<SessionDrawer Open="_drawerOpen" OnClose="() => _drawerOpen = false" />

@if (CanShowTasksPanel && _tasksPanelOpen)
{
    <button type="button"
            class="tareas-side-backdrop no-print"
            aria-label="Cerrar tareas"
            @onclick="CloseTasksPanel"></button>
}

@if (CanShowTasksPanel)
{
<aside class="tareas-side-panel no-print @(_tasksPanelOpen ? "is-open" : string.Empty)" aria-label="Tareas rápidas">
    <header class="tareas-side-panel__head">
        <div class="tareas-side-panel__title">
            <span>TASKS</span>
            <strong>Rápidas</strong>
        </div>
        <div class="tareas-side-panel__actions">
            <a href="/tareas" title="Ir al módulo de tareas" aria-label="Ir al módulo de tareas" @onclick="CloseTasksPanel">
                <i class="bi bi-box-arrow-up-right"></i>
            </a>
            <button type="button" title="Cerrar" aria-label="Cerrar tareas" @onclick="CloseTasksPanel">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </header>

    <section class="tareas-side-panel__add">
        <i class="bi bi-check2-circle"></i>
        <input @bind="_tasksPanelQuickTitle"
               @bind:event="oninput"
               @onkeydown="HandleTasksPanelQuickKeyDown"
               dir="ltr"
               autocomplete="off"
               spellcheck="true"
               style="direction: ltr; unicode-bidi: plaintext; text-align: left;"
               placeholder="Añadir rápida" />
    </section>

    <section class="tareas-side-panel__body">
        @if (_tasksPanelLoading)
        {
            <div class="tareas-side-panel__empty">Cargando tareas...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_tasksPanelError))
        {
            <div class="tareas-side-panel__empty is-error">@_tasksPanelError</div>
        }
        else
        {
            @if (TasksPanelOpenNotes.Count > 0)
            {
                <p class="tareas-side-panel__group">Para hoy</p>
                <div class="tareas-side-list">
                    @foreach (var nota in TasksPanelOpenNotes)
                    {
                        <article class="tareas-side-row">
                            <button type="button" class="tareas-side-check" title="Marcar como hecha" @onclick="() => CompleteTasksPanelNoteAsync(nota)">
                                <i class="bi bi-circle"></i>
                            </button>
                            <span class="tareas-side-row__body">
                                <strong>@nota.Texto</strong>
                                <span>Rápida</span>
                            </span>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="tareas-side-panel__empty">No hay rápidas pendientes.</div>
            }

            <details class="tareas-side-completed">
                <summary>Hechas (@TasksPanelCompletedNotes.Count)</summary>
                <div class="tareas-side-list">
                    @foreach (var nota in TasksPanelCompletedNotes)
                    {
                        <article class="tareas-side-row is-done">
                            <button type="button" class="tareas-side-check is-done" title="Restaurar" @onclick="() => RestoreTasksPanelNoteAsync(nota)">
                                <i class="bi bi-check-circle-fill"></i>
                            </button>
                            <span class="tareas-side-row__body">
                                <strong>@nota.Texto</strong>
                                <span>@FormatTasksPanelDateTime(nota.FechaHoraCompletada)</span>
                            </span>
                        </article>
                    }
                </div>
            </details>
        }
    </section>
</aside>
}

@if (_showInstallHelp)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar instalación" @onclick="() => _showInstallHelp = false"></button>
    <section class="panel-card app-modal no-print">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Instalar AlfaCore</h3>
                <p class="panel-card__subtitle">En iPhone o iPad usá Compartir &gt; Agregar a pantalla de inicio.</p>
            </div>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _showInstallHelp = false" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </section>
}

@if (_showPushPanel)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar notificaciones" @onclick="() => _showPushPanel = false"></button>
    <section class="panel-card app-modal app-modal--wide no-print">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Notificaciones</h3>
                <p class="panel-card__subtitle">Avisos push por dispositivo para mensajes nuevos.</p>
            </div>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _showPushPanel = false" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_pushMessage))
        {
            <div class="conversations-inline conversations-inline--ok">@_pushMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_pushError))
        {
            <div class="conversations-inline conversations-inline--error">@_pushError</div>
        }

        <div class="app-settings-grid">
            <label class="toggle-row">
                <input type="checkbox" checked="@_pushPreferences.Habilitadas" @onchange="OnPushEnabledChanged" disabled="@(!CanEnablePush)" />
                <span>Activar notificaciones en este dispositivo</span>
            </label>

            <div class="field">
                <label>Alcance</label>
                <select @bind="_pushPreferences.Alcance">
                    <option value="@NotificacionesPushScopes.Asignadas">Solo conversaciones asignadas a mi usuario</option>
                    <option value="@NotificacionesPushScopes.Accesibles">Todas las conversaciones accesibles</option>
                </select>
            </div>

            <div class="field">
                <label>Canales</label>
                <label class="toggle-row toggle-row--compact">
                    <input type="checkbox" checked="@(PushChannelEnabled("WHATSAPP"))" @onchange="@(args => TogglePushChannel("WHATSAPP", args))" />
                    <span>WhatsApp</span>
                </label>
                <p class="app-modal__hint">El selector queda preparado para sumar nuevos canales cuando el módulo los habilite.</p>
            </div>
        </div>

        <div class="actions">
            <button type="button" class="btn btn--primary" @onclick="SavePushPreferencesAsync" disabled="@_pushBusy">
                <i class="bi bi-save"></i>
                <span>Guardar</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="SendTestPushAsync" disabled="@(!CanSendTestPush)">
                <i class="bi bi-send"></i>
                <span>Enviar prueba</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="ReRegisterCurrentDeviceAsync" disabled="@_pushBusy">
                <i class="bi bi-arrow-repeat"></i>
                <span>Re-registrar este dispositivo</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="LoadPushDiagnosticsAsync" disabled="@_pushBusy">
                <i class="bi bi-activity"></i>
                <span>Diagnóstico push</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(PushScopeNotice))
        {
            <p class="app-modal__hint">@PushScopeNotice</p>
        }

        @if (_pushDiagnostics is not null)
        {
            <div class="app-settings-grid">
                <div class="field">
                    <label>Diagnóstico del dispositivo</label>
                    <p class="app-modal__hint">HTTPS: @(_pushDiagnostics.Https ? "SI" : "NO") · SW activo: @(_pushDiagnostics.ServiceWorkerReady ? "SI" : "NO") · Push soportado: @(_pushDiagnostics.PushSupported ? "SI" : "NO") · Permiso: @_pushDiagnostics.NotificationPermission</p>
                    <p class="app-modal__hint">DeviceId: @_pushDiagnostics.DeviceId</p>
                    <p class="app-modal__hint">PublicKey: @_pushDiagnostics.PublicKeyPreview</p>
                    @if (_pushDiagnostics.IsBrave)
                    {
                        <p class="conversations-inline conversations-inline--error">Brave detectado: este navegador puede bloquear push por Shields/Notificaciones.</p>
                    }
                </div>
                <div class="field">
                    <label>Suscripciones registradas</label>
                    <p class="app-modal__hint">Dispositivos registrados: @_pushDiagnostics.SubscriptionCount · Activos: @_pushDiagnostics.ActiveSubscriptionCount</p>
                    @if (_pushDiagnostics.Subscriptions.Count == 0)
                    {
                        <p class="conversations-inline conversations-inline--error">No hay suscripciones push activas para este usuario/dispositivo.</p>
                    }
                    else
                    {
                        @foreach (var sub in _pushDiagnostics.Subscriptions)
                        {
                            <p class="app-modal__hint">[@sub.DeviceId@(sub.EsDispositivoActual ? " · ESTE EQUIPO" : string.Empty)] activo: @(sub.Activo ? "SI" : "NO") · endpoint: @sub.EndpointParcial · alta: @(sub.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</p>
                            <p class="app-modal__hint">UA: @DisplayOrDash(sub.UserAgent) · último intento: @(sub.LastAttemptAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-") · último status: @(sub.StatusCode?.ToString() ?? "-") · último error: @DisplayOrDash(sub.Error)</p>
                            <p class="app-modal__hint">Preferencias dispositivo: alcance=@sub.Preferences.Alcance · canales=@string.Join(", ", sub.Preferences.Canales)</p>
                        }
                    }
                </div>
                <div class="field">
                    <label>Preferencias y último test</label>
                    <p class="app-modal__hint">Alcance: @_pushDiagnostics.Preferences.Alcance · Canales: @string.Join(", ", _pushDiagnostics.Preferences.Canales)</p>
                    <p class="app-modal__hint">Último envío de prueba: @_pushLastTestSummary</p>
                    <p class="app-modal__hint">Último error del proveedor push: @DisplayOrDash(_pushDiagnosticsLastProviderError)</p>
                    @if (_pushLastTestResults.Count > 0)
                    {
                        @foreach (var item in _pushLastTestResults)
                        {
                            <p class="app-modal__hint">Prueba → [@item.DeviceId] endpoint=@item.EndpointParcial · resultado=@(item.Success ? "OK" : "FALLÓ") · status=@(item.StatusCode?.ToString() ?? "-") · error=@DisplayOrDash(item.Error)</p>
                        }
                    }
                </div>
            </div>
        }

        @if (_pwaIsIos && !_pwaInstalled)
        {
            <p class="app-modal__hint">En iOS las notificaciones web requieren instalar AlfaCore en pantalla de inicio. Primero usá Compartir &gt; Agregar a pantalla de inicio y abrí la app desde ese ícono.</p>
        }
        else if (!_pwaPushSupported)
        {
            <p class="app-modal__hint">Este navegador no informa soporte para notificaciones push web.</p>
        }
        else if (!_pushConfigured)
        {
            <p class="app-modal__hint">@_pushConfigurationMessage</p>
        }
    </section>
}

<AppLoginOverlay Open="@(!AppUserSession.IsAuthenticated)"
                 SqlSessionLabel="@GetSqlSessionLabel()"
                 UserName="@_loginUserName"
                 Password="@_loginPassword"
                 ErrorMessage="@_loginError"
                 IsBusy="@_loginBusy"
                 ShowPassword="@_loginShowPassword"
                 RememberCredentials="@_loginRememberCredentials"
                 UserNameChanged="@(value => _loginUserName = value)"
                 PasswordChanged="@(value => _loginPassword = value)"
                 ShowPasswordChanged="@(value => _loginShowPassword = value)"
                 RememberCredentialsChanged="OnRememberCredentialsChangedAsync"
                 OnSubmit="LoginAsync"
                 OnOpenSqlSessions="OpenSqlSessionDrawerAsync" />

<AppMsgBoxHost />

@code {
    private bool _mobileSidebarOpen;
    private bool _isDark = false;
    private bool _drawerOpen;
    private AlfaCore.Models.SessionDto? _activeSession;
    private string _loginUserName = string.Empty;
    private string _loginPassword = string.Empty;
    private string _loginError = string.Empty;
    private bool _loginBusy;
    private bool _loginShowPassword;
    private bool _loginRememberCredentials;
    private DotNetObjectReference<MainLayout>? _pwaRef;
    private bool _pwaCanInstall;
    private bool _pwaInstalled;
    private bool _pwaIsIos;
    private bool _pwaPushSupported;
    private string _pwaNotificationPermission = string.Empty;
    private bool _showInstallHelp;
    private bool _showPushPanel;
    private bool _pushBusy;
    private bool _pushConfigured;
    private string _pushPublicKey = string.Empty;
    private string _pushConfigurationMessage = string.Empty;
    private string _pushMessage = string.Empty;
    private string _pushError = string.Empty;
    private NotificacionesPushPreferencesDto _pushPreferences = new();
    private PushDiagnosticsVm? _pushDiagnostics;
    private string _pushLastTestSummary = "Sin pruebas ejecutadas.";
    private string _pushDiagnosticsLastProviderError = string.Empty;
    private List<NotificacionesPushEndpointResultDto> _pushLastTestResults = [];
    private string CurrentPageTitle => GetCurrentPageTitle();
    private RenderFragment? ModuleBackLink => !IsDirectMode
        ? @<a class="menu__back" href="/" @onclick:preventDefault="true" @onclick="GoBackOrLauncherAsync">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <span>Aplicaciones</span>
            </a>
        : null;
    private string ShellClass
        => $"shell {(IsSidebarCollapsed ? "shell--collapsed" : string.Empty)} {(_mobileSidebarOpen ? "shell--mobile-open" : string.Empty)} {(IsDirectMode ? "shell--direct" : string.Empty)} {(IsPosFullscreenRoute ? "shell--pos-fullscreen" : string.Empty)}";
    private bool ShowShellContext => string.IsNullOrWhiteSpace(_currentModule);
    private bool ShowLauncherContext => ShowShellContext && !IsDirectMode;
    private bool CanShowLauncherAccess => !IsDirectMode;
    private bool IsSidebarCollapsed => !ShowLauncherContext;
    private bool CanShowTasksPanel => !IsPosFullscreenRoute && !IsDirectMode && AppUserSession.IsAuthenticated;
    private bool IsLauncherRoute => string.IsNullOrWhiteSpace(Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/'));
    private bool IsDirectMode => !string.IsNullOrWhiteSpace(_directModuleKey);
    private bool IsPosFullscreenRoute => string.Equals(GetNormalizedCurrentPath(), "ventas/punto-venta", StringComparison.OrdinalIgnoreCase);
    private bool ShouldShowConversationMobilePwaActions
        => string.Equals(_currentModule, "conversaciones", StringComparison.OrdinalIgnoreCase);
    private bool CanEnablePush
        => !_pushBusy
           && _pushConfigured
           && _pwaPushSupported
           && (!_pwaIsIos || _pwaInstalled);
    private bool CanSendTestPush
        => CanEnablePush && _pushPreferences.Habilitadas;
    private bool ShouldShowConversationNotice
        => !IsDirectMode
           && _globalConversationUnreadCount > 0
           && !string.Equals(_currentModule, "conversaciones", StringComparison.OrdinalIgnoreCase);
    private string GlobalConversationNoticeTitle
        => _globalConversationUnreadCount == 1 ? "Nuevo mensaje" : $"{_globalConversationUnreadCount} mensajes nuevos";
    private string GlobalConversationNoticeText
        => string.IsNullOrWhiteSpace(_globalConversationLatestName)
            ? "Abrir conversaciones"
            : $"{_globalConversationLatestName}: {_globalConversationLatestSummary}";
    private string PushScopeNotice
        => string.Equals(_pushPreferences.Alcance, NotificacionesPushScopes.Asignadas, StringComparison.OrdinalIgnoreCase)
            ? "Importante: con 'solo asignadas', si la conversación no tiene técnico asignado no se envía push."
            : string.Empty;
    private IReadOnlyList<ShellMenuSearchItemDto> FilteredMenuSearchResults => GetFilteredMenuSearchResults();

    private string _currentModule = string.Empty;
    private string _activeShellModuleKey = string.Empty;
    private string _directModuleKey = string.Empty;
    private List<ShellModuleDto> _mainMenuModules = [];
    private List<ShellMenuSearchItemDto> _menuSearchCatalog = [];
    private string _menuSearchText = string.Empty;
    private string _menuSearchError = string.Empty;
    private bool _menuSearchLoaded;
    private bool _menuSearchLoading;
    private bool _tasksPanelOpen;
    private bool _tasksPanelLoading;
    private string _tasksPanelQuickTitle = string.Empty;
    private string _tasksPanelError = string.Empty;
    private TareasPageDto _tasksPanel = new();
    private readonly Dictionary<long, long> _globalConversationLastIncomingById = [];
    private CancellationTokenSource? _globalConversationPollingCts;
    private Task? _globalConversationPollingTask;
    private bool _globalConversationBaselineReady;
    private int _globalConversationUnreadCount;
    private long? _globalConversationLatestId;
    private string _globalConversationLatestName = string.Empty;
    private string _globalConversationLatestSummary = string.Empty;

    protected override void OnInitialized()
    {
        _activeSession = SessionSvc.GetActiveSession();
        SessionSvc.SessionChanged += OnSessionChanged;
        AppUserSession.StateChanged += OnAppUserStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnSessionChanged()
    {
        _activeSession = SessionSvc.GetActiveSession();
        ResetMenuSearchCatalog();
        var wasAuthenticated = AppUserSession.IsAuthenticated;
        AppUserSession.HandleSqlSessionChanged();
        if (wasAuthenticated && !AppUserSession.IsAuthenticated)
        {
            _ = InvokeAsync(async () =>
            {
                try { await JS.InvokeVoidAsync("localStorage.removeItem", "alfacore_user_token"); }
                catch { }
            });
        }
        _loginPassword = string.Empty;
        _loginShowPassword = false;
        _loginError = string.Empty;
        ResetGlobalConversationNotifications();
        if (ShowShellContext)
            _ = InvokeAsync(EnsureMenuSearchCatalogAsync);
        InvokeAsync(StateHasChanged);
    }

    private void OnAppUserStateChanged()
    {
        ResetMenuSearchCatalog();
        if (!AppUserSession.IsAuthenticated)
        {
            _loginPassword = string.Empty;
            _loginShowPassword = false;
            CloseTasksPanel();
        }

        if (ShowShellContext)
            _ = InvokeAsync(EnsureMenuSearchCatalogAsync);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionSvc.SessionChanged -= OnSessionChanged;
        AppUserSession.StateChanged -= OnAppUserStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        StopGlobalConversationPolling();
        _ = InvokeAsync(async () =>
        {
            try { await JS.InvokeVoidAsync("conversacionesUi.setUnreadCount", 0); }
            catch { }
            _pwaRef?.Dispose();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _mobileSidebarOpen = false;
        UpdateCurrentModule();
        if (EnforceDirectMode())
            return;
        if (ShowShellContext)
            _ = InvokeAsync(EnsureMenuSearchCatalogAsync);
        if (string.Equals(_currentModule, "conversaciones", StringComparison.OrdinalIgnoreCase))
            ResetGlobalConversationNotifications();

        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        UpdateCurrentModule();
        EnforceDirectMode();
    }

    private void GoToLauncher()
        => Nav.NavigateTo("/");

    private async Task GoBackOrLauncherAsync()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("alfaCoreNavigation.canGoBack"))
            {
                await JS.InvokeVoidAsync("alfaCoreNavigation.goBack");
                return;
            }
        }
        catch
        {
        }

        GoToLauncher();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        StartGlobalConversationPolling();

        try
        {
            await JS.InvokeVoidAsync("conversacionesUi.initNotifications", "AlfaCore - Alfa Gestión");
        }
        catch
        {
        }

        try
        {
            var theme = await JS.InvokeAsync<string>("dashboardTheme.get");
            _isDark = !string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _isDark = true;
        }

        try
        {
            _pwaRef = DotNetObjectReference.Create(this);
            var pwaState = await JS.InvokeAsync<PwaClientState>("alfaCorePwa.init", _pwaRef);
            _pwaCanInstall = pwaState.CanInstall;
            _pwaInstalled = pwaState.Installed;
            _pwaIsIos = pwaState.IsIos;
            _pwaPushSupported = pwaState.PushSupported;
            _pwaNotificationPermission = pwaState.NotificationPermission;
        }
        catch
        {
        }

        if (!AppUserSession.IsAuthenticated)
        {
            try
            {
                var token = await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_user_token");
                if (!string.IsNullOrEmpty(token))
                    AppUserSession.TryRestoreFromToken(token);
            }
            catch { }

            try
            {
                _loginRememberCredentials = string.Equals(
                    await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_login_remember"),
                    "true",
                    StringComparison.OrdinalIgnoreCase);

                if (_loginRememberCredentials)
                {
                    _loginUserName = await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_login_user") ?? string.Empty;
                    _loginPassword = await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_login_password") ?? string.Empty;
                }
            }
            catch { }
        }

        if (ShowShellContext)
            await EnsureMenuSearchCatalogAsync();
        StateHasChanged();
    }

    private void UpdateCurrentModule()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var path = relativePath.Split('?')[0].Split('#')[0].Trim('/');
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        var normalized = path.ToLowerInvariant();
        if (normalized.StartsWith("shell/", StringComparison.OrdinalIgnoreCase))
        {
            _activeShellModuleKey = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Skip(1).FirstOrDefault() ?? string.Empty;
            _currentModule = string.Empty;
            _directModuleKey = string.Empty;
            return;
        }

        _activeShellModuleKey = string.Empty;

        _currentModule = normalized switch
        {
            "clientes" => "clientes",
            "proveedores" => "proveedores",
            _ => path.Split('/').FirstOrDefault()?.ToLowerInvariant() ?? string.Empty
        };

        if (query.TryGetValue("directo", out var directo)
            && string.Equals(directo.ToString(), "1", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(_currentModule))
        {
            _directModuleKey = _currentModule;
        }
        else if (string.IsNullOrWhiteSpace(path) || string.IsNullOrWhiteSpace(_currentModule))
        {
            _directModuleKey = string.Empty;
        }
    }

    private bool EnforceDirectMode()
    {
        if (!IsDirectMode)
            return false;

        var normalizedPath = GetNormalizedCurrentPath();
        var isAllowedModuleRoute = normalizedPath == _directModuleKey
            || normalizedPath.StartsWith($"{_directModuleKey}/", StringComparison.OrdinalIgnoreCase);

        if (isAllowedModuleRoute)
            return false;

        var target = $"/{_directModuleKey}?directo=1";
        Nav.NavigateTo(target);
        return true;
    }

    private string BuildModuleUrl(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return route;

        if (!IsDirectMode)
            return route;

        var normalizedRoute = route.Trim();
        if (!normalizedRoute.StartsWith('/'))
            normalizedRoute = "/" + normalizedRoute;

        var normalizedModule = "/" + _directModuleKey;
        var belongsToDirectModule = string.Equals(normalizedRoute, normalizedModule, StringComparison.OrdinalIgnoreCase)
            || normalizedRoute.StartsWith(normalizedModule + "/", StringComparison.OrdinalIgnoreCase);

        return belongsToDirectModule ? AppendDirectFlag(normalizedRoute) : normalizedRoute;
    }

    private static string AppendDirectFlag(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return route;

        if (route.Contains("directo=1", StringComparison.OrdinalIgnoreCase))
            return route;

        return route.Contains('?', StringComparison.Ordinal)
            ? route + "&directo=1"
            : route + "?directo=1";
    }

