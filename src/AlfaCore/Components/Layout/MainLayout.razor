    private async Task RunGlobalConversationPollingAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        await PollGlobalConversationNotificationsAsync(cancellationToken);

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(() => PollGlobalConversationNotificationsAsync(cancellationToken));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PollGlobalConversationNotificationsAsync(CancellationToken cancellationToken)
    {
        if (!AppUserSession.IsAuthenticated
            || string.Equals(_currentModule, "conversaciones", StringComparison.OrdinalIgnoreCase))
            return;

        try
        {
            var inbox = await ConversacionesSvc.GetInboxAsync(new AlfaCore.Models.ConversacionesInboxFilters
            {
                Canal = "WHATSAPP",
                Modo = "pendientes",
                Limit = 50
            }, cancellationToken);

            var newCount = 0;
            AlfaCore.Models.ConversacionInboxItemDto? latest = null;

            foreach (var item in inbox)
            {
                if (item.IdUltimoMensajeCliente is not long currentIncomingId)
                    continue;

                if (!_globalConversationLastIncomingById.TryGetValue(item.IdConversacion, out var previousIncomingId))
                {
                    _globalConversationLastIncomingById[item.IdConversacion] = currentIncomingId;
                    if (_globalConversationBaselineReady)
                    {
                        newCount++;
                        latest = item;
                    }
                    continue;
                }

                if (currentIncomingId <= previousIncomingId)
                    continue;

                _globalConversationLastIncomingById[item.IdConversacion] = currentIncomingId;
                newCount++;
                latest = item;
            }

            _globalConversationBaselineReady = true;
            if (newCount <= 0)
                return;

            _globalConversationUnreadCount += newCount;
            if (latest is not null)
            {
                _globalConversationLatestId = latest.IdConversacion;
                _globalConversationLatestName = FirstNonEmpty(
                    latest.ContactoNombre,
                    latest.NombreVisible,
                    latest.ClienteNombre,
                    latest.TelefonoWhatsApp,
                    "Conversaciones");
                _globalConversationLatestSummary = string.IsNullOrWhiteSpace(latest.ResumenUltimoMensaje)
                    ? "Mensaje nuevo"
                    : latest.ResumenUltimoMensaje;
            }

            await JS.InvokeVoidAsync("conversacionesUi.setUnreadCount", _globalConversationUnreadCount);
            await JS.InvokeVoidAsync("conversacionesUi.playNewMessageSound");
            StateHasChanged();
        }
        catch
        {
        }
    }

