    private async Task LoginAsync()
    {
        _loginBusy = true;
        _loginError = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        using var loginCts = new CancellationTokenSource(TimeSpan.FromSeconds(20));

        try
        {
            Logger.LogInformation(
                "LoginAsync: start. SaaS={SaaS}, InternalContext={InternalContext}, Route={Route}, User={User}, HasRouteBase={HasRouteBase}, ActiveSession={ActiveSession}",
                AppMode.IsSaaSMode,
                IsInternalSqlLoginContext,
                GetNormalizedCurrentPath(),
                _loginUserName,
                TryGetRouteBaseId(out var debugRouteBaseId),
                SessionSvc.GetActiveSession()?.BaseId);

            AppUserSessionInfo session;
            if (IsInternalSqlLoginContext)
            {
                var selectedSession = SessionSvc.GetActiveSession();
                if (selectedSession is not null)
                {
                    var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder
                    {
                        DataSource = selectedSession.Servidor,
                        InitialCatalog = selectedSession.BaseDatos,
                        UserID = selectedSession.Usuario,
                        Password = selectedSession.Password,
                        TrustServerCertificate = selectedSession.TrustServerCertificate,
                        ApplicationName = "AlfaCore"
                    };

                    Logger.LogInformation(
                        "LoginAsync: validando acceso interno contra base activa seleccionada. BaseId={BaseId}, DbServer={DbServer}, DbName={DbName}, DbUser={DbUser}",
                        selectedSession.BaseId,
                        selectedSession.Servidor,
                        selectedSession.BaseDatos,
                        selectedSession.Usuario);

                    var loginTask = LegacyBaseUserSession.LoginAsync(_loginUserName, _loginPassword, builder.ConnectionString, loginCts.Token);
                    var completedTask = await Task.WhenAny(loginTask, Task.Delay(TimeSpan.FromSeconds(20), loginCts.Token));
                    if (!ReferenceEquals(completedTask, loginTask))
                    {
                        Logger.LogWarning("LoginAsync: timeout esperando validación interna. BaseId={BaseId}", selectedSession.BaseId);
                        throw new TaskCanceledException("El inicio de sesión interno superó el tiempo máximo de espera.");
                    }

                    session = await loginTask;
                    Logger.LogInformation("LoginAsync: acceso interno validado. User={User}, SystemCode={SystemCode}", session.UserName, session.SystemCode);
                    Logger.LogInformation("LoginAsync: adoptando usuario interno...");
                    AppUserSession.AdoptInternalUser(session);
                    Logger.LogInformation("LoginAsync: usuario interno adoptado. RequiresInternalLogin={RequiresInternalLogin}, Authenticated={Authenticated}", AppUserSession.RequiresInternalLogin, AppUserSession.IsAuthenticated);
                }
                else
                {
                    if (!TryGetRouteBaseId(out var routeBaseId))
                    {
                        _loginError = "No hay una base activa lista para validar el acceso interno.";
                        Logger.LogWarning("LoginAsync: no se pudo resolver idbase desde la URL. Route={Route}", GetNormalizedCurrentPath());
                        return;
                    }

                    var routeBase = await CentralBasesSvc.GetByIdAsync(routeBaseId);
                    if (routeBase is null)
                    {
                        _loginError = $"No se encontró la base #{routeBaseId} para validar el acceso interno.";
                        Logger.LogWarning("LoginAsync: base central no encontrada. IdBase={IdBase}, Route={Route}", routeBaseId, GetNormalizedCurrentPath());
                        return;
                    }

                    var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder
                    {
                        DataSource = routeBase.DbServer,
                        InitialCatalog = routeBase.DbName,
                        UserID = routeBase.DbUser,
                        Password = routeBase.DbPassword,
                        TrustServerCertificate = true,
                        ApplicationName = "AlfaCore"
                    };

                    Logger.LogInformation(
                        "LoginAsync: validando acceso interno contra base central. IdBase={IdBase}, DbServer={DbServer}, DbName={DbName}, DbUser={DbUser}",
                        routeBaseId,
                        routeBase.DbServer,
                        routeBase.DbName,
                        routeBase.DbUser);

                    var loginTask = LegacyBaseUserSession.LoginAsync(_loginUserName, _loginPassword, builder.ConnectionString, loginCts.Token);
                    var completedTask = await Task.WhenAny(loginTask, Task.Delay(TimeSpan.FromSeconds(20), loginCts.Token));
                    if (!ReferenceEquals(completedTask, loginTask))
                    {
                        Logger.LogWarning("LoginAsync: timeout esperando validación interna. Route={Route}, IdBase={IdBase}", GetNormalizedCurrentPath(), routeBaseId);
                        throw new TaskCanceledException("El inicio de sesión interno superó el tiempo máximo de espera.");
                    }

                    session = await loginTask;
                    Logger.LogInformation("LoginAsync: acceso interno validado. User={User}, SystemCode={SystemCode}", session.UserName, session.SystemCode);
                    Logger.LogInformation("LoginAsync: adoptando usuario interno...");
                    AppUserSession.AdoptInternalUser(session);
                    Logger.LogInformation("LoginAsync: usuario interno adoptado. RequiresInternalLogin={RequiresInternalLogin}, Authenticated={Authenticated}", AppUserSession.RequiresInternalLogin, AppUserSession.IsAuthenticated);
                }
            }
            else if (AppMode.IsSaaSMode)
            {
                Logger.LogInformation("LoginAsync: validación SaaS central para usuario {User}", _loginUserName);
                session = await AppUserSession.LoginAsync(_loginUserName, _loginPassword, loginCts.Token);
                Logger.LogInformation("LoginAsync: login SaaS OK. User={User}, Client={Client}, Base={Base}", session.UserName, session.IdCliente, session.SqlSessionId);
            }
            else
            {
                Logger.LogInformation("LoginAsync: validación legacy local para usuario {User}", _loginUserName);
                session = await LegacyBaseUserSession.LoginAsync(_loginUserName, _loginPassword, loginCts.Token);
                Logger.LogInformation("LoginAsync: login legacy OK. User={User}, SystemCode={SystemCode}", session.UserName, session.SystemCode);
                AppUserSession.AdoptInternalUser(session);
            }

            if (IsInternalSqlLoginContext)
            {
                _loginUserName = string.Empty;
                _loginPassword = string.Empty;
                _loginRememberCredentials = false;
                _ = InvokeAsync(async () =>
                {
                    try
                    {
                        await JS.InvokeVoidAsync("localStorage.removeItem", "alfacore_login_user");
                        await JS.InvokeVoidAsync("localStorage.removeItem", "alfacore_login_password");
                        await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_remember", "false");
                    }
                    catch { }
                });
            }
            else
            {
                _loginUserName = session.UserName;
                if (_loginRememberCredentials)
                {
                    try
                    {
                        await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_remember", "true");
                        await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_user", _loginUserName);
                        await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_password", _loginPassword);
                    }
                    catch { }
                }
                else
                {
                    _loginPassword = string.Empty;
                    try
                    {
                        await JS.InvokeVoidAsync("localStorage.removeItem", "alfacore_login_user");
                        await JS.InvokeVoidAsync("localStorage.removeItem", "alfacore_login_password");
                        await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_remember", "false");
                    }
                    catch { }
                }
            }
            _loginShowPassword = false;
            _manualLoginOverlayOpen = false;
            if (AppUserSession.CurrentToken is not null)
            {
                var tokenToPersist = AppUserSession.CurrentToken;
                Logger.LogInformation("LoginAsync: persistiendo token de usuario en background.");
                _ = InvokeAsync(async () =>
                {
                    try { await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_user_token", tokenToPersist); }
                    catch { }
                });
            }
        }
        catch (AlfaCore.Services.AppUserFacingException ex)
        {
            _loginError = ex.Message;
            Logger.LogWarning(ex, "LoginAsync: AppUserFacingException. Route={Route}, User={User}", GetNormalizedCurrentPath(), _loginUserName);
        }
        catch (InvalidOperationException ex)
        {
            _loginError = ex.Message;
            Logger.LogWarning(ex, "LoginAsync: InvalidOperationException. Route={Route}, User={User}", GetNormalizedCurrentPath(), _loginUserName);
        }
        catch (TaskCanceledException)
        {
            _loginError = "No se pudo iniciar sesión a tiempo. Revisá la base activa e intentá nuevamente.";
            Logger.LogWarning("LoginAsync: timeout/cancelación. Route={Route}, User={User}", GetNormalizedCurrentPath(), _loginUserName);
        }
        catch (Exception ex)
        {
            _loginError = ex.Message;
            Logger.LogError(ex, "LoginAsync: excepción inesperada. Route={Route}, User={User}", GetNormalizedCurrentPath(), _loginUserName);
        }
        finally
        {
            _loginBusy = false;
            Logger.LogInformation("LoginAsync: end. Busy=false, HasError={HasError}", !string.IsNullOrWhiteSpace(_loginError));
            StateHasChanged();
        }
    }

