    private async Task GoBackOrLauncherAsync()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("alfaCoreNavigation.canGoBack"))
            {
                await JS.InvokeVoidAsync("alfaCoreNavigation.goBack");
                return;
            }
        }
        catch
        {
        }

        GoToLauncher();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            StartGlobalConversationPolling();

            await JS.InvokeVoidAsync("conversacionesUi.initNotifications", "AlfaCore - Alfa Gestión");

            var theme = await JS.InvokeAsync<string>("dashboardTheme.get");
            _isDark = !string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _isDark = true;
            _initializationErrorMessage ??= "No se pudo sincronizar el estado visual inicial.";
            Logger.LogDebug(ex, "MainLayout: no se pudo leer el tema inicial.");
        }

        try
        {
            _pwaRef = DotNetObjectReference.Create(this);
            var pwaState = await JS.InvokeAsync<PwaClientState>("alfaCorePwa.init", _pwaRef);
            _pwaCanInstall = pwaState.CanInstall;
            _pwaInstalled = pwaState.Installed;
            _pwaIsIos = pwaState.IsIos;
            _pwaPushSupported = pwaState.PushSupported;
            _pwaNotificationPermission = pwaState.NotificationPermission;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "MainLayout: no se pudo inicializar PWA.");
        }

        try
        {
            await EnsureActiveSessionFromRouteAsync();
            await EnsureInternalLoginUsersAsync();

            if (IsInternalSqlLoginContext && AppUserSession.RequiresInternalLogin)
                ResetLoginDraftForInternalContext();

            if (!AppUserSession.IsAuthenticated)
            {
                var normalizedPathForToken = GetNormalizedCurrentPath();
                try
                {
                    if (!string.IsNullOrWhiteSpace(normalizedPathForToken))
                    {
                        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_user_token");
                        if (!string.IsNullOrEmpty(token))
                            AppUserSession.TryRestoreFromToken(token);
                    }
                }
                catch { }

                try
                {
                    var isInternalLoginPrompt = IsInternalSqlLoginContext || (AppMode.IsSaaSMode && AppUserSession.RequiresInternalLogin && !IsLoginRoute);
                    if (!isInternalLoginPrompt)
                    {
                        _loginRememberCredentials = string.Equals(
                            await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_login_remember"),
                            "true",
                            StringComparison.OrdinalIgnoreCase);

                        if (_loginRememberCredentials)
                        {
                            _loginUserName = await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_login_user") ?? string.Empty;
                            _loginPassword = await JS.InvokeAsync<string?>("localStorage.getItem", "alfacore_login_password") ?? string.Empty;
                        }
                    }
                    else
                    {
                        _loginRememberCredentials = false;
                        _loginUserName = string.Empty;
                        _loginPassword = string.Empty;
                    }
                }
                catch { }
            }

            if (AppMode.IsSaaSMode && !AppUserSession.IsAuthenticated)
            {
                var normalizedPath = GetNormalizedCurrentPath();
                var allowSaasLanding = await CanShowSaaSClientLandingAsync(normalizedPath);
                Logger.LogInformation(
                    "MainLayout: auth guard. Path={Path}, AllowLanding={AllowLanding}, HasAuth={HasAuth}, ActiveSession={ActiveSession}, SaaS={SaaS}",
                    normalizedPath,
                    allowSaasLanding,
                    AppUserSession.IsAuthenticated,
                    SessionSvc.GetActiveSession()?.BaseId,
                    AppMode.IsSaaSMode);

                if (!allowSaasLanding && string.IsNullOrWhiteSpace(_currentModule))
                {
                    var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].TrimStart('/');
                    var loginTarget = string.Equals(returnUrl, "/", StringComparison.Ordinal)
                        ? "/login"
                        : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
                    Logger.LogInformation(
                        "MainLayout: redirecting to login. ReturnUrl={ReturnUrl}",
                        string.Equals(loginTarget, "/login", StringComparison.Ordinal) ? "(sin returnUrl)" : returnUrl);
                    Nav.NavigateTo(loginTarget, replace: true);
                    return;
                }

                if (!allowSaasLanding)
                {
                    Logger.LogInformation(
                        "MainLayout: SaaS module route without auth, keeping current URL. Path={Path}, Module={Module}",
                        normalizedPath,
                        _currentModule);
                }
            }

            if (TryRedirectToCanonicalHome())
                return;

            if (ShowShellContext)
                await EnsureMenuSearchCatalogAsync();
        }
        catch (Exception ex)
        {
            _initializationErrorMessage = "No se pudo completar la carga inicial del sistema.";
            Logger.LogError(ex, "MainLayout: fallo durante la inicializacion inicial.");
        }
        finally
        {
            _isInitializing = false;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
            }
        }
    }

    private async Task EnsureActiveSessionFromRouteAsync()
    {
        if (!AppMode.IsSaaSMode || !TryGetRouteBaseId(out var routeBaseId))
            return;

        var availableSessions = SessionSvc.GetAllSessions();
        var routeSession = availableSessions.FirstOrDefault(x => x.BaseId == routeBaseId);

        if (routeSession is null)
        {
            var routeBase = await CentralBasesSvc.GetByIdAsync(routeBaseId);
            _routeSessionLabel = routeBase is null
                ? $"Base #{routeBaseId}"
                : $"{routeBase.Nombre} · {routeBase.DbServer} · {routeBase.DbName}";
            return;
        }

        if (SessionSvc.GetActiveSession() is null)
        {
            SessionSvc.SwitchSession(routeSession.Id);

            try
            {
                await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", routeSession.Id.ToString());
            }
            catch
            {
                // La sesión en memoria ya quedó activa; el storage es solo persistencia auxiliar.
            }

            Logger.LogInformation(
                "MainLayout: base activada desde la URL (sin sesión previa). Path={Path}, IdWeb={IdWeb}, IdBase={IdBase}, Nombre={Nombre}",
                GetNormalizedCurrentPath(),
                GetRouteIdWeb() ?? "(sin ruta)",
                routeSession.BaseId,
                routeSession.Nombre);
            _routeSessionLabel = $"{routeSession.Nombre} · {routeSession.Servidor} · {routeSession.BaseDatos}";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", routeSession.Id.ToString());
        }
        catch
        {
            // La sesión en memoria ya quedó activa; el storage es solo persistencia auxiliar.
        }

        Logger.LogInformation(
            "MainLayout: base activada desde la URL. Path={Path}, IdWeb={IdWeb}, IdBase={IdBase}, Nombre={Nombre}",
            GetNormalizedCurrentPath(),
            GetRouteIdWeb() ?? "(sin ruta)",
            routeSession.BaseId,
            routeSession.Nombre);
        _routeSessionLabel = $"{routeSession.Nombre} · {routeSession.Servidor} · {routeSession.BaseDatos}";
    }

    private async Task EnsureInternalLoginUsersAsync()
    {
        if (!ShowLoginOverlay || !IsInternalSqlLoginContext)
            return;

        var currentBaseId = SessionSvc.GetActiveSession()?.BaseId;
        if (currentBaseId is null)
            return;

        if (_loginUsersLoading)
            return;

        if (_loginUsersLoaded && _loginUsersBaseId == currentBaseId)
            return;

        _loginUsersLoading = true;
        try
        {
            _loginUsers = await LegacyBaseUserSession.GetLoginUsersAsync();
            _loginUsersBaseId = currentBaseId;
            _loginUsersLoaded = true;
            _loginUseUserList = _loginUsers.Count > 0;
            Logger.LogInformation(
                "MainLayout: usuarios de login cargados. BaseId={BaseId}, Count={Count}",
                currentBaseId,
                _loginUsers.Count);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _loginUsers = [];
            _loginUsersBaseId = currentBaseId;
            _loginUsersLoaded = true;
            _loginUseUserList = false;
            Logger.LogWarning(ex, "MainLayout: no se pudo cargar el listado de usuarios de login.");
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _loginUsersLoading = false;
        }
    }

    private bool TryGetRouteBaseId(out int baseId)
    {
        baseId = 0;
        var path = GetNormalizedCurrentPath();
        if (string.IsNullOrWhiteSpace(path))
            return false;

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (segments.Length < 2)
            return false;

        return int.TryParse(segments[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out baseId);
    }

    private string? GetRouteIdWeb()
    {
        var path = GetNormalizedCurrentPath();
        if (string.IsNullOrWhiteSpace(path))
            return null;

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return segments.Length > 0 ? segments[0] : null;
    }

    private void UpdateCurrentModule()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var path = relativePath.Split('?')[0].Split('#')[0].Trim('/');
        var effectivePath = GetEffectiveCurrentPath();
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        var normalized = effectivePath.ToLowerInvariant();

        if (IsLauncherContextRoute(path) || string.IsNullOrWhiteSpace(effectivePath))
        {
            _activeShellModuleKey = string.Empty;
            _currentModule = string.Empty;
            _directModuleKey = string.Empty;
            return;
        }

        if (normalized.StartsWith("shell/", StringComparison.OrdinalIgnoreCase))
        {
            _activeShellModuleKey = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Skip(1).FirstOrDefault() ?? string.Empty;
            _currentModule = string.Empty;
            _directModuleKey = string.Empty;
            return;
        }

        _activeShellModuleKey = string.Empty;

        _currentModule = normalized switch
        {
            "clientes" => "clientes",
            "proveedores" => "proveedores",
            _ => effectivePath.Split('/').FirstOrDefault()?.ToLowerInvariant() ?? string.Empty
        };

        if (query.TryGetValue("directo", out var directo)
            && string.Equals(directo.ToString(), "1", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(_currentModule))
        {
            _directModuleKey = _currentModule;
        }
        else if (string.IsNullOrWhiteSpace(effectivePath) || string.IsNullOrWhiteSpace(_currentModule))
        {
            _directModuleKey = string.Empty;
        }
    }

    private bool TryRedirectToCanonicalHome()
    {
        if (!AppMode.IsSaaSMode)
            return false;

        if (!CanShowLauncherAccess)
            return false;

        var activeSession = SessionSvc.GetActiveSession();
        if (activeSession is null)
            return false;

        var currentPath = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');

        if (!IsLauncherContextRoute(currentPath))
            return false;

        var canonicalHome = BuildLauncherUrl(activeSession);
        var currentCanonical = canonicalHome.Trim('/');

        if (string.Equals(currentPath, currentCanonical, StringComparison.OrdinalIgnoreCase))
            return false;

        Nav.NavigateTo(canonicalHome, replace: true);
        return true;
    }

    private bool EnforceDirectMode()
    {
        if (!IsDirectMode)
            return false;

        var normalizedPath = GetNormalizedCurrentPath();
        var isAllowedModuleRoute = normalizedPath == _directModuleKey
            || normalizedPath.StartsWith($"{_directModuleKey}/", StringComparison.OrdinalIgnoreCase);

        if (isAllowedModuleRoute)
            return false;

        var target = $"/{_directModuleKey}?directo=1";
        Nav.NavigateTo(target);
        return true;
    }

    private string BuildModuleUrl(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return route;

        var normalizedRoute = RouteContext.BuildRoute(route);
        if (!IsDirectMode)
            return normalizedRoute;

        var normalizedModule = RouteContext.BuildRoute("/" + _directModuleKey);
        var belongsToDirectModule = string.Equals(normalizedRoute, normalizedModule, StringComparison.OrdinalIgnoreCase)
            || normalizedRoute.StartsWith(normalizedModule + "/", StringComparison.OrdinalIgnoreCase);

        return belongsToDirectModule ? AppendDirectFlag(normalizedRoute) : normalizedRoute;
    }

    private static string AppendDirectFlag(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return route;

        if (route.Contains("directo=1", StringComparison.OrdinalIgnoreCase))
            return route;

        return route.Contains('?', StringComparison.Ordinal)
            ? route + "&directo=1"
            : route + "?directo=1";
    }

    private void ResetMenuSearchCatalog()
    {
        _mainMenuModules = [];
        _menuSearchCatalog = [];
        _menuSearchText = string.Empty;
        _menuSearchError = string.Empty;
        _menuSearchLoaded = false;
        _menuSearchLoading = false;
    }

    private async Task EnsureMenuSearchCatalogAsync()
    {
        if (!ShowShellContext || _menuSearchLoaded || _menuSearchLoading)
            return;

        _menuSearchLoading = true;
        _menuSearchError = string.Empty;

        try
        {
            _mainMenuModules = (await MenuSvc.GetModulesAsync()).ToList();
            _menuSearchCatalog = (await MenuSvc.GetSearchItemsAsync()).ToList();
            if (_mainMenuModules.Count == 0)
            {
                _mainMenuModules = GetFallbackMainMenuModules().ToList();
                _menuSearchCatalog = BuildSearchCatalogFromModules(_mainMenuModules).ToList();
                _menuSearchError = "Se usó un catálogo de respaldo porque no respondió el menú dinámico.";
            }
            _menuSearchLoaded = true;
        }
        catch
        {
            _mainMenuModules = GetFallbackMainMenuModules().ToList();
            _menuSearchCatalog = BuildSearchCatalogFromModules(_mainMenuModules).ToList();
            _menuSearchError = "Se usó un catálogo de respaldo porque no respondió el menú dinámico.";
            _menuSearchLoaded = true;
        }
        finally
        {
            _menuSearchLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<ShellMenuSearchItemDto> GetFilteredMenuSearchResults()
    {
        var query = _menuSearchText?.Trim();
        if (string.IsNullOrWhiteSpace(query))
            return [];

        var tokens = query
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => x.ToLowerInvariant())
            .ToArray();
        if (tokens.Length == 0)
            return [];

        static int ScoreItem(ShellMenuSearchItemDto item, string rawQuery, string[] tokens)
        {
            var name = item.Nombre.ToLowerInvariant();
            var description = item.Descripcion.ToLowerInvariant();
            var clave = item.Clave.ToLowerInvariant();
            var observacion = item.Observacion.ToLowerInvariant();
            var full = $"{name} {description} {clave} {observacion}";

            if (!tokens.All(full.Contains))
                return int.MaxValue;

            if (name.StartsWith(rawQuery, StringComparison.OrdinalIgnoreCase))
                return item.EsModulo ? 0 : 1;

            if (name.Contains(rawQuery, StringComparison.OrdinalIgnoreCase))
                return item.EsModulo ? 2 : 3;

            if (description.Contains(rawQuery, StringComparison.OrdinalIgnoreCase))
                return 4;

            return 5;
        }

        return _menuSearchCatalog
            .Select(x => new { Item = x, Score = ScoreItem(x, query.ToLowerInvariant(), tokens) })
            .Where(x => x.Score < int.MaxValue)
            .OrderBy(x => x.Score)
            .ThenBy(x => x.Item.ModuloNombre)
            .ThenBy(x => x.Item.Nombre)
            .Take(8)
            .Select(x => x.Item)
            .ToArray();
    }

