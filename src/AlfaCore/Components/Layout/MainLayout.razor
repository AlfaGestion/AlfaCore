                @ModuleBackLink

                <p class="menu__section">Usuarios</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/usuarios")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Gestión de usuarios</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "seguridad")
            {
                @ModuleBackLink

                <p class="menu__section">Seguridad</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/usuarios")">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
