    private async Task OnPushEnabledChanged(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        _pushPreferences.Habilitadas = enabled;
        if (!enabled)
        {
            await DisablePushAsync();
            return;
        }

        await EnablePushAsync();
    }

    private async Task EnablePushAsync()
    {
        _pushBusy = true;
        _pushMessage = string.Empty;
        _pushError = string.Empty;
        try
        {
            if (!_pushConfigured)
                throw new InvalidOperationException(string.IsNullOrWhiteSpace(_pushConfigurationMessage)
                    ? "Faltan configurar las claves VAPID en el servidor."
                    : _pushConfigurationMessage);
            if (!_pwaPushSupported)
                throw new InvalidOperationException("Este navegador no soporta notificaciones push web.");
            if (_pwaIsIos && !_pwaInstalled)
                throw new InvalidOperationException("En iOS las notificaciones web requieren instalar AlfaCore en pantalla de inicio. Primero usÃ¡ Compartir > Agregar a pantalla de inicio.");

            var subscription = await JS.InvokeAsync<NotificacionesPushSubscriptionDto>("alfaCorePwa.subscribePush", _pushPublicKey);
            await JS.InvokeVoidAsync("alfaCorePwa.savePushSubscription", subscription);
            await SavePushPreferencesAsync();
            _pushMessage = "Notificaciones activadas en este dispositivo.";
        }
        catch (Exception ex)
        {
            await LogBrowserPushErrorAsync("EnablePush", ex);
            _pushPreferences.Habilitadas = false;
            _pushError = ex.Message;
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private async Task DisablePushAsync()
    {
        _pushBusy = true;
        _pushMessage = string.Empty;
        _pushError = string.Empty;
        try
        {
            await JS.InvokeVoidAsync("alfaCorePwa.unsubscribePush");
            await JS.InvokeVoidAsync("alfaCorePwa.deletePushSubscription");
            await SavePushPreferencesAsync();
            _pushMessage = "Notificaciones desactivadas en este dispositivo.";
        }
        catch (Exception ex)
        {
            await LogBrowserPushErrorAsync("DisablePush", ex);
            _pushError = $"No se pudo desactivar la suscripciÃ³n push. {ex.Message}";
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private async Task SavePushPreferencesAsync()
    {
        _pushBusy = true;
        _pushMessage = string.Empty;
        _pushError = string.Empty;
        try
        {
            await JS.InvokeVoidAsync("alfaCorePwa.savePushPreferences", _pushPreferences);
            _pushMessage = "Preferencias guardadas.";
        }
        catch (Exception ex)
        {
            await LogBrowserPushErrorAsync("SavePushPreferences", ex);
            _pushError = $"No se pudieron guardar las preferencias. {ex.Message}";
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private async Task SendTestPushAsync()
    {
        _pushBusy = true;
        _pushMessage = string.Empty;
        _pushError = string.Empty;
        try
        {
            if (!_pushConfigured)
                throw new InvalidOperationException(string.IsNullOrWhiteSpace(_pushConfigurationMessage)
                    ? "Faltan configurar las claves VAPID en el servidor."
                    : _pushConfigurationMessage);

            var result = await JS.InvokeAsync<NotificacionesPushSendResultDto>("alfaCorePwa.sendTestPush");
            _pushLastTestSummary = $"Total: {result.TotalCount} · OK: {result.SuccessCount} · Fallidos: {result.FailCount}";
            _pushMessage = _pushLastTestSummary;
            if (result.TotalCount == 0)
                _pushError = "No hay suscripciones push activas para este usuario/dispositivo.";
            else if (result.FailCount > 0)
                _pushError = BuildPushSendError(result);
        }
        catch (Exception ex)
        {
            _pushLastTestSummary = $"Falló: {ex.Message}";
            await LogBrowserPushErrorAsync("SendTestPush", ex);
            _pushError = ex.Message;
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private async Task LoadPushDiagnosticsAsync()
    {
        _pushBusy = true;
        _pushMessage = string.Empty;
        _pushError = string.Empty;
        try
        {
            var client = await JS.InvokeAsync<PwaPushClientDiagnostics>("alfaCorePwa.getPushClientDiagnostics", _pushPublicKey);
            var server = await JS.InvokeAsync<NotificacionesPushDiagnosticsDto>("alfaCorePwa.fetchPushDiagnostics");
            _pushDiagnostics = new PushDiagnosticsVm
            {
                Https = client.Https,
                ServiceWorkerReady = client.ServiceWorkerReady,
                PushSupported = client.PushSupported,
                NotificationPermission = client.NotificationPermission,
                DeviceId = client.DeviceId,
                PublicKeyPreview = client.PublicKeyPreview,
                IsBrave = client.IsBrave,
                SubscriptionCount = server.SubscriptionCount,
                ActiveSubscriptionCount = server.ActiveSubscriptionCount,
                Preferences = server.Preferences ?? new(),
                Subscriptions = server.Subscriptions ?? []
            };
            _pushDiagnosticsLastProviderError = _pushDiagnostics.Subscriptions
                .Where(x => !string.IsNullOrWhiteSpace(x.Error))
                .Select(x => x.Error)
                .FirstOrDefault() ?? string.Empty;
            _pushMessage = "Diagnóstico actualizado.";
        }
        catch (Exception ex)
        {
            await LogBrowserPushErrorAsync("LoadPushDiagnostics", ex);
            _pushError = $"No se pudo cargar el diagnóstico push. {ex.Message}";
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private static string BuildPushSendError(NotificacionesPushSendResultDto? result)
    {
        if (result is null)
            return "El backend no devolviÃ³ resultado del envÃ­o push.";

        var firstError = result.Results.FirstOrDefault(x => !x.Success);
        if (firstError is not null)
            return $"Fallaron {result.FailCount} dispositivo(s). Endpoint: {firstError.EndpointParcial}. Status: {(firstError.StatusCode?.ToString() ?? "-")}. Error: {DisplayOrDash(firstError.Error)}";

        return result.TotalCount == 0
            ? "No hay suscripciones push activas para enviar."
            : $"Fallaron {result.FailCount} dispositivo(s). RevisÃ¡ el diagnÃ³stico de notificaciones.";
    }

    private bool PushChannelEnabled(string channel)
        => _pushPreferences.Canales.Contains(channel, StringComparer.OrdinalIgnoreCase);

    private static string DisplayOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private void TogglePushChannel(string channel, ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        _pushPreferences.Canales.RemoveAll(x => string.Equals(x, channel, StringComparison.OrdinalIgnoreCase));
        if (enabled)
            _pushPreferences.Canales.Add(channel);
    }

    private async Task LogBrowserPushErrorAsync(string action, Exception ex)
    {
        try
        {
            await AppEvents.LogErrorAsync(
                "PWA",
                action,
                ex,
                "FallÃ³ una operaciÃ³n de instalaciÃ³n o notificaciones web.",
                new
                {
                    _pwaCanInstall,
                    _pwaInstalled,
                    _pwaIsIos,
                    _pwaPushSupported,
                    _pwaNotificationPermission,
                    _pushConfigured
                });
        }
        catch
        {
        }
    }


