@inherits LayoutComponentBase
@inject IJSRuntime JS
@using System.Globalization
@using AlfaCore.Models
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IMenuService MenuSvc
@inject AlfaCore.Services.IRecentService RecentSvc
@inject AlfaCore.Services.IConversacionesService ConversacionesSvc
@inject AlfaCore.Services.ITareasService TareasSvc
@inject AlfaCore.Services.IAppEventService AppEvents
@inject AlfaCore.Services.IFloatingWindowService FloatingWindows
@implements IDisposable

@if (IsPosFullscreenRoute)
{
    <div class="pos-layout-host" @onclick="CloseFloatingWindowsAsync">
        @Body
    </div>
}
else
{
<div class="@ShellClass" @onclick="CloseFloatingWindowsAsync">
    @if (_mobileSidebarOpen)
    {
        <button type="button"
                class="shell__overlay no-print"
                aria-label="Cerrar menú"
                @onclick="CloseMobileSidebar"></button>
    }

    <aside class="shell__sidebar" aria-label="Menú principal">
        <div class="brand">
            @if (CanShowLauncherAccess)
            {
                <a class="brand__logo-link" href="/" title="Volver al menú principal" aria-label="Volver al menú principal" @onclick="GoToLauncher">
                    <img class="brand__logo" src="logo.png" alt="Alfa Gestión" />
                </a>
            }
            else
            {
                <span class="brand__logo-link brand__logo-link--static" aria-hidden="true">
                    <img class="brand__logo" src="logo.png" alt="Alfa Gestión" />
                </span>
            }
            <div class="brand__content">
                <p class="brand__eyebrow">Business Intelligence</p>
                @if (CanShowLauncherAccess)
                {
                    <a class="brand__title" href="/" @onclick="GoToLauncher">Alfa Gestión</a>
                }
                else
                {
                    <span class="brand__title">Alfa Gestión</span>
                }
            </div>
            @if (ShowLauncherContext)
            {
                <span class="sidebar-toggle sidebar-toggle--static" title="Menú principal desplegado" aria-hidden="true">
                    <i class="bi bi-layout-sidebar"></i>
                </span>
            }
        </div>

        <div class="menu">
            @if (_currentModule == "consultas")
            {
                @ModuleBackLink

                <p class="menu__section">Consultas</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/consultas")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-table"></i></span>
                        <span>Mis consultas</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/consultas/nueva")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-plus-circle"></i></span>
                        <span>Nueva consulta</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "costos")
            {
                @ModuleBackLink

                <p class="menu__section">Actualización de Costos</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/costos")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-currency-dollar"></i></span>
                        <span>Inicio</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/costos/nueva")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-upload"></i></span>
                        <span>Nueva importación</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/costos/perfiles")">
                        <span class="menu__icon"><i class="bi bi-sliders"></i></span>
                        <span>Perfiles</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/costos/historial")">
                        <span class="menu__icon"><i class="bi bi-clock-history"></i></span>
                        <span>Historial</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "auditoria")
            {
                @ModuleBackLink

                <p class="menu__section">Auditoría</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/auditoria")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-shield-exclamation"></i></span>
                        <span>Resumen</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/auditoria/errores")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-bug"></i></span>
                        <span>Auditoría de errores</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/auditoria/usuarios")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-person-check"></i></span>
                        <span>Auditoría de usuarios</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "conversaciones")
            {
                @ModuleBackLink

                <p class="menu__section">Conversaciones</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/conversaciones")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-chat-dots-fill"></i></span>
                        <span>Inbox</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/conversaciones/plantillas")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-chat-square-text-fill"></i></span>
                        <span>Plantillas</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/conversaciones/configuracion")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-sliders"></i></span>
                        <span>Configuración</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/conversaciones/estadisticas")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span>Estadisticas</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "tickets")
            {
                @ModuleBackLink

                <p class="menu__section">Tickets de asistencia</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/tickets")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-life-preserver"></i></span>
                        <span>Mesa de ayuda</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "calendario")
            {
                @ModuleBackLink

                <p class="menu__section">Calendario</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/calendario")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-calendar3"></i></span>
                        <span>Guardias</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/calendario/reuniones")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-camera-video"></i></span>
                        <span>Reuniones</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "carga-viajes")
            {
                @ModuleBackLink

                <p class="menu__section">Logística</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-truck"></i></span>
                        <span>Viajes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes/nuevo")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-plus-circle"></i></span>
                        <span>Nuevo viaje</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes/tarifas")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-tags"></i></span>
                        <span>Tarifas</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes/choferes")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-person-badge"></i></span>
                        <span>Choferes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes/destinos")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-geo-alt"></i></span>
                        <span>Destinos</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes/tipo-vehiculo")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-truck"></i></span>
                        <span>Tipo vehículo</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes/reportes")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-bar-chart-line"></i></span>
                        <span>Reportes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/carga-viajes/configuracion")" Match="NavLinkMatch.Prefix">
                        <span class="menu__icon"><i class="bi bi-sliders"></i></span>
                        <span>Configurar carga de viaje</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "informes")
            {
                @ModuleBackLink

                <p class="menu__section">Informes</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/informes")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-journal-richtext"></i></span>
                        <span>Articulos</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "interfaces")
            {
                @ModuleBackLink

                <p class="menu__section">Interfaces</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/interfaces")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-folder2-open"></i></span>
                        <span>Recepción documental</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/interfaces/configuracion")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-sliders"></i></span>
                        <span>Configuración</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "actualizaciones")
            {
                @ModuleBackLink

                <p class="menu__section">Actualizaciones</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/actualizaciones")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-cloud-arrow-up"></i></span>
                        <span>Base de datos</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "usuarios")
            {
                @ModuleBackLink

                <p class="menu__section">Usuarios</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/usuarios")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Gestión de usuarios</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "seguridad")
            {
                @ModuleBackLink

                <p class="menu__section">Seguridad</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/usuarios")">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Usuarios</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/seguridad/autorizacion-tareas")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-shield-lock-fill"></i></span>
                        <span>Autorización de tareas</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/auditoria")">
                        <span class="menu__icon"><i class="bi bi-clipboard2-check"></i></span>
                        <span>Reporte de auditoría</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "contactos")
            {
                @ModuleBackLink

                <p class="menu__section">Contactos</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/contactos")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-person-lines-fill"></i></span>
                        <span>Agenda de contactos</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "clientes")
            {
                @ModuleBackLink

                <p class="menu__section">Clientes</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/clientes")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Maestro de clientes</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "tecnicos")
            {
                @ModuleBackLink

                <p class="menu__section">Técnicos</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/tecnicos")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-tools"></i></span>
                        <span>Técnicos</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "ventas")
            {
                @ModuleBackLink

                <p class="menu__section">Ventas</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-graph-up-arrow"></i></span>
                        <span>Inicio</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/clientes")">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Clientes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/rubros")">
                        <span class="menu__icon"><i class="bi bi-tag-fill"></i></span>
                        <span>Rubros</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/familias")">
                        <span class="menu__icon"><i class="bi bi-collection-fill"></i></span>
                        <span>Familias</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/articulos")">
                        <span class="menu__icon"><i class="bi bi-box-fill"></i></span>
                        <span>Artículos</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/comprobantes")">
                        <span class="menu__icon"><i class="bi bi-receipt"></i></span>
                        <span>Comprobantes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/comparativo")">
                        <span class="menu__icon"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span>Comparativo</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "stock")
            {
                @ModuleBackLink

                <p class="menu__section">Stock</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/stock")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-box-seam"></i></span>
                        <span>Resumen</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "caja-bancos")
            {
                @ModuleBackLink

                <p class="menu__section">Caja y Bancos</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/caja-bancos")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-bank"></i></span>
                        <span>Resumen</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "contabilidad")
            {
                @ModuleBackLink

                <p class="menu__section">Contabilidad</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/contabilidad")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-journal-bookmark-fill"></i></span>
                        <span>Resumen</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/contabilidad/posicion-iva")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-receipt"></i></span>
                        <span>Posición de IVA</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "proveedores")
            {
                @ModuleBackLink

                <p class="menu__section">Proveedores</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/proveedores")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Maestro de proveedores</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "compras")
            {
                @ModuleBackLink

                <p class="menu__section">Compras</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-house-fill"></i></span>
                        <span>Inicio</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/proveedores")">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Proveedores</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/comprobantes")">
                        <span class="menu__icon"><i class="bi bi-receipt"></i></span>
                        <span>Comprobantes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/rubros")">
                        <span class="menu__icon"><i class="bi bi-tag-fill"></i></span>
                        <span>Rubros</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/familias")">
                        <span class="menu__icon"><i class="bi bi-collection-fill"></i></span>
                        <span>Familias</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/articulos")">
                        <span class="menu__icon"><i class="bi bi-box-fill"></i></span>
                        <span>Artículos</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/actividad")">
                        <span class="menu__icon"><i class="bi bi-bar-chart-steps"></i></span>
                        <span>Actividad</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/informesia")">
                        <span class="menu__icon"><i class="bi bi-stars"></i></span>
                        <span>InformesIA</span>
                    </NavLink>
                </nav>
            }
            else if (!IsDirectMode)
            {
                <p class="menu__section">Aplicaciones</p>
                <nav class="menu__nav">
                    @if (ShowShellContext)
                    {
                        <a class="menu__link menu__link--module" href="/#favoritos">
                            <span class="menu__icon"><i class="bi bi-star-fill"></i></span>
                            <span>Favoritos</span>
                        </a>
                    }

                    @if (_menuSearchLoading || (!_menuSearchLoaded && ShowShellContext))
                    {
                        <div class="menu__link menu__link--disabled">
                            <span class="menu__icon"><i class="bi bi-hourglass-split"></i></span>
                            <span>Cargando módulos...</span>
                        </div>
                    }
                    else if (_mainMenuModules.Count == 0)
                    {
                        <div class="menu__link menu__link--disabled">
                            <span class="menu__icon"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                            <span>Sin módulos visibles</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var module in _mainMenuModules)
                        {
                            <a class="@GetMainMenuModuleClass(module)"
                               href="@module.RutaWeb"
                               title="@module.Nombre"
                               @onclick="(() => NavigateToModule(module.RutaWeb))">
                                <span class="menu__icon"><i class="bi @(string.IsNullOrWhiteSpace(module.Icono) ? "bi-grid" : module.Icono)"></i></span>
                                <span>@module.Nombre</span>
                            </a>
                        }
                    }
                </nav>

                <div class="menu__search" @onclick:stopPropagation="true">
                    <label class="menu__search-label" for="main-menu-search">Buscar opción</label>
                    <div class="menu__search-box">
                        <span class="menu__search-icon"><i class="bi bi-search"></i></span>
                        <input id="main-menu-search"
                               class="menu__search-input"
                               type="search"
                               placeholder="Ventas, clientes, auditoría..."
                               @bind="_menuSearchText"
                               @bind:event="oninput"
                               @onfocus="EnsureMenuSearchCatalogAsync" />
                        @if (!string.IsNullOrWhiteSpace(_menuSearchText))
                        {
                            <button type="button"
                                    class="menu__search-clear"
                                    aria-label="Limpiar búsqueda"
                                    @onclick="ClearMenuSearch">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>

                    @if (_menuSearchLoading)
                    {
                        <p class="menu__search-state">Preparando opciones del menú...</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_menuSearchError))
                    {
                        <p class="menu__search-state menu__search-state--error">@_menuSearchError</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_menuSearchText))
                    {
                        <div class="menu__search-results">
                            @if (FilteredMenuSearchResults.Count == 0)
                            {
                                <p class="menu__search-state">No se encontraron opciones para "@_menuSearchText".</p>
                            }
                            else
                            {
                                @foreach (var item in FilteredMenuSearchResults)
                                {
                                    <button type="button"
                                            class="menu__search-result"
                                            @onclick="() => OpenMenuSearchResultAsync(item)">
                                        <span class="menu__search-result-icon">
                                            <i class="bi @item.Icono"></i>
                                        </span>
                                        <span class="menu__search-result-body">
                                            <span class="menu__search-result-title">@item.Nombre</span>
                                            <span class="menu__search-result-meta">@item.Descripcion</span>
                                        </span>
                                        <span class="menu__search-result-kind">@(item.EsModulo ? "Módulo" : "Opción")</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }

            @if (!IsDirectMode)
            {
            <div class="menu__footer">
                @if (string.IsNullOrWhiteSpace(_currentModule))
                {
                    @if (_pwaCanInstall)
                    {
                        <button type="button" class="menu__link menu__button" @onclick="InstallPwaAsync">
                            <span class="menu__icon"><i class="bi bi-download"></i></span>
                            <span>Instalar AlfaCore</span>
                        </button>
                    }
                    else if (_pwaIsIos && !_pwaInstalled)
                    {
                        <button type="button" class="menu__link menu__button" @onclick="ToggleInstallHelp">
                            <span class="menu__icon"><i class="bi bi-phone"></i></span>
                            <span>Instalar app</span>
                        </button>
                    }
                    @if (AppUserSession.IsAuthenticated)
                    {
                        <button type="button" class="menu__link menu__button" @onclick="TogglePushPanelAsync">
                            <span class="menu__icon"><i class="bi bi-bell-fill"></i></span>
                            <span>Notificaciones</span>
                        </button>
                    }
                }
                @if (CanShowTasksPanel)
                {
                    <button type="button" class="menu__link menu__button menu__link--help @(_tasksPanelOpen ? "is-active" : string.Empty)" @onclick="ToggleTasksPanelAsync">
                        <span class="menu__icon"><i class="bi bi-check2-circle"></i></span>
                        <span>Tareas</span>
                    </button>
                }
                <NavLink class="menu__link menu__link--help" href="@(_currentModule == "consultas" ? "/ayuda?topic=consultas" : "/ayuda")">
                    <span class="menu__icon"><i class="bi bi-question-circle-fill"></i></span>
                    <span>Ayuda</span>
                </NavLink>
            </div>
            }
        </div>
    </aside>

    <main class="shell__main">
        <header class="shell__header">
            <button type="button"
                    class="shell__mobile-toggle no-print"
                    @onclick="ToggleMobileSidebar"
                    aria-label="Abrir menú"
                    aria-expanded="@_mobileSidebarOpen">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <p class="shell__eyebrow">Alfa Gestión</p>
                <p class="shell__module">@GetModuleTitle()</p>
            </div>
            @if (ShowLauncherContext)
            {
                <div class="shell__actions">
                    <button type="button" class="btn btn--ghost no-print" @onclick="ToggleThemeAsync" title="@(_isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro")">
                        <i class="bi @(_isDark ? "bi-sun" : "bi-moon")"></i>
                    </button>
                    @if (_currentModule == "compras")
                    {
                        <button type="button" class="btn btn--ghost shell__print no-print" @onclick="ExportCurrentPageToPdfAsync" title="Exportar pantalla actual a PDF">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>Exportar PDF</span>
                        </button>
                    }
                    <button class="session-chip no-print" @onclick="() => _drawerOpen = true" title="Gestionar sesiones de base de datos">
                        <span class="session-chip__dot"></span>
                        <span class="session-chip__text">@(_activeSession?.Servidor ?? "—") · @(_activeSession?.BaseDatos ?? "—")</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (AppUserSession.IsAuthenticated && AppUserSession.CurrentUser is not null)
                    {
                        <button type="button" class="session-chip no-print" @onclick="LogoutAppUser" title="Cerrar sesión del sistema">
                            <span class="session-chip__dot"></span>
                            <span class="session-chip__text">@AppUserSession.CurrentUser.UserName</span>
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    }
                    <div class="shell__status">
                        <span class="shell__dot"></span>
                        <span>Actualizado en tiempo real</span>
                        <span class="shell__date">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                        <a class="help-btn no-print" href="@(_currentModule == "consultas" ? "/ayuda?topic=consultas" : "/ayuda")" title="Manual de usuario">
                            <i class="bi bi-question-circle"></i>
                        </a>
                    </div>
                </div>
            }
        </header>

        @if (ShouldShowConversationMobilePwaActions)
        {
            <div class="pwa-mobile-actions no-print">
                @if (_pwaInstalled)
                {
                    <span class="pwa-mobile-actions__status">
                        <i class="bi bi-check2-circle"></i>
                        App instalada
                    </span>
                }
                else
                {
                    <button type="button" class="btn btn--ghost pwa-mobile-actions__button" @onclick="InstallPwaAsync">
                        <i class="bi bi-download"></i>
                        <span>Instalar app</span>
                    </button>
                }

                @if (AppUserSession.IsAuthenticated)
                {
                    <button type="button" class="btn btn--primary pwa-mobile-actions__button" @onclick="TogglePushPanelAsync">
                        <i class="bi bi-bell-fill"></i>
                        <span>Notificaciones</span>
                    </button>
                }
            </div>
        }

        <section class="shell__content">
            <div class="print-banner print-only">
                <div>
                    <p class="print-banner__eyebrow">Dashboard de Compras</p>
                    <h2 class="print-banner__title">@CurrentPageTitle</h2>
                </div>
                <p class="print-banner__meta">Exportado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            @Body
        </section>
    </main>
</div>
}

@if (!IsPosFullscreenRoute && ShouldShowConversationNotice)
{
    <button type="button"
            class="global-message-notice no-print"
            @onclick="OpenGlobalConversationNotice"
            title="Abrir conversación">
        <span class="global-message-notice__icon">
            <i class="bi bi-whatsapp"></i>
        </span>
        <span class="global-message-notice__body">
            <strong>@GlobalConversationNoticeTitle</strong>
