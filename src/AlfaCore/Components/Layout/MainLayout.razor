    private async Task DropTasksPanelNoteAsync(TareaNotaRapidaDto target)
    {
        if (_tasksPanelDraggedNoteId is not long draggedId || draggedId == target.IdNota)
            return;

        await ReorderTasksPanelNotesAsync(draggedId, target.IdNota);
    }

    private bool CanMoveTasksPanelNote(TareaNotaRapidaDto nota, int direction)
    {
        if (!nota.EsPropia || nota.Completada)
            return false;

        var open = TasksPanelOpenNotes;
        var index = open.FindIndex(x => x.IdNota == nota.IdNota);
        var targetIndex = index + direction;
        return index >= 0 && targetIndex >= 0 && targetIndex < open.Count;
    }

    private async Task MoveTasksPanelNoteAsync(TareaNotaRapidaDto nota, int direction)
    {
        var open = TasksPanelOpenNotes;
        var index = open.FindIndex(x => x.IdNota == nota.IdNota);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= open.Count)
            return;

        open.RemoveAt(index);
        open.Insert(targetIndex, nota);
        await SaveTasksPanelNoteOrderAsync(open.Select(x => x.IdNota).ToArray());
    }

    private async Task ReorderTasksPanelNotesAsync(long draggedId, long targetId)
    {
        var open = TasksPanelOpenNotes;
        var dragged = open.FirstOrDefault(x => x.IdNota == draggedId);
        if (dragged is null || !dragged.EsPropia)
            return;

        var oldIndex = open.FindIndex(x => x.IdNota == draggedId);
        var newIndex = open.FindIndex(x => x.IdNota == targetId);
        if (oldIndex < 0 || newIndex < 0)
            return;

        open.RemoveAt(oldIndex);
        open.Insert(newIndex, dragged);
        await SaveTasksPanelNoteOrderAsync(open.Select(x => x.IdNota).ToArray());
    }

