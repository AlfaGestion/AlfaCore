@inject AlfaCore.Services.IFloatingWindowService FloatingWindows
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject ILogger<MainLayout> Logger
@implements IDisposable

@if (_isInitializing)
{
    <div class="shell__initial-loading">
        <AppLoadingFrame Title="@(_initializationErrorMessage is null ? "Cargando sistema..." : "No se pudo cargar el sistema")"
                         Subtitle="@(_initializationErrorMessage ?? "Resolviendo la sesión, la base activa y el contexto inicial.")" />
    </div>
}
else if (IsPosFullscreenRoute)
{
    <div class="pos-layout-host" @onclick="CloseFloatingWindowsAsync">
        @Body
    </div>
}
else
{
<div class="@ShellClass" @onclick="CloseFloatingWindowsAsync">
    @if (_mobileSidebarOpen)
    {
        <button type="button"
                class="shell__overlay no-print"
                aria-label="Cerrar menú"
                @onclick="CloseMobileSidebar"></button>
    }

    <aside class="shell__sidebar" aria-label="Menú principal">
        <div class="brand">
            @if (CanShowLauncherAccess)
            {
                <a class="brand__logo-link" href="@GetLauncherUrl()" title="Volver al menú principal" aria-label="Volver al menú principal" @onclick="GoToLauncher">
                    <img class="brand__logo" src="/logos/Logo.png" alt="Alfa Gestión" />
                </a>
            }
            else
            {
                <span class="brand__logo-link brand__logo-link--static" aria-hidden="true">
                    <img class="brand__logo" src="/logos/Logo.png" alt="Alfa Gestión" />
                </span>
            }
            <div class="brand__content">
                <p class="brand__eyebrow">Business Intelligence</p>
                @if (CanShowLauncherAccess)
                {
                    <a class="brand__title" href="@GetLauncherUrl()" @onclick="GoToLauncher">Alfa Gestión</a>
                }
                else
                {
                    <span class="brand__title">Alfa Gestión</span>
                }
            </div>
            <button type="button"
                    class="sidebar-toggle no-print"
                    title="@SidebarToggleTitle"
                    aria-label="@SidebarToggleTitle"
                    aria-expanded="@(!IsSidebarCollapsed)"
                    @onclick="ToggleSidebarCollapsed"
                    @onclick:stopPropagation="true">
                <i class="bi @SidebarToggleIcon"></i>
            </button>
        </div>

