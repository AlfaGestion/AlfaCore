    private static IReadOnlyList<ShellMenuSearchItemDto> BuildSearchCatalogFromModules(IEnumerable<ShellModuleDto> modules)
        => modules
            .Select(module => new ShellMenuSearchItemDto
            {
                Menu = module.Menu,
                Clave = module.Clave,
                Nombre = module.Nombre,
                RutaWeb = module.RutaWeb,
                Icono = string.IsNullOrWhiteSpace(module.Icono) ? "bi-grid-3x3-gap-fill" : module.Icono,
                ModuloNombre = module.Nombre,
                SeccionNombre = "Módulo raíz",
                Descripcion = $"Acceso al módulo raíz {module.Nombre}.",
                EsModulo = true
            })
            .ToArray();

    private string GetMainMenuModuleClass(ShellModuleDto module)
    {
        var css = "menu__link menu__link--module";
        if (!string.IsNullOrWhiteSpace(_activeShellModuleKey)
            && string.Equals(_activeShellModuleKey, module.Clave, StringComparison.OrdinalIgnoreCase))
        {
            css += " active";
        }

        return css;
    }

