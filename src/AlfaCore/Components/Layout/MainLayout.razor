                    }
                    else
                    {
                        @foreach (var sub in _pushDiagnostics.Subscriptions)
                        {
                            <p class="app-modal__hint">[@sub.DeviceId] @sub.EndpointParcial Â· status: @(sub.StatusCode?.ToString() ?? "-") Â· error: @DisplayOrDash(sub.Error)</p>
                        }
                    }
                </div>
                <div class="field">
                    <label>Preferencias y Ãºltimo test</label>
                    <p class="app-modal__hint">Alcance: @_pushDiagnostics.Preferences.Alcance Â· Canales: @string.Join(", ", _pushDiagnostics.Preferences.Canales)</p>
                    <p class="app-modal__hint">Ãšltimo envÃ­o de prueba: @_pushLastTestSummary</p>
                    <p class="app-modal__hint">Ãšltimo error del proveedor push: @DisplayOrDash(_pushDiagnosticsLastProviderError)</p>
                </div>
            </div>
        }

        @if (_pwaIsIos && !_pwaInstalled)
        {
            <p class="app-modal__hint">En iOS las notificaciones web requieren instalar AlfaCore en pantalla de inicio. Primero usÃ¡ Compartir &gt; Agregar a pantalla de inicio y abrÃ­ la app desde ese Ã­cono.</p>
        }
        else if (!_pwaPushSupported)
        {
            <p class="app-modal__hint">Este navegador no informa soporte para notificaciones push web.</p>
        }
        else if (!_pushConfigured)
        {
            <p class="app-modal__hint">@_pushConfigurationMessage</p>
        }
    </section>
}

