    private string GetNormalizedCurrentPath()
        => Nav.ToBaseRelativePath(Nav.Uri)
            .Split('?')[0]
            .Split('#')[0]
            .Trim('/')
            .ToLowerInvariant();

    private bool IsWorkspaceRoute => GetEffectiveCurrentPath().StartsWith("shell/", StringComparison.OrdinalIgnoreCase);

    private string GetEffectiveCurrentPath()
    {
        var path = GetNormalizedCurrentPath();
        if (!AppMode.IsSaaSMode || string.IsNullOrWhiteSpace(path))
            return path;

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (segments.Length >= 2
            && int.TryParse(segments[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
        {
            return string.Join('/', segments.Skip(2));
        }

        return path;
    }

    private bool IsLauncherContextRoute(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return true;

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (segments.Length == 1
            && !string.IsNullOrWhiteSpace(AppUserSession.CurrentUser?.IdWeb)
            && string.Equals(segments[0], AppUserSession.CurrentUser.IdWeb, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return segments.Length == 2
            && int.TryParse(segments[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out _);
    }

    private async Task<bool> CanShowSaaSClientLandingAsync(string path)
    {
        if (!AppMode.IsSaaSMode || string.IsNullOrWhiteSpace(path))
            return false;

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (segments.Length != 1)
            return false;

        try
        {
            var client = await CentralClientesSvc.GetByIdWebAsync(segments[0]);
            Logger.LogInformation(
                "MainLayout: SaaS landing lookup. IdWeb={IdWeb}, Found={Found}",
                segments[0],
                client is not null);
            return client is not null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "MainLayout: no se pudo validar el cliente SaaS para {IdWeb}", segments[0]);
            return false;
        }
    }

