        _pushPreferences.Canales.RemoveAll(x => string.Equals(x, channel, StringComparison.OrdinalIgnoreCase));
        if (enabled)
            _pushPreferences.Canales.Add(channel);
    }

    private async Task LogBrowserPushErrorAsync(string action, Exception ex)
    {
        try
        {
            await AppEvents.LogErrorAsync(
                "PWA",
                action,
                ex,
                "Falló una operación de instalación o notificaciones web.",
                new
                {
                    _pwaCanInstall,
                    _pwaInstalled,
                    _pwaIsIos,
                    _pwaPushSupported,
                    _pwaNotificationPermission,
                    _pushConfigured
                });
        }
        catch
        {
        }
    }


    private async Task OnRememberCredentialsChangedAsync(bool value)
    {
        _loginRememberCredentials = value;
        if (!value)
        {
            _loginPassword = string.Empty;
            try
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "alfacore_login_user");
                await JS.InvokeVoidAsync("localStorage.removeItem", "alfacore_login_password");
                await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_remember", "false");
            }
            catch { }
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_remember", "true");
            await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_user", _loginUserName ?? string.Empty);
            await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_login_password", _loginPassword ?? string.Empty);
        }
        catch { }
