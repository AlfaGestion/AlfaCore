                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/seguridad/autorizacion-tareas")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-shield-lock-fill"></i></span>
                        <span>Autorización de tareas</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/auditoria")">
                        <span class="menu__icon"><i class="bi bi-clipboard2-check"></i></span>
                        <span>Reporte de auditoría</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "contactos")
            {
                @ModuleBackLink

                <p class="menu__section">Contactos</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/contactos")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-person-lines-fill"></i></span>
                        <span>Agenda de contactos</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "clientes")
            {
                @ModuleBackLink

                <p class="menu__section">Clientes</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/clientes")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Maestro de clientes</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "tecnicos")
            {
                @ModuleBackLink

                <p class="menu__section">Técnicos</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/tecnicos")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-tools"></i></span>
                        <span>Técnicos</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "ventas")
            {
                @ModuleBackLink

                <p class="menu__section">Ventas</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-graph-up-arrow"></i></span>
                        <span>Inicio</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/clientes")">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Clientes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/rubros")">
                        <span class="menu__icon"><i class="bi bi-tag-fill"></i></span>
                        <span>Rubros</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/familias")">
                        <span class="menu__icon"><i class="bi bi-collection-fill"></i></span>
                        <span>Familias</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/articulos")">
                        <span class="menu__icon"><i class="bi bi-box-fill"></i></span>
                        <span>Artículos</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/comprobantes")">
                        <span class="menu__icon"><i class="bi bi-receipt"></i></span>
                        <span>Comprobantes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/ventas/comparativo")">
                        <span class="menu__icon"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span>Comparativo</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "stock")
            {
                @ModuleBackLink

                <p class="menu__section">Stock</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/stock")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-box-seam"></i></span>
                        <span>Resumen</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "caja-bancos")
            {
                @ModuleBackLink

                <p class="menu__section">Caja y Bancos</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/caja-bancos")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-bank"></i></span>
                        <span>Resumen</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "contabilidad")
            {
                @ModuleBackLink

                <p class="menu__section">Contabilidad</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/contabilidad")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-journal-bookmark-fill"></i></span>
                        <span>Resumen</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/contabilidad/posicion-iva")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-receipt"></i></span>
                        <span>Posición de IVA</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "proveedores")
            {
                @ModuleBackLink

                <p class="menu__section">Proveedores</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/proveedores")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Maestro de proveedores</span>
                    </NavLink>
                </nav>
            }
            else if (_currentModule == "compras")
            {
                @ModuleBackLink

                <p class="menu__section">Compras</p>
                <nav class="menu__nav">
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras")" Match="NavLinkMatch.All">
                        <span class="menu__icon"><i class="bi bi-house-fill"></i></span>
                        <span>Inicio</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/proveedores")">
                        <span class="menu__icon"><i class="bi bi-people-fill"></i></span>
                        <span>Proveedores</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/comprobantes")">
                        <span class="menu__icon"><i class="bi bi-receipt"></i></span>
                        <span>Comprobantes</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/rubros")">
                        <span class="menu__icon"><i class="bi bi-tag-fill"></i></span>
                        <span>Rubros</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/familias")">
                        <span class="menu__icon"><i class="bi bi-collection-fill"></i></span>
                        <span>Familias</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/articulos")">
                        <span class="menu__icon"><i class="bi bi-box-fill"></i></span>
                        <span>Artículos</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/actividad")">
                        <span class="menu__icon"><i class="bi bi-bar-chart-steps"></i></span>
                        <span>Actividad</span>
                    </NavLink>
                    <NavLink class="menu__link" href="@BuildModuleUrl("/compras/informesia")">
                        <span class="menu__icon"><i class="bi bi-stars"></i></span>
                        <span>InformesIA</span>
                    </NavLink>
                </nav>
            }
            else if (!IsDirectMode)
            {
                <p class="menu__section">Aplicaciones</p>
                <nav class="menu__nav">
                    @if (ShowShellContext)
                    {
                        <a class="menu__link menu__link--module" href="/#favoritos">
                            <span class="menu__icon"><i class="bi bi-star-fill"></i></span>
                            <span>Favoritos</span>
                        </a>
                    }

                    @if (_menuSearchLoading)
                    {
                        <div class="menu__link menu__link--disabled">
                            <span class="menu__icon"><i class="bi bi-hourglass-split"></i></span>
                            <span>Cargando módulos...</span>
                        </div>
                    }
                    else if (_mainMenuModules.Count == 0)
                    {
                        <div class="menu__link menu__link--disabled">
                            <span class="menu__icon"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                            <span>Sin módulos visibles</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var module in _mainMenuModules)
                        {
                            <a class="@GetMainMenuModuleClass(module)"
                               href="@BuildModuleUrl(module.RutaWeb)"
                               title="@module.Nombre"
                               @onclick="(() => NavigateToModule(module.RutaWeb))">
                                <span class="menu__icon"><i class="bi @(string.IsNullOrWhiteSpace(module.Icono) ? "bi-grid" : module.Icono)"></i></span>
                                <span>@module.Nombre</span>
                            </a>
                        }
                    }
                </nav>

                <div class="menu__search" @onclick:stopPropagation="true">
                    <label class="menu__search-label" for="main-menu-search">Buscar opción</label>
                    <div class="menu__search-box" style="background: rgba(6, 17, 33, .78); border: 1px solid rgba(92, 201, 255, .18);">
                        <span class="menu__search-icon"><i class="bi bi-search"></i></span>
                        <input id="main-menu-search"
                               class="menu__search-input"
                               style="appearance: none; -webkit-appearance: none; background: transparent; color: #e2e8f0; border: 0; box-shadow: none;"
                               type="search"
                               placeholder="Ventas, clientes, auditoría..."
                               @bind="_menuSearchText"
                               @bind:event="oninput"
                               @onfocus="EnsureMenuSearchCatalogAsync" />
                        @if (!string.IsNullOrWhiteSpace(_menuSearchText))
                        {
                            <button type="button"
                                    class="menu__search-clear"
                                    style="background: transparent; color: rgba(196, 212, 237, .72);"
                                    aria-label="Limpiar búsqueda"
                                    @onclick="ClearMenuSearch">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>

                    @if (_menuSearchLoading)
                    {
                        <p class="menu__search-state">Preparando opciones del menú...</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_menuSearchError))
                    {
                        <p class="menu__search-state menu__search-state--error">@_menuSearchError</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_menuSearchText))
                    {
                        <div class="menu__search-results">
                            @if (FilteredMenuSearchResults.Count == 0)
                            {
                                <p class="menu__search-state">No se encontraron opciones para "@_menuSearchText".</p>
                            }
                            else
                            {
                                @foreach (var item in FilteredMenuSearchResults)
                                {
                                    <button type="button"
                                            class="menu__search-result"
                                            @onclick="() => OpenMenuSearchResultAsync(item)">
                                        <span class="menu__search-result-icon">
                                            <i class="bi @item.Icono"></i>
                                        </span>
                                        <span class="menu__search-result-body">
                                            <span class="menu__search-result-title">@item.Nombre</span>
                                            <span class="menu__search-result-meta">@item.Descripcion</span>
                                        </span>
                                        <span class="menu__search-result-kind">@(item.EsModulo ? "Módulo" : "Opción")</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }

            @if (!IsDirectMode)
            {
            <div class="menu__footer">
                @if (string.IsNullOrWhiteSpace(_currentModule))
                {
                    @if (_pwaCanInstall)
                    {
                        <button type="button" class="menu__link menu__button" @onclick="InstallPwaAsync">
                            <span class="menu__icon"><i class="bi bi-download"></i></span>
                            <span>Instalar AlfaCore</span>
                        </button>
                    }
                    else if (_pwaIsIos && !_pwaInstalled)
                    {
                        <button type="button" class="menu__link menu__button" @onclick="ToggleInstallHelp">
                            <span class="menu__icon"><i class="bi bi-phone"></i></span>
                            <span>Instalar app</span>
                        </button>
                    }
                    @if (AppUserSession.IsAuthenticated)
                    {
                        <button type="button" class="menu__link menu__button" @onclick="TogglePushPanelAsync">
                            <span class="menu__icon"><i class="bi bi-bell-fill"></i></span>
                            <span>Notificaciones</span>
                        </button>
                    }
                }
                @if (CanShowTasksPanel)
                {
                    <button type="button" class="menu__link menu__button menu__link--help @(_tasksPanelOpen ? "is-active" : string.Empty)" @onclick="ToggleTasksPanelAsync">
                        <span class="menu__icon"><i class="bi bi-check2-circle"></i></span>
                        <span>Tareas</span>
                    </button>
                }
                <NavLink class="menu__link menu__link--help" href="@(_currentModule == "consultas" ? "/ayuda?topic=consultas" : "/ayuda")">
                    <span class="menu__icon"><i class="bi bi-question-circle-fill"></i></span>
                    <span>Ayuda</span>
                </NavLink>
            </div>
            }
        </div>
    </aside>

    <main class="shell__main">
        <header class="shell__header">
            <button type="button"
                    class="shell__mobile-toggle no-print"
                    style="display:none !important;"
                    @onclick="ToggleMobileSidebar"
                    aria-label="Abrir menú"
                    aria-expanded="@_mobileSidebarOpen">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <p class="shell__eyebrow">Alfa Gestión</p>
                <p class="shell__module">@GetModuleTitle()</p>
            </div>
            @if (ShowLauncherContext)
            {
                <div class="shell__actions">
                    <button type="button" class="btn btn--ghost no-print" @onclick="ToggleThemeAsync" title="@(_isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro")">
                        <i class="bi @(_isDark ? "bi-sun" : "bi-moon")"></i>
                    </button>
                    @if (_currentModule == "compras")
                    {
                        <button type="button" class="btn btn--ghost shell__print no-print" @onclick="ExportCurrentPageToPdfAsync" title="Exportar pantalla actual a PDF">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>Exportar PDF</span>
                        </button>
                    }
                    <button type="button" class="session-chip no-print" @onclick="() => _drawerOpen = true" title="Gestionar sesiones de base de datos">
                        <span class="session-chip__dot"></span>
                        <span class="session-chip__text">@(_activeSession?.Servidor ?? "—") · @(_activeSession?.BaseDatos ?? "—")</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (AppUserSession.IsAuthenticated && AppUserSession.CurrentUser is not null)
                    {
                        <button type="button" class="session-chip no-print" @onclick="OpenLoginOverlayAsync" title="Cambiar usuario o base">
                            <span class="session-chip__dot"></span>
                            <span class="session-chip__text">@AppUserSession.CurrentUser.UserName</span>
                            <i class="bi bi-person-circle"></i>
                        </button>
                    }
                    <div class="shell__status">
                        <span class="shell__dot"></span>
                        <span>Actualizado en tiempo real</span>
                        <span class="shell__date">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                        <a class="help-btn no-print" href="@(_currentModule == "consultas" ? "/ayuda?topic=consultas" : "/ayuda")" title="Manual de usuario">
                            <i class="bi bi-question-circle"></i>
                        </a>
                    </div>
                </div>
            }
        </header>

        @if (ShouldShowConversationMobilePwaActions)
        {
            <div class="pwa-mobile-actions no-print">
                @if (_pwaInstalled)
                {
                    <span class="pwa-mobile-actions__status">
                        <i class="bi bi-check2-circle"></i>
                        App instalada
                    </span>
                }
                else
                {
                    <button type="button" class="btn btn--ghost pwa-mobile-actions__button" @onclick="InstallPwaAsync">
                        <i class="bi bi-download"></i>
                        <span>Instalar app</span>
                    </button>
                }

                @if (AppUserSession.IsAuthenticated)
                {
                    <button type="button" class="btn btn--primary pwa-mobile-actions__button" @onclick="TogglePushPanelAsync">
                        <i class="bi bi-bell-fill"></i>
                        <span>Notificaciones</span>
                    </button>
                }
            </div>
        }

        <section class="shell__content">
            @if (IsWorkspaceRoute)
            {
                <div class="print-banner print-only">
                    <div>
                        <p class="print-banner__eyebrow">Aplicaciones</p>
                        <h2 class="print-banner__title">@CurrentPageTitle</h2>
                    </div>
                    <p class="print-banner__meta">Exportado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            }
            @Body
        </section>
    </main>
</div>
}

@if (!IsPosFullscreenRoute && ShouldShowConversationNotice)
{
    <button type="button"
            class="global-message-notice no-print"
            @onclick="OpenGlobalConversationNotice"
            title="Abrir conversación">
        <span class="global-message-notice__icon">
            <i class="bi bi-whatsapp"></i>
        </span>
        <span class="global-message-notice__body">
            <strong>@GlobalConversationNoticeTitle</strong>
            <span>@GlobalConversationNoticeText</span>
        </span>
        <span class="global-message-notice__count">@_globalConversationUnreadCount</span>
    </button>
}

<SessionDrawer Open="_drawerOpen"
               DarkTheme="_drawerDarkTheme"
               RouteBaseId="_drawerRouteBaseId"
               OnClose="() => _drawerOpen = false" />

@if (CanShowTasksPanel && _tasksPanelOpen)
{
    <button type="button"
            class="tareas-side-backdrop no-print"
            aria-label="Cerrar tareas"
            @onclick="CloseTasksPanel"></button>
}

@if (CanShowTasksPanel)
{
<aside class="tareas-side-panel no-print @(_tasksPanelOpen ? "is-open" : string.Empty)" aria-label="Tareas rápidas">
    <header class="tareas-side-panel__head">
        <div class="tareas-side-panel__title">
            <span>TASKS</span>
            <strong>Rápidas</strong>
        </div>
        <div class="tareas-side-panel__actions">
            <a href="/tareas" title="Ir al módulo de tareas" aria-label="Ir al módulo de tareas" @onclick="CloseTasksPanel">
                <i class="bi bi-box-arrow-up-right"></i>
            </a>
            <button type="button" title="Cerrar" aria-label="Cerrar tareas" @onclick="CloseTasksPanel">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </header>

    <section class="tareas-side-panel__add">
        <i class="bi bi-check2-circle"></i>
        <div class="tareas-side-compose">
            <input @bind="_tasksPanelQuickTitle"
                   @bind:event="oninput"
                   @onkeydown="HandleTasksPanelQuickKeyDown"
                   @onfocus="() => _tasksPanelShowComposerDetails = true"
                   dir="ltr"
                   autocomplete="off"
                   spellcheck="true"
                   style="direction: ltr; unicode-bidi: plaintext; text-align: left;"
                   placeholder="Añadir una tarea" />
            @if (_tasksPanelShowComposerDetails || !string.IsNullOrWhiteSpace(_tasksPanelQuickDetail))
            {
                <textarea @bind="_tasksPanelQuickDetail"
                          @bind:event="oninput"
                          rows="2"
                          placeholder="Detalles"></textarea>
                <div class="tareas-side-compose__actions">
                    <button type="button" @onclick="AddTasksPanelNoteAsync" disabled="@_tasksPanelLoading">
                        Añadir
                    </button>
                    <button type="button" @onclick="CancelTasksPanelCompose">
                        Cancelar
                    </button>
                </div>
            }
        </div>
    </section>

    <section class="tareas-side-panel__body">
        @if (_tasksPanelLoading)
        {
            <div class="tareas-side-panel__empty">Cargando tareas...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_tasksPanelError))
        {
            <div class="tareas-side-panel__empty is-error">@_tasksPanelError</div>
        }
        else
        {
            @if (TasksPanelOpenNotes.Count > 0)
            {
                <p class="tareas-side-panel__group">Para hoy</p>
                <div class="tareas-side-list">
                    @foreach (var nota in TasksPanelOpenNotes)
                    {
                        <article class="tareas-side-row @(_tasksPanelDraggedNoteId == nota.IdNota ? "is-dragging" : string.Empty) @(_tasksPanelDragOverNoteId == nota.IdNota ? "is-drag-over" : string.Empty) @(_tasksPanelEditingNoteId == nota.IdNota ? "is-editing" : string.Empty)"
                                 draggable="@nota.EsPropia"
                                 @ondragstart="() => StartTasksPanelNoteDrag(nota)"
                                 @ondragend="ClearTasksPanelNoteDrag"
                                 @ondragenter="() => SetTasksPanelDragOver(nota)"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => DropTasksPanelNoteAsync(nota)">
                            <span class="tareas-side-drag" title="Arrastrar para ordenar" aria-hidden="true">
                                <i class="bi bi-grip-vertical"></i>
                            </span>
                            <button type="button" class="tareas-side-check" title="Marcar como hecha" @onclick="() => CompleteTasksPanelNoteAsync(nota)">
                                <i class="bi bi-circle"></i>
                            </button>
                            @if (_tasksPanelEditingNoteId == nota.IdNota)
                            {
                                <div class="tareas-side-row__editor">
                                    <input value="@_tasksPanelEditTitle"
                                           @oninput="e => _tasksPanelEditTitle = Convert.ToString(e.Value) ?? string.Empty"
                                           placeholder="Título" />
                                    <textarea value="@_tasksPanelEditDetail"
                                              @oninput="e => _tasksPanelEditDetail = Convert.ToString(e.Value) ?? string.Empty"
                                              rows="2"
                                              placeholder="Detalles"></textarea>
                                    <div class="tareas-side-row__editor-actions">
                                        <button type="button" @onclick="SaveTasksPanelEditedNoteAsync">Guardar</button>
                                        <button type="button" @onclick="CancelTasksPanelEdit">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="tareas-side-row__body" @onclick="() => StartTasksPanelEdit(nota)">
                                    <strong>@nota.Texto</strong>
                                    @if (!string.IsNullOrWhiteSpace(nota.Detalle))
                                    {
                                        <span>@nota.Detalle</span>
                                    }
                                    else
                                    {
                                        <span class="is-placeholder">Añadir detalles</span>
                                    }
                                </button>
                            }
                            <div class="tareas-side-row__actions">
                                @if (nota.CompartidaConTodos || nota.UsuariosCompartidos.Count > 0)
                                {
                                    <i class="bi bi-share" title="@GetTasksPanelSharingSummary(nota)"></i>
                                }
                                @if (CanMoveTasksPanelNote(nota, -1))
                                {
                                    <button type="button" class="tareas-side-order-button" title="Subir tarea" @onclick="() => MoveTasksPanelNoteAsync(nota, -1)">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                }
                                @if (CanMoveTasksPanelNote(nota, 1))
                                {
                                    <button type="button" class="tareas-side-order-button" title="Bajar tarea" @onclick="() => MoveTasksPanelNoteAsync(nota, 1)">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                }
                                <button type="button" class="tareas-side-menu-button" title="Más opciones" @onclick="() => ToggleTasksPanelNoteMenu(nota.IdNota)">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                @if (_tasksPanelMenuNoteId == nota.IdNota)
                                {
                                    <div class="tareas-side-note-menu" @onclick:stopPropagation>
                                        <button type="button" @onclick="() => StartTasksPanelEdit(nota)">
                                            <i class="bi bi-card-text"></i>
                                            Editar detalle
                                        </button>
                                        <button type="button" @onclick="() => OpenTasksPanelNoteInModule(nota)">
                                            <i class="bi bi-share"></i>
                                            Compartir
                                        </button>
                                        <button type="button" class="is-danger" @onclick="() => DeleteTasksPanelNoteAsync(nota)" disabled="@(!nota.EsPropia)">
                                            <i class="bi bi-trash"></i>
                                            Eliminar
                                        </button>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="tareas-side-panel__empty">No hay rápidas pendientes.</div>
            }

            <details class="tareas-side-completed">
                <summary>Hechas (@TasksPanelCompletedNotes.Count)</summary>
                <div class="tareas-side-list">
                    @foreach (var nota in TasksPanelCompletedNotes)
                    {
                        <article class="tareas-side-row is-done">
                            <button type="button" class="tareas-side-check is-done" title="Restaurar" @onclick="() => RestoreTasksPanelNoteAsync(nota)">
                                <i class="bi bi-check-circle-fill"></i>
                            </button>
                            <span class="tareas-side-row__body">
                                <strong>@nota.Texto</strong>
                                @if (!string.IsNullOrWhiteSpace(nota.Detalle))
                                {
                                    <span>@nota.Detalle</span>
                                }
                                <span>@FormatTasksPanelDateTime(nota.FechaHoraCompletada)</span>
                            </span>
                        </article>
                    }
                </div>
            </details>
        }
    </section>
</aside>
}

@if (_showInstallHelp)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar instalación" @onclick="() => _showInstallHelp = false"></button>
    <section class="panel-card app-modal no-print">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Instalar AlfaCore</h3>
                <p class="panel-card__subtitle">En iPhone o iPad usá Compartir &gt; Agregar a pantalla de inicio.</p>
            </div>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _showInstallHelp = false" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </section>
}

@if (_showPushPanel)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar notificaciones" @onclick="() => _showPushPanel = false"></button>
    <section class="panel-card app-modal app-modal--wide no-print">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Notificaciones</h3>
                <p class="panel-card__subtitle">Avisos push por dispositivo para mensajes nuevos.</p>
            </div>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _showPushPanel = false" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_pushMessage))
        {
            <div class="conversations-inline conversations-inline--ok">@_pushMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_pushError))
        {
            <div class="conversations-inline conversations-inline--error">@_pushError</div>
        }

        <div class="app-settings-grid">
            <label class="toggle-row">
                <input type="checkbox" checked="@_pushPreferences.Habilitadas" @onchange="OnPushEnabledChanged" disabled="@(!CanEnablePush)" />
                <span>Activar notificaciones en este dispositivo</span>
            </label>

            <div class="field">
                <label>Alcance</label>
                <select @bind="_pushPreferences.Alcance">
                    <option value="@NotificacionesPushScopes.Asignadas">Solo conversaciones asignadas a mi usuario</option>
                    <option value="@NotificacionesPushScopes.Accesibles">Todas las conversaciones accesibles</option>
                </select>
            </div>

            <div class="field">
                <label>Canales</label>
                <label class="toggle-row toggle-row--compact">
                    <input type="checkbox" checked="@(PushChannelEnabled("WHATSAPP"))" @onchange="@(args => TogglePushChannel("WHATSAPP", args))" />
                    <span>WhatsApp</span>
                </label>
                <p class="app-modal__hint">El selector queda preparado para sumar nuevos canales cuando el módulo los habilite.</p>
            </div>
        </div>

        <div class="actions">
            <button type="button" class="btn btn--primary" @onclick="SavePushPreferencesAsync" disabled="@_pushBusy">
                <i class="bi bi-save"></i>
                <span>Guardar</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="SendTestPushAsync" disabled="@(!CanSendTestPush)">
                <i class="bi bi-send"></i>
                <span>Enviar prueba</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="ReRegisterCurrentDeviceAsync" disabled="@_pushBusy">
                <i class="bi bi-arrow-repeat"></i>
                <span>Re-registrar este dispositivo</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="LoadPushDiagnosticsAsync" disabled="@_pushBusy">
                <i class="bi bi-activity"></i>
                <span>Diagnóstico push</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(PushScopeNotice))
        {
            <p class="app-modal__hint">@PushScopeNotice</p>
        }

        @if (_pushDiagnostics is not null)
        {
            <div class="app-settings-grid">
                <div class="field">
                    <label>Diagnóstico del dispositivo</label>
                    <p class="app-modal__hint">HTTPS: @(_pushDiagnostics.Https ? "SI" : "NO") · SW activo: @(_pushDiagnostics.ServiceWorkerReady ? "SI" : "NO") · Push soportado: @(_pushDiagnostics.PushSupported ? "SI" : "NO") · Permiso: @_pushDiagnostics.NotificationPermission</p>
                    <p class="app-modal__hint">DeviceId: @_pushDiagnostics.DeviceId</p>
                    <p class="app-modal__hint">PublicKey: @_pushDiagnostics.PublicKeyPreview</p>
                    @if (_pushDiagnostics.IsBrave)
                    {
                        <p class="conversations-inline conversations-inline--error">Brave detectado: este navegador puede bloquear push por Shields/Notificaciones.</p>
                    }
                </div>
                <div class="field">
                    <label>Suscripciones registradas</label>
                    <p class="app-modal__hint">Dispositivos registrados: @_pushDiagnostics.SubscriptionCount · Activos: @_pushDiagnostics.ActiveSubscriptionCount</p>
                    @if (_pushDiagnostics.Subscriptions.Count == 0)
                    {
                        <p class="conversations-inline conversations-inline--error">No hay suscripciones push activas para este usuario/dispositivo.</p>
                    }
                    else
                    {
                        @foreach (var sub in _pushDiagnostics.Subscriptions)
                        {
                            <p class="app-modal__hint">[@sub.DeviceId@(sub.EsDispositivoActual ? " · ESTE EQUIPO" : string.Empty)] activo: @(sub.Activo ? "SI" : "NO") · endpoint: @sub.EndpointParcial · alta: @(sub.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</p>
                            <p class="app-modal__hint">UA: @DisplayOrDash(sub.UserAgent) · último intento: @(sub.LastAttemptAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-") · último status: @(sub.StatusCode?.ToString() ?? "-") · último error: @DisplayOrDash(sub.Error)</p>
                            <p class="app-modal__hint">Preferencias dispositivo: alcance=@sub.Preferences.Alcance · canales=@string.Join(", ", sub.Preferences.Canales)</p>
                        }
                    }
                </div>
                <div class="field">
                    <label>Preferencias y último test</label>
                    <p class="app-modal__hint">Alcance: @_pushDiagnostics.Preferences.Alcance · Canales: @string.Join(", ", _pushDiagnostics.Preferences.Canales)</p>
                    <p class="app-modal__hint">Último envío de prueba: @_pushLastTestSummary</p>
                    <p class="app-modal__hint">Último error del proveedor push: @DisplayOrDash(_pushDiagnosticsLastProviderError)</p>
                    @if (_pushLastTestResults.Count > 0)
                    {
                        @foreach (var item in _pushLastTestResults)
                        {
                            <p class="app-modal__hint">Prueba → [@item.DeviceId] endpoint=@item.EndpointParcial · resultado=@(item.Success ? "OK" : "FALLÓ") · status=@(item.StatusCode?.ToString() ?? "-") · error=@DisplayOrDash(item.Error)</p>
                        }
                    }
                </div>
            </div>
        }

        @if (_pwaIsIos && !_pwaInstalled)
        {
            <p class="app-modal__hint">En iOS las notificaciones web requieren instalar AlfaCore en pantalla de inicio. Primero usá Compartir &gt; Agregar a pantalla de inicio y abrí la app desde ese ícono.</p>
        }
        else if (!_pwaPushSupported)
        {
            <p class="app-modal__hint">Este navegador no informa soporte para notificaciones push web.</p>
        }
        else if (!_pushConfigured)
        {
            <p class="app-modal__hint">@_pushConfigurationMessage</p>
        }
    </section>
}

<AppLoginOverlay Open="@ShowLoginOverlay"
                 DarkTheme="@_isDark"
                 SqlSessionLabel="@GetSqlSessionLabel()"
                 UserName="@_loginUserName"
                 Password="@_loginPassword"
                 ErrorMessage="@_loginError"
                 IsBusy="@_loginBusy"
                ShowPassword="@_loginShowPassword"
                 RememberCredentials="@_loginRememberCredentials"
                 ShowLogoutButton="@CanShowLogoutButton"
                 UserNameChanged="@(value => _loginUserName = value)"
                 PasswordChanged="@(value => _loginPassword = value)"
                 ShowPasswordChanged="@(value => _loginShowPassword = value)"
                 RememberCredentialsChanged="OnRememberCredentialsChangedAsync"
                 OnSubmit="LoginAsync"
                 OnOpenSqlSessions="OpenSqlSessionDrawerAsync"
                 OnLogout="GoToCentralLoginAsync" />

<AppMsgBoxHost />
<NovedadesPopup Enabled="@(!IsDirectMode)" />

@code {
    private bool _mobileSidebarOpen;
    private bool? _sidebarCollapsedOverride;
    private bool _isDark = false;
    private bool _drawerOpen;
    private bool _drawerDarkTheme;
    private int? _drawerRouteBaseId;
    private AlfaCore.Models.SessionDto? _activeSession;
    private bool _isInitializing = true;
    private string? _initializationErrorMessage;
    private string _loginUserName = string.Empty;
    private string _loginPassword = string.Empty;
    private string _loginError = string.Empty;
    private bool _loginBusy;
    private bool _loginShowPassword;
    private bool _loginRememberCredentials;
    private IReadOnlyList<UsuarioSistemaDto> _loginUsers = [];
    private int? _loginUsersBaseId;
    private bool _loginUsersLoaded;
    private bool _loginUsersLoading;
    private bool _loginUseUserList = true;
    private DotNetObjectReference<MainLayout>? _pwaRef;
    private bool _pwaCanInstall;
    private bool _pwaInstalled;
    private bool _pwaIsIos;
    private bool _pwaPushSupported;
    private string _pwaNotificationPermission = string.Empty;
    private bool _showInstallHelp;
    private bool _showPushPanel;
    private bool _pushBusy;
    private bool _pushConfigured;
    private string _pushPublicKey = string.Empty;
    private string _pushConfigurationMessage = string.Empty;
    private string _pushMessage = string.Empty;
    private string _pushError = string.Empty;
    private NotificacionesPushPreferencesDto _pushPreferences = new();
    private PushDiagnosticsVm? _pushDiagnostics;
    private string _pushLastTestSummary = "Sin pruebas ejecutadas.";
    private string _pushDiagnosticsLastProviderError = string.Empty;
    private List<NotificacionesPushEndpointResultDto> _pushLastTestResults = [];
    private string CurrentPageTitle => GetCurrentPageTitle();
    private RenderFragment? ModuleBackLink => !IsDirectMode
        ? @<a class="menu__back" href="@GetLauncherUrl()" @onclick:preventDefault="true" @onclick="GoBackOrLauncherAsync">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <span>Aplicaciones</span>
            </a>
        : null;
    private string ShellClass
        => $"shell {(IsSidebarCollapsed ? "shell--collapsed" : string.Empty)} {(_mobileSidebarOpen ? "shell--mobile-open" : string.Empty)} {(IsDirectMode ? "shell--direct" : string.Empty)} {(IsPosFullscreenRoute ? "shell--pos-fullscreen" : string.Empty)}";
    private bool ShowShellContext => string.IsNullOrWhiteSpace(_currentModule);
    private bool ShowLauncherContext => ShowShellContext && !IsDirectMode;
    private bool CanShowLauncherAccess => !IsDirectMode;
    private bool DefaultSidebarCollapsed => !ShowLauncherContext;
    private bool IsSidebarCollapsed => _sidebarCollapsedOverride ?? DefaultSidebarCollapsed;
