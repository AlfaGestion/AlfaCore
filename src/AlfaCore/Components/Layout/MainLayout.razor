@if (_showPushPanel)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar notificaciones" @onclick="() => _showPushPanel = false"></button>
    <section class="panel-card app-modal app-modal--wide no-print">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Notificaciones</h3>
                <p class="panel-card__subtitle">Avisos push por dispositivo para mensajes nuevos.</p>
            </div>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _showPushPanel = false" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_pushMessage))
        {
            <div class="conversations-inline conversations-inline--ok">@_pushMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_pushError))
        {
            <div class="conversations-inline conversations-inline--error">@_pushError</div>
        }

        <div class="app-settings-grid">
            <label class="toggle-row">
                <input type="checkbox" checked="@_pushPreferences.Habilitadas" @onchange="OnPushEnabledChanged" disabled="@(!CanEnablePush)" />
                <span>Activar notificaciones en este dispositivo</span>
            </label>

            <div class="field">
                <label>Alcance</label>
                <select @bind="_pushPreferences.Alcance">
                    <option value="@NotificacionesPushScopes.Asignadas">Solo conversaciones asignadas a mi usuario</option>
                    <option value="@NotificacionesPushScopes.Accesibles">Todas las conversaciones accesibles</option>
                </select>
            </div>

            <div class="field">
                <label>Canales</label>
                <label class="toggle-row toggle-row--compact">
                    <input type="checkbox" checked="@(PushChannelEnabled("WHATSAPP"))" @onchange="@(args => TogglePushChannel("WHATSAPP", args))" />
                    <span>WhatsApp</span>
                </label>
                <p class="app-modal__hint">El selector queda preparado para sumar nuevos canales cuando el mÃ³dulo los habilite.</p>
            </div>
        </div>

        <div class="actions">
            <button type="button" class="btn btn--primary" @onclick="SavePushPreferencesAsync" disabled="@_pushBusy">
                <i class="bi bi-save"></i>
                <span>Guardar</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="SendTestPushAsync" disabled="@(!CanSendTestPush)">
                <i class="bi bi-send"></i>
                <span>Enviar prueba</span>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="LoadPushDiagnosticsAsync" disabled="@_pushBusy">
                <i class="bi bi-activity"></i>
                <span>DiagnÃ³stico push</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(PushScopeNotice))
        {
            <p class="app-modal__hint">@PushScopeNotice</p>
        }

        @if (_pushDiagnostics is not null)
        {
            <div class="app-settings-grid">
                <div class="field">
                    <label>DiagnÃ³stico del dispositivo</label>
                    <p class="app-modal__hint">HTTPS: @(_pushDiagnostics.Https ? "SI" : "NO") Â· SW activo: @(_pushDiagnostics.ServiceWorkerReady ? "SI" : "NO") Â· Push soportado: @(_pushDiagnostics.PushSupported ? "SI" : "NO") Â· Permiso: @_pushDiagnostics.NotificationPermission</p>
                    <p class="app-modal__hint">DeviceId: @_pushDiagnostics.DeviceId</p>
                    <p class="app-modal__hint">PublicKey: @_pushDiagnostics.PublicKeyPreview</p>
                    @if (_pushDiagnostics.IsBrave)
                    {
                        <p class="conversations-inline conversations-inline--error">Brave detectado: este navegador puede bloquear push por Shields/Notificaciones.</p>
                    }
                </div>
                <div class="field">
