@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private bool _loading = true;
    private List<PuntoVentaEntidadDto> _puntosVenta = [];
    private PuntoVentaEntidadDto? _selectedPuntoVenta;
    private bool _showPuntoVentaForm;
    private bool _showIngresoRapidoModal;
    private bool _showCatalogoModal;
    private bool _showSectoresModal;
    private bool _showMesasModal;
    private bool _showReciboAnticipoPreview;
    private bool _detectandoTop;
    private bool _guardandoTop;
    private int _topLimiteDraft = 100;
    private PuntoVentaEntidadSaveRequest _puntoVentaForm = new();
    private PuntoVentaCatalogosDto _catalogos = new();
    private string _comprobanteHabitual = "FC";
    private bool _mostrarTodosRubros;
    private IReadOnlyList<PuntoVentaTopArticuloDto> _topArticulos = [];
    private string? _catalogoFeedback;
    private bool _catalogoFeedbackOk;
    private static readonly CultureInfo _culturaAr = CultureInfo.GetCultureInfo("es-AR");

    private IEnumerable<PuntoVentaCatalogoOpcionDto> RubrosVisibles
        => _mostrarTodosRubros
            ? _catalogos.Rubros
            : _catalogos.Rubros.Take(15).Concat(
                _catalogos.Rubros.Skip(15).Where(r => _puntoVentaForm.Rubros.Contains(r.Valor, StringComparer.OrdinalIgnoreCase)));

    private List<PuntoVentaSectorDto> _sectores = [];
    private PuntoVentaSectorDto? _selectedSector;
    private bool _showSectorForm;
    private PuntoVentaSectorSaveRequest _sectorForm = new();

    private List<PuntoVentaMesaDto> _mesas = [];
    private bool _showMesaForm;
    private PuntoVentaMesaSaveRequest _mesaForm = new();

    private AppUiMessage? _feedback;
    private string _quickDraft1 = string.Empty;
    private string _quickDraft2 = string.Empty;
    private string _quickDraft3 = string.Empty;
    private string _quickDraft4 = string.Empty;
    private string _quickDraft5 = string.Empty;
    private string _quickDraft6 = string.Empty;
    private string _quickQuantityDraft1 = string.Empty;
    private string _quickQuantityDraft2 = string.Empty;
    private string _quickQuantityDraft3 = string.Empty;
    private string _quickQuantityDraft4 = string.Empty;
    private string _quickQuantityDraft5 = string.Empty;
    private string _quickQuantityDraft6 = string.Empty;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "ventas",
        TopNavigationItems = ModuleTopNavPresets.BuildPuntoVenta(RouteContext, Nav, "puntos-venta")
    });

    private void VolverAlDashboardVentas()
        => Nav.NavigateTo(RouteContext.BuildRoute("/ventas"));

    protected override async Task OnInitializedAsync() => await LoadPuntosVentaAsync();

    private async Task LoadPuntosVentaAsync()
    {
        _loading = true;
        var result = await UiOps.RunAsync(() => PosConfigSvc.GetPuntosVentaAsync(), "No se pudieron cargar los puntos de venta.");
        _puntosVenta = result.Success && result.Value is not null ? result.Value.ToList() : [];
        var catalogos = await UiOps.RunAsync(() => PosConfigSvc.GetCatalogosAsync(), "No se pudieron cargar los catálogos de puntos de venta.");
        if (catalogos.Success && catalogos.Value is not null)
            _catalogos = catalogos.Value;
        if (!result.Success)
            _feedback = result.Feedback;
        var comprobante = await UiOps.RunAsync(() => PosConfigSvc.GetComprobanteHabitualAsync(), "No se pudo cargar el comprobante habitual.");
        if (comprobante.Success && !string.IsNullOrWhiteSpace(comprobante.Value))
            _comprobanteHabitual = comprobante.Value;
        else if (!comprobante.Success)
            _feedback = comprobante.Feedback;
        _loading = false;
    }

    private Task NuevoPuntoVentaAsync()
    {
        _puntoVentaForm = new PuntoVentaEntidadSaveRequest
        {
            Codigo = ProponerCodigo(_puntosVenta.Select(x => x.Codigo)),
            Activo = true,
            Modo = PuntoVentaModoKeys.Mostrador
        };
        _mostrarTodosRubros = false;
        _showIngresoRapidoModal = false;
        _showSectoresModal = false;
        _showMesasModal = false;
        _showPuntoVentaForm = true;
        return Task.CompletedTask;
    }

    private static string ProponerCodigo(IEnumerable<string?> codigos)
    {
        var numericos = codigos
            .Select(codigo => (Texto: (codigo ?? string.Empty).Trim(), EsNumero: int.TryParse((codigo ?? string.Empty).Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var numero), Numero: numero))
            .Where(x => x.EsNumero && x.Numero >= 0)
            .ToList();

        if (numericos.Count == 0)
            return "1";

        var siguiente = numericos.Max(x => x.Numero) + 1;
        var ancho = Math.Min(4, Math.Max(1, numericos.Max(x => x.Texto.Length)));
        return siguiente.ToString($"D{ancho}", CultureInfo.InvariantCulture);
    }

    private async Task SeleccionarPuntoVentaAsync(PuntoVentaEntidadDto pv)
    {
        _selectedPuntoVenta = pv;
        _selectedSector = null;
        _sectores = [];
        _mesas = [];
        _showSectorForm = false;
        _showMesaForm = false;
        _showSectoresModal = false;
        _showMesasModal = false;

        _puntoVentaForm = new PuntoVentaEntidadSaveRequest
        {
            Id = pv.Id,
            Codigo = pv.Codigo,
            Nombre = pv.Nombre,
            Modo = pv.Modo,
            Unegocio = pv.Unegocio,
            IdCaja = pv.IdCaja,
            Sucursal = pv.Sucursal,
            IdLista = pv.IdLista,
            ClasePrecio = pv.ClasePrecio,
            CargaRapidaGrafica = pv.CargaRapidaGrafica,
            ModoIngresoRapido = pv.ModoIngresoRapido,
            ImporteRapido1 = pv.ImporteRapido1,
            ImporteRapido2 = pv.ImporteRapido2,
            ImporteRapido3 = pv.ImporteRapido3,
            ImporteRapido4 = pv.ImporteRapido4,
            ImporteRapido5 = pv.ImporteRapido5,
            ImporteRapido6 = pv.ImporteRapido6,
            CantidadRapida1 = pv.CantidadRapida1,
            CantidadRapida2 = pv.CantidadRapida2,
            CantidadRapida3 = pv.CantidadRapida3,
            CantidadRapida4 = pv.CantidadRapida4,
            CantidadRapida5 = pv.CantidadRapida5,
            CantidadRapida6 = pv.CantidadRapida6,
            ModalidadReciboAnticipo = pv.ModalidadReciboAnticipo,
            FormatoReciboAnticipo = pv.FormatoReciboAnticipo,
            ReciboAnticipoMuestraEmpresa = pv.ReciboAnticipoMuestraEmpresa,
            ReciboAnticipoMuestraPedido = pv.ReciboAnticipoMuestraPedido,
            ReciboAnticipoMuestraCliente = pv.ReciboAnticipoMuestraCliente,
            ReciboAnticipoMuestraImportes = pv.ReciboAnticipoMuestraImportes,
            ReciboAnticipoMuestraMediosPago = pv.ReciboAnticipoMuestraMediosPago,
            ReciboAnticipoMuestraEntrega = pv.ReciboAnticipoMuestraEntrega,
            ReciboAnticipoMuestraUsuario = pv.ReciboAnticipoMuestraUsuario,
            Rubros = pv.Rubros.ToList(),
            Activo = pv.Activo
        };
        _mostrarTodosRubros = false;
        _showIngresoRapidoModal = false;
        _showPuntoVentaForm = true;

        if (string.Equals(pv.Modo, PuntoVentaModoKeys.Salon, StringComparison.OrdinalIgnoreCase))
            await LoadSectoresAsync(pv.Id);
    }

    private void ToggleRubro(string idRubro)
    {
        var existente = _puntoVentaForm.Rubros.FirstOrDefault(r => string.Equals(r, idRubro, StringComparison.OrdinalIgnoreCase));
        if (existente is null)
            _puntoVentaForm.Rubros.Add(idRubro);
        else
            _puntoVentaForm.Rubros.Remove(existente);
    }

    private async Task AbrirEditorCatalogo()
    {
        _catalogoFeedback = null;
        _showCatalogoModal = true;
        var result = await UiOps.RunAsync(() => PosConfigSvc.GetTopArticulosAsync(), "No se pudo cargar la lista Top.");
        if (result.Success && result.Value is not null)
            _topArticulos = result.Value;
        else if (!result.Success)
        {
            _catalogoFeedbackOk = false;
            _catalogoFeedback = result.Feedback?.Message ?? "No se pudo cargar la lista Top.";
        }
    }

    private void CerrarEditorCatalogo() => _showCatalogoModal = false;

    private async Task AbrirSectoresModalAsync()
    {
        if (_selectedPuntoVenta is null || !string.Equals(_puntoVentaForm.Modo, PuntoVentaModoKeys.Salon, StringComparison.OrdinalIgnoreCase))
            return;

        await LoadSectoresAsync(_selectedPuntoVenta.Id);
        _showSectoresModal = true;
    }

    private void CerrarSectoresModal() => _showSectoresModal = false;

    private async Task AbrirMesasModalAsync(PuntoVentaSectorDto sector)
    {
        _selectedSector = sector;
        _showSectoresModal = false;
        await LoadMesasAsync(sector.Id);
        _showMesasModal = true;
    }

    private void CerrarMesasModal()
    {
        _showMesasModal = false;
        if (_selectedPuntoVenta is not null && string.Equals(_selectedPuntoVenta.Modo, PuntoVentaModoKeys.Salon, StringComparison.OrdinalIgnoreCase))
            _showSectoresModal = true;
    }

    private void AbrirVistaPreviaRecibo() => _showReciboAnticipoPreview = true;

    private void CerrarVistaPreviaRecibo() => _showReciboAnticipoPreview = false;

    private async Task DetectarTopArticulosAsync()
    {
        _detectandoTop = true;
        _catalogoFeedback = null;
        _topLimiteDraft = Math.Clamp(_topLimiteDraft, 1, 100);
        var result = await UiOps.RunAsync(() => PosConfigSvc.DetectarTopArticulosAsync(_topLimiteDraft), "No se pudieron detectar los artículos más vendidos.");
        if (result.Success && result.Value is not null)
        {
            _topArticulos = result.Value;
            _catalogoFeedbackOk = true;
            _catalogoFeedback = $"Se detectaron {_topArticulos.Count} artículos. Revisá la lista y guardala para usarla en el catálogo.";
        }
        else if (!result.Success)
        {
            _catalogoFeedbackOk = false;
            _catalogoFeedback = result.Feedback?.Message ?? "No se pudieron detectar los artículos más vendidos.";
        }
        _detectandoTop = false;
    }

    private async Task GuardarCatalogoAsync()
    {
        _guardandoTop = true;
        var result = await UiOps.RunAsync(
            () => PosConfigSvc.SaveTopArticulosAsync(_topArticulos.Select(x => x.IdArticulo).ToList()),
            "No se pudo guardar la lista Top.");
        if (result.Success)
        {
            _showCatalogoModal = false;
            _feedback = AppUiMessage.Success("Catálogo actualizado", "La lista Top del catálogo se guardó correctamente.");
        }
        else
        {
            _catalogoFeedbackOk = false;
            _catalogoFeedback = result.Feedback?.Message ?? "No se pudo guardar la lista Top.";
        }
        _guardandoTop = false;
    }

    private void OnIngresoRapidoEnabledChanged(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        _puntoVentaForm.CargaRapidaGrafica = enabled;
        _puntoVentaForm.ModoIngresoRapido = enabled
            ? (_puntoVentaForm.ModoIngresoRapido == PuntoVentaIngresoRapidoModoKeys.Deshabilitado
                ? PuntoVentaIngresoRapidoModoKeys.Completo
                : _puntoVentaForm.ModoIngresoRapido)
            : PuntoVentaIngresoRapidoModoKeys.Deshabilitado;
    }

    private void CancelarPuntoVentaForm()
    {
        _showPuntoVentaForm = false;
        _mostrarTodosRubros = false;
        _showIngresoRapidoModal = false;
        _showSectoresModal = false;
        _showMesasModal = false;
        _puntoVentaForm = new PuntoVentaEntidadSaveRequest();
