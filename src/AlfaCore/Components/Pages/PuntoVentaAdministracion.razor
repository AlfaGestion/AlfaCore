@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private bool _loading = true;
    private List<PuntoVentaEntidadDto> _puntosVenta = [];
    private PuntoVentaEntidadDto? _selectedPuntoVenta;
    private bool _showPuntoVentaForm;
    private bool _showIngresoRapidoModal;
    private PuntoVentaEntidadSaveRequest _puntoVentaForm = new();
    private PuntoVentaCatalogosDto _catalogos = new();
    private string _comprobanteHabitual = "FC";
    private bool _mostrarTodosRubros;

    private IEnumerable<PuntoVentaCatalogoOpcionDto> RubrosVisibles
        => _mostrarTodosRubros
            ? _catalogos.Rubros
            : _catalogos.Rubros.Take(10).Concat(
                _catalogos.Rubros.Skip(10).Where(r => _puntoVentaForm.Rubros.Contains(r.Valor, StringComparer.OrdinalIgnoreCase)));

    private List<PuntoVentaSectorDto> _sectores = [];
    private PuntoVentaSectorDto? _selectedSector;
    private bool _showSectorForm;
    private PuntoVentaSectorSaveRequest _sectorForm = new();

    private List<PuntoVentaMesaDto> _mesas = [];
    private bool _showMesaForm;
    private PuntoVentaMesaSaveRequest _mesaForm = new();

    private AppUiMessage? _feedback;
    private string _quickDraft1 = string.Empty;
    private string _quickDraft2 = string.Empty;
    private string _quickDraft3 = string.Empty;
    private string _quickDraft4 = string.Empty;
    private string _quickDraft5 = string.Empty;
    private string _quickDraft6 = string.Empty;
    private string _quickQuantityDraft1 = string.Empty;
    private string _quickQuantityDraft2 = string.Empty;
    private string _quickQuantityDraft3 = string.Empty;
    private string _quickQuantityDraft4 = string.Empty;
    private string _quickQuantityDraft5 = string.Empty;
    private string _quickQuantityDraft6 = string.Empty;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "ventas",
        TopNavigationItems = ModuleTopNavPresets.BuildPuntoVenta(RouteContext, Nav, "puntos-venta")
    });

    private void VolverAlDashboardVentas()
        => Nav.NavigateTo(RouteContext.BuildRoute("/ventas"));

    protected override async Task OnInitializedAsync() => await LoadPuntosVentaAsync();

    private async Task LoadPuntosVentaAsync()
    {
        _loading = true;
        var result = await UiOps.RunAsync(() => PosConfigSvc.GetPuntosVentaAsync(), "No se pudieron cargar los puntos de venta.");
        _puntosVenta = result.Success && result.Value is not null ? result.Value.ToList() : [];
        var catalogos = await UiOps.RunAsync(() => PosConfigSvc.GetCatalogosAsync(), "No se pudieron cargar los catálogos de puntos de venta.");
        if (catalogos.Success && catalogos.Value is not null)
            _catalogos = catalogos.Value;
        if (!result.Success)
            _feedback = result.Feedback;
        var comprobante = await UiOps.RunAsync(() => PosConfigSvc.GetComprobanteHabitualAsync(), "No se pudo cargar el comprobante habitual.");
        if (comprobante.Success && !string.IsNullOrWhiteSpace(comprobante.Value))
            _comprobanteHabitual = comprobante.Value;
        else if (!comprobante.Success)
            _feedback = comprobante.Feedback;
        _loading = false;
    }

    private Task NuevoPuntoVentaAsync()
    {
        _puntoVentaForm = new PuntoVentaEntidadSaveRequest { Activo = true, Modo = PuntoVentaModoKeys.Mostrador };
        _mostrarTodosRubros = false;
        _showIngresoRapidoModal = false;
        _showPuntoVentaForm = true;
        return Task.CompletedTask;
    }

    private async Task SeleccionarPuntoVentaAsync(PuntoVentaEntidadDto pv)
    {
        _selectedPuntoVenta = pv;
        _selectedSector = null;
        _sectores = [];
        _mesas = [];
        _showSectorForm = false;
        _showMesaForm = false;

        _puntoVentaForm = new PuntoVentaEntidadSaveRequest
        {
            Id = pv.Id,
            Codigo = pv.Codigo,
            Nombre = pv.Nombre,
            Modo = pv.Modo,
            Unegocio = pv.Unegocio,
            IdCaja = pv.IdCaja,
            Sucursal = pv.Sucursal,
            IdLista = pv.IdLista,
            ClasePrecio = pv.ClasePrecio,
            CargaRapidaGrafica = pv.CargaRapidaGrafica,
            ImporteRapido1 = pv.ImporteRapido1,
            ImporteRapido2 = pv.ImporteRapido2,
            ImporteRapido3 = pv.ImporteRapido3,
            ImporteRapido4 = pv.ImporteRapido4,
            ImporteRapido5 = pv.ImporteRapido5,
            ImporteRapido6 = pv.ImporteRapido6,
            CantidadRapida1 = pv.CantidadRapida1,
            CantidadRapida2 = pv.CantidadRapida2,
            CantidadRapida3 = pv.CantidadRapida3,
            CantidadRapida4 = pv.CantidadRapida4,
            CantidadRapida5 = pv.CantidadRapida5,
            CantidadRapida6 = pv.CantidadRapida6,
            Rubros = pv.Rubros.ToList(),
            Activo = pv.Activo
        };
        _mostrarTodosRubros = false;
        _showIngresoRapidoModal = false;
        _showPuntoVentaForm = true;

        if (string.Equals(pv.Modo, PuntoVentaModoKeys.Salon, StringComparison.OrdinalIgnoreCase))
            await LoadSectoresAsync(pv.Id);
    }

    private void ToggleRubro(string idRubro)
    {
        var existente = _puntoVentaForm.Rubros.FirstOrDefault(r => string.Equals(r, idRubro, StringComparison.OrdinalIgnoreCase));
        if (existente is null)
            _puntoVentaForm.Rubros.Add(idRubro);
        else
            _puntoVentaForm.Rubros.Remove(existente);
    }

    private void CancelarPuntoVentaForm()
    {
        _showPuntoVentaForm = false;
        _mostrarTodosRubros = false;
        _showIngresoRapidoModal = false;
        _puntoVentaForm = new PuntoVentaEntidadSaveRequest();
    }

    private void AbrirEditorIngresoRapido()
    {
        _quickDraft1 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido1);
        _quickDraft2 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido2);
        _quickDraft3 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido3);
        _quickDraft4 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido4);
        _quickDraft5 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido5);
        _quickDraft6 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido6);
        _quickQuantityDraft1 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida1);
        _quickQuantityDraft2 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida2);
        _quickQuantityDraft3 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida3);
        _quickQuantityDraft4 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida4);
        _quickQuantityDraft5 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida5);
        _quickQuantityDraft6 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida6);
        _showIngresoRapidoModal = true;
    }

    private void CerrarEditorIngresoRapido() => _showIngresoRapidoModal = false;

    private void AplicarEditorIngresoRapido()
    {
        _puntoVentaForm.ImporteRapido1 = LeerConfiguracion(_quickDraft1, 5m);
        _puntoVentaForm.ImporteRapido2 = LeerConfiguracion(_quickDraft2, 10m);
        _puntoVentaForm.ImporteRapido3 = LeerConfiguracion(_quickDraft3, 25m);
        _puntoVentaForm.ImporteRapido4 = LeerConfiguracion(_quickDraft4, 50m);
        _puntoVentaForm.ImporteRapido5 = LeerConfiguracion(_quickDraft5, 100m);
        _puntoVentaForm.ImporteRapido6 = LeerConfiguracion(_quickDraft6, 200m);
        _puntoVentaForm.CantidadRapida1 = LeerConfiguracion(_quickQuantityDraft1, 0.1m);
        _puntoVentaForm.CantidadRapida2 = LeerConfiguracion(_quickQuantityDraft2, 0.25m);
        _puntoVentaForm.CantidadRapida3 = LeerConfiguracion(_quickQuantityDraft3, 0.5m);
        _puntoVentaForm.CantidadRapida4 = LeerConfiguracion(_quickQuantityDraft4, 1m);
        _puntoVentaForm.CantidadRapida5 = LeerConfiguracion(_quickQuantityDraft5, 6m);
        _puntoVentaForm.CantidadRapida6 = LeerConfiguracion(_quickQuantityDraft6, 12m);
        _showIngresoRapidoModal = false;
    }

    private static string FormatearConfiguracion(decimal value)
        => value.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static decimal LeerConfiguracion(string value, decimal fallback)
        => decimal.TryParse((value ?? string.Empty).Trim().Replace('.', ','), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.GetCultureInfo("es-AR"), out var parsed) && parsed > 0m
            ? decimal.Round(parsed, 2, MidpointRounding.AwayFromZero)
            : fallback;

    private async Task GuardarPuntoVentaAsync()
    {
        _feedback = null;
        _puntoVentaForm.UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty);
        var result = await UiOps.RunAsync(() => PosConfigSvc.SavePuntoVentaAsync(_puntoVentaForm), "No se pudo guardar el punto de venta.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        var comprobante = await UiOps.RunAsync(
            () => PosConfigSvc.SaveComprobanteHabitualAsync(_comprobanteHabitual),
            "No se pudo guardar el comprobante habitual.");
        if (!comprobante.Success)
        {
            _feedback = comprobante.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Guardado", "El punto de venta se guardó correctamente.");
        _showPuntoVentaForm = false;
        await LoadPuntosVentaAsync();
    }

    private async Task LoadSectoresAsync(int idPuntoVenta)
    {
        var result = await UiOps.RunAsync(() => PosConfigSvc.GetSectoresAsync(idPuntoVenta), "No se pudieron cargar los sectores.");
        _sectores = result.Success && result.Value is not null ? result.Value.ToList() : [];
        if (!result.Success)
            _feedback = result.Feedback;
    }

    private Task NuevoSectorAsync()
    {
        if (_selectedPuntoVenta is null)
            return Task.CompletedTask;

        _sectorForm = new PuntoVentaSectorSaveRequest { IdPuntoVenta = _selectedPuntoVenta.Id, Activo = true, Orden = _sectores.Count };
        _showSectorForm = true;
        return Task.CompletedTask;
    }

    private async Task SeleccionarSectorAsync(PuntoVentaSectorDto sector)
    {
        _selectedSector = sector;
        _sectorForm = new PuntoVentaSectorSaveRequest
        {
            Id = sector.Id,
            Codigo = sector.Codigo,
            IdPuntoVenta = sector.IdPuntoVenta,
            Nombre = sector.Nombre,
            Icono = sector.Icono,
            Imagen = sector.Imagen,
            Orden = sector.Orden,
            Activo = sector.Activo
        };
        _showSectorForm = true;
        _showMesaForm = false;
        await LoadMesasAsync(sector.Id);
    }

    private void CancelarSectorForm()
    {
        _showSectorForm = false;
        _sectorForm = new PuntoVentaSectorSaveRequest();
    }

    private async Task GuardarSectorAsync()
    {
        _feedback = null;
        _sectorForm.UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty);
        var result = await UiOps.RunAsync(() => PosConfigSvc.SaveSectorAsync(_sectorForm), "No se pudo guardar el sector.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Guardado", "El sector se guardó correctamente.");
        _showSectorForm = false;
        if (_selectedPuntoVenta is not null)
            await LoadSectoresAsync(_selectedPuntoVenta.Id);
    }

    private async Task LoadMesasAsync(int idSector)
    {
        var result = await UiOps.RunAsync(() => PosConfigSvc.GetMesasAsync(idSector), "No se pudieron cargar las mesas.");
        _mesas = result.Success && result.Value is not null ? result.Value.ToList() : [];
        if (!result.Success)
            _feedback = result.Feedback;
    }

    private Task NuevaMesaAsync()
    {
        if (_selectedSector is null)
            return Task.CompletedTask;

        _mesaForm = new PuntoVentaMesaSaveRequest { IdSector = _selectedSector.Id, Activo = true };
        _showMesaForm = true;
        return Task.CompletedTask;
    }

    private Task EditarMesaAsync(PuntoVentaMesaDto mesa)
    {
        _mesaForm = new PuntoVentaMesaSaveRequest
        {
            Id = mesa.Id,
            Codigo = mesa.Codigo,
            IdSector = mesa.IdSector,
            Nombre = mesa.Nombre,
            Capacidad = mesa.Capacidad,
            PosX = mesa.PosX,
            PosY = mesa.PosY,
            Width = mesa.Width,
            Height = mesa.Height,
            Formato = PuntoVentaMesaFormatoKeys.Normalizar(mesa.Formato),
            Icono = mesa.Icono,
            Imagen = mesa.Imagen,
            Activo = mesa.Activo
        };
        _showMesaForm = true;
        return Task.CompletedTask;
    }

    private void CancelarMesaForm()
    {
        _showMesaForm = false;
        _mesaForm = new PuntoVentaMesaSaveRequest();
    }

    private async Task GuardarMesaAsync()
    {
        _feedback = null;
        _mesaForm.UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty);
        var result = await UiOps.RunAsync(() => PosConfigSvc.SaveMesaAsync(_mesaForm), "No se pudo guardar la mesa.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Guardado", "La mesa se guardó correctamente.");
        _showMesaForm = false;
        if (_selectedSector is not null)
            await LoadMesasAsync(_selectedSector.Id);
    }

    private static string GetModoTexto(string modo) => modo switch
    {
        PuntoVentaModoKeys.MostradorProduccion => "Mostrador y Producción",
        PuntoVentaModoKeys.Salon => "Salón",
        PuntoVentaModoKeys.Delivery => "Delivery / Take Away",
        _ => "Mostrador"
    };

    private static string GetFeedbackClass(AppUiMessage message) => message.Severity switch
    {
        AppUiFeedbackSeverity.Success => "editor-msg--success",
        AppUiFeedbackSeverity.Warning => "editor-msg--warning",
        AppUiFeedbackSeverity.Info => "editor-msg--info",
        _ => "editor-msg--error"
    };
}
