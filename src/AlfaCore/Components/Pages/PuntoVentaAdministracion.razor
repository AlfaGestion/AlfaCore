        _quickDraft1 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido1);
        _quickDraft2 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido2);
        _quickDraft3 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido3);
        _quickDraft4 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido4);
        _quickDraft5 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido5);
        _quickDraft6 = FormatearConfiguracion(_puntoVentaForm.ImporteRapido6);
        _quickQuantityDraft1 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida1);
        _quickQuantityDraft2 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida2);
        _quickQuantityDraft3 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida3);
        _quickQuantityDraft4 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida4);
        _quickQuantityDraft5 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida5);
        _quickQuantityDraft6 = FormatearConfiguracion(_puntoVentaForm.CantidadRapida6);
        _showIngresoRapidoModal = true;
    }

    private void CerrarEditorIngresoRapido() => _showIngresoRapidoModal = false;

    private void AplicarEditorIngresoRapido()
    {
        _puntoVentaForm.ImporteRapido1 = LeerConfiguracion(_quickDraft1, 1000m);
        _puntoVentaForm.ImporteRapido2 = LeerConfiguracion(_quickDraft2, 2000m);
        _puntoVentaForm.ImporteRapido3 = LeerConfiguracion(_quickDraft3, 5000m);
        _puntoVentaForm.ImporteRapido4 = LeerConfiguracion(_quickDraft4, 10000m);
        _puntoVentaForm.ImporteRapido5 = LeerConfiguracion(_quickDraft5, 20000m);
        _puntoVentaForm.ImporteRapido6 = LeerConfiguracion(_quickDraft6, 50000m);
        _puntoVentaForm.CantidadRapida1 = LeerConfiguracion(_quickQuantityDraft1, 0.1m);
        _puntoVentaForm.CantidadRapida2 = LeerConfiguracion(_quickQuantityDraft2, 0.25m);
        _puntoVentaForm.CantidadRapida3 = LeerConfiguracion(_quickQuantityDraft3, 0.5m);
        _puntoVentaForm.CantidadRapida4 = LeerConfiguracion(_quickQuantityDraft4, 1m);
        _puntoVentaForm.CantidadRapida5 = LeerConfiguracion(_quickQuantityDraft5, 6m);
        _puntoVentaForm.CantidadRapida6 = LeerConfiguracion(_quickQuantityDraft6, 12m);
        _showIngresoRapidoModal = false;
    }

    private static string FormatearConfiguracion(decimal value)
        => value.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static decimal LeerConfiguracion(string value, decimal fallback)
        => decimal.TryParse((value ?? string.Empty).Trim().Replace('.', ','), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.GetCultureInfo("es-AR"), out var parsed) && parsed > 0m
            ? decimal.Round(parsed, 2, MidpointRounding.AwayFromZero)
            : fallback;

    private bool _confirmarBorrarPuntoVenta;
    private bool _borrandoPuntoVenta;

    private async Task BorrarPuntoVentaAsync()
    {
        if (_puntoVentaForm.Id is not > 0 || _borrandoPuntoVenta) return;
        _borrandoPuntoVenta = true;
        _feedback = null;
        var id = _puntoVentaForm.Id.Value;
        var nombre = _puntoVentaForm.Nombre;
        var result = await UiOps.RunAsync(() => PosConfigSvc.DeletePuntoVentaAsync(id), "No se pudo borrar el punto de venta.");
        _borrandoPuntoVenta = false;
        _confirmarBorrarPuntoVenta = false;
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Borrado", $"Se borró el punto de venta {nombre}.");
        _selectedPuntoVenta = null;
        _selectedSector = null;
        _sectores = [];
        _mesas = [];
        CancelarPuntoVentaForm();
        await LoadPuntosVentaAsync();
    }

    private async Task GuardarPuntoVentaAsync()
    {
        _feedback = null;
        _puntoVentaForm.UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty);
        var result = await UiOps.RunAsync(() => PosConfigSvc.SavePuntoVentaAsync(_puntoVentaForm), "No se pudo guardar el punto de venta.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        var comprobante = await UiOps.RunAsync(
            () => PosConfigSvc.SaveComprobanteHabitualAsync(_comprobanteHabitual),
            "No se pudo guardar el comprobante habitual.");
        if (!comprobante.Success)
        {
            _feedback = comprobante.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Guardado", "El punto de venta se guardó correctamente.");
        _showPuntoVentaForm = false;
        _showSectoresModal = false;
        _showMesasModal = false;
        await LoadPuntosVentaAsync();

        // Salón: se muestra el salón (el servicio arma sector, barra y mesas si todavía no tenía sectores).
        if (_puntoVentaForm.Modo == PuntoVentaModoKeys.Salon && _puntosVenta.FirstOrDefault(p => p.Id == result.Value) is { } guardado)
        {
            var eraNuevo = _puntoVentaForm.Id is not > 0;
            await SeleccionarPuntoVentaAsync(guardado);
            _showPuntoVentaForm = false;
            if (_sectores.FirstOrDefault() is { } primero)
            {
                await SeleccionarSectorAsync(primero);
                _showSectorForm = false;
                if (eraNuevo)
                {
                    var conBarra = _mesas.Any(EsBarra);
                    _feedback = AppUiMessage.Success("Guardado",
                        $"Se armó el sector {primero.Nombre}{(conBarra ? " con barra y" : " con")} {_mesas.Count(m => !EsBarra(m))} mesa(s). Podés cambiar la cantidad con «Aplicar».");
                }
            }
        }
    }

    private async Task LoadSectoresAsync(int idPuntoVenta)
    {
        var result = await UiOps.RunAsync(() => PosConfigSvc.GetSectoresAsync(idPuntoVenta), "No se pudieron cargar los sectores.");
        _sectores = result.Success && result.Value is not null ? result.Value.ToList() : [];
        if (!result.Success)
            _feedback = result.Feedback;
    }

    private Task NuevoSectorAsync()
    {
        if (_selectedPuntoVenta is null)
            return Task.CompletedTask;

        _sectorForm = new PuntoVentaSectorSaveRequest
        {
            Codigo = ProponerCodigo(_sectores.Select(x => x.Codigo)),
            IdPuntoVenta = _selectedPuntoVenta.Id,
            Activo = true,
            Orden = _sectores.Count
        };
        _showSectorForm = true;
        return Task.CompletedTask;
    }

    private async Task SeleccionarSectorAsync(PuntoVentaSectorDto sector)
    {
        _selectedSector = sector;
        _sectorForm = new PuntoVentaSectorSaveRequest
        {
            Id = sector.Id,
            Codigo = sector.Codigo,
            IdPuntoVenta = sector.IdPuntoVenta,
            Nombre = sector.Nombre,
            Icono = sector.Icono,
            Imagen = sector.Imagen,
            Orden = sector.Orden,
            Activo = sector.Activo
        };
        _showSectorForm = true;
        _showMesaForm = false;
        await LoadMesasAsync(sector.Id);
    }

    private void CancelarSectorForm()
    {
        _showSectorForm = false;
        _sectorForm = new PuntoVentaSectorSaveRequest();
    }

    private async Task GuardarSectorAsync()
    {
        _feedback = null;
        _sectorForm.UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty);
        var result = await UiOps.RunAsync(() => PosConfigSvc.SaveSectorAsync(_sectorForm), "No se pudo guardar el sector.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Guardado", "El sector se guardó correctamente.");
        _showSectorForm = false;
        if (_selectedPuntoVenta is not null)
            await LoadSectoresAsync(_selectedPuntoVenta.Id);
    }

    private async Task LoadMesasAsync(int idSector)
    {
        var result = await UiOps.RunAsync(() => PosConfigSvc.GetMesasAsync(idSector), "No se pudieron cargar las mesas.");
        _mesas = result.Success && result.Value is not null ? result.Value.ToList() : [];
        if (!result.Success)
            _feedback = result.Feedback;
        var activas = _mesas.Where(m => m.Activo && !EsBarra(m)).ToList();
        _cantidadMesas = activas.Count;
        if (activas.Select(m => m.Capacidad).FirstOrDefault(c => c is > 0) is { } capacidad)
            _capacidadMesas = capacidad;
    }

    private static bool EsBarra(PuntoVentaMesaDto mesa)
        => string.Equals(mesa.Codigo?.Trim(), "BAR", StringComparison.OrdinalIgnoreCase);

    private int _cantidadMesas;
    private int _capacidadMesas = 4;
    private bool _redistribuirMesas = true;
    private bool _ajustandoMesas;
    private PuntoVentaMesaDto? _mesaParaBorrar;

    private async Task AjustarCantidadMesasAsync()
    {
        if (_selectedSector is null || _ajustandoMesas) return;
        _ajustandoMesas = true;
        _feedback = null;
        var idSector = _selectedSector.Id;
        var result = await UiOps.RunAsync(
            () => PosConfigSvc.AjustarCantidadMesasAsync(idSector, _cantidadMesas, _capacidadMesas, _redistribuirMesas, AppUserSession.GetCurrentUserName(string.Empty)),
            "No se pudo cambiar la cantidad de mesas.");
        _ajustandoMesas = false;
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        var r = result.Value;
        var partes = new List<string>();
        if (r.Agregadas > 0) partes.Add($"{r.Agregadas} nueva(s)");
        if (r.Reactivadas > 0) partes.Add($"{r.Reactivadas} reactivada(s)");
        if (r.Borradas > 0) partes.Add($"{r.Borradas} borrada(s)");
        if (r.Desactivadas > 0) partes.Add($"{r.Desactivadas} dada(s) de baja porque ya tenían pedidos");
        _feedback = AppUiMessage.Success("Mesas actualizadas",
            $"{_selectedSector.Nombre} quedó con {_cantidadMesas} mesa(s){(partes.Count > 0 ? ": " + string.Join(", ", partes) : string.Empty)}."
            + (_redistribuirMesas ? " Se repartieron en el plano." : string.Empty));
        _showMesaForm = false;
        await LoadMesasAsync(idSector);
    }

    private async Task BorrarMesaAsync()
    {
        if (_mesaParaBorrar is null || _ajustandoMesas) return;
        _ajustandoMesas = true;
        _feedback = null;
        var mesa = _mesaParaBorrar;
        var result = await UiOps.RunAsync(() => PosConfigSvc.DeleteMesaAsync(mesa.Id), "No se pudo borrar la mesa.");
        _ajustandoMesas = false;
        _mesaParaBorrar = null;
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Mesa quitada", $"Se borró la mesa {mesa.Nombre}.");
        if (_mesaForm.Id == mesa.Id)
            CancelarMesaForm();
        if (_selectedSector is not null)
            await LoadMesasAsync(_selectedSector.Id);
    }

    private Task NuevaMesaAsync()
    {
        if (_selectedSector is null)
            return Task.CompletedTask;

        _mesaForm = new PuntoVentaMesaSaveRequest
        {
            Codigo = ProponerCodigo(_mesas.Select(x => x.Codigo)),
            IdSector = _selectedSector.Id,
            Activo = true
        };
        _showMesasModal = true;
        _showMesaForm = true;
        return Task.CompletedTask;
    }

    private Task EditarMesaAsync(PuntoVentaMesaDto mesa)
    {
        _mesaForm = new PuntoVentaMesaSaveRequest
        {
            Id = mesa.Id,
            Codigo = mesa.Codigo,
            IdSector = mesa.IdSector,
            Nombre = mesa.Nombre,
            Capacidad = mesa.Capacidad,
            PosX = mesa.PosX,
            PosY = mesa.PosY,
            Width = mesa.Width,
            Height = mesa.Height,
            Formato = PuntoVentaMesaFormatoKeys.Normalizar(mesa.Formato),
            Icono = mesa.Icono,
            Imagen = mesa.Imagen,
            Activo = mesa.Activo
        };
        _showMesasModal = true;
        _showMesaForm = true;
        return Task.CompletedTask;
    }

    private void CancelarMesaForm()
    {
        _showMesaForm = false;
        _mesaForm = new PuntoVentaMesaSaveRequest();
        if (_selectedSector is not null)
        {
            _showSectoresModal = false;
            _showMesasModal = true;
        }
    }

    private void CerrarEditorMesa() => CancelarMesaForm();

    private async Task GuardarMesaAsync()
    {
        _feedback = null;
        _mesaForm.UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty);
        var result = await UiOps.RunAsync(() => PosConfigSvc.SaveMesaAsync(_mesaForm), "No se pudo guardar la mesa.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Guardado", "La mesa se guardó correctamente.");
        _showMesaForm = false;
        if (_selectedSector is not null)
            await LoadMesasAsync(_selectedSector.Id);
    }

    private static string GetModoTexto(string modo) => modo switch
    {
        PuntoVentaModoKeys.MostradorProduccion => "Mostrador y Producción",
        PuntoVentaModoKeys.Salon => "Salón",
        PuntoVentaModoKeys.Delivery => "Delivery / Take Away",
        _ => "Mostrador"
    };

    private static string GetFeedbackClass(AppUiMessage message) => message.Severity switch
    {
        AppUiFeedbackSeverity.Success => "editor-msg--success",
        AppUiFeedbackSeverity.Warning => "editor-msg--warning",
        AppUiFeedbackSeverity.Info => "editor-msg--info",
        _ => "editor-msg--error"
    };
}
