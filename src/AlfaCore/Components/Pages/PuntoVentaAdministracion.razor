@page "/ventas/puntos-venta"
@page "/{idweb}/{idbase:int}/ventas/puntos-venta"
@using AlfaCore.Models
@using AlfaCore.Services
@using System.Globalization
@inject IPuntoVentaConfigService PosConfigSvc
@inject IAppUiOperationService UiOps
@inject IAppUserSessionService AppUserSession
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Puntos de Venta | Configuración</PageTitle>

<style>
    .pv-admin-rubros {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        padding: 0.35rem 0;
    }

    .pv-admin-rubros .pv-admin-rubro {
        display: inline-flex;
        flex-direction: row;
        align-items: center;
        gap: 0.4rem;
        margin: 0;
        font-size: 0.9rem;
        font-weight: 500;
        text-transform: none;
        cursor: pointer;
    }

    .pv-admin-rubros .pv-admin-rubro input {
        width: auto;
        height: auto;
        min-height: 0;
        margin: 0;
    }

    .pv-admin-form-actions {
        position: sticky;
        top: 4.7rem;
        z-index: 3;
        justify-content: flex-end;
        margin-bottom: 1rem;
        padding: .65rem 0;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-panel-strong);
    }

    .pv-admin-page-intro {
        align-items: flex-start;
    }

    .pv-admin-page-intro__actions {
        display: flex;
        justify-content: flex-end;
        margin-left: auto;
    }

    .pv-admin-quick-inputs {
        display: grid;
        grid-template-columns: repeat(3, minmax(5rem, 1fr));
        gap: 0.5rem;
    }

    .pv-admin-quick-inputs .field { margin: 0; }
    .pv-admin-quick-inputs input { font-variant-numeric: tabular-nums; }

    .pv-admin-rubros__more {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        margin-top: 0.35rem;
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-panel);
        color: var(--color-primary);
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
    }

    .pv-admin-field-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .pv-admin-subfield-label {
        display: block;
        margin-top: .8rem;
        color: var(--color-text);
        font-size: .82rem;
        font-weight: 700;
    }

    .pv-admin-inline-edit {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        min-height: 2.1rem;
        padding: .35rem .7rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: color-mix(in srgb, var(--color-primary) 10%, var(--color-panel));
        color: var(--color-primary);
        cursor: pointer;
        font-weight: 800;
    }

    .pv-admin-inline-edit:hover { border-color: var(--color-primary); }

    .pv-admin-field-heading { display:flex; align-items:center; justify-content:space-between; gap:.75rem; }
    .pv-admin-catalog-summary { display:flex; flex-wrap:wrap; gap:.45rem .8rem; margin-top:.5rem; color:var(--color-muted); font-size:.82rem; }
    .pv-admin-catalog-summary span { display:inline-flex; align-items:center; gap:.35rem; }
    .pv-admin-catalog-summary i { color:var(--color-primary); }
    .pv-admin-config-section {
        margin-top: 1rem;
        padding: 1rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-panel) 78%, transparent);
    }

    .pv-admin-config-section > h4 {
        margin: 0;
        color: var(--color-text);
        font-size: 1rem;
        font-weight: 800;
    }

    .pv-admin-config-section__description {
        display: block;
        margin-top: .25rem;
        color: var(--color-muted);
        font-size: .82rem;
        line-height: 1.4;
    }

    .pv-admin-catalog-section { margin-top: 1.1rem; }
    .pv-admin-catalog-section__heading { align-items: flex-start; }
    .pv-admin-catalog-section__heading h4 { margin: 0; }
    .pv-admin-catalog-section__summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .5rem;
        margin-top: .85rem;
    }

    .pv-admin-catalog-section__summary span {
        display: flex;
        align-items: center;
        gap: .4rem;
        min-height: 2.1rem;
        padding: .45rem .6rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface-subtle);
        color: var(--color-muted);
        font-size: .8rem;
    }

    .pv-admin-catalog-section__rubros {
        margin-top: .85rem;
        padding: .75rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 26%, var(--color-border));
        border-radius: 10px;
        background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    }

    .pv-admin-catalog-section__rubros-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .4rem;
        color: var(--color-text);
        font-size: .84rem;
        font-weight: 800;
    }

    .pv-admin-catalog-section__rubros-title small { color: var(--color-muted); font-weight: 500; }

    @@media (max-width: 650px) {
        .pv-admin-catalog-section__summary { grid-template-columns: 1fr; }
    }
    .pv-admin-catalog-modal__card { width: min(900px, calc(100vw - 2rem)); }

    .pv-admin-catalog-modal__top {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1rem;
        padding: .75rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 28%, var(--color-border));
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-primary) 8%, var(--color-panel));
    }

    .pv-admin-catalog-modal__top > i { color: var(--color-primary); font-size: 1.1rem; }
    .pv-admin-catalog-modal__top div { display: grid; gap: .15rem; }
    .pv-admin-catalog-modal__top small { color: var(--color-muted); }

    .pv-admin-catalog-modal__rubros {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .55rem;
        max-height: min(45vh, 360px);
        overflow: auto;
        padding: .25rem;
    }

    .pv-admin-catalog-modal__empty { color: var(--color-muted); padding: 1rem 0; }
    .pv-admin-catalog-modal__toolbar { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.7rem .8rem; border:1px solid var(--color-border); border-radius:.7rem; background:var(--color-surface-subtle); }
    .pv-admin-catalog-modal__toolbar > div { display:grid; gap:.15rem; }
    .pv-admin-catalog-modal__detect { display:flex !important; align-items:end; gap:.45rem; white-space:nowrap; }
    .pv-admin-catalog-modal__detect label { color:var(--color-muted); font-size:.78rem; }
    .pv-admin-catalog-modal__detect input { width:4.5rem; padding:.45rem .5rem; border:1px solid var(--color-border); border-radius:.4rem; background:var(--color-input); color:var(--color-text); font:inherit; }
    .pv-admin-catalog-modal__toolbar small, .pv-admin-catalog-modal__note { color:var(--color-muted); }
    .pv-admin-catalog-modal__feedback { margin-top:.65rem; padding:.55rem .7rem; border-radius:.55rem; font-size:.86rem; }
    .pv-admin-catalog-modal__feedback.is-ok { color:var(--color-success); background:color-mix(in srgb, var(--color-success) 12%, transparent); }
    .pv-admin-catalog-modal__feedback.is-error { color:var(--color-danger); background:color-mix(in srgb, var(--color-danger) 12%, transparent); }
    .pv-admin-catalog-modal__grid-wrap { max-height: min(48vh, 430px); overflow:auto; margin-top:.7rem; border:1px solid var(--color-border); border-radius:.65rem; }
    .pv-admin-catalog-modal__grid { width:100%; border-collapse:collapse; font-size:.86rem; }
    .pv-admin-catalog-modal__grid th, .pv-admin-catalog-modal__grid td { padding:.48rem .55rem; border-bottom:1px solid var(--color-border); text-align:left; }
    .pv-admin-catalog-modal__grid th { position:sticky; top:0; z-index:1; background:var(--color-surface); color:var(--color-text); }
    .pv-admin-catalog-modal__grid .numeric { text-align:right; white-space:nowrap; }
    .pv-admin-catalog-modal__grid .empty { padding:1.4rem; text-align:center; color:var(--color-muted); }
    .pv-admin-catalog-modal__code-input { width:8rem; min-width:6rem; padding:.35rem .45rem; border:1px solid var(--color-border); border-radius:.35rem; background:var(--color-input); color:var(--color-text); font:inherit; }

    @@media (max-width: 560px) {
        .pv-admin-catalog-modal__rubros { grid-template-columns: 1fr; }
        .pv-admin-catalog-modal__toolbar { align-items:stretch; flex-direction:column; }
    }

    .pv-admin-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        width: fit-content;
        margin-top: 0.35rem;
        color: var(--color-text);
        cursor: pointer;
    }

    .pv-admin-switch__input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .pv-admin-switch__track {
        position: relative;
        display: inline-block;
        width: 2.75rem;
        height: 1.55rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-panel);
        transition: background .15s ease, border-color .15s ease;
    }

    .pv-admin-switch__track::after {
        position: absolute;
        top: 0.18rem;
        left: 0.2rem;
        width: 1.05rem;
        height: 1.05rem;
        border-radius: 50%;
        background: var(--color-muted);
        content: "";
        transition: transform .15s ease, background .15s ease;
    }

    .pv-admin-switch.is-on .pv-admin-switch__track {
        border-color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 22%, transparent);
    }

    .pv-admin-switch.is-on .pv-admin-switch__track::after {
        background: var(--color-primary);
        transform: translateX(1.18rem);
    }

    .pv-admin-switch__text { font-weight: 700; }

    .pv-admin-quick-edit {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2.1rem;
        margin-top: 0.65rem;
        padding: 0.4rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-panel);
        color: var(--color-primary);
        font-weight: 700;
        cursor: pointer;
    }

    .pv-admin-quick-modal {
        position: fixed;
        inset: 0;
        z-index: 30000 !important;
        display: grid;
        place-items: center;
        padding: 1rem;
        background: rgba(2, 8, 23, 0.72);
    }

    .pv-admin-quick-modal__card {
        width: min(42rem, 100%);
        padding: 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 18px;
        background: var(--color-panel-strong);
        color: var(--color-text);
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.4);
    }

    .pv-admin-quick-modal__header,
    .pv-admin-quick-modal__actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .pv-admin-quick-modal__header h3 { margin: 0; }
    .pv-admin-quick-modal__header small { color: var(--color-muted); }
    .pv-admin-quick-modal__close { border: 0; background: transparent; color: var(--color-muted); font-size: 1.5rem; cursor: pointer; }
    .pv-admin-quick-modal__quantities { display: flex; flex-wrap: wrap; gap: .45rem; margin: 1rem 0; }
    .pv-admin-quick-modal__quantity { padding: .35rem .6rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-muted); font-size: .82rem; }
    .pv-admin-quick-modal__actions { justify-content: flex-end; margin-top: 1rem; }

    .pv-admin-pv-modal__card {
        width: min(980px, calc(100vw - 2rem));
        max-height: calc(100vh - 2rem);
        overflow: auto;
        padding: 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 18px;
        background: var(--color-panel-strong);
        color: var(--color-text);
        box-shadow: 0 24px 70px rgba(0, 0, 0, .45);
    }

    .pv-admin-pv-modal__header {
        position: sticky;
        top: -1.25rem;
        z-index: 4;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin: -1.25rem -1.25rem 1rem;
        padding: 1.1rem 1.25rem .9rem;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-panel-strong);
    }

    .pv-admin-pv-modal__header h3 { margin: 0; }
    .pv-admin-pv-modal__header small { color: var(--color-muted); }
    .pv-admin-pv-modal__close {
        display: inline-grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-panel);
        color: var(--color-text);
        font-size: 1.35rem;
        cursor: pointer;
    }

    .pv-admin-pv-modal__close:hover { border-color: var(--color-primary); color: var(--color-primary); }

    .pv-admin-salon-layout {
        display: grid;
        grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
        align-items: start;
        gap: 1rem;
        margin-top: 1rem;
    }

    .pv-admin-salon-sectors,
    .pv-admin-salon-mesas { min-width: 0; }

    /* Sectores y mesas se administran desde sus modales; no duplicar las tablas debajo del formulario. */
    .pv-admin-inline-salon-view { display: none; }

    @@media (max-width: 900px) {
        .pv-admin-salon-layout { grid-template-columns: 1fr; }
    }

    .pv-admin-pv-modal__identity {
        display: grid;
        grid-template-columns: minmax(7rem, .35fr) minmax(14rem, 1fr) auto;
        align-items: end;
        gap: .75rem;
        margin-bottom: 1rem;
        padding: .85rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 24%, var(--color-border));
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    }

    .pv-admin-pv-modal__topbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: .75rem;
        margin-bottom: 1rem;
        padding: .75rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 24%, var(--color-border));
        border-radius: 12px;
        background: var(--color-panel-strong);
    }

    .pv-admin-pv-modal__topbar .pv-admin-pv-modal__identity {
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
    }

    .pv-admin-pv-modal__topbar .pv-admin-form-actions {
        position: sticky;
        top: 4.7rem;
        z-index: 3;
        margin: 0;
        padding: 0;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-panel-strong);
        padding: .45rem;
        white-space: nowrap;
    }

    .pv-admin-sectors-modal__card {
        width: min(760px, calc(100vw - 2rem));
        max-height: calc(100vh - 2rem);
        overflow: auto;
    }
    .pv-admin-sectors-modal__table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    .pv-admin-sectors-modal__table th,
    .pv-admin-sectors-modal__table td { padding: .6rem .55rem; border-bottom: 1px solid var(--color-border); text-align: left; }
    .pv-admin-sectors-modal__table th { color: var(--color-muted); font-size: .78rem; text-transform: uppercase; }
    .pv-admin-sectors-modal__empty { padding: 1.2rem 0; color: var(--color-muted); text-align: center; }
    .pv-admin-sectors-modal__actions { display: inline-flex; gap: .35rem; }
    .pv-admin-mesas-modal__toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        gap: .55rem;
        margin-top: 1rem;
        padding: .7rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface-subtle);
    }
    .pv-admin-mesas-modal__toolbar label { display: grid; gap: .3rem; color: var(--color-muted); font-size: .76rem; font-weight: 700; }
    .pv-admin-mesas-modal__toolbar input[type="number"] {
        width: 6.2rem;
        min-height: 2.35rem;
        padding: .4rem .55rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        outline: none;
        background: var(--color-input);
        color: var(--color-text);
        font: inherit;
        font-size: .9rem;
        font-variant-numeric: tabular-nums;
    }
    .pv-admin-mesas-modal__toolbar input[type="number"]:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 20%, transparent);
    }
    .pv-admin-mesas-modal__toolbar .pv-mesas-cantidad__check {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        min-height: 2.35rem;
        padding: 0 .55rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-input);
        color: var(--color-text);
        cursor: pointer;
    }
    .pv-admin-mesas-modal__toolbar .pv-mesas-cantidad__check input { accent-color: var(--color-primary); }

    .pv-admin-pv-modal__identity .field { min-width: 0; margin: 0; }
    .pv-admin-pv-modal__identity input { max-width: 100%; min-width: 0; }
    .pv-admin-pv-modal__identity .carga-viajes-check { margin: 0 0 .15rem; white-space: nowrap; }

    @@media (max-width: 1000px) {
        .pv-admin-pv-modal__card { width: calc(100vw - 2rem); }
        .pv-admin-pv-modal__topbar { grid-template-columns: 1fr; align-items: stretch; }
        .pv-admin-pv-modal__identity { grid-template-columns: 1fr 1fr; }
        .pv-admin-pv-modal__identity .carga-viajes-check { grid-column: 1 / -1; }
        .pv-admin-pv-modal__topbar .pv-admin-form-actions { justify-content: flex-start; flex-wrap: wrap; }
    }

    @@media (max-width: 560px) {
        .pv-admin-pv-modal__identity { grid-template-columns: 1fr; }
        .pv-admin-pv-modal__identity .carga-viajes-check { grid-column: auto; }
    }

    .pv-admin-receipt-preview {
        display: grid;
        place-items: start center;
        max-height: 70vh;
        overflow: auto;
        padding: 1rem;
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-background) 88%, #000);
    }

    .pv-admin-receipt-paper {
        width: min(100%, 320px);
        min-height: 420px;
        padding: 1.25rem 1rem;
        background: #fff;
        color: #151515;
        font-family: Arial, sans-serif;
        font-size: .78rem;
        box-shadow: 0 12px 30px rgba(0,0,0,.3);
    }

    .pv-admin-receipt-paper.is-a4 {
        width: min(100%, 680px);
        min-height: 820px;
        padding: 2rem;
        font-size: .9rem;
    }

    .pv-admin-receipt-paper__header { padding-bottom: .7rem; border-bottom: 1px dashed #777; text-align: center; }
    .pv-admin-receipt-paper__header strong { display: block; font-size: 1.15em; }
    .pv-admin-receipt-paper__title { margin: .9rem 0; font-weight: 800; text-align: center; }
    .pv-admin-receipt-paper__row { display: flex; justify-content: space-between; gap: 1rem; padding: .25rem 0; }
    .pv-admin-receipt-paper__row span:first-child { color: #555; }
    .pv-admin-receipt-paper__total { margin-top: .6rem; padding-top: .6rem; border-top: 1px solid #222; font-weight: 800; }
    .pv-admin-receipt-paper__footer { margin-top: 2rem; padding-top: .7rem; border-top: 1px dashed #777; text-align: center; color: #555; }
</style>

<section class="page-grid">
    <div class="page-intro pv-admin-page-intro">
        <div>
            <h2 class="page-intro__title">Puntos de Venta<AlfaInfoTip>Administrá los puntos de venta (Mostrador, Salón, Delivery) y, para Salón, sus sectores y mesas.</AlfaInfoTip></h2>
        </div>
        <div class="pv-admin-page-intro__actions">
            <button type="button" class="btn btn--ghost btn--sm" @onclick="VolverAlDashboardVentas">
                <i class="bi bi-arrow-left"></i> Volver
            </button>
        </div>
    </div>

    @if (_feedback is not null)
    {
        <div class="editor-msg @GetFeedbackClass(_feedback)">
            <strong>@_feedback.Title</strong>
            <span>@_feedback.Message</span>
        </div>
    }

    @if (_loading)
    {
        <div class="loading">Cargando puntos de venta...</div>
    }
    else
    {
        <div class="split-grid">
            <DataTable Titulo="Puntos de venta" Subtitulo="Cada punto de venta define un modo de operación.">
                <Toolbar>
                    <button type="button" class="btn btn--primary btn--sm" @onclick="NuevoPuntoVentaAsync">+ Nuevo</button>
                </Toolbar>
                <Header>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Modo</th>
                        <th>Activo</th>
                        <th></th>
                    </tr>
                </Header>
                <Rows>
                    @if (_puntosVenta.Count == 0)
                    {
                        <tr><td colspan="5">No hay puntos de venta cargados todavía.</td></tr>
                    }
                    @foreach (var pv in _puntosVenta)
                    {
                        <tr class="@(pv.Id == _selectedPuntoVenta?.Id ? "row--selected" : string.Empty)">
                            <td>@pv.Codigo</td>
                            <td>@pv.Nombre</td>
                            <td>@GetModoTexto(pv.Modo)</td>
                            <td>@(pv.Activo ? "Sí" : "No")</td>
                            <td><button type="button" class="btn btn--ghost btn--sm" @onclick="() => SeleccionarPuntoVentaAsync(pv)">Editar</button></td>
                        </tr>
                    }
                </Rows>
            </DataTable>

            @if (_showPuntoVentaForm)
            {
                <div class="pv-admin-quick-modal" role="dialog" aria-modal="true" aria-labelledby="punto-venta-form-title">
                    <section class="pv-admin-pv-modal__card">
                        <header class="pv-admin-pv-modal__header">
                            <div>
                                <h3 id="punto-venta-form-title">@(_puntoVentaForm.Id.HasValue ? "Editar punto de venta" : "Nuevo punto de venta")</h3>
                                <small>Configurá el modo de operación, catálogo, ingreso rápido y recibos.</small>
                            </div>
                            <button type="button" class="pv-admin-pv-modal__close" @onclick="CancelarPuntoVentaForm" aria-label="Cerrar">×</button>
                        </header>
                        <div class="pv-admin-pv-modal__topbar">
                        <div class="pv-admin-pv-modal__identity">
                            <div class="field">
                                <label>Código</label>
                                <input maxlength="4" @bind="_puntoVentaForm.Codigo" placeholder="Ej: 001" />
                            </div>
                            <div class="field">
                                <label>Nombre</label>
                                <input @bind="_puntoVentaForm.Nombre" placeholder="Ej: Salón principal" />
                            </div>
                            <label class="carga-viajes-check">
                                <input class="carga-viajes-check__input" type="checkbox" checked="@_puntoVentaForm.Activo" @onchange="args => _puntoVentaForm.Activo = args.Value is bool flag && flag" />
                                <span class="carga-viajes-check__box" aria-hidden="true"></span>
                                <span class="carga-viajes-check__text">Punto de venta activo</span>
                            </label>
                        </div>
                    <div class="actions pv-admin-form-actions">
                        @if (string.Equals(_puntoVentaForm.Modo, PuntoVentaModoKeys.Salon, StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="AbrirSectoresModalAsync">
                                <i class="bi bi-grid-3x3-gap"></i> Sectores
                            </button>
                        }
                        <button type="button" class="btn btn--primary btn--sm" @onclick="GuardarPuntoVentaAsync">Guardar</button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="CancelarPuntoVentaForm">Cancelar</button>
                        @if (_puntoVentaForm.Id is > 0)
                        {
                            <button type="button" class="btn btn--danger btn--sm" @onclick="() => _confirmarBorrarPuntoVenta = true">Borrar</button>
                        }
                    </div>
                        </div>
                    <div class="field">
                        <label>Modo</label>
                        <select @bind="_puntoVentaForm.Modo">
                            <option value="@PuntoVentaModoKeys.Mostrador">Mostrador</option>
                            <option value="@PuntoVentaModoKeys.MostradorProduccion">Mostrador y Producción</option>
                            <option value="@PuntoVentaModoKeys.Salon">Salón</option>
                            <option value="@PuntoVentaModoKeys.Delivery">Delivery / Take Away</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Comprobante habitual de esta PC</label>
                        <select @bind="_comprobanteHabitual">
                            <option value="FC">Factura electrónica (eFC)</option>
                            <option value="NC">Nota de crédito (NC)</option>
                            <option value="FP">Factura proforma (FP)</option>
                            <option value="NCFP">Nota de crédito proforma (NCFP)</option>
                        </select>
                        <small>Se guarda en la configuración existente de esta PC.</small>
                    </div>
                    <div class="field">
                        <label>Unidad de negocio</label>
                        <select @bind="_puntoVentaForm.Unegocio">
                            <option value="">Sin unidad de negocio</option>
                            @foreach (var item in _catalogos.UnidadesNegocio)
                            {
                                <option value="@item.Valor">@item.Valor · @item.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Caja</label>
                        <select @bind="_puntoVentaForm.IdCaja">
                            <option value="">Sin caja</option>
                            @foreach (var item in _catalogos.Cajas)
                            {
                                <option value="@item.Valor">@item.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Sucursal</label>
                        <select @bind="_puntoVentaForm.Sucursal">
                            <option value="">Usar configuración general</option>
                            @foreach (var item in _catalogos.Sucursales)
                            {
                                <option value="@item.Valor">@item.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Lista de precios</label>
                        <select @bind="_puntoVentaForm.IdLista">
                            <option value="">Sin lista (precios del maestro de artículos)</option>
                            @foreach (var item in _catalogos.ListasPrecios)
                            {
                                <option value="@item.Valor">@item.Descripcion</option>
                            }
                        </select>
                        <small>Un cliente con lista propia sigue usando la suya.</small>
                    </div>
                    <div class="field">
                        <label>Clase de precio</label>
                        <select value="@(_puntoVentaForm.ClasePrecio?.ToString() ?? string.Empty)"
                                @onchange="args => _puntoVentaForm.ClasePrecio = int.TryParse(args.Value?.ToString(), out var clase) ? clase : null">
                            <option value="">Usar configuración general</option>
                            @for (var clase = 1; clase <= 8; clase++)
                            {
                                <option value="@clase">Clase @clase</option>
                            }
                        </select>
                    </div>
                    <section class="field pv-admin-config-section pv-admin-catalog-section">
                        <div class="pv-admin-field-heading pv-admin-catalog-section__heading">
                            <div>
                                <h4>Catálogo de artículos</h4>
                                <small class="pv-admin-config-section__description">Definí qué artículos y rubros se muestran en el facturador gráfico de este punto de venta.</small>
                            </div>
                            <button type="button" class="pv-admin-inline-edit" @onclick="AbrirEditorCatalogo">
                                <i class="bi bi-pencil-square"></i> Editar
                            </button>
                        </div>
                        <div class="pv-admin-catalog-section__summary">
                            <span><i class="bi bi-star-fill"></i> Artículos destacados: lista Top</span>
                            <span>Rubros por punto de venta: @(_puntoVentaForm.Rubros.Count == 0 ? "todos" : $"{_puntoVentaForm.Rubros.Count} configurados")</span>
                        </div>
                        <div class="pv-admin-catalog-section__rubros">
                            <div class="pv-admin-catalog-section__rubros-title">
                                <span>Rubros que vende</span>
                                <small>Sin marcar = todos</small>
                            </div>
                            @if (_catalogos.Rubros.Count == 0)
                            {
                                <small class="pv-admin-config-section__description">No hay rubros cargados: se venden todos los artículos.</small>
                            }
                            else
                            {
                                <div class="pv-admin-rubros">
                                    <label class="pv-admin-rubro">
                                        <input type="checkbox" checked="@(_puntoVentaForm.Rubros.Count == 0)"
                                               @onchange="_ => _puntoVentaForm.Rubros.Clear()" />
                                        Todos
                                    </label>
                                    @foreach (var rubro in RubrosVisibles)
                                    {
                                        var id = rubro.Valor;
                                        <label class="pv-admin-rubro">
                                            <input type="checkbox" checked="@_puntoVentaForm.Rubros.Contains(id, StringComparer.OrdinalIgnoreCase)"
                                                   @onchange="_ => ToggleRubro(id)" />
                                            @rubro.Descripcion
                                        </label>
                                    }
                                </div>
                                @if (_catalogos.Rubros.Count > 15)
                                {
                                    <button type="button" class="pv-admin-rubros__more" @onclick="() => _mostrarTodosRubros = !_mostrarTodosRubros">
                                        @(_mostrarTodosRubros ? "Ver menos" : $"Ver todos ({_catalogos.Rubros.Count})")
                                    </button>
                                }
                            }
                        </div>
                    </section>
                    <section class="field pv-admin-config-section">
                        <h4>Panel de ingreso rápido</h4>
                        <small class="pv-admin-config-section__description">Permite cargar importes o cantidades desde un teclado táctil dentro del punto de venta.</small>
                        <label class="pv-admin-switch @(_puntoVentaForm.CargaRapidaGrafica ? "is-on" : string.Empty)">
                            <input class="pv-admin-switch__input" type="checkbox" checked="@_puntoVentaForm.CargaRapidaGrafica" @onchange="OnIngresoRapidoEnabledChanged" />
                            <span class="pv-admin-switch__track" aria-hidden="true"></span>
                            <span class="pv-admin-switch__text">Activar panel en este punto de venta</span>
                        </label>
                        <label class="field pv-admin-quick-mode">
                            <span>Presentación del panel</span>
                            <select @bind="_puntoVentaForm.ModoIngresoRapido">
                                <option value="DESHABILITADO">No mostrar</option>
                                <option value="COMPACTO">Compacto: muestra valores rápidos y despliega el teclado</option>
                                <option value="COMPLETO">Completo: muestra siempre el teclado numérico</option>
                            </select>
                        </label>
                        <small class="pv-admin-config-section__description">Compacto ocupa menos espacio. Completo deja todos los botones visibles durante la venta.</small>
                        @if (_puntoVentaForm.ModoIngresoRapido != PuntoVentaIngresoRapidoModoKeys.Deshabilitado)
                        {
                            <button type="button" class="pv-admin-quick-edit" @onclick="AbrirEditorIngresoRapido">
                                <i class="bi bi-pencil-square"></i> Editar importes y cantidades
                            </button>
                        }
                    </section>
                    @if (string.Equals(_puntoVentaForm.Modo, PuntoVentaModoKeys.MostradorProduccion, StringComparison.OrdinalIgnoreCase))
                    {
                    <section class="field pv-admin-config-section">
                        <h4>Recibo de anticipo</h4>
                        <small class="pv-admin-config-section__description">Define qué hacer con el comprobante que se entrega al cliente cuando una Nota de Pedido recibe una seña.</small>
                        <label class="field pv-admin-quick-mode">
                            <span>Cuándo imprimir</span>
                            <select @bind="_puntoVentaForm.ModalidadReciboAnticipo">
                                <option value="NO">No imprimir recibo</option>
                                <option value="PREGUNTAR">Preguntar antes de imprimir</option>
                                <option value="AUTOMATICO">Imprimir automáticamente al registrar la seña</option>
                            </select>
                        </label>
                        <small class="pv-admin-config-section__description">La impresión se realiza únicamente después de registrar correctamente el anticipo.</small>
                        <label class="field pv-admin-quick-mode">
                            <span>Formato del recibo</span>
                            <select @bind="_puntoVentaForm.FormatoReciboAnticipo">
                                <option value="TICKET80">Ticket térmico 80 mm</option>
                                <option value="A4">A4</option>
                            </select>
                        </label>
                        <button type="button" class="pv-admin-quick-edit" @onclick="AbrirVistaPreviaRecibo">
                            <i class="bi bi-eye"></i> Vista previa
                        </button>
                        <div class="pv-admin-rubros">
                            <label class="pv-admin-rubro"><input type="checkbox" @bind="_puntoVentaForm.ReciboAnticipoMuestraEmpresa" /> Empresa y sucursal</label>
                            <label class="pv-admin-rubro"><input type="checkbox" @bind="_puntoVentaForm.ReciboAnticipoMuestraPedido" /> Pedido y cobranza</label>
                            <label class="pv-admin-rubro"><input type="checkbox" @bind="_puntoVentaForm.ReciboAnticipoMuestraCliente" /> Cliente</label>
                            <label class="pv-admin-rubro"><input type="checkbox" @bind="_puntoVentaForm.ReciboAnticipoMuestraImportes" /> Total, seña y saldo</label>
                            <label class="pv-admin-rubro"><input type="checkbox" @bind="_puntoVentaForm.ReciboAnticipoMuestraMediosPago" /> Medios de pago</label>
                            <label class="pv-admin-rubro"><input type="checkbox" @bind="_puntoVentaForm.ReciboAnticipoMuestraEntrega" /> Fecha de entrega</label>
                            <label class="pv-admin-rubro"><input type="checkbox" @bind="_puntoVentaForm.ReciboAnticipoMuestraUsuario" /> Usuario</label>
                        </div>
                    </section>
                    }
                    </section>
                </div>
            }
        </div>
    }

    @if (_showIngresoRapidoModal)
    {
        <div class="pv-admin-quick-modal" role="dialog" aria-modal="true" aria-labelledby="ingreso-rapido-config-title">
            <section class="pv-admin-quick-modal__card">
                <header class="pv-admin-quick-modal__header">
                    <div>
                        <h3 id="ingreso-rapido-config-title">Ingreso rápido</h3>
                        <small>Configurá los importes que aparecerán en el teclado táctil.</small>
                    </div>
                    <button type="button" class="pv-admin-quick-modal__close" @onclick="CerrarEditorIngresoRapido" aria-label="Cerrar">×</button>
                </header>

                <div class="pv-admin-quick-inputs">
                    <div class="field"><label>Importe rápido 1</label><input inputmode="decimal" @bind="_quickDraft1" /></div>
                    <div class="field"><label>Importe rápido 2</label><input inputmode="decimal" @bind="_quickDraft2" /></div>
                    <div class="field"><label>Importe rápido 3</label><input inputmode="decimal" @bind="_quickDraft3" /></div>
                    <div class="field"><label>Importe rápido 4</label><input inputmode="decimal" @bind="_quickDraft4" /></div>
                    <div class="field"><label>Importe rápido 5</label><input inputmode="decimal" @bind="_quickDraft5" /></div>
                    <div class="field"><label>Importe rápido 6</label><input inputmode="decimal" @bind="_quickDraft6" /></div>
                </div>

                <strong>Cantidades rápidas</strong>
                <div class="pv-admin-quick-modal__quantities" aria-label="Cantidades rápidas fijas">
                    <div class="pv-admin-quick-inputs">
                        <div class="field"><label>Cantidad rápida 1</label><input inputmode="decimal" @bind="_quickQuantityDraft1" /></div>
                        <div class="field"><label>Cantidad rápida 2</label><input inputmode="decimal" @bind="_quickQuantityDraft2" /></div>
                        <div class="field"><label>Cantidad rápida 3</label><input inputmode="decimal" @bind="_quickQuantityDraft3" /></div>
                        <div class="field"><label>Cantidad rápida 4</label><input inputmode="decimal" @bind="_quickQuantityDraft4" /></div>
                        <div class="field"><label>Cantidad rápida 5</label><input inputmode="decimal" @bind="_quickQuantityDraft5" /></div>
                        <div class="field"><label>Cantidad rápida 6</label><input inputmode="decimal" @bind="_quickQuantityDraft6" /></div>
                    </div>
                </div>
                <small>Se guardan por punto de venta y se muestran con dos decimales.</small>

                <footer class="pv-admin-quick-modal__actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarEditorIngresoRapido">Cancelar</button>
                    <button type="button" class="btn btn--primary btn--sm" @onclick="AplicarEditorIngresoRapido">Aplicar</button>
                </footer>
            </section>
        </div>
    }

    @if (_showReciboAnticipoPreview)
    {
        <div class="pv-admin-quick-modal" role="dialog" aria-modal="true" aria-labelledby="recibo-anticipo-preview-title">
            <section class="pv-admin-quick-modal__card pv-admin-catalog-modal__card">
                <header class="pv-admin-quick-modal__header">
                    <div>
                        <h3 id="recibo-anticipo-preview-title">Vista previa del recibo</h3>
                        <small>@(_puntoVentaForm.FormatoReciboAnticipo == PuntoVentaReciboAnticipoFormatoKeys.A4 ? "Formato A4" : "Ticket térmico 80 mm") · Datos ilustrativos</small>
                    </div>
                    <button type="button" class="pv-admin-quick-modal__close" @onclick="CerrarVistaPreviaRecibo" aria-label="Cerrar">×</button>
                </header>

                <div class="pv-admin-receipt-preview">
                    <article class="pv-admin-receipt-paper @(_puntoVentaForm.FormatoReciboAnticipo == PuntoVentaReciboAnticipoFormatoKeys.A4 ? "is-a4" : string.Empty)">
                        @if (_puntoVentaForm.ReciboAnticipoMuestraEmpresa)
                        {
                            <div class="pv-admin-receipt-paper__header">
                                <strong>LA NUEVA</strong>
                                <span>@(_puntoVentaForm.Nombre.Length > 0 ? _puntoVentaForm.Nombre : "Punto de venta")</span>
                                <span>Sucursal 0001</span>
                            </div>
                        }
                        <div class="pv-admin-receipt-paper__title">RECIBO DE ANTICIPO</div>
                        @if (_puntoVentaForm.ReciboAnticipoMuestraPedido)
                        {
                            <div class="pv-admin-receipt-paper__row"><span>Pedido</span><strong>NP 0000000001X</strong></div>
                            <div class="pv-admin-receipt-paper__row"><span>Cobranza</span><strong>CBCT 0000000001X</strong></div>
                        }
                        @if (_puntoVentaForm.ReciboAnticipoMuestraCliente)
                        {
                            <div class="pv-admin-receipt-paper__row"><span>Cliente</span><strong>Cliente de ejemplo</strong></div>
                        }
                        @if (_puntoVentaForm.ReciboAnticipoMuestraImportes)
                        {
                            <div class="pv-admin-receipt-paper__row"><span>Total del pedido</span><strong>$ 50.000,00</strong></div>
                            <div class="pv-admin-receipt-paper__row"><span>Anticipo recibido</span><strong>$ 20.000,00</strong></div>
                            <div class="pv-admin-receipt-paper__row"><span>Saldo pendiente</span><strong>$ 30.000,00</strong></div>
                        }
                        @if (_puntoVentaForm.ReciboAnticipoMuestraMediosPago)
                        {
                            <div class="pv-admin-receipt-paper__row"><span>Medio de pago</span><strong>Efectivo</strong></div>
                        }
                        @if (_puntoVentaForm.ReciboAnticipoMuestraEntrega)
                        {
                            <div class="pv-admin-receipt-paper__row"><span>Entrega</span><strong>28/11/2026 - 17:00</strong></div>
                        }
                        @if (_puntoVentaForm.ReciboAnticipoMuestraUsuario)
                        {
                            <div class="pv-admin-receipt-paper__row"><span>Usuario</span><strong>Vendedor</strong></div>
                        }
                        <div class="pv-admin-receipt-paper__footer">Datos de muestra · No es un comprobante fiscal</div>
                    </article>
                </div>
                <footer class="pv-admin-quick-modal__actions">
                    <button type="button" class="btn btn--primary btn--sm" @onclick="CerrarVistaPreviaRecibo">Cerrar</button>
                </footer>
            </section>
        </div>
    }

    @if (_showCatalogoModal)
    {
        <div class="pv-admin-quick-modal" role="dialog" aria-modal="true" aria-labelledby="catalogo-config-title">
            <section class="pv-admin-quick-modal__card pv-admin-catalog-modal__card">
                <header class="pv-admin-quick-modal__header">
                    <div>
                        <h3 id="catalogo-config-title">Catálogo de artículos</h3>
                        <small>Administrá los artículos que aparecen primero en el catálogo gráfico.</small>
                    </div>
                    <button type="button" class="pv-admin-quick-modal__close" @onclick="CerrarEditorCatalogo" aria-label="Cerrar">×</button>
                </header>

                <div class="pv-admin-catalog-modal__toolbar">
                    <div>
                        <strong>Artículos más vendidos</strong>
                        <small>Elegí cuántos artículos detectar de los últimos 12 meses.</small>
                    </div>
                    <div class="pv-admin-catalog-modal__detect">
                        <label for="top-articulos-limite">Cantidad</label>
                        <input id="top-articulos-limite" type="number" min="1" max="100" step="1" @bind="_topLimiteDraft" />
                        <button type="button" class="btn btn--primary btn--sm" @onclick="DetectarTopArticulosAsync" disabled="@_detectandoTop">
                            <i class="bi bi-stars"></i> @(_detectandoTop ? "Detectando..." : $"Detectar Top {_topLimiteDraft}")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_catalogoFeedback))
                {
                    <div class="pv-admin-catalog-modal__feedback @(_catalogoFeedbackOk ? "is-ok" : "is-error")">@_catalogoFeedback</div>
                }

                <div class="pv-admin-catalog-modal__grid-wrap">
                    <table class="pv-admin-catalog-modal__grid">
                        <thead>
                            <tr><th>Pos.</th><th>Código</th><th>Descripción</th><th class="numeric">Cantidad</th><th class="numeric">Total</th></tr>
                        </thead>
                        <tbody>
                            @if (_topArticulos.Count == 0)
                            {
                                <tr><td colspan="5" class="empty">No hay artículos Top configurados. Presioná “Detectar Top 100”.</td></tr>
                            }
                            else
                            {
                                @foreach (var articulo in _topArticulos)
                                {
                                    <tr>
                                        <td>@articulo.Posicion</td>
                                        <td><input class="pv-admin-catalog-modal__code-input" @bind="articulo.IdArticulo" aria-label="Código del artículo @articulo.Posicion" /></td>
                                        <td>@articulo.Descripcion</td>
                                        <td class="numeric">@articulo.CantidadVendida.ToString("N2")</td>
                                        <td class="numeric">@articulo.TotalVendido.ToString("C2", _culturaAr)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <small class="pv-admin-catalog-modal__note">Al guardar se actualiza la lista legacy global <code>GOUR_TOPVTAS</code>, que también utiliza Alfa Gestión.</small>

                <footer class="pv-admin-quick-modal__actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarEditorCatalogo">Cancelar</button>
                    <button type="button" class="btn btn--primary btn--sm" @onclick="GuardarCatalogoAsync" disabled="@_guardandoTop">@(_guardandoTop ? "Guardando..." : "Guardar lista")</button>
                </footer>
            </section>
        </div>
    }

    @if (_showSectoresModal && _selectedPuntoVenta is not null)
    {
        <div class="pv-admin-quick-modal" role="dialog" aria-modal="true" aria-labelledby="sectores-modal-title">
            <section class="pv-admin-quick-modal__card pv-admin-sectors-modal__card">
                <header class="pv-admin-quick-modal__header">
                    <div>
                        <h3 id="sectores-modal-title">Sectores de @_selectedPuntoVenta.Nombre</h3>
                        <small>Administrá los sectores del salón sin salir de la edición del punto de venta.</small>
                    </div>
                    <button type="button" class="pv-admin-quick-modal__close" @onclick="CerrarSectoresModal" aria-label="Cerrar">×</button>
                </header>

                <div class="actions" style="justify-content:flex-end;">
                    <button type="button" class="btn btn--primary btn--sm" @onclick="NuevoSectorAsync">+ Nuevo sector</button>
                </div>
                @if (_sectores.Count == 0)
                {
                    <div class="pv-admin-sectors-modal__empty">Este punto de venta todavía no tiene sectores.</div>
                }
                else
                {
                    <table class="pv-admin-sectors-modal__table">
                        <thead><tr><th>Código</th><th>Nombre</th><th>Orden</th><th>Estado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var sector in _sectores)
                            {
                                <tr>
                                    <td>@sector.Codigo</td>
                                    <td>@sector.Nombre</td>
                                    <td>@sector.Orden</td>
                                    <td>@(sector.Activo ? "Activo" : "Inactivo")</td>
                                    <td>
                                        <div class="pv-admin-sectors-modal__actions">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AbrirMesasModalAsync(sector)">
                                                <i class="bi bi-grid-3x3"></i> Mesas
                                            </button>
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => SeleccionarSectorAsync(sector)">Editar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <footer class="pv-admin-quick-modal__actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarSectoresModal">Cerrar</button>
                </footer>
            </section>
        </div>
    }

    @if (_showMesasModal && _selectedSector is not null)
    {
        <div class="pv-admin-quick-modal" role="dialog" aria-modal="true" aria-labelledby="mesas-modal-title">
            <section class="pv-admin-quick-modal__card pv-admin-sectors-modal__card">
                <header class="pv-admin-quick-modal__header">
                    <div>
                        <h3 id="mesas-modal-title">Mesas de @_selectedSector.Nombre</h3>
