@page "/carga-viajes/viaje/{Id:int}"
@page "/{idweb}/{idbase:int}/carga-viajes/viaje/{Id:int}"
@using AlfaCore.Models
@using AlfaCore.Services
@inject ICargaViajesService CargaViajesSvc
@inject IAppUiOperationService UiOps
@inject IJSRuntime JS
@inject IRouteContextService RouteContext
@inject IViajePreviewStateService PreviewState
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Viaje | Alfa Gestión</PageTitle>

<div class="gd gd-modal-scope viaje-preview-ad">
@if (_loading)
{
    <div class="viaje-preview-page">
        <div class="viaje-preview-page__loading panel-card">
            <i class="bi bi-hourglass-split"></i>
            <span>Cargando viaje...</span>
        </div>
    </div>
}
else if (_preview is null)
{
    <div class="viaje-preview-page">
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error"
                        Title="Viaje no disponible"
                        Message="@(_feedback?.Message ?? "No se pudo cargar la vista previa solicitada.")" />
    </div>
}
else
{
    var adicionales = GetAdicionales();

    <div class="viaje-preview-page">
        <article class="viaje-preview-card">
            <header class="viaje-preview-card__hero">
                <div>
                    <p class="viaje-preview-card__eyebrow">ALFA GESTIÓN</p>
                    <h1>VIAJE</h1>
                    <p class="viaje-preview-card__subtitle">@_preview.Viaje.Fecha.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="viaje-preview-card__badge">
                    <span>Vista HTML</span>
                    <strong>Preparada para impresión</strong>
                </div>
            </header>

            <section class="viaje-preview-card__grid">
                <div class="viaje-preview-field">
                    <span class="viaje-preview-field__label">Fecha</span>
                    <strong>@_preview.Viaje.Fecha.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="viaje-preview-field">
                    <span class="viaje-preview-field__label">Cliente</span>
                    <strong>@GetDisplayOrDefault(_preview.Viaje.ClienteNombre, "Sin cliente")</strong>
                </div>
                <div class="viaje-preview-field">
                    <span class="viaje-preview-field__label">Destino</span>
                    <strong>@GetDisplayOrDefault(_preview.Viaje.DestinoDescripcion, "Sin destino")</strong>
                </div>
                <div class="viaje-preview-field">
                    <span class="viaje-preview-field__label">Chofer / Fletero</span>
                    <strong>@GetDisplayOrDefault(_preview.Viaje.ChoferNombre, "Sin chofer")</strong>
                </div>
                <div class="viaje-preview-field">
                    <span class="viaje-preview-field__label">Tipo de vehículo</span>
                    <strong>@GetDisplayOrDefault(_preview.Viaje.TipoVehiculoDescripcion, "Sin vehículo")</strong>
                </div>
                <div class="viaje-preview-field">
                    <span class="viaje-preview-field__label">Tarifa utilizada</span>
                    <strong>@GetDisplayOrDefault(_preview.Viaje.ListaDisplay, _preview.Viaje.ListaDescripcion)</strong>
                </div>
            </section>

            <section class="viaje-preview-section">
                <div class="viaje-preview-section__head">
                    <h2>Adicionales</h2>
                    <span>@GetAdicionalesResumen(adicionales.Count)</span>
                </div>

                @if (adicionales.Count == 0)
                {
                    <p class="viaje-preview-empty">Sin adicionales cargados.</p>
                }
                else
                {
                    <div class="viaje-preview-additional-list">
                        @foreach (var item in adicionales)
                        {
                            <article class="viaje-preview-additional @(item.Activo ? "viaje-preview-additional--active" : string.Empty)">
                                <div class="viaje-preview-additional__check" aria-hidden="true">
                                    <i class="bi @(item.Activo ? "bi-check-lg" : "bi-dash-lg")"></i>
                                </div>
                                <div class="viaje-preview-additional__content">
                                    <strong>@item.Titulo</strong>
                                    <span>@item.Subtitulo</span>
                                </div>
                                <div class="viaje-preview-additional__amount">
                                    @FormatMoney(item.Importe)
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="viaje-preview-card__details">
                <article class="viaje-preview-detail viaje-preview-detail--cliente">
                    <div class="viaje-preview-detail__head">
                        <span>Detalle cliente</span>
                        <strong>CLIENTE</strong>
                    </div>
                    <div class="viaje-preview-detail__lines">
                        @foreach (var item in GetClienteConceptos())
                        {
                            <div class="viaje-preview-detail__line">
                                <span>@item.Descripcion</span>
                                <strong>@FormatMoney(item.Importe)</strong>
                            </div>
                        }
                    </div>
                    <div class="viaje-preview-detail__total">
                        <span>TOTAL CLIENTE</span>
                        <strong>@FormatMoney(GetTotalCliente())</strong>
                    </div>
                    <div class="viaje-preview-detail__line">
                        <span>PEAJE</span>
                        <strong>@FormatMoney(_preview.Viaje.Peaje)</strong>
                    </div>
                </article>

                <article class="viaje-preview-detail viaje-preview-detail--fletero">
                    <div class="viaje-preview-detail__head">
                        <span>Detalle fletero</span>
                        <strong>FLETERO</strong>
                    </div>
                    <div class="viaje-preview-detail__lines">
                        @foreach (var item in GetFleteroConceptos())
                        {
                            <div class="viaje-preview-detail__line">
                                <span>@item.Descripcion</span>
                                <strong>@FormatMoney(item.Importe)</strong>
                            </div>
                        }
                    </div>
                    <div class="viaje-preview-detail__total">
                        <span>TOTAL FLETERO</span>
                        <strong>@FormatMoney(GetTotalFletero())</strong>
                    </div>
                </article>
            </section>

            <section class="viaje-preview-section viaje-preview-section--observaciones">
                <div class="viaje-preview-section__head">
                    <h2>Observaciones</h2>
                </div>
                @if (string.IsNullOrWhiteSpace(_preview.Viaje.Observaciones))
                {
                    <p class="viaje-preview-empty">Sin observaciones.</p>
                }
                else
                {
                    <p class="viaje-preview-observaciones">@_preview.Viaje.Observaciones</p>
                }
            </section>
        </article>
    </div>
}
</div>

@code {
    [Parameter] public int Id { get; set; }

    private CargaViajePreviewDto? _preview;
    private AppUiMessage? _feedback;
    private bool _loading = true;
    private int _loadedId;

    private PageHeaderConfig? _pageHeaderPublicado;
    private string _headerSnapshot = string.Empty;

    // Estado que muestra la barra superior (acciones habilitadas, buscador): si cambia, se
    // republica el header después del render de la página.
    private string HeaderSnapshot() => $"{_loading}|{_preview is null}";

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || HeaderSnapshot() != _headerSnapshot)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader()
    {
        _headerSnapshot = HeaderSnapshot();
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "carga-viajes",
            Title = "Vista previa del viaje",
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCargaViajes(RouteContext, Nav, "viajes"),
            Actions = BuildHeaderActions(),
        });
    }

    private IReadOnlyList<PageHeaderAction> BuildHeaderActions()
    {
        var acciones = new List<PageHeaderAction>
        {
            new PageHeaderAction
            {
                Key = "volver",
                Label = "Volver",
                Icon = "bi-arrow-left",
                Style = PageHeaderActionStyle.Ghost,
                OnClick = VolverAsync
            }
        };

        if (!_loading && _preview is not null)
        {
            acciones.Add(new PageHeaderAction
            {
                Key = "pdf",
                Label = "Exportar PDF",
                Icon = "bi-file-earmark-arrow-down",
                Style = PageHeaderActionStyle.Ghost,
                OnClick = () => InvokeAsync(async () => { await ImprimirAsync(); StateHasChanged(); })
            });
            acciones.Add(new PageHeaderAction
            {
                Key = "imprimir",
                Label = "Imprimir",
                Icon = "bi-printer",
                Style = PageHeaderActionStyle.Primary,
                OnClick = () => InvokeAsync(async () => { await ImprimirAsync(); StateHasChanged(); })
            });
        }

        return acciones;
    }

    private Task VolverAsync()
    {
        Nav.NavigateTo(GetBackUrl());
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id && _preview is not null)
            return;

        _loading = true;
        _feedback = null;

        var cached = PreviewState.ConsumeFor(Id);
        if (cached is not null)
        {
            _preview = cached;
            _loadedId = Id;
            _loading = false;
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetViajePreviewAsync(Id), "No se pudo cargar la vista previa del viaje.");
        if (result.Success && result.Value is not null)
        {
            _preview = result.Value;
            _loadedId = Id;
        }
        else
        {
            _preview = null;
            _feedback = result.Feedback;
        }

        _loading = false;
    }

    private string GetBackUrl()
        => RouteContext.BuildRoute("/carga-viajes");

    private async Task ImprimirAsync()
        => await JS.InvokeVoidAsync("dashboardExport.printCurrentPage", "Viaje");

    private static readonly System.Globalization.CultureInfo MoneyCulture = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private ViajeTotalesDto GetViajeTotales()
        => _preview is null ? new ViajeTotalesDto() : CargaViajesService.BuildViajeTotales(_preview.Viaje, _preview.Configuracion);

    private IReadOnlyList<ViajeConceptoTotalDto> GetClienteConceptos()
        => GetViajeTotales().ConceptosCliente.Where(item => item.AportaAlTotal).ToList();

    private IReadOnlyList<ViajeConceptoTotalDto> GetFleteroConceptos()
        => GetViajeTotales().ConceptosFletero;

    private decimal GetTotalCliente()
        => GetViajeTotales().TotalCliente;

    private decimal GetTotalFletero()
        => GetViajeTotales().TotalFletero;

    private static string FormatMoney(decimal value)
        => value.ToString("C2", MoneyCulture);

    private static string GetAdicionalesResumen(int count)
        => count == 0 ? "Sin adicionales" : $"{count} adicional(es)";

    private IReadOnlyList<ViajePreviewAdicionalItem> GetAdicionales()
    {
        if (_preview is null)
            return [];

        var items = new List<ViajePreviewAdicionalItem>();
        var config = _preview.Configuracion;
        var viaje = _preview.Viaje;

        AddGeneralAdditional(items, 0, config, viaje.PorcentajeAdic, viaje.TotalAdic);
        AddGeneralAdditional(items, 1, config, viaje.PorcentajeAdic1, viaje.TotalAdic1);
        AddGeneralAdditional(items, 2, config, viaje.PorcentajeAdic2, viaje.TotalAdic2);
        AddGeneralAdditional(items, 3, config, viaje.PorcentajeAdic3, viaje.TotalAdic3);
        AddGeneralAdditional(items, 4, config, viaje.PorcentajeAdic4, viaje.TotalAdic4);

        AddFixedAdditional(items, viaje.AdicionalFijo1Descripcion, viaje.AdicionalFijo1Importe, viaje.AdicionalFijo1Aplicado);
        AddFixedAdditional(items, viaje.AdicionalFijo2Descripcion, viaje.AdicionalFijo2Importe, viaje.AdicionalFijo2Aplicado);
        AddFixedAdditional(items, viaje.AdicionalFijo3Descripcion, viaje.AdicionalFijo3Importe, viaje.AdicionalFijo3Aplicado);

        return items;
    }

    private static void AddGeneralAdditional(List<ViajePreviewAdicionalItem> items, int index, CargaViajesConfigDto config, decimal percent, decimal amount)
    {
        if (!GetConfigFlag(config.AdicionalesHabilitados, index))
            return;

        var title = GetConfigName(config, index);
        var subtitle = GetConfigFlag(config.AdicionalesSumarFletero, index)
            ? $"{percent:0.##}% - adicional general - fletero"
            : $"{percent:0.##}% - adicional general";
        items.Add(new ViajePreviewAdicionalItem(title, subtitle, amount, false, true));
    }

    private static void AddFixedAdditional(List<ViajePreviewAdicionalItem> items, string descripcion, decimal importe, bool aplicado)
    {
        if (string.IsNullOrWhiteSpace(descripcion) && importe <= 0m)
            return;

        var title = string.IsNullOrWhiteSpace(descripcion) ? "Adicional fijo" : descripcion.Trim();
        items.Add(new ViajePreviewAdicionalItem(title, "Importe fijo", Math.Max(0m, importe), true, aplicado));
    }

    private static string GetConfigName(CargaViajesConfigDto config, int index)
    {
        var fallback = $"Adicional {index + 1}";
        if (index < 0 || index >= config.NombresAdicionales.Count)
            return fallback;

        var value = config.NombresAdicionales[index];
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }

    private static bool GetConfigFlag(IReadOnlyList<bool> values, int index)
        => index >= 0 && index < values.Count && values[index];

    private static string GetDisplayOrDefault(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private static string GetFeedbackClass(AppUiMessage message) => message.Severity switch
    {
        AppUiFeedbackSeverity.Success => "editor-msg--success",
        AppUiFeedbackSeverity.Warning => "editor-msg--warning",
        AppUiFeedbackSeverity.Info => "editor-msg--info",
        _ => "editor-msg--error"
    };

    private sealed record ViajePreviewAdicionalItem(string Titulo, string Subtitulo, decimal Importe, bool EsFijo, bool Activo);
}
