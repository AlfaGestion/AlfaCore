@page "/admin/solicitudes"
@page "/{idweb}/{idbase:int}/admin/solicitudes"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@implements IDisposable
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ICentralAdminService AdminSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav

<PageTitle>Solicitudes de módulos | AlfaNet</PageTitle>

@* Administrar → Solicitudes (AlfaDesign v1, 2026-10-07). Aprobar y rechazar piden confirmación:
   impactan en ALFA_CENTRAL (aprobar activa el módulo o contrata el plan pedido). *@

<AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

<div class="adm-page">
    <div class="adm">
        <header class="adm-header">
            <div>
                <h2>Solicitudes de módulos</h2>
                <p>Módulos que un cliente pidió y todavía no se aprobaron ni rechazaron. Se cargan desde el panel Cliente → Módulos con "Solicitar".</p>
            </div>
        </header>

        @if (_loading)
        {
            <AlfaEmptyState Title="Cargando solicitudes" Message="Buscando pedidos pendientes." />
        }
        else if (!IsSuperAdmin)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="Acceso restringido" Message="Solo los superadmin pueden ver esta sección." />
        }
        else if (_loadError is not null)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudieron cargar las solicitudes" Message="@_loadError" ActionLabel="Reintentar" ActionIcon="bi bi-arrow-clockwise" OnAction="_ => LoadAsync()" />
        }
        else if (_items.Count == 0)
        {
            <AlfaEmptyState Title="No hay solicitudes pendientes" Message="Todo lo que se pide desde Cliente → Módulos aparece acá hasta que se aprueba o se rechaza." />
        }
        else
        {
            <section class="adm-card" aria-label="Solicitudes pendientes">
                <div class="adm-table-wrap">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Módulo</th>
                                <th>Plan</th>
                                <th class="is-number">Precio</th>
                                <th>Pedido</th>
                                <th class="adm-actions-col"><span class="visually-hidden">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td><strong>@item.ClienteNombre</strong><small>@item.IdCliente</small></td>
                                    <td>@item.Nombre</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PlanNombre) ? "—" : item.PlanNombre)</td>
                                    <td class="is-number">@item.Precio.ToString("C2")</td>
                                    <td class="is-nowrap">
                                        @if (item.SolicitadoUtc is not null)
                                        {
                                            <span>@item.SolicitadoUtc.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                            @if (!string.IsNullOrWhiteSpace(item.SolicitadoPor))
                                            {
                                                <small>@item.SolicitadoPor</small>
                                            }
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="adm-actions-col">
                                        <div class="adm-row-actions">
                                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-x-circle" Disabled="@_busy" OnClick="_ => Request(item, aprobar: false)">Rechazar</AlfaButton>
                                            <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-check2" Disabled="@_busy" OnClick="_ => Request(item, aprobar: true)">Aprobar</AlfaButton>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <footer class="alfa-data-view-footer">
                    <span class="alfa-data-view-footer__summary">@(_items.Count == 1 ? "1 solicitud pendiente" : $"{_items.Count} solicitudes pendientes")</span>
                </footer>
            </section>
        }
    </div>
</div>

<AlfaConfirmDialog Open="@(_pending is not null)"
                   Title="@(_pendingAprobar ? "Aprobar solicitud" : "Rechazar solicitud")"
                   Message="@(_pending is null ? string.Empty : _pendingAprobar
                       ? $"¿Aprobar {_pending.Nombre} para {_pending.ClienteNombre}?"
                       : $"¿Rechazar la solicitud de {_pending.Nombre} para {_pending.ClienteNombre}?")"
                   SecondaryMessage="@(_pendingAprobar
                       ? (_pending?.IdPlan is not null ? "Se contrata el plan pedido y queda activo para el cliente." : "El módulo queda activo para el cliente.")
                       : "La solicitud se descarta; el cliente puede volver a pedirlo.")"
                   ConfirmLabel="@(_pendingAprobar ? "Aprobar" : "Rechazar")"
                   LoadingLabel="@(_pendingAprobar ? "Aprobando..." : "Rechazando...")"
                   Loading="@_busy"
                   OnConfirm="ConfirmAsync"
                   OnCancel="CancelPending" />

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private readonly List<SolicitudModuloDto> _items = [];
    private bool _loading = true;
    private bool _busy;
    private string? _loadError;
    private AppUiMessage? _feedback;
    private SolicitudModuloDto? _pending;
    private bool _pendingAprobar;

    private bool IsSuperAdmin => AppUserSession.CurrentUser?.SuperAdmin == true;
    private string UsuarioActual => AppUserSession.CurrentUser?.UserName ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!IsSuperAdmin)
        {
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        Title = "Solicitudes",
        Breadcrumb = ["Administrar", "Solicitudes"],
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "admin",
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildAdministrar(RouteContext, Nav, "solicitudes")
    });

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _items.Clear();
            _items.AddRange(await AdminSvc.GetSolicitudesPendientesAsync());
        }
        catch (Exception ex)
        {
            _loadError = UserMessage(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Request(SolicitudModuloDto item, bool aprobar)
    {
        _pending = item;
        _pendingAprobar = aprobar;
    }

    private void CancelPending()
    {
        if (!_busy)
            _pending = null;
    }

    private async Task ConfirmAsync()
    {
        if (_pending is null || _busy)
            return;

        var item = _pending;
        var aprobar = _pendingAprobar;
        _busy = true;
        try
        {
            if (aprobar)
            {
                // Si la solicitud tiene un plan guardado (registro público con Planes reales que no
                // pudo autoservirse en Prueba — ver ElegirPlanesAsync), aprobar contrata ese plan en
                // vez de activar el módulo "a secas": es acá donde alguien de Alfa confirma el pago,
                // mismo criterio que "Confirmar pago" en el panel Cliente → Módulos.
                if (item.IdPlan is int idPlan)
                {
                    await AdminSvc.ContratarPlanAsync(item.IdCliente, idPlan, UsuarioActual);
                }
                else
                {
                    await AdminSvc.ActivarModuloAsync(new ActivarModuloRequest
                    {
                        IdCliente = item.IdCliente,
                        IdModulo = item.IdModulo,
                        ActivadoPor = UsuarioActual
                    });
                }

                _feedback = AppUiMessage.Success("Solicitud aprobada", $"Módulo {item.Nombre} aprobado y activado para {item.ClienteNombre}.");
            }
            else
            {
                await AdminSvc.RechazarModuloAsync(new RechazarModuloRequest
                {
                    IdCliente = item.IdCliente,
                    IdModulo = item.IdModulo,
                    DecididoPor = UsuarioActual
                });

                _feedback = AppUiMessage.Success("Solicitud rechazada", $"Solicitud de {item.Nombre} rechazada.");
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _feedback = AppUiMessage.Error(aprobar ? "No se pudo aprobar la solicitud" : "No se pudo rechazar la solicitud", UserMessage(ex));
        }
        finally
        {
            _busy = false;
            _pending = null;
        }
    }

    private static string UserMessage(Exception ex)
        => ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
}
