@page "/ventas/familias"
@page "/{idweb}/{idbase:int}/ventas/familias"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.GestionFilterStateService FilterState
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Familias | Ventas</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Familias más vendidas</h2>
            <p>Análisis comercial por familia para entender composición y concentración de ventas.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudieron cargar los datos" Message="@_error" />
    }
    else if (_page is null)
    {
        <AlfaEmptyState Title="Cargando familias" Message="Buscando datos del período." />
    }
    else
    {
        <div class="kpi-grid">
            <KpiCard Titulo="Total vendido" Valor="@Moneda(_page.TotalVendido)" Icono="$" />
            <KpiCard Titulo="Familias activas" Valor="@_page.FamiliasActivas.ToString("N0")" Icono="F" />
        </div>

        <div class="split-grid">
            <section class="panel-card">
                <HorizontalBarChart Data="_page.TopFamilias" Titulo="Top familias" Subtitulo="Familias con mayor incidencia" />
            </section>

            <DataTable Titulo="Listado de familias" Subtitulo="Participación comercial por familia">
                <Header>
                    <tr>
                        <th>Familia</th>
                        <th style="text-align:right;">Total</th>
                        <th style="text-align:right;">% total</th>
                        <th style="text-align:right;">Artículos</th>
                        <th style="text-align:right;">Comprobantes</th>
                    </tr>
                </Header>
                <Rows>
                    @foreach (var item in _page.Familias)
                    {
                        <tr>
                            <td>
                                <strong>@item.Familia</strong>
                                @if (!string.IsNullOrWhiteSpace(item.DescripcionFamilia))
                                {
                                    <br /><span class="text-muted" style="font-size:0.8em;">@item.DescripcionFamilia</span>
                                }
                            </td>
                            <td style="text-align:right;">@Moneda(item.TotalVendido)</td>
                            <td style="text-align:right;">@Porcentaje(item.Participacion)</td>
                            <td style="text-align:right;">@item.CantidadArticulos.ToString("N0")</td>
                            <td style="text-align:right;">@item.CantidadComprobantes.ToString("N0")</td>
                        </tr>
                    }
                </Rows>
            </DataTable>
        </div>
    }
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private VentasDashboardFilters _filters = null!;
    private VentasFilterOptionsDto _options = new();
    private VentasFamiliasPageDto? _page;
    private string? _error;

    protected override void OnInitialized()
    {
        _filters = FilterState.Ventas;
        UpdatePageHeader();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    // Filtros en el Context Toolbar (Smart Search). El fragmento lee _filters/_options al dibujarse:
    // después de cargar las opciones se vuelve a publicar el header.
    private RenderFragment RenderSmartSearch() => @<VentasSmartSearch Model="_filters" Options="_options" OnApply="LoadAsync" />;

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "ventas",
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildVentas(RouteContext, Nav, "familias")
    });

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Ventas;
        _options = await GestionSvc.GetVentasFilterOptionsAsync();
        UpdatePageHeader();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try { _page = await GestionSvc.GetVentasFamiliasAsync(_filters); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string Moneda(decimal valor) => valor.ToString("$ #,##0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
    private static string Porcentaje(decimal valor) => valor.ToString("P1", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
