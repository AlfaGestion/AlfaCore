@page "/ventas/rubros"
@page "/{idweb}/{idbase:int}/ventas/rubros"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.GestionFilterStateService FilterState

<PageTitle>Rubros | Ventas</PageTitle>

<section class="page-grid">
    <div class="page-intro">
        <div>
            <h2 class="page-intro__title">Rubros más vendidos</h2>
            <p class="page-intro__text">Lectura comercial por rubro para identificar concentración y categorías líderes.</p>
        </div>
    </div>

    <VentasFiltersBar Model="_filters" Options="_options" OnApply="LoadAsync" Titulo="Filtros de rubros" Subtitulo="Acotá el análisis de categorías vendidas." MostrarComparativoUnidadNegocio="true" />

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="panel-card empty-state"><p>@_error</p></div>
    }
    else if (_page is null)
    {
        <div class="loading">Cargando rubros...</div>
    }
    else
    {
        <div class="kpi-grid">
            <KpiCard Titulo="Total vendido" Valor="@Moneda(_page.TotalVendido)" Icono="$" />
            <KpiCard Titulo="Rubros activos" Valor="@_page.RubrosActivos.ToString("N0")" Icono="R" />
        </div>

        <div class="rubros-layout">
            @if (MostrarComparativoUnidadNegocio)
            {
                <section class="panel-card rubros-compare">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Top rubros por unidad de negocio</h3>
                            <p class="panel-card__subtitle">@UnidadesTexto()</p>
                        </div>
                    </div>

                    @if (_page.Rubros.Count == 0)
                    {
                        <p class="chart-empty">Sin datos para graficar.</p>
                    }
                    else
                    {
                        <div class="rubros-compare__legend">
                            @foreach (var unidad in _page.UnidadesNegocio.Select((item, index) => new { item, index }))
                            {
                                <span class="rubros-compare__legend-item">
                                    <span class="rubros-compare__dot" style="background:@ColorUnidad(unidad.index)"></span>
                                    @unidad.item.Descripcion
                                </span>
                            }
                        </div>

                        <div class="rubros-compare__chart">
                            @foreach (var rubro in _page.Rubros.Take(10))
                            {
                                <div class="rubros-compare__row">
                                    <div class="rubros-compare__head">
                                        <strong>@RubroTexto(rubro.Rubro)</strong>
                                        <span>@Moneda(rubro.TotalVendido)</span>
                                    </div>
                                    <div class="rubros-compare__track">
                                        @foreach (var unidad in _page.UnidadesNegocio.Select((item, index) => new { item, index }))
                                        {
                                            var detalleUnidad = DetalleUnidad(rubro, unidad.item.Codigo);
                                            if (detalleUnidad.TotalVendido > 0 && rubro.TotalVendido > 0)
                                            {
                                                var ancho = Math.Max((double)(detalleUnidad.TotalVendido / rubro.TotalVendido) * 100d, 2d);
                                                <div class="rubros-compare__segment"
                                                     title="@unidad.item.Descripcion: @Moneda(detalleUnidad.TotalVendido) - @Porcentaje(detalleUnidad.Participacion)"
                                                     style="width:@ancho.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;background:@ColorUnidad(unidad.index)">
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="panel-card">
                    <HorizontalBarChart Data="_page.TopRubros" Titulo="Top rubros" Subtitulo="Rubros con mayor venta" />
                </section>
            }

            <div class="rubros-list">
                <DataTable Titulo="Listado de rubros" Subtitulo="Participación comercial por categoría">
                <Header>
                    @if (MostrarComparativoUnidadNegocio)
                    {
                        <tr>
                            <th>Rubro</th>
                            @foreach (var unidad in _page.UnidadesNegocio)
                            {
                                <th style="text-align:right;">@unidad.Descripcion</th>
                            }
                            <th style="text-align:right;">Total</th>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <th>Rubro</th>
                            <th style="text-align:right;">Total</th>
                            <th style="text-align:right;">% total</th>
                            <th style="text-align:right;">Artículos</th>
                            <th style="text-align:right;">Comprobantes</th>
                        </tr>
                    }
                </Header>
                <Rows>
                    @if (MostrarComparativoUnidadNegocio)
                    {
                        @foreach (var item in _page.Rubros)
                        {
                            <tr>
                                <td><strong>@RubroTexto(item.Rubro)</strong></td>
                                @foreach (var unidad in _page.UnidadesNegocio)
                                {
                                    var detalleUnidad = DetalleUnidad(item, unidad.Codigo);
                                    <td style="text-align:right;">
                                        <span class="rubros-unit-cell">
                                            <strong>@Moneda(detalleUnidad.TotalVendido)</strong>
                                            <small>@Porcentaje(detalleUnidad.Participacion)</small>
                                        </span>
                                    </td>
                                }
                                <td style="text-align:right;"><strong>@Moneda(item.TotalVendido)</strong></td>
                            </tr>
                        }
                        <tr class="data-table__totals">
                            <td><strong>Total</strong></td>
                            @foreach (var unidad in _page.UnidadesNegocio)
                            {
                                <td style="text-align:right;"><strong>@Moneda(TotalUnidad(unidad.Codigo))</strong></td>
                            }
                            <td style="text-align:right;"><strong>@Moneda(_page.TotalVendido)</strong></td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in _page.Rubros)
                        {
                            <tr>
                                <td><strong>@RubroTexto(item.Rubro)</strong></td>
                                <td style="text-align:right;">@Moneda(item.TotalVendido)</td>
                                <td style="text-align:right;">@Porcentaje(item.Participacion)</td>
                                <td style="text-align:right;">@item.CantidadArticulos.ToString("N0")</td>
                                <td style="text-align:right;">@item.CantidadComprobantes.ToString("N0")</td>
                            </tr>
                        }
                    }
                </Rows>
                </DataTable>
            </div>
        </div>
    }
</section>

@code {
    private VentasDashboardFilters _filters = null!;
    private VentasFilterOptionsDto _options = new();
    private VentasRubrosPageDto? _page;
    private string? _error;

    private bool MostrarComparativoUnidadNegocio => _filters.UnidadesNegocio.Count > 1;

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Ventas;
        _options = await GestionSvc.GetVentasFilterOptionsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try { _page = await GestionSvc.GetVentasRubrosAsync(_filters); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string Moneda(decimal valor) => valor.ToString("$ #,##0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
    private static string Porcentaje(decimal valor) => valor.ToString("P1", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private string UnidadesTexto()
        => _filters.UnidadesNegocio.Count == 0
            ? "Todas las unidades de negocio"
            : $"Comparativo: {string.Join(", ", _page?.UnidadesNegocio.Select(x => x.Descripcion) ?? Array.Empty<string>())}";

    private static decimal ValorUnidad(VentasRubroResumenDto rubro, string codigo)
        => rubro.UnidadesNegocio.FirstOrDefault(x => x.Codigo == codigo)?.TotalVendido ?? 0;

    private static VentasRubroUnidadNegocioDto DetalleUnidad(VentasRubroResumenDto rubro, string codigo)
        => rubro.UnidadesNegocio.FirstOrDefault(x => x.Codigo == codigo) ?? new VentasRubroUnidadNegocioDto();

    private decimal TotalUnidad(string codigo)
        => _page?.Rubros.Sum(r => ValorUnidad(r, codigo)) ?? 0;

    private static string RubroTexto(string? rubro)
        => string.IsNullOrWhiteSpace(rubro) ? "Sin rubro" : rubro;

    private static string ColorUnidad(int index)
    {
        var colors = new[]
        {
            "#16b8d9",
            "#22c55e",
            "#f59e0b",
            "#a78bfa",
            "#f43f5e",
            "#14b8a6",
            "#eab308",
            "#38bdf8"
        };

        return colors[index % colors.Length];
    }
}
