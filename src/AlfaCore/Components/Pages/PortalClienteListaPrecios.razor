@page "/portal-cliente/lista-precios"
@page "/{idweb}/{idbase:int}/portal-cliente/lista-precios"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Components.Shared
@using AlfaCore.Components.Shared.AlfaDesign
@using AlfaCore.Models
@inject AlfaCore.Services.IListaPreciosClienteService ListaPreciosSvc
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc

<PageTitle>Lista de precios | Portal Cliente</PageTitle>

@if (NotFound)
{
    <section class="page-grid portal-cliente">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver" />
}
else
{
    <section class="page-grid portal-cliente portal-cliente--detail">
        <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                              BrandName="@GetBrandingName()"
                              LogoFrameClass="@GetBrandingLogoFrameClass()"
                              ClientLabel="@GetCurrentClientLabel()"
                              Busy="@SessionBusy"
                              OnLogout="LogoutClienteAsync"
                              ActiveTab="lista-precios"
                              RouteInicio="@BuildPortalRoute("")"
                              RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                              RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                              RouteCatalogos="@BuildPortalRoute("catalogos")"
                              RouteCarrito="@BuildPortalRoute("carrito")"
                              RoutePedidos="@BuildPortalRoute("pedidos")"
                              RouteMiCuenta="@BuildPortalRoute("mi-cuenta")" />

        <section class="portal-cliente__section portal-cliente__list-section">
            <header class="portal-cliente__section-head portal-cliente__list-head">
                <div>
                    <h3 class="portal-cliente__section-title">Lista de precios</h3>
                    @if (_resultado is not null)
                    {
                        <div class="portal-cliente__list-meta">
                            <AlfaTag Tone="AlfaTagTone.Accent">Lista: @GetNombreListaTexto()</AlfaTag>
                            <AlfaTag Tone="AlfaTagTone.Neutral">Clase: @_resultado.Resolucion.Clase</AlfaTag>
                            @if (_margen > 0)
                            {
                                <AlfaTag Tone="AlfaTagTone.Warning">Margen activo</AlfaTag>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="portal-cliente__section-subtitle">Buscá por código, descripción, marca o rubro y filtrá la vista sin salir del portal.</p>
                    }
                </div>

                <div class="portal-cliente__list-head-actions">
                    <AlfaActionMenu Items="@ExportMenuItems"
                                    TriggerLabel="Exportar"
                                    MenuLabel="Exportar lista de precios"
                                    TriggerIcon="bi bi-download"
                                    Class="portal-cliente__export-menu"
                                    Align="AlfaActionMenuAlign.End" />
                </div>
            </header>

            <div class="portal-cliente__list-toolbar">
                <div class="portal-cliente__toolbar-row portal-cliente__toolbar-row--search" @onkeydown="HandleSearchKeyDownAsync">
                    <AlfaInput Label="Buscar"
                               Type="search"
                               Value="@_texto"
                               ValueChanged="SetTextoAsync"
                               Placeholder="Código, descripción, marca o rubro"
                               Class="portal-cliente__toolbar-field portal-cliente__toolbar-field--search" />
                </div>

                <div class="portal-cliente__toolbar-row portal-cliente__toolbar-row--filters">
                    <AlfaSelect Label="Agrupar por"
                                Value="@_agruparPor"
                                ValueChanged="SetAgruparPorAsync"
                                Options="@GroupOptions"
                                Class="portal-cliente__toolbar-field portal-cliente__toolbar-field--group" />
                    <AlfaInput Label="Margen de ganancia %"
                               Type="number"
                               Value="@_margenTexto"
                               ValueChanged="SetMargenAsync"
                               Placeholder="0,00"
                               HelpText="Solo simulación"
                               Class="portal-cliente__toolbar-field portal-cliente__toolbar-field--margin" />
                    <div class="portal-cliente__toolbar-actions">
                    <AlfaButton Variant="AlfaButtonVariant.Primary"
                                Size="AlfaSize.Sm"
                                Icon="bi bi-search"
                                Disabled="@_loading"
                                OnClick="@(_ => BuscarPrimeraPaginaAsync())">
                            Buscar
                        </AlfaButton>
                    </div>
                </div>
            </div>

            <div class="portal-cliente__active-filters">
                @if (!string.IsNullOrWhiteSpace(_texto))
                {
                    <AlfaTag Tone="AlfaTagTone.Neutral">Búsqueda: @_texto.Trim()</AlfaTag>
                }
                @if (!string.IsNullOrEmpty(_agruparPor))
                {
                    <AlfaTag Tone="AlfaTagTone.Neutral">Agrupar: @GetAgruparPorTexto()</AlfaTag>
                }
                @if (_margen > 0)
                {
                    <AlfaTag Tone="AlfaTagTone.Warning">Margen @GetMargenTexto() %</AlfaTag>
                }
            </div>

            @if (_loading)
            {
                <div class="portal-cliente__loading-state portal-cliente__list-loading">
                    <span class="portal-cliente__loading-spinner" aria-hidden="true"></span>
                    <span>Cargando lista de precios...</span>
                </div>
            }
            else if (_resultado is null || _resultado.Pagina.Items.Count == 0)
            {
                <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults"
                                Title="No encontramos artículos para esta búsqueda."
                                Message="Probá ajustar la búsqueda, la agrupación o los filtros activos."
                                Class="portal-cliente__empty-state" />
            }
            else
            {
                <div class="portal-cliente__data-view portal-cliente__lista-precios-view">
                    <div class="portal-cliente__data-view-header portal-cliente__lista-precios-header">
                        <span>Artículo</span>
                        <span class="text-end">Precio</span>
                    </div>

                    <div class="portal-cliente__data-view-body">
                        @if (string.IsNullOrEmpty(_agruparPor))
                        {
                            @foreach (var item in _resultado.Pagina.Items)
                            {
                                <ListaPreciosArticuloRow Item="item"
                                                         ImagenUrl="@GetImagenUrl(item.IdArticulo)"
                                                         Margen="_margen" />
                            }
                        }
                        else
                        {
                            @foreach (var grupo in GetGrupos())
                            {
                                <section class="lista-precios__group">
                                    <header class="lista-precios__group-head">
                                        <div class="lista-precios__group-title">
                                            <h4>@grupo.Titulo</h4>
                                            <span>@grupo.Items.Count artículo(s)</span>
                                        </div>
                                    </header>
                                    <div class="lista-precios__group-body">
                                        @foreach (var item in grupo.Items)
                                        {
                                            <ListaPreciosArticuloRow Item="item"
                                                                     ImagenUrl="@GetImagenUrl(item.IdArticulo)"
                                                                     Margen="_margen" />
                                        }
                                    </div>
                                </section>
                            }
                        }
                    </div>

                    @if (_resultado.Pagina.TotalPages > 1)
                    {
                        <footer class="alfa-data-view-footer portal-cliente__list-footer">
                            <span class="alfa-data-view-footer__summary">@GetListSummaryText()</span>
                            <div class="alfa-data-view-footer__controls portal-cliente__pagination-controls">
                                <AlfaButton Variant="AlfaButtonVariant.Ghost"
                                            Size="AlfaSize.Sm"
                                            Disabled="@(!_resultado.Pagina.HasPrev)"
                                            OnClick="() => BuscarAsync(_resultado.Pagina.PageNumber - 1)">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </AlfaButton>
                                <span class="portal-cliente__pagination-page">
                                    Página @_resultado.Pagina.PageNumber de @_resultado.Pagina.TotalPages
                                </span>
                                <AlfaButton Variant="AlfaButtonVariant.Ghost"
                                            Size="AlfaSize.Sm"
                                            Disabled="@(!_resultado.Pagina.HasNext)"
                                            OnClick="() => BuscarAsync(_resultado.Pagina.PageNumber + 1)">
                                    Siguiente <i class="bi bi-chevron-right"></i>
                                </AlfaButton>
                            </div>
                        </footer>
                    }
                </div>
            }
        </section>
    </section>
}

@code {
    private CatalogoClienteLoginPanel? _loginPanel;
    private bool _loading;
    private string _texto = string.Empty;
    private string _agruparPor = ListaPreciosAgruparPorKeys.Ninguno;
    private string _margenTexto = string.Empty;
    private decimal _margen;
    private ListaPreciosResultadoDto? _resultado;
    private PuntoVentaSettingsDto _puntoVentaSettings = new();

    protected override async Task OnPortalInitializedAsync()
    {
        try
        {
            _puntoVentaSettings = await PuntoVentaSvc.GetSettingsAsync();
        }
        catch
        {
            _puntoVentaSettings = new PuntoVentaSettingsDto();
        }
    }

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            await BuscarAsync(1);
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
        => await BuscarAsync(1);

    private async Task HandleSearchKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await BuscarPrimeraPaginaAsync();
    }

    private Task BuscarPrimeraPaginaAsync()
        => BuscarAsync(1);

    private Task SetTextoAsync(string? value)
    {
        _texto = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task SetAgruparPorAsync(string? value)
    {
        _agruparPor = value ?? ListaPreciosAgruparPorKeys.Ninguno;
        await BuscarAsync(1);
    }

    private Task SetMargenAsync(string? value)
    {
        _margenTexto = value ?? string.Empty;
        _margen = ParseDecimal(_margenTexto);
        return Task.CompletedTask;
    }

    private async Task BuscarAsync(int pageNumber)
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => ListaPreciosSvc.BuscarAsync(new ListaPreciosBusquedaFiltroDto
            {
                CodigoCliente = GetCurrentCodigoCliente(),
                Texto = string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim(),
                AgruparPor = _agruparPor,
                PageNumber = pageNumber,
                PageSize = 50
            }), "No pudimos cargar la lista de precios en este momento.");

            _resultado = result.Success ? result.Value : null;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IEnumerable<(string Titulo, List<ListaPreciosArticuloDto> Items)> GetGrupos()
    {
        if (_resultado is null)
            yield break;

        var items = _resultado.Pagina.Items;
        var claveFn = _agruparPor == ListaPreciosAgruparPorKeys.Familia
            ? (Func<ListaPreciosArticuloDto, string>)(i => string.IsNullOrWhiteSpace(i.Familia) ? "Sin familia" : i.Familia.Trim())
            : i => string.IsNullOrWhiteSpace(i.Marca) ? "Sin marca" : i.Marca.Trim();

        foreach (var grupo in items.GroupBy(claveFn).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase))
            yield return (grupo.Key, grupo.ToList());
    }

    private string BuildExportUrl(string tipo)
    {
        var basePath = tipo == "excel" ? "/api/portal-cliente/lista-precios/excel" : "/api/portal-cliente/lista-precios/pdf";
        var query = $"?token={Uri.EscapeDataString(CatalogoClienteSession.CurrentToken ?? string.Empty)}";

        if (!string.IsNullOrWhiteSpace(idweb))
            query += $"&idweb={Uri.EscapeDataString(idweb)}";
        if (idbase is > 0)
            query += $"&idbase={idbase.Value}";
        if (!string.IsNullOrWhiteSpace(_texto))
            query += $"&texto={Uri.EscapeDataString(_texto.Trim())}";
        if (!string.IsNullOrEmpty(_agruparPor))
            query += $"&agrupar={Uri.EscapeDataString(_agruparPor)}";

        return basePath + query;
    }

    private string GetNombreListaTexto()
    {
        if (_resultado is null)
            return string.Empty;

        var r = _resultado.Resolucion;
        if (r.UsaMaestro)
            return "Precio de maestro (sin lista)";

        var nombre = string.IsNullOrWhiteSpace(r.NombreLista) ? r.IdLista : r.NombreLista;
        return r.ListaDesdeCliente ? nombre ?? string.Empty : $"{nombre} (general)";
    }

    private string? GetImagenUrl(string idArticulo)
    {
        var relativa = AlfaCore.Services.ArticuloImagenUrlHelper.BuildPublicImageUrl(_puntoVentaSettings.FtpCodigoCta, idArticulo, GetEffectiveIdBase(), thumbnail: true);
        return string.IsNullOrWhiteSpace(relativa) ? null : relativa;
    }

    private string GetAgruparPorTexto()
        => _agruparPor switch
        {
            ListaPreciosAgruparPorKeys.Familia => "Familia",
            ListaPreciosAgruparPorKeys.Marca => "Marca",
            _ => "Sin agrupar"
        };

    private string GetListSummaryText()
    {
        if (_resultado is null)
            return string.Empty;

        var pagina = _resultado.Pagina;
        return $"{pagina.Total} artículo(s) · Página {pagina.PageNumber} de {pagina.TotalPages}";
    }

    private string GetMargenTexto()
        => _margen.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static decimal ParseDecimal(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return 0m;

        if (decimal.TryParse(value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out var parsed))
            return parsed;

        if (decimal.TryParse(value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out parsed))
            return parsed;

        return 0m;
    }

    private IReadOnlyList<AlfaSelectOption> GroupOptions { get; } = new[]
    {
        new AlfaSelectOption(ListaPreciosAgruparPorKeys.Ninguno, "Sin agrupar"),
        new AlfaSelectOption(ListaPreciosAgruparPorKeys.Familia, "Familia"),
        new AlfaSelectOption(ListaPreciosAgruparPorKeys.Marca, "Marca")
    };

    private IReadOnlyList<AlfaActionMenuItem> ExportMenuItems => new[]
    {
        new AlfaActionMenuItem
        {
            Key = "excel",
            Label = "Exportar Excel",
            Icon = "bi bi-file-earmark-excel",
            OnClick = () =>
            {
                Nav.NavigateTo(BuildExportUrl("excel"), forceLoad: true);
                return Task.CompletedTask;
            }
        },
        new AlfaActionMenuItem
        {
            Key = "pdf",
            Label = "Exportar PDF",
            Icon = "bi bi-file-earmark-pdf",
            OnClick = () =>
            {
                Nav.NavigateTo(BuildExportUrl("pdf"), forceLoad: true);
                return Task.CompletedTask;
            }
        }
    };
}
