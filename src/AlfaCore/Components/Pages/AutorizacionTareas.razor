@page "/seguridad/autorizacion-tareas"
@page "/{idweb}/{idbase:int}/seguridad/autorizacion-tareas"
@using AlfaCore.Models
@inject AlfaCore.Services.IAutorizacionTareasService AutorizacionSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Autorización de tareas | Alfa Gestión</PageTitle>

<div class="gd-page gd gd-legacy autorizacion-page">
    <header class="gd-header">
        <h2>Autorización de tareas<AlfaInfoTip>Administrá los permisos del menú web y las asignaciones de cada usuario.</AlfaInfoTip></h2>
    </header>

    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <section class="panel-card auth-admin-shell">
        <div class="panel-card__header auth-shell__header">
            <div>
                <h3 class="panel-card__title">Opciones del menú</h3>
                <p class="panel-card__subtitle">Elegí un usuario y presioná Consultar para ver y editar qué opciones del menú web puede usar.</p>
            </div>

            @if (_treeLoaded)
            {
                <div class="auth-shell__stats">
                    <div class="auth-stat">
                        <span class="auth-stat__label">Visible</span>
                        <strong>@_visibleTreeCount</strong>
                    </div>
                    <div class="auth-stat">
                        <span class="auth-stat__label">Autorizadas</span>
                        <strong>@_authorizedCount</strong>
                    </div>
                    <div class="auth-stat">
                        <span class="auth-stat__label">Usuario</span>
                        <strong>@_selectedUser</strong>
                    </div>
                </div>
            }
        </div>

        <div class="auth-shell__layout">
            <div class="auth-main">
                <div class="auth-main__header">
                    <div>
                        <h4 class="auth-panel__title">Árbol de permisos</h4>
                        <p class="auth-main__subtitle">Editá el árbol oficial del menú y aplicá selección masiva solo sobre los nodos visibles.</p>
                    </div>

                    @if (_dirty)
                    {
                        <span class="auth-main__status">Cambios pendientes</span>
                    }
                </div>

                <div class="auth-tree-toolbar">
                    <div class="auth-tree-toolbar__group">
                        <button type="button" class="btn btn--ghost" @onclick="SeleccionarTodoVisible" disabled="@(!_treeLoaded || _visibleTree.Count == 0)">
                            <i class="bi bi-check2-square"></i> Seleccionar visible
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="DeseleccionarTodoVisible" disabled="@(!_treeLoaded || _visibleTree.Count == 0)">
                            <i class="bi bi-square"></i> Deseleccionar visible
                        </button>
                    </div>

                    <div class="auth-tree-toolbar__group">
                        <button type="button" class="btn btn--ghost" @onclick="ExpandirTodo" disabled="@(!_treeLoaded)">
                            <i class="bi bi-arrows-expand"></i> Expandir todo
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="ContraerTodo" disabled="@(!_treeLoaded)">
                            <i class="bi bi-arrows-collapse"></i> Contraer todo
                        </button>
                    </div>
                </div>

                @if (_treeLoaded && !_loadingTree)
                {
                    @if (!_restringido && CantidadOpcionesMenu == 0)
                    {
                        <div class="auth-aviso auth-aviso--info">
                            <i class="bi bi-info-circle"></i>
                            <span><strong>@_selectedUser no tiene opciones cargadas: hoy ve todo el menú web.</strong>
                                Si tildás alguna opción y grabás, va a ver <strong>solo</strong> lo tildado.
                                Los permisos marcados <em>Solo si se tilda</em> no cuentan para esto.</span>
                        </div>
                    }
                    else if (!_restringido && CantidadOpcionesMenu > 0)
                    {
                        <div class="auth-aviso auth-aviso--warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <span><strong>Atención:</strong> hasta ahora @_selectedUser veía todo el menú web. Al grabar, va a ver
                                <strong>solo las @CantidadOpcionesMenu opciones tildadas</strong>.</span>
                        </div>
                    }
                    else if (_restringido && CantidadOpcionesMenu == 0)
                    {
                        <div class="auth-aviso auth-aviso--warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <span>No queda ninguna opción del menú tildada: al grabar, @_selectedUser va a volver a ver <strong>todo</strong> el menú web.</span>
                        </div>
                    }
                }

                @if (_loadingTree)
                {
                    <div class="auth-tree-state"><i class="bi bi-hourglass-split"></i> Cargando árbol de autorizaciones...</div>
                }
                else if (!_treeLoaded)
                {
                    <div class="auth-tree-state"><span>Seleccioná un usuario y presioná <strong>Consultar</strong> para editar permisos y asignaciones.</span></div>
                }
                else if (_visibleTree.Count == 0)
                {
                    <div class="auth-tree-state">No hay opciones que coincidan con el filtro actual.</div>
                }
                else
                {
                    <div class="auth-tree-panel">
                        <div class="auth-tree">
                            @foreach (var item in _visibleTree)
                            {
                                <AutorizacionTareasTreeNode Item="item"
                                                            ExpandedKeys="_expandedKeys"
                                                            ToggleExpand="ToggleExpandAsync"
                                                            ToggleAuthorization="ToggleAuthorizationAsync" />
                            }
                        </div>
                    </div>
                }
            </div>

            <aside class="auth-sidebar">
                @if (_perfilesDisponibles)
                {
                    <div class="auth-panel auth-panel--compact">
                        <div class="field field--full">
                            <label>Perfil</label>
                            <select value="@(_idPerfil?.ToString() ?? string.Empty)" @onchange="OnPerfilChanged" disabled="@(!_treeLoaded || _loadingTree)">
                                <option value="">Sin perfil</option>
                                @foreach (var perfil in _perfiles)
                                {
                                    <option value="@perfil.IdPerfil">@perfil.Nombre</option>
                                }
                            </select>
                            <small>Las opciones del perfil se suman a las del usuario y aparecen con la marca <strong>Perfil</strong>.
                                Se cambian desde <a href="@RouteContext.BuildRoute("/seguridad/perfiles")">Perfiles</a>.</small>
                        </div>
                    </div>
                }

                <div class="auth-panel auth-panel--compact">
                    <div class="field field--full">
                        <label>Aplicar mismos permisos que...</label>
                        <input list="auth-users-copy"
                               type="text"
                               placeholder="Usuario origen..."
                               @bind="_copyFromUser"
                               @bind:event="oninput" />
                        <datalist id="auth-users-copy">
                            @foreach (var item in _users.Where(x => !string.Equals(x.Nombre, _selectedUser, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@item.Nombre">@item.Nombre</option>
                            }
                        </datalist>
                    </div>

                    <div class="auth-sidebar__actions">
                        <button type="button" class="btn btn--ghost" @onclick="CopiarPermisosAsync" disabled="@(!_canCopy)">
                            <i class="bi bi-copy"></i> Copiar permisos
                        </button>
                    </div>
                </div>

                <div class="auth-panel auth-panel--compact auth-panel--footer">
                    <h4 class="auth-panel__title">Asignaciones del usuario</h4>
                    <div class="auth-assignments">
                        <label class="auth-toggle">
                            <input type="checkbox"
                                   checked="@_currentUserAdministrador"
                                   @onchange="OnAdministradorChanged"
                                   disabled="@(!_treeLoaded || _loadingTree)" />
                            <span>Administrador del sistema</span>
                        </label>

                        <label class="auth-toggle">
                            <input type="checkbox"
                                   checked="@_currentUserVerProforma"
                                   @onchange="OnVerProformaChanged"
                                   disabled="@(!_treeLoaded || _loadingTree)" />
                            <span>Puede ver y realizar proformas</span>
                        </label>

                        <div class="auth-comprobantes-rapidos auth-assignments">
                            <h4>Comprobantes habilitados</h4>
                            <small>Definí qué comprobantes puede seleccionar en el Punto de Venta.</small>
                            @foreach (var comprobante in ComprobantesPuntoVenta)
                            {
                                <label class="auth-toggle">
                                    <input type="checkbox"
                                           checked="@TieneComprobanteAutorizado(comprobante.Clave)"
                                           @onchange="args => OnComprobanteChanged(comprobante.Clave, args)"
                                           disabled="@(!_treeLoaded || _loadingTree)" />
                                    <span>@comprobante.Nombre</span>
                                </label>
                            }
                        </div>

                        <div class="field field--full">
                            <label>Unidad de negocio</label>
                            <select class="@GetCodeSelectClass(_selectedUNegocio)"
                                    value="@_selectedUNegocio"
                                    @onchange="OnUnidadNegocioChanged"
                                    disabled="@(!_treeLoaded || _loadingTree)">
                                @foreach (var item in _unidadesNegocio)
                                {
                                    <option value="@item.Codigo">@item.Etiqueta</option>
                                }
                            </select>
                            <small>Obligatoria. Por defecto se usa la unidad <strong>1</strong>.</small>
                        </div>

                        <div class="field field--full">
                            <label>Caja asignada</label>
                            <select class="@GetCodeSelectClass(_selectedIdCaja)"
                                    value="@_selectedIdCaja"
                                    @onchange="OnCajaChanged"
                                    disabled="@(!_treeLoaded || _loadingTree)">
                                <option value="">Sin caja asignada</option>
                                @foreach (var item in CajasDisponibles)
                                {
                                    <option value="@item.Codigo">@item.Etiqueta</option>
                                }
                            </select>
                            <small>Opcional. Se filtra según la unidad de negocio elegida.</small>
                        </div>

                        <div class="field field--full">
                            <label>Depósito asignado</label>
                            <select class="@GetCodeSelectClass(_selectedIdDeposito)"
                                    value="@_selectedIdDeposito"
                                    @onchange="OnDepositoChanged"
                                    disabled="@(!_treeLoaded || _loadingTree)">
                                <option value="">Sin depósito asignado</option>
                                @foreach (var item in DepositosDisponibles)
                                {
                                    <option value="@item.Codigo">@item.Etiqueta</option>
                                }
                            </select>
                            <small>Opcional. Incluye depósitos compartidos.</small>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </section>
</div>

@code {
    private const string MenuSistema = "ALFA";
    private const string PermisosSistema = "CN000PR";
    private const string DefaultUnidadNegocioVisual = "1";

    private readonly HashSet<string> _expandedKeys = new(StringComparer.OrdinalIgnoreCase);
    private List<UsuarioSistemaDto> _users = [];
    private List<MenuAutorizacionItemDto> _tree = [];
    private List<MenuAutorizacionItemDto> _originalTree = [];
    private List<MenuAutorizacionItemDto> _visibleTree = [];
    private List<AutorizacionCatalogoItemDto> _unidadesNegocio = [];
    private List<AutorizacionCatalogoItemDto> _cajas = [];
    private List<AutorizacionCatalogoItemDto> _depositos = [];
    private string _selectedUser = string.Empty;
    private string _consultaUsuario = string.Empty;
    private string _copyFromUser = string.Empty;
    private string _searchText = string.Empty;
    private string _selectedUNegocio = string.Empty;
    private string _selectedIdCaja = string.Empty;
    private string _selectedIdDeposito = string.Empty;
    private string _originalUNegocio = string.Empty;
    private string _originalIdCaja = string.Empty;
    private string _originalIdDeposito = string.Empty;
    private bool _currentUserAdministrador;
    private bool _originalAdministrador;
    private bool _currentUserVerProforma = true;
    private bool _originalVerProforma = true;
    private bool _restringido;
    private bool _perfilesDisponibles;
    private List<PerfilWebResumenDto> _perfiles = [];
    private int? _idPerfil;
    private int? _originalIdPerfil;

    /// <summary>Opciones del menú tildadas (sin contar los permisos que se dan solo si se tildan).</summary>
    private int CantidadOpcionesMenu => CountMenuKeys(_tree);
    private bool _loadingUsers;
    private bool _loadingTree;
    private bool _treeLoaded;
    private bool _dirty;
    private int _visibleTreeCount;
    private int _authorizedCount;
    private AppUiMessage? _feedback;

    private static readonly IReadOnlyList<(string Clave, string Nombre)> ComprobantesPuntoVenta =
    [
        (PuntoVentaComprobantePermissionKeys.Factura, "EFC · Factura electrónica"),
        (PuntoVentaComprobantePermissionKeys.Proforma, "FP · Factura proforma"),
        (PuntoVentaComprobantePermissionKeys.NotaPedido, "NP · Nota de pedido"),
        (PuntoVentaComprobantePermissionKeys.Remito, "RM · Remito interno")
    ];

    private bool _canSave => _treeLoaded && !_loadingTree && !string.IsNullOrWhiteSpace(_selectedUser) && _dirty && !string.IsNullOrWhiteSpace(_selectedUNegocio);
    private bool _canCopy => _treeLoaded && !_loadingTree && !string.IsNullOrWhiteSpace(_selectedUser) && !string.IsNullOrWhiteSpace(_copyFromUser) && !string.Equals(_selectedUser, _copyFromUser, StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<AutorizacionCatalogoItemDto> CajasDisponibles => _cajas
        .Where(item => string.Equals(item.UnidadNegocio.Trim(), _selectedUNegocio.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IReadOnlyList<AutorizacionCatalogoItemDto> DepositosDisponibles => _depositos
        .Where(item => item.Compartido || string.Equals(item.UnidadNegocio.Trim(), _selectedUNegocio.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private PageHeaderConfig? _pageHeaderPublicado;
    private string _headerSnapshot = string.Empty;

    // Estado que muestra la barra superior (acciones habilitadas, buscador): si cambia, se
    // republica el header después del render de la página.
    private string HeaderSnapshot() => $"{_loadingUsers}|{_loadingTree}|{_dirty}|{_selectedUser}|{_consultaUsuario}|{_selectedUNegocio}|{_searchText}|{_idPerfil}";

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || HeaderSnapshot() != _headerSnapshot)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader()
    {
        _headerSnapshot = HeaderSnapshot();
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "seguridad",
            Title = "Autorización de tareas",
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildSeguridad(RouteContext, Nav, "autorizacion"),
            Search = new PageHeaderSearchConfig(),
            SearchContent = RenderFiltrosUsuario(),
            Actions =
            [
                new() { Key = "grabar", Label = "Grabar", Icon = "bi-floppy", Style = PageHeaderActionStyle.Primary, Disabled = !_canSave, OnClick = () => InvokeAsync(async () => { await GuardarAsync(); StateHasChanged(); }) },
                new() { Key = "cancelar", Label = "Cancelar", Icon = "bi-x-lg", Style = PageHeaderActionStyle.Ghost, Disabled = !_dirty || _loadingTree, OnClick = () => InvokeAsync(() => { CancelarCambios(); StateHasChanged(); }) },
                new PageHeaderAction
                {
                    Key = "recargar",
                    Label = "Recargar usuarios",
                    Icon = "bi-arrow-clockwise",
                    Style = PageHeaderActionStyle.Ghost,
                    Disabled = _loadingUsers,
                    OnClick = () => InvokeAsync(async () => { await RecargarUsuariosAsync(); StateHasChanged(); })
                },
            ],
        });
    }

    private RenderFragment RenderFiltrosUsuario() => @<FiltrosSmartSearch Resumen="@(string.IsNullOrEmpty(_selectedUser) ? "Usuario" : _selectedUser)" Placeholder="Usuario y permisos..." Texto="@_searchText" TextoChanged="v => OnSearchChanged(new ChangeEventArgs { Value = v })" OnApply="ConsultarAsync" Disabled="@(_loadingUsers || _loadingTree || _dirty || string.IsNullOrWhiteSpace(_consultaUsuario))" PanelClass="smart-search__panel--uno">
        <div class="smart-search__column">
            <AlfaSelect Label="Usuario" Placeholder="Seleccioná un usuario" Value="@_consultaUsuario" ValueChanged="v => { _consultaUsuario = v ?? string.Empty; UpdatePageHeader(); }"
                Options="@_users.Select(x => new AlfaSelectOption(x.Nombre, x.Nombre)).ToList()" Disabled="@(_loadingUsers || _loadingTree || _dirty)" />
            @if (_dirty) { <span class="smart-search__hint">Grabá o cancelá los cambios antes de consultar otro usuario.</span> }
        </div>
    </FiltrosSmartSearch>;

    protected override async Task OnInitializedAsync()
    {
        await RecargarUsuariosAsync();
    }

    private async Task RecargarUsuariosAsync()
    {
        _loadingUsers = true;
        try
        {
            var result = await UiOps.RunAsync(() => AutorizacionSvc.GetUsuariosAsync(PermisosSistema), "No se pudieron cargar los usuarios.");
            if (!result.Success)
            {
                SetFeedback(result.Feedback!);
                return;
            }

            _users = (result.Value ?? Array.Empty<UsuarioSistemaDto>()).ToList();
            if (!string.IsNullOrWhiteSpace(_selectedUser) && _users.All(x => !string.Equals(x.Nombre, _selectedUser, StringComparison.OrdinalIgnoreCase)))
                _selectedUser = string.Empty;
        }
        finally
        {
            _loadingUsers = false;
        }
    }

    private async Task ConsultarAsync()
    {
        if (_loadingTree || _dirty || string.IsNullOrWhiteSpace(_consultaUsuario)) return;
        var usuario = _consultaUsuario;
        _feedback = null;
        _loadingTree = true;
        try
        {
            var result = await UiOps.RunAsync(() => AutorizacionSvc.GetAutorizacionAsync(MenuSistema, PermisosSistema, usuario), "No se pudo cargar la autorización.");
            if (!result.Success)
            {
                SetFeedback(result.Feedback!);
                return;
            }

            _selectedUser = usuario;
            var dto = result.Value!;
            var items = dto.Items ?? Array.Empty<MenuAutorizacionItemDto>();
            _tree = MenuAutorizacionArbol.CloneTree(items);
            _originalTree = MenuAutorizacionArbol.CloneTree(items);
            _treeLoaded = true;
            _dirty = false;
            _copyFromUser = string.Empty;

            _unidadesNegocio = (dto.UnidadesNegocio ?? Array.Empty<AutorizacionCatalogoItemDto>()).ToList();
            _cajas = (dto.Cajas ?? Array.Empty<AutorizacionCatalogoItemDto>()).ToList();
            _depositos = (dto.Depositos ?? Array.Empty<AutorizacionCatalogoItemDto>()).ToList();
            _currentUserAdministrador = dto.Administrador;
            _currentUserVerProforma = dto.VerProforma;
            _selectedUNegocio = ResolveUnidadNegocio(dto.UNegocio);
            _selectedIdCaja = ResolveOptionalCatalogValue(dto.IdCaja, CajasDisponibles);
            _selectedIdDeposito = ResolveOptionalCatalogValue(dto.IdDeposito, DepositosDisponibles);
            _originalAdministrador = _currentUserAdministrador;
            _originalVerProforma = _currentUserVerProforma;
            _originalUNegocio = _selectedUNegocio;
            _originalIdCaja = _selectedIdCaja;
            _originalIdDeposito = _selectedIdDeposito;
            _restringido = dto.Restringido;
            _perfilesDisponibles = dto.PerfilesDisponibles;
            _perfiles = (dto.Perfiles ?? Array.Empty<PerfilWebResumenDto>()).ToList();
            _idPerfil = dto.IdPerfil;
            _originalIdPerfil = dto.IdPerfil;

            SeedExpandedKeys(_tree);
            RebuildVisibleTree();
        }
        finally
        {
            _loadingTree = false;
        }
    }

    private async Task CopiarPermisosAsync()
    {
        var result = await UiOps.RunAsync(() => AutorizacionSvc.GetAutorizacionAsync(MenuSistema, PermisosSistema, _copyFromUser), "No se pudo copiar la autorización.");
        if (!result.Success)
        {
            SetFeedback(result.Feedback!);
            return;
        }

        var sourceItems = result.Value?.Items ?? Array.Empty<MenuAutorizacionItemDto>();
        // Se copian las opciones propias del otro usuario; las de su perfil no (el perfil se elige aparte).
        var sourceSelected = new HashSet<string>(EnumerateOwnAuthorizedKeys(sourceItems), StringComparer.OrdinalIgnoreCase);
        ApplySelectedKeys(_tree, sourceSelected);
        _dirty = true;
        RebuildVisibleTree();
        SetFeedback(AppUiMessage.Success("Permisos copiados", $"Se aplicaron visualmente los permisos de {_copyFromUser}. Grabá para confirmar los cambios."));
    }

    private async Task GuardarAsync()
    {
        if (!_canSave) return;
        var selectedKeys = MenuAutorizacionArbol.AuthorizedKeys(_tree).ToArray();
        var result = await UiOps.RunAsync(() => AutorizacionSvc.GuardarAutorizacionAsync(new GuardarAutorizacionTareasRequest
        {
            MenuSistema = MenuSistema,
            PermisosSistema = PermisosSistema,
            Usuario = _selectedUser,
            IdPerfil = _perfilesDisponibles ? _idPerfil : null,
            Administrador = _currentUserAdministrador,
            VerProforma = _currentUserVerProforma,
            UNegocio = _selectedUNegocio,
            IdCaja = _selectedIdCaja,
            IdDeposito = _selectedIdDeposito,
            TareasSeleccionadas = selectedKeys
        }), "No se pudo guardar la autorización.");

        if (!result.Success)
        {
            SetFeedback(result.Feedback!);
            return;
        }

        _originalTree = MenuAutorizacionArbol.CloneTree(_tree);
        _originalAdministrador = _currentUserAdministrador;
        _originalVerProforma = _currentUserVerProforma;
        _originalUNegocio = _selectedUNegocio;
        _originalIdCaja = _selectedIdCaja;
        _originalIdDeposito = _selectedIdDeposito;
        _originalIdPerfil = _idPerfil;
        _restringido = CantidadOpcionesMenu > 0;
        _dirty = false;
        RebuildVisibleTree();
        SetFeedback(AppUiMessage.Success("Permisos actualizados", _restringido
            ? $"Se guardaron los permisos de {_selectedUser}: ve solo las {CantidadOpcionesMenu} opciones tildadas."
            : $"Se guardaron los permisos de {_selectedUser}: no tiene opciones cargadas, ve todo el menú web."));
    }

    private void CancelarCambios()
    {
        _tree = MenuAutorizacionArbol.CloneTree(_originalTree);
        _currentUserAdministrador = _originalAdministrador;
        _currentUserVerProforma = _originalVerProforma;
        _selectedUNegocio = _originalUNegocio;
        _selectedIdCaja = _originalIdCaja;
        _selectedIdDeposito = _originalIdDeposito;
        _idPerfil = _originalIdPerfil;
        _dirty = false;
        _copyFromUser = string.Empty;
        RebuildVisibleTree();
        SetFeedback(new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Info,
            Title = "Cambios descartados",
            Message = "Se restauró la autorización cargada originalmente."
        });
    }

    private Task ToggleExpandAsync(string key)
    {
        if (_expandedKeys.Contains(key))
            _expandedKeys.Remove(key);
        else
            _expandedKeys.Add(key);

        return Task.CompletedTask;
    }

    private Task ToggleAuthorizationAsync(MenuAutorizacionToggleRequest request)
    {
        if (!_treeLoaded)
            return Task.CompletedTask;

        MenuAutorizacionArbol.Toggle(_tree, _visibleTree, request.Clave, request.Checked);
        MarkDirty();
        return Task.CompletedTask;
    }

    private Task OnPerfilChanged(ChangeEventArgs args)
    {
        var raw = Convert.ToString(args.Value);
        int? nuevo = int.TryParse(raw, out var id) ? id : null;
        if (nuevo == _idPerfil)
            return Task.CompletedTask;

        var claves = new HashSet<string>(_perfiles.FirstOrDefault(p => p.IdPerfil == nuevo)?.Claves ?? [], StringComparer.OrdinalIgnoreCase);
        AplicarPerfil(_tree, claves);
        _idPerfil = nuevo;
        MarkDirty();
        return Task.CompletedTask;
    }

    /// <summary>Saca las opciones del perfil anterior y marca (bloqueadas) las del perfil nuevo.</summary>
    private static void AplicarPerfil(IEnumerable<MenuAutorizacionItemDto> items, HashSet<string> clavesPerfil)
    {
        foreach (var item in items)
        {
            if (item.PorPerfil)
            {
                item.PorPerfil = false;
                item.Autorizado = false;
            }

            if (clavesPerfil.Contains(item.Clave))
            {
                item.PorPerfil = true;
                item.Autorizado = true;
            }

            AplicarPerfil(item.Hijos, clavesPerfil);
        }
    }

    private static IEnumerable<string> EnumerateOwnAuthorizedKeys(IEnumerable<MenuAutorizacionItemDto> items)
    {
        foreach (var item in items)
        {
            if (item.Autorizado && item.Habilitado && !item.PorPerfil)
                yield return item.Clave;

            foreach (var child in EnumerateOwnAuthorizedKeys(item.Hijos))
                yield return child;
        }
    }

    /// <summary>Opciones del menú tildadas (propias o del perfil) sin contar los permisos explícitos.</summary>
    private static int CountMenuKeys(IEnumerable<MenuAutorizacionItemDto> items)
        => items.Sum(x => (x.Autorizado && x.Habilitado && !x.Explicito ? 1 : 0) + CountMenuKeys(x.Hijos));

    private Task OnUnidadNegocioChanged(ChangeEventArgs args)
    {
        _selectedUNegocio = ResolveUnidadNegocio(Convert.ToString(args.Value));
        _selectedIdCaja = ResolveOptionalCatalogValue(_selectedIdCaja, CajasDisponibles);
        _selectedIdDeposito = ResolveOptionalCatalogValue(_selectedIdDeposito, DepositosDisponibles);
        MarkDirty();
        return Task.CompletedTask;
    }

    private Task OnSearchChanged(ChangeEventArgs args)
    {
        _searchText = Convert.ToString(args.Value) ?? string.Empty;
        RebuildVisibleTree();
        return Task.CompletedTask;
    }

    private Task AplicarFiltrosAsync()
    {
        RebuildVisibleTree();
        return Task.CompletedTask;
    }

    private Task LimpiarFiltrosAsync()
    {
        _searchText = string.Empty;
        RebuildVisibleTree();
        return Task.CompletedTask;
    }

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return;

        await AplicarFiltrosAsync();
    }

    private Task OnAdministradorChanged(ChangeEventArgs args)
    {
        _currentUserAdministrador = args.Value is bool b
            ? b
            : string.Equals(Convert.ToString(args.Value), "true", StringComparison.OrdinalIgnoreCase);
        MarkDirty();
        return Task.CompletedTask;
    }

    private Task OnVerProformaChanged(ChangeEventArgs args)
    {
        _currentUserVerProforma = args.Value is bool b
