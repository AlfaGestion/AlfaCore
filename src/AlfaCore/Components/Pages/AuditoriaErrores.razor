@using Microsoft.AspNetCore.Components.Forms
@page "/auditoria/errores"
@page "/{idweb}/{idbase:int}/auditoria/errores"
@inject AlfaCore.Services.IAuditoriaService AuditoriaSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@implements IDisposable

<PageTitle>Errores | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando errores…
    </div>
}
else
{
    <div class="page-grid">
        @if (_feedback is not null)
        {
            <div class="conversations-inline @GetFeedbackClass(_feedback)">
                <strong>@_feedback.Title</strong>
                <div>@_feedback.Message</div>
                @if (_feedback.HasCode)
                {
                    <div>Código: @_feedback.Code</div>
                }
                @if (_feedback.HasSuggestion)
                {
                    <div>@_feedback.Suggestion</div>
                }
            </div>
        }

        <section class="panel-card">
            <div class="table-wrap">
                <table class="data-table" data-sticky-list-header="attached">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Proceso</th>
                            <th>Usuario</th>
                            <th>PC</th>
                            <th>Error</th>
                            <th>Descripción</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _rows)
                        {
                            <tr>
                                <td><a class="action-link" href="/auditoria/error/@item.Id">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</a></td>
                                <td>@item.Proceso</td>
                                <td>@item.Usuario</td>
                                <td>@item.Pc</td>
                                <td>@item.ErrorCodigo</td>
                                <td>@item.Descripcion</td>
                                <td>
                                    <a class="btn btn--ghost btn--sm" href="/auditoria/error/@item.Id">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        <span>Ver detalle</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private AlfaCore.Models.AppUiMessage? _feedback;
    private IReadOnlyList<string> _usuarios = [];
    private IReadOnlyList<string> _procesos = [];
    private IReadOnlyList<AuditoriaErrorRowDto> _rows = [];
    private DateTime? _desde = DateTime.Today.AddDays(-7);
    private DateTime? _hasta = DateTime.Today;
    private string _usuario = string.Empty;
    private string _proceso = string.Empty;
    private string _pc = string.Empty;
    private string _errorCodigoText = string.Empty;
    private string _texto = string.Empty;
    private bool _showFilters;
    private bool _searching;

    private RenderFragment RenderErrorSearch() => @<div class="smart-search" @onclick:stopPropagation>
        <div class="smart-search__bar">
            <i class="bi bi-search"></i>
            <input type="search"
                   placeholder="Buscar en descripción, SQL, proceso o usuario..."
                   @bind="_texto"
                   @bind:event="oninput"
                   @onfocus="OpenFilters"
                   @onkeydown="HandleApplyKeyDownAsync" />
            <button type="button" class="smart-search__toggle" @onclick="ToggleFilters" aria-label="Mostrar filtros">
                <i class="bi @(_showFilters ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_showFilters)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CloseFilters"></button>
            <div class="smart-search__panel" @onclick:stopPropagation @onkeydown="HandleApplyKeyDownAsync">
                <div class="smart-search__column">
                    <h4><i class="bi bi-calendar-range"></i> Período</h4>
                    <div class="smart-search__inline">
                        <label>Desde</label>
                        <InputDate @bind-Value="_desde" />
                    </div>
                    <div class="smart-search__inline">
                        <label>Hasta</label>
                        <InputDate @bind-Value="_hasta" />
                    </div>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-person-gear"></i> Origen</h4>
                    <div class="smart-search__inline">
                        <label>Usuario</label>
                        <select @bind="_usuario">
                            <option value="">Todos</option>
                            @foreach (var item in _usuarios)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>
                    <div class="smart-search__inline">
                        <label>Proceso</label>
                        <select @bind="_proceso">
                            <option value="">Todos</option>
                            @foreach (var item in _procesos)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-sliders"></i> Detalle</h4>
                    <div class="smart-search__inline">
                        <label>PC</label>
                        <input @bind="_pc" placeholder="Equipo o IP..." />
                    </div>
                    <div class="smart-search__inline">
                        <label>Código error</label>
                        <input type="number" @bind="_errorCodigoText" placeholder="Ej: 208" />
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary btn--sm" @onclick="BuscarAsync" disabled="@_searching">
                            <i class="bi bi-search"></i> Aplicar
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltros" disabled="@_searching">
                            <i class="bi bi-eraser"></i> Limpiar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>;

    private void UpdatePageHeader()
    {
        PageHeader.Set(new PageHeaderConfig
        {
            Title = "Errores",
            Breadcrumb = ["Auditoría", "Errores"],
            State = _loading || _searching ? PageHeaderState.Loading : PageHeaderState.List,
            Search = new PageHeaderSearchConfig(),
            SearchContent = RenderErrorSearch(),
            Actions =
            [
                new PageHeaderAction
                {
                    Key = "aplicar",
                    Label = "Aplicar",
                    Icon = "bi-search",
                    Style = PageHeaderActionStyle.Primary,
                    Disabled = _loading || _searching,
                    OnClick = BuscarAsync
                },
                new PageHeaderAction
                {
                    Key = "limpiar",
                    Label = "Limpiar",
                    Icon = "bi-eraser",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _loading || _searching,
                    OnClick = LimpiarFiltros
                }
            ]
        });
    }

    protected override async Task OnInitializedAsync()
    {
        UpdatePageHeader();
        var result = await UiOps.RunAsync(async () =>
        {
            _usuarios = await AuditoriaSvc.GetUsuariosAsync();
            _procesos = await AuditoriaSvc.GetProcesosAsync();
            await BuscarAsync();
        }, "No se pudo cargar el listado de errores.");

        _feedback = result.Success ? null : result.Feedback;
        _loading = false;
        UpdatePageHeader();
    }

    private async Task BuscarAsync()
    {
        _showFilters = false;
        _searching = true;
        UpdatePageHeader();
        _feedback = null;
        var result = await UiOps.RunAsync(async () =>
        {
            _rows = await AuditoriaSvc.SearchErrorsAsync(new AuditoriaErrorFilterDto
            {
                Desde = _desde,
                Hasta = _hasta,
                Usuario = _usuario,
                Proceso = _proceso,
                Pc = _pc,
                ErrorCodigo = int.TryParse(_errorCodigoText, out var code) ? code : null,
                Texto = _texto,
                MaxRows = 500
            });
        }, "No se pudieron cargar los errores filtrados.");

        _feedback = result.Feedback;
        _searching = false;
        UpdatePageHeader();
    }

    private async Task LimpiarFiltros()
    {
        _desde = DateTime.Today.AddDays(-7);
        _hasta = DateTime.Today;
        _usuario = string.Empty;
        _proceso = string.Empty;
        _pc = string.Empty;
        _errorCodigoText = string.Empty;
        _texto = string.Empty;
        await BuscarAsync();
    }

    private void OpenFilters()
    {
        if (_showFilters || _loading)
            return;

        _showFilters = true;
        UpdatePageHeader();
    }

    private void ToggleFilters()
    {
        if (_loading)
            return;

        _showFilters = !_showFilters;
        UpdatePageHeader();
    }

    private void CloseFilters()
    {
        if (!_showFilters)
            return;

        _showFilters = false;
        UpdatePageHeader();
    }

    private async Task HandleApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase) || _loading)
            return;

        await BuscarAsync();
    }

    private static string GetFeedbackClass(AlfaCore.Models.AppUiMessage message)
        => message.Severity switch
        {
            AlfaCore.Models.AppUiFeedbackSeverity.Success => "conversations-inline--ok",
            AlfaCore.Models.AppUiFeedbackSeverity.Warning => "conversations-inline--error",
            AlfaCore.Models.AppUiFeedbackSeverity.Error => "conversations-inline--error",
            _ => "conversations-inline--ok"
        };

    public void Dispose()
        => PageHeader.Clear();
}
