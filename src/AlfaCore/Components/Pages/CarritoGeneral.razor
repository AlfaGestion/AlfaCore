@page "/carrito-general/nuevo"
@page "/carrito-general/{IdCarrito:int}"
@page "/{idweb}/{idbase:int}/carrito-general/nuevo"
@page "/{idweb}/{idbase:int}/carrito-general/{IdCarrito:int}"
@inherits SaaSRoutePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@using AlfaCore.Components.Shared.AlfaDesign
@inject AlfaCore.Services.ICarritoComprasService CarritoComprasSvc
@inject AlfaCore.Services.IInterfacesCatalogosService CatalogosSvc
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUiDialogService DialogSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Carrito general | Alfa Gestión</PageTitle>

<section class="page-grid">
    <div class="page-intro">
        <div>
            <h2 class="page-intro__title">@( _editingIdCarrito.HasValue ? $"Editar carrito general #{_editingIdCarrito}" : "Nuevo carrito")</h2>
            <p class="page-intro__text">Configurá artículos y precios sin depender de un catálogo previo.</p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="@BuildSaasRoute("/carrito-compras")">
                <i class="bi bi-arrow-left"></i> Volver a Carritos
            </a>
            <button type="button" class="btn btn--primary" @onclick="GuardarAsync" disabled="@_loading">
                <i class="bi bi-floppy"></i> Guardar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <div class="panel-card">
            <div class="editor-msg @(_feedbackIsError ? "is-error" : "is-success")">
                <div>
                    <strong>@_feedbackTitle</strong>
                    <p>@_feedback</p>
                </div>
            </div>
        </div>
    }

    <section class="section-block">
        <div class="section-block__head">
            <h4 class="section-block__title">Datos del carrito</h4>
        </div>
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="field">
                    <label>Nombre</label>
                    <input @bind="_nombre" placeholder="Compra general" />
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="field">
                    <label>Descripción</label>
                    <input @bind="_descripcion" placeholder="Opcional" />
                </div>
            </div>
            <div class="col-12">
                <label class="catalogos-toggle">
                    <input type="checkbox" class="catalogos-toggle__input" @bind="_activo" />
                    <span class="catalogos-toggle__track" aria-hidden="true"></span>
                    <span class="catalogos-toggle__label">
                        <strong>Activo</strong>
                        <small>Si lo desactivás, no se mostrará para tomar pedidos.</small>
                    </span>
                </label>
            </div>
        </div>
    </section>

    <section class="section-block mt-4">
        <div class="section-block__head">
            <h4 class="section-block__title">Origen de artículos</h4>
        </div>
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <button type="button" class="catalog-source-card @(string.Equals(_origenArticulos, CarritoComprasArticuloOrigenKeys.Maestro, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectOrigenArticulosAsync(CarritoComprasArticuloOrigenKeys.Maestro)">
                    <strong>Maestro de artículos</strong>
                </button>
            </div>
            <div class="col-12 col-lg-6">
                <button type="button" class="catalog-source-card @(string.Equals(_origenArticulos, CarritoComprasArticuloOrigenKeys.Lista, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectOrigenArticulosAsync(CarritoComprasArticuloOrigenKeys.Lista)">
                    <strong>Lista de precios</strong>
                </button>
            </div>
        </div>
        @if (string.Equals(_origenArticulos, CarritoComprasArticuloOrigenKeys.Lista, StringComparison.OrdinalIgnoreCase))
        {
            <div class="row g-3 mt-1">
                <div class="col-12 col-lg-6 col-xxl-4">
                    <div class="field">
                        <label>Lista de artículos</label>
                        <select @bind="_idListaArticulos" @bind:after="CloseLookupArticulosAsync">
                            <option value="">Seleccionar...</option>
                            @foreach (var lista in _listasPrecio)
                            {
                                <option value="@lista.IdLista">@lista.Nombre (@lista.IdLista)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        }
        <div class="toolbar mt-3">
            <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-search" Disabled="@_loading" OnClick="AbrirLookupArticulosAsync">
                Consultar artículos
            </AlfaButton>
            @if (PuedeImportarListaCompleta())
            {
                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-cloud-arrow-down" Loading="@_importandoListaCompleta" Disabled="@(_loading || _importandoListaCompleta)" OnClick="ImportarListaCompletaAsync">
                    @( _importandoListaCompleta ? "Importando..." : "Importar lista completa" )
                </AlfaButton>
            }
            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-trash" Disabled="@(!_articulosSeleccionados.Any())" OnClick="LimpiarArticulosAsync">
                Limpiar artículos
            </AlfaButton>
        </div>

        <div class="table-responsive mt-3">
            @if (_articulosSeleccionados.Count == 0)
            {
                <div class="usuarios-empty">Todavía no hay artículos cargados.</div>
            }
            else
            {
                <table class="data-table usuarios-table">
                    <thead>
                        <tr>
                            <th style="width:48px;"></th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Presentación</th>
                            <th>Marca</th>
                            <th>Rubro</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _articulosSeleccionados)
                        {
                            <tr>
                                <td>
                                    @if (ShouldShowArticuloImage(item.IdArticulo))
                                    {
                                        <img class="catalogos-article-thumb catalogos-article-thumb--lookup"
                                             src="@GetArticuloImageUrl(item.IdArticulo)"
                                             alt="@item.DescripcionArticulo"
                                             loading="lazy"
                                             @onerror="@EventCallback.Factory.Create(this, () => HandleArticuloImageError(item.IdArticulo))" />
                                    }
                                    else
                                    {
                                        <div class="catalogos-article-thumb catalogos-article-thumb--lookup catalogos-article-thumb--fallback">@ProductInitials(item.DescripcionArticulo)</div>
                                    }
                                </td>
                                <td><strong>@item.IdArticulo</strong></td>
                                <td>@item.DescripcionArticulo</td>
                                <td>@item.Presentacion</td>
                                <td>@item.Marca</td>
                                <td>@item.Rubro</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => QuitarArticuloAsync(item.IdArticulo)">
                                        <i class="bi bi-x-circle"></i> Quitar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    <section class="section-block mt-4">
        <div class="section-block__head">
            <h4 class="section-block__title">Origen de precios</h4>
        </div>
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <button type="button" class="catalog-source-card @(string.Equals(_origenPrecios, CarritoComprasPrecioOrigenKeys.SegunCliente, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectOrigenPreciosAsync(CarritoComprasPrecioOrigenKeys.SegunCliente)">
                    <strong>Según cliente</strong>
                </button>
            </div>
            <div class="col-12 col-lg-4">
                <button type="button" class="catalog-source-card @(string.Equals(_origenPrecios, CarritoComprasPrecioOrigenKeys.ListaFija, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectOrigenPreciosAsync(CarritoComprasPrecioOrigenKeys.ListaFija)">
                    <strong>Lista fija</strong>
                </button>
            </div>
            <div class="col-12 col-lg-4">
                <button type="button" class="catalog-source-card @(string.Equals(_origenPrecios, CarritoComprasPrecioOrigenKeys.Maestro, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectOrigenPreciosAsync(CarritoComprasPrecioOrigenKeys.Maestro)">
                    <strong>Maestro de precios</strong>
                </button>
            </div>
        </div>

        @if (!string.Equals(_origenPrecios, CarritoComprasPrecioOrigenKeys.SegunCliente, StringComparison.OrdinalIgnoreCase))
        {
            <div class="row g-3 mt-1">
                <div class="col-12 col-lg-6 col-xxl-4">
                    <div class="field">
                        <label>Lista de precios</label>
                        <select @bind="_idListaPrecios">
                            <option value="">Seleccionar...</option>
                            @foreach (var lista in _listasPrecio)
                            {
                                <option value="@lista.IdLista">@lista.Nombre (@lista.IdLista)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-lg-3 col-xxl-2">
                    <div class="field">
                        <label>Clase de precio</label>
                        <select @bind="_clasePrecio">
                            <option value="">Automática</option>
                            @for (var i = 1; i <= 8; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="context-card mt-3">
                <span class="context-card__label">Según cliente</span>
                <strong>ListaCliente → ListaVentas → MaestroPrecios</strong>
                <span class="context-card__muted">La clase se resuelve como ClaseCliente y, si no existe, ClaseVenta.</span>
            </div>
        }
    </section>
</section>

<ArticuloPickerDialog Open="@_showLookupModal"
                      Titulo="Consultar artículos"
                      Subtitulo="@(string.Equals(_origenArticulos, CarritoComprasArticuloOrigenKeys.Lista, StringComparison.OrdinalIgnoreCase) ? "Búsqueda filtrada por la lista seleccionada." : "Búsqueda sobre el maestro oficial de artículos.")"
                      BloqueoMensaje="@(string.Equals(_origenArticulos, CarritoComprasArticuloOrigenKeys.Lista, StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(_idListaArticulos) ? "Elegí una lista antes de consultar artículos." : null)"
                      Origen="@_origenArticulos"
                      IdLista="@_idListaArticulos"
                      IdWeb="@idweb"
                      ExcludedIds="@(_articulosSeleccionados.Select(x => x.IdArticulo).ToList())"
                      ImageUrlResolver="GetArticuloImageUrl"
                      OnAgregarSeleccionados="AgregarDesdeLookupAsync"
                      OnClose="CloseLookupArticulosAsync" />

@code {
    [Parameter] public int? IdCarrito { get; set; }

    private readonly List<CatalogosListaPrecioDto> _listasPrecio = [];
    private readonly List<CarritoComprasGeneralArticuloDto> _articulosSeleccionados = [];
    private readonly HashSet<string> _articuloImageFallbacks = new(StringComparer.OrdinalIgnoreCase);

    private bool _loading;
    private bool _importandoListaCompleta;
    private bool _showLookupModal;
    private string _nombre = string.Empty;
    private string _descripcion = string.Empty;
    private bool _activo = true;
    private string _origenArticulos = CarritoComprasArticuloOrigenKeys.Maestro;
    private string _idListaArticulos = string.Empty;
    private string _origenPrecios = CarritoComprasPrecioOrigenKeys.SegunCliente;
    private string _idListaPrecios = string.Empty;
    private int? _clasePrecio;
    private int? _editingIdCarrito;
    private string _feedback = string.Empty;
    private string _feedbackTitle = string.Empty;
    private bool _feedbackIsError;
    private string _ftpCodigoCta = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var settingsTask = PuntoVentaSvc.GetSettingsAsync();
        var listasTask = CatalogosSvc.GetListasPrecioAsync();
        await Task.WhenAll(settingsTask, listasTask);

        _ftpCodigoCta = (await settingsTask).FtpCodigoCta;
        _listasPrecio.AddRange(await listasTask);

        if (IdCarrito.HasValue)
            await CargarAsync(IdCarrito.Value);
    }

    private async Task CargarAsync(int idCarrito)
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => CarritoComprasSvc.GetGeneralAsync(idCarrito), "No se pudo cargar el carrito general.");
            var detail = result.Value;
            if (!result.Success || detail is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _editingIdCarrito = detail.IdCarrito;
            _nombre = detail.Nombre;
            _descripcion = detail.Descripcion;
            _activo = detail.Activo;
            _origenArticulos = detail.OrigenArticulos;
            _idListaArticulos = detail.IdListaArticulos ?? string.Empty;
            _origenPrecios = detail.OrigenPrecios;
            _idListaPrecios = detail.IdListaPrecios ?? string.Empty;
            _clasePrecio = detail.ClasePrecio;
            _articulosSeleccionados.Clear();
            _articulosSeleccionados.AddRange(detail.Articulos);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(_nombre))
        {
            SetFeedback("El nombre del carrito es obligatorio.", "Falta el nombre", true);
            return;
        }

        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => CarritoComprasSvc.SaveGeneralAsync(new CarritoComprasGeneralSaveRequestDto
            {
                IdCarrito = _editingIdCarrito,
                Nombre = _nombre,
                Descripcion = _descripcion,
                Activo = _activo,
                OrigenArticulos = _origenArticulos,
                IdListaArticulos = _idListaArticulos,
                OrigenPrecios = _origenPrecios,
                IdListaPrecios = _idListaPrecios,
                ClasePrecio = _clasePrecio,
                Articulos = _articulosSeleccionados.ToArray(),
                Usuario = Environment.UserName,
                Pc = Environment.MachineName
            }), "No se pudo guardar el carrito general.");

            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _editingIdCarrito = result.Value;
            SetFeedback($"Se guardó el carrito general #{result.Value}.", "Carrito guardado", false);
            Nav.NavigateTo(BuildSaasRoute("/carrito-general/0"));
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SelectOrigenArticulosAsync(string origen)
    {
        _origenArticulos = origen;
        if (!string.Equals(origen, CarritoComprasArticuloOrigenKeys.Lista, StringComparison.OrdinalIgnoreCase))
            _idListaArticulos = string.Empty;

        _showLookupModal = false;
        return Task.CompletedTask;
    }

    private async Task SelectOrigenPreciosAsync(string origen)
    {
        _origenPrecios = origen;
        if (string.Equals(origen, CarritoComprasPrecioOrigenKeys.SegunCliente, StringComparison.OrdinalIgnoreCase))
        {
            _idListaPrecios = string.Empty;
            _clasePrecio = null;
        }

        await Task.CompletedTask;
    }

    private Task AbrirLookupArticulosAsync()
    {
        // La validación "falta la lista" y la búsqueda en sí quedan dentro de ArticuloPickerDialog
        // (BloqueoMensaje / carga al abrir); acá solo corresponde mostrarlo.
        _showLookupModal = true;
        return Task.CompletedTask;
    }

    private async Task ImportarListaCompletaAsync()
    {
        if (string.IsNullOrWhiteSpace(_idListaArticulos))
            return;

        _importandoListaCompleta = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => CatalogosSvc.GetArticulosDesdeListaAsync(_idListaArticulos, idweb, CancellationToken.None), "No se pudo importar la lista completa.");
            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            foreach (var item in result.Value)
                AddArticulo(item);
        }
        finally
        {
            _importandoListaCompleta = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AgregarDesdeLookupAsync(IReadOnlyList<CatalogosArticuloBusquedaDto> items)
    {
        foreach (var item in items)
            AddArticulo(item);

        await InvokeAsync(StateHasChanged);
    }

    private void AddArticulo(CatalogosArticuloBusquedaDto item)
    {
        if (_articulosSeleccionados.Any(x => string.Equals(x.IdArticulo, item.IdArticulo, StringComparison.OrdinalIgnoreCase)))
            return;

        _articulosSeleccionados.Add(new CarritoComprasGeneralArticuloDto
        {
            IdArticulo = item.IdArticulo,
            DescripcionArticulo = item.DescripcionArticulo,
            Presentacion = item.Presentacion,
            Marca = item.Marca,
            Rubro = item.Rubro
        });
    }

    private async Task QuitarArticuloAsync(string idArticulo)
    {
        _articulosSeleccionados.RemoveAll(x => string.Equals(x.IdArticulo, idArticulo, StringComparison.OrdinalIgnoreCase));
        await Task.CompletedTask;
    }

    private async Task LimpiarArticulosAsync()
    {
        if (_articulosSeleccionados.Count == 0)
            return;

        var confirm = await DialogSvc.ConfirmAsync(
            "Limpiar artículos",
            "Se quitarán todos los artículos del carrito.",
            "Limpiar",
            "Cancelar");

        if (!confirm)
            return;

        _articulosSeleccionados.Clear();
    }

    private Task CloseLookupArticulosAsync()
    {
        _showLookupModal = false;
        return Task.CompletedTask;
    }

    private bool PuedeImportarListaCompleta()
        => string.Equals(_origenArticulos, CarritoComprasArticuloOrigenKeys.Lista, StringComparison.OrdinalIgnoreCase)
           && !string.IsNullOrWhiteSpace(_idListaArticulos);

    private bool ShouldShowArticuloImage(string idArticulo)
        => !_articuloImageFallbacks.Contains(idArticulo) && !string.IsNullOrWhiteSpace(GetArticuloImageUrl(idArticulo));

    private string GetArticuloImageUrl(string idArticulo)
        => AlfaCore.Services.ArticuloImagenUrlHelper.BuildPublicImageUrl(_ftpCodigoCta, idArticulo, idbase, thumbnail: true);

    private void HandleArticuloImageError(string idArticulo)
    {
        if (!string.IsNullOrWhiteSpace(idArticulo))
            _articuloImageFallbacks.Add(idArticulo);
    }

    private static string ProductInitials(string descripcion)
    {
        if (string.IsNullOrWhiteSpace(descripcion))
            return "CA";

        var parts = descripcion
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => char.ToUpperInvariant(x[0]));

        return string.Concat(parts);
    }

    private static string Money(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private string BuildSaasRoute(string route)
    {
        var normalizedRoute = string.IsNullOrWhiteSpace(route)
            ? "/"
            : (route.Trim().StartsWith('/') ? route.Trim() : "/" + route.Trim());

        if (!string.IsNullOrWhiteSpace(idweb) && idbase.HasValue)
            return $"/{Uri.EscapeDataString(idweb.Trim())}/{idbase.Value}{normalizedRoute}";

        return RouteContext.BuildRoute(normalizedRoute);
    }

    private void SetFeedback(string message, string title = "Atención", bool isError = false)
    {
        _feedback = message;
        _feedbackTitle = title;
        _feedbackIsError = isError;
    }

    private void SetFeedback(AppUiMessage? feedback)
    {
        if (feedback is null)
        {
            _feedback = string.Empty;
            _feedbackTitle = string.Empty;
            _feedbackIsError = false;
            return;
        }

        _feedback = feedback.Message;
        _feedbackTitle = string.IsNullOrWhiteSpace(feedback.Title) ? "Atención" : feedback.Title;
        _feedbackIsError = feedback.Severity is AppUiFeedbackSeverity.Error or AppUiFeedbackSeverity.Warning;
    }
}
