    private async Task ActualizarDetalleCliente(ConciliacionMovimiento row,CancellationToken ct)
    {
        var detalle=await Servicio.DetalleAsync(row.Id,ct);
        var contexto=await Servicio.ContextoComprobantesAsync(row.Id,ct);
        var movimientos=await Servicio.MovimientosAsync(FiltrosMovimientos(_paginaMov),ct);
        ct.ThrowIfCancellationRequested();
        _movimientos=movimientos;_detalle=detalle;_contexto=contexto;
        row.Cliente=detalle.FirstOrDefault()?.ClientName ?? row.Cliente;
        row.Propuesta=detalle.FirstOrDefault()?.ProposalSummary ?? row.Propuesta;
        _comprobanteDetalleId=(contexto.Comprobantes.FirstOrDefault(c=>c.Propuesto) ?? contexto.Comprobantes.FirstOrDefault())?.Id ?? 0;
        _detalleVersion++;
        _saldoDetalle=null;
        if(detalle.FirstOrDefault() is { } propuesta) { row.TipoMatch=propuesta.MatchType.ToString();row.Confianza=propuesta.Confidence; }
    }
    private Task SeleccionarMovimiento(ConciliacionMovimiento row) => Operar(async ct =>
    {
        var detalle = await Servicio.DetalleAsync(row.Id,ct);
        var contexto = await Servicio.ContextoComprobantesAsync(row.Id,ct);
        ct.ThrowIfCancellationRequested();
        _detalleTab="cuenta";
        _saldoDetalle=null;
        _seleccion = row; _detalle = detalle; _contexto=contexto;
        _comprobanteDetalleId=(contexto.Comprobantes.FirstOrDefault(c=>c.Propuesto) ?? contexto.Comprobantes.FirstOrDefault())?.Id ?? 0;
        _categoriaRevision=row.Categoria;_motivoRevision="";
        _clienteAsignar=null;_buscarCliente="";_recordarCliente=true;
        _aliasCliente=ContraparteBancaria.Extraer(row.Descripcion.Split('·')[0]).Nombre;
    });
    private Task EliminarImportacion() => Operar(async ct =>
    {
        if (_eliminar is null) return;
        await Servicio.EliminarAsync(_eliminar.Id,ct);
        _eliminar = null; _filtro = null; _paginaImport = 1; _paginaMov = 1;
        _importaciones = await Servicio.ImportacionesAsync(1,ct);
        _movimientos = await Servicio.MovimientosAsync(FiltrosMovimientos(1,todas:true),ct);
        _seleccion = null; _detalle = [];
        if (_archivo is not null) await Leer(ct);
        _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Success, Title = "Importación eliminada", Message = "Se eliminaron los movimientos y propuestas de esa importación." };
    });
    private Task Paginar(int delta) => Operar(async ct =>
    {
        if (_tab == "importar") _paginaImport = Math.Max(1,_paginaImport+delta);
        else _paginaMov = Math.Max(1,_paginaMov+delta);
        await CargarPagina(ct);
    });
    private void PublicarHeader()
    {
        if (_disposed) return;
        var total = _tab == "importar" ? _importaciones.Total : _movimientos.Total;
        var pagina = _tab == "importar" ? _paginaImport : _paginaMov;
        PageHeader.Set(_header = new PageHeaderConfig {
            ModuleKey = "caja-bancos", ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            Title = "Conciliación bancaria inteligente", Breadcrumb = ["Caja y Bancos", "Conciliación bancaria inteligente"],
            TopNavigationItems = Navegacion(),
            SearchContent = _tab=="conciliar" ? _busquedaConciliacion : null,
            // En "Conciliar cuenta" no se ofrece "Importar extracto" (no aplica) y van las acciones de la comparación (2026-10-22).
            Actions = _tab=="conciliar"
                ? [.. _accionesConciliacion,
                    new() { Key = "actualizar",Label = "Actualizar",Icon = "bi-arrow-clockwise",Priority = PageHeaderActionPriority.Overflow,Disabled = _busy,OnClick = () => Operar(CargarPagina) }]
                : [
                new() { Key = "importar",Label = "Importar extracto",Icon = "bi-upload",Style = PageHeaderActionStyle.Primary,
                    Disabled = _tab!="importar" || _busy || !_listo || string.IsNullOrWhiteSpace(_cuenta),Busy = _busy,OnClick = Importar },
                new() { Key = "actualizar",Label = "Actualizar",Icon = "bi-arrow-clockwise",Disabled = _busy,OnClick = () => Operar(CargarPagina) }
            ],
            Pagination = _tab=="conciliar" ? null : new() { Label = $"{total} registros",PageLabel = $"{pagina} / {Math.Max(1,(int)Math.Ceiling(total/50d))}",
                HasPrevious = pagina>1,HasNext = pagina*50<total,Disabled = _busy,OnPrevious = () => Paginar(-1),OnNext = () => Paginar(1) }
        });
    }
    private IReadOnlyList<PageHeaderTopNavItem> Navegacion()
    {
        var url=RouteContext.BuildRoute("/caja-bancos/conciliacion-bancaria");
        var query=Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("directo",out var value) && value=="1") url+="?directo=1";
        return [new PageHeaderTopNavItem { Key="conciliacion",Label="Conciliación bancaria",Active=true,
            Url=url,OnClick=()=> { Nav.NavigateTo(url);return Task.CompletedTask; } }];
    }
    // Sólo se reinicia si de verdad cambió la base o el usuario: antes cualquier aviso de sesión (por ejemplo,
    // renovarla) vaciaba la pantalla y se perdía lo que se estaba revisando (2026-10-22).
    private int? _baseActual;
    private string _usuarioActual = "";
    private void CambiarSesion() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        var baseId = Sesiones.GetActiveSession()?.BaseId;
        var usuario = Usuarios.CurrentUser?.UserName ?? "";
        if (baseId == _baseActual && string.Equals(usuario, _usuarioActual, StringComparison.OrdinalIgnoreCase)) return;
        _baseActual = baseId; _usuarioActual = usuario;
        _lifetime.Cancel(); _lifetime.Dispose(); _lifetime = new();
        _tab="importar"; _comparacion=null;
        _busy = false; _archivo = null; _listo = false; _cuentas = []; _importaciones = new(); _movimientos = new();
        _seleccion = null; _eliminar = null; _detalle = []; _feedback = null; _filtro = null;
        _contexto=new([],[]);_comprobanteDetalleId=0;_categoriaRevision=_motivoRevision="";
        _clienteAsignar=null;_buscarCliente=_aliasCliente="";_recordarCliente=true;_detalleVersion=0;
        _cobranza=null; _errorCobranza=null; _comprobantePreferido=null;
        _banco = ""; _cuenta = ""; _paginaImport = _paginaMov = 1;
        _requiereBanco = false; _requiereFecha=false;_fechaReferencia=""; _buscar = _buscarAplicado = _clasificacion = _clasificacionAplicada = "";
        _orden = "fecha"; _descendente = true;
        if (TenantDataAccessGuard.IsActiveSessionAuthorized(Sesiones,Usuarios))
            await Operar(async ct => { _cuentas = await Servicio.CuentasAsync(ct); await CargarPagina(ct); });
        PublicarHeader(); StateHasChanged();
    });
    private static string Dinero(decimal value) => value.ToString("N2",System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
    private static string Estado(string s) => s == "IMPORTED" ? "Importado" : s;
    private static string Separar(string s) => System.Text.RegularExpressions.Regex.Replace(s,"(?<=[a-záéíóúñ])(?=[A-ZÁÉÍÓÚÑ])"," ");
    private static string FechaLocal(DateTime d) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(d,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById("Argentina Standard Time")).ToString("dd/MM/yyyy HH:mm");
    public void Dispose()
    {
        _disposed = true; Sesiones.SessionChanged -= CambiarSesion; Usuarios.StateChanged -= CambiarSesion;
        _lifetime.Cancel(); _lifetime.Dispose();
        if (ReferenceEquals(PageHeader.Current,_header)) PageHeader.Clear();
    }
}
