    {
        if (_tab == "importar") _importaciones = await Servicio.ImportacionesAsync(_paginaImport,ct);
        else if (_tab=="conciliar") { if(_comparacion is not null) await _comparacion.ActualizarAsync(); }
        else { _movimientos = await Servicio.MovimientosAsync(FiltrosMovimientos(_paginaMov),ct); _seleccion = null; _detalle = []; }
    }
    private Task AbrirCobranza(ConciliacionMovimiento row,string? preferido=null) => Operar(async ct =>
    {
        var preparacion=await Cobranzas.PrepararConciliacionAsync(row.Id,ct);
        if(preferido is not null && !preparacion.Documentos.Any(d=>$"{d.Tc}|{d.Comprobante}"==preferido))
            throw new InvalidOperationException("El comprobante elegido no está disponible para cobrar en pesos o cambió su saldo. Revisá la selección.");
        var propuestas=await Servicio.DetalleAsync(row.Id,ct);
        ct.ThrowIfCancellationRequested();
        var primera=propuestas.FirstOrDefault(d=>d.DocumentType is not null);
        _comprobantePreferido=preferido ?? (primera is null ? null : $"{primera.DocumentType}|{primera.EmissionCenter:D4}{primera.DocumentNumber:D8}{primera.Letter}");
        _seleccion=null; _detalle=[]; _feedback=null; _errorCobranza=null; _cobranza=preparacion;
    });
