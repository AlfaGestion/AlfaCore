    private void CambiarFechaReferencia(string? value)
    {
        _fechaReferencia=value ?? "";_requiereFecha=true;_listo=false;
        _lecturaMensaje="Confirmá la fecha de referencia y pulsá Procesar archivo.";
        if(_archivo is not null)_archivo=_archivo with{FechaReferencia=null};
        PublicarHeader();
    }
    private Task ProcesarArchivo()=>Operar(async ct=>
    {
        if(_archivo is null)return;
        if(!DateTime.TryParseExact(_fechaReferencia,"yyyy-MM-dd",System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,out var fecha)||fecha.Year<1900)
            throw new InvalidOperationException("Indicá una fecha de referencia válida para la descarga.");
        _archivo=_archivo with{FechaReferencia=fecha.Date};
        await Leer(ct);
    });
    private Task Importar() => Operar(async ct =>
