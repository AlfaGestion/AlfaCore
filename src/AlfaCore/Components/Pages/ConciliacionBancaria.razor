            Message = $"Importación #{result.ImportacionId}: {result.Movimientos} movimientos · Total: {Dinero(result.Total)} · Duplicados omitidos: {result.Duplicados}." };
        _buscar = _buscarAplicado = _clasificacion = _clasificacionAplicada = "";
        _filtro = result.ImportacionId; _paginaMov = 1; _paginaImport = 1; _tab = "revisar";
        _listo = false;
        _importaciones = await Servicio.ImportacionesAsync(1,ct);
        _movimientos = await Servicio.MovimientosAsync(FiltrosMovimientos(1),ct);
