@page "/caja-bancos/conciliacion-bancaria"
@page "/{idweb}/{idbase:int}/caja-bancos/conciliacion-bancaria"
@using AlfaCore.Services
@using AlfaCore.ConciliacionBancaria.Domain.Enums
@using AlfaCore.ConciliacionBancaria.Domain.Entities
@using AlfaCore.ConciliacionBancaria.Application.DTOs
@using AlfaCore.ConciliacionBancaria.Application.Services
@inject ConciliacionBancariaService Servicio
@inject CobranzasService Cobranzas
@inject IAppUiOperationService UiOps
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject ISessionService Sesiones
@inject IAppUserSessionService Usuarios
@inject IAppEventService Eventos
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Conciliación bancaria inteligente | Alfa Gestión</PageTitle>

<div class="gd-page gd conciliacion-page @(_tab=="conciliar" ? "conciliacion-page--comparar" : null)">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />
    <AlfaTabs Items="@Tabs" ActiveKey="@_tab" ActiveKeyChanged="CambiarTab" AriaLabel="Conciliación bancaria" />

    @if (_tab == "importar")
    {
        <section class="panel-card conciliacion-importar" aria-busy="@_busy">
            <h3 class="panel-card__title">Importar extracto</h3>
            <p>Elegí el extracto descargado del banco. Detectaremos su formato y prepararemos la revisión.</p>
            <label class="conciliacion-archivo">
                <span>Archivo Excel o CSV (.xlsx, .xls, .csv, hasta 20 MB)</span>
                <InputFile OnChange="SeleccionarArchivo" accept=".xlsx,.xls,.csv" disabled="@_busy" />
            </label>
            @if (_archivo is not null)
            {
                <p><strong>@_archivo.Nombre</strong></p>
                @if(_requiereFecha || _archivo.FechaReferencia.HasValue)
                {
                    <div class="conciliacion-campos">
                        <AlfaInput Label="Fecha de referencia de la descarga" Type="date" Value="@_fechaReferencia" ValueChanged="CambiarFechaReferencia" Disabled="@_busy" />
                        <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@_busy" OnClick="ProcesarArchivo">Procesar archivo</AlfaButton>
                    </div>
                    <p>Esta fecha permite interpretar Hoy, Ayer y fechas sin año. La sugerencia proviene de la creación del Excel; verificá que corresponda a la descarga.</p>
                }
                <div class="conciliacion-campos @(!_requiereBanco ? "conciliacion-campos--cuenta" : "")">
                    @if (_requiereBanco)
                    {
                        <AlfaSelect Label="Formato del extracto" Value="@_banco" ValueChanged="CambiarBanco"
                            Options="@Bancos" Placeholder="Elegir formato bancario" Disabled="@_busy" />
                    }
                    <AlfaSelect Label="Cuenta bancaria en Alfa" Value="@_cuenta" ValueChanged="CambiarCuenta"
                        Options="@OpcionesCuentas" Placeholder="Seleccionar cuenta bancaria" Disabled="@_busy" />
                </div>
                <p role="status">@_lecturaMensaje</p>
                @if (_listo)
                {
                    <div class="conciliacion-resumen">
                        <span><strong>@_cantidad</strong> movimientos</span>
                        <span>Ingresos: <strong>@Dinero(_ingresos)</strong></span>
                        <span>Egresos: <strong>@Dinero(_egresos)</strong></span>
                        <span>Total neto: <strong>@Dinero(_ingresos - _egresos)</strong></span>
                    </div>
                }
            }
        </section>
        <section class="panel-card">
            <h3 class="panel-card__title">Importaciones recientes</h3>
            @if (_importaciones.Total == 0)
            {
                <AlfaEmptyState Title="Sin importaciones" Message="Seleccioná un extracto para comenzar." />
            }
            else
            {
                <div class="conciliacion-scroll">
                    <table class="conciliacion-tabla conciliacion-tabla--acciones">
                        <thead><tr><th>#</th><th>Banco</th><th>Archivo</th><th>Cuenta</th><th>Fecha</th><th>Usuario</th><th>Mov.</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
                        <tbody>
                            @foreach (var item in _importaciones.Items)
                            {
                                <tr @key="item.Id">
                                    <td>@item.Id</td><td>@item.Banco</td><td>@item.Archivo</td><td>@item.Cuenta</td>
                                    <td>@FechaLocal(item.FechaUtc)</td><td>@item.Usuario</td><td>@item.Movimientos</td>
                                    <td class="conciliacion-numero">@Dinero(item.Total)</td><td>@Estado(item.Estado)</td>
                                    <td class="conciliacion-acciones">
                                        <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="() => AbrirImportacion(item.Id)">Revisar</AlfaButton>
                                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="() => _eliminar = item">Eliminar</AlfaButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <footer class="alfa-data-view-footer"><span class="alfa-data-view-footer__summary">@_importaciones.Total importaciones · 50 por página</span></footer>
            }
        </section>
    }
    else if (_tab=="conciliar")
    {
        <ConciliacionComparacionPanel @ref="_comparacion" CuentaInicial="@_cuenta" SearchChanged="PublicarBusquedaConciliacion" AccionesChanged="PublicarAccionesConciliacion" />
    }
    else
    {
        <section class="panel-card">
            <form class="conciliacion-filtros" @onsubmit="AplicarFiltros" @onsubmit:preventDefault aria-label="Filtros de movimientos">
                <AlfaInput Label="Buscar movimientos" Value="@_buscar" ValueChanged="v => _buscar = v ?? string.Empty"
                    Placeholder="Descripción, referencia, cliente, importe…" MaxLength="200" Disabled="@_busy" />
                <AlfaSelect Label="Clasificación" Value="@_clasificacion" ValueChanged="CambiarClasificacion"
                    Options="@Clasificaciones" Placeholder="Todas las clasificaciones" Disabled="@_busy" />
                <div class="conciliacion-filtros__acciones">
                    <AlfaButton Type="submit" Icon="bi bi-search" Disabled="@_busy">Buscar</AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_busy" OnClick="LimpiarFiltros">Limpiar</AlfaButton>
                </div>
            </form>
            <div class="conciliacion-alcance">
                <span>@(_filtro.HasValue ? $"Importación #{_filtro}" : "Todas las importaciones")</span>
                @if (_filtro.HasValue)
                {
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_busy" OnClick="VerTodas">Ver todas</AlfaButton>
                }
            </div>
            @if (_movimientos.Total == 0)
            {
                <AlfaEmptyState Title="Sin movimientos" Message="@(_buscarAplicado.Length > 0 || _clasificacionAplicada.Length > 0 ? "No hay coincidencias. Cambiá o limpiá los filtros." : "Importá un extracto o seleccioná otra importación.")" />
            }
            else
            {
                <div class="conciliacion-scroll">
                    <table class="conciliacion-tabla conciliacion-tabla--acciones">
                        <thead><tr>
                            @foreach (var columna in Columnas)
                            {
                                <th aria-sort="@AriaOrden(columna.Key)">
                                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@_busy"
                                        OnClick="() => Ordenar(columna.Key)">@columna.Label @IndicadorOrden(columna.Key)</AlfaButton>
                                </th>
                            }
                            <th>Acciones</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var item in _movimientos.Items)
                            {
                                <tr @key="item.Id" class="@(_seleccion?.Id == item.Id ? "is-selected" : "")">
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td><td>@item.Banco</td><td class="conciliacion-descripcion">@item.Descripcion</td><td>@item.Referencia</td>
                                    <td class="conciliacion-numero @(item.Importe >= 0 ? "conciliacion-ingreso" : "conciliacion-egreso")">@Dinero(item.Importe)</td>
                                    <td>@Separar(item.Categoria)</td><td>@item.Cliente</td><td class="conciliacion-descripcion">
                                        @item.Propuesta
                                        @if(item.AvisoPosibleDuplicado is { } aviso)
                                        {
                                            <p class="conciliacion-aviso-duplicado"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @aviso</p>
                                        }
                                    </td>
                                    <td>@item.Confianza.ToString("N0")%</td><td>@item.Estado</td><td>@(item.ConciliacionId.HasValue ? $"Conciliado #{item.ConciliacionId}" : "Pendiente")</td>
                                    <td>
                                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="() => SeleccionarMovimiento(item)">Detalle</AlfaButton>
                                        @if (item.Categoria=="Cobranza" && item.Importe>0 && item.Estado!="Cobrado")
                                        {
                                            <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="()=>SeleccionarMovimiento(item)">Marcar como cobrado</AlfaButton>
                                            @if(item.TipoMatch!="CobranzaYaRegistrada" && !item.ConciliacionId.HasValue)
                                            {
                                                <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Disabled="@_busy"
                                                    OnClick="() => string.IsNullOrWhiteSpace(item.Cliente) || item.AvisoPosibleDuplicado is not null ? SeleccionarMovimiento(item) : AbrirCobranza(item)">@(string.IsNullOrWhiteSpace(item.Cliente) ? "Asignar cliente" : item.AvisoPosibleDuplicado is not null ? "Revisar posible duplicado" : "Cobrar")</AlfaButton>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <footer class="alfa-data-view-footer"><span class="alfa-data-view-footer__summary">@_movimientos.Total movimientos · 50 por página</span></footer>
            }
        </section>
        @if (_seleccion is not null)
        {
            <AlfaDialog Open="true" Title="@($"Detalle del movimiento #{_seleccion.Id}")"
                Size="AlfaDialogSize.Xl" Loading="@_busy" OnClose="CerrarDetalle">
                <ChildContent>
                <div class="conciliacion-detalle-resumen">
                    <section class="conciliacion-detalle-cliente" aria-label="Cliente y saldo">
                        <span class="conciliacion-detalle-etiqueta">Cliente</span>
                        <strong class="conciliacion-detalle-nombre">@(_detalle.FirstOrDefault()?.ClientName is { Length: >0 } nombre ? nombre : string.IsNullOrWhiteSpace(_seleccion.Cliente) ? "Sin cliente asignado" : _seleccion.Cliente)</strong>
                        @if (_detalle.FirstOrDefault()?.ClientCode is { Length: >0 } codigo)
                        {
                            <span class="conciliacion-detalle-secundario">Código @codigo</span>
                        }
                        <span class="conciliacion-detalle-etiqueta">Saldo del cliente</span>
                        <div class="conciliacion-detalle-saldos" aria-live="polite">
                            @if (_saldoDetalle is { ConsultaFallida:true })
                            {
                                <span>No se pudo consultar el saldo. Reintentá en Cuenta corriente.</span>
                            }
                            else if (_saldoDetalle is { } resumen)
                            {
                                @foreach(var saldo in resumen.Saldos)
                                {
                                    <strong class="conciliacion-detalle-importe">@saldo.Moneda @Dinero(saldo.Saldo)</strong>
                                }
                                @if(resumen.Saldos.Count==0) { <span>Sin movimientos al corte</span> }
                                <span class="conciliacion-detalle-secundario">Al @resumen.FechaCorte.ToString("dd/MM/yyyy") · según unidades autorizadas</span>
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(_detalle.FirstOrDefault()?.ClientCode) ? "Asigná un cliente para consultar su saldo." : "Consultando saldo…")</span>
                            }
                        </div>
                    </section>
                    <section class="conciliacion-detalle-banco" aria-label="Movimiento bancario">
                        <span class="conciliacion-detalle-etiqueta">Movimiento bancario · @_seleccion.Banco</span>
                        <strong class="conciliacion-detalle-importe @(_seleccion.Importe>=0 ? "conciliacion-ingreso" : "conciliacion-egreso")">$ @Dinero(_seleccion.Importe)</strong>
                        <span class="conciliacion-detalle-secundario">@_seleccion.Fecha.ToString("dd/MM/yyyy") · @Separar(_seleccion.Categoria)</span>
                        <p>@_seleccion.Descripcion</p>
                        <span class="conciliacion-detalle-secundario">Registración: @_seleccion.Estado · Conciliación: @(_seleccion.ConciliacionId.HasValue ? $"#{_seleccion.ConciliacionId}" : "Pendiente")</span>
                    </section>
                </div>
                @if(_seleccion.AvisoPosibleDuplicado is { } avisoDuplicado)
                {
                    <AlfaFeedbackPanel Message="@(new AppUiMessage { Severity=AppUiFeedbackSeverity.Warning,Title="Revisá el cobro existente",Message=avisoDuplicado })" />
                }
                <section class="conciliacion-detalle-propuesta" aria-label="Propuesta de aplicación">
                    <div>
                        <span class="conciliacion-detalle-etiqueta">Propuesta de aplicación</span>
                        @if (_detalle.Count>0)
                        {
                            <p>@_detalle[0].ProposalSummary</p>
                            <span class="conciliacion-detalle-secundario">@Separar(_detalle[0].MatchType) · Confianza @_detalle[0].Confidence.ToString("N0")%</span>
                        }
                        else { <p>Sin propuesta de aplicación a comprobantes.</p> }
                    </div>
                    @if (_seleccion.Estado!="Cobrado" && _seleccion.ConciliacionId is null && _seleccion.Categoria=="Cobranza" && _seleccion.Importe>0)
                    {
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="ReevaluarPropuesta">Reevaluar propuesta</AlfaButton>
                    }
                </section>
                <AlfaTabs Items="@DetalleTabs" ActiveKey="@_detalleTab" ActiveKeyChanged="v => _detalleTab=v ?? string.Empty" AriaLabel="Información del cliente" />
                <div hidden="@(_detalleTab!="revision")">
                <h3 class="conciliacion-detalle-titulo">Clasificación del movimiento</h3>
                <p class="conciliacion-detalle-secundario">@_seleccion.Observaciones</p>
                @if (_seleccion.Estado!="Cobrado")
                {
                    <div class="conciliacion-reclasificar">
                        <AlfaSelect Label="Clasificación del movimiento" Value="@_categoriaRevision" ValueChanged="v => _categoriaRevision=v ?? string.Empty"
                            Options="@Clasificaciones" Disabled="@_busy" />
                        <AlfaInput Label="Motivo de la corrección (opcional)" Value="@_motivoRevision" ValueChanged="v => _motivoRevision=v ?? string.Empty"
                            MaxLength="300" Disabled="@_busy" />
                        <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@(_busy || _categoriaRevision==_seleccion.Categoria)"
                            OnClick="GuardarClasificacion">Guardar clasificación</AlfaButton>
                    </div>
                }
                @if (_seleccion.Estado!="Cobrado" && _seleccion.ConciliacionId is null && _seleccion.Importe>0 && _seleccion.Categoria=="Cobranza")
                {
                    <div class="conciliacion-asignar-cliente">
                        <h3>@(string.IsNullOrWhiteSpace(_seleccion.Cliente) ? "Asignar cliente" : "Cambiar cliente")</h3>
                        <AlfaLookup TItem="ClientSearchResultDto" Label="Cliente" Placeholder="Buscar por nombre, código o CUIT"
                            SearchText="@_buscarCliente" SearchTextChanged="v => _buscarCliente=v"
                            SelectedItem="@_clienteAsignar" SelectedItemChanged="SeleccionarCliente" Disabled="@_busy"
                            SearchFunc="Servicio.BuscarClientesAsync" ItemKey="c => c.ClientCode">
                            <ItemTemplate Context="c">@c.ClientCode · @c.ClientName · @c.Cuit</ItemTemplate>
                        </AlfaLookup>
                        @if (_clienteAsignar is { } clienteSeleccionado)
                        {
                            <p>Cliente seleccionado: <strong>@clienteSeleccionado.ClientName</strong> · @clienteSeleccionado.ClientCode</p>
                        }
                        <AlfaCheckbox Value="@_recordarCliente" ValueChanged="v => _recordarCliente=v==true" Disabled="@_busy">Recordar este nombre bancario para próximas importaciones</AlfaCheckbox>
                        @if (_recordarCliente)
                        {
                            <AlfaInput Label="Nombre del pagador en el extracto" Value="@_aliasCliente" ValueChanged="v => _aliasCliente=v ?? string.Empty"
                                MaxLength="200" Disabled="@_busy" />
                            <p>Usá un nombre que identifique al pagador, por ejemplo «Maderas San Blas Srl». La asociación se usará para proponer el cliente; los comprobantes se seguirán revisando.</p>
                        }
                        <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@(_busy || _clienteAsignar is null)" OnClick="GuardarCliente">Asignar cliente</AlfaButton>
                    </div>
                }
                </div>
                <div hidden="@(_detalleTab!="cuenta")">
                    <ConciliacionCuentaCorrientePanel @ref="_cuentaDetalle" @key="(_seleccion.Id,_detalleVersion)" MovimientoId="@_seleccion.Id" FechaMovimiento="@_seleccion.Fecha"
                        PuedeReconocer="@(_seleccion.Estado!="Cobrado" && _seleccion.Categoria=="Cobranza" && _seleccion.Importe>0)" CobroReconocido="ActualizarCobroReconocido"
                        SaldoConsultado="ActualizarSaldoDetalle" SaldoEnCabecera="true" />
                </div>
                <div hidden="@(_detalleTab!="comprobantes")">
                @if (_detalle.Count>0)
                {
                    <p>Los importes de la propuesta corresponden al momento de importar. Compará debajo con la información actual del comprobante.</p>
                    @if (_detalle.Any(d => d.DocumentType is not null))
                    {
                        <div class="conciliacion-scroll"><table class="conciliacion-tabla">
                            <thead><tr><th>Comprobante</th><th>Saldo pendiente</th><th>Aplicación propuesta</th><th>Parcial</th></tr></thead>
                            <tbody>@foreach (var doc in _detalle.Where(d => d.DocumentType is not null))
                            {
                                <tr><td>@doc.DocumentDisplay</td><td>@Dinero(doc.PendingBalance ?? 0)</td><td>@Dinero(doc.AppliedAmount ?? 0)</td><td>@(doc.IsPartial == true ? "Sí" : "No")</td></tr>
                            }</tbody>
                        </table></div>
                    }
                }
                @if (_contexto.Comprobantes.Count>0)
                {
                    <h3 class="conciliacion-detalle-titulo">Comprobantes del cliente para comparar</h3>
                    <p>Hasta 40 comprobantes próximos a la fecha del movimiento, incluyendo los propuestos. Seleccioná Ver para consultar su información.</p>
                    <div class="conciliacion-scroll conciliacion-scroll--comparar"><table class="conciliacion-tabla">
                        <thead><tr><th>Fecha</th><th>Comprobante</th><th>Vencimiento</th><th>Moneda</th><th>Total</th><th>Saldo actual</th><th>Referencia</th><th></th></tr></thead>
                        <tbody>@foreach (var c in _contexto.Comprobantes)
                        {
                            <tr class="@(c.Id==_comprobanteDetalleId ? "is-selected" : null)">
                                <td>@c.Fecha?.ToString("dd/MM/yyyy")</td><td>@c.Display</td><td>@c.Vencimiento?.ToString("dd/MM/yyyy")</td>
                                <td>@c.Moneda</td><td class="conciliacion-numero">@Dinero(c.Importe)</td>
                                <td class="conciliacion-numero">@(c.SaldoActual.HasValue ? Dinero(c.SaldoActual.Value) : "Sin pendiente informado")</td>
                                <td>@(c.Anulada ? "Anulado" : c.Propuesto ? "Propuesto" : "Otro comprobante")</td>
                                <td><AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="() => _comprobanteDetalleId=c.Id">Ver</AlfaButton></td>
                            </tr>
                        }</tbody>
                    </table></div>
                    @if (_comprobanteInfo is { } info)
                    {
                        <section class="conciliacion-comprobante-info">
                            <h3 class="conciliacion-detalle-titulo">@info.Display</h3>
                            <p><strong>@info.Nombre</strong> · Documento/CUIT @info.Cuit · Unidad @info.Unidad</p>
                            @if(!string.IsNullOrWhiteSpace(info.Comentarios)) { <p>Comentarios: @info.Comentarios</p> }
                            @if(!string.IsNullOrWhiteSpace(info.Observaciones)) { <p>Observaciones: @info.Observaciones</p> }
                            @if(!string.IsNullOrWhiteSpace(info.Conceptos)) { <p>Conceptos (primeros 5 renglones): @info.Conceptos</p> }
                            @if(_contexto.Origenes.Any(o=>o.FacturaId==info.Id))
                            {
                                <p><strong>Pedidos/remitos de origen</strong></p>
                                @foreach(var origen in _contexto.Origenes.Where(o=>o.FacturaId==info.Id))
                                {
                                    <p>@origen.Tc @origen.Comprobante · @origen.Fecha?.ToString("dd/MM/yyyy") @origen.Comentarios</p>
                                }
                            }
                            else { <p>Sin pedidos/remitos de origen vinculados.</p> }
                        </section>
                    }
                }
                </div>
                </ChildContent>
                <Footer>
                    @if (_seleccion.Categoria=="Cobranza" && _seleccion.Importe>0 && _seleccion.Estado!="Cobrado")
                    {
                        <AlfaButton Variant="AlfaButtonVariant.Primary" Disabled="@_busy" OnClick="MostrarReconocimientoCobro">Marcar como cobrado</AlfaButton>
                    }
                    @if (_detalleTab=="comprobantes" && _seleccion.Categoria=="Cobranza" && _seleccion.Importe>0 && _seleccion.Estado!="Cobrado" && _seleccion.TipoMatch!="CobranzaYaRegistrada" && !_seleccion.ConciliacionId.HasValue)
                    {
                        <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_seleccion.Cliente) || (_comprobanteInfo is { } elegido && (elegido.Anulada || elegido.SaldoActual is not >0)))"
                            OnClick="() => AbrirCobranza(_seleccion,_comprobanteInfo?.Clave)">Cobrar</AlfaButton>
                    }
                    <AlfaButton Variant="AlfaButtonVariant.Secondary" OnClick="CerrarDetalle">Cerrar</AlfaButton>
                </Footer>
            </AlfaDialog>
        }
    }
    <CobranzaRapidaDialog Preparacion="@_cobranza" Busy="@_busy" Error="@_errorCobranza" ComprobantePreferido="@_comprobantePreferido"
        OnClose="CerrarCobranza" OnConfirm="ConfirmarCobranza" />
    <AlfaConfirmDialog Open="@(_eliminar is not null)" Title="Eliminar importación"
        Message="@($"Se eliminará la importación #{_eliminar?.Id} y sus movimientos y propuestas.")"
        SecondaryMessage="No se modifican comprobantes ni asientos de Alfa." ConfirmLabel="Eliminar"
        Loading="@_busy" OnConfirm="EliminarImportacion" OnCancel="() => _eliminar = null" />
</div>

@code {
    private PageHeaderConfig? _header;
    private CancellationTokenSource _lifetime = new();
    private bool _disposed, _busy, _listo, _requiereBanco, _requiereFecha;
    private string _fechaReferencia="";
    private string _buscar = "", _buscarAplicado = "", _clasificacion = "", _clasificacionAplicada = "", _orden = "fecha";
    private bool _descendente = true;
    private string _tab = "importar", _banco = "", _cuenta = "", _lecturaMensaje = "";
    private int _paginaImport = 1, _paginaMov = 1, _cantidad;
    private decimal _ingresos, _egresos;
    private long? _filtro;
    private ConciliacionArchivo? _archivo;
    private AppUiMessage? _feedback;
    private IReadOnlyList<ConciliacionCuenta> _cuentas = [];
    private PagedResult<ConciliacionImportacion> _importaciones = new();
    private PagedResult<ConciliacionMovimiento> _movimientos = new();
    private IReadOnlyList<MatchDetailItem> _detalle = [];
    private string _detalleTab="cuenta";
    private static readonly IReadOnlyList<AlfaTabItem> DetalleTabs = [new("cuenta","Cuenta corriente"),new("comprobantes","Comprobantes"),new("revision","Clasificación y cliente")];
    private ConciliacionSaldoResumen? _saldoDetalle;
