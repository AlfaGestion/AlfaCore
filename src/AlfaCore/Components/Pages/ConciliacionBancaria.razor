    protected override void OnAfterRender(bool firstRender) { if (firstRender) PublicarHeader(); }

    private async Task Operar(Func<CancellationToken,Task> action)
    {
        if (_busy || _disposed) return;
        var lifetime = _lifetime;
        _busy = true;
        PublicarHeader();
        await InvokeAsync(StateHasChanged);
        try { await action(lifetime.Token); }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!lifetime.IsCancellationRequested)
            {
                if (ex is not AppUserFacingException && TenantDataAccessGuard.IsActiveSessionAuthorized(Sesiones,Usuarios))
                {
                    var mensaje=ex is InvalidOperationException ? ex.Message : "No se pudo leer el archivo. Revisá que sea un Excel válido de hasta 20 MB.";
                    var code=await Eventos.LogErrorAsync("ConciliacionBancaria","Pantalla",ex,mensaje);
                    ex=new AppUserFacingException(mensaje,code,ex);
                }
                _feedback = UiOps.BuildMessage(ex,"Conciliación bancaria");
            }
        }
        finally { if (ReferenceEquals(lifetime,_lifetime) && !_disposed) { _busy = false; PublicarHeader(); await InvokeAsync(StateHasChanged); } }
    }

    private async Task SeleccionarArchivo(InputFileChangeEventArgs e)
    {
        await Operar(async ct =>
        {
            _listo = false; _requiereBanco = false; _requiereFecha=false; _fechaReferencia=""; _banco = ""; _cuenta = ""; _archivo = null; _feedback = null; _lecturaMensaje = "Leyendo archivo…";
            if (e.File.Size > ConciliacionExtractoLector.MaxBytes)
                throw new InvalidOperationException("El archivo supera los 20 MB. Seleccioná un extracto más pequeño.");
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(ConciliacionExtractoLector.MaxBytes,ct).CopyToAsync(ms,ct);
            ct.ThrowIfCancellationRequested();
            _archivo = new(e.File.Name,ms.ToArray());
            await Leer(ct);
        });
    }
    private async Task Leer(CancellationToken ct)
    {
        if (_archivo is null) return;
        ConciliacionLectura lectura;
        try { lectura = await Servicio.LeerAsync(_archivo,Enum.TryParse<BankSource>(_banco,out var banco) ? banco : null,ct); }
        catch (AppUserFacingException) { _lecturaMensaje="No se pudo procesar el archivo. Revisá el mensaje e intentá nuevamente."; throw; }
        ct.ThrowIfCancellationRequested();
        _requiereBanco = lectura.Banco is null;
        _banco = lectura.Banco?.ToString() ?? "";
        _lecturaMensaje = lectura.Mensaje;
        _requiereFecha=lectura.RequiereFechaReferencia;
        if(_requiereFecha && _fechaReferencia.Length==0 && lectura.FechaReferenciaSugerida is { } sugerida)
            _fechaReferencia=sugerida.ToString("yyyy-MM-dd");
        _cantidad = lectura.Movimientos.Count;
        _ingresos = lectura.Movimientos.Where(m => m.Amount > 0).Sum(m => m.Amount);
        _egresos = -lectura.Movimientos.Where(m => m.Amount < 0).Sum(m => m.Amount);
        _listo = _cantidad > 0;
        if (string.IsNullOrWhiteSpace(_cuenta) && lectura.Banco is not null)
            _cuenta = ConciliacionExtractoLector.SugerirCuenta(lectura.Banco.Value,_cuentas);
    }
    private async Task CambiarBanco(string? value)
    {
        _banco = value ?? ""; _listo = false; _cuenta = "";
        if (_banco.Length > 0) await Operar(Leer);
