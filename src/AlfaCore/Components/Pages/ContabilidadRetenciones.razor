@page "/contabilidad/retenciones"
@page "/{idweb}/{idbase:int}/contabilidad/retenciones"
@using AlfaCore.Services
@inject IRetencionesService Service
@inject IAppUiOperationService UiOps
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Retenciones y percepciones | Alfa Gestión</PageTitle>

@* Retenciones y percepciones sufridas y practicadas (cuentas RI/RB/RG/RO del asiento) con las exportaciones de SIFERE WEB y F.2002. *@
<div class="gd-page gd rp-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <section class="rp-filtros">
        <label>Desde <input type="date" class="rp-input" value="@_f.Desde.ToString("yyyy-MM-dd")" @onchange="e => CambiarFecha(e, true)" /></label>
        <label>Hasta <input type="date" class="rp-input" value="@_f.Hasta.ToString("yyyy-MM-dd")" @onchange="e => CambiarFecha(e, false)" /></label>
        <label>Ver
            <select class="rp-input" value="@_f.Alcance" @onchange="e => _f.Alcance = e.Value?.ToString() ?? _f.Alcance">
                <option value="SUFRIDAS">Sufridas</option>
                <option value="PRACTICADAS">Practicadas</option>
                <option value="TODAS">Todas</option>
            </select>
        </label>
        @if (_cfg is { Unidades.Count: > 1 })
        {
            <label>Unidad
                <select class="rp-input" value="@_f.Unidad" @onchange="e => _f.Unidad = e.Value?.ToString() ?? string.Empty">
                    <option value="">Todas</option>
                    @foreach (var u in _cfg.Unidades) { <option value="@u.Codigo">@u.Codigo · @u.Descripcion</option> }
                </select>
            </label>
        }
        <div class="rp-meses">
            <button type="button" @onclick="() => Mes(-1)">Mes anterior</button>
            <button type="button" @onclick="() => Mes(0)">Este mes</button>
        </div>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-search" Disabled="_busy" OnClick="_ => ConsultarAsync()">Consultar</AlfaButton>
    </section>

    @if (_r is { } r)
    {
        @foreach (var a in r.Avisos) { <AlfaNotification Message="@AppUiMessage.Warning("Revisar", a)" /> }
        @if (r.Totales.Count > 0)
        {
            <div class="kpi-grid rp-kpis">
                @foreach (var t in r.Totales)
                {
                    <KpiCard Titulo="@($"{t.Impuesto} · {t.Clase} {(t.Sufrida ? "sufrida" : "practicada")}")" Valor="@t.Importe.ToString("C2", Culture)"
                             Icono="@Icono(t.Sufrida ? "bi-box-arrow-in-down" : "bi-box-arrow-up")" Descripcion="@($"{t.Cantidad} movimiento(s)")" />
                }
            </div>
        }

        <section class="rp-export">
            <strong><i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i> Archivos para presentar (sufridas del período)</strong>
            <div class="rp-export__botones">
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("SIFERE_RET")'>SIFERE · retenciones IIBB</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("SIFERE_PERC")'>SIFERE · percepciones IIBB</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("IVA_RET")'>F.2002 · retenciones IVA</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("IVA_PERC")'>F.2002 · percepciones IVA</AlfaButton>
            </div>
            <small>SIFERE WEB (Comisión Arbitral) va en un .zip con un archivo por jurisdicción. F.2002 es «Mis Aplicaciones Web» de ARCA (IVA por actividad). Mismos formatos que el Alfa Gestión.</small>
        </section>

        <section class="rp-export">
            <strong><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i> Archivos de agente (practicadas del período)</strong>
            <div class="rp-export__botones">
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("SICORE_GAN")'>SICORE · retenciones Ganancias</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("SICORE_SUJ")'>SICORE · sujetos retenidos</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("SICORE_PERC_IVA")'>SICORE · percepción IVA</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("ARBA_RET")'>ARBA · retenciones IIBB</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("ARBA_PERC")'>ARBA · percepciones IIBB</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("ARCIBA")'>ARCIBA · percepciones IIBB</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("SIRCAR_RET")'>SIRCAR · retenciones IIBB</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick='_ => ExportarAsync("SIRCAR_PERC")'>SIRCAR · percepciones IIBB</AlfaButton>
            </div>
            <small>Salen de las retenciones grabadas en órdenes de pago y pagos, y de las percepciones del libro de IVA ventas. ARBA va en .zip con el nombre de lote; SIRCAR, un archivo por jurisdicción.</small>
        </section>

        @if (r.Filas.Count == 0)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin movimientos" Message="No hay retenciones ni percepciones en ese período." />
        }
        else
        {
            <section class="rp-tabla__marco"><div class="rp-tabla__scroll">
                <table class="rp-tabla">
                    <thead><tr><th>Fecha</th><th>Impuesto</th><th>Origen</th><th>Comprobante</th><th>Agente / sujeto</th><th>Jurisdicción</th><th>Certificado</th>
                        <th class="n">Base</th><th class="n">Importe</th></tr></thead>
                    <tbody>
                    @foreach (var x in r.Filas)
                    {
                        <tr>
                            <td>@x.Fecha.ToString("dd/MM/yyyy")</td>
                            <td><span class="rp-chip @(x.Sufrida ? "is-sufrida" : "is-practicada")">@x.Impuesto</span><small>@x.Clase @(x.Sufrida ? "sufrida" : "practicada")</small></td>
                            <td>@x.Origen<small>@x.Cuenta · @x.CuentaNombre</small></td>
                            <td>@x.Comprobante</td>
                            <td>@x.Nombre<small>@x.Cuit</small></td>
                            <td>@x.JurisdiccionNombre</td>
                            <td>@x.Certificado</td>
                            <td class="n">@(x.Base is { } b ? b.ToString("N2", Culture) : "")</td>
                            <td class="n @(x.Importe < 0 ? "is-neg" : null)">@x.Importe.ToString("N2", Culture)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></section>
        }
    }
    else if (!_busy)
    {
        <AlfaEmptyState Title="Elegí el período" Message="Consultá las retenciones y percepciones sufridas o practicadas del período." />
    }
</div>

<AlfaDialog Open="@(_cfgEdit is not null)" Title="Configurar exportaciones" Size="AlfaDialogSize.Lg" Loading="@_cfgBusy"
            ErrorMessage="@_cfgError" CloseOnBackdrop="false" OnClose="() => _cfgEdit = null">
    <ChildContent>
    @if (_cfgEdit is { } c)
    {
        <div class="rp-cfg">
            <h4>Sufridas</h4>
            <AlfaSelect Label="Jurisdicción por defecto (SIFERE)" Value="@c.JurisdiccionDefecto" ValueChanged="v => c.JurisdiccionDefecto = v ?? string.Empty"
                        Options="@JurisdiccionOpciones("Sin jurisdicción por defecto")" />
            <small>Se usa cuando la cuenta de la retención o percepción de IIBB no tiene provincia cargada.</small>
            <div class="rp-cfg__par">
                <AlfaInput Label="Régimen F.2002 · retenciones de IVA" Value="@c.RegimenRetencionIva" ValueChanged="v => c.RegimenRetencionIva = v ?? string.Empty" MaxLength="3" />
                <AlfaInput Label="Régimen F.2002 · percepciones de IVA" Value="@c.RegimenPercepcionIva" ValueChanged="v => c.RegimenPercepcionIva = v ?? string.Empty" MaxLength="3" />
            </div>
            <small>Código de régimen de ARCA (tres dígitos). Son los mismos datos del Alfa Gestión.</small>

            <h4>ARBA (agente de recaudación)</h4>
            <div class="rp-cfg__par">
                <AlfaInput Label="Código de actividad · retenciones" Value="@c.ArbaRetencionesActividad" ValueChanged="v => c.ArbaRetencionesActividad = v ?? string.Empty" MaxLength="20" />
                <AlfaInput Label="Código de actividad · percepciones" Value="@c.ArbaPercepcionesActividad" ValueChanged="v => c.ArbaPercepcionesActividad = v ?? string.Empty" MaxLength="20" />
            </div>
            <div class="rp-cfg__par">
                <AlfaCheckbox Value="@c.ArbaRetencionesMensual" ValueChanged="v => c.ArbaRetencionesMensual = v ?? true">Retenciones: presentación mensual</AlfaCheckbox>
                <AlfaCheckbox Value="@c.ArbaPercepcionesMensual" ValueChanged="v => c.ArbaPercepcionesMensual = v ?? true">Percepciones: presentación mensual</AlfaCheckbox>
            </div>
            <small>Sin presentación mensual, el lote es por quincena: consultá del 1 al 15 o del 16 a fin de mes.</small>

            <h4>SIRCAR</h4>
            <div class="rp-cfg__par">
                <AlfaInput Label="Tipo de régimen" Value="@c.SircarRegimen" ValueChanged="v => c.SircarRegimen = v ?? string.Empty" MaxLength="3" />
                <AlfaSelect Label="Jurisdicción" Value="@c.SircarJurisdiccion" ValueChanged="v => c.SircarJurisdiccion = v ?? string.Empty"
                            Options="@JurisdiccionOpciones("La provincia de cada comprobante")" />
            </div>

            <h4>SICORE · códigos por retención</h4>
            @if (c.Sicore.Count == 0)
            {
                <small>No hay retenciones cargadas en la tabla de retenciones.</small>
            }
            else
            {
                <table class="rp-cfg__tabla">
                    <thead><tr><th>Retención</th><th>Impuesto</th><th>Régimen</th></tr></thead>
                    <tbody>
                    @foreach (var s in c.Sicore)
                    {
                        <tr>
                            <td>@s.IdRetencion · @s.Descripcion</td>
                            <td><input class="rp-input" maxlength="4" placeholder="217" value="@s.Impuesto" @onchange="e => s.Impuesto = e.Value?.ToString() ?? string.Empty" /></td>
                            <td><input class="rp-input" maxlength="3" value="@s.Regimen" @onchange="e => s.Regimen = e.Value?.ToString() ?? string.Empty" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <small>Impuesto vacío = 217 (Ganancias). Son las claves RETGANCI_ / RETGANCR_ de la tabla de retenciones del Alfa Gestión.</small>
            }
        </div>
    }
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="_cfgBusy" OnClick="_ => _cfgEdit = null">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check2" Disabled="_cfgBusy" OnClick="_ => GuardarConfigAsync()">Guardar</AlfaButton>
    </Footer>
</AlfaDialog>

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private readonly RetencionesFiltro _f = new();
    private RetencionesResultado? _r;
    private RetencionesConfig? _cfg, _cfgEdit;
    private AppUiMessage? _feedback;
    private string? _cfgError;
    private bool _busy, _cfgBusy, _disposed;
    private PageHeaderConfig? _header;

    protected override async Task OnInitializedAsync()
    {
        Mes(-1, consultar: false);
        UpdateHeader();
        var c = await UiOps.RunAsync(() => Service.GetConfigAsync(), "Retenciones");
        if (c.Success) _cfg = c.Value; else _feedback = c.Feedback;
        if (_cfg is not null) await ConsultarAsync();
    }

    private void CambiarFecha(ChangeEventArgs e, bool desde)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d)) return;
        if (desde) _f.Desde = d; else _f.Hasta = d;
    }

    private void Mes(int delta, bool consultar = true)
    {
        var inicio = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(delta);
        _f.Desde = inicio; _f.Hasta = inicio.AddMonths(1).AddDays(-1);
        if (consultar) _ = ConsultarAsync();
    }

    private async Task ConsultarAsync()
    {
        if (_busy) return;
        _busy = true; _feedback = null; UpdateHeader(); await InvokeAsync(StateHasChanged);
        try
        {
            var filtro = new RetencionesFiltro { Desde = _f.Desde, Hasta = _f.Hasta, Alcance = _f.Alcance, Unidad = _f.Unidad };
            var r = await UiOps.RunAsync(() => Service.GetAsync(filtro), "Retenciones y percepciones");
            if (r.Success) _r = r.Value; else _feedback = r.Feedback;
        }
        finally { _busy = false; if (!_disposed) { UpdateHeader(); await InvokeAsync(StateHasChanged); } }
    }

    private async Task ExportarAsync(string formato)
    {
        if (_busy) return;
        _busy = true; _feedback = null; UpdateHeader(); StateHasChanged();
        try
        {
            var filtro = new RetencionesFiltro { Desde = _f.Desde, Hasta = _f.Hasta, Alcance = _f.Alcance, Unidad = _f.Unidad };
            var r = await UiOps.RunAsync(() => Service.ExportarAsync(filtro, formato), "Exportar");
            if (!r.Success) { _feedback = r.Feedback; return; }
            await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob", Convert.ToBase64String(r.Value!.Contenido), r.Value.ContentType, r.Value.Nombre);
        }
        finally { _busy = false; if (!_disposed) { UpdateHeader(); StateHasChanged(); } }
    }

    private Task AbrirConfig()
    {
        if (_cfg is null) return Task.CompletedTask;
        _cfgError = null;
        _cfgEdit = new RetencionesConfig
        {
            JurisdiccionDefecto = _cfg.JurisdiccionDefecto, RegimenRetencionIva = _cfg.RegimenRetencionIva, RegimenPercepcionIva = _cfg.RegimenPercepcionIva,
            ArbaRetencionesMensual = _cfg.ArbaRetencionesMensual, ArbaPercepcionesMensual = _cfg.ArbaPercepcionesMensual,
            ArbaRetencionesActividad = _cfg.ArbaRetencionesActividad, ArbaPercepcionesActividad = _cfg.ArbaPercepcionesActividad,
            SircarRegimen = _cfg.SircarRegimen, SircarJurisdiccion = _cfg.SircarJurisdiccion,
            Sicore = _cfg.Sicore.Select(s => new RetencionSicoreCodigo { IdRetencion = s.IdRetencion, Descripcion = s.Descripcion, Impuesto = s.Impuesto, Regimen = s.Regimen }).ToList(),
            Jurisdicciones = _cfg.Jurisdicciones, Unidades = _cfg.Unidades
        };
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task GuardarConfigAsync()
    {
        if (_cfgEdit is null || _cfgBusy) return;
        _cfgBusy = true; _cfgError = null;
        try
        {
            await Service.GuardarConfigAsync(_cfgEdit);
            _cfg = _cfgEdit; _cfgEdit = null;
            _feedback = AppUiMessage.Success("Configuración guardada", "Se guardaron los datos de las exportaciones.");
        }
        catch (Exception ex) { _cfgError = ex is AppUserFacingException or InvalidOperationException ? ex.Message : "No se pudo guardar."; }
        finally { _cfgBusy = false; }
    }

    private async Task ExcelAsync() => await ExportarAsync("EXCEL");

    private void UpdateHeader() => PageHeader.Set(_header = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot, ModuleKey = "contabilidad", Title = "Retenciones y percepciones",
        Breadcrumb = ["Contabilidad", "Retenciones y percepciones"],
        TopNavigationItems = ModuleTopNavPresets.BuildContabilidad(RouteContext, Nav, "retenciones"),
        State = _busy ? PageHeaderState.Loading : PageHeaderState.List,
        Actions =
        [
            new() { Key = "config", Label = "Configurar", Icon = "bi-gear", Style = PageHeaderActionStyle.Secondary, Disabled = _busy || _cfg is null, OnClick = AbrirConfig },
            new() { Key = "excel", Label = "Excel", Icon = "bi-file-earmark-excel", Style = PageHeaderActionStyle.Secondary, Disabled = _busy || _r is null, OnClick = ExcelAsync }
        ]
    });

    private List<AlfaSelectOption> JurisdiccionOpciones(string vacia)
        => new[] { new AlfaSelectOption("", vacia) }.Concat((_cfg?.Jurisdicciones ?? []).Select(j => new AlfaSelectOption(j.Codigo, $"{j.Codigo} · {j.Nombre}"))).ToList();

    private static string Icono(string bi) => $"<i class=\"bi {bi}\" aria-hidden=\"true\"></i>";

    public void Dispose()
    {
        _disposed = true;
        if (ReferenceEquals(PageHeader.Current, _header)) PageHeader.Clear();
    }
}
