@page "/consultas"
@page "/{idweb}/{idbase:int}/consultas"
@inject AlfaCore.Services.IConsultasService ConsultasSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Consultas | Alfa Gestión</PageTitle>

<div class="gd-page gd gd-legacy consultas-ad">
@if (_cargando)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando consultas…
    </div>
}
else if (_error is not null)
{
    <AlfaNotification Message="@_error" OnDismiss="() => _error = null" />
}

@if (_raiz.Count == 0)
{
    <div class="consultas-empty">
        No se encontraron consultas guardadas en la base de datos.
    </div>
}
else
{
    <div class="ctree-layout">

        <!-- Panel izquierdo: árbol jerárquico -->
        <div class="ctree-panel">

            <div class="ctree-search">
                <i class="bi bi-search ctree-search__icon"></i>
                <input class="ctree-search__input"
                       type="search"
                       placeholder="Buscar por nombre o código…"
                       @bind="_busqueda"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDownAsync" />
                <button type="button" class="btn btn--primary btn--sm" @onclick="AplicarBusquedaAsync">
                    <i class="bi bi-search"></i> Aplicar
                </button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarBusqueda">
                    <i class="bi bi-eraser"></i> Limpiar
                </button>
            </div>

            <div class="ctree">
                @foreach (var (nodo, nivel) in GetNodosVisibles())
                {
                    <div class="ctree__node">
                        <div class="ctree__indent" style="width: @(nivel * 18)px;"></div>

                        @if (nodo.Hijos.Count > 0)
                        {
                            var expandido = _expandidos.Contains(nodo.Clave);
                            <button class="ctree__toggle" @onclick="() => ToggleNodo(nodo.Clave)">
                                <i class="bi @(expandido ? "bi-chevron-down" : "bi-chevron-right") ctree__chevron"></i>
                                <span class="ctree__node-label">@nodo.Nombre</span>
                                <span class="ctree__group-count">@nodo.Hijos.Count</span>
                            </button>
                        }
                        else
                        {
                            <a class="ctree__leaf" href="@RouteContext.BuildRoute($"/consultas/{nodo.Id}")">
                                <span class="ctree__item-clave">@nodo.Clave</span>
                                <span class="ctree__node-label">@nodo.Nombre</span>
                                @if (nodo.TieneParametros)
                                {
                                    <i class="bi bi-sliders2 ctree__item-badge" title="Requiere parámetros"></i>
                                }
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Panel derecho: placeholder -->
        <div class="ctree-content">
            <div class="ctree-welcome">
                <i class="bi bi-table ctree-welcome__icon"></i>
                <p class="ctree-welcome__text">Seleccioná una consulta del árbol para abrirla.</p>
                <a class="btn btn--ghost" href="@RouteContext.BuildRoute("/consultas/nueva")">
                    <i class="bi bi-plus-lg"></i> Crear nueva consulta
                </a>
            </div>
        </div>

    </div>
}
</div>

@code {
    private List<AlfaCore.Models.NodoArbolDto> _raiz = [];
    private HashSet<string> _expandidos = [];
    private string _busqueda = string.Empty;
    private bool _cargando = true;
    private AlfaCore.Models.AppUiMessage? _error;

    private PageHeaderConfig? _pageHeaderPublicado;
    private string _headerSnapshot = string.Empty;

    // Estado que muestra la barra superior (acciones habilitadas, buscador): si cambia, se
    // republica el header después del render de la página.
    private string HeaderSnapshot() => string.Empty;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || HeaderSnapshot() != _headerSnapshot)
            UpdatePageHeader();
    }


    private void UpdatePageHeader()
    {
        _headerSnapshot = HeaderSnapshot();
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "consultas",
            Title = "Consultas",
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildConsultas(RouteContext, Nav, "consultas"),
            Actions =
            [
                new PageHeaderAction
                {
                    Key = "nueva",
                    Label = "Nueva consulta",
                    Icon = "bi-plus-lg",
                    Style = PageHeaderActionStyle.Primary,
                    Disabled = false,
                    OnClick = () => InvokeAsync(() => { Nav.NavigateTo(RouteContext.BuildRoute("/consultas/nueva")); StateHasChanged(); })
                },
            ],
        });
    }

    protected override async Task OnInitializedAsync()
    {
        SessionSvc.SessionChanged += OnSessionChanged;
        await CargarArbolAsync();
    }

    private async Task CargarArbolAsync()
    {
        _cargando = true;
        _error = null;

        var result = await UiOps.RunAsync(async () =>
        {
            _raiz = (await ConsultasSvc.GetArbolAsync()).ToList();
            foreach (var r in _raiz)
                _expandidos.Add(r.Clave);
        }, "No se pudieron cargar las consultas.");

        _error = result.Feedback;
        _cargando = false;
    }

    private void OnSessionChanged()
    {
        _expandidos.Clear();
        InvokeAsync(async () => { await CargarArbolAsync(); StateHasChanged(); });
    }

    public void Dispose()
    {
        SessionSvc.SessionChanged -= OnSessionChanged;
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void ToggleNodo(string clave)
    {
        if (!_expandidos.Remove(clave))
            _expandidos.Add(clave);
    }

    private Task AplicarBusquedaAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void LimpiarBusqueda()
        => _busqueda = string.Empty;

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return;

        await AplicarBusquedaAsync();
    }

    private IEnumerable<(AlfaCore.Models.NodoArbolDto nodo, int nivel)> GetNodosVisibles()
    {
        if (string.IsNullOrWhiteSpace(_busqueda))
            return GetVisiblesRec(_raiz, 0);

        return GetTodosRec(_raiz)
            .Where(n => n.Nombre.Contains(_busqueda, StringComparison.CurrentCultureIgnoreCase)
                     || n.Clave.Contains(_busqueda, StringComparison.CurrentCultureIgnoreCase))
            .Select(n => (n, 0));
    }

    private IEnumerable<(AlfaCore.Models.NodoArbolDto, int)> GetVisiblesRec(
        IEnumerable<AlfaCore.Models.NodoArbolDto> nodos, int nivel)
    {
        foreach (var nodo in nodos)
        {
            yield return (nodo, nivel);
            if (nodo.Hijos.Count > 0 && _expandidos.Contains(nodo.Clave))
                foreach (var hijo in GetVisiblesRec(nodo.Hijos, nivel + 1))
                    yield return hijo;
        }
    }

    private IEnumerable<AlfaCore.Models.NodoArbolDto> GetTodosRec(
        IEnumerable<AlfaCore.Models.NodoArbolDto> nodos)
    {
        foreach (var nodo in nodos)
        {
            yield return nodo;
            foreach (var hijo in GetTodosRec(nodo.Hijos))
                yield return hijo;
        }
    }

    private static string GetFeedbackClass(AlfaCore.Models.AppUiMessage message)
        => message.Severity switch
        {
            AlfaCore.Models.AppUiFeedbackSeverity.Success => "conversations-inline--ok",
            AlfaCore.Models.AppUiFeedbackSeverity.Warning => "conversations-inline--error",
            AlfaCore.Models.AppUiFeedbackSeverity.Error => "conversations-inline--error",
            _ => "conversations-inline--ok"
        };
}
