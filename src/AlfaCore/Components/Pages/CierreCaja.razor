@page "/caja-bancos/cierre"
@page "/{idweb}/{idbase:int}/caja-bancos/cierre"
@using AlfaCore.Models
@using AlfaCore.Services
@inject ICierreCajaService Service
@inject IAppUiOperationService UiOps
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@inject CierreCajaExportService ExportService
@inject IConversacionesService Conversaciones
@inject IAppUserSessionService AppUser
@inject IAppEventService Events
@inject IJSRuntime JS
@using AlfaCore.Components.Shared.AlfaDesign
@implements IDisposable

<PageTitle>Cierre de caja | AlfaCore</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Cierre de caja</h2>
            <p>Resumen del día operativo por caja y unidad de negocio. Elegí fecha, caja y opciones arriba y presioná Cargar.</p>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_feedback))
    {
        <AlfaNotification Message="@AppUiMessage.Warning("Cierre de caja", _feedback)" OnDismiss="() => _feedback = string.Empty" />
    }
    @if (_ocupado)
    {
        <AlfaEmptyState Title="@(string.IsNullOrWhiteSpace(_estado) ? "Procesando" : _estado)" Message="Esperá un momento." />
    }
    @if (_consulta is not null)
    {
        <div @key="_version" class="cierre-resultados">
            <p class="gd-hint">Fecha operativa: <strong>@_consulta.Fecha.ToString("dd/MM/yyyy")</strong> · <strong>@_unidadConsultada</strong> · @(_consulta.Caja.Length == 0 ? "Todas las cajas" : $"Caja {_consulta.Caja}")</p>
            @foreach (var seccion in CierreCajaSecciones.Activas(_consulta))
            {
                <AlfaCore.Components.Shared.CierreCajaTabla @key="seccion.Clave" Seccion="seccion" Filtros="_consulta" />
            }
        </div>
    }
    else if (!_ocupado)
    {
        <AlfaEmptyState Title="Todavía no cargaste un cierre" Message="Seleccioná la fecha, la caja y las opciones en el buscador de arriba." ActionLabel="Cargar" ActionIcon="bi bi-arrow-clockwise" OnAction="_ => Cargar()" />
    }
</div>

<AlfaDialog Open="@(_dialogo.Length > 0)"
            Title="@(_dialogo == "email" ? "Enviar cierre por email" : "Enviar cierre por WhatsApp")"
            Eyebrow="Cierre de caja"
            OnClose="CerrarDialogo"
            Disabled="@_ocupado">
    <ChildContent>
        <div class="cierre-envio">
            <div class="cierre-envio__archivo">
                <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
                <div>
                    <strong>@_archivo?.Nombre</strong>
                    <span>Excel con todas las filas y los filtros del informe cargado.</span>
                </div>
            </div>

            @if (_dialogo == "email")
            {
                <AlfaInput Label="Email del destinatario" Type="email" Value="@_destinatario" ValueChanged="v => _destinatario = v ?? string.Empty" Placeholder="nombre@empresa.com" Disabled="@_ocupado" />
            }
            else
            {
                <div class="cierre-envio__buscar" @onkeydown="BuscarConEnterAsync">
                    <AlfaInput Label="Buscar conversación" Value="@_busqueda" ValueChanged="v => _busqueda = v ?? string.Empty" Placeholder="Nombre o teléfono" Disabled="@_ocupado" />
                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Icon="bi bi-search" Disabled="@_ocupado" OnClick="_ => BuscarConversaciones()">Buscar</AlfaButton>
                </div>

                @if (_conversaciones.Count > 0)
                {
                    <AlfaSelect Label="Destinatario"
                                Value="@(_conversacion > 0 ? _conversacion.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)"
                                ValueChanged="OnDestinatarioElegidoAsync"
                                Options="@OpcionesConversaciones"
                                Placeholder="Elegí una conversación"
                                Disabled="@_ocupado" />
                    <p class="cierre-envio__ayuda">@(_conversaciones.Count >= 50 ? "Se muestran las primeras 50 coincidencias: refiná la búsqueda si no encontrás el destinatario." : $"{_conversaciones.Count} coincidencia(s).")</p>
                }

                @if (VentanaVencida)
                {
                    <div class="cierre-plantilla">
                        <p class="cierre-plantilla__aviso">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                            <span>Pasaron más de 24 h desde el último mensaje de este contacto. WhatsApp solo permite reabrir la conversación con una <strong>plantilla aprobada</strong>; el Excel viaja adjunto dentro de la plantilla.</span>
                        </p>

                        @if (_cargandoPlantillas)
                        {
                            <p class="cierre-envio__ayuda" role="status">Buscando plantillas con documento…</p>
                        }
                        else if (_plantillasDocumento.Count == 0)
                        {
                            <div class="cierre-plantilla__vacia">
                                <div>
                                    <strong>Todavía no hay una plantilla con documento aprobada</strong>
                                    <span>Creala desde AlfaCore: se abre precargada con el texto y las variables del cierre. Después la enviás a aprobación de Meta y, cuando esté aprobada, aparece acá.</span>
                                </div>
                                <div class="cierre-plantilla__accion">
                                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-plus-circle" Disabled="@_ocupado" OnClick="_ => IrACrearPlantilla()">Crear plantilla</AlfaButton>
                                </div>
                            </div>
                        }
                        else
                        {
                            <AlfaSelect Label="Plantilla"
                                        Value="@(_idPlantilla > 0 ? _idPlantilla.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)"
                                        ValueChanged="OnPlantillaElegidaAsync"
                                        Options="@OpcionesPlantillas"
                                        Disabled="@_ocupado" />
                            @if (_valoresPlantilla.Count > 0)
                            {
                                <div class="cierre-plantilla__variables">
                                    @for (var i = 0; i < _valoresPlantilla.Count; i++)
                                    {
                                        var indice = i;
                                        <AlfaInput Label="@("Variable {{" + (indice + 1) + "}}")" Value="@_valoresPlantilla[indice]" ValueChanged="v => _valoresPlantilla[indice] = v ?? string.Empty" Disabled="@_ocupado" />
                                    }
                                </div>
                            }
                            @if (PlantillaSeleccionada is not null)
                            {
                                <div class="cierre-plantilla__preview">
                                    <span class="cierre-plantilla__preview-doc"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> @_archivo?.Nombre</span>
                                    <p>@VistaPreviaPlantilla</p>
                                </div>
                            }
                        }
                    </div>
                }
            }

            @if (_ocupado && !string.IsNullOrWhiteSpace(_estado))
            {
                <p class="cierre-envio__ayuda" role="status">@_estado</p>
            }
            @if (_feedback.Length > 0)
            {
                <p class="cierre-envio__error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_feedback</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_ocupado" OnClick="_ => CerrarDialogo()">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-send" Loading="@_ocupado" Disabled="@(_ocupado || (_dialogo == "email" ? string.IsNullOrWhiteSpace(_destinatario) : !PuedeEnviarWhatsApp))" OnClick="_ => Enviar()">@(VentanaVencida ? "Enviar plantilla con el Excel" : "Enviar Excel")</AlfaButton>
    </Footer>
</AlfaDialog>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private bool _mostrarFiltros = true;
    private bool _ocupado;
    private string _estado = "", _feedback = "", _dialogo = "", _destinatario = "", _busqueda = "";
    private long _conversacion;
    private CierreCajaArchivo? _archivo;
    private IReadOnlyList<ConversacionInboxItemDto> _conversaciones = [];

    private RenderFragment RenderFiltros() => @<div class="smart-search cierre-search" @onclick:stopPropagation>
        <div class="smart-search__bar @(_mostrarFiltros ? "is-open" : string.Empty)">
            <button type="button" class="smart-search__filter-button is-active" title="Filtros del cierre" aria-label="Filtros del cierre" aria-expanded="@_mostrarFiltros" @onclick="ToggleFiltros"><i class="bi bi-funnel-fill"></i></button>
            <div class="smart-search__active-filters" aria-label="Filtros del cierre">
                <button type="button" class="smart-search__active-filter" @onclick="ToggleFiltros"><span>@_filtros.Fecha.ToString("dd/MM/yyyy")</span></button>
                <button type="button" class="smart-search__active-filter" @onclick="ToggleFiltros"><span>@(_filtros.UnidadNegocio.Length == 0 ? "Todas las unidades" : $"Unidad {_filtros.UnidadNegocio}")</span></button>
                <button type="button" class="smart-search__active-filter" @onclick="ToggleFiltros"><span>@(_filtros.Caja.Length == 0 ? "Todas las cajas" : $"Caja {_filtros.Caja}")</span></button>
            </div>
            <button type="button" class="smart-search__toggle" title="Filtros y opciones" aria-label="Filtros y opciones" aria-expanded="@_mostrarFiltros" @onclick="ToggleFiltros"><i class="bi @(_mostrarFiltros ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i></button>
        </div>
        @if (_mostrarFiltros)
        {
            <div class="smart-search__panel cierre-filter-panel">
        <div class="cierre-filtros">
            <div class="field">
                <label for="cierre-fecha">Fecha operativa</label>
                <InputDate id="cierre-fecha" @bind-Value="_filtros.Fecha" @bind-Value:after="CargarCajasAsync" />
            </div>
            <div class="field">
                <label for="cierre-unidad">Unidad de negocio</label>
                <select id="cierre-unidad" @bind="_filtros.UnidadNegocio" @bind:after="CargarCajasAsync" disabled="@_cargandoUnidades">
                    <option value="">Todas las unidades</option>
                    @foreach (var unidad in _unidades)
                    {
                        <option value="@unidad.Codigo">@unidad.Codigo - @unidad.Descripcion</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="cierre-caja">Caja</label>
                <select id="cierre-caja" @bind="_filtros.Caja" @bind:after="UpdateHeader" disabled="@_cargandoCajas">
                    <option value="">Todas las cajas</option>
                    @foreach (var caja in _cajas)
                    {
                        <option value="@caja.Codigo">@caja.Codigo - @caja.Descripcion</option>
                    }
                </select>
            </div>
            <div class="cierre-opciones">
                <label><input type="checkbox" @bind="_filtros.SaldoInicial" @bind:after="UpdateHeader" /> Incluir saldo inicial</label>
                <label><input type="checkbox" @bind="_filtros.Diario" @bind:after="UpdateHeader" /> Diario</label>
                <label><input type="checkbox" @bind="_filtros.Mensual" @bind:after="UpdateHeader" /> Mensual</label>
                <label><input type="checkbox" @bind="_filtros.Cancelados" @bind:after="UpdateHeader" /> Ver comprobantes cancelados</label>
            </div>
            <div class="cierre-opciones">
                <label><input type="checkbox" @bind="_filtros.Productos" @bind:after="UpdateHeader" /> Venta por productos</label>
                <label><input type="checkbox" @bind="_filtros.Rubros" @bind:after="UpdateHeader" /> Detalle por rubro</label>
                <label><input type="checkbox" @bind="_filtros.Ventas" @bind:after="UpdateHeader" /> Detalle de ventas</label>
                <label><input type="checkbox" @bind="_filtros.Cobranzas" @bind:after="UpdateHeader" /> Detalle de cobranzas</label>
            </div>
        </div>
        @if (_cargandoCajas || _cargandoUnidades)
        {
            <p class="cierre-carga" role="status">Leyendo opciones disponibles… Esperá un momento.</p>
        }
        @if (_error is not null || _errorUnidades is not null)
        {
            <p class="editor-msg editor-msg--warning" role="alert">@(_errorUnidades ?? _error)</p>
        }
        @if (!_cargandoCajas && _cajas.Count == 0 && _error is null)
        {
            <p class="text-muted">No hay cajas con movimientos en la fecha seleccionada.</p>
        }

                <div class="smart-search__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-arrow-clockwise" Disabled="@(_cargandoCajas || _cargandoUnidades || _ocupado)" OnClick="_ => Cargar()">Cargar</AlfaButton>
                </div>
            </div>
        }
    </div>;

    // ── WhatsApp con ventana de 24 h vencida: plantilla aprobada con encabezado documento ──────
    private IReadOnlyList<ConversacionPlantillaDto> _plantillasDocumento = [];
    private long _idPlantilla;
    private List<string> _valoresPlantilla = [];
    private bool _cargandoPlantillas;

    private ConversacionInboxItemDto? ConversacionSeleccionada => _conversaciones.FirstOrDefault(c => c.IdConversacion == _conversacion);
    private bool VentanaVencida => _dialogo == "whatsapp" && ConversacionSeleccionada is { VentanaWhatsAppActiva: false };
    private ConversacionPlantillaDto? PlantillaSeleccionada => _plantillasDocumento.FirstOrDefault(p => p.IdPlantilla == _idPlantilla);
    private bool PuedeEnviarWhatsApp => ConversacionSeleccionada is not null
        && (!VentanaVencida || (PlantillaSeleccionada is not null && _valoresPlantilla.All(v => !string.IsNullOrWhiteSpace(v))));

    private string VistaPreviaPlantilla
    {
        get
        {
            var texto = PlantillaSeleccionada?.CuerpoTexto ?? string.Empty;
            for (var i = 0; i < _valoresPlantilla.Count; i++)
            {
                var valor = string.IsNullOrWhiteSpace(_valoresPlantilla[i]) ? $"{{{{{i + 1}}}}}" : _valoresPlantilla[i];
                texto = System.Text.RegularExpressions.Regex.Replace(texto, @"\{\{\s*" + (i + 1) + @"\s*\}\}", valor.Replace("$", "$$"));
            }
            return texto;
        }
    }

    private IReadOnlyList<AlfaSelectOption> OpcionesConversaciones => _conversaciones
        .Select(c => new AlfaSelectOption(c.IdConversacion.ToString(System.Globalization.CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(c.NombreVisible) ? c.TelefonoWhatsApp : $"{c.NombreVisible} · {c.TelefonoWhatsApp}"))
        .ToList();

    private IReadOnlyList<AlfaSelectOption> OpcionesPlantillas => _plantillasDocumento
        .Select(p => new AlfaSelectOption(p.IdPlantilla.ToString(System.Globalization.CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(p.NombreVisible) ? p.NombreMeta : p.NombreVisible))
        .ToList();

    private async Task OnDestinatarioElegidoAsync(string? valor)
    {
        _conversacion = long.TryParse(valor, out var id) ? id : 0;
        await OnConversacionCambiadaAsync();
    }

    private async Task OnPlantillaElegidaAsync(string? valor)
    {
        _idPlantilla = long.TryParse(valor, out var id) ? id : 0;
        await CompletarVariablesAsync();
    }

    private async Task BuscarConEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_ocupado)
            await BuscarConversaciones();
    }

    // Abre Plantillas con el alta precargada (encabezado documento + variables del cierre).
    private void IrACrearPlantilla()
        => Nav.NavigateTo(RouteContext.BuildRoute("/conversaciones/plantillas?nueva=cierre-caja"));

    private async Task OnConversacionCambiadaAsync()
    {
        _plantillasDocumento = [];
        _idPlantilla = 0;
        _valoresPlantilla = [];
        if (!VentanaVencida) return;

        _cargandoPlantillas = true;
        var idConversacion = _conversacion;
        try
        {
            var result = await UiOps.RunAsync(() => Conversaciones.GetTemplatesForConversationAsync(idConversacion, _cts.Token), "No se pudieron leer las plantillas de WhatsApp.");
            if (idConversacion != _conversacion) return;
            if (!result.Success) { _feedback = result.Feedback?.Message ?? "No se pudieron leer las plantillas de WhatsApp."; return; }
            _plantillasDocumento = (result.Value ?? [])
                .Where(p => p.Activa
                    && (p.EsMetaRemota || string.Equals(p.EstadoMeta, "APPROVED", StringComparison.OrdinalIgnoreCase))
                    && WhatsAppTemplateValidation.RequiereDocumento(p)
                    && WhatsAppTemplateValidation.UnsupportedReason(p, documentoDisponible: true).Length == 0)
                .ToList();
            _idPlantilla = _plantillasDocumento.FirstOrDefault()?.IdPlantilla ?? 0;
            await CompletarVariablesAsync();
        }
        finally { _cargandoPlantillas = false; }
    }

    // Prellena las variables BODY. Si la plantilla tiene variables asignadas (Plantillas → Insertar
    // variable), las resuelve el servicio, con "Fecha del cierre" y "Caja del cierre" aportadas desde
    // acá. Sin asignaciones: {{1}} = nombre del contacto y {{2}} = fecha del cierre, el uso más común.
    // Siempre se pueden editar antes de enviar.
    private async Task CompletarVariablesAsync()
    {
        var plantilla = PlantillaSeleccionada;
        var cantidad = plantilla is null ? 0 : System.Text.RegularExpressions.Regex
            .Matches(plantilla.CuerpoTexto, @"\{\{\s*(\d+)\s*\}\}")
            .Select(m => int.Parse(m.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture))
            .DefaultIfEmpty(0).Max();
        var fechaCierre = _consulta?.Fecha.ToString("dd/MM/yyyy") ?? string.Empty;
        _valoresPlantilla = Enumerable.Range(1, cantidad).Select(i => i switch
        {
            1 => ConversacionSeleccionada?.NombreVisible ?? string.Empty,
            2 => fechaCierre,
            _ => string.Empty
        }).ToList();
        if (plantilla is null || plantilla.EsMetaRemota || cantidad == 0) return;

        var idPlantilla = plantilla.IdPlantilla;
        var detalle = await UiOps.RunAsync(() => Conversaciones.GetTemplateAsync(idPlantilla, _cts.Token), "No se pudo leer la plantilla.");
        if (idPlantilla != _idPlantilla || !detalle.Success || detalle.Value is null || detalle.Value.VariableMappings.Count == 0) return;

        var contexto = new Dictionary<string, string>
        {
            [WhatsAppTemplateVariableCatalog.CierreFecha] = fechaCierre,
            [WhatsAppTemplateVariableCatalog.CierreCaja] = _consulta is null || _consulta.Caja.Length == 0 ? "Todas las cajas" : $"Caja {_consulta.Caja}"
        };
        var auto = await UiOps.RunAsync(() => Conversaciones.GetTemplateAutoValuesAsync(_conversacion, idPlantilla, cantidad, contexto, _cts.Token), "No se pudieron completar las variables.");
        if (idPlantilla != _idPlantilla || !auto.Success || auto.Value is null) return;

        // Solo se toman las posiciones con variable asignada; las "manuales" conservan el valor por
        // defecto de arriba (el servicio les aplicaría el heurístico histórico de cobranza).
        var asignadas = detalle.Value.VariableMappings;
        for (var i = 0; i < cantidad; i++)
        {
            if (asignadas.ContainsKey(i + 1))
                _valoresPlantilla[i] = i < auto.Value.Valores.Count ? auto.Value.Valores[i] : string.Empty;
        }
    }

    private void ToggleFiltros() { _mostrarFiltros = !_mostrarFiltros; UpdateHeader(); }
    private void CerrarDialogo() { if (_ocupado) return; _dialogo = ""; _archivo = null; }

    private async Task Preparar(string destino)
    {
        if (_consulta is null || _ocupado) return;
        _ocupado = true; _feedback = ""; _estado = "Preparando Excel completo… Esperá un momento."; UpdateHeader(); StateHasChanged();
        try
        {
            var filtros = _consulta with { };
            var result = await UiOps.RunAsync(() => ExportService.PrepararAsync(filtros, _unidadConsultada, _cts.Token), "No se pudo preparar el Excel.");
            if (!result.Success || result.Value is null) { _feedback = result.Feedback?.Message ?? "No se pudo preparar el Excel."; return; }
            _archivo = result.Value;
            if (destino == "excel")
                await JS.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob", Convert.ToBase64String(_archivo.Contenido), CierreCajaArchivo.Mime, _archivo.Nombre);
            else { _dialogo = destino; _conversacion = 0; _conversaciones = []; _plantillasDocumento = []; _idPlantilla = 0; _valoresPlantilla = []; }
        }
        catch (JSException ex)
        {
            await Events.LogErrorAsync("Cierre de caja", "DescargarExcel", ex, "No se pudo descargar el Excel.", ct: _cts.Token);
            _feedback = "No se pudo descargar el Excel. Intentá nuevamente.";
        }
        finally { _ocupado = false; if (!_cts.IsCancellationRequested) { UpdateHeader(); StateHasChanged(); } }
    }

    private async Task BuscarConversaciones()
    {
        _ocupado = true; _estado = "Buscando conversaciones…"; _feedback = ""; _conversacion = 0; _plantillasDocumento = []; _idPlantilla = 0; _valoresPlantilla = []; UpdateHeader(); StateHasChanged();
        try
        {
            var result = await UiOps.RunAsync(() => Conversaciones.GetInboxAsync(new ConversacionesInboxFilters
            { Modo = "todas", Canal = ConversacionCanales.WhatsApp, Search = _busqueda, Limit = 50,
                UsuarioActual = AppUser.CurrentUser?.UserName, SistemaActual = AppUser.CurrentUser?.SystemCode, ExpectedBaseId = idbase }, _cts.Token), "No se pudieron buscar las conversaciones.");
            _conversaciones = result.Value ?? [];
            if (!result.Success) _feedback = result.Feedback?.Message ?? "No se pudieron buscar las conversaciones.";
            else if (_conversaciones.Count == 0) _feedback = "No hay conversaciones disponibles para esta búsqueda.";
        }
        finally { _ocupado = false; UpdateHeader(); }
    }

    private async Task Enviar()
    {
        if (_ocupado || _archivo is null) return;
        _ocupado = true; _estado = "Enviando Excel…"; _feedback = ""; UpdateHeader(); StateHasChanged();
        try
        {
            if (_dialogo == "email")
            {
                var result = await UiOps.RunAsync(() => ExportService.EnviarEmailAsync(_archivo, _destinatario, _cts.Token), "No se pudo enviar el email.");
                if (!result.Success) { _feedback = result.Feedback?.Message ?? "No se pudo enviar el email."; return; }
                _feedback = "Email enviado con el Excel adjunto.";
            }
            else
            {
                if (!_conversaciones.Any(c => c.IdConversacion == _conversacion)) return;
                if (VentanaVencida)
                {
                    var plantilla = PlantillaSeleccionada;
                    if (plantilla is null) return;
                    var envio = await UiOps.RunAsync(() => Conversaciones.SendTemplateWithDocumentAsync(new ConversacionPlantillaDocumentoSendRequest
                    {
                        IdConversacion = _conversacion, IdPlantilla = plantilla.IdPlantilla, EsMetaRemota = plantilla.EsMetaRemota,
                        ValoresVariables = _valoresPlantilla.Select(v => v.Trim()).ToList(),
                        NombreArchivo = _archivo.Nombre, MimeType = CierreCajaArchivo.Mime, Contenido = _archivo.Contenido,
                        UsuarioAccion = AppUser.CurrentUser?.UserName, SistemaAccion = AppUser.CurrentUser?.SystemCode
                    }, _cts.Token), "No se pudo enviar la plantilla con el Excel.");
                    if (!envio.Success) { _feedback = envio.Feedback?.Message ?? "No se pudo enviar la plantilla con el Excel."; return; }
                    _feedback = "Plantilla enviada con el Excel adjunto. La conversación queda reabierta cuando el contacto responda.";
                    _dialogo = ""; _archivo = null;
                    return;
                }
                using var contenido = new MemoryStream(_archivo.Contenido);
                var result = await UiOps.RunAsync(() => Conversaciones.UploadAttachmentAsync(new ConversacionUploadAdjuntoRequest
                { IdConversacion = _conversacion, NombreArchivo = _archivo.Nombre, MimeType = CierreCajaArchivo.Mime,
                    TipoArchivo = "DOCUMENT", Contenido = contenido, TamanoBytes = contenido.Length,
                    UsuarioAccion = AppUser.CurrentUser?.UserName, SistemaAccion = AppUser.CurrentUser?.SystemCode }, _cts.Token), "No se pudo adjuntar el Excel a WhatsApp.");
                if (!result.Success) { _feedback = result.Feedback?.Message ?? "No se pudo adjuntar el Excel."; return; }
                _feedback = "Excel adjuntado a la conversación de WhatsApp. Revisá allí el estado del envío.";
            }
            _dialogo = ""; _archivo = null;
        }
        finally { _ocupado = false; UpdateHeader(); }
    }

    private CierreCajaFiltros _filtros = new();
    private CierreCajaFiltros? _consulta;
    private IReadOnlyList<CierreCajaOpcion> _cajas = [];
    private IReadOnlyList<CierreCajaOpcion> _unidades = [];
    private string _unidadConsultada = "Todas las unidades";
    private bool _cargandoUnidades;
    private string? _errorUnidades;
    private int _cajasVersion;
    private bool _cargandoCajas;
    private string? _error;
    private int _version;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        UpdateHeader();
        _cargandoUnidades = true;
        var unidades = await UiOps.RunAsync(() => Service.GetUnidadesAsync(_cts.Token), "No se pudieron cargar las unidades de negocio.");
        _cargandoUnidades = false;
        if (unidades.Success && unidades.Value is not null) _unidades = unidades.Value;
        else _errorUnidades = unidades.Feedback?.Message ?? "No se pudieron cargar las unidades de negocio.";
        await CargarCajasAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) UpdateHeader();
    }

    private void UpdateHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        SearchContent = RenderFiltros(),
        Actions = [
            new() { Key = "cargar", Label = "Cargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Primary, Disabled = _ocupado || _cargandoCajas || _cargandoUnidades, OnClick = () => { Cargar(); StateHasChanged(); return Task.CompletedTask; } },
            new() { Key = "excel", Label = "Excel", Icon = "bi-file-earmark-excel", Disabled = _consulta is null || _ocupado, OnClick = () => Preparar("excel") },
            new() { Key = "email", Label = "Email", Icon = "bi-envelope", Disabled = _consulta is null || _ocupado, OnClick = () => Preparar("email") },
            new() { Key = "whatsapp", Label = "WhatsApp", Icon = "bi-whatsapp", Disabled = _consulta is null || _ocupado, OnClick = () => Preparar("whatsapp") }
        ],
        Title = "Cierre de caja", ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "caja-bancos",
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCajaBancos(RouteContext, Nav, "cierre")
    });

    private async Task CargarCajasAsync()
    {
        var fecha = _filtros.Fecha;
        var unidad = _filtros.UnidadNegocio;
        var version = ++_cajasVersion;
        _cargandoCajas = true;
        UpdateHeader();
        _error = null;
        var result = await UiOps.RunAsync(() => Service.GetCajasAsync(fecha, _cts.Token, unidad), "No se pudieron cargar las cajas.");
        if (version != _cajasVersion || _cts.IsCancellationRequested) return;
        _cargandoCajas = false;
        if (result.Success && result.Value is not null)
        {
            _cajas = result.Value;
            if (!_cajas.Any(c => c.Codigo == _filtros.Caja)) _filtros.Caja = string.Empty;
        }
        else _error = result.Feedback?.Message ?? "No se pudieron cargar las cajas.";
        UpdateHeader();
    }

    private void Cargar()
    {
        if (_ocupado || _cargandoCajas || _cargandoUnidades) return;
        _consulta = _filtros with { };
        var unidad = _unidades.FirstOrDefault(u => u.Codigo == _consulta.UnidadNegocio);
        _unidadConsultada = unidad is null ? "Todas las unidades" : $"{unidad.Codigo} - {unidad.Descripcion}";
        _version++;
        _mostrarFiltros = false;
        UpdateHeader();
        StateHasChanged();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }
}
