@page "/conversaciones/informes/detalle/{idDetalle:int}"
@page "/{idweb}/{idbase:int}/conversaciones/informes/detalle/{idDetalle:int}"
@inject AlfaCore.Services.IConversacionesInformesService InformesSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.ISessionService SessionSvc
@inject NavigationManager Nav
@implements IDisposable
@using AlfaCore.Models

<PageTitle>Detalle de informe | Alfa Gestión</PageTitle>

<AlfaNotification Message="@FeedbackMessage" OnDismiss="() => _feedback = null" />

<div class="infdet-page">
    @if (_det is null)
    {
        <ConversacionesConfigPagina Titulo="Detalle de informe">
            <Estado>
                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi-arrow-left" OnClick="Volver">Volver al informe</AlfaButton>
            </Estado>
            <ChildContent>
                <ConversacionesConfigTarjeta>
                    @if (_error is not null)
                    {
                        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudo abrir el detalle" Message="@_error" />
                    }
                    else
                    {
                        <p class="cfg-hint">Cargando…</p>
                    }
                </ConversacionesConfigTarjeta>
            </ChildContent>
        </ConversacionesConfigPagina>
    }
    else
    {
        <ConversacionesConfigPagina Titulo="@_det.Fila.NombreMostrar" Descripcion="@Subtitulo">
            <Estado>
                @if (_det.Fila.EstadoEnvio == "ENVIADO")
                {
                    <AlfaTag Tone="AlfaTagTone.Success">Enviado por @_det.Fila.CanalEnvio.ToLowerInvariant()</AlfaTag>
                }
                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi-arrow-left" OnClick="Volver">Volver al informe</AlfaButton>
            </Estado>
            <ChildContent>
                <section class="infdet-metrics" aria-label="Indicadores del período">
                    <div class="infdet-metric"><strong>@_det.Fila.CantConversaciones</strong><span>conversaciones</span></div>
                    <div class="infdet-metric"><strong>@_det.Fila.CantDias</strong><span>días con actividad</span></div>
                    <div class="infdet-metric"><strong>@_det.Fila.CantMensajes</strong><span>mensajes</span></div>
                    <div class="infdet-metric"><strong>@_det.Fila.HorasTotalesLabel</strong><span>horas</span></div>
                    <div class="infdet-metric"><strong>@_det.Fila.HorasFacturablesLabel</strong><span>horas facturables</span></div>
                </section>

                <ConversacionesConfigTarjeta Titulo="Resumen para el cliente" Descripcion="Se envía el texto que quede acá. Podés generarlo con IA y ajustarlo antes de enviar.">
                    <Extra>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi-stars" Disabled="@_trabajando" OnClick="GenerarAsync">
                            @(string.IsNullOrWhiteSpace(_texto) ? "Generar con IA" : "Regenerar con IA")
                        </AlfaButton>
                    </Extra>
                    <ChildContent>
                        <ConversacionesConfigTexto Id="infdet-resumen" Filas="10"
                                                   Placeholder="Tocá «Generar con IA» para que redacte el resumen del mes, o escribilo vos."
                                                   Value="@_texto" ValueChanged="@((string? v) => _texto = v ?? string.Empty)" />
                        <div class="cfg-actions">
                            <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi-floppy" Loading="@_trabajando"
                                        Disabled="@(_trabajando || string.IsNullOrWhiteSpace(_texto))" OnClick="GuardarAsync">Guardar cambios</AlfaButton>
                        </div>
                    </ChildContent>
                </ConversacionesConfigTarjeta>

                <ConversacionesConfigTarjeta Titulo="Enviar" Descripcion="WhatsApp solo funciona si el cliente escribió en las últimas 24 h; si no, usá email.">
                    <AlfaInput Id="infdet-email" Label="Email del cliente" Type="email" Placeholder="email@cliente.com"
                               Value="@_email" ValueChanged="@((string? v) => _email = v ?? string.Empty)" />
                    <div class="cfg-actions">
                        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi-envelope"
                                    Disabled="@(_trabajando || string.IsNullOrWhiteSpace(_texto))" OnClick="EnviarEmailAsync">Enviar por email</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Secondary" Icon="bi-whatsapp"
                                    Disabled="@(_trabajando || string.IsNullOrWhiteSpace(_texto) || !_det.IdConversacionWhatsApp.HasValue)"
                                    OnClick="EnviarWhatsAppAsync">Enviar por WhatsApp</AlfaButton>
                    </div>
                    @if (!_det.IdConversacionWhatsApp.HasValue)
                    {
                        <p class="cfg-hint">Este cliente no tiene conversación de WhatsApp.</p>
                    }
                </ConversacionesConfigTarjeta>

                @if (_tendencia.Count > 0)
                {
                    <ConversacionesConfigTarjeta Titulo="Evolución de mensajes" Descripcion="Actividad de este cliente en los últimos 12 meses.">
                        <div class="inf-chart" role="img" aria-label="Mensajes por mes de este cliente">
                            @foreach (var t in _tendencia)
                            {
                                var h = _tendenciaMax > 0 ? (int)Math.Round(100.0 * t.CantMensajes / _tendenciaMax) : 0;
                                <div class="inf-chart__col" title="@t.Label: @t.CantMensajes mensajes">
                                    <span class="inf-chart__value">@t.CantMensajes</span>
                                    <div class="inf-chart__bar" style="height:@Math.Max(h, 2)%;"></div>
                                    <span class="inf-chart__label">@t.Label</span>
                                </div>
                            }
                        </div>
                    </ConversacionesConfigTarjeta>
                }
            </ChildContent>
        </ConversacionesConfigPagina>
    }
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse, solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header de la página nueva (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    [Parameter] public int IdDetalle { get; set; }

    private ConversacionInformeDetalleDto? _det;
    private string _texto = string.Empty;
    private string _email = string.Empty;
    private List<ConversacionInformeTendenciaDto> _tendencia = [];
    private int _tendenciaMax;
    private bool _trabajando;
    private string? _error;
    private string? _feedback;
    private bool _feedbackOk;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        // Se reafirma acá (no solo en OnInitialized): si se navega desde otra pantalla AlfaDesign,
        // el Dispose() de esa página anterior -- que hace PageHeader.Clear() -- puede correr DESPUÉS
        // de OnInitialized acá, pisando el header recién seteado. OnAfterRender corre estrictamente
        // después de ese commit de render, así que volver a setearlo acá gana esa carrera de forma
        // confiable (mismo patrón que las demás páginas del módulo).
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader()
    {
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems()
        });
    }

    private IReadOnlyList<PageHeaderTopNavItem> BuildTopNavigationItems()
        =>
        [
            BuildTopNavItem("conversaciones", "Conversaciones", "/conversaciones"),
            BuildTopNavItem("plantillas", "Plantillas", "/conversaciones/plantillas"),
            BuildTopNavItem("configuracion", "Configuración", "/conversaciones/configuracion"),
            BuildTopNavItem("estadisticas", "Estadísticas", "/conversaciones/estadisticas"),
            new() { Key = "informes", Label = "Informes", Url = RouteContext.BuildRoute("/conversaciones/informes"), Active = true }
        ];

    private PageHeaderTopNavItem BuildTopNavItem(string key, string label, string route)
    {
        var url = RouteContext.BuildRoute(route);
        return new PageHeaderTopNavItem
        {
            Key = key,
            Label = label,
            Url = url,
            OnClick = () =>
            {
                Nav.NavigateTo(url);
                return Task.CompletedTask;
            }
        };
    }

    protected override async Task OnParametersSetAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _det = await InformesSvc.GetDetalleAsync(IdDetalle, CurrentExpectedBaseIdOrNull());
            if (_det is null)
            {
                _error = "No se encontró el detalle del informe.";
                return;
            }
            _texto = !string.IsNullOrWhiteSpace(_det.Fila.ResumenEditado) ? _det.Fila.ResumenEditado : _det.Fila.ResumenBorrador;
            _email = _det.ClienteEmail;
            try
            {
                _tendencia = (await InformesSvc.GetTendenciaClienteAsync(IdDetalle, CurrentExpectedBaseIdOrNull())).ToList();
                _tendenciaMax = _tendencia.Count > 0 ? _tendencia.Max(t => t.CantMensajes) : 0;
            }
            catch { _tendencia = []; _tendenciaMax = 0; }
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el detalle: {ex.Message}";
        }
    }

    private async Task GenerarAsync()
    {
        _trabajando = true; _feedback = null; StateHasChanged();
        try
        {
            _texto = await InformesSvc.GenerarResumenAsync(IdDetalle, CurrentExpectedBaseIdOrNull());
            SetFeedback(true, "Resumen generado. Revisalo y ajustalo antes de enviar.");
        }
        catch (Exception ex) { SetFeedback(false, ex.Message); }
        finally { _trabajando = false; }
    }

    private async Task GuardarAsync()
    {
        _trabajando = true; _feedback = null; StateHasChanged();
        try
        {
            await InformesSvc.GuardarResumenEditadoAsync(IdDetalle, _texto, CurrentExpectedBaseIdOrNull());
            SetFeedback(true, "Cambios guardados.");
        }
        catch (Exception ex) { SetFeedback(false, ex.Message); }
        finally { _trabajando = false; }
    }

    private async Task EnviarEmailAsync()
    {
        _trabajando = true; _feedback = null; StateHasChanged();
        try
        {
            await InformesSvc.GuardarResumenEditadoAsync(IdDetalle, _texto, CurrentExpectedBaseIdOrNull());
            await InformesSvc.EnviarPorEmailAsync(IdDetalle, _email, CurrentExpectedBaseIdOrNull());
            await CargarAsync();
            SetFeedback(true, $"Enviado por email a {_email}.");
        }
        catch (Exception ex) { SetFeedback(false, ex.Message); }
        finally { _trabajando = false; }
    }

    private async Task EnviarWhatsAppAsync()
    {
        _trabajando = true; _feedback = null; StateHasChanged();
        try
        {
            await InformesSvc.GuardarResumenEditadoAsync(IdDetalle, _texto, CurrentExpectedBaseIdOrNull());
            await InformesSvc.EnviarPorWhatsAppAsync(IdDetalle, CurrentExpectedBaseIdOrNull());
            await CargarAsync();
            SetFeedback(true, "Enviado por WhatsApp.");
        }
        catch (Exception ex) { SetFeedback(false, ex.Message); }
        finally { _trabajando = false; }
    }

    private void Volver()
    {
        var qs = _det is not null ? $"?anio={_det.Anio}&mes={_det.Mes}" : string.Empty;
        Nav.NavigateTo(idbase.HasValue && !string.IsNullOrEmpty(idweb)
            ? $"/{idweb}/{idbase}/conversaciones/informes{qs}"
            : $"/conversaciones/informes{qs}");
    }

    private void SetFeedback(bool ok, string msg) { _feedbackOk = ok; _feedback = msg; }

    private string Subtitulo
    {
        get
        {
            if (_det is null)
                return string.Empty;

            var partes = new List<string> { $"Período {_det.PeriodoLabel}" };
            if (!string.IsNullOrWhiteSpace(_det.Fila.ClienteCodigo)) partes.Add($"N° {_det.Fila.ClienteCodigo}");
            if (!string.IsNullOrWhiteSpace(_det.Fila.ClasificacionDesc)) partes.Add(_det.Fila.ClasificacionDesc);
            if (!string.IsNullOrWhiteSpace(_det.Fila.CategoriaDesc)) partes.Add(_det.Fila.CategoriaDesc);
            return string.Join(" · ", partes);
        }
    }

    // AlfaNotification detecta un aviso nuevo por referencia: se reutiliza la misma instancia mientras
    // el texto no cambie, para no reiniciar el aviso en cada render.
    private AppUiMessage? _feedbackMessage;

    private AppUiMessage? FeedbackMessage
    {
        get
        {
            if (_feedback is null)
                return _feedbackMessage = null;

            if (_feedbackMessage is null || _feedbackMessage.Message != _feedback
                || (_feedbackMessage.Severity == AppUiFeedbackSeverity.Success) != _feedbackOk)
            {
                _feedbackMessage = new AppUiMessage
                {
                    Severity = _feedbackOk ? AppUiFeedbackSeverity.Success : AppUiFeedbackSeverity.Error,
                    Title = _feedbackOk ? "Listo" : "No se pudo completar",
                    Message = _feedback
                };
            }

            return _feedbackMessage;
        }
    }

    private int? CurrentExpectedBaseIdOrNull()
        => idbase is > 0 ? idbase : SessionSvc.GetActiveSession()?.BaseId;
}
