@* Barra Guardar/Descartar fija al pie de cada pantalla de Configuración. Si la pantalla no lleva
   control de cambios (MostrarEstado = false), Guardar queda habilitado siempre que no esté ocupada. *@

<footer class="cfg-savebar">
    <span class="cfg-savebar__status">
        @if (MostrarEstado)
        {
            @if (HayCambios)
            {
                <i class="bi bi-circle-fill" aria-hidden="true"></i>
                <span>Hay cambios sin guardar</span>
            }
            else
            {
                <span>Sin cambios</span>
            }
        }
    </span>
    @if (OnDescartar.HasDelegate)
    {
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@(Busy || !HayCambios)" OnClick="() => OnDescartar.InvokeAsync()">Descartar</AlfaButton>
    }
    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi-floppy"
                Disabled="@(Busy || (MostrarEstado && !HayCambios))" Loading="@Busy"
                OnClick="() => OnGuardar.InvokeAsync()">@Etiqueta</AlfaButton>
</footer>

@code {
    [Parameter] public string Etiqueta { get; set; } = "Guardar";
    [Parameter] public bool HayCambios { get; set; } = true;
    [Parameter] public bool MostrarEstado { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnGuardar { get; set; }
    [Parameter] public EventCallback OnDescartar { get; set; }
}
