@page "/admin/monitor-clientes"
@page "/{idweb}/{idbase:int}/admin/monitor-clientes"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@using AlfaCore.Services
@implements IDisposable
@inject IAppUserSessionService AppUserSession
@inject IMonitorClientesService MonitorSvc
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav

<PageTitle>Monitor de Clientes | AlfaNet</PageTitle>

@* Administrar → Monitor de Clientes (2026-10-28): estado del sistema legacy de cada cliente. Los datos
   los manda el Timer de cada cliente (POST /api/vb6/monitor-estado); acá solo se muestran, ya evaluados
   con los límites de MON_CONTROL_TIPO / MON_CONTROL_CLIENTE (ALFANET2007). *@

<div class="mon-page">
    <div class="mon">
        <header class="mon__header">
            <div>
                <h2>Monitor de Clientes</h2>
                <p>Estado del sistema de escritorio de cada cliente: envíos y recepciones de puntos de venta, backup, tareas automáticas y certificados ARCA. Se actualiza solo cada minuto.</p>
            </div>
            @if (_tablero is not null)
            {
                <span class="mon__hint">Actualizado @_tablero.FechaHora.ToString("HH:mm:ss", Es)</span>
            }
        </header>

        @if (AppUserSession.CurrentUser?.SuperAdmin != true)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="Acceso restringido" Message="Solo los superadmin pueden ver esta sección." />
        }
        else if (!MonitorSvc.Disponible)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="Sin conexión central" Message="Esta instalación no tiene configurada la conexión a ALFANET2007 (ConnectionStrings:AlfaGestion)." />
        }
        else if (_error is not null && _tablero is null)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudo cargar el monitor" Message="@_error" />
        }
        else if (_tablero is null)
        {
            <p class="mon__hint">Cargando…</p>
        }
        else
        {
            <section class="mon__kpis" aria-label="Resumen">
                <button type="button" class="mon__kpi mon__kpi--critico @(_filtroEstado == "critico" ? "is-active" : null)" @onclick='() => _filtroEstado = "critico"'>
                    <span>Críticos</span>
                    <strong>@Contar(MonitorEstado.Critico)</strong>
                    <small>@ClientesCon(MonitorEstado.Critico)</small>
                </button>
                <button type="button" class="mon__kpi mon__kpi--aviso @(_filtroEstado == "aviso" ? "is-active" : null)" @onclick='() => _filtroEstado = "aviso"'>
                    <span>Avisos</span>
                    <strong>@Contar(MonitorEstado.Aviso)</strong>
                    <small>@ClientesCon(MonitorEstado.Aviso)</small>
                </button>
                <button type="button" class="mon__kpi mon__kpi--sindatos @(_filtroEstado == "sindatos" ? "is-active" : null)" @onclick='() => _filtroEstado = "sindatos"'>
                    <span>Sin datos</span>
                    <strong>@Contar(MonitorEstado.SinDatos)</strong>
                    <small>@ClientesCon(MonitorEstado.SinDatos)</small>
                </button>
                <button type="button" class="mon__kpi mon__kpi--ok @(_filtroEstado == "ok" ? "is-active" : null)" @onclick='() => _filtroEstado = "ok"'>
                    <span>OK</span>
                    <strong>@Contar(MonitorEstado.Ok)</strong>
                    <small>@SistemasReportando sistema(s) reportando</small>
                </button>
            </section>

            <section class="mon__card">
                <div class="mon__filtros">
                    <AlfaSelect Id="mon-estado" Label="Estado" Options="EstadoOptions" Value="@_filtroEstado" ValueChanged="@((string? v) => _filtroEstado = v ?? "problemas")" />
                    <AlfaSelect Id="mon-prioridad" Label="Prioridad" Options="PrioridadOptions" Value="@_filtroPrioridad" ValueChanged="@((string? v) => _filtroPrioridad = v ?? string.Empty)" />
                    <AlfaSelect Id="mon-control" Label="Control" Options="ControlOptions" Value="@_filtroControl" ValueChanged="@((string? v) => _filtroControl = v ?? string.Empty)" />
                    <AlfaInput Id="mon-buscar" Label="Buscar" Placeholder="Cliente, código, base o equipo" Value="@_buscar" ValueChanged="@((string? v) => _buscar = v ?? string.Empty)" />
                </div>

                @if (_error is not null)
                {
                    <p class="mon__hint is-warning">No se pudo actualizar: @_error</p>
                }

                @if (_tablero.Filas.Count == 0)
                {
                    <AlfaEmptyState Title="Todavía no reporta ningún sistema" Message="Los datos aparecen cuando el Timer de un cliente manda su primer reporte a AlfaCore." />
                }
                else if (FilasFiltradas.Count == 0)
                {
                    <AlfaEmptyState Title="@(_filtroEstado == "problemas" ? "Sin problemas" : "Sin resultados")"
                                    Message="@(_filtroEstado == "problemas" ? "Ningún control está en aviso, crítico o sin datos con estos filtros." : "Probá con otros filtros.")" />
                }
                else
                {
                    <div class="mon__table-wrap">
                        <table class="mon__table">
                            <thead>
                                <tr>
                                    <th>Estado</th>
                                    <th>Cliente</th>
                                    <th>Base</th>
                                    <th>Control</th>
                                    <th>Último OK</th>
                                    <th>Detalle</th>
                                    <th>Seguimiento</th>
                                    <th><span class="visually-hidden">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in FilasFiltradas)
                                {
                                    <tr class="mon__row mon__row--@EstadoClase(f.Estado)">
                                        <td class="is-nowrap"><AlfaTag Tone="@EstadoTone(f.Estado)">@EstadoTexto(f.Estado)</AlfaTag></td>
                                        <td>
                                            <div class="mon__cliente">
                                                @if (!string.IsNullOrEmpty(f.PrioridadCodigo))
                                                {
                                                    <span class="mon__prio mon__prio--@PrioridadClase(f.PrioridadCodigo)" title="@($"Prioridad P{f.PrioridadCodigo} · {f.PrioridadDescripcion}")">P@(f.PrioridadCodigo)</span>
                                                }
                                                <span>
                                                    <strong>@f.RazonSocial</strong>
                                                    <small>@f.ClienteCodigo</small>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <span>@f.DbNombre</span>
                                            <small>@f.DbServidor@(string.IsNullOrWhiteSpace(f.HostCliente) ? string.Empty : $" · {f.HostCliente}")</small>
                                        </td>
                                        <td>
                                            <span>@f.TipoNombre</span>
                                            @if (!string.IsNullOrWhiteSpace(f.Destino))
                                            {
                                                <small>@f.Destino</small>
                                            }
                                        </td>
                                        <td class="is-nowrap">
                                            @if (f.EsVencimiento && f.UltimoOk is { } vence)
                                            {
                                                <span title="Fecha de vencimiento">Vence @vence.ToString("dd/MM/yyyy", Es)</span>
                                            }
                                            else if (f.UltimoOk is { } ok)
                                            {
                                                <span>@ok.ToString("dd/MM HH:mm", Es)</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td>
                                            <span>@f.Motivo</span>
                                            @if (!string.IsNullOrWhiteSpace(f.Mensaje))
                                            {
                                                <small>@f.Mensaje</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="mon__seg">
                                                @if (f.Tomado)
                                                {
                                                    <AlfaTag Tone="AlfaTagTone.Accent">Tomado: @f.TomadoPor</AlfaTag>
                                                }
                                                @if (f.Silenciado && f.SilenciadoHasta is { } hasta)
                                                {
                                                    <AlfaTag Tone="AlfaTagTone.Neutral">Silenciado hasta @hasta.ToString("dd/MM HH:mm", Es)</AlfaTag>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(f.Nota))
                                                {
                                                    <small title="@f.Nota">@f.Nota</small>
                                                }
                                            </div>
                                        </td>
                                        <td class="is-nowrap">
                                            @if (f.Estado != MonitorEstado.Ok || f.Tomado || f.Silenciado || !string.IsNullOrWhiteSpace(f.Nota))
                                            {
                                                <AlfaActionMenu Items="@MenuFila(f)" TriggerLabel="Seguimiento" MenuLabel="Seguimiento de la alerta" Disabled="@_guardando" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer class="alfa-data-view-footer">
                        <span class="alfa-data-view-footer__summary">@(FilasFiltradas.Count == 1 ? "1 control" : $"{FilasFiltradas.Count} controles")</span>
                    </footer>
                }
            </section>

            <section class="mon__card mon__avisos" aria-labelledby="mon-avisos-titulo">
                <div class="mon__avisos-head">
                    <div>
                        <h3 id="mon-avisos-titulo">Avisos al chat de soporte</h3>
                        <p class="mon__hint">
                            Un solo mensaje agrupado en el hilo interno <strong>Monitor de Clientes</strong> de Conversaciones, con las alertas críticas
                            que nadie tomó ni silenció. Se manda cuando aparece una nueva, se repite si siguen pendientes y avisa cuando se normalizan.
                        </p>
                    </div>
                    @if (_aviso is not null)
                    {
                        <span class="mon__hint">
                            @(_aviso.UltimoEnvio is { } ue ? $"Último aviso {ue.ToString("dd/MM HH:mm", Es)}" : "Todavía no se mandó ningún aviso")
                            @(_aviso.IdHilo is { } hilo ? $" · hilo #{hilo}" : string.Empty)
                            @(_aviso.Forzar ? " · aviso pedido, sale en el próximo minuto" : string.Empty)
                        </span>
                    }
                </div>

                @if (_aviso is null)
                {
                    <p class="mon__hint">@(_avisoError ?? "Cargando…")</p>
                }
                else
                {
                    <div class="mon__avisos-form">
                        <AlfaCheckbox Value="@_aviso.Activo" ValueChanged="@((bool? v) => _aviso.Activo = v == true)">Avisar al chat de soporte</AlfaCheckbox>
                        <AlfaSelect Id="mon-aviso-prioridad" Label="Clientes" Options="AvisoPrioridadOptions" Value="@_aviso.Prioridades" ValueChanged="@((string? v) => _aviso.Prioridades = v ?? string.Empty)" />
                        <AlfaSelect Id="mon-aviso-repetir" Label="Si siguen pendientes, repetir" Options="RepetirOptions" Value="@_aviso.RepetirMinutos.ToString(System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="@((string? v) => _aviso.RepetirMinutos = int.TryParse(v, out var n) ? n : 120)" />
                        <AlfaInput Id="mon-aviso-push" Label="Además, push a los usuarios" Placeholder="usuario1, usuario2" HelpText="Usuarios de AlfaCore separados por coma. Vacío = sin push." Value="@_aviso.UsuariosPush" ValueChanged="@((string? v) => _aviso.UsuariosPush = v ?? string.Empty)" />
                    </div>
                    @if (_avisoError is not null)
                    {
                        <p class="mon__hint is-warning">@_avisoError</p>
                    }
                    <div class="mon__avisos-acciones">
                        <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi-check2" Loading="@_guardando" Disabled="@_guardando" OnClick="GuardarAvisoAsync">Guardar</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi-send" Disabled="@_guardando" OnClick="AvisarAhoraAsync">Enviar aviso ahora</AlfaButton>
                    </div>
                }
            </section>

            <section class="mon__card" aria-labelledby="mon-act-titulo">
                <div class="mon__avisos-head">
                    <div>
                        <h3 id="mon-act-titulo">Actualizaciones (AlfaActualizacion_Monitor)</h3>
                        <p class="mon__hint">
                            Cada versión se arma y se sube con <code>Herramientas\ArmarActualizacion.py</code> y queda <strong>sin liberar</strong>.
                            El Timer de cada cliente pregunta cada hora y la instala solo en su horario permitido (por defecto de 21 a 7 h).
                            Los clientes de prueba la reciben en cualquier liberación salvo "Nadie (pausada)".
                        </p>
                    </div>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi-arrow-clockwise" Disabled="@_guardando" OnClick="RecargarVersionesAsync">Recargar</AlfaButton>
                </div>

                @if (_versionesError is not null)
                {
                    <p class="mon__hint is-warning">@_versionesError</p>
                }
                @if (_versiones is null)
                {
                    <p class="mon__hint">Cargando…</p>
                }
                else if (_versiones.Count == 0)
                {
                    <AlfaEmptyState Title="Todavía no hay versiones publicadas" Message="Se publican con Herramientas\ArmarActualizacion.py desde la PC de desarrollo." />
                }
                else
                {
                    <div class="mon__table-wrap">
                        <table class="mon__table">
                            <thead>
                                <tr>
                                    <th>Versión</th>
                                    <th>Publicada</th>
                                    <th>Instalada en</th>
                                    <th>Liberar a</th>
                                    <th>Clientes de prueba</th>
                                    <th><span class="visually-hidden">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in _versiones)
                                {
                                    <tr>
                                        <td>
                                            <strong>@v.Version</strong>
                                            <small>@($"{v.TamanioBytes / 1048576.0:0.0} MB")@(string.IsNullOrWhiteSpace(v.Notas) ? string.Empty : $" · {v.Notas}")</small>
                                        </td>
                                        <td class="is-nowrap">
                                            <span>@v.FechaAlta.ToString("dd/MM HH:mm", Es)</span>
                                            @if (v.FechaLiberacion is { } fl)
                                            {
                                                <small>Liberación: @fl.ToString("dd/MM HH:mm", Es) @v.UsuarioLiberacion</small>
                                            }
                                        </td>
                                        <td class="is-nowrap">@(v.Instalaciones == 1 ? "1 sistema" : $"{v.Instalaciones} sistemas")</td>
                                        <td>
                                            <AlfaSelect Id="@($"mon-lib-{v.IdVersion}")" Options="LiberacionOptions" Value="@v.Liberacion" ValueChanged="@((string? x) => v.Liberacion = x ?? MonitorLiberacion.Nadie)" />
                                        </td>
                                        <td>
                                            <AlfaInput Id="@($"mon-prueba-{v.IdVersion}")" Placeholder="112010760, 112010001" Value="@v.ClientesPrueba" ValueChanged="@((string? x) => v.ClientesPrueba = x)" />
                                        </td>
                                        <td class="is-nowrap">
                                            <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi-check2" Disabled="@_guardando" OnClick="() => GuardarLiberacionAsync(v)">Guardar</AlfaButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <details class="mon__help">
                <summary><i class="bi bi-question-circle" aria-hidden="true"></i> Cómo funciona</summary>
                <ol>
                    <li>El Timer de cada cliente manda cada tanto a AlfaCore el último OK de cada control. Si un sistema deja de mandar datos (servidor apagado, Timer cerrado, sin internet), su fila <strong>Reporte del sistema</strong> pasa a aviso o crítico y el resto de sus controles quedan <strong>sin datos</strong>.</li>
                    <li>Límites por defecto:
                        @foreach (var t in _tablero.Tipos.Where(t => t.Activo))
                        {
                            <span class="mon__limite"><strong>@t.Nombre</strong>: @LimiteTexto(t)</span>
                        }
                    </li>
                    <li>Un cliente puede tener límites propios o un control desactivado en <code>MON_CONTROL_CLIENTE</code> (ALFANET2007).</li>
                    <li>La prioridad P1 a P4 es la clasificación del cliente (la misma de Conversaciones).</li>
                    <li>Con el menú de cada fila: <strong>Lo tomo</strong> la saca del aviso al chat; <strong>Silenciar</strong> la saca por un tiempo (por ejemplo, un PDV que se apaga de noche). Cuando el control vuelve a OK, la alerta queda libre sola y la nota se borra.</li>
                </ol>
            </details>
        }
    </div>
</div>

<AlfaDialog Open="@(_notaFila is not null)" Title="Nota de seguimiento" Description="@(_notaFila is null ? null : $"{_notaFila.RazonSocial} · {_notaFila.TipoNombre} {_notaFila.Destino}")"
            Size="AlfaDialogSize.Sm" Loading="@_guardando" OnClose="() => _notaFila = null">
    <ChildContent>
        <AlfaInput Id="mon-nota" Label="Nota" Placeholder="Ej.: hablé con el cliente, reinician el servidor a la tarde" MaxLength="500" Value="@_notaTexto" ValueChanged="@((string? v) => _notaTexto = v ?? string.Empty)" />
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" OnClick="() => _notaFila = null">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Loading="@_guardando" OnClick="GuardarNotaAsync">Guardar</AlfaButton>
    </Footer>
</AlfaDialog>

@code {
    private static readonly System.Globalization.CultureInfo Es = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private static readonly TimeSpan Refresco = TimeSpan.FromMinutes(1);

    private PageHeaderConfig? _pageHeaderPublicado;
    private MonitorTableroDto? _tablero;
    private string? _error;
    private string _filtroEstado = "problemas";
    private string _filtroPrioridad = string.Empty;
    private string _filtroControl = string.Empty;
    private string _buscar = string.Empty;
    private System.Threading.Timer? _timer;
    private bool _cargando;
    private bool _guardando;
    private MonitorAvisoConfigDto? _aviso;
    private string? _avisoError;
    private MonitorFilaDto? _notaFila;
    private string _notaTexto = string.Empty;

    private static readonly IReadOnlyList<AlfaSelectOption> AvisoPrioridadOptions =
    [
        new("1,2", "P1 y P2"),
        new("1", "Solo P1"),
        new("1,2,3", "P1 a P3"),
        new(string.Empty, "Todos")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> RepetirOptions =
    [
        new("60", "Cada 1 h"),
        new("120", "Cada 2 h"),
        new("240", "Cada 4 h"),
        new("480", "Cada 8 h"),
        new("0", "No repetir (solo alertas nuevas)")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> EstadoOptions =
    [
        new("problemas", "Con problemas"),
        new("sintomar", "Críticos y avisos sin tomar"),
        new("critico", "Críticos"),
        new("aviso", "Avisos"),
        new("sindatos", "Sin datos"),
        new("ok", "OK"),
        new("todos", "Todos")
    ];

    private IReadOnlyList<AlfaSelectOption> PrioridadOptions
        => new[] { new AlfaSelectOption(string.Empty, "Todas"), new AlfaSelectOption("1,2", "P1 y P2") }
            .Concat((_tablero?.Filas ?? [])
                .Where(f => !string.IsNullOrEmpty(f.PrioridadCodigo))
                .GroupBy(f => f.PrioridadCodigo)
                .OrderBy(g => int.TryParse(g.Key, out var n) ? n : int.MaxValue)
                .Select(g => new AlfaSelectOption(g.Key, $"P{g.Key} · {g.First().PrioridadDescripcion}")))
            .ToList();

    private IReadOnlyList<AlfaSelectOption> ControlOptions
        => new[] { new AlfaSelectOption(string.Empty, "Todos") }
            .Concat((_tablero?.Tipos ?? []).Where(t => t.Activo).Select(t => new AlfaSelectOption(t.Codigo, t.Nombre)))
            .ToList();

    private IReadOnlyList<MonitorFilaDto> FilasFiltradas
    {
        get
        {
            IEnumerable<MonitorFilaDto> q = _tablero?.Filas ?? [];
            q = _filtroEstado switch
            {
                "sintomar" => q.Where(f => f.Estado is MonitorEstado.Critico or MonitorEstado.Aviso && !f.Tomado && !f.Silenciado),
                "critico" => q.Where(f => f.Estado == MonitorEstado.Critico),
                "aviso" => q.Where(f => f.Estado == MonitorEstado.Aviso),
                "sindatos" => q.Where(f => f.Estado == MonitorEstado.SinDatos),
                "ok" => q.Where(f => f.Estado == MonitorEstado.Ok),
                "todos" => q,
                _ => q.Where(f => f.Estado != MonitorEstado.Ok)
            };
            if (!string.IsNullOrEmpty(_filtroPrioridad))
            {
                var prioridades = _filtroPrioridad.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                q = q.Where(f => prioridades.Contains(f.PrioridadCodigo, StringComparer.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrEmpty(_filtroControl))
                q = q.Where(f => string.Equals(f.TipoCodigo, _filtroControl, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_buscar))
            {
                var t = _buscar.Trim();
                q = q.Where(f => Contiene(f.RazonSocial, t) || Contiene(f.ClienteCodigo, t) || Contiene(f.DbNombre, t)
                    || Contiene(f.DbServidor, t) || Contiene(f.HostCliente, t) || Contiene(f.Destino, t));
            }
            return q.ToList();
        }
    }

    private int SistemasReportando
        => (_tablero?.Filas ?? []).Where(f => f.TipoCodigo == "REPORTE" && f.Estado == MonitorEstado.Ok).Select(f => f.IdOrigen).Distinct().Count();

    private int Contar(MonitorEstado estado) => (_tablero?.Filas ?? []).Count(f => f.Estado == estado);

    private string ClientesCon(MonitorEstado estado)
    {
        var n = (_tablero?.Filas ?? []).Where(f => f.Estado == estado).Select(f => f.ClienteCodigo).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        return n == 1 ? "1 cliente" : $"{n} clientes";
    }

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    protected override async Task OnInitializedAsync()
    {
        if (AppUserSession.CurrentUser?.SuperAdmin != true || !MonitorSvc.Disponible)
            return;

        await CargarAsync();
        _timer = new System.Threading.Timer(_ => _ = InvokeAsync(async () =>
        {
            await CargarAsync();
            StateHasChanged();
        }), null, Refresco, Refresco);
    }

    private async Task CargarAsync()
    {
        if (_cargando)
            return;
        _cargando = true;
        try
        {
            _tablero = await MonitorSvc.GetTableroAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = Texto(ex);
        }

        // La configuración se recarga solo si no se está editando (para no pisar lo que se escribe).
        try
        {
            var aviso = await MonitorSvc.GetAvisoConfigAsync();
            if (_aviso is null)
                _aviso = aviso;
            else
            {
                _aviso.IdHilo = aviso.IdHilo;
                _aviso.UltimoEnvio = aviso.UltimoEnvio;
                _aviso.Forzar = aviso.Forzar;
            }
            _avisoError = null;
        }
        catch (Exception ex)
        {
            _avisoError = Texto(ex);
        }
        finally
        {
            _cargando = false;
        }

        // Las versiones solo se cargan la primera vez (y al guardar o "Recargar"), para no pisar lo que se edita.
        if (_versiones is null)
            await RecargarVersionesAsync();
    }

    private List<MonitorActualizacionDto>? _versiones;
    private string? _versionesError;

    private static readonly IReadOnlyList<AlfaSelectOption> LiberacionOptions =
    [
        new(MonitorLiberacion.Nadie, "Nadie (pausada)"),
        new(MonitorLiberacion.Prueba, "Solo clientes de prueba"),
        new(MonitorLiberacion.P1P2, "P1 y P2"),
        new(MonitorLiberacion.Todos, "Todos")
    ];

    private async Task RecargarVersionesAsync()
    {
        try
        {
            _versiones = (await MonitorSvc.GetActualizacionesAsync()).ToList();
            _versionesError = null;
        }
        catch (Exception ex)
        {
            _versionesError = Texto(ex);
            _versiones ??= [];
        }
    }

    private async Task GuardarLiberacionAsync(MonitorActualizacionDto v)
    {
        if (_guardando)
            return;
        _guardando = true;
        try
        {
            await MonitorSvc.CambiarLiberacionAsync(v.IdVersion, v.Liberacion, v.ClientesPrueba, UsuarioActual);
            _versionesError = null;
            await RecargarVersionesAsync();
        }
        catch (Exception ex)
        {
            _versionesError = Texto(ex);
        }
        finally
        {
            _guardando = false;
        }
    }

    private string UsuarioActual => AppUserSession.CurrentUser?.UserName?.Trim() ?? string.Empty;

    private static string Texto(Exception ex) => ex is AppUserFacingException uf ? uf.UserMessage : ex.Message;

    private IReadOnlyList<AlfaActionMenuItem> MenuFila(MonitorFilaDto f)
    {
        var items = new List<AlfaActionMenuItem>();
        if (f.Tomado)
            items.Add(new AlfaActionMenuItem { Key = "soltar", Label = "Soltar", Icon = "bi bi-person-dash", SecondaryText = $"La tiene {f.TomadoPor}", OnClick = () => SeguimientoAsync(f, tomar: false) });
        else
            items.Add(new AlfaActionMenuItem { Key = "tomar", Label = "Lo tomo", Icon = "bi bi-person-check", OnClick = () => SeguimientoAsync(f, tomar: true) });

        var ahora = DateTime.Now;
        var manana8 = ahora.Date.AddDays(ahora.Hour < 8 ? 0 : 1).AddHours(8);
        items.Add(new AlfaActionMenuItem { Key = "sil1", Label = "Silenciar 1 h", Icon = "bi bi-bell-slash", SeparatorBefore = true, OnClick = () => SeguimientoAsync(f, silenciarHasta: ahora.AddHours(1), cambiarSilencio: true) });
        items.Add(new AlfaActionMenuItem { Key = "sil4", Label = "Silenciar 4 h", Icon = "bi bi-bell-slash", OnClick = () => SeguimientoAsync(f, silenciarHasta: ahora.AddHours(4), cambiarSilencio: true) });
        items.Add(new AlfaActionMenuItem { Key = "sil8", Label = $"Silenciar hasta las 8 ({manana8.ToString("dd/MM", Es)})", Icon = "bi bi-moon", OnClick = () => SeguimientoAsync(f, silenciarHasta: manana8, cambiarSilencio: true) });
        items.Add(new AlfaActionMenuItem { Key = "sil24", Label = "Silenciar 24 h", Icon = "bi bi-bell-slash", OnClick = () => SeguimientoAsync(f, silenciarHasta: ahora.AddHours(24), cambiarSilencio: true) });
        items.Add(new AlfaActionMenuItem { Key = "sil7d", Label = "Silenciar 7 días", Icon = "bi bi-bell-slash", OnClick = () => SeguimientoAsync(f, silenciarHasta: ahora.AddDays(7), cambiarSilencio: true) });
        if (f.Silenciado)
            items.Add(new AlfaActionMenuItem { Key = "nosil", Label = "Quitar silencio", Icon = "bi bi-bell", OnClick = () => SeguimientoAsync(f, silenciarHasta: null, cambiarSilencio: true) });

        items.Add(new AlfaActionMenuItem
        {
            Key = "nota",
            Label = string.IsNullOrWhiteSpace(f.Nota) ? "Agregar nota" : "Editar nota",
            Icon = "bi bi-pencil",
            SeparatorBefore = true,
            OnClick = () =>
            {
                _notaFila = f;
                _notaTexto = f.Nota ?? string.Empty;
                return Task.CompletedTask;
            }
        });
        return items;
    }

    private async Task SeguimientoAsync(MonitorFilaDto f, bool? tomar = null, DateTime? silenciarHasta = null, bool cambiarSilencio = false,
        string? nota = null, bool cambiarNota = false)
    {
        if (_guardando)
            return;
        _guardando = true;
        try
        {
            await MonitorSvc.GuardarSeguimientoAsync(new MonitorSeguimientoRequest
            {
                IdOrigen = f.IdOrigen,
                TipoCodigo = f.TipoCodigo,
                Destino = f.Destino,
                Usuario = UsuarioActual,
                Tomar = tomar,
                SilenciarHasta = silenciarHasta,
                CambiarSilencio = cambiarSilencio,
                Nota = nota,
                CambiarNota = cambiarNota
            });
            _error = null;
        }
        catch (Exception ex)
        {
            _error = Texto(ex);
        }
        finally
        {
            _guardando = false;
        }

        await CargarAsync();
        StateHasChanged();
    }

    private async Task GuardarNotaAsync()
    {
        if (_notaFila is not { } f)
            return;
        await SeguimientoAsync(f, nota: _notaTexto, cambiarNota: true);
        _notaFila = null;
    }

    private async Task GuardarAvisoAsync()
    {
        if (_aviso is null || _guardando)
            return;
        _guardando = true;
        try
        {
            await MonitorSvc.GuardarAvisoConfigAsync(_aviso, UsuarioActual);
            _aviso = await MonitorSvc.GetAvisoConfigAsync();
            _avisoError = null;
        }
        catch (Exception ex)
        {
            _avisoError = Texto(ex);
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task AvisarAhoraAsync()
    {
        if (_aviso is null || _guardando)
            return;
        _guardando = true;
        try
        {
            await MonitorSvc.SolicitarAvisoAhoraAsync(UsuarioActual);
            _aviso.Forzar = true;
            _avisoError = null;
        }
        catch (Exception ex)
        {
            _avisoError = Texto(ex);
        }
        finally
        {
            _guardando = false;
        }
    }

    private static bool Contiene(string? valor, string termino)
        => !string.IsNullOrEmpty(valor) && valor.Contains(termino, StringComparison.CurrentCultureIgnoreCase);

    private static AlfaTagTone EstadoTone(MonitorEstado e) => e switch
    {
        MonitorEstado.Critico => AlfaTagTone.Danger,
        MonitorEstado.Aviso => AlfaTagTone.Warning,
        MonitorEstado.Ok => AlfaTagTone.Success,
        _ => AlfaTagTone.Neutral
    };

    private static string EstadoTexto(MonitorEstado e) => e switch
    {
        MonitorEstado.Critico => "Crítico",
        MonitorEstado.Aviso => "Aviso",
        MonitorEstado.SinDatos => "Sin datos",
        _ => "OK"
    };

    private static string EstadoClase(MonitorEstado e) => e switch
    {
        MonitorEstado.Critico => "critico",
        MonitorEstado.Aviso => "aviso",
        MonitorEstado.SinDatos => "sindatos",
        _ => "ok"
    };

    private static string PrioridadClase(string codigo)
        => codigo is "1" or "2" or "3" or "4" ? codigo : "otra";

    private static string LimiteTexto(MonitorTipoControlDto t)
    {
        if (string.Equals(t.Medida, "RESULTADO", StringComparison.OrdinalIgnoreCase))
            return "error = crítico, advertencia = aviso";
        if (string.Equals(t.Medida, "VENCE", StringComparison.OrdinalIgnoreCase))
        {
            var antes = new List<string>();
            if (t.AvisoMinutos is > 0)
                antes.Add($"aviso {MonitorDuracion(t.AvisoMinutos.Value)} antes de vencer");
            if (t.CriticoMinutos is > 0)
                antes.Add($"crítico {MonitorDuracion(t.CriticoMinutos.Value)} antes");
            antes.Add("vencido = crítico");
            return string.Join(", ", antes);
        }
        var partes = new List<string>();
        if (t.AvisoMinutos is > 0)
            partes.Add($"aviso a las {MonitorDuracion(t.AvisoMinutos.Value)}");
        if (t.CriticoMinutos is > 0)
            partes.Add($"crítico a las {MonitorDuracion(t.CriticoMinutos.Value)}");
        return partes.Count == 0 ? "sin límite" : string.Join(", ", partes);
    }

    private static string MonitorDuracion(int minutos)
        => minutos >= 2880 && minutos % 1440 == 0 ? $"{minutos / 1440} días"
            : minutos % 60 == 0 ? $"{minutos / 60} h"
            : minutos < 60 ? $"{minutos} min"
            : $"{minutos / 60} h {minutos % 60} min";

