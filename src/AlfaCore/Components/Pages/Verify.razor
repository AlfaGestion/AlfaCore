@page "/verify/{Code}"
@layout AlfaCore.Components.Layout.PublicLayout
@using AlfaCore.Models
@using AlfaCore.Services
@using Microsoft.AspNetCore.Components
@inject ICentralRegistrationService RegistrationService
@inject ICentralAdminService AdminService
@inject IPlanesService PlanesSvc

<PageTitle>Verificación | AlfaNet</PageTitle>

<section class="public-verify">
    <div class="public-verify__card">
        @if (_loading)
        {
            <div class="public-verify__state">
                <span class="spinner-border spinner-border-sm"></span>
                <strong>Confirmando tu cuenta...</strong>
                <p>Estamos validando el enlace y preparando el alta.</p>
            </div>
        }
        else
        {
            <div class="public-verify__state">
                <span class="public-verify__icon @(_result?.Success == true ? "is-success" : "is-error")">
                    <i class="bi @(_result?.Success == true ? "bi-check2-circle" : "bi-exclamation-triangle")"></i>
                </span>
                <strong>@GetTitle()</strong>
                <p>@(_result?.Message ?? "No se pudo validar la cuenta.")</p>

                @if (!string.IsNullOrWhiteSpace(_result?.DatabaseName))
                {
                    <div class="public-verify__db">Base asignada: <strong>@_result!.DatabaseName</strong></div>
                }

                @if (!string.IsNullOrWhiteSpace(_result?.IncidentId))
                {
                    <small>Incidente: @_result!.IncidentId</small>
                }

                @if (_result?.Success == true && !_pruebaFinalizada)
                {
                    <div class="modulos">
                        <div class="modulos__intro">
                            <span class="modulos__badge">Probá gratis</span>
                            <h3>Elegí con qué querés arrancar</h3>
                            <p>Activá todos los que quieras probar sin costo — los días de prueba de cada uno dependen del plan que elijas. Te avisamos por email antes de que venza cada prueba; si no la contratás, se desactiva sola, sin sorpresas.</p>
                        </div>

                        @if (_modulosLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else if (_modulos.Count == 0)
                        {
                            <p><em>No hay módulos disponibles para probar en este momento.</em></p>
                        }
                        else
                        {
                            <div class="modulos__grid">
                                @foreach (var modulo in _modulos)
                                {
                                    var info = GetModuloInfo(modulo.Codigo);
                                    var planes = _planesPorModulo.TryGetValue(modulo.Codigo, out var planesModulo) ? planesModulo : [];

                                    if (planes.Count > 0)
                                    {
                                        <div @key="modulo.Id" class="modulo-card modulo-card--planes">
                                            <span class="modulo-card__icon"><i class="bi @info.Icono"></i></span>
                                            <span class="modulo-card__body">
                                                <span class="modulo-card__name">@modulo.Nombre</span>
                                                <span class="modulo-card__desc">@info.Descripcion</span>
                                                <div class="plan-option-list">
                                                    @foreach (var plan in planes)
                                                    {
                                                        var idModuloActual = modulo.Id;
                                                        var idPlanActual = plan.Id;
                                                        var seleccionado = _planesSeleccionados.TryGetValue(idModuloActual, out var idPlanElegido) && idPlanElegido == idPlanActual;
                                                        <label @key="plan.Id" class="plan-option @(seleccionado ? "is-selected" : string.Empty)">
                                                            <input type="radio" name="@($"plan-modulo-{idModuloActual}")" class="plan-option__radio"
                                                                   checked="@seleccionado" @onchange="() => ElegirPlan(idModuloActual, idPlanActual)" />
                                                            <span class="plan-option__body">
                                                                <span class="plan-option__name">@plan.Nombre</span>
                                                                <span class="plan-option__price">@plan.Moneda @plan.Precio.ToString("0.##")@PlanDisplayHelper.FormatPeriodoCorto(plan.TipoFacturacion)</span>
                                                                @if (plan.DiasPrueba > 0)
                                                                {
                                                                    <span class="plan-option__trial"><i class="bi bi-gift-fill"></i> @plan.DiasPrueba días gratis</span>
                                                                }
                                                            </span>
                                                            <span class="plan-option__mark"><i class="bi bi-check-lg"></i></span>
                                                        </label>
                                                    }
                                                    <label class="plan-option plan-option--none @(!_planesSeleccionados.ContainsKey(modulo.Id) ? "is-selected" : string.Empty)">
                                                        <input type="radio" name="@($"plan-modulo-{modulo.Id}")" class="plan-option__radio"
                                                               checked="@(!_planesSeleccionados.ContainsKey(modulo.Id))" @onchange="() => QuitarPlan(modulo.Id)" />
                                                        <span class="plan-option__body">
                                                            <span class="plan-option__name">No, gracias</span>
                                                        </span>
                                                        <span class="plan-option__mark"><i class="bi bi-check-lg"></i></span>
                                                    </label>
                                                </div>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        var seleccionado = _seleccionados.Contains(modulo.Id);
                                        <label @key="modulo.Id" class="modulo-card @(seleccionado ? "is-selected" : string.Empty)">
                                            <input type="checkbox" class="modulo-card__checkbox" checked="@seleccionado"
                                                   @onchange="args => ToggleModulo(modulo.Id, args)" />
                                            <span class="modulo-card__icon"><i class="bi @info.Icono"></i></span>
                                            <span class="modulo-card__body">
                                                <span class="modulo-card__name">@modulo.Nombre</span>
                                                <span class="modulo-card__desc">@info.Descripcion</span>
                                                @if (modulo.Precio > 0)
                                                {
                                                    <span class="modulo-card__price">USD @modulo.Precio.ToString("0.##")/mes después de la prueba</span>
                                                }
                                            </span>
                                            <span class="modulo-card__mark"><i class="bi bi-check-lg"></i></span>
                                        </label>
                                    }
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_pruebaFeedback))
                            {
                                <p class="public-verify__feedback">@_pruebaFeedback</p>
                            }

                            <div class="public-verify__actions">
                                <button type="button" class="btn btn--primary" disabled="@(_pruebaEnCurso || TotalSeleccionados == 0)" @onclick="IniciarPruebaAsync">
                                    @(_pruebaEnCurso ? "Activando..." : TotalSeleccionados == 0 ? "Elegí al menos un módulo" : $"Empezar prueba gratis ({TotalSeleccionados})")
                                </button>
                                <button type="button" class="btn btn--ghost" disabled="@_pruebaEnCurso" @onclick="() => _pruebaFinalizada = true">
                                    Elegir más tarde
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @if (_result?.Success == true && !string.IsNullOrWhiteSpace(_result.ModuloPreactivado))
                    {
                        <div class="public-verify__db">Ya activamos tu prueba de <strong>@_result.ModuloPreactivado</strong>. Iniciá sesión para empezar.</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_pruebaResultMessage))
                    {
                        <div class="public-verify__db">@_pruebaResultMessage</div>
                    }

                    <div class="public-verify__actions">
                        <a href="/login" class="btn btn--primary">Ir al login</a>
                        <a href="/registrarme" class="btn btn--ghost">Nuevo registro</a>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    private bool _loading = true;
    private PublicVerificationResult? _result;

    private bool _modulosLoading;
    private IReadOnlyList<ModuloDto> _modulos = [];
    private readonly HashSet<int> _seleccionados = [];
    /// <summary>Planes reales de cada módulo (ver IPlanesService), agrupados por Código de módulo — un módulo presente acá muestra el selector de planes en vez del checkbox clásico.</summary>
    private IReadOnlyDictionary<string, IReadOnlyList<PlanDto>> _planesPorModulo = new Dictionary<string, IReadOnlyList<PlanDto>>(StringComparer.OrdinalIgnoreCase);
    /// <summary>Plan elegido por módulo (IdModulo -> IdPlan) para los módulos que ya tienen Planes reales.</summary>
    private readonly Dictionary<int, int> _planesSeleccionados = [];
    private bool _pruebaEnCurso;
    private bool _pruebaFinalizada;
    private string? _pruebaFeedback;
    private string? _pruebaResultMessage;

    private int TotalSeleccionados => _seleccionados.Count + _planesSeleccionados.Count;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _result = await RegistrationService.VerifyAsync(Code);
        _loading = false;

        if (_result?.Success == true)
        {
            if (!string.IsNullOrWhiteSpace(_result.ModuloPreactivado))
                _pruebaFinalizada = true;
            else
                await CargarModulosAsync();
        }
    }

    private async Task CargarModulosAsync()
    {
        _modulosLoading = true;

        IReadOnlyList<ModuloDto> catalogoCompleto;
        try
        {
            catalogoCompleto = await AdminService.GetModulosAsync();
        }
        catch
        {
            catalogoCompleto = [];
        }

        try
        {
            _planesPorModulo = await PlanesSvc.GetPlanesVisiblesPorCodigoModuloAsync();
        }
        catch
        {
            // Si dbo.Planes todavía no existe en esta base (migración de Fase 2 sin correr) o
            // falla por cualquier motivo, se cae al comportamiento histórico de checkbox + prueba
            // fija de 30 días para todos los módulos — nunca rompe el selector completo.
            _planesPorModulo = new Dictionary<string, IReadOnlyList<PlanDto>>(StringComparer.OrdinalIgnoreCase);
        }

        // Los módulos base sin costo (Clientes/Técnicos) se activan solos en cascada cuando se
        // elige cualquier módulo que dependa de ellos — no tiene sentido ofrecerlos como opción
        // propia. Un módulo entra al selector si tiene precio de catálogo (flujo histórico) o si
        // ya tiene Planes reales cargados (aunque Modulos.Precio no se haya actualizado).
        _modulos = catalogoCompleto
            .Where(m => m.Precio > 0 || (_planesPorModulo.TryGetValue(m.Codigo, out var planes) && planes.Count > 0))
            .ToArray();

        _modulosLoading = false;
    }

    private void ToggleModulo(int idModulo, ChangeEventArgs args)
    {
        var marcado = args.Value is bool b && b;
        if (marcado)
            _seleccionados.Add(idModulo);
        else
            _seleccionados.Remove(idModulo);
    }

    private void ElegirPlan(int idModulo, int idPlan) => _planesSeleccionados[idModulo] = idPlan;

    private void QuitarPlan(int idModulo) => _planesSeleccionados.Remove(idModulo);

    private async Task IniciarPruebaAsync()
    {
        if (TotalSeleccionados == 0 || _pruebaEnCurso)
            return;

        _pruebaEnCurso = true;
        _pruebaFeedback = null;
        try
        {
            var mensajesError = new List<string>();
            var mensajesOk = new List<string>();

            if (_seleccionados.Count > 0)
            {
                var resultadoModulos = await RegistrationService.IniciarPruebaModulosAsync(Code, _seleccionados.ToArray());
                if (resultadoModulos.Success)
                    mensajesOk.Add(resultadoModulos.Message);
                else
                    mensajesError.Add(resultadoModulos.Message);
            }

            if (_planesSeleccionados.Count > 0)
            {
                var resultadoPlanes = await RegistrationService.ElegirPlanesAsync(Code, _planesSeleccionados.Values.ToArray());
                if (resultadoPlanes.Success)
                    mensajesOk.Add(resultadoPlanes.Message);
                else
                    mensajesError.Add(resultadoPlanes.Message);
            }

            if (mensajesError.Count > 0)
            {
                _pruebaFeedback = string.Join(" ", mensajesError);
            }
            else
            {
                _pruebaResultMessage = string.Join(" ", mensajesOk);
                _pruebaFinalizada = true;
            }
        }
        finally
        {
            _pruebaEnCurso = false;
        }
    }

    private string GetTitle()
        => _result?.Success == true
            ? "Cuenta confirmada"
            : "No se pudo completar la confirmación";

    private sealed record ModuloInfo(string Icono, string Descripcion);

    /// <summary>
    /// Copy pensado para el visitante que se acaba de registrar (beneficio, no ficha técnica) —
    /// distinto de <c>Modulos.Descripcion</c> en la base, que es texto interno para el catálogo
    /// de Administrar.
    /// </summary>
    private static ModuloInfo GetModuloInfo(string codigo) => codigo.ToUpperInvariant() switch
    {
        "CONVERSACIONES" => new("bi-chat-dots-fill", "Todos tus mensajes de WhatsApp, Instagram, Facebook y MercadoLibre en una sola bandeja, sin perder ni un cliente."),
        "TICKETS" => new("bi-ticket-perforated-fill", "Convertí cualquier conversación en un ticket con seguimiento, sin salir del chat."),
        "ALFAKNOWLEDGE" => new("bi-stars", "Un asistente con IA que sugiere la respuesta ideal usando tu propia base de conocimiento."),
        "PARTES_HORAS" => new("bi-clock-history", "Registrá y controlá las horas trabajadas por tu equipo, con reportes listos para facturar."),
        "AUTOMATIZACIONES" => new("bi-lightning-charge-fill", "Respuestas automáticas fuera de horario y mensajes de bienvenida, para no dejar a nadie sin contestar."),
        "LOGISTICA" => new("bi-truck", "Carga y seguimiento de viajes, tarifas de clientes y fleteros, liquidaciones y reportes en un solo lugar."),
        "POS" or "POS - PUNTO DE VENTA" => new("bi-shop", "Punto de venta ágil para mostrador, salón y delivery, con caja y stock integrados."),
        _ => new("bi-puzzle-fill", "Sumá esta función a tu cuenta y probala sin costo por 30 días.")
    };
}
