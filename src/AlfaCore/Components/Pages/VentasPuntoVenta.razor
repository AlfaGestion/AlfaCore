    private static string FmtInputAmount(decimal value)
        => value <= 0 ? string.Empty : value.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static string FmtQuantityInput(decimal value)
        => value <= 0 ? "0" : value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static bool TryParseMoney(string? value, out decimal parsed)
    {
        var normalized = (value ?? string.Empty).Trim();
        if (normalized.Length == 0)
        {
            parsed = 0m;
            return false;
        }

        normalized = normalized.Replace("$", string.Empty).Replace(" ", string.Empty);

        return decimal.TryParse(
                   normalized,
                   System.Globalization.NumberStyles.Number,
                   System.Globalization.CultureInfo.GetCultureInfo("es-AR"),
                   out parsed)
               || decimal.TryParse(
                   normalized.Replace(",", "."),
                   System.Globalization.NumberStyles.Number,
                   System.Globalization.CultureInfo.InvariantCulture,
                   out parsed);
    }

