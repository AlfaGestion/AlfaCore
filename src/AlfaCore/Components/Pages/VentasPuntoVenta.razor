    private string MensajeErrorGrabacionVenta(Exception ex)
    {
        var detalleTecnico = ObtenerDetalleTecnico(ex);
        var detalle = EsTimeoutOperacion(ex)
            ? MensajeTimeoutOperacion(ex)
            : detalleTecnico;
        if (!string.IsNullOrWhiteSpace(_mpUltimaReferenciaAprobada))
        {
            return "El pago de Mercado Pago Point fue aprobado, pero la venta no pudo grabarse todavía. "
                + "No vuelvas a cobrar en la terminal: el pago queda conservado en esta cobranza. "
                + "Presioná Aceptar nuevamente para reintentar solamente la grabación."
                + (string.IsNullOrWhiteSpace(detalle) ? string.Empty : $" Detalle: {detalle}");
        }

        return detalle;
    }

    private static string MensajeErrorPrerequisitoCobro(Exception ex)
    {
        var detalle = ObtenerDetalleTecnico(ex);
        return EsTimeoutOperacion(ex)
            ? "No se inició el cobro con Mercado Pago Point porque ARCA o la base de datos no respondieron dentro del tiempo permitido. Verificá la conexión y el estado de ARCA e intentá nuevamente."
            : detalle;
    }

    private static string MensajeTimeoutOperacion(Exception ex)
    {
        if (EsTimeoutSql(ex))
            return "La base de datos no respondió dentro del tiempo permitido durante la grabación de la factura. Verificá la conexión y que no haya otra operación bloqueando la base antes de reintentar.";

        if (EsTimeoutArca(ex))
            return "ARCA no respondió dentro del tiempo permitido durante la numeración o autorización de la factura. Verificá el ambiente, el certificado y la conexión antes de reintentar.";

        return "La base de datos o ARCA no respondieron dentro del tiempo permitido. Verificá la conexión y el estado de ARCA antes de reintentar.";
    }

    private static bool EsTimeoutSql(Exception ex)
    {
        for (Exception? actual = ex; actual is not null; actual = actual.InnerException)
        {
            if (string.Equals(actual.GetType().Name, "SqlException", StringComparison.OrdinalIgnoreCase)
                && (actual.Message.Contains("timeout", StringComparison.OrdinalIgnoreCase)
                    || actual.Message.Contains("tiempo de espera", StringComparison.OrdinalIgnoreCase)
                    || actual.Message.Contains("operación de espera", StringComparison.OrdinalIgnoreCase)))
                return true;
        }

        return false;
    }

    private static bool EsTimeoutArca(Exception ex)
    {
        for (Exception? actual = ex; actual is not null; actual = actual.InnerException)
        {
            if (actual is TaskCanceledException or TimeoutException)
                return true;

            // Una falla HTTP, un certificado inválido o un rechazo de WSAA/WSFE
            // no necesariamente es un timeout. Si se clasifican por el nombre
            // de la excepción, la pantalla oculta la causa real y siempre muestra
            // el mismo mensaje genérico de demora.
            var mensaje = actual.Message ?? string.Empty;
            if (actual is HttpRequestException
                && (mensaje.Contains("timeout", StringComparison.OrdinalIgnoreCase)
                    || mensaje.Contains("timed out", StringComparison.OrdinalIgnoreCase)
                    || mensaje.Contains("tiempo de espera", StringComparison.OrdinalIgnoreCase)))
                return true;
        }

        return false;
    }

    private static bool EsTimeoutOperacion(Exception ex)
        => EsTimeoutSql(ex)
            || EsTimeoutArca(ex)
            || EsTimeoutOperacion(ObtenerDetalleTecnico(ex));

    private static bool EsTimeoutOperacion(string? detalle)
    {
        var texto = (detalle ?? string.Empty).ToLowerInvariant();
        return texto.Contains("timeout", StringComparison.Ordinal)
            || texto.Contains("tiempo de espera", StringComparison.Ordinal)
            || texto.Contains("operación de espera", StringComparison.Ordinal)
            || texto.Contains("operation wait", StringComparison.Ordinal);
    }

    private static string ObtenerDetalleTecnico(Exception ex)
    {
        var mensajes = new List<string>();
        for (Exception? actual = ex; actual is not null; actual = actual.InnerException)
        {
            var mensaje = actual.Message?.Trim() ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(mensaje)
                && !mensajes.Contains(mensaje, StringComparer.OrdinalIgnoreCase))
            {
                mensajes.Add(mensaje);
            }
        }

        return mensajes.Count == 0
            ? "No se informó un detalle adicional."
            : string.Join(" Detalle: ", mensajes);
    }

    private async Task OpenReceiptModalAsync(
        PuntoVentaSaleResultDto result,
        IReadOnlyList<PuntoVentaCartItemDto> soldItems,
        IReadOnlyList<PuntoVentaPaymentLineDto> soldPayments)
    {
        _lastSaleResult = result;
        _receiptItems.Clear();
        _receiptItems.AddRange(soldItems);
        _receiptPayments.Clear();
        _receiptPayments.AddRange(soldPayments);
        _receiptContext = null;
        _receiptEmail = string.Empty;
        _receiptEmailFeedback = null;
        _receiptEmailError = null;
        _receiptPreviewHtml = null;
        _receiptPreviewError = null;
        _receiptIsReprint = false;
        _receiptIsAnticipo = false;
        _anticipoReceiptData = null;
        _anticipoReceiptPreviewHtml = null;
        _anticipoReceiptPreviewError = null;
        // El comprobante ya está grabado. Abrimos el modal sin esperar consultas
        // complementarias (contexto de email y QR público), así Aceptar termina
        // inmediatamente y esas ayudas se cargan en segundo plano.
        _showReceiptModal = true;
        await InvokeAsync(StateHasChanged);

        var cuentaCliente = !string.IsNullOrEmpty(_cuentaCliente)
            ? _cuentaCliente
            : _settings.CuentaConsumidorFinal;
        var contextoTask = PuntoVentaSvc.GetReceiptContextAsync(cuentaCliente);
        var qrTask = PrepareReceiptPublicQrAsync(result);
        await Task.WhenAll(contextoTask, qrTask);
        _receiptContext = await contextoTask;
        _receiptEmail = _receiptContext.EmailSugerido;
        await InvokeAsync(StateHasChanged);

        // La vista previa del diseñador se carga al final y nunca bloquea la
        // presentación inicial del comprobante recién grabado.
        await LoadReceiptDesignerPreviewAsync();
    }

    private async Task PrepararAnticipoReceiptPreviewAsync(int idCobranza)
    {
        _anticipoReceiptData = null;
        _anticipoReceiptPreviewHtml = null;
        _anticipoReceiptPreviewError = null;

        try
        {
            var receipt = await PuntoVentaSvc.GetReceiptDataAsync(idCobranza);
            _anticipoReceiptData = receipt;
            _anticipoReceiptPreviewHtml = BuildAnticipoReceiptHtml(receipt);
        }
        catch (Exception ex)
        {
            _anticipoReceiptPreviewError = $"No se pudo cargar el recibo de anticipo: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private string BuildAnticipoReceiptHtml(PuntoVentaReceiptDataDto receipt)
    {
        var esA4 = string.Equals(_settings.FormatoReciboAnticipo, PuntoVentaReciboAnticipoFormatoKeys.A4, StringComparison.OrdinalIgnoreCase);
        var total = receipt.Resultado.Total;
        var anticipo = receipt.Pagos.Sum(x => x.Importe);
        var saldo = Math.Max(total - anticipo, 0m);
        var empresa = HtmlEncode(string.IsNullOrWhiteSpace(receipt.Contexto.Empresa) ? "LA NUEVA" : receipt.Contexto.Empresa);
        var pedido = HtmlEncode($"NP {_lastSaleResult?.IdComprobanteTexto ?? "-"}");
        var cobranza = HtmlEncode($"{receipt.Resultado.TipoComprobante} {receipt.Resultado.IdComprobanteTexto}");
        var cliente = HtmlEncode(_cuentaClienteNombre);
        var fechaEntrega = CombinarNpFechaHora()?.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "-";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<!doctype html><html lang='es'><head><meta charset='utf-8'><style>");
        sb.AppendLine(esA4
            ? "@page{size:A4;margin:14mm}body{width:auto;font-size:12px}"
            : "@page{size:80mm auto;margin:0}body{width:80mm;font-size:10.5px}");
        sb.AppendLine("body{margin:0;padding:0;font-family:Arial,sans-serif;color:#111}.ticket{box-sizing:border-box;padding:4mm}.center{text-align:center}.brand{font-size:16px;font-weight:800}.title{margin:5mm 0 3mm;text-align:center;font-weight:800;font-size:14px}.line{border-top:1px dashed #555;margin:3mm 0}.row{display:flex;justify-content:space-between;gap:4mm;margin:2mm 0}.row span{color:#555}.row strong{text-align:right}.total{border-top:1px solid #111;margin-top:4mm;padding-top:3mm;font-size:13px;font-weight:800}.footer{text-align:center;border-top:1px dashed #555;margin-top:6mm;padding-top:3mm;color:#555;font-size:9px}");
        sb.AppendLine("</style></head><body><main class='ticket'>");
        if (_settings.ReciboAnticipoMuestraEmpresa)
            sb.AppendLine($"<div class='center'><div class='brand'>{empresa}</div><div>RECIBO DE ANTICIPO</div></div>");
        else
            sb.AppendLine("<div class='title'>RECIBO DE ANTICIPO</div>");
        sb.AppendLine("<div class='line'></div>");
        if (_settings.ReciboAnticipoMuestraPedido)
        {
            sb.AppendLine($"<div class='row'><span>Pedido</span><strong>{pedido}</strong></div>");
            sb.AppendLine($"<div class='row'><span>Cobranza</span><strong>{cobranza}</strong></div>");
        }
        if (_settings.ReciboAnticipoMuestraCliente)
            sb.AppendLine($"<div class='row'><span>Cliente</span><strong>{(string.IsNullOrWhiteSpace(cliente) ? "-" : cliente)}</strong></div>");
        if (_settings.ReciboAnticipoMuestraImportes)
        {
            sb.AppendLine($"<div class='row'><span>Total del pedido</span><strong>{HtmlEncode(FmtMoney(total))}</strong></div>");
            sb.AppendLine($"<div class='row'><span>Anticipo recibido</span><strong>{HtmlEncode(FmtMoney(anticipo))}</strong></div>");
            sb.AppendLine($"<div class='row total'><span>Saldo pendiente</span><strong>{HtmlEncode(FmtMoney(saldo))}</strong></div>");
        }
        if (_settings.ReciboAnticipoMuestraMediosPago)
            foreach (var pago in receipt.Pagos)
                sb.AppendLine($"<div class='row'><span>{HtmlEncode(pago.DescripcionMedioPago)}</span><strong>{HtmlEncode(FmtMoney(pago.Importe))}</strong></div>");
        if (_settings.ReciboAnticipoMuestraEntrega)
            sb.AppendLine($"<div class='row'><span>Entrega</span><strong>{HtmlEncode(fechaEntrega)}</strong></div>");
        if (_settings.ReciboAnticipoMuestraUsuario)
            sb.AppendLine($"<div class='row'><span>Usuario</span><strong>{HtmlEncode(AppUserSession.GetCurrentUserName(string.Empty))}</strong></div>");
        sb.AppendLine("<div class='footer'>No es un comprobante fiscal<br>Gracias por su compra</div></main></body></html>");
        return sb.ToString();
    }

