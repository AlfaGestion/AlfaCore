    private void AddToCart(PuntoVentaArticleDto article, decimal cantidad = 1m)
    {
        _chargeSuccess = null;
        var existing = _cartItems.FirstOrDefault(x => x.IdArticulo == article.IdArticulo);
        if (existing is not null)
        {
            existing.Cantidad += cantidad;
            return;
        }

        _cartItems.Add(new PuntoVentaCartItemDto
        {
            IdArticulo = article.IdArticulo,
            Descripcion = article.Descripcion,
            Presentacion = article.Presentacion,
            PrecioUnitario = article.PrecioUnitario,
            Cantidad = cantidad,
            TasaIva = article.TasaIva,
            Exento = article.Exento,
            Familia = article.Familia
        });
    }

    private void ChangeQty(string idArticulo, decimal delta)
    {
        var item = _cartItems.FirstOrDefault(x => x.IdArticulo == idArticulo);
