    private static string ConstruirTicketProduccion(PuntoVentaNpAnticiposDto np)
    {
        var sb = new System.Text.StringBuilder();
        var entrega = np.FechaEntrega?.ToString("dd/MM/yyyy HH:mm") ?? "A coordinar";
        sb.AppendLine("<!doctype html><html><head><meta charset='utf-8'><title>Ticket de producción</title>");
        sb.AppendLine("<style>body{font-family:Arial,sans-serif;width:72mm;margin:0;padding:4mm;color:#111}h1{font-size:18px;margin:0 0 4px}h2{font-size:13px;border-bottom:1px solid #111;padding-bottom:3px}p{font-size:11px;margin:3px 0}.line{border-bottom:1px dashed #777;padding:5px 0}.qty{font-size:16px;font-weight:700;margin-right:6px}.obs{font-size:10px;font-style:italic;margin-top:2px}.foot{font-size:10px;margin-top:8px}</style></head><body>");
        sb.AppendLine($"<h1>PRODUCCIÓN · NP {HtmlEncode(np.IdComprobante)}</h1>");
        sb.AppendLine($"<p><b>Cliente:</b> {HtmlEncode(DisplayValueOrDash(np.Cliente))}</p>");
        sb.AppendLine($"<p><b>Entrega:</b> {HtmlEncode(entrega)}</p>");
        if (!string.IsNullOrWhiteSpace(np.Observaciones))
            sb.AppendLine($"<p><b>Observaciones:</b> {HtmlEncode(np.Observaciones)}</p>");
        sb.AppendLine("<h2>Artículos</h2>");
        foreach (var item in np.Items)
        {
            var pendiente = Math.Max(item.Cantidad - item.CantidadPreparada, 0m);
            sb.AppendLine($"<div class='line'><span class='qty'>{FmtQty(pendiente)}</span>{HtmlEncode(item.Descripcion)}");
            if (!string.IsNullOrWhiteSpace(item.Presentacion))
                sb.Append($"<p>{HtmlEncode(item.Presentacion)}</p>");
            if (!string.IsNullOrWhiteSpace(item.Observaciones))
                sb.Append($"<div class='obs'>{HtmlEncode(item.Observaciones)}</div>");
            sb.AppendLine("</div>");
        }
        sb.AppendLine($"<p class=\"foot\">Impreso: {DateTime.Now:dd/MM/yyyy HH:mm} · Sin información financiera</p></body></html>");
        return sb.ToString();
    }

