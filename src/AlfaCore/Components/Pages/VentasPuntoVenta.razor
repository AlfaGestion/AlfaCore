    private async Task ConfirmManualArticleAsync()
    {
        var article = _manualArticlePending;
        var descripcion = _manualArticleDescription.Trim();
        if (article is null)
            return;

        if (descripcion.Length == 0)
        {
            _manualArticleError = "Ingresá la descripción del artículo.";
            return;
        }

        if (!TryParseMoney(_manualArticlePriceInput, out var precio) || precio <= 0m)
        {
            _manualArticleError = "Ingresá un precio unitario válido mayor que cero.";
            return;
        }

        var manualArticle = new PuntoVentaArticleDto
        {
            IdArticulo = article.IdArticulo,
            CodigoBarra = article.CodigoBarra,
            Descripcion = descripcion,
            Presentacion = article.Presentacion,
            Procedencia = article.Procedencia,
            IdFamilia = article.IdFamilia,
            Familia = article.Familia,
            IdUnidad = article.IdUnidad,
            PrecioUnitario = decimal.Round(precio, 2),
            TasaIva = article.TasaIva,
            Exento = article.Exento,
            NoControlaStock = article.NoControlaStock,
            Pesable = article.Pesable,
            RutaImagen = article.RutaImagen
        };
        var cantidad = _manualArticlePendingQuantity;
        CloseManualArticleModal();

        if (cantidad < 0m && RequiereClaveCancelar())
        {
            AbrirModalClaveCancelar(
                "Cantidad negativa",
                "Ingresá la clave para cargar una cantidad negativa.",
                () =>
                {
                    AddToCartCore(manualArticle, cantidad);
                    return Task.CompletedTask;
                });
        }
        else
        {
            AddToCartCore(manualArticle, cantidad);
        }

        await Task.CompletedTask;
    }

