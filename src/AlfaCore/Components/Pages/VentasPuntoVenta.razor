    private IReadOnlyList<PuntoVentaPaymentMethodDto> PaymentMethodsFiltrados
    {
        get
        {
            IEnumerable<PuntoVentaPaymentMethodDto> methods = _paymentMethods;
            if (_settings.CobranzaPFSoloEfectivo
                && _tipoComprobanteSeleccionado.Trim().ToUpperInvariant() is "FP" or "NCFP")
            {
                methods = methods.Where(IsCashPaymentMethod);
            }

            var texto = _paymentMethodCodeFilter.Trim();
            if (texto.Length > 0)
            {
                methods = methods.Where(x =>
                    (x.Codigo ?? string.Empty).Contains(texto, StringComparison.OrdinalIgnoreCase)
                    || (x.CodigoOpcional ?? string.Empty).Contains(texto, StringComparison.OrdinalIgnoreCase)
                    || (x.Descripcion ?? string.Empty).Contains(texto, StringComparison.OrdinalIgnoreCase));
            }

            return methods.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            _context = await PuntoVentaSvc.GetContextAsync();
            await CargarComprobantesAutorizadosAsync();
            _tipoComprobanteSeleccionado = _context.TipoComprobanteDefault.ToUpperInvariant() switch
            {
                "NC" => "NC",
                "FP" when _context.UsaProforma && _context.VerProformaUsuario => "FP",
                "NCFP" when _context.UsaProforma && _context.VerProformaUsuario => "NCFP",
                _ => "FC"
            };
            if (!UsuarioTieneComprobante(_tipoComprobanteSeleccionado))
                _tipoComprobanteSeleccionado = PrimerComprobanteHabilitado();
            _settings = await PuntoVentaSvc.GetSettingsAsync();
            try
            {
                _mpCodigoMedioPago = await MpConfigSvc.ResolveCodigoMedioPagoAsync();
                _mpMediosConfigurados = await MpConfigSvc.ResolveMediosConfiguradosAsync();
                var mpConfig = await MpConfigSvc.GetConfiguracionAsync();
                _mpObtenerMedioAutomatico = mpConfig.ObtenerMedioPagoAutomatico;
                _mpModoPrueba = mpConfig.ModoPrueba;
            }
            catch { /* Sin Mercado Pago Point configurado, ningún medio de pago dispara el cobro real. */ }
            _idPuntoVentaActual = IdPuntoVentaQuery ?? 0;

            if (IdPuntoVentaQuery is > 0)
            {
                var puntoVenta = await PosConfigSvc.GetPuntoVentaByIdAsync(IdPuntoVentaQuery.Value);
                AplicarConfiguracionIngresoRapido(puntoVenta);
                _puntoVentaModo = string.IsNullOrWhiteSpace(puntoVenta?.Modo)
                    ? PuntoVentaModoKeys.Mostrador
                    : puntoVenta!.Modo.Trim().ToUpperInvariant();
                _puntoVentaNombre = string.IsNullOrWhiteSpace(puntoVenta?.Nombre)
                    ? null
                    : puntoVenta!.Nombre.Trim();
                _puntoVentaSucursal = string.IsNullOrWhiteSpace(puntoVenta?.Sucursal)
                    ? null
                    : puntoVenta!.Sucursal.Trim();
            }

            if (IdPedidoQuery is > 0)
            {
                _pedidoContexto = await PedidoSvc.GetPedidoByIdAsync(IdPedidoQuery.Value);
                if (_pedidoContexto is null)
                {
                    _pedidoError = "No se encontró el pedido indicado.";
                }
                else
                {
                    // La lista/clase de precio y los rubros salen del punto de venta del pedido.
                    _idPuntoVentaActual = _pedidoContexto.IdPuntoVenta;
                    // El carrito es un estado compartido por circuito (no por pedido):
                    // se limpia y se repuebla con los ítems ya guardados del pedido para
                    // no arrastrar un carrito de otra sesión de Mostrador.
                    CartState.Clear();
                    var itemsACargar = _pedidoContexto.Items;
                    if (EsPedidoSalon)
                    {
                        _salonTotalCargado = _pedidoContexto.Items.Sum(i => i.Subtotal);
                        // Al cobrar una mesa se agrupan las rondas (mismo artículo y precio) en una sola línea;
                        // al agregar, el carrito arranca vacío.
                        itemsACargar = EsCierrePedido
                            ? _pedidoContexto.Items
                                .GroupBy(i => new { IdArticulo = i.IdArticulo.Trim(), i.Precio, i.TasaIva, i.Exento })
                                .Select(g => new PuntoVentaPedidoItemDto
                                {
                                    IdArticulo = g.Key.IdArticulo,
                                    Descripcion = g.First().Descripcion,
                                    Presentacion = g.First().Presentacion,
                                    Precio = g.Key.Precio,
                                    Cantidad = g.Sum(x => x.Cantidad),
                                    TasaIva = g.Key.TasaIva,
                                    Exento = g.Key.Exento,
                                    Familia = g.First().Familia
                                })
                                .ToList()
                            : [];
                    }

                    foreach (var item in itemsACargar)
                    {
                        _cartItems.Add(new PuntoVentaCartItemDto
                        {
                            IdArticulo = item.IdArticulo,
                            Descripcion = item.Descripcion,
                            Presentacion = item.Presentacion,
                            PrecioUnitario = item.Precio,
                            Cantidad = item.Cantidad,
                            TasaIva = item.TasaIva,
                            Exento = item.Exento,
                            Familia = item.Familia,
                            Observaciones = item.Observaciones
                        });
                    }

                    if (!string.IsNullOrWhiteSpace(_pedidoContexto.IdCliente))
                    {
                        _cuentaCliente = _pedidoContexto.IdCliente;
                        _cuentaClienteNombre = _pedidoContexto.NombreCliente;
                        await RecalculateCartPricesAsync();
                    }

                    var puntoVentaPedido = await PosConfigSvc.GetPuntoVentaByIdAsync(_pedidoContexto.IdPuntoVenta);
                    AplicarConfiguracionIngresoRapido(puntoVentaPedido);
                    _puntoVentaModo = string.IsNullOrWhiteSpace(puntoVentaPedido?.Modo)
                        ? PuntoVentaModoKeys.Mostrador
                        : puntoVentaPedido!.Modo.Trim().ToUpperInvariant();
                    _puntoVentaNombre = string.IsNullOrWhiteSpace(puntoVentaPedido?.Nombre)
                        ? null
                        : puntoVentaPedido!.Nombre.Trim();
                    _puntoVentaSucursal = string.IsNullOrWhiteSpace(puntoVentaPedido?.Sucursal)
                        ? null
                        : puntoVentaPedido!.Sucursal.Trim();
                    _pedidoSucursalOverride = string.IsNullOrWhiteSpace(puntoVentaPedido?.Sucursal) ? null : puntoVentaPedido!.Sucursal;
                }
            }

            _idPuntoVentaActual = _pedidoContexto?.IdPuntoVenta ?? IdPuntoVentaQuery ?? 0;
            _familias = await PuntoVentaSvc.GetFamiliasAsync();
            _rubros = await PuntoVentaSvc.GetRubrosAsync(_idPuntoVentaActual);
            // Igual que el catálogo gráfico de VB6: si existe una lista Top configurada,
            // se muestra al entrar al POS sin obligar al vendedor a volver a elegir el filtro.
            // La lista es global legacy (GOUR_TOPVTAS), por eso solo se usa como valor inicial;
            // después el vendedor puede cambiar a Todos o a cualquier rubro.
            try
            {
                _topConfigurado = await PosConfigSvc.GetTopArticulosAsync();
                _topConfiguradoCount = await PosConfigSvc.GetTopArticulosConfiguradosCountAsync();
                if (_topConfiguradoCount > 0 && string.IsNullOrWhiteSpace(_filters.IdRubro))
                    _filters.IdRubro = PuntoVentaCatalogoKeys.Top;
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "No se pudo leer GOUR_TOPVTAS para el filtro inicial del catálogo.");
            }
            await LoadCatalogAsync();

            _idCajaActual = _context?.CajaActual ?? string.Empty;
            if (_idPuntoVentaActual > 0 && !string.IsNullOrWhiteSpace(_idCajaActual))
            {
                _turnoActual = await TurnoSvc.GetTurnoAbiertoAsync(_idPuntoVentaActual, _idCajaActual);
                _denominaciones = await TurnoSvc.GetDenominacionesAsync();
                if (_turnoActual is null)
                {
                    try { _fondoSugerido = await TurnoSvc.GetFondoSugeridoAsync(_idPuntoVentaActual, _idCajaActual); }
                    catch { _fondoSugerido = null; }
                }
            }

            // El cobro de una mesa/pedido y las acciones de caja pedidas desde el salón se abren
            // recién acá: necesitan el turno de caja ya cargado.
            if (_pedidoContexto is not null && EsCierrePedido)
            {
                if (_idPuntoVentaActual > 0 && _turnoActual is null)
                    AbrirModalApertura();
                else
                    await OpenChargeModalAsync();
            }
            else if (_pedidoContexto is null && DesdeSalon && !string.IsNullOrWhiteSpace(AccionCajaQuery))
            {
                await AbrirAccionCajaAsync(AccionCajaQuery);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GuardarPedidoDesdeCarritoAsync()
    {
        if (_pedidoContexto is null)
            return;

        _pedidoError = null;
        var items = _cartItems.Select(x => new PuntoVentaPedidoItemDto
        {
            IdArticulo = x.IdArticulo,
            Descripcion = x.Descripcion,
            Presentacion = x.Presentacion,
            Precio = x.PrecioUnitario,
            Cantidad = x.Cantidad,
            TasaIva = x.TasaIva,
            Exento = x.Exento,
            Familia = x.Familia
        }).ToList();

        if (EsPedidoSalon)
        {
            try
            {
                await SalonSvc.AgregarItemsAsync(_pedidoContexto.Id, items, enviar: true, PuntoVentaSalonOrigenKeys.Mozo, AppUserSession.GetCurrentUserName(string.Empty));
                CartState.Clear();
                Nav.NavigateTo(RouteCtx.BuildRoute($"{RutaSalon}&idPedido={_pedidoContexto.Id}"));
            }
            catch (Exception ex)
            {
                _pedidoError = ex.Message;
            }
            return;
        }

        var request = new PuntoVentaPedidoSaveRequest
        {
            Id = _pedidoContexto.Id,
            IdPuntoVenta = _pedidoContexto.IdPuntoVenta,
            Modalidad = _pedidoContexto.Modalidad,
            IdCliente = _pedidoContexto.IdCliente,
            NombreCliente = _pedidoContexto.NombreCliente,
            Telefono = _pedidoContexto.Telefono,
            Direccion = _pedidoContexto.Direccion,
            Fecha = _pedidoContexto.Fecha,
            HorarioProgramado = _pedidoContexto.HorarioProgramado,
            Observaciones = _pedidoContexto.Observaciones,
            Items = items,
            UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty)
        };

        try
        {
            await PedidoSvc.SavePedidoAsync(request);
            CartState.Clear();
            Nav.NavigateTo(RouteCtx.BuildRoute($"/ventas/delivery?idPuntoVenta={_pedidoContexto.IdPuntoVenta}"));
        }
        catch (Exception ex)
        {
            _pedidoError = ex.Message;
        }
    }

    private bool _confirmarVolverPedido;

    /// <summary>Vuelve al salón (o al tablero de pedidos) sin grabar; si hay artículos cargados, pide confirmación.</summary>
    private void VolverDePedido(bool confirmado)
    {
        if (_pedidoContexto is null)
            return;
        if (!confirmado && !EsCierrePedido && _cartItems.Count > 0)
        {
            _confirmarVolverPedido = true;
            return;
        }

        _confirmarVolverPedido = false;
        CartState.Clear();
        Nav.NavigateTo(RouteCtx.BuildRoute(EsPedidoSalon
            ? $"{RutaSalon}&idPedido={_pedidoContexto.Id}"
            : $"/ventas/delivery?idPuntoVenta={_pedidoContexto.IdPuntoVenta}"));
    }

    private string GetPedidoContextoTexto()
    {
        if (_pedidoContexto is null)
            return string.Empty;

        if (EsPedidoSalon)
        {
            var mesa = _pedidoContexto.NombreCliente;
            return EsCierrePedido
                ? $"Cobrar {mesa}"
                : $"{mesa} · ya cargado {FmtMoney(_salonTotalCargado)} · lo que agregues se envía a cocina/barra";
        }

        var modalidad =_pedidoContexto.Modalidad == PuntoVentaPedidoModalidadKeys.Delivery ? "Delivery" : "Take Away";
        var partes = new List<string> { $"Pedido {modalidad}", _pedidoContexto.NombreCliente };
        if (!string.IsNullOrWhiteSpace(_pedidoContexto.Direccion))
            partes.Add(_pedidoContexto.Direccion);
        if (_pedidoContexto.HorarioProgramado.HasValue)
            partes.Add(_pedidoContexto.HorarioProgramado.Value.ToString("dd/MM HH:mm"));

        return string.Join(" · ", partes);
    }

    private static int ParseIntSafe(object? value) => int.TryParse(value?.ToString(), out var n) ? n : 0;

    private void AbrirModalApertura()
    {
        _aperturaSaldoInicial = Math.Round(_fondoSugerido ?? 0, 2);
        _aperturaObservaciones = string.Empty;
        _aperturaCantidades = _denominaciones.ToDictionary(d => d.Id, _ => 0);
        _aperturaError = null;
        _showAperturaModal = true;
    }

    private void CerrarModalApertura() => _showAperturaModal = false;

    private int GetAperturaCantidad(int idDenominacion) => _aperturaCantidades.TryGetValue(idDenominacion, out var c) ? c : 0;

    private void SetAperturaCantidad(int idDenominacion, int cantidad)
    {
        _aperturaCantidades[idDenominacion] = Math.Max(0, cantidad);
        // Si se usa la grilla de billetes, el total contado manda sobre el saldo inicial.
        // Si no se toca la grilla, el campo queda libre para escribir el importe a mano.
        _aperturaSaldoInicial = AperturaTotalBilletes();
    }

    private decimal AperturaTotalBilletes() => _denominaciones.Sum(d => GetAperturaCantidad(d.Id) * d.Valor);

    private async Task ConfirmarAperturaAsync()
    {
        _aperturaError = null;
        try
        {
            _aperturaSaving = true;
            var request = new PuntoVentaTurnoAperturaRequest
            {
                IdPuntoVenta = _idPuntoVentaActual,
                IdCaja = _idCajaActual,
                SaldoInicial = _aperturaSaldoInicial,
                Observaciones = _aperturaObservaciones,
                UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty),
                Billetes = _aperturaCantidades
                    .Where(kv => kv.Value > 0)
                    .Select(kv => new PuntoVentaTurnoBilleteDetalleRequest { IdDenominacion = kv.Key, Cantidad = kv.Value })
                    .ToList()
            };

            var idTurno = await TurnoSvc.AbrirTurnoAsync(request);
            _turnoActual = await TurnoSvc.GetTurnoByIdAsync(idTurno);
            _showAperturaModal = false;
            _chargeError = null;
            if (_pedidoContexto is not null && EsCierrePedido && _cartItems.Any())
                await OpenChargeModalAsync();
        }
        catch (AlfaCore.Services.AppValidationException vex)
