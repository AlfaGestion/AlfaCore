    private async Task ConfirmChargeAsync(bool imprimir = false)
    {
        _chargeError = null;
        _chargeSuccess = null;

        // El atajo F2 llama esto directo (además de los botones, que ya se deshabilitan con
        // _mpCobrando) -- sin este chequeo, F2 podría confirmar la venta mientras todavía se está
        // esperando el resultado del cobro con Mercado Pago Point.
        if (_mpCobrando)
        {
            _chargeError = "Esperando el resultado del cobro con Mercado Pago Point...";
            return;
        }

        if (!_cartItems.Any())
        {
            _chargeError = "No hay artículos en el carrito para cobrar.";
            return;
        }

        if (EsRemitoONotaPedido && _npCargarAnticipoInput)
        {
            // Una seña precargada no reemplaza el importe que el operador acaba
            // de escribir para completar el saldo. Si hay importe en el campo y
            // todavía no existe un pago nuevo, se agrega automáticamente al grabar.
            if (!_paymentLines.Any(x => !x.EsAnticipo) && TryParseMoney(_chargeAmountInput, out var importePendiente) && importePendiente > 0m)
                await AddSelectedPaymentAsync(focusFilterAfterAdd: false);

            if (!_paymentLines.Any(x => !x.EsAnticipo) && !_paymentLines.Any(x => x.EsAnticipo))
            {
                if (string.IsNullOrWhiteSpace(_chargeError))
                    _chargeError = "Seleccioná un medio de pago e ingresá el importe del anticipo.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(_chargeError))
                return;
        }

        // Remito interno (RM) y Nota de pedido (NP) quedan pendientes de facturar: no piden medio de
        // pago (ver EsRemitoONotaPedido / PuntoVentaService.CreateSaleAsync), así que se salta toda la
        // validación de cobro y se confirma directo con el carrito.
        if (!EsRemitoONotaPedido)
        {
            // Si todavía no hay líneas cargadas, aprovechamos el medio seleccionado
            // y el importe del formulario. Así ACEPTAR y ACEPTAR E IMPRIMIR también
            // funcionan como una carga rápida del primer medio de pago.
            if (!_paymentLines.Any(x => !x.EsAnticipo)
                && PendienteCobro > 0.01m
                && TryParseMoney(_chargeAmountInput, out var importeCompletar)
                && importeCompletar > 0m)
                await AddSelectedPaymentAsync(focusFilterAfterAdd: false);

            if (!_paymentLines.Any(x => !x.EsAnticipo) && PendienteCobro > 0.01m)
            {
                if (string.IsNullOrWhiteSpace(_chargeError))
                    _chargeError = "Seleccioná un medio de pago e ingresá un importe válido.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(_chargeError))
                return;

            if (PendienteCobro > 0.01m)
            {
                _chargeError = "El total cobrado debe cubrir al menos el total del carrito.";
                return;
            }
        }

        if (_idPuntoVentaActual > 0 && _turnoActual is null)
        {
            _chargeError = "No hay un turno de caja abierto para este punto de venta. Abrí la caja antes de cobrar.";
            return;
        }

        try
        {
            _chargeSaving = true;
            _arcaEnvironmentLabel = "SERVICIO WEB";
            _chargeProgress = EsComprobanteFiscalSeleccionado()
                ? "Conectando con el servicio web de ARCA..."
                : "Guardando el comprobante...";
            await InvokeAsync(StateHasChanged);
            var soldItems = _cartItems
                .Select(x => new PuntoVentaCartItemDto
                {
                    OrigenLineaId = x.OrigenLineaId,
                    IdArticulo = x.IdArticulo,
                    Descripcion = x.Descripcion,
                    Presentacion = x.Presentacion,
                    PrecioUnitario = x.PrecioUnitario,
                    PrecioOriginal = x.PrecioOriginal,
                    EsPrecioOferta = x.EsPrecioOferta,
                    Cantidad = x.Cantidad,
                    TasaIva = x.TasaIva,
                    Exento = x.Exento,
                    Familia = x.Familia,
                    Observaciones = x.Observaciones
                })
                .ToList();

            var soldPayments = _paymentLines
                .Select(x => new PuntoVentaPaymentLineDto
                {
                    CodigoMedioPago = x.CodigoMedioPago,
                    DescripcionMedioPago = x.DescripcionMedioPago,
                    Observaciones = x.Observaciones,
                    Recargo = x.Recargo,
                    Importe = x.Importe,
                    EsAnticipo = x.EsAnticipo,
                    IdCobranzaAnticipo = x.IdCobranzaAnticipo,
                    ComprobanteAnticipo = x.ComprobanteAnticipo
                })
                .ToList();

            var saleRequest = new PuntoVentaSaleRequestDto
            {
                IdNotaPedidoEdicion = _editandoNotaPedidoId,
                CuentaCliente = !string.IsNullOrEmpty(_cuentaCliente) ? _cuentaCliente : _settings.CuentaConsumidorFinal,
                ClienteEventual = _clienteEventual is null
                    ? null
                    : new PuntoVentaClienteEventualDto
                    {
                        RazonSocial = _clienteEventual.RazonSocial,
                        DocumentoTipo = _clienteEventual.DocumentoTipoCodigo,
                        NumeroDocumento = _clienteEventual.NumeroDocumento,
                        Domicilio = _clienteEventual.Calle,
                        Localidad = _clienteEventual.Localidad,
                        Provincia = _clienteEventual.ProvinciaCodigo,
                        CodigoPostal = _clienteEventual.CodigoPostal,
                        CondicionIva = _clienteEventual.IvaCodigo
                    },
                Fecha = DateTime.Today,
                FechaEntrega = EsRemitoONotaPedido ? CombinarNpFechaHora() : null,
                NombreContacto = EsRemitoONotaPedido ? _npNombreContactoInput.Trim() : string.Empty,
                TelefonoContacto = EsRemitoONotaPedido ? _npTelefonoInput.Trim() : string.Empty,
                DocumentoContacto = EsRemitoONotaPedido ? _npDocumentoContactoInput.Trim() : string.Empty,
                EsEntregaADomicilio = EsRemitoONotaPedido && _npEntregaADomicilioInput,
                DomicilioEntrega = EsRemitoONotaPedido ? _npDomicilioEntregaInput.Trim() : string.Empty,
                LocalidadEntrega = EsRemitoONotaPedido ? _npLocalidadEntregaInput.Trim() : string.Empty,
                TipoComprobante = _tipoComprobanteSeleccionado,
                // La sucursal del punto seleccionado tiene prioridad. La configuración
                // general se usa dentro del servicio únicamente si el punto no tiene una.
                Sucursal = _pedidoSucursalOverride ?? _puntoVentaSucursal ?? string.Empty,
                Items = soldItems,
                Observaciones = string.Join(" | ", new[]
                {
                    EsRemitoONotaPedido ? _npObservacionesInput.Trim() : string.Empty,
                    string.Join(" | ", soldPayments.Where(x => x.Recargo > 0).Select(x => $"Recargo Point: {FmtMoney(x.Recargo)}"))
                }.Where(x => !string.IsNullOrWhiteSpace(x))),
                Pagos = soldPayments,
                IdNotaPedidoOrigen = _facturandoNotaPedidoId,
                ComprobanteNotaPedidoOrigen = _facturandoNotaPedidoComprobante,
                IdCobranzaAnticipo = soldPayments.FirstOrDefault(x => x.EsAnticipo)?.IdCobranzaAnticipo ?? 0,
                ComprobanteCobranzaAnticipo = soldPayments.FirstOrDefault(x => x.EsAnticipo)?.ComprobanteAnticipo ?? string.Empty,
                ImporteAnticipo = soldPayments.Where(x => x.EsAnticipo).Sum(x => x.Importe),
                Progreso = ActualizarProgresoGrabacion
            };

            if (_editandoNotaPedidoId is > 0)
            {
                await PuntoVentaSvc.ActualizarNotaPedidoAsync(saleRequest);
                _chargeSuccess = $"Nota de pedido { _facturandoNotaPedidoComprobante } actualizada correctamente.";
                _cartItems.Clear();
                _paymentLines.Clear();
                _editandoNotaPedidoId = null;
                _showChargeModal = false;
                return;
            }

            var result = await PuntoVentaSvc.CreateSaleAsync(saleRequest);

            _lastSaleResult = result;

            if (_mpUltimaReferenciaAprobada is not null)
            {
                try { await MpPaymentSvc.VincularComprobanteAsync(_mpUltimaReferenciaAprobada, result.IdComprobante); }
                catch (Exception ex) { Logger.LogWarning(ex, "No se pudo vincular la orden de Mercado Pago Point al comprobante {IdComprobante}.", result.IdComprobante); }
                finally { _mpUltimaReferenciaAprobada = null; }
            }

            if (_turnoActual is not null)
            {
                try
                {
                    var importeEfectivo = soldPayments
                        .Where(p => string.Equals(
                            _paymentMethods.FirstOrDefault(m => m.Codigo == p.CodigoMedioPago)?.MedioDePago?.Trim(),
                            "EF", StringComparison.OrdinalIgnoreCase))
                        .Sum(p => p.Importe);

                    await TurnoSvc.RegistrarMovimientoAsync(_turnoActual.Id, result.TipoComprobante, result.IdComprobanteTexto, result.Total, importeEfectivo);
                }
                catch (Exception ex)
                {
                    _pedidoError = $"La venta se registró pero no se pudo actualizar el turno de caja: {ex.Message}";
                }
            }

            if (_pedidoContexto is not null)
            {
                try
                {
                    await PedidoSvc.MarcarFacturadoAsync(_pedidoContexto.Id, result.TipoComprobante, result.IdComprobanteTexto, AppUserSession.GetCurrentUserName(string.Empty));
                }
                catch (Exception ex)
                {
                    _pedidoError = $"La venta se registró pero no se pudo actualizar el pedido: {ex.Message}";
                }
            }

            var mensajeRegistro = result.IdCobranza > 0
                && string.Equals(_tipoComprobanteSeleccionado.Trim(), "NP", StringComparison.OrdinalIgnoreCase)
                ? $"Nota de pedido registrada: {result.TipoComprobante} {result.Sucursal}-{result.Numero}{result.Letra} · anticipo CBCT registrado · total {FmtMoney(result.Total)}."
                : $"Venta registrada: {result.TipoComprobante} {result.Sucursal}-{result.Numero}{result.Letra} · total {FmtMoney(result.Total)}.";
            ShowChargeSuccess(mensajeRegistro);
            _cartItems.Clear();
            _paymentLines.Clear();
            _facturandoNotaPedidoId = null;
            _facturandoNotaPedidoComprobante = string.Empty;
            // Después de grabar, una nueva venta móvil debe comenzar en la
            // carga de artículos y no quedar detrás del recibo en cobranza.
            _mobileCartView = false;
            _mobileScrollToTop = true;
            _showChargeModal = false;
            var receiptItems = soldItems
                .Concat(soldPayments
                    .Where(x => x.Recargo > 0)
                    .Select(x => new PuntoVentaCartItemDto
                    {
                        IdArticulo = "RECARGO-TARJETA",
                        Descripcion = string.IsNullOrWhiteSpace(x.Observaciones) ? "Recargo tarjeta" : x.Observaciones,
                        PrecioUnitario = x.Recargo,
                        Cantidad = 1m,
                        TasaIva = _settings.RecargoTarjetaSinIva ? 0m : ResolverTasaIvaRecargo(soldItems),
                        NoGravado = _settings.RecargoTarjetaSinIva
                    }))
                .ToList();
            var tieneAnticipoRegistrado = EsRemitoONotaPedido
                && string.Equals(result.TipoComprobante.Trim(), "NP", StringComparison.OrdinalIgnoreCase)
                && result.IdCobranza > 0;

            await OpenReceiptModalAsync(result, receiptItems, soldPayments);
            if (tieneAnticipoRegistrado)
                await PrepararAnticipoReceiptPreviewAsync(result.IdCobranza);
            // La próxima venta debe iniciar nuevamente con Consumidor Final.
            // Se hace después de preparar el comprobante para no alterar el cliente
            // de la venta recién grabada.
            await SetClienteConsumidorFinal();
            if (imprimir)
            {
                _closeReceiptAfterPrint = true;
                _printReceiptAfterRender = true;
            }
        }
        catch (Exception ex)
        {
            _chargeError = MensajeErrorGrabacionVenta(ex);
        }
        finally
        {
            _chargeSaving = false;
            _chargeProgress = "Preparando la grabación...";
        }
    }

    private async Task ActualizarProgresoGrabacion(string mensaje)
    {
        _chargeProgress = mensaje;
        if (mensaje.Contains("modo PRODUCCIÓN", StringComparison.OrdinalIgnoreCase))
            _arcaEnvironmentLabel = "MODO PRODUCCIÓN";
        else if (mensaje.Contains("modo PRUEBA", StringComparison.OrdinalIgnoreCase)
            || mensaje.Contains("HOMOLOGACIÓN", StringComparison.OrdinalIgnoreCase))
            _arcaEnvironmentLabel = "MODO PRUEBA / HOMOLOGACIÓN";
        await InvokeAsync(StateHasChanged);
    }

