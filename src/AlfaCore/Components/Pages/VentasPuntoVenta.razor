    private void AddToCartCore(PuntoVentaArticleDto article, decimal cantidad = 1m)
    {
        _chargeSuccess = null;
        var existing = _cartItems.FirstOrDefault(x => x.IdArticulo == article.IdArticulo
            && string.IsNullOrWhiteSpace(x.Observaciones));
        if (existing is not null)
        {
            existing.Cantidad += cantidad;
            _cartScrollToIndex = _cartItems.IndexOf(existing);
            return;
        }

        _cartScrollToIndex = _cartItems.Count;
        _cartItems.Add(new PuntoVentaCartItemDto
        {
            IdArticulo = article.IdArticulo,
            Descripcion = article.Descripcion,
            Presentacion = article.Presentacion,
            PrecioUnitario = article.PrecioUnitario,
            PrecioOriginal = article.PrecioOriginal,
            EsPrecioOferta = article.EsPrecioOferta,
            Cantidad = cantidad,
            TasaIva = article.TasaIva,
            Exento = article.Exento,
            Familia = article.Familia
        });
    }

