    private async Task PrepareReceiptPublicQrAsync(PuntoVentaSaleResultDto result)
    {
        _receiptPublicQrDataUrl = null;
        _receiptPublicUrl = null;

        // El POS también puede abrirse por la ruta corta. En ese caso los parámetros de la
        // ruta no existen, pero la sesión y el usuario ya contienen el contexto SaaS.
        var effectiveIdWeb = idweb?.Trim();
        var effectiveIdBase = idbase ?? SessionSvc.GetActiveSession()?.BaseId;
        if (string.IsNullOrWhiteSpace(effectiveIdWeb))
            effectiveIdWeb = AppUserSession.CurrentUser?.IdWeb?.Trim();

        if (string.IsNullOrWhiteSpace(effectiveIdWeb) || !effectiveIdBase.HasValue || effectiveIdBase.Value <= 0 || result.IdComprobante <= 0)
            return;

        try
        {
            var link = await PublicLinkSvc.GetOrCreateAsync(
                effectiveIdWeb,
                effectiveIdBase.Value,
                PublicLinkTipos.Comprobante,
                result.IdComprobante,
                result.TipoComprobante);

            _receiptPublicUrl = $"{Nav.BaseUri.TrimEnd('/')}/{Uri.EscapeDataString(effectiveIdWeb)}/comprobante/{link.RouteSegment}?tc={Uri.EscapeDataString(result.TipoComprobante)}";
            using var generator = new QRCodeGenerator();
            using var qr = generator.CreateQrCode(_receiptPublicUrl, QRCodeGenerator.ECCLevel.M);
            using var png = new PngByteQRCode(qr);
            _receiptPublicQrDataUrl = $"data:image/png;base64,{Convert.ToBase64String(png.GetGraphic(8))}";
        }
        catch (Exception ex)
        {
            // El QR es complementario: si la base central no está disponible, no se bloquea
            // la visualización ni la impresión del comprobante.
            Logger.LogWarning(ex, "No se pudo preparar el QR público del comprobante {Tipo} {Id}.", result.TipoComprobante, result.IdComprobante);
        }
    }

