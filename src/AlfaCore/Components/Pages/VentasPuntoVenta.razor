        }
    }
    /* Tamaño y distribución por PC (wwwroot/js/pos-layout.js). Las variables viven en el elemento html:
       --pos-tile-scale (botones), --pos-cart-width (carrito), --pos-rubros-alto / --pos-rubros-ancho.
       Sin valores guardados, todo queda igual que el layout definitivo de arriba. */
    .pos-catalog { position: relative; }

    .pos-catalog__search { grid-template-columns: minmax(0, 1fr) auto auto; }

    .pos-catalog__body {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .pos-catalog__body > .pos-catalog__rubros {
        flex: 0 0 auto;
        max-height: var(--pos-rubros-alto, 150px);
        padding: 0.35rem 0.7rem;
        background: rgba(10, 20, 35, 0.72);
        box-sizing: border-box;
    }

    html[data-theme="light"] .pos-catalog__body > .pos-catalog__rubros { background: var(--color-panel); }

    .pos-split {
        flex: 0 0 auto;
        background: var(--color-border);
        touch-action: none;
        transition: background-color .12s ease;
    }

    .pos-split:hover,
    .pos-split.is-dragging { background: var(--color-primary); }

    .pos-split--rubros { height: 6px; cursor: row-resize; }

    .pos-split--carrito {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 3;
        width: 6px;
        background: transparent;
        cursor: col-resize;
    }

    html.pos-arrastrando,
    html.pos-arrastrando * { user-select: none !important; }
    html.pos-arrastrando .pos-split--rubros { cursor: inherit; }

    /* Rubros al costado: columna a la izquierda de los artículos. */
    html[data-pos-rubros="costado"] .pos-catalog__body { flex-direction: row; }

    html[data-pos-rubros="costado"] .pos-catalog__body > .pos-catalog__rubros {
        width: var(--pos-rubros-ancho, 170px);
        max-height: none;
        height: 100%;
        grid-template-columns: repeat(auto-fill, minmax(95px, 1fr));
    }

    html[data-pos-rubros="costado"] .pos-split--rubros { width: 6px; height: auto; cursor: col-resize; }
    html[data-pos-rubros="costado"] .pos-catalog__articles { flex: 1 1 auto; }

    /* Ancho del carrito elegido a mano (solo en pantallas con carrito y catálogo lado a lado). */
    @@media (min-width: 961px) {
        html[data-pos-cart="custom"] .pos-stage,
        html[data-pos-cart="custom"] .pos-stage.pos-stage--quick {
            grid-template-columns: var(--pos-cart-width) minmax(0, 1fr);
        }
    }

    @@media (max-width: 960px) {
        .pos-split { display: none; }
    }

    /* Tamaño de los botones de artículos. */
    .pos-catalog__articles .pos-grid {
        grid-template-columns: repeat(auto-fill, minmax(calc(112px * var(--pos-tile-scale, 1)), 1fr));
        gap: calc(5px * var(--pos-tile-scale, 1));
    }

    .pos-catalog__articles .pos-product {
        grid-template-rows: calc(64px * var(--pos-tile-scale, 1)) calc(60px * var(--pos-tile-scale, 1));
        min-height: calc(124px * var(--pos-tile-scale, 1)) !important;
        height: calc(124px * var(--pos-tile-scale, 1));
        max-height: calc(124px * var(--pos-tile-scale, 1));
    }

    .pos-catalog__articles .pos-product__text strong { font-size: calc(0.7rem * var(--pos-tile-scale, 1)); }

    .pos-catalog__articles .pos-product__price {
        min-height: calc(1.35rem * var(--pos-tile-scale, 1));
        font-size: calc(0.67rem * var(--pos-tile-scale, 1));
    }

    .pos-catalog__articles .pos-product__fallback { font-size: calc(1.45rem * var(--pos-tile-scale, 1)); }

    /* Panel "Tamaño y distribución". */
    .pos-layout { position: relative; display: flex; }

    .pos-layout__toggle {
        min-width: 2.5rem;
        min-height: 2.5rem;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-panel);
        color: var(--color-text);
        font-size: 1.05rem;
        cursor: pointer;
    }

    .pos-layout__toggle:hover,
    .pos-layout__toggle.is-open { border-color: var(--color-primary); color: var(--color-primary); }

    .pos-layout__backdrop { position: fixed; inset: 0; z-index: 40; }

    .pos-layout__panel {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        z-index: 41;
        display: grid;
        gap: 0.55rem;
        width: 300px;
        padding: 0.85rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: var(--color-panel-strong, var(--color-panel));
        color: var(--color-text);
        box-shadow: 0 16px 40px rgba(0, 0, 0, .35);
    }

    .pos-layout__panel header { display: grid; gap: 0.1rem; }
    .pos-layout__panel header small,
    .pos-layout__hint { color: var(--color-muted); font-size: 0.78rem; margin: 0; }
    .pos-layout__label { font-size: 0.8rem; font-weight: 700; color: var(--color-muted); margin: 0.2rem 0 0; }

    .pos-layout__size { display: grid; grid-template-columns: auto minmax(0, 1fr) auto 3rem; align-items: center; gap: 0.45rem; }
    .pos-layout__size input[type="range"] { width: 100%; accent-color: var(--color-primary); }
    .pos-layout__size output { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }

    .pos-layout__size button,
    .pos-layout__seg button,
    .pos-layout__reset {
        min-height: 2.4rem;
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-panel);
        color: var(--color-text);
        font-weight: 700;
        cursor: pointer;
    }

    .pos-layout__seg { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }

    html:not([data-pos-rubros="costado"]) .pos-layout__seg [data-pos-layout="rubros-arriba"],
    html[data-pos-rubros="costado"] .pos-layout__seg [data-pos-layout="rubros-costado"] {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: #fff;
    }

    .pos-layout__reset { justify-self: start; background: transparent; }
</style>

<script>
    window.alfaPosPrintFrame = function (frameId) {
        const frame = document.getElementById(frameId);
        if (frame && frame.contentWindow) {
            frame.contentWindow.focus();
            frame.contentWindow.print();
        }
    };

    // Impresión directa (sin el diálogo del navegador): frame.contentWindow.print() ya alcanza --
    // solo hace falta que la PC de la caja abra Chrome/Edge con el flag --kiosk-printing (imprime
    // directo a la impresora predeterminada de Windows con la configuración por defecto, sin diálogo).
    // No requiere ningún cambio de código acá; es config del lado del sistema operativo de cada caja.
    // Pendiente para cuando haya más de una impresora por caja (ej.: A4 para Factura A/B + térmica
    // para tickets): eso sí requeriría un agente de impresión local, no solo el flag de Chrome.
    window.alfaPosPrintHtml = function (frameId, html) {
        const frame = document.getElementById(frameId);
        if (!frame || !frame.contentWindow) {
            return Promise.resolve(false);
        }

        const doc = frame.contentWindow.document;
        doc.open();
        doc.write(html || "");
        doc.close();

        return new Promise(resolve => {
            window.setTimeout(() => {
                frame.contentWindow.focus();
                frame.contentWindow.print();
                resolve(true);
            }, 180);
        });
    };

    window.alfaPosPrintPdfBytes = function (frameId, base64Pdf) {
        const frame = document.getElementById(frameId);
        if (!frame) {
            return;
        }

        try {
            const binary = atob(base64Pdf);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                bytes[i] = binary.charCodeAt(i);
            }
            const blob = new Blob([bytes], { type: "application/pdf" });
            const url = URL.createObjectURL(blob);

            frame.onload = function () {
                window.setTimeout(() => {
                    try {
                        frame.contentWindow.focus();
                        frame.contentWindow.print();
                    } catch (e) {
                        // El visor de PDF nativo del navegador puede tardar en quedar listo --
                        // si print() falla acá, igual queda el PDF cargado en el iframe para
                        // que el usuario lo imprima manualmente (Ctrl+P) o lo abra aparte.
                    }
                }, 300);
            };
            frame.src = url;
        } catch (e) {
            console.error("alfaPosPrintPdfBytes", e);
        }
    };

    window.alfaPosCatalogNearBottom = function (element) {
        if (!element) {
            return false;
        }

        return (element.scrollTop + element.clientHeight) >= (element.scrollHeight - 120);
    };

    window.alfaPosCatalogNeedsMore = function (element) {
        if (!element) {
            return false;
        }

        return element.scrollHeight <= element.clientHeight + 1;
    };

    window.alfaPosScrollCartTo = function (container, index) {
        if (!container) {
            return;
        }

        var lines = container.querySelectorAll('.pos-line');
        var target = index >= 0 && index < lines.length ? lines[index] : lines[lines.length - 1];
        if (target) {
            target.scrollIntoView({ block: 'nearest' });
        } else {
            container.scrollTop = container.scrollHeight;
        }
    };

    window.alfaPosScrollToTop = function (element) {
        if (element) {
            element.scrollTop = 0;
        }
    };

    window.alfaPosFocusSelect = function (element) {
        if (!element) {
            return;
        }

        element.focus();
        element.select();
    };

    window.alfaPosFocusPaymentMethodList = function (element) {
        if (!element) {
            return;
        }

        const firstButton = element.querySelector("button");
        (firstButton || element).focus();
    };

    window.alfaPosRegisterShortcuts = function () {
        window.alfaPosUnregisterShortcuts();
        window._alfaPosShortcutHandler = function (event) {
            if (event.key === "Escape" && !event.repeat) {
                event.preventDefault();
                event.stopPropagation();
                const trigger = document.getElementById("pos-escape-shortcut-trigger");
                if (trigger) {
                    trigger.click();
                }
                return;
            }

            if (event.ctrlKey && (event.key === "f" || event.key === "F")) {
                event.preventDefault();
                event.stopPropagation();
                const trigger = document.getElementById("pos-arca-shortcut-trigger");
                if (trigger) {
                    trigger.click();
                }
                return;
            }

            if (!event.ctrlKey && !event.altKey && !event.metaKey && event.key === "F5") {
                event.preventDefault();
                event.stopPropagation();
                const trigger = document.getElementById("pos-clients-shortcut-trigger");
                if (trigger) {
                    trigger.click();
                }
                return;
            }

            if (!event.ctrlKey && !event.altKey && !event.metaKey && event.key === "F9") {
                event.preventDefault();
                event.stopPropagation();
                const trigger = document.getElementById("pos-orders-shortcut-trigger");
                if (trigger) {
                    trigger.click();
                }
                return;
            }

            if (event.ctrlKey && !event.altKey && !event.metaKey) {
                const comprobanteTriggers = {
                    a: "pos-comprobante-fc-shortcut-trigger",
                    n: "pos-comprobante-nc-shortcut-trigger",
                    c: "pos-comprobante-fp-shortcut-trigger",
                    o: "pos-comprobante-np-shortcut-trigger",
                    e: "pos-comprobante-rm-shortcut-trigger"
                };
                const triggerId = comprobanteTriggers[event.key.toLowerCase()];
                if (triggerId) {
                    event.preventDefault();
                    event.stopPropagation();
                    const trigger = document.getElementById(triggerId);
                    if (trigger) trigger.click();
                    return;
                }
            }

            if (event.ctrlKey && (event.key === "b" || event.key === "B")) {
                event.preventDefault();
                event.stopPropagation();
                const trigger = document.getElementById("pos-clear-cart-shortcut-trigger");
                if (trigger) {
                    trigger.click();
                }
                return;
            }

            if (event.ctrlKey && (event.key === "g" || event.key === "G")) {
                event.preventDefault();
                event.stopPropagation();
                const trigger = document.getElementById("pos-save-shortcut-trigger");
                if (trigger) {
                    trigger.click();
                }
                return;
            }

            if (event.ctrlKey && (event.key === "p" || event.key === "P")) {
                event.preventDefault();
                event.stopPropagation();
                const trigger = document.getElementById("pos-reprint-shortcut-trigger");
                if (trigger) {
                    trigger.click();
                }
            }
        };
        document.addEventListener("keydown", window._alfaPosShortcutHandler, true);
    };

    window.alfaPosUnregisterShortcuts = function () {
        if (window._alfaPosShortcutHandler) {
            document.removeEventListener("keydown", window._alfaPosShortcutHandler, true);
            window._alfaPosShortcutHandler = null;
        }
    };
</script>

<section class="pos-shell">
    @if (_cargandoNpEnPos)
    {
        <div class="pos-np-loading-overlay" role="status" aria-live="polite">
            <div class="pos-np-loading"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cargando nota de pedido...</div>
        </div>
    }
    <button id="pos-reprint-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick="OpenReprintModalAsync" tabindex="-1" aria-hidden="true"></button>
    <button id="pos-arca-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick="HandleArcaShortcutAsync" tabindex="-1" aria-hidden="true"></button>
    <button id="pos-clients-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick="HandleClientsShortcutAsync" tabindex="-1" aria-hidden="true"></button>
    <button id="pos-orders-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick="OpenNpAnticiposModalAsync" tabindex="-1" aria-hidden="true"></button>
    <button id="pos-comprobante-fc-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick='() => SeleccionarTipoComprobante("FC")' tabindex="-1" aria-hidden="true"></button>
    <button id="pos-comprobante-nc-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick='() => SeleccionarTipoComprobante("NC")' tabindex="-1" aria-hidden="true"></button>
    <button id="pos-comprobante-fp-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick='() => SeleccionarTipoComprobante("FP")' tabindex="-1" aria-hidden="true"></button>
    <button id="pos-comprobante-np-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick='() => SeleccionarTipoComprobante("NP")' tabindex="-1" aria-hidden="true"></button>
    <button id="pos-comprobante-rm-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick='() => SeleccionarTipoComprobante("RM")' tabindex="-1" aria-hidden="true"></button>
    <button id="pos-clear-cart-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick="HandleClearCartShortcutAsync" tabindex="-1" aria-hidden="true"></button>
    <button id="pos-save-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick="HandleSaveShortcutAsync" tabindex="-1" aria-hidden="true"></button>
    <button id="pos-escape-shortcut-trigger" type="button" class="pos-shortcut-trigger" @onclick="HandleEscapeShortcutAsync" tabindex="-1" aria-hidden="true"></button>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="panel-card empty-state">
            <p>@_error</p>
        </section>
    }
    else if (_loading)
    {
        <section class="panel-card pos-loading">
            <div class="loading">Leyendo catalogo inicial del punto de venta...</div>
        </section>
    }
    else if (_context is not null)
    {
        <header class="pos-topbar @(_mobileCartView ? "pos-topbar--mobile-review" : "pos-topbar--mobile-catalog")">
            <div class="pos-topbar__brand">
                <div class="pos-topbar__logo">PV</div>
                <div class="pos-topbar__copy">
                    <div class="pos-topbar__title-row">
                        <h1>Punto de Venta</h1>
                        <span class="pos-topbar__version">@GetAppVersionLabel()</span>
                    </div>
                    <div class="pos-topbar__context" aria-label="Contexto operativo actual">
                        <span class="pos-topbar__context-item" title="Punto de venta actual">
                            <i class="bi bi-shop"></i>
                            PV <strong>@PuntoVentaActualLabel</strong>
                        </span>
                        <span class="pos-topbar__context-item" title="Sucursal operativa">
                            <i class="bi bi-building"></i>
                            Suc. <strong>@SucursalOperativa</strong>
                        </span>
                        <span class="pos-topbar__context-item" title="Usuario de la sesión">
                            <i class="bi bi-person"></i>
                            <strong>@UsuarioActualLabel</strong>
                        </span>
                    </div>
                </div>
            </div>

            <div class="pos-topbar__document" aria-label="Comprobante a utilizar">
                <span class="pos-topbar__document-label">Comprobante:</span>
                <div class="pos-topbar__quick-documents">
                    @foreach (var acceso in ComprobantesRapidosDisponibles())
                    {
                        <button type="button" class="pos-topbar__quick-document @(_tipoComprobanteSeleccionado == acceso.Codigo ? "is-active" : string.Empty)"
                                title="@acceso.Descripcion"
                                @onclick="() => SeleccionarTipoComprobante(acceso.Codigo)">@acceso.Etiqueta</button>
                    }
                </div>
            </div>

            <div class="pos-topbar__customer" title="@CustomerSummaryTooltip()" aria-live="polite">
                <div class="pos-topbar__customer-main">
                    <strong>Cliente:</strong> @PricingCustomerLabel()
                </div>
                <div class="pos-topbar__customer-data">
                    <span><strong>Doc.:</strong> @CustomerDocumentLabel()</span>
                    <span><strong>IVA:</strong> @CustomerIvaLabel()</span>
                </div>
                <div class="pos-topbar__customer-data">
                    <span><strong>Clase:</strong> @_catalog.ClasePrecioActual</span>
                    <span><strong>Lista:</strong> @PricingListLabel()</span>
                    @if (!string.IsNullOrWhiteSpace(_catalog.ClasePrecioOfertaActual))
                    {
                        <span><strong>Oferta:</strong> clase @_catalog.ClasePrecioOfertaActual</span>
                    }
                </div>
            </div>

            <div class="pos-topbar__actions">
                <div class="pos-topbar__menu">
                    <button type="button" class="pos-topbar__ghost" @onclick="TogglePosMenu" aria-label="Abrir menú del punto de venta" title="Menú POS">
                        <i class="bi bi-list"></i>
                    </button>

                    @if (_showPosMenu)
                    {
                        <div class="pos-topbar__menu-panel">
                            <button type="button" class="pos-topbar__menu-item" @onclick="OpenCashDetailModalAsync">
                                <i class="bi bi-journal-text"></i>
                                Detalle de caja
                            </button>
                            <button type="button" class="pos-topbar__menu-item" @onclick="OpenCashInOutModalAsync">
                                <i class="bi bi-cash-stack"></i>
                                Ingresos/Egresos de caja
                            </button>
                            @if (_idPuntoVentaActual > 0)
                            {
                                <button type="button" class="pos-topbar__menu-item" @onclick="AbrirModalCorteXAsync" disabled="@(_turnoActual is null)">
                                    <i class="bi bi-clipboard-check"></i>
                                    Corte X
                                </button>
                                <button type="button" class="pos-topbar__menu-item" @onclick="AbrirModalCierreCajaAsync" disabled="@(_turnoActual is null)">
                                    <i class="bi bi-lock"></i>
                                    Cerrar caja
                                </button>
                                <button type="button" class="pos-topbar__menu-item" @onclick="AbrirModalSaldosPorCajaAsync">
                                    <i class="bi bi-cash-coin"></i>
                                    Ver saldos por caja
                                </button>
                            }
                            <button type="button" class="pos-topbar__menu-item" @onclick="OpenClearCartConfirm" disabled="@(!_cartItems.Any())" title="Vaciar carrito (Ctrl+B)">
                                <i class="bi bi-trash"></i>
                                Vaciar carrito <kbd>Ctrl+B</kbd>
                            </button>
                            <button type="button" class="pos-topbar__menu-item" @onclick="OpenReprintModalAsync" title="Reimprimir comprobantes (Ctrl+P)">
                                <i class="bi bi-printer"></i>
                                Reimprimir comprobantes <kbd>Ctrl+P</kbd>
                            </button>
                            @if (EsMostradorProduccion)
                            {
                                <button type="button" class="pos-topbar__menu-item" @onclick="OpenNuevoEncargoAsync">
                                    <i class="bi bi-plus-circle"></i>
                                    Nuevo encargo
                                </button>
                                <button type="button" class="pos-topbar__menu-item" @onclick="OpenNpAnticiposModalAsync">
                                    <i class="bi bi-receipt"></i>
                                    Consultar pedidos <kbd>F9</kbd>
                                </button>
                                <button type="button" class="pos-topbar__menu-item" @onclick="OpenProductionMonitorAsync">
                                    <i class="bi bi-kanban"></i>
                                    Producción
                                </button>
                            }
                            <button type="button" class="pos-topbar__menu-item" @onclick="InstallPwaFromPosAsync" title="Instalar Punto de Venta como aplicación">
                                <i class="bi bi-download"></i>
                                Instalar Punto de Venta
                            </button>
                            <button type="button" class="pos-topbar__menu-link" @onclick="OpenCloseModuleConfirm">
                                <i class="bi bi-box-arrow-left"></i>
                                Salir
                            </button>
                        </div>
                    }
                </div>

            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_chargeSuccess))
        {
            <section class="pos-loading" style="padding-top:0.75rem;">
                <div class="pos-charge-modal__feedback pos-success-banner">
                    <span>@_chargeSuccess</span>
                    <button type="button" @onclick="DismissChargeSuccess"><i class="bi bi-x-lg"></i></button>
                </div>
            </section>
        }

        @if (_pedidoContexto is not null)
        {
            <section class="pos-loading" style="padding-top:0.75rem;">
                <div class="pos-charge-modal__feedback pos-success-banner pos-pedido-banner">
                    <span>@GetPedidoContextoTexto()</span>
                    @if (_confirmarVolverPedido)
                    {
                        <span class="pos-pedido-banner__acciones">
                            <span>Hay @_cartItems.Count artículo(s) sin @(EsPedidoSalon ? "enviar" : "guardar"). ¿Salir igual?</span>
                            <button type="button" @onclick="() => _confirmarVolverPedido = false">Seguir cargando</button>
                            <button type="button" class="pos-pedido-banner__salir" @onclick="() => VolverDePedido(true)">Salir sin @(EsPedidoSalon ? "enviar" : "guardar")</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="btn btn--ghost btn--sm pos-pedido-banner__volver" @onclick="() => VolverDePedido(false)">
                            <i class="bi bi-arrow-left"></i> @(EsPedidoSalon ? "Volver al salón" : "Volver a pedidos")
                        </button>
                    }
                </div>
            </section>
        }
        @if (DesdeSalon)
        {
            <section class="pos-loading" style="padding-top:0.75rem;">
                <div class="pos-charge-modal__feedback pos-success-banner pos-pedido-banner">
                    <span>Caja del salón</span>
                    <button type="button" class="btn btn--ghost btn--sm pos-pedido-banner__volver" @onclick="VolverAlSalonDesdeCaja">
                        <i class="bi bi-arrow-left"></i> Volver al salón
                    </button>
                </div>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(_pedidoError))
        {
            <section class="pos-loading" style="padding-top:0.75rem;">
                <div class="pos-charge-modal__feedback">
                    <span>@_pedidoError</span>
                </div>
            </section>
        }

        @if (_idPuntoVentaActual > 0 && !_loading && _turnoActual is null)
        {
            <section class="pos-loading" style="padding-top:0.75rem;">
                <div class="pos-charge-modal__feedback">
                    <span>No hay un turno abierto para la caja @_idCajaActual de este punto de venta. Abrí la caja para poder cobrar.</span>
                    <button type="button" class="btn btn--primary btn--sm" @onclick="AbrirModalApertura">Abrir caja</button>
                </div>
            </section>
        }

        <section class="pos-mobile-app" aria-label="Punto de venta móvil">
            <main class="pos-mobile-content @(_mobileCartView ? "pos-mobile-content--review" : string.Empty)" @ref="_mobileContentRef">
                @if (!_mobileCartView)
                {
                    <section class="pos-mobile-catalog">
                        <div class="pos-mobile-search">
                            <i class="bi bi-search"></i>
                            <input @bind="_filters.Texto"
                                   @bind:event="oninput"
                                   @onkeydown="HandleMobileSearchKeyDown"
                                   class="pos-mobile-search__input"
                                   placeholder="Buscar por descripción, código o barras"
                                   aria-label="Buscar artículos" />
                            <button type="button" class="pos-mobile-search__button" @onclick="BuscarArticulosAsync" disabled="@_catalogLoading" aria-label="Buscar artículos">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>

                        <div class="pos-catalog__rubros pos-catalog__rubros--mobile" aria-label="Rubros">
                            @if (_topConfiguradoCount > 0)
                            {
                                <button type="button" class="pos-catalog__rubro pos-catalog__rubro--top @(_filters.IdRubro == PuntoVentaCatalogoKeys.Top ? "is-active" : string.Empty)" @onclick="() => SeleccionarRubroAsync(PuntoVentaCatalogoKeys.Top)">TOP @_topConfiguradoCount</button>
                            }
                            <button type="button" class="pos-catalog__rubro pos-catalog__rubro--todos @(_filters.IdRubro == string.Empty ? "is-active" : string.Empty)" @onclick="() => SeleccionarRubroAsync(string.Empty)">Todos</button>
                            @foreach (var rubro in _rubros)
                            {
                                <button type="button" class="pos-catalog__rubro @(EsRubroSeleccionado(rubro) ? "is-active" : string.Empty)" style="@RubroStyle(rubro)" @onclick="() => SeleccionarRubroAsync(rubro.IdRubro)">@rubro.Descripcion</button>
                            }
                        </div>

                        @if (_catalogLoading)
                        {
                            <div class="pos-mobile-state">Buscando artículos...</div>
                        }
                        else if (!_catalog.Articulos.Any())
                        {
                            <div class="pos-mobile-state">No hay artículos para mostrar.</div>
                        }
                        else
                        {
                            <section class="pos-mobile-products">
                                @foreach (var article in _catalog.Articulos)
                                {
                                    var quantity = GetMobileArticleQuantity(article.IdArticulo);
                                    <article class="pos-mobile-product @(quantity > 0 ? "pos-mobile-product--selected" : string.Empty)">
                                        <button type="button" class="pos-mobile-product__select" @onclick="() => AddToCart(article)" aria-label="Agregar @article.Descripcion">
                                            <div class="pos-mobile-product__image">
                                                @if (ShouldShowImage(article))
                                                {
                                                    <img src="@GetProductThumbUrl(article)" alt="@article.Descripcion" loading="lazy" @onerror="@EventCallback.Factory.Create(this, () => HandleImageError(article.IdArticulo))" />
                                                }
                                                else
                                                {
                                                    <span>@ProductInitials(article.Descripcion)</span>
                                                }
                                            </div>
                                            <strong>@article.Descripcion</strong>
                                            <span class="pos-mobile-product__code">Código: @article.IdArticulo</span>
                                            <span class="pos-mobile-product__price">
                                                @if (article.EsPrecioOferta)
                                                {
                                                    <del>@FmtMoney(article.PrecioOriginal)</del>
                                                    <strong>Oferta @FmtMoney(article.PrecioUnitario)</strong>
                                                }
                                                else
                                                {
                                                    @FmtMoney(article.PrecioUnitario)
                                                }
                                            </span>
                                        </button>
                                        <div class="pos-mobile-product__quantity" @onclick:stopPropagation="true">
                                            <button type="button" @onclick="() => ChangeMobileArticleQuantity(article, -1m)" aria-label="Disminuir cantidad">−</button>
                                            <input type="number" min="0" step="0.01" inputmode="decimal"
                                                   @key="quantity"
                                                   value="@(quantity > 0 ? FmtQuantityInput(quantity) : "0")"
                                                   @onchange="eventArgs => SetMobileArticleQuantity(article, eventArgs)"
                                                   aria-label="Cantidad de @article.Descripcion" />
                                            <button type="button" @onclick="() => ChangeMobileArticleQuantity(article, 1m)" aria-label="Aumentar cantidad">+</button>
                                        </div>
                                    </article>
                                }
                            </section>

                            @if (_catalogLoadingMore)
                            {
                                <div class="pos-mobile-state">Cargando más artículos...</div>
                            }
                        }
                    </section>
                }
                else
                {
                    <section class="pos-mobile-review">
                        <button type="button" class="pos-mobile-client" @onclick="() => _showClienteModal = true">
                            <span><i class="bi bi-person-circle"></i> Cliente</span>
                            <strong>@(string.IsNullOrWhiteSpace(_cuentaClienteNombre) ? "Consumidor final" : RecortarNombreCliente(_cuentaClienteNombre))</strong>
                            <i class="bi bi-chevron-right"></i>
                        </button>

                        <div class="pos-mobile-review__items">
                            @if (!_cartItems.Any())
                            {
                                <div class="pos-mobile-state">No hay artículos seleccionados.</div>
                            }
                            else
                            {
                                @foreach (var item in _cartItems)
                                {
                                    <article class="pos-mobile-cart-line">
                                        <div class="pos-mobile-cart-line__info">
                                            <strong>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Artículo sin descripción" : item.Descripcion)</strong>
                                            <span>Código: @item.IdArticulo · @FmtMoney(item.PrecioUnitario) ud.</span>
                                            @if (item.EsPrecioOferta)
                                            {
                                                <span class="pos-line__offer"><i class="bi bi-lightning-charge-fill"></i> Precio oferta</span>
                                            }
                                        </div>
                                        <strong class="pos-mobile-cart-line__subtotal">@FmtMoney(item.Subtotal)</strong>
                                        <div class="pos-mobile-cart-line__quantity">
                                            <button type="button" @onclick="() => ChangeQty(item.IdArticulo, -1m)" aria-label="Disminuir cantidad">−</button>
                                            <input type="number" min="0" step="0.01" inputmode="decimal" @key="item.Cantidad" value="@FmtQuantityInput(item.Cantidad)" @onchange="eventArgs => SetCartItemQuantity(item, eventArgs)" aria-label="Cantidad de @item.Descripcion" />
                                            <button type="button" @onclick="() => ChangeQty(item.IdArticulo, 1m)" aria-label="Aumentar cantidad">+</button>
                                            <button type="button" class="pos-mobile-cart-line__remove" @onclick="() => RemoveItem(item.IdArticulo)" aria-label="Eliminar artículo"><i class="bi bi-trash3"></i></button>
                                        </div>
                                    </article>
                                }
                            }
                        </div>

                    </section>
                }
            </main>

            <footer class="pos-mobile-footer">
                @if (!_mobileCartView)
                {
                    <div class="pos-mobile-footer__summary">
                        <span>@FmtQty(_cartItems.Sum(x => x.Cantidad)) artículos</span>
                        <strong>@FmtMoney(TotalCarrito)</strong>
                    </div>
                    <button type="button" class="pos-mobile-footer__primary" @onclick="OpenMobileCart" disabled="@(!_cartItems.Any())">Ver carrito <i class="bi bi-arrow-right"></i></button>
                }
                else
                {
                    <div class="pos-mobile-footer__review-total">
                        <span>Total</span>
                        <strong>@FmtMoney(TotalCarrito)</strong>
                    </div>
                    <div class="pos-mobile-footer__review-actions">
                        <button type="button" class="pos-mobile-footer__secondary" @onclick="CloseMobileCart"><i class="bi bi-arrow-left"></i> Volver</button>
                        @if (_pedidoContexto is not null && !EsCierrePedido)
                        {
                            <button type="button" class="pos-mobile-footer__primary" @onclick="GuardarPedidoDesdeCarritoAsync" disabled="@(!_cartItems.Any())">@(EsPedidoSalon ? "Enviar comanda" : "Guardar pedido")</button>
                        }
                        else
                        {
                            <button type="button" class="pos-mobile-footer__primary" @onclick="OpenChargeModalAsync" disabled="@(!_cartItems.Any() || (_idPuntoVentaActual > 0 && _turnoActual is null))">@(EsRemitoONotaPedido ? "Generar" : "Cobrar")</button>
                        }
                    </div>
                }
            </footer>
        </section>

        <section class="pos-stage @(_settings.ModoIngresoRapido != PuntoVentaIngresoRapidoModoKeys.Deshabilitado ? "pos-stage--quick" : string.Empty)">
            <aside class="pos-sidebar">
                <div class="pos-sidebar__items" @ref="_cartItemsRef">
                    @if (!_cartItems.Any())
                    {
                        <div class="pos-sidebar__empty">
                            <strong>Carrito vacio</strong>
                            <span>Agrega articulos desde el catalogo para empezar a vender.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in _cartItems)
                        {
                            <article class="pos-line" @onclick="() => OpenCartItemModal(item)">
                                <div class="pos-line__main">
                                    <strong>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Artículo sin descripción" : item.Descripcion)</strong>
                                    <div class="pos-line__details">
                                        <span>Código: @item.IdArticulo · Precio ud.: @FmtMoney(item.PrecioUnitario)</span>
                                        @if (item.EsPrecioOferta)
                                        {
                                            <span class="pos-line__offer"><i class="bi bi-lightning-charge-fill"></i> Precio oferta</span>
                                        }
                                        <div class="pos-line__controls" @onclick:stopPropagation="true">
                                            <button type="button" title="Disminuir cantidad"
                                                    @onclick="() => ChangeQty(item.IdArticulo, -1m)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <strong>@FmtQty(item.Cantidad)</strong>
                                            <button type="button" title="Aumentar cantidad"
                                                    @onclick="() => ChangeQty(item.IdArticulo, 1m)">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                            <button type="button" class="pos-line__remove" title="Eliminar artículo"
                                                    @onclick="() => RemoveItem(item)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                        {
                                            <div class="pos-line__observation"><i class="bi bi-chat-left-text"></i> @item.Observaciones</div>
                                        }
                                    </div>
                                </div>
                                <div class="pos-line__price">@FmtMoney(item.Subtotal)</div>
                            </article>
                        }
                    }
                </div>

                <div class="pos-sidebar__checkout">
                    @if (_settings.ModoIngresoRapido != PuntoVentaIngresoRapidoModoKeys.Deshabilitado)
                    {
                        <PosIngresoRapido @ref="_ingresoRapidoRef"
                                          ImportesRapidos="ImportesRapidosConfigurados"
                                          CantidadesRapidas="CantidadesRapidasConfiguradas"
                                          Decimales="_settings.CantidadDecimales"
                                          Compacto="@(_settings.ModoIngresoRapido == PuntoVentaIngresoRapidoModoKeys.Compacto)"
                                          OnConfirmed="AceptarIngresoRapidoAsync"
                                          OnPreparedChanged="ActualizarIngresoRapidoPreparadoAsync" />
                    }
                    <div class="pos-sidebar__notes">
                        <div class="pos-sidebar__scan-wrap">
                            <i class="bi bi-upc-scan pos-sidebar__scan-icon"></i>
                            <input class="pos-sidebar__scan"
                                   placeholder="Código o código de barras"
                                   @ref="_scanInputRef"
                                   @bind="_scanCode"
                                   @bind:event="oninput"
                                   @onkeydown="HandleScanKeyAsync"
                                   disabled="@_scanLoading"
                                   autocomplete="off" />
                        </div>
                        @if (!string.IsNullOrEmpty(_scanError))
                        {
                            <span class="pos-sidebar__scan-error">@_scanError</span>
                        }
                    </div>

                    <div class="pos-sidebar__client">
                            <button type="button" class="pos-sidebar__client-btn" @onclick="() => _showClienteModal = true" title="Consultar cliente">
                            <i class="bi bi-person-circle"></i>
                            @if (!string.IsNullOrEmpty(_cuentaClienteNombre))
                            {
                                <span class="pos-sidebar__client-name"
                                      title="@_cuentaClienteNombre">@RecortarNombreCliente(_cuentaClienteNombre)</span>
                            }
                            else
                            {
                                <span>Consumidor final</span>
                            }
                        </button>
                        @if (!string.IsNullOrEmpty(_cuentaCliente))
                        {
                            <button type="button" class="pos-sidebar__client-clear" title="Quitar cliente"
                                    @onclick="LimpiarCliente" @onclick:stopPropagation>
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>

                    <div class="pos-sidebar__footer">
                        @if (_pedidoContexto is not null && !EsCierrePedido)
                        {
                            <button type="button" class="pos-charge" @onclick="GuardarPedidoDesdeCarritoAsync" disabled="@(!_cartItems.Any())">
                                <i class="bi @(EsPedidoSalon ? "bi-send" : "bi-journal-check") pos-charge__icon"></i>
                                <span class="pos-charge__label">@(EsPedidoSalon ? "Enviar comanda" : "Guardar pedido")</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="pos-charge" @onclick="OpenChargeModalAsync" disabled="@(!_cartItems.Any() || (_idPuntoVentaActual > 0 && _turnoActual is null))" title="@(EsRemitoONotaPedido ? TipoComprobanteSeleccionadoLabel() : "Cobrar")">
                                <i class="bi @(EsRemitoONotaPedido ? "bi-file-earmark-text" : "bi-cash-stack") pos-charge__icon"></i>
                                <span class="pos-charge__label">@(EsRemitoONotaPedido ? "Generar" : "Cobrar")</span>
                            </button>
                        }

                        <div class="pos-total-card">
                            <span>Total</span>
                            <strong>@FmtMoney(TotalCarrito)</strong>
                        </div>
                    </div>

                </div>
            </aside>

            <div class="pos-catalog">
                <div class="pos-split pos-split--carrito" data-pos-split="carrito" role="separator" aria-orientation="vertical"
                     title="Arrastrá para cambiar el ancho del carrito · Doble clic: ancho original"></div>
                <section class="pos-catalog__toolbar">
                    <div class="pos-catalog__search">
                        <input @bind="_filters.Texto"
                               @bind:event="oninput"
                               @onkeydown="HandleDesktopSearchKeyDown"
                               class="pos-search-input"
                               placeholder="Buscar articulos..."
                               aria-label="Buscar artículos" />
                        <button type="button" class="pos-search-btn" @onclick="BuscarArticulosAsync" disabled="@_catalogLoading">
                            @( _catalogLoading ? "Buscando..." : "Buscar" )
                        </button>
                        <div class="pos-layout">
                            <button type="button" class="pos-layout__toggle @(_showLayoutPanel ? "is-open" : null)" @onclick="ToggleLayoutPanel"
                                    title="Tamaño de los botones y distribución (se guarda en esta PC)" aria-expanded="@(_showLayoutPanel ? "true" : "false")">
                                <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                            </button>
                            @if (_showLayoutPanel)
                            {
                                <div class="pos-layout__backdrop" @onclick="() => _showLayoutPanel = false"></div>
                                <section class="pos-layout__panel" aria-label="Tamaño y distribución">
                                    <header>
                                        <strong>Tamaño y distribución</strong>
                                        <small>Se guarda en esta PC</small>
                                    </header>
                                    <label class="pos-layout__label">Tamaño de los botones</label>
                                    <div class="pos-layout__size">
                                        <button type="button" data-pos-layout="menos" title="Más chicos" aria-label="Botones más chicos">A−</button>
                                        <input type="range" min="0.7" max="2" step="0.1" value="1" data-pos-layout="escala" aria-label="Tamaño de los botones" />
                                        <button type="button" data-pos-layout="mas" title="Más grandes" aria-label="Botones más grandes">A+</button>
                                        <output data-pos-layout-valor>100%</output>
                                    </div>
                                    <label class="pos-layout__label">Rubros</label>
                                    <div class="pos-layout__seg">
                                        <button type="button" data-pos-layout="rubros-arriba"><i class="bi bi-layout-text-window" aria-hidden="true"></i> Arriba</button>
                                        <button type="button" data-pos-layout="rubros-costado"><i class="bi bi-layout-sidebar" aria-hidden="true"></i> Al costado</button>
                                    </div>
                                    <p class="pos-layout__hint">Arrastrá las barras para cambiar el ancho del carrito y el espacio de los rubros. Doble clic en una barra la vuelve a su medida original.</p>
                                    <button type="button" class="pos-layout__reset" data-pos-layout="restablecer"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Restablecer todo</button>
                                </section>
                            }
                        </div>
                    </div>
                </section>

                <div class="pos-catalog__body">
                    <div class="pos-catalog__rubros" aria-label="Rubros">
                        @if (_topConfiguradoCount > 0)
                        {
                            <button type="button" class="pos-catalog__rubro pos-catalog__rubro--top @(_filters.IdRubro == PuntoVentaCatalogoKeys.Top ? "is-active" : string.Empty)" @onclick="() => SeleccionarRubroAsync(PuntoVentaCatalogoKeys.Top)">TOP @_topConfiguradoCount</button>
                        }
                        <button type="button" class="pos-catalog__rubro pos-catalog__rubro--todos @(_filters.IdRubro == string.Empty ? "is-active" : string.Empty)" @onclick="() => SeleccionarRubroAsync(string.Empty)">Todos</button>
                        @foreach (var rubro in _rubros)
                        {
                            <button type="button" class="pos-catalog__rubro @(EsRubroSeleccionado(rubro) ? "is-active" : string.Empty)" style="@RubroStyle(rubro)" @onclick="() => SeleccionarRubroAsync(rubro.IdRubro)">@rubro.Descripcion</button>
                        }
                    </div>

                    <div class="pos-split pos-split--rubros" data-pos-split="rubros" role="separator"
                         title="Arrastrá para dar más o menos lugar a los rubros · Doble clic: medida original"></div>

                <div class="pos-catalog__articles">
                    <section class="pos-catalog__meta">
                        <span>@DisplayListName()</span>
                        <span>Clase @_catalog.ClasePrecioActual</span>
                        @if (_catalog.UsaPrecioFallback)
                        {
                            <span>Precio base del articulo</span>
                        }
                    </section>

                    @if (_catalogLoading)
                    {
                        <div class="pos-grid-status">Buscando articulos...</div>
                    }
                    else if (!_catalog.Articulos.Any())
                    {
                        <div class="pos-grid-status">No hay articulos para mostrar con los filtros actuales.</div>
                    }
                    else
                    {
                        <section class="pos-grid" @ref="_catalogGridRef" @onscroll="OnCatalogScrolledAsync">
                        @foreach (var article in _catalog.Articulos)
                        {
                            <article class="pos-product" @onclick="() => AddToCart(article)">
                                <div class="pos-product__price">
                                    @if (article.EsPrecioOferta)
                                    {
                                        <del>@FmtMoney(article.PrecioOriginal)</del>
                                        <strong>Oferta @FmtMoney(article.PrecioUnitario)</strong>
                                    }
                                    else
                                    {
                                        @FmtMoney(article.PrecioUnitario)
                                    }
                                </div>

                                <div class="pos-product__image-wrap">
                                    @if (ShouldShowImage(article))
                                    {
                                        <img class="pos-product__image"
                                             src="@GetProductThumbUrl(article)"
                                             alt="@article.Descripcion"
                                             loading="lazy"
                                             @onerror="@EventCallback.Factory.Create(this, () => HandleImageError(article.IdArticulo))" />
                                    }
                                    else
                                    {
                                        <div class="pos-product__fallback">@ProductInitials(article.Descripcion)</div>
                                    }
                                </div>

                                <div class="pos-product__text">
                                    <strong>@article.Descripcion</strong>
                                </div>

                                @if (article.Pesable || article.NoControlaStock)
                                {
                                    <div class="pos-product__badges">
                                        @if (article.Pesable)
                                        {
                                            <span class="pos-mini-badge">Pesable</span>
                                        }
                                        @if (article.NoControlaStock)
                                        {
                                            <span class="pos-mini-badge pos-mini-badge--muted">Sin stock</span>
                                        }
                                    </div>
                                }
                            </article>
                        }
                        </section>

                        @if (_catalogLoadingMore)
                        {
                            <div class="pos-grid-status">Cargando más artículos...</div>
                        }
                        else if (_catalog.TieneMasResultados)
                        {
                            <div class="pos-grid-status pos-grid-status--more">Deslizá hacia abajo para seguir cargando artículos.</div>
                        }
                    }
                </div>
                </div>
            </div>
        </section>
    }
</section>

@if (SelectedCartItem is not null)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar detalle" @onclick="CloseCartItemModal"></button>
    <section class="pos-item-modal" aria-label="Editar artículo">
        <div class="pos-item-modal__image">
            @if (ShouldShowImage(SelectedCartItem.IdArticulo))
            {
                <img src="@GetProductImageUrl(SelectedCartItem.IdArticulo)"
                     alt="@SelectedCartItem.Descripcion"
                     loading="lazy"
                     @onerror="@EventCallback.Factory.Create(this, () => HandleImageError(SelectedCartItem.IdArticulo))" />
            }
            else
            {
                <div class="pos-item-modal__fallback">@ProductInitials(SelectedCartItem.Descripcion)</div>
            }
        </div>

        <div class="pos-item-modal__body">
            <div class="pos-item-modal__top">
                <div>
                    <div class="pos-item-modal__code"># @SelectedCartItem.IdArticulo</div>
                    @if (string.IsNullOrWhiteSpace(SelectedCartItem.Descripcion))
                    {
                        <h3 class="pos-item-modal__title">Artículo sin descripción</h3>
                    }
                    else
                    {
                        <h3 class="pos-item-modal__title">@SelectedCartItem.Descripcion</h3>
                    }
                </div>
                <button type="button" class="pos-item-modal__close" @onclick="CloseCartItemModal">X</button>
            </div>

            @if (string.IsNullOrWhiteSpace(SelectedCartItem.Descripcion))
            {
                <div class="pos-item-modal__description-edit">
                    <label for="pos-item-description">Descripción del artículo</label>
                    <input id="pos-item-description"
                           @bind="_descriptionBeingEdited"
                           @onkeydown="HandleDescriptionKeyDown"
                           placeholder="Ingresá una descripción" />
                    <button type="button" class="pos-item-modal__description-save"
                            @onclick="SaveItemDescription"
                            disabled="@string.IsNullOrWhiteSpace(_descriptionBeingEdited)">
                        Guardar descripción
                    </button>
                </div>
            }

            <div class="pos-item-modal__price">@FmtMoney(SelectedCartItem.Subtotal)</div>

            <label class="pos-item-modal__observation">
                <span><i class="bi bi-chat-left-text" aria-hidden="true"></i> Observación</span>
                <textarea @bind="_lineObservationBeingEdited" maxlength="500"
                          @ref="_lineObservationRef"
                          placeholder="Indicaciones para este artículo"></textarea>
            </label>
            <div class="pos-item-modal__observation-actions">
                <button type="button" @onclick="SaveLineObservation">Guardar nota</button>
                @if (!string.IsNullOrWhiteSpace(SelectedCartItem.Observaciones))
                {
                    <button type="button" class="is-muted" @onclick="ClearLineObservation">Quitar nota</button>
                }
            </div>

            <button type="button" class="pos-item-modal__danger" @onclick="() => RemoveItemAndClose(SelectedCartItem!)">Eliminar</button>

            <div class="pos-item-modal__qty-label">Cantidad</div>
            <div class="pos-item-modal__qty">
                <input class="pos-item-modal__qty-input"
                       type="number"
                       min="0.01"
                       step="0.01"
                       @bind="SelectedCartItem.Cantidad"
                       @onkeydown="HandleQuantityKeyDown" />
                <button type="button" class="pos-item-modal__qty-btn" @onclick="() => ChangeQtyAndRefreshModal(SelectedCartItem!, -1m)">-</button>
                <button type="button" class="pos-item-modal__qty-btn" @onclick="() => ChangeQtyAndRefreshModal(SelectedCartItem!, 1m)">+</button>
            </div>
        </div>
    </section>
}

@if (_manualArticlePending is not null)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar carga manual" @onclick="CloseManualArticleModal"></button>
    <section class="pos-item-modal pos-manual-article-modal" aria-label="Cargar artículo especial">
        <div class="pos-item-modal__top">
            <div>
                <div class="pos-item-modal__code"># @_manualArticlePending.IdArticulo</div>
                <h3 class="pos-item-modal__title">
                    @(_manualArticleRequiresDescription ? "Cargar artículo manual" : "Ingresar precio")
                </h3>
            </div>
            <button type="button" class="pos-item-modal__close" @onclick="CloseManualArticleModal">X</button>
        </div>

        <p class="pos-manual-article-modal__hint">
            @(_manualArticleRequiresDescription
                ? "Este artículo requiere que ingreses la descripción y el precio antes de agregarlo al carrito."
                : "Este artículo no tiene precio configurado. Ingresá el precio antes de agregarlo al carrito.")
        </p>

        <div class="pos-manual-article-modal__fields">
            @if (_manualArticleRequiresDescription)
            {
                <label for="pos-manual-article-description">
                    Descripción
                    <input id="pos-manual-article-description"
                           @ref="_manualArticleDescriptionRef"
                           @bind="_manualArticleDescription"
                           @bind:event="oninput"
                           @onkeydown="HandleManualArticleDescriptionKeyDown"
                           autocomplete="off"
                           placeholder="Ingresá la descripción" />
                </label>
            }
            <label for="pos-manual-article-price">
                Precio unitario
                <input id="pos-manual-article-price"
                       @ref="_manualArticlePriceRef"
                       @bind="_manualArticlePriceInput"
                       @bind:event="oninput"
                       @onkeydown="HandleManualArticlePriceKeyDown"
                       inputmode="decimal"
                       autocomplete="off"
                       placeholder="0,00" />
            </label>
        </div>

        @if (!string.IsNullOrWhiteSpace(_manualArticleError))
        {
            <p class="pos-manual-article-modal__error">@_manualArticleError</p>
        }

        <div class="pos-manual-article-modal__actions">
            <button type="button" @onclick="CloseManualArticleModal">Cancelar</button>
            <button type="button" @onclick="ConfirmManualArticleAsync">Agregar al carrito</button>
        </div>
    </section>
}

@if (_showChargeModal)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar cobranza" @onclick="CloseChargeModal" disabled="@_chargeSaving"></button>
    <section class="pos-charge-modal" aria-label="Cobranza del punto de venta">
        <div class="pos-charge-modal__header">
            <div>
                <h3>@(EsRemitoONotaPedido ? TipoComprobanteSeleccionadoLabel() : "Cobranza")</h3>
                @if (_editandoNotaPedidoId is > 0)
                {
                    <p class="pos-charge-modal__mode">Editando nota de pedido @_facturandoNotaPedidoComprobante</p>
                }
            </div>
            <button type="button" class="pos-charge-modal__close" @onclick="CloseChargeModal" disabled="@_chargeSaving"><i class="bi bi-x-lg"></i></button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_chargeError))
        {
            <div class="pos-charge-modal__feedback pos-charge-modal__feedback--error">@_chargeError</div>
        }

        @if (_chargeSaving)
        {
            <div class="pos-arca-overlay" role="status" aria-live="polite">
                <div class="pos-arca-overlay__panel">
                    @if (EsComprobanteFiscalSeleccionado())
                    {
                    <div class="pos-arca-overlay__brand">
                        <span class="pos-arca-overlay__brand-mark">ARCA</span>
                        <span class="pos-arca-overlay__brand-copy">
                            <strong>Agencia de Recaudación</strong>
                            <span>y Control Aduanero</span>
                            <span>Facturación electrónica</span>
                        </span>
                        <span class="pos-arca-overlay__environment">@_arcaEnvironmentLabel</span>
                    </div>
                    }
                    <div class="pos-arca-overlay__body">
                        <span class="pos-arca-overlay__spinner"><i class="bi bi-arrow-repeat"></i></span>
                        <div>
                            <strong>@_chargeProgress</strong>
                            <small>No cierres esta ventana ni presiones Aceptar nuevamente.</small>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_mpCobrando || _mpPointPuedeReintentar)
        {
            <div class="pos-point-overlay @(_mpPointPuedeReintentar ? "pos-point-overlay--final" : string.Empty)">
                <div class="pos-point-overlay__panel">
                    <span class="pos-point-status__icon"><i class="bi @(_mpPointPuedeReintentar ? "bi-exclamation-triangle" : "bi-phone-vibrate")"></i></span>
                    @if (_mpPointPuedeReintentar)
                    {
                        <strong class="pos-point-overlay__title">@(_mpPointFueCancelado ? "Pago cancelado" : "No se pudo completar el pago")</strong>
                        <strong class="pos-point-overlay__amount">@FmtMoney(_mpImportePointPendiente)</strong>
                        <span class="pos-point-overlay__detail">@(_mpPointFueCancelado ? "La operación fue cancelada. Podés reintentar o cancelar." : "Verificá el lector y podés reintentar la operación.")</span>
                    }
                    else
                    {
                        <strong class="pos-point-overlay__title">Cobrando con Mercado Pago</strong>
                        <strong class="pos-point-overlay__amount">@FmtMoney(_mpImportePointPendiente)</strong>
                        <span class="pos-point-overlay__detail">@EstadoPointVisible(_mpEstadoCobro)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_mpTerminalSeleccionada))
                    {
                        <small class="pos-point-overlay__terminal">Terminal: @_mpTerminalSeleccionada</small>
                    }
                    @if (_mpPointPuedeReintentar)
                    {
                        <div class="pos-point-overlay__actions">
                            <button type="button" class="pos-charge-modal__action" @onclick="ReintentarCobroPointAsync">Reintentar</button>
                            <button type="button" class="pos-charge-modal__ghost" @onclick="SolicitarCancelarReintentoPoint">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_mpTerminalesDisponibles.Count > 1 && !_mpCobrando)
        {
            <div class="pos-charge-modal__point-reader">
                <label for="pos-point-reader">Lector Mercado Pago Point</label>
                <select id="pos-point-reader" class="pos-select" @bind="_mpTerminalSeleccionada">
                    <option value="">Seleccioná un lector</option>
                    @foreach (var terminal in _mpTerminalesDisponibles)
                    {
                        <option value="@terminal">@terminal</option>
                    }
                </select>
            </div>
        }

        <div class="pos-charge-modal__totals-head">
            <div>
                <span>Total</span>
                <strong>@FmtMoney(TotalCarrito)</strong>
            </div>
            @if (!EsRemitoONotaPedido)
            {
                <div class="@(VueltoCobro > 0 ? "pos-charge-modal__totals-head--change" : "pos-charge-modal__totals-head--pending")">
                    @if (VueltoCobro > 0)
                    {
                        <span>Vuelto</span>
                        <strong>@FmtMoney(VueltoCobro)</strong>
                    }
                    else
                    {
                        <span>Faltante</span>
                        <strong>@FmtMoney(PendienteCobro)</strong>
                    }
                </div>
            }
        </div>

        @if (EsRemitoONotaPedido)
        {
            <div class="pos-charge-modal__body pos-charge-modal__body--np">
                <section class="pos-charge-modal__section pos-charge-modal__section--np-form">
                    <h4>Datos del encargo</h4>
                    <div class="pos-np-arca-search">
                        <label for="np-documento-arca">DNI / CUIT</label>
                        <input id="np-documento-arca"
                               @bind="_npDocumentoContactoInput"
                               @bind:event="oninput"
                               @onkeydown="HandleNpArcaKeyDownAsync"
                               maxlength="20"
                               inputmode="numeric"
                               placeholder="Ingresá DNI o CUIT" />
                        <button type="button" @onclick="ConsultarNpArcaAsync" disabled="@_npArcaBuscando">
                            <i class="bi bi-cloud-search"></i>
                            @(_npArcaBuscando ? "..." : "ARCA")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(_npArcaMensaje))
                        {
                            <p class="pos-np-arca-message">@_npArcaMensaje</p>
                        }
                        @if (_npArcaOpciones.Count > 1)
                        {
                            <div class="pos-np-arca-options">
                                @foreach (var persona in _npArcaOpciones)
                                {
                                    <button type="button" @onclick="() => AplicarNpArcaPersona(persona)">
                                        @persona.Cuit · @persona.RazonSocial
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <label class="pos-charge-modal__field">
                        <span>Nombre y apellido *</span>
                        <input @bind="_npNombreContactoInput" maxlength="100" placeholder="Nombre y apellido" />
                    </label>
                    <label class="pos-charge-modal__field">
                        <span>Teléfono *</span>
                        <input @bind="_npTelefonoInput" maxlength="100" placeholder="Ej.: 11-4444-5555" />
                    </label>
                    <div class="pos-charge-modal__field-row">
                        <label class="pos-charge-modal__field">
                            <span>Fecha de entrega</span>
                            <input type="date" @bind="_npFechaEntregaDateInput" />
                        </label>
                        <label class="pos-charge-modal__field">
                            <span>Hora de entrega</span>
                            <input type="time" @bind="_npHoraEntregaInput" />
                        </label>
                    </div>
                    @if (_npEntregaADomicilioInput)
                    {
                        <div class="pos-charge-modal__field-row pos-charge-modal__field-row--address">
                            <label class="pos-charge-modal__field">
                                <span>Domicilio *</span>
                                <input @bind="_npDomicilioEntregaInput" maxlength="200" placeholder="Calle y número" />
                            </label>
                            <label class="pos-charge-modal__field">
                                <span>Localidad</span>
                                <input @bind="_npLocalidadEntregaInput" maxlength="100" placeholder="Localidad" />
                            </label>
                        </div>
                    }
                    <label class="pos-settings-modal__check-field">
                        <input type="checkbox" @bind="_npEntregaADomicilioInput" />
                        <span><strong>Enviar a domicilio</strong></span>
                    </label>
                    @if (_settings.RelacionaCobranzasConNotasPedido)
                    {
                        <div class="pos-np-anticipo pos-np-anticipo--attention">
                            <div class="pos-np-anticipo__question">
                                <span>¿Cargar anticipo por el pedido?</span>
                                <small>Elegí una opción antes de generar</small>
                                @if (_npCargarAnticipoInput)
                                {
                                    <span class="pos-np-anticipo__status"><i class="bi bi-exclamation-triangle"></i> Requiere CBCT</span>
                                }
                            </div>
                            <div class="pos-np-anticipo__options">
                                <button type="button" class="@(_npCargarAnticipoInput ? "is-active" : string.Empty)" @onclick="() => SeleccionarAnticipoAsync(true)">Sí</button>
                                <button type="button" class="@(!_npCargarAnticipoInput ? "is-active" : string.Empty)" @onclick="() => SeleccionarAnticipoAsync(false)">No</button>
                            </div>
                        </div>
                        @if (_npCargarAnticipoInput)
                        {
                            <div class="pos-np-anticipo__payment">
                                <label class="pos-charge-modal__field">
                                    <span>Importe del anticipo</span>
                                    <input class="pos-charge-modal__amount"
                                           @ref="_chargeAmountRef"
                                           @bind="_chargeAmountInput"
                                           @bind:event="oninput"
                                           @onkeydown="HandleChargeAmountKeyDown"
                                           inputmode="decimal"
                                           placeholder="0,00" />
                                </label>
                                <label class="pos-charge-modal__field">
                                    <span>Medio de pago</span>
                                    <select class="pos-select" @bind="_selectedPaymentCode">
                                        <option value="">Seleccioná un medio</option>
                                        @foreach (var method in PaymentMethodsFiltrados)
                                        {
                                            <option value="@method.Codigo">@method.Descripcion</option>
                                        }
                                    </select>
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pos-grid-status pos-grid-status--np-summary">Anticipo no disponible para este punto de venta.</div>
                    }
                    <label class="pos-charge-modal__field pos-np-observations">
                        <span>Observaciones</span>
                        <textarea @bind="_npObservacionesInput" maxlength="500" placeholder="Indicaciones"></textarea>
                    </label>
                </section>
            </div>
        }
        else
        {
        <div class="pos-charge-modal__payment-entry">
            <input class="pos-charge-modal__code-filter"
                   @ref="_paymentMethodCodeFilterRef"
                   @bind="_paymentMethodCodeFilter"
                   @bind:event="oninput"
                   @onkeydown="HandlePaymentMethodFilterKeyDown"
                   @onblur="HandlePaymentMethodFilterBlur"
                   placeholder="Código o descripción" />
            <div class="pos-charge-modal__selected-method">
                <span>Medio seleccionado</span>
                <strong>@SelectedPaymentMethodLabel()</strong>
            </div>
            <input class="pos-charge-modal__amount"
                   @ref="_chargeAmountRef"
                   @bind="_chargeAmountInput"
                   @bind:event="oninput"
                   @onkeydown="HandleChargeAmountKeyDown"
                   inputmode="decimal"
                   placeholder="Importe" />
            <button type="button" class="pos-charge-modal__action" @onclick="() => AddSelectedPaymentAsync()" disabled="@(_paymentMethodsLoading || _mpCobrando)">Agregar</button>
        </div>

        @if (_mpModoPrueba
            && _selectedPaymentCode.Length > 0
            && _paymentMethods.FirstOrDefault(x => x.Codigo == _selectedPaymentCode) is { } selectedMethod
            && IsMercadoPagoPointMethod(selectedMethod))
        {
            <div class="pos-charge-modal__test-tools">
                <div>
                    <strong>Modo de prueba Point</strong>
                    <small>No usa Mercado Pago real.</small>
                </div>
                <select class="pos-select" @bind="_mpPruebaTipo">
                    <option value="QR">QR</option>
                    <option value="TARJETA">Tarjeta</option>
                </select>
                @if (_mpPruebaTipo == "TARJETA")
                {
                    <select class="pos-select" @bind="_mpPruebaTarjetaTipo">
                        <option value="DEBITO">Débito</option>
                        <option value="CREDITO">Crédito</option>
                    </select>
                    @if (_mpPruebaTarjetaTipo == "CREDITO")
                    {
                        <select class="pos-select" @bind="_mpPruebaCuotas">
                            @for (var cuota = 1; cuota <= 12; cuota++)
                            {
                                <option value="@cuota">@cuota cuota@(cuota == 1 ? string.Empty : "s") · @FmtPercent(PorcentajeRecargoPrueba(cuota))</option>
                            }
                        </select>
                    }
                }
                <button type="button" class="pos-charge-modal__action" @onclick="SimularPagoPointCreditoAsync" disabled="@(_chargeSaving || _mpCobrando)">
                    Simular pago
                </button>
            </div>
        }

        <div class="pos-charge-modal__body">
            <section class="pos-charge-modal__section">
                <h4>Medios de pago</h4>

                @if (_paymentMethodsLoading)
                {
                    <div class="pos-grid-status">Leyendo medios de pago...</div>
                }
                else if (!_paymentMethods.Any())
                {
                    <div class="pos-grid-status">No hay medios de pago configurados para esta base.</div>
                }
                else
                {
                    <div class="pos-charge-modal__methods-scroll"
                         @ref="_paymentMethodListRef"
                         tabindex="0">
                        <div class="pos-charge-modal__method-grid">
                            @foreach (var method in PaymentMethodsFiltrados)
                            {
                                <button type="button"
                                        class="@(method.Codigo == _selectedPaymentCode ? "pos-charge-modal__method-btn pos-charge-modal__method-btn--active" : "pos-charge-modal__method-btn")"
                                        @onclick="() => HandlePaymentMethodClickAsync(method.Codigo)">
                                    <strong>@method.Descripcion</strong>
                                    <span>@(string.IsNullOrWhiteSpace(method.CodigoOpcional) ? method.Codigo : method.CodigoOpcional) @(!string.IsNullOrWhiteSpace(method.MedioDePago) ? $"· {method.MedioDePago}" : string.Empty)</span>
                                </button>
                            }
                        </div>
                    </div>
                }

            </section>

            <section class="pos-charge-modal__section">
                <h4>Pagos aplicados</h4>

                @if (!_paymentLines.Any())
                {
                    <div class="pos-grid-status">Todavía no agregaste pagos.</div>
                }
                else
                {
                    <div class="pos-charge-modal__list">
                        @foreach (var line in _paymentLines.ToList())
                        {
                            <div class="pos-charge-modal__line" @key="line">
                                <div>
                                    <strong>@line.DescripcionMedioPago</strong>
                                    <span>@line.CodigoMedioPago</span>
                                    @if (line.Recargo > 0)
                                    {
                                        <small class="pos-charge-modal__line-surcharge">Recargo Point: @FmtMoney(line.Recargo)</small>
                                    }
                                </div>
                                <strong>@FmtMoney(line.Importe)</strong>
                                <button type="button" @onclick="() => SolicitarEliminarLineaPago(line)" @onclick:stopPropagation="true" @onclick:preventDefault="true"><i class="bi bi-x-lg"></i></button>
                            </div>
                        }
                    </div>
                }

                <div class="pos-charge-modal__summary">
                    <div class="pos-charge-modal__summary-row">
                        <span>Total cobrado</span>
                        <strong>@FmtMoney(TotalPagado)</strong>
                    </div>
                    @if (TotalRecargosPoint > 0)
                    {
                        <div class="pos-charge-modal__summary-row">
                            <span>Recargos Point</span>
                            <strong>@FmtMoney(TotalRecargosPoint)</strong>
                        </div>
                    }
                    <div class="pos-charge-modal__summary-row pos-charge-modal__summary-row--pending">
                        <span>Pendiente</span>
                        <strong>@FmtMoney(PendienteCobro)</strong>
                    </div>
                    <div class="@(VueltoCobro > 0 ? "pos-charge-modal__summary-row pos-charge-modal__summary-row--change" : "pos-charge-modal__summary-row")">
                        <span>Vuelto</span>
                        <strong>@FmtMoney(VueltoCobro)</strong>
                    </div>
                    <div class="pos-charge-modal__summary-row">
                        <span>Comprobante</span>
                        <strong>@TipoComprobanteSeleccionadoLabel()</strong>
                    </div>
                </div>
            </section>
        </div>
        }

        <div class="pos-charge-modal__footer">
            <div class="pos-charge-modal__actions">
                <button type="button" class="pos-charge-modal__accept-print" @onclick="() => ConfirmChargeAsync(true)" disabled="@(_chargeSaving || _mpCobrando || !_cartItems.Any())">
                    @(EsRemitoONotaPedido ? "GENERAR E IMPRIMIR" : "ACEPTAR E IMPRIMIR")
                </button>
                <button type="button" class="pos-charge-modal__save" @onclick="() => ConfirmChargeAsync(false)" disabled="@(_chargeSaving || _mpCobrando || !_cartItems.Any())">
                    @(_chargeSaving ? "Grabando..." : EsRemitoONotaPedido ? "GENERAR" : "ACEPTAR")
                </button>
                <button type="button" class="pos-charge-modal__ghost" @onclick="CloseChargeModal" disabled="@_chargeSaving">CANCELAR</button>
            </div>
            <div class="pos-shortcuts-hint pos-shortcuts-hint--modal" aria-label="Atajos de la cobranza">
                <span class="pos-shortcuts-hint__title">Atajos</span>
                <span><kbd>Ctrl+G</kbd> Aceptar</span>
                <span><kbd>Esc</kbd> Cerrar</span>
            </div>
        </div>
    </section>
}

@if (_showReceiptModal && _lastSaleResult is not null)
{
    <div class="pos-item-modal-backdrop" aria-hidden="true"></div>
    <section class="pos-receipt-modal @(_mobileReceiptPreviewOpen ? "pos-receipt-modal--mobile-preview" : string.Empty)" aria-label="Comprobante generado" @onclick:stopPropagation="true">
        <section class="pos-receipt-modal__actions-panel">
            <div class="pos-receipt-modal__header">
                <div>
                    <h3>@(_receiptIsAnticipo ? "Recibo de anticipo" : "Recibo")</h3>
                    <p>Imprimí el comprobante, envialo por email o seguí con una nueva venta.</p>
                </div>
                <button type="button" class="pos-receipt-modal__close" @onclick="CloseReceiptModal">X</button>
            </div>

            <div class="pos-receipt-modal__total">
                <span>Total cobrado</span>
                <strong>@FmtMoney(_lastSaleResult.Total)</strong>
                <small>Venta finalizada</small>
            </div>

            <button type="button" class="pos-receipt-modal__print" @onclick="PrintReceiptAsync">
                <i class="bi bi-printer"></i>
                Imprimir recibo
            </button>

            @if (_anticipoReceiptData is not null)
            {
                <button type="button" class="pos-receipt-modal__print" @onclick="PrintAnticipoReceiptAsync" disabled="@_anticipoPrinting">
                    <i class="bi bi-cash-coin"></i>
                    @(_anticipoPrinting ? "Preparando recibo de anticipo..." : "Imprimir recibo de anticipo")
                </button>
            }

            <div class="pos-receipt-modal__contact-grid">
                <div class="pos-receipt-modal__mail">
                    <label for="pos-receipt-email">Enviar por email</label>
                    <div class="pos-receipt-modal__mail-row">
                        <input id="pos-receipt-email" type="email" @bind="_receiptEmail" placeholder="cliente@email.com" />
                        <button type="button" @onclick="SendReceiptEmailAsync" disabled="@_receiptEmailSending">
                            @(_receiptEmailSending ? "Enviando..." : "Enviar")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_receiptEmailFeedback))
                    {
                        <div class="pos-receipt-modal__mail-feedback pos-receipt-modal__mail-feedback--ok">@_receiptEmailFeedback</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_receiptEmailError))
                    {
                        <div class="pos-receipt-modal__mail-feedback pos-receipt-modal__mail-feedback--error">@_receiptEmailError</div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_receiptPublicQrDataUrl))
                {
                    <button type="button" class="pos-receipt-modal__public-qr" @onclick="OpenPublicQrModal" aria-label="Ampliar código QR del comprobante">
                        <img src="@_receiptPublicQrDataUrl" alt="Código QR para ver el comprobante" />
                        <div>
                            <strong>Ver desde el celular</strong>
                            <span>Escaneá para consultar la factura.</span>
                        </div>
                    </button>
                }
            </div>

            <button type="button" class="pos-receipt-mobile-preview-trigger" @onclick="OpenMobileReceiptPreview">
                <span class="pos-receipt-mobile-preview-trigger__icon"><i class="bi bi-file-earmark-text"></i></span>
                <span>
                    <strong>Vista previa del comprobante</strong>
                    <small>@($"{_lastSaleResult.TipoComprobante} {_lastSaleResult.IdComprobanteTexto}")</small>
                </span>
                <i class="bi bi-chevron-right"></i>
            </button>

            @if (_lastSaleResult.CaeEstado == "Aprobado")
            {
                <div class="pos-receipt-modal__cae pos-receipt-modal__cae--aprobado">
                    <span>CAE: @_lastSaleResult.Cae — Vto @(_lastSaleResult.CaeVencimiento?.ToString("dd/MM/yyyy"))</span>
                </div>
            }
            else if (_lastSaleResult.CaeEstado is "Rechazado" or "Pendiente")
            {
                var esRechazado = _lastSaleResult.CaeEstado == "Rechazado";
                <div class="pos-receipt-modal__cae @(esRechazado ? "pos-receipt-modal__cae--alerta" : "pos-receipt-modal__cae--pendiente")">
                    <span>
                        @(esRechazado
                            ? $"Comprobante SIN autorización AFIP — {_lastSaleResult.CaeMotivo}. No debe entregarse como factura fiscal hasta regularizar."
                            : "CAE pendiente de autorización (ARCA no respondió). Reintentá en unos minutos.")
                    </span>
                    <button type="button" class="pos-receipt-modal__cae-retry" @onclick="RetryCaeAsync" disabled="@_caeRetryInProgress">
                        @(_caeRetryInProgress ? "Reintentando..." : "Reintentar CAE")
                    </button>
                </div>
            }

            <button type="button" class="pos-receipt-modal__new" @onclick="ContinueWithNewReceipt">
                <span class="pos-receipt-modal__new-icon"><i class="bi bi-arrow-right-circle"></i></span>
                <span>Nuevo comprobante</span>
            </button>
        </section>

        <section class="pos-receipt-modal__preview">
            <div class="pos-receipt-modal__preview-header">
                <div>
                    <h4>Vista previa del comprobante</h4>
                    <p>
                        @($"{_lastSaleResult.TipoComprobante} {_lastSaleResult.IdComprobanteTexto}")
                        @if (_receiptIsReprint)
                        {
                            <span class="pos-receipt-modal__flag">REIMPRESION</span>
                        }
                    </p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_receiptPreviewHtml))
            {
                <iframe class="pos-receipt-modal__designer-frame"
                        title="Vista previa del comprobante diseñado"
                        srcdoc="@_receiptPreviewHtml"></iframe>
            }
            else if (!string.IsNullOrWhiteSpace(_receiptPreviewError))
            {
                <div class="pos-receipt-modal__preview-loading">@_receiptPreviewError</div>
            }
            else
            {
                <div class="pos-receipt-modal__preview-loading">Cargando la plantilla del diseñador...</div>
            }
            <iframe id="pos-receipt-frame" class="pos-receipt-modal__frame pos-receipt-modal__frame--hidden" title="Impresión ticket POS"></iframe>

            @if (_anticipoReceiptData is not null)
            {
                <div class="pos-receipt-modal__preview-header" style="margin-top: 1rem;">
                    <div>
                        <h4>Vista previa del anticipo</h4>
                        <p>@($"{_anticipoReceiptData.Resultado.TipoComprobante} {_anticipoReceiptData.Resultado.IdComprobanteTexto}")</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_anticipoReceiptPreviewHtml))
                {
                    <iframe class="pos-receipt-modal__designer-frame"
                            title="Vista previa del recibo de anticipo"
                            srcdoc="@_anticipoReceiptPreviewHtml"></iframe>
                }
                else if (!string.IsNullOrWhiteSpace(_anticipoReceiptPreviewError))
                {
                    <div class="pos-receipt-modal__preview-loading">@_anticipoReceiptPreviewError</div>
                }
                else
                {
                    <div class="pos-receipt-modal__preview-loading">Cargando el recibo de anticipo...</div>
                }
                <iframe id="pos-anticipo-receipt-frame" class="pos-receipt-modal__frame pos-receipt-modal__frame--hidden" title="Impresión recibo de anticipo"></iframe>
            }
        </section>

        @if (_mobileReceiptPreviewOpen)
        {
            <section class="pos-receipt-mobile-preview" aria-label="Vista previa completa del comprobante">
                <div class="pos-receipt-mobile-preview__header">
                    <div>
                        <h4>Vista previa</h4>
                        <p>@($"{_lastSaleResult.TipoComprobante} {_lastSaleResult.IdComprobanteTexto}")</p>
                    </div>
                    <button type="button" class="pos-receipt-modal__close" @onclick="CloseMobileReceiptPreview" aria-label="Volver al recibo">X</button>
                </div>
                <div class="pos-receipt-mobile-preview__document">
                    @if (!string.IsNullOrWhiteSpace(_receiptPreviewHtml))
                    {
                        <iframe class="pos-receipt-modal__designer-frame" title="Vista previa completa del comprobante" srcdoc="@_receiptPreviewHtml"></iframe>
                    }
                    else if (!string.IsNullOrWhiteSpace(_receiptPreviewError))
                    {
                        <div class="pos-receipt-modal__preview-loading">@_receiptPreviewError</div>
                    }
                    else
                    {
                        <div class="pos-receipt-modal__preview-loading">Cargando la plantilla del diseñador...</div>
                    }
                </div>
                <button type="button" class="pos-receipt-modal__print" @onclick="PrintReceiptAsync">
                    <i class="bi bi-printer"></i>
                    Imprimir recibo
                </button>
            </section>
        }
    </section>

    @if (_showPublicQrModal && !string.IsNullOrWhiteSpace(_receiptPublicQrDataUrl))
    {
        <button type="button" class="pos-public-qr-backdrop" aria-label="Cerrar QR ampliado" @onclick="ClosePublicQrModal"></button>
        <section class="pos-public-qr-modal" aria-label="Código QR ampliado" @onclick:stopPropagation="true">
            <button type="button" class="pos-public-qr-modal__close" @onclick="ClosePublicQrModal">X</button>
            <h4>Escaneá para ver el comprobante</h4>
            <img src="@_receiptPublicQrDataUrl" alt="Código QR ampliado para ver el comprobante" />
            <p>Acercá la cámara del celular al código QR.</p>
            @if (!string.IsNullOrWhiteSpace(_receiptPublicUrl))
            {
                <a class="pos-public-qr-modal__link" href="@_receiptPublicUrl" target="_blank" rel="noopener noreferrer">
                    Abrir enlace del comprobante
                </a>
            }
        </section>
    }
}

@if (_showReprintModal)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar reimpresión" @onclick="CloseReprintModal"></button>
    <section class="pos-settings-modal pos-reprint-modal" aria-label="Reimprimir comprobantes">
        <div class="pos-settings-modal__header">
            <div>
                <h3>Reimprimir comprobantes</h3>
                <p>Se listan del más reciente al más viejo.</p>
            </div>
            <button type="button" class="pos-settings-modal__close" @onclick="CloseReprintModal">X</button>
        </div>

        <div class="pos-reprint-filters">
            <label>
                <span>Desde</span>
                <input type="date" value="@_reprintDateDesdeText" @onchange="OnReprintDateDesdeChanged" />
            </label>
            <label>
                <span>Hasta</span>
                <input type="date" value="@_reprintDateHastaText" @onchange="OnReprintDateHastaChanged" />
            </label>
            <button type="button" class="btn btn--primary" @onclick="LoadReprintAsync" disabled="@_reprintLoading">Buscar</button>
        </div>

        @if (_reprintLoading)
        {
            <div class="pos-grid-status">Cargando comprobantes recientes...</div>
        }
        else if (!_recentReceipts.Any())
        {
            <div class="pos-grid-status">No hay comprobantes recientes para reimprimir.</div>
        }
        else
        {
            <div class="pos-encargos-table-wrap">
                @foreach (var receipt in _recentReceipts)
                {
                    <button type="button" class="pos-reprint-item" @onclick="() => OpenExistingReceiptAsync(receipt.IdComprobante)">
                        <div class="pos-reprint-item__header">
                            <strong>@($"{receipt.TipoComprobante} {receipt.IdComprobanteTexto}")</strong>
                            @if (receipt.Impreso)
                            {
                                <span class="pos-receipt-modal__flag">REIMPRESION</span>
                            }
                        </div>
                        <div class="pos-reprint-item__meta">
                            <span>@DisplayValueOrDash(receipt.Cliente)</span>
                            <strong>@FmtMoney(receipt.Total)</strong>
                        </div>
                        <div class="pos-reprint-item__footer">
                            <span>@(receipt.FechaHora?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                        </div>
                    </button>
                }
            </div>
        }
    </section>
}

@if (_showNpAnticiposModal && EsMostradorProduccion)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar consulta de anticipos" @onclick="CloseNpAnticiposModal"></button>
    <section class="pos-settings-modal pos-reprint-modal pos-encargos-modal" aria-label="Consultar pedidos">
        <div class="pos-settings-modal__header">
            <div>
                <h3>@(_npVistaProduccion ? "Producción" : "Consultar pedidos")</h3>
                <p>@(_npVistaProduccion
                    ? "Monitor de NP comerciales pendientes, con avance de preparación y entrega. Solo lectura; se actualiza cada 30 segundos."
                    : "Consultá y revisá tus últimos encargos. Esta pantalla es solo de lectura.")</p>
            </div>
            <button type="button" class="pos-settings-modal__close" @onclick="CloseNpAnticiposModal">X</button>
        </div>

        <div class="pos-reprint-filters pos-encargos-filters">
            <div class="pos-encargos-filters__primary">
            <label class="pos-encargos-filter--search">
                <span>Buscar en todo</span>
                <input class="pos-settings-modal__input" type="text" value="@_npAnticiposIdComprobante"
                       @oninput="OnNpAnticiposIdChanged" @onkeydown="HandleNpAnticiposKeyDown"
                       placeholder="Comprobante, cliente, DNI/CUIT o teléfono" autocomplete="off" />
            </label>
            </div>
            <div class="pos-encargos-filters__secondary">
            <label>
                <span>Fecha desde</span>
                <input class="pos-settings-modal__input" type="date" @bind="_npFechaDesdeInput" />
            </label>
            <label>
                <span>Fecha hasta</span>
                <input class="pos-settings-modal__input" type="date" @bind="_npFechaHastaInput" />
            </label>
            <label>
                <span>Estado</span>
                <select class="pos-settings-modal__input pos-encargos-select" @bind="_npEstadoInput">
                    <option value="">Todos</option>
                    <option value="PENDIENTE">Pendiente</option>
                    <option value="CERRADA">Cerrada</option>
                    <option value="FINALIZADA">Finalizada</option>
                    <option value="BLOQUEADA">Bloqueada</option>
                    <option value="ANULADA">Anulada</option>
                </select>
            </label>
            <button type="button" class="btn btn--primary" @onclick="BuscarEncargosDesdeFiltrosAsync" disabled="@_npAnticiposLoading">Buscar</button>
            <button type="button" class="btn btn--secondary" @onclick="ActualizarEncargosAsync" disabled="@_npAnticiposLoading" title="Actualizar listado"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </div>

        @if (_npAnticiposResultado is null && _npAnticiposListado is { } resumenPedidos)
        {
            var pedidosVisibles = resumenPedidos.Items;
            var totalPedidos = pedidosVisibles.Count;
            var importePedidos = pedidosVisibles.Sum(x => x.ImporteComercial);
            var senasPedidos = pedidosVisibles.Where(x => x.TotalAnticiposVerificado).Sum(x => x.TotalAnticiposVigentes ?? 0m);
            var saldoPedidos = pedidosVisibles.Where(x => x.TotalAnticiposVerificado)
                .Sum(x => Math.Max(x.ImporteComercial - (x.TotalAnticiposVigentes ?? 0m), 0m));
            <div class="pos-encargos-kpis" aria-label="Resumen de pedidos visibles">
                <div class="pos-encargos-kpi"><span>Pedidos pendientes visibles</span><strong>@totalPedidos</strong></div>
                <div class="pos-encargos-kpi"><span>Importe comercial</span><strong>@FmtMoney(importePedidos)</strong></div>
                <div class="pos-encargos-kpi pos-encargos-kpi--accent"><span>Señas verificadas</span><strong>@FmtMoney(senasPedidos)</strong></div>
                <div class="pos-encargos-kpi"><span>Saldo verificado</span><strong>@FmtMoney(saldoPedidos)</strong></div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_npAnticiposError))
        {
            <div class="pos-charge-modal__feedback pos-charge-modal__feedback--error">@_npAnticiposError</div>
        }
        else if (_npAnticiposLoading)
        {
            <div class="pos-grid-status">Consultando la nota de pedido...</div>
        }
        else if (_npAnticiposResultado is null)
        {
            <div class="pos-reprint-list">
                @if (_npAnticiposListado?.Items.Count is not > 0)
                {
                    <div class="pos-grid-status">No se encontraron encargos con los filtros indicados.</div>
                }
                else
                {
                    <table class="pos-encargos-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Comprobante</th>
                                <th>Cliente</th>
                                <th class="pos-encargos-table__number">Total</th>
                                <th class="pos-encargos-table__number">Seña</th>
                                <th class="pos-encargos-table__number">Saldo</th>
                                <th>Estado</th>
                                <th>Fecha de entrega</th>
                                <th aria-label="Acciones"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var encargo in _npAnticiposListado!.Items)
                            {
                                var puedeFacturar = PuedeFacturarEncargo(encargo);
                                <tr class="pos-encargos-table__row" @ondblclick="() => FacturarEncargoDesdeListado(encargo)" title="Doble clic para cargar en el POS y facturar">
                                    <td>@(encargo.Fecha?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td><strong>@encargo.IdComprobante</strong></td>
                                    <td>@DisplayValueOrDash(encargo.Cliente)</td>
                                    <td class="pos-encargos-table__number">@FmtMoney(encargo.ImporteComercial)</td>
                                    <td class="pos-encargos-table__number">@(encargo.TotalAnticiposVerificado ? FmtMoney(encargo.TotalAnticiposVigentes ?? 0m) : PuntoVentaAnticiposEstados.NoVerificado)</td>
                                    <td class="pos-encargos-table__number">@(encargo.TotalAnticiposVerificado ? FmtMoney(Math.Max(encargo.ImporteComercial - (encargo.TotalAnticiposVigentes ?? 0m), 0m)) : PuntoVentaAnticiposEstados.NoVerificado)</td>
                                    <td><span class="pos-encargo-state @EstadoEncargoCss(encargo.EstadoComprobante)">@EstadoEncargoTexto(encargo.EstadoComprobante)</span></td>
                                    <td>@(encargo.FechaEntrega?.ToString("dd/MM/yyyy HH:mm") ?? "A coordinar")</td>
                                    <td class="pos-encargos-table__actions">
                                        <button type="button" class="btn btn--primary btn--sm" disabled="@(!puedeFacturar)" title="Cargar en el POS" @onclick="() => FacturarEncargoDesdeListado(encargo)">Facturar</button>
                                        <button type="button" class="btn btn--secondary btn--sm" title="Ver detalle" @onclick="() => AbrirDetalleEncargoAsync(encargo)">Detalle</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            @if (_npAnticiposListado is { TotalPaginas: > 1 })
            {
                <div class="pos-reprint-item__footer">
                    <button type="button" class="btn btn--secondary" @onclick="() => CambiarPaginaEncargosAsync(-1)" disabled="@(_npAnticiposPagina <= 1)">Anterior</button>
                    <span>Página @_npAnticiposPagina de @_npAnticiposListado.TotalPaginas</span>
                    <button type="button" class="btn btn--secondary" @onclick="() => CambiarPaginaEncargosAsync(1)" disabled="@(!_npAnticiposListado.TieneSiguiente)">Siguiente</button>
                </div>
            }
        }
        else
        {
            var np = _npAnticiposResultado;
            <div class="pos-encargo-detail">
                <div class="pos-encargo-summary">
                    <div class="pos-encargo-summary__main">
                        <span class="pos-encargo-summary__label">Cliente</span>
                        <strong>@DisplayValueOrDash(np.Cliente)</strong>
                        <span class="pos-encargo-summary__account">Cuenta @DisplayValueOrDash(np.Cuenta)</span>
                    </div>
                    <div class="pos-encargo-summary__status">
                        <span class="pos-encargo-summary__label">Estado</span>
                        <span class="pos-encargo-status">@np.EstadoComprobante</span>
                    </div>
                    <div class="pos-encargo-summary__metric">
                        <span class="pos-encargo-summary__label">Fecha</span>
                        <strong>@(np.Fecha?.ToString("dd/MM/yyyy") ?? "-")</strong>
                    </div>
                    <div class="pos-encargo-summary__metric">
                        <span class="pos-encargo-summary__label">Importe comercial</span>
                        <strong>@FmtMoney(np.ImporteComercial)</strong>
                    </div>
                    <div class="pos-encargo-summary__metric">
                        <span class="pos-encargo-summary__label">Anticipos vigentes</span>
                        <strong>@(np.TotalAnticiposVerificado ? FmtMoney(np.TotalAnticiposVigentes ?? 0m) : PuntoVentaAnticiposEstados.NoVerificado)</strong>
                    </div>
                    <div class="pos-encargo-summary__metric pos-encargo-summary__metric--total">
                        <span class="pos-encargo-summary__label">Saldo pendiente</span>
                        <strong>@(np.TotalAnticiposVerificado ? FmtMoney(Math.Max(np.ImporteComercial - (np.TotalAnticiposVigentes ?? 0m), 0m)) : PuntoVentaAnticiposEstados.NoVerificado)</strong>
                    </div>
                </div>

                <div class="pos-encargo-delivery">
                    <div><span>Entrega</span><strong>@(np.FechaEntrega?.ToString("dd/MM/yyyy HH:mm") ?? "A coordinar")@IndicadorEntrega(np.FechaEntrega, np.EstadoEntrega)</strong></div>
                    <div><span>Teléfono</span><strong>@(string.IsNullOrWhiteSpace(np.Telefono) ? "No informado" : np.Telefono)</strong></div>
                    <div><span>Preparación</span><strong>@(np.FechaPreparacion?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente de producción")</strong></div>
                    <div><span>Estado producción</span><strong>@np.EstadoProduccion</strong></div>
                    <div><span>Estado entrega</span><strong>@np.EstadoEntrega</strong></div>
                </div>
                <div class="pos-encargo-actions">
                    <button type="button" class="btn btn--secondary" @onclick="() => ImprimirEncargoAsync(np)" disabled="@_npPrinting">
                        <i class="bi bi-printer"></i> @(_npPrinting ? "Preparando impresión..." : "Imprimir nota")
                    </button>
                    <button type="button" class="btn btn--secondary" @onclick="() => ImprimirTicketProduccionAsync(np)" disabled="@_npPrinting">
                        <i class="bi bi-card-checklist"></i> Ticket de producción
                    </button>
                    @if (!string.Equals(np.EstadoComprobante, "ANULADA", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(np.EstadoComprobante, "FINALIZADA", StringComparison.OrdinalIgnoreCase))
                    {
                        <button type="button" class="btn btn--secondary" @onclick="() => EditarNotaPedidoAsync(np)">
                            <i class="bi bi-pencil"></i> Editar pedido
                        </button>
                    }
                    @if (!string.Equals(np.EstadoComprobante, "ANULADA", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(np.EstadoComprobante, "FINALIZADA", StringComparison.OrdinalIgnoreCase))
                    {
                        <button type="button" class="btn btn--primary" @onclick="() => FacturarEncargoDesdeDetalleAsync(np)">
                            <i class="bi bi-receipt"></i> Cargar en el POS
                        </button>
                        <span>La NP se carga en el carrito actual para continuar la facturación.</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_npPrintError))
                {
                    <div class="pos-charge-modal__feedback pos-charge-modal__feedback--error">@_npPrintError</div>
                }
                @if (!string.IsNullOrWhiteSpace(np.Observaciones))
                {
                    <div class="pos-encargo-observations"><span>Observaciones</span><strong>@np.Observaciones</strong></div>
                }

                @if (!np.TotalAnticiposVerificado)
                {
                    <div class="pos-encargo-alert">
                        <strong>Saldo no verificado</strong>
                        <span>No utilices estos importes para cobrar hasta revisar las cobranzas relacionadas.</span>
                    </div>
                }

                <section class="pos-encargo-section">
                    <div class="pos-encargo-section__heading">
                        <div>
                            <h4>Cobranzas relacionadas</h4>
                            <p>Señas y pagos asociados a esta nota de pedido.</p>
                        </div>
                        <span class="pos-encargo-section__count">@np.Cobranzas.Count</span>
                    </div>
                    @if (np.Cobranzas.Count == 0)
                    {
                        <div class="pos-encargo-empty">No se encontraron cobranzas relacionadas.</div>
                    }
                    else
                    {
                        <div class="pos-encargo-cobranzas">
                            @foreach (var cobranza in np.Cobranzas)
                            {
                                <article class="pos-encargo-cobranza">
                                    <div class="pos-encargo-cobranza__top">
                                        <strong>@($"{cobranza.Tc} {cobranza.IdComprobante}")</strong>
                                        <span class="pos-receipt-modal__flag">@(cobranza.Anulada ? PuntoVentaAnticiposEstados.Anulado : cobranza.EstadoDisponible)</span>
                                    </div>
                                    <div class="pos-encargo-cobranza__values">
                                        <div><span>Original</span><strong>@FmtMoney(cobranza.ImporteOriginal)</strong></div>
                                        <div><span>Aplicado</span><strong>@(cobranza.ImporteAplicado.HasValue ? FmtMoney(cobranza.ImporteAplicado.Value) : PuntoVentaAnticiposEstados.NoVerificado)</strong></div>
                                        <div><span>Disponible</span><strong>@(cobranza.PuedeUsarseComoAnticipo && cobranza.ImporteDisponible.HasValue ? FmtMoney(cobranza.ImporteDisponible.Value) : PuntoVentaAnticiposEstados.NoVerificado)</strong></div>
                                    </div>
                                    <div class="pos-encargo-cobranza__bottom">
                                        <span>@(cobranza.Fecha?.ToString("dd/MM/yyyy") ?? "-")</span>
                                        <span>Relación: @cobranza.TipoRelacion</span>
                                        <span>Finanzas: @(cobranza.Anulada ? PuntoVentaAnticiposEstados.Anulado : cobranza.EstadoDisponible)</span>
                                    </div>
                                    @if (!cobranza.RelacionVerificada)
                                    {
                                        <div class="pos-charge-modal__feedback pos-charge-modal__feedback--error">
                                            @DisplayValueOrDash(cobranza.AdvertenciaRelacion)
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>

                <section class="pos-encargo-section">
                    <div class="pos-encargo-section__heading">
                        <div>
                            <h4>Artículos del encargo</h4>
                            <p>Detalle comercial y avance de preparación.</p>
                        </div>
                        <span class="pos-encargo-section__count">@np.Items.Count</span>
                    </div>
                    @if (np.Items.Count == 0)
                    {
                        <div class="pos-encargo-empty">No se encontraron artículos para esta nota.</div>
                    }
                    else
                    {
                        <div class="pos-encargo-items">
                            @foreach (var item in np.Items)
                            {
                                var progreso = item.Cantidad <= 0 ? 0 : Math.Clamp(item.CantidadPreparada / item.Cantidad * 100m, 0m, 100m);
                                <article class="pos-encargo-item">
                                    <div class="pos-encargo-item__description">
                                        <strong>@item.Descripcion</strong>
                                        <span>@item.IdArticulo@(string.IsNullOrWhiteSpace(item.Presentacion) ? string.Empty : $" · {item.Presentacion}")</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                        {
                                            <small>@item.Observaciones</small>
                                        }
                                    </div>
                                    <div class="pos-encargo-item__numbers">
                                        <span>@item.Cantidad.ToString("0.####")</span>
                                        <span>@FmtMoney(item.Precio)</span>
                                        <strong>@FmtMoney(item.Importe)</strong>
                                    </div>
                                    <div class="pos-encargo-item__progress">
                                        <span>Preparado @item.CantidadPreparada.ToString("0.####") / @item.Cantidad.ToString("0.####")</span>
                                        <div><i style="@($"width:{progreso:0.##}%")"></i></div>
                                        <small>Entregado en mostrador: @item.CantidadEntregada.ToString("0.####") / @item.Cantidad.ToString("0.####")</small>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                <section class="pos-encargo-section pos-encargo-section--history">
                    <div class="pos-encargo-section__heading">
                        <div>
                            <h4>Historial de acciones</h4>
                            <p>Registro de cambios realizados sobre la nota de pedido.</p>
                        </div>
                        <span class="pos-encargo-section__count">@np.Acciones.Count</span>
                    </div>
                    @if (np.Acciones.Count == 0)
                    {
                        <div class="pos-encargo-empty">No hay acciones registradas.</div>
                    }
                    else
                    {
                        <div class="pos-encargo-cobranzas">
                            @foreach (var accion in np.Acciones)
                            {
                                <article class="pos-encargo-cobranza pos-encargo-action">
                                    <div class="pos-encargo-cobranza__top"><strong>@DisplayValueOrDash(accion.TipoAccion)</strong><span>@(accion.FechaHora?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span></div>
                                    <div class="pos-encargo-cobranza__bottom"><span>@DisplayValueOrDash(accion.Usuario)</span><span>@DisplayValueOrDash(accion.Comentario)</span></div>
                                </article>
                            }
                        </div>
                    }
                </section>
            </div>
        }
    </section>
}

<iframe id="pos-np-print-frame" class="pos-receipt-modal__frame pos-receipt-modal__frame--hidden" title="Impresión de nota de pedido"></iframe>

@if (_showSettingsModal)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar configuración" @onclick="CloseSettingsModal"></button>
    <section class="pos-settings-modal" aria-label="Configuración del punto de venta">
        <div class="pos-settings-modal__header">
            <div>
                <h3>Configuración</h3>
                <p>Administrá las claves activas del POS sin perder el carrito ni los filtros cargados.</p>
            </div>
            <button type="button" class="pos-settings-modal__close" @onclick="CloseSettingsModal">X</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_settingsFeedback))
        {
            <div class="pos-settings-modal__feedback">@_settingsFeedback</div>
        }

        @if (!string.IsNullOrWhiteSpace(_settingsError))
        {
            <div class="pos-settings-modal__feedback pos-settings-modal__feedback--error">@_settingsError</div>
        }

        <div class="pos-settings-modal__grid">
            <section class="pos-settings-modal__section">
                <h4>Claves editables</h4>
                <p>Estos valores se guardan en <code>TA_CONFIGURACION</code> sobre la base activa.</p>

                <div class="pos-settings-modal__field">
                    <label>Clase de precio default</label>
                    <select @bind="_settings.ClasePrecioDefault">
                        @for (var clase = 1; clase <= 8; clase++)
                        {
                            <option value="@clase.ToString()">@clase</option>
                        }
                    </select>
                </div>

                <div class="pos-settings-modal__field">
                    <label>VERIFICADOR_RUTAIMAGENES</label>
                    <input @bind="_settings.VerificadorRutaImagenes" placeholder="\\\\SERVER\\C\\NETSISTEMAS\\..." />
                </div>

                <div class="pos-settings-modal__field">
                    <label>CUENTACONSUMIDORFINAL</label>
                    <input @bind="_settings.CuentaConsumidorFinal" placeholder="112010001" />
                </div>

                <label class="pos-settings-modal__check-field">
                    <input type="checkbox" @bind="_settings.RecargoTarjetaSinIva" />
                    <span>
                        <strong>Recargo por tarjeta sin IVA</strong>
                        <small>cfgRecargoTJTSinIVA: el recargo se informa completo y no genera IVA.</small>
                    </span>
                </label>

                <div class="pos-settings-modal__field">
                    <label>Máximo de entrega (km)</label>
                    <input type="number" min="0" step="0.1" @bind="_settings.DistanciaMaximaEntregaKm" placeholder="Vacío = sin límite" />
                    <small>Se compara con la distancia legacy de TA_DistLocalidades por localidad.</small>
                </div>

                <div class="pos-settings-modal__field">
                    <label>EMAIL_SERVER</label>
                    <input @bind="_settings.EmailServer" placeholder="smtp.servidor.com" />
                </div>

                <div class="pos-settings-modal__field">
                    <label>EMAIL_PORT</label>
                    <input @bind="_settings.EmailPort" placeholder="587" />
                </div>

                <div class="pos-settings-modal__field">
                    <label>EMAIL_CTA</label>
                    <input @bind="_settings.EmailCuenta" placeholder="noreply@empresa.com" />
                </div>

                <div class="pos-settings-modal__field">
                    <label>EMAIL_PASS</label>
                    <input type="password" @bind="_settings.EmailPassword" placeholder="Contraseña SMTP" />
                </div>

                <div class="pos-settings-modal__field">
                    <label>EMAIL_SSL</label>
                    <select @bind="_settings.EmailSsl">
                        <option value="">No</option>
                        <option value="SI">Sí</option>
                    </select>
                </div>
            </section>

            <section class="pos-settings-modal__section">
                <h4>Lectura actual del POS</h4>
                <div class="pos-settings-modal__field">
                    <label>Usuario actual</label>
                    <div class="pos-settings-modal__readonly">@(_context?.UsuarioActual ?? "-")</div>
                </div>
                <div class="pos-settings-modal__field">
                    <label>Caja actual</label>
                    <div class="pos-settings-modal__readonly">@(_context?.CajaActual ?? "-")</div>
                </div>
                <div class="pos-settings-modal__field">
                    <label>TC / sucursal</label>
                    <div class="pos-settings-modal__readonly">@(_context?.TipoComprobanteDefault ?? "FC") / @SucursalOperativa</div>
                </div>
                <div class="pos-settings-modal__field">
                    <label>RUTAIMAGENES heredada</label>
                    <div class="pos-settings-modal__readonly">@DisplayValueOrDash(_settings.RutaImagenesLegacy)</div>
                </div>
                <div class="pos-settings-modal__field">
                    <label>Orden de búsqueda de imágenes</label>
                    <ol class="pos-settings-modal__flow">
                        <li><code>VERIFICADOR_RUTAIMAGENES + RutaImagen</code></li>
                        <li><code>ContentRootPath + RutaImagen</code></li>
                        <li>Si <code>RutaImagen</code> es absoluta, se usa directamente.</li>
                    </ol>
                </div>
            </section>
        </div>

        <div class="pos-settings-modal__actions">
            <button type="button" class="pos-settings-modal__ghost" @onclick="CloseSettingsModal" disabled="@_settingsSaving">Cerrar</button>
            <button type="button" class="pos-settings-modal__save" @onclick="SavePosSettingsAsync" disabled="@_settingsSaving">
                @( _settingsSaving ? "Guardando..." : "Guardar configuración" )
            </button>
        </div>
    </section>
}

@if (_showCashInOutModal)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar ingreso/egreso" @onclick="CloseCashInOutModal"></button>
    <section class="pos-panel-modal pos-panel-modal--narrow" aria-label="Ingresos/Egresos de caja">
        <div class="pos-settings-modal__header">
            <div>
                <h3>Ingresos/Egresos</h3>
            </div>
            <button type="button" class="pos-settings-modal__close" @onclick="CloseCashInOutModal">X</button>
        </div>

        <div class="pos-cashinout__body">
            <div class="pos-cashinout__type-row">
                <button type="button"
                        class="@(_cashInOutTipo == "I" ? "pos-cashinout__type-btn pos-cashinout__type-btn--active" : "pos-cashinout__type-btn")"
                        @onclick='() => _cashInOutTipo = "I"'>
                    Ingreso
                </button>
                <button type="button"
                        class="@(_cashInOutTipo == "E" ? "pos-cashinout__type-btn pos-cashinout__type-btn--active" : "pos-cashinout__type-btn")"
                        @onclick='() => _cashInOutTipo = "E"'>
                    Egreso
                </button>
                <div class="pos-cashinout__amount-wrap">
                    <span class="pos-cashinout__currency">$</span>
                    <input type="number"
                           class="pos-cashinout__amount"
                           min="0.01"
                           step="0.01"
                           placeholder="00.00"
                           @bind="_cashInOutImporte"
                           @bind:event="oninput" />
                    <span class="pos-cashinout__currency-end">$</span>
                </div>
            </div>

            <div class="pos-cashinout__field">
                <label class="pos-cashinout__label">Imputación</label>
                @if (_cashInOutCuentasLoading)
                {
                    <div class="pos-cashinout__loading">Cargando cuentas...</div>
                }
                else
                {
                    <select class="pos-cashinout__select" @bind="_cashInOutCuenta">
                        <option value="">— Seleccionar —</option>
                        @foreach (var c in _cashInOutCuentas)
                        {
                            <option value="@c.Codigo">@c.Descripcion</option>
                        }
                    </select>
                }
            </div>

            <div class="pos-cashinout__field">
                <label class="pos-cashinout__label">Motivo</label>
                <textarea class="pos-cashinout__textarea" rows="3" placeholder="Motivo (opcional)" @bind="_cashInOutDetalle"></textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(_cashInOutFeedback))
            {
                <div class="pos-cashinout__feedback @(_cashInOutOk ? "pos-cashinout__feedback--ok" : "pos-cashinout__feedback--error")">
                    @_cashInOutFeedback
                </div>
            }
        </div>

        <div class="pos-settings-modal__actions">
            <button type="button"
                    class="pos-charge-modal__confirm"
                    disabled="@(_cashInOutSaving || _cashInOutCuentasLoading)"
                    @onclick="ConfirmarMovimientoCajaAsync">
                @if (_cashInOutSaving)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Confirmar</span>
                }
            </button>
            <button type="button" class="pos-settings-modal__ghost" @onclick="CloseCashInOutModal">Cerrar</button>
        </div>
    </section>
}

@if (_showCashDetailModal)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar detalle de caja" @onclick="CloseCashDetailModal"></button>
    <section class="pos-panel-modal pos-panel-modal--wide" aria-label="Detalle de caja">
        <div class="pos-settings-modal__header">
            <div>
                <h3>Detalle de caja</h3>
                <p>Movimientos del día — @DateTime.Today.ToString("dd/MM/yyyy")</p>
            </div>
            <button type="button" class="pos-settings-modal__close" @onclick="CloseCashDetailModal">X</button>
        </div>

        @if (_cashDetailLoading)
        {
            <div class="pos-cashinout__loading" style="padding: 2rem 1.5rem;">Cargando movimientos...</div>
        }
        else
        {
            @if (_cashDetailConsolidado.Count > 0)
            {
                <div class="pos-cashdetail__section">
                    <h4 class="pos-cashdetail__section-title">Saldo consolidado por cuenta</h4>
                    <table class="pos-cashdetail__table" data-sticky-list-header>
                        <thead>
                            <tr>
                                <th>Caja</th>
                                <th>Cuenta</th>
                                <th>Descripción</th>
                                <th class="pos-cashdetail__num">Ingresos +</th>
                                <th class="pos-cashdetail__num">Egresos -</th>
                                <th class="pos-cashdetail__num">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _cashDetailConsolidado)
                            {
                                <tr>
                                    <td>@c.IdCajas.Trim()</td>
                                    <td>@c.Cuenta</td>
                                    <td>@c.Descripcion</td>
                                    <td class="pos-cashdetail__num">@FmtMoney(c.Ingresos)</td>
                                    <td class="pos-cashdetail__num">@FmtMoney(c.Egresos)</td>
                                    <td class="pos-cashdetail__num pos-cashdetail__total">@FmtMoney(c.Saldo)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="pos-cashdetail__total-label">Totales</td>
                                <td class="pos-cashdetail__num pos-cashdetail__total">@FmtMoney(_cashDetailConsolidado.Sum(c => c.Ingresos))</td>
                                <td class="pos-cashdetail__num pos-cashdetail__total">@FmtMoney(_cashDetailConsolidado.Sum(c => c.Egresos))</td>
                                <td class="pos-cashdetail__num pos-cashdetail__total">@FmtMoney(_cashDetailConsolidado.Sum(c => c.Saldo))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @if (_cashDetailMovimientos.Count == 0 && _cashDetailConsolidado.Count == 0)
            {
                <div class="pos-cashinout__loading" style="padding: 1rem 0; color: var(--color-muted);">
                    No hay movimientos de caja registrados hoy.
                </div>
            }

            @if (_cashDetailMovimientos.Count > 0)
            {
            var ingresos = _cashDetailMovimientos.Where(m => m.TipoMovimiento == "I").ToList();
            var egresos  = _cashDetailMovimientos.Where(m => m.TipoMovimiento == "E").ToList();

            <div class="pos-cashdetail__tables">
                @if (ingresos.Any())
                {
                    <div class="pos-cashdetail__section">
                        <h4 class="pos-cashdetail__section-title">Ingresos</h4>
                        <table class="pos-cashdetail__table" data-sticky-list-header>
                            <thead>
                                <tr>
                                    <th>Cuenta</th>
                                    <th>Descripción</th>
                                    <th>Detalle</th>
                                    <th>Hora</th>
                                    <th class="pos-cashdetail__num">Importe</th>
                                    <th>Usuario</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in ingresos)
                                {
                                    <tr>
                                        <td>@m.Cuenta</td>
                                        <td>@m.Descripcion</td>
                                        <td>@m.Detalle</td>
                                        <td>@m.Fecha.ToString("HH:mm")</td>
                                        <td class="pos-cashdetail__num">@FmtMoney(m.Importe)</td>
                                        <td>@m.Usuario</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="pos-cashdetail__total-label">Total ingresos</td>
                                    <td class="pos-cashdetail__num pos-cashdetail__total">@FmtMoney(ingresos.Sum(m => m.Importe))</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                @if (egresos.Any())
                {
                    <div class="pos-cashdetail__section">
                        <h4 class="pos-cashdetail__section-title">Egresos</h4>
                        <table class="pos-cashdetail__table" data-sticky-list-header>
                            <thead>
                                <tr>
                                    <th>Cuenta</th>
                                    <th>Descripción</th>
                                    <th>Detalle</th>
                                    <th>Hora</th>
                                    <th class="pos-cashdetail__num">Importe</th>
                                    <th>Usuario</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in egresos)
                                {
                                    <tr>
                                        <td>@m.Cuenta</td>
                                        <td>@m.Descripcion</td>
                                        <td>@m.Detalle</td>
                                        <td>@m.Fecha.ToString("HH:mm")</td>
                                        <td class="pos-cashdetail__num">@FmtMoney(m.Importe)</td>
                                        <td>@m.Usuario</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="pos-cashdetail__total-label">Total egresos</td>
                                    <td class="pos-cashdetail__num pos-cashdetail__total">@FmtMoney(egresos.Sum(m => m.Importe))</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
            }
        }

        <div class="pos-settings-modal__actions">
            <button type="button" class="pos-settings-modal__ghost" @onclick="CloseCashDetailModal">Cerrar</button>
        </div>
    </section>
}

@if (_showClearCartConfirm)
