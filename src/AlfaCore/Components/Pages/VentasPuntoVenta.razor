    private async Task ConfirmarCierreCajaAsync()
    {
        if (_turnoActual is null)
            return;

        _cierreError = null;
        try
        {
            _cierreSaving = true;
            var request = new PuntoVentaTurnoCierreRequest
            {
                IdTurno = _turnoActual.Id,
                SaldoFinalDeclarado = _cierreSaldoFinalDeclarado,
                Observaciones = _cierreObservaciones,
                UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty),
                Billetes = _cierreCantidades
                    .Where(kv => kv.Value > 0)
                    .Select(kv => new PuntoVentaTurnoBilleteDetalleRequest { IdDenominacion = kv.Key, Cantidad = kv.Value })
                    .ToList(),
                FondoQueda = _cierreFondoQueda
            };

            if (_cierreSaldoFinalDeclarado <= 0 && _cierreSaldoTeoricoPreview > 0)
            {
                _cierreError = "Contá el efectivo de la caja (o escribí el saldo final declarado) antes de cerrar.";
                return;
            }

            if (_cierreTransferir && _cierrePreview is not null && TotalATransferir() != 0)
            {
                if (string.IsNullOrWhiteSpace(_cierreCajaDestino))
                {
                    _cierreError = "Elegí la caja a la que se transfiere, o desmarcá \"Transferir a otra caja\".";
                    return;
                }
                request.IdCajaDestino = _cierreCajaDestino;
                request.Transferencia = _cierrePreview.Saldos
                    .Select(s => new PuntoVentaTurnoTransferenciaLineaRequest
                    {
                        Cuenta = s.Cuenta,
                        Moneda = s.Moneda,
                        Cotizacion = s.Cotizacion,
                        Importe = GetImporteTransferir(s)
                    })
                    .Where(l => l.Importe != 0)
                    .ToList();
            }

            _cierreResultado = await TurnoSvc.CerrarTurnoAsync(request);
            _fondoSugerido = _cierreFondoQueda;
            _showCierreCajaModal = false;
            _turnoActual = null;
        }
        catch (AlfaCore.Services.AppValidationException vex)
        {
            _cierreError = vex.UserMessage;
        }
        catch (Exception ex)
        {
            _cierreError = ex.Message;
        }
        finally
        {
            _cierreSaving = false;
        }
    }

