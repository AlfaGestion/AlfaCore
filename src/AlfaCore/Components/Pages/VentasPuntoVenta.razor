    private async Task OnCatalogScrolledAsync()
    {
        if (_catalogLoading || _catalogLoadingMore || !_catalog.TieneMasResultados)
            return;

        var nearBottom = await Js.InvokeAsync<bool>("alfaPosCatalogNearBottom", _catalogGridRef);
        if (!nearBottom)
            return;

        await LoadMoreCatalogAsync();
    }

    private async Task LoadMoreCatalogAsync()
    {
        if (_catalogLoading || _catalogLoadingMore || !_catalog.TieneMasResultados)
            return;

        try
        {
            _catalogLoadingMore = true;

            var nextPage = Math.Max(_catalog.PaginaActual + 1, 2);
            var result = await PuntoVentaSvc.SearchArticulosAsync(BuildCatalogFilters(nextPage));
            var existingIds = new HashSet<string>(_catalog.Articulos.Select(x => x.IdArticulo), StringComparer.OrdinalIgnoreCase);
            var merged = _catalog.Articulos
                .Concat(result.Articulos.Where(x => existingIds.Add(x.IdArticulo)))
                .ToList();

            _catalog = new PuntoVentaCatalogDto
            {
                Articulos = merged,
                ListaPrecioActual = result.ListaPrecioActual,
                NombreListaPrecioActual = result.NombreListaPrecioActual,
                ClasePrecioActual = result.ClasePrecioActual,
                UsaPrecioFallback = result.UsaPrecioFallback,
                TieneMasResultados = result.TieneMasResultados,
                PaginaActual = result.PaginaActual
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _catalogLoadingMore = false;
        }
    }

