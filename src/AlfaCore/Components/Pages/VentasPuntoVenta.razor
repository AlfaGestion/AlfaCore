    private async Task ConsultarNpArcaAsync()
    {
        _npArcaMensaje = null;
        _npArcaOpciones = [];
        var documento = new string((_npDocumentoContactoInput ?? string.Empty).Where(char.IsDigit).ToArray());
        if (documento.Length is not (7 or 8 or 11))
        {
            _npArcaMensaje = "Ingresá un DNI de 7/8 dígitos o un CUIT de 11 dígitos.";
            return;
        }

        try
        {
            _npArcaBuscando = true;
            if (documento.Length == 11)
            {
                AplicarNpArcaPersona(await ArcaPadronSvc.ConsultarPersonaAsync(documento));
                return;
            }

            var personas = await ArcaPadronSvc.ConsultarDniAsync(documento);
            if (personas.Count == 0)
            {
                _npArcaMensaje = $"ARCA no encontró un CUIT asociado al DNI {documento}.";
            }
            else if (personas.Count == 1)
            {
                AplicarNpArcaPersona(personas[0]);
            }
            else
            {
                _npArcaOpciones = personas;
                _npArcaMensaje = "El DNI tiene más de un CUIT asociado. Seleccioná el cliente correcto.";
            }
        }
        catch (Exception ex)
        {
            _npArcaMensaje = ex.Message;
        }
        finally
        {
            _npArcaBuscando = false;
        }
    }

    private void AplicarNpArcaPersona(ArcaPadronPersonaDto persona)
    {
        _npDocumentoContactoInput = persona.Cuit;
        _npNombreContactoInput = string.IsNullOrWhiteSpace(persona.RazonSocial)
            ? $"{persona.Nombre} {persona.Apellido}".Trim()
            : persona.RazonSocial;
        _npDomicilioEntregaInput = persona.Calle;
        _npLocalidadEntregaInput = persona.Localidad;
        _npArcaOpciones = [];
        _npArcaMensaje = "Datos completados desde ARCA.";
    }

