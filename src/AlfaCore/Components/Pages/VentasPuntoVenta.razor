    private async Task BuscarEncargosDesdeFiltrosAsync()
    {
        _npAnticiposPagina = 1;
        await BuscarEncargosAsync();
    }

    private async Task BuscarEncargosAsync()
    {
        if (!EsMostradorProduccion || _npAnticiposLoading)
            return;

        try
        {
            _npAnticiposLoading = true;
            _npAnticiposError = null;
            _npAnticiposResultado = null;
            // Mostrar el modal y su estado de carga antes de esperar la consulta.
            // F9 debe responder de inmediato aunque la base tarde en devolver la primera página.
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            _npAnticiposListado = await AnticiposSvc.BuscarNotasPedidoAsync(new PuntoVentaNpListadoFiltro
            {
                Buscar = _npAnticiposIdComprobante,
                Estado = _npEstadoInput,
                Desde = _npFechaDesdeInput,
                Hasta = _npFechaHastaInput,
                Sucursal = _npSucursalInput,
                Unidad = _npUnidadInput,
                IncluirAnuladas = _npIncluirAnuladasInput,
                Pagina = _npAnticiposPagina,
                TamanoPagina = 20,
                // La sucursal queda vacía por defecto y puede acotarse con el filtro.
            });
        }
        catch (Exception ex)
        {
            _npAnticiposListado = null;
            _npAnticiposError = ex.Message;
        }
        finally
        {
            _npAnticiposLoading = false;
        }
    }

    private async Task CambiarPaginaEncargosAsync(int delta)
    {
        if (_npAnticiposListado is null)
            return;

        _npAnticiposPagina = Math.Clamp(_npAnticiposPagina + delta, 1, Math.Max(1, _npAnticiposListado.TotalPaginas));
        await BuscarEncargosAsync();
    }

    private async Task ActualizarEncargosAsync()
    {
        if (_npAnticiposListado is null)
            _npAnticiposPagina = 1;
        await BuscarEncargosAsync();
    }

    private void StartNpMonitorRefresh()
    {
        StopNpMonitorRefresh();
        _npMonitorRefreshCts = new CancellationTokenSource();
        _npMonitorRefreshTask = RefrescarMonitorNpAsync(_npMonitorRefreshCts.Token);
    }

    private void StopNpMonitorRefresh()
    {
        _npMonitorRefreshCts?.Cancel();
        _npMonitorRefreshCts = null;
        _npMonitorRefreshTask = null;
    }

    private async Task RefrescarMonitorNpAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), ct);
                if (!_showNpAnticiposModal || !_npVistaProduccion || ct.IsCancellationRequested)
                    return;

                await InvokeAsync(async () =>
                {
                    if (!_npAnticiposLoading)
                        await BuscarEncargosAsync();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo actualizar automáticamente el monitor de producción.");
        }
    }

