    private void AbrirFacturacionEncargo(string idComprobante)
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        const string mostradorRoute = "/ventas/punto-venta/mostrador";
        var index = path.IndexOf(mostradorRoute, StringComparison.OrdinalIgnoreCase);
        var prefix = index >= 0 ? path[..index] : string.Empty;
        var route = $"{prefix}/ventas/carga-comprobantes?buscar={Uri.EscapeDataString(idComprobante)}";
        Nav.NavigateTo(route);
    }

