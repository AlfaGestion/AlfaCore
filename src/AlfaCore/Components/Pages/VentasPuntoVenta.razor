        <div class="pos-settings-modal__actions">
            <button type="button" class="pos-settings-modal__ghost" @onclick="CloseClearCartConfirm">Cancelar</button>
            <button type="button" class="pos-settings-modal__save" @onclick="ConfirmClearCart">Vaciar carrito</button>
        </div>
