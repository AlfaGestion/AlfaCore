    private static bool PuedeFacturarEncargo(PuntoVentaNpResumenDto encargo)
        => !string.Equals(encargo.EstadoComprobante, "ANULADA", StringComparison.OrdinalIgnoreCase)
           && !string.Equals(encargo.EstadoComprobante, "FINALIZADA", StringComparison.OrdinalIgnoreCase);

    private async Task FacturarEncargoDesdeListado(PuntoVentaNpResumenDto encargo)
    {
        if (!PuedeFacturarEncargo(encargo) || _npAnticiposLoading)
            return;

        if (_cartItems.Any())
        {
            var reemplazar = await Js.InvokeAsync<bool>("confirm", "El carrito tiene artículos. ¿Querés reemplazarlo por la nota de pedido seleccionada?");
            if (!reemplazar)
                return;
        }

        try
        {
            _cargandoNpEnPos = true;
            _npAnticiposLoading = true;
            _npAnticiposError = null;
            var np = await AnticiposSvc.GetNotaPedidoParaFacturarAsync(encargo.IdComprobante, encargo.Cuenta);
            if (np is null)
            {
                _npAnticiposError = "No se pudo cargar la nota de pedido en el POS.";
                return;
            }

            var pendientes = np.Items
                .Select(x => new { Item = x, Cantidad = Math.Max(x.Cantidad - x.CantidadEntregada, 0m) })
                .Where(x => x.Cantidad > 0m)
                .ToList();
            if (pendientes.Count == 0)
            {
                _npAnticiposError = "La nota de pedido no tiene cantidades pendientes para facturar.";
                return;
            }

            CartState.Clear();
            foreach (var pendiente in pendientes)
            {
                var item = pendiente.Item;
                _cartItems.Add(new PuntoVentaCartItemDto
                {
                    OrigenLineaId = item.LineaId,
                    IdArticulo = item.IdArticulo,
                    Descripcion = item.Descripcion,
                    Presentacion = item.Presentacion,
                    PrecioUnitario = item.Precio,
                    PrecioOriginal = item.Precio,
                    Cantidad = pendiente.Cantidad,
                    Observaciones = item.Observaciones
                });
            }

            _cuentaCliente = np.Cuenta.Trim();
            _cuentaClienteNombre = np.Cliente.Trim();
            _tipoComprobanteSeleccionado = "FC";
            _facturandoNotaPedidoId = np.Id;
            _facturandoNotaPedidoComprobante = np.IdComprobante.Trim();
            _paymentLines.Clear();
            if (np.AnticipoAplicable is { ImporteOriginal: > 0 } anticipo)
            {
                _paymentLines.Add(new PuntoVentaPaymentLineDto
                {
                    CodigoMedioPago = "ANTICIPO",
                    DescripcionMedioPago = $"Seña {anticipo.IdComprobante}",
                    Importe = anticipo.ImporteOriginal,
                    EsAnticipo = true,
                    IdCobranzaAnticipo = anticipo.Id,
                    ComprobanteAnticipo = anticipo.IdComprobante
                });
            }
            _showNpAnticiposModal = false;
            _npAnticiposResultado = null;
            _selectedCartItemId = null;
            _needScanFocus = true;
        }
        catch (Exception ex)
        {
            _npAnticiposError = ex.Message;
        }
        finally
        {
            _npAnticiposLoading = false;
            _cargandoNpEnPos = false;
        }
    }

    private Task FacturarEncargoDesdeDetalleAsync(PuntoVentaNpAnticiposDto np)
        => FacturarEncargoDesdeListado(new PuntoVentaNpResumenDto
