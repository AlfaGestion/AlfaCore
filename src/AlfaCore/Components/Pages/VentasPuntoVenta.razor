@page "/ventas/punto-venta/mostrador"
@page "/{idweb}/{idbase:int}/ventas/punto-venta/mostrador"
@inherits SaaSRoutePageBase
@implements IAsyncDisposable
@using QRCoder
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc
@inject AlfaCore.Services.IPuntoVentaCartStateService CartState
@inject AlfaCore.Services.IPuntoVentaPedidoService PedidoSvc
@inject AlfaCore.Services.IPuntoVentaAnticiposService AnticiposSvc
@inject AlfaCore.Services.ICotizacionDocumentService CotizacionDocumentSvc
@inject AlfaCore.Services.IPuntoVentaSalonService SalonSvc
@inject AlfaCore.Services.IPuntoVentaConfigService PosConfigSvc
@inject AlfaCore.Services.IPuntoVentaTurnoService TurnoSvc
@inject AlfaCore.Services.IFacturaDocumentService FacturaDocumentSvc
@inject AlfaCore.Services.IMercadoPagoPointPosService MpPaymentSvc
@inject AlfaCore.Services.IMercadoPagoPointConfigService MpConfigSvc
@inject AlfaCore.Services.IArcaPadronService ArcaPadronSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPermissionService PermissionSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IRouteContextService RouteCtx
@inject AlfaCore.Services.ICentralPublicLinkService PublicLinkSvc
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ILogger<VentasPuntoVenta> Logger

<PageTitle>Punto de Venta | Ventas</PageTitle>

<style>
    .pos-shell {
        height: 100dvh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        margin: 0;
        background: linear-gradient(180deg, #eef1f6 0%, #e4e8ef 100%);
        color: #1f2d3d;
    }

    .pos-shortcut-trigger {
        display: none;
    }

    .pos-shortcuts-hint {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem 0.65rem;
        padding: 0.45rem 0.6rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        color: var(--color-muted);
        font-size: 0.7rem;
        line-height: 1.25;
    }

    .pos-shortcuts-hint__title {
        width: 100%;
        color: var(--color-text);
        font-weight: 800;
    }

    .pos-shortcuts-hint kbd,
    .pos-button-shortcut {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.55rem;
        padding: 0.1rem 0.3rem;
        border: 1px solid var(--color-border-strong, var(--color-border));
        border-radius: 4px;
        background: var(--color-panel-strong);
        color: var(--color-text);
        font-size: 0.68rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .pos-button-shortcut {
        margin-left: 0.45rem;
        vertical-align: middle;
    }

    .pos-shortcuts-hint--modal {
        margin-top: 0.7rem;
        justify-content: flex-end;
    }

    .pos-shortcuts-hint--modal .pos-shortcuts-hint__title {
        width: auto;
        margin-right: auto;
    }

    .pos-shell .empty-state,
    .pos-shell .pos-loading {
        margin: 1rem;
    }

    .pos-np-loading-overlay { position: fixed; inset: 0; z-index: 1200; display: grid; place-items: center; background: rgba(4, 12, 24, .58); backdrop-filter: blur(2px); }
    .pos-np-loading { display: flex; align-items: center; gap: .7rem; padding: 1rem 1.25rem; border: 1px solid var(--color-border-strong, var(--color-border)); border-radius: .8rem; background: var(--color-panel-strong); color: var(--color-text); box-shadow: 0 1rem 3rem rgba(0,0,0,.28); font-weight: 700; }
    .pos-np-loading i { color: var(--color-primary); font-size: 1.35rem; animation: pos-np-spin .8s linear infinite; }
    @@keyframes pos-np-spin { to { transform: rotate(360deg); } }

    .pos-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: nowrap;
        padding: 1rem 1.4rem;
        background: linear-gradient(180deg, #5f95cc 0%, #5a8dc1 100%);
        border-bottom: 1px solid rgba(33, 58, 84, 0.16);
        box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.16);
    }

    .pos-topbar__brand {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1 1 20rem;
        min-width: 0;
        min-width: 0;
    }

    .pos-topbar__logo {
        display: grid;
        place-items: center;
        width: 3.15rem;
        height: 3.15rem;
        border-radius: 1rem;
        background: #ffffff;
        color: #3b6ea4;
        font-weight: 900;
        letter-spacing: 0.08em;
        box-shadow: 0 8px 20px rgba(27, 49, 76, 0.12);
    }

    .pos-topbar__eyebrow {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: rgba(237, 244, 252, 0.88);
    }

    .pos-topbar h1 {
        margin: 0.15rem 0 0;
        color: #ffffff;
        font-size: 1.9rem;
        line-height: 1;
    }

    .pos-topbar__context {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
        margin-left: 0.65rem;
    }

    .pos-topbar__context-item {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-height: 2rem;
        padding: 0.3rem 0.58rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 0.5rem;
        background: rgba(8, 31, 58, 0.22);
        color: rgba(237, 244, 252, 0.78);
        font-size: 0.72rem;
        white-space: nowrap;
    }

    .pos-topbar__context-item i {
        color: #b8e8ff;
    }

    .pos-topbar__context-item strong {
        color: #ffffff;
        font-weight: 800;
    }

    .pos-topbar__customer {
        display: grid;
        gap: 0.12rem;
        flex: 1 1 18rem;
        min-width: 12rem;
        max-width: 30rem;
        padding: 0.42rem 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 0.65rem;
        background: rgba(8, 31, 58, 0.3);
        color: rgba(237, 244, 252, 0.82);
        font-size: 0.7rem;
        line-height: 1.2;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pos-topbar__customer strong {
        color: #ffffff;
        font-weight: 800;
    }

    .pos-topbar__customer-main {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pos-topbar__customer-data {
        display: flex;
        gap: 0.7rem;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pos-topbar__document {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex: 0 1 27rem;
        min-width: 13rem;
    }

    .pos-topbar__document-label {
        color: rgba(237, 244, 252, 0.78);
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .pos-topbar__document .pos-select {
        min-height: 2.35rem;
        padding: 0.45rem 0.65rem;
        border-color: rgba(255, 255, 255, 0.16);
        border-radius: 0.6rem;
        background: rgba(8, 31, 58, 0.3);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 800;
    }

    .pos-topbar__quick-documents {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        min-width: 0;
    }

    .pos-topbar__quick-document {
        min-height: 2.15rem;
        padding: .3rem .55rem;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: .55rem;
        background: rgba(8,31,58,.3);
        color: #fff;
        font-size: .72rem;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    .pos-topbar__quick-document:hover,
    .pos-topbar__quick-document.is-active {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: #fff;
    }

    .pos-topbar__actions {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .pos-catalog__document {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex: 0 0 auto;
    }

    .pos-catalog__document-label {
        color: var(--color-muted);
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .pos-catalog__document-btn {
        min-height: 2.35rem;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-panel);
        color: var(--color-text);
        font-size: 0.8rem;
        font-weight: 800;
        cursor: pointer;
    }

    .pos-catalog__document-btn--active {
        border-color: rgba(56, 189, 248, 0.7);
        background: rgba(56, 189, 248, 0.18);
        color: #ffffff;
    }

    .pos-catalog__document-select {
        min-width: 14rem;
        min-height: 2.35rem;
        font-size: 0.8rem;
        font-weight: 800;
    }

    .pos-topbar__ghost,
    .pos-topbar__cart-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 2.9rem;
        padding: 0.8rem 1.1rem;
        border: 0;
        border-radius: 0.4rem;
        background: rgba(88, 108, 128, 0.74);
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
    }

    .pos-topbar__cart-link {
        background: rgba(105, 121, 137, 0.86);
    }

    .pos-topbar__cart-link strong {
        font-weight: 800;
    }

    .pos-topbar__cart-count {
        position: absolute;
        top: -0.45rem;
        right: -0.45rem;
        display: grid;
        place-items: center;
        min-width: 1.55rem;
        height: 1.55rem;
        padding: 0 0.35rem;
        border-radius: 999px;
        background: #f0495c;
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 800;
    }

    .pos-topbar__company {
        display: grid;
        gap: 0.18rem;
        min-width: 17rem;
        padding: 0.72rem 1rem;
        border-radius: 0.4rem;
        background: rgba(255, 255, 255, 0.92);
        color: #1f2d3d;
    }

    .pos-topbar__company span {
        font-size: 0.76rem;
        color: #5f6c7c;
    }

    .pos-topbar__company strong {
        font-size: 1rem;
    }

    .pos-stage {
        display: grid;
        grid-template-columns: 38rem minmax(0, 1fr);
        flex: 1 1 auto;
        min-height: 0;
    }

    .pos-stage.pos-stage--quick {
        grid-template-columns: minmax(28rem, 40%) minmax(0, 60%);
    }

    .pos-sidebar {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto auto auto auto;
        background: #f3f4f7;
        border-right: 1px solid #d6dce6;
        min-height: 0;
    }

    .pos-sidebar__toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        padding: 0.85rem 0.7rem 0.6rem;
    }

    .pos-sidebar__link,
    .pos-sidebar__danger,
    .pos-sidebar__cash-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border: 1px solid #b6c0ce;
        background: #ffffff;
        color: #3b5e86;
        border-radius: 0.28rem;
        min-height: 2.3rem;
        padding: 0.55rem 0.8rem;
        font-size: 0.92rem;
        font-weight: 600;
    }

    .pos-sidebar__danger {
        color: #d54f59;
        border-color: transparent;
        background: transparent;
    }

    .pos-sidebar__items {
        overflow: auto;
        padding: 0 0.7rem 0.8rem;
    }

    .pos-sidebar__empty {
        display: grid;
        gap: 0.35rem;
        padding: 1rem;
        border: 1px dashed #ccd3de;
        border-radius: 0.35rem;
        background: #ffffff;
        color: #5d6979;
    }

    .pos-line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.55rem 0.9rem;
        padding: 0.75rem 0.9rem;
        border-bottom: 1px solid #dadfe7;
        background: rgba(255, 255, 255, 0.72);
    }

    .pos-line__main {
        display: grid;
        gap: 0.22rem;
        min-width: 0;
    }

    .pos-line__main strong {
        color: #243447;
        font-size: 0.94rem;
        line-height: 1.25;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pos-line__main span {
        color: #667483;
        font-size: 0.88rem;
    }

    .pos-line__details {
        display: grid;
        gap: 0.35rem;
    }

    .pos-line__details > span {
        white-space: nowrap;
        font-size: 0.78rem;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pos-line__controls {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        flex: 0 0 auto;
        justify-self: end;
        max-width: 100%;
    }

    .pos-line__controls button {
        display: grid;
        place-items: center;
        width: 1.55rem;
        height: 1.55rem;
        padding: 0;
        border: 1px solid #c8cfda;
        border-radius: 6px;
        background: #ffffff;
        color: #3b5e86;
        cursor: pointer;
    }

    .pos-line__controls button:hover {
        background: #e7f1fb;
    }

    .pos-line__controls strong {
        min-width: 1.8rem;
        text-align: center;
        color: #243447;
        font-size: 0.8rem;
    }

    .pos-line__controls .pos-line__remove {
        margin-left: 0.2rem;
        border-color: rgba(220, 53, 69, 0.28);
        color: #c0394b;
    }

    .pos-line__price {
        align-self: start;
        font-size: 0.94rem;
        font-weight: 700;
        color: #243447;
    }
    .pos-line__observation { margin-top:.25rem; color:var(--color-primary); font-size:.78rem; line-height:1.25; overflow-wrap:anywhere; }

    .pos-sidebar__notes {
        padding: 0.65rem 0.7rem 0;
    }

    .pos-sidebar__scan {
        width: 100%;
        min-height: 2.9rem;
        border: 1px solid #c8cfda;
        border-radius: 0.28rem;
        padding: 0.75rem 0.85rem 0.75rem 2.4rem;
        background: #ffffff;
        font-size: 0.95rem;
    }

    .pos-sidebar__client {
        padding: 0.65rem 0.7rem 0;
    }

    .pos-sidebar__client-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: 0;
        background: transparent;
        color: #2b74e0;
        font-size: 1rem;
    }

    .pos-sidebar__footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-top: 0.7rem;
        border-top: 1px solid #ccd3de;
    }

    .pos-charge {
        display: grid;
        justify-items: center;
        align-content: center;
        gap: 0.65rem;
        min-height: 12rem;
        border: 0;
        background: #5c94cf;
        color: #ffffff;
    }

    .pos-charge__icon {
        display: grid;
        place-items: center;
        width: 5.4rem;
        height: 5.4rem;
        border-radius: 999px;
        background: #ffffff;
        color: #5c94cf;
        font-size: 2.4rem;
    }

    .pos-charge__label {
        font-size: 1.8rem;
        font-weight: 800;
    }

    .pos-total-card {
        display: grid;
        justify-items: center;
        align-content: center;
        gap: 0.8rem;
        min-height: 12rem;
        background: #ffffff;
        color: #2a3440;
        border-left: 1px solid #d0d7e2;
    }

    .pos-total-card span {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .pos-total-card strong {
        font-size: 2.35rem;
        font-weight: 900;
    }

    .pos-sidebar__cash-actions {
        display: flex;
        justify-content: flex-end;
        padding: 0 0.7rem 0.7rem;
    }

    .pos-sidebar__cash-btn {
        background: #6f7680;
        border-color: #6f7680;
        color: #ffffff;
    }

    .pos-catalog {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
    }

    .pos-catalog__toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: stretch;
        gap: 0.35rem;
        padding: 0.45rem 0.7rem;
        background: #f3f4f7;
        border-bottom: 1px solid #d6dce6;
    }

    .pos-catalog__filters {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-width: 0;
        flex: 0 0 17rem;
    }

    .pos-catalog__rubros {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: .35rem;
        width: 100%;
        max-height: 7.1rem;
        overflow-y: auto;
        padding: .1rem 0;
        scrollbar-gutter: stable;
    }

    .pos-catalog__rubros--mobile {
        max-height: 5.4rem;
        margin: .25rem 0 .45rem;
    }

    .pos-catalog__rubro {
        min-width: 0;
        width: 100%;
        min-height: 2.1rem;
        padding: .25rem .65rem;
        border: 1px solid color-mix(in srgb, var(--rubro-color, var(--color-border)) 75%, #ffffff 25%);
        border-radius: 6px;
        background: var(--rubro-color, var(--color-panel-strong));
        color: var(--rubro-text, var(--color-text));
        font-size: .7rem;
        font-weight: 800;
        cursor: pointer;
        line-height: 1.1;
        white-space: normal;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: center;
    }

    .pos-catalog__rubro:hover,
    .pos-catalog__rubro.is-active {
        background: var(--rubro-color, var(--color-primary));
        border-color: var(--rubro-color, var(--color-primary));
        color: var(--rubro-text, #fff);
    }

    .pos-catalog__rubro--top {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: #fff;
    }

    .pos-catalog__rubro--top.is-active {
        background: var(--color-primary);
        color: #fff;
    }

    /* TOP es la acción destacada; Todos necesita un estado propio para no
       confundirse con TOP cuando queda seleccionado. */
    .pos-catalog__rubro--todos.is-active {
        background: var(--color-panel-strong);
        border-color: var(--color-primary);
        color: var(--color-text);
        box-shadow: inset 0 0 0 1px var(--color-primary);
    }

    .pos-select {
        min-width: 0;
        width: 100%;
        min-height: 2.5rem;
        border: 1px solid #c8cfda;
        border-radius: 0.28rem;
        background: #ffffff;
        padding: 0.65rem 0.8rem;
        font-size: 0.95rem;
    }

    .pos-context-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .pos-context-pill span,
    .pos-catalog__meta span,
    .pos-mini-badge {
        display: inline-flex;
        align-items: center;
        min-height: 1.9rem;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        background: #dce7f5;
        color: #4a6988;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .pos-catalog__search {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.5rem;
        flex: 1 1 auto;
        min-width: 0;
    }

    .pos-search-input {
        min-height: 2.5rem;
        border: 1px solid #c8cfda;
        border-radius: 0.28rem;
        background: #ffffff;
        padding: 0.75rem 0.9rem;
        font-size: 1rem;
        flex: 1 1 auto;
        min-width: 0;
    }

    .pos-search-btn {
        min-height: 2.5rem;
        border: 0;
        border-radius: 0.28rem;
        background: #5c94cf;
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        padding: 0.55rem 0.9rem;
    }

    .pos-catalog__meta {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
        padding: 0.55rem 0.95rem;
        background: #f3f4f7;
        border-bottom: 1px solid #dce2eb;
    }

    .pos-catalog__quick-filters {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        padding: 0.45rem 0.7rem;
        background: #eef1f6;
        border-bottom: 1px solid #dce2eb;
        overflow-x: auto;
    }

    .pos-catalog__quick-filter {
        min-height: 2rem;
        padding: 0.35rem 0.7rem;
        border: 1px solid #c8cfda;
        border-radius: 999px;
        background: #ffffff;
        color: #34465a;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
    }

    .pos-catalog__quick-filter:hover,
    .pos-catalog__quick-filter.is-active {
        border-color: #168fca;
        background: #168fca;
        color: #ffffff;
    }

    .pos-catalog__quick-filter:disabled { opacity: .55; cursor: wait; }

    .pos-grid-status {
        display: grid;
        place-items: center;
        padding: 2.2rem 1rem;
        color: #5c6978;
        font-size: 1rem;
    }

    .pos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
        gap: 0.14rem;
        align-content: start;
        overflow: auto;
        padding: 0.18rem;
        background: #efeff2;
    }

    .pos-product {
        position: relative;
        display: grid;
        grid-template-rows: 165px minmax(48px, auto);
        gap: 0.3rem;
        padding: 0;
        border: 1px solid #e1e4ea;
        background: #ffffff;
        cursor: pointer;
        transition: transform 0.16s ease, box-shadow 0.16s ease;
    }

    .pos-product:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 22px rgba(58, 73, 92, 0.12);
        z-index: 1;
    }

    .pos-product__price {
        position: absolute;
        top: 0;
        right: 0;
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0.25rem 0.55rem;
        background: #5c94cf;
        color: #ffffff;
        font-size: 0.92rem;
        font-weight: 800;
    }

    .pos-product__price:has(del),
    .pos-mobile-product__price:has(del) {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.05rem;
        line-height: 1.05;
        white-space: normal;
    }

    .pos-product__price del,
    .pos-mobile-product__price del {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.68rem;
        font-weight: 600;
    }

    .pos-product__price strong,
    .pos-mobile-product__price strong {
        color: #fff3c4;
        font-size: 0.78rem;
    }

    .pos-line__offer {
        color: #f6c453 !important;
        font-weight: 800;
        white-space: nowrap;
    }

    .pos-product__image-wrap {
        display: grid;
        place-items: center;
        padding: 0.55rem;
        background: #ffffff;
        overflow: hidden;
    }

    .pos-product__image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    .pos-product__fallback {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #f7f8fb 0%, #dde5ef 100%);
        color: #5f6f83;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: 0.08em;
    }

    .pos-product__text {
        display: grid;
        gap: 0.25rem;
        padding: 0 .6rem .45rem;
    }

    .pos-product__text strong {
        color: #304255;
        font-size: 0.84rem;
        line-height: 1.18;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.32;
        font-weight: 400;
    }

    .pos-product__text span {
        color: #6a7686;
        font-size: 0.84rem;
    }

    .pos-product__badges {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        padding: 0 0.8rem 0.8rem;
    }

    .pos-mini-badge--muted {
        background: #ebedf1;
        color: #6b7582;
    }

    .pos-shell {
        background: radial-gradient(circle at top left, rgba(14, 165, 233, 0.1), transparent 26%), var(--color-bg);
        color: var(--color-text);
        font: inherit;
    }

    .pos-topbar {
        padding: 0.8rem 1rem;
        background: rgba(13, 27, 48, 0.92);
        border-bottom: 1px solid var(--color-border);
        box-shadow: none;
    }

    .pos-topbar__logo {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.9rem;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #ffffff;
        box-shadow: none;
    }

    .pos-topbar__eyebrow {
        color: var(--color-muted);
    }

    .pos-topbar h1 {
        color: var(--color-text);
        font-size: 1.45rem;
    }

    .pos-topbar__version {
        font-size: 0.72rem;
        font-weight: 400;
        opacity: 0.55;
        vertical-align: middle;
        margin-left: 0.35rem;
        letter-spacing: 0.02em;
    }

    .pos-topbar__ghost,
    .pos-topbar__cart-link {
        min-height: 2.65rem;
        background: rgba(14, 165, 233, 0.12);
        border: 1px solid rgba(14, 165, 233, 0.18);
        color: var(--color-text);
    }

    .pos-topbar__cart-link strong {
        color: var(--color-text);
    }

    .pos-topbar__cart-count {
        background: var(--color-danger);
    }

    .pos-stage {
        grid-template-columns: 24.25rem minmax(0, 1fr);
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }

    .pos-sidebar {
        grid-template-rows: auto minmax(0, 1fr) auto;
        background: var(--color-panel);
        border-right: 1px solid var(--color-border);
        overflow: hidden;
        position: sticky;
        top: 0;
    }

    .pos-sidebar__toolbar {
        padding: 0.75rem;
        border-bottom: 1px solid var(--color-border);
        justify-content: flex-end;
    }

    .pos-sidebar__link,
    .pos-sidebar__danger,
    .pos-sidebar__cash-btn {
        border: 1px solid var(--color-border);
        background: rgba(148, 163, 184, 0.08);
        color: var(--color-text);
        border-radius: 14px;
    }

    .pos-sidebar__danger {
        color: #fda4af;
        background: transparent;
    }

    .pos-sidebar__items {
        min-height: 0;
        height: 100%;
        overflow: auto;
        padding: 0;
    }

    .pos-sidebar__empty {
        margin: 0.75rem;
        border: 1px dashed var(--color-border);
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.18);
        color: var(--color-muted);
    }

    .pos-line {
        padding: 0.75rem;
        border-bottom: 1px solid var(--color-border);
        background: transparent;
        gap: 0.35rem 0.65rem;
    }

    .pos-line__main strong,
    .pos-line__price {
        color: var(--color-text);
    }

    .pos-line__main strong {
        font-size: 0.84rem;
        line-height: 1.15;
    }

    .pos-line__main span {
        color: var(--color-muted);
        font-size: 0.76rem;
        line-height: 1.1;
    }

    .pos-line__details > span {
        color: var(--color-muted);
    }

    .pos-line__controls button {
        border-color: var(--color-border);
        background: var(--color-panel);
        color: var(--color-text);
    }

    .pos-line__controls button:hover {
        background: rgba(56, 189, 248, 0.12);
    }

    .pos-line__controls strong {
        color: var(--color-text);
    }

    .pos-line__controls .pos-line__remove {
        border-color: rgba(248, 113, 113, 0.28);
        color: #fda4af;
    }

    .pos-sidebar__checkout {
        flex: 0 0 auto;
        display: grid;
        gap: 0.65rem;
        padding: 0.75rem;
        border-top: 1px solid var(--color-border);
        background: linear-gradient(180deg, rgba(7, 17, 31, 0.35), rgba(10, 20, 35, 0.98));
    }

    .pos-sidebar__notes,
    .pos-sidebar__client,
    .pos-sidebar__cash-actions {
        padding: 0;
    }

    .pos-context-pill {
        display: none;
    }

    .pos-sidebar__scan {
        min-height: 3rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 0.85rem 1rem 0.85rem 2.4rem;
        background: var(--color-panel-strong);
        color: var(--color-text);
    }

    .pos-sidebar__scan::placeholder {
        color: var(--color-muted);
    }

    .pos-sidebar__client-btn {
        width: 100%;
        justify-content: flex-start;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: rgba(14, 165, 233, 0.08);
        color: var(--color-text);
    }

    .pos-sidebar__footer {
        margin-top: 0;
        border-top: 0;
        gap: 0.7rem;
        grid-template-columns: 0.64fr 1.36fr;
    }

    .pos-charge {
        min-height: 4.6rem;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.16), rgba(15, 23, 42, 0.08));
        border: 1px solid rgba(56, 189, 248, 0.18);
        color: var(--color-text);
    }

    .pos-charge__icon {
        width: 3rem;
        height: 3rem;
        font-size: 1.55rem;
        color: var(--color-primary);
    }

    .pos-charge__label {
        font-size: 1rem;
    }

    .pos-total-card {
        min-height: 4.6rem;
        border-radius: 18px;
        background: var(--color-panel-strong);
        color: var(--color-text);
        border: 1px solid var(--color-border);
        border-left: 1px solid var(--color-border);
    }

    .pos-total-card span {
        font-size: 0.88rem;
    }

    .pos-total-card strong {
        font-size: 1.7rem;
    }

    .pos-sidebar__cash-btn {
        width: 100%;
        justify-content: center;
        min-height: 3.15rem;
        font-weight: 800;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.2), rgba(20, 184, 166, 0.18));
        border-color: rgba(34, 211, 238, 0.24);
    }

    .pos-sidebar__cash-actions .pos-sidebar__danger {
        min-height: 3.15rem;
        justify-content: center;
        background: rgba(239, 68, 68, 0.06);
        border-color: rgba(239, 68, 68, 0.14);
        color: #fecaca;
    }

    .pos-sidebar__cash-actions .pos-sidebar__danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.12);
        border-color: rgba(239, 68, 68, 0.24);
    }

    .pos-catalog__toolbar,
    .pos-catalog__meta {
        background: rgba(10, 20, 35, 0.72);
        border-bottom: 1px solid var(--color-border);
    }

    .pos-catalog__meta {
        display: none;
    }

    .pos-catalog {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }

    .pos-select,
    .pos-search-input {
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-panel-strong);
        color: var(--color-text);
    }

    /* El menú nativo del comprobante tomaba el gris claro del sistema y
       rompía el contraste del topbar oscuro. */
    .pos-topbar__document .pos-select option {
        background: var(--color-panel-strong);
        color: var(--color-text);
    }

    .pos-topbar__document .pos-select option:checked,
    .pos-topbar__document .pos-select option:hover {
        background: var(--color-primary);
        color: #ffffff;
    }

    .pos-search-input::placeholder {
        color: var(--color-muted);
    }

    .pos-search-btn {
        border-radius: 14px;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    }

    .pos-catalog__search .pos-sidebar__scan {
        min-width: 15rem;
        flex: 0 1 17rem;
    }

    .pos-context-pill span,
    .pos-catalog__meta span,
    .pos-mini-badge {
        background: rgba(14, 165, 233, 0.12);
        color: var(--color-text);
    }

    .pos-grid-status {
        color: var(--color-muted);
    }

    .pos-grid-status--warning {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.55rem 0.65rem;
        border: 1px solid rgba(245, 158, 11, 0.35);
        border-radius: 12px;
        background: rgba(245, 158, 11, 0.1);
        color: #fde68a;
        font-size: 0.76rem;
        line-height: 1.35;
    }

    .pos-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.55rem;
        padding: 0.75rem;
        background: transparent;
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .pos-product {
        grid-template-rows: 104px minmax(42px, auto);
        gap: 0.2rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: var(--color-panel);
        overflow: hidden;
        min-height: 154px;
    }

    .pos-product:hover {
        box-shadow: 0 16px 30px rgba(0, 0, 0, 0.22);
    }

    .pos-product__price {
        min-height: 1.8rem;
        padding: 0.2rem 0.5rem;
        background: linear-gradient(135deg, var(--color-primary), #5b95e2);
        font-size: 0.8rem;
    }

    .pos-product__image-wrap {
        padding: 0.4rem;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(148, 163, 184, 0.08));
    }

    .pos-product__fallback {
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.08), rgba(148, 163, 184, 0.12));
        color: var(--color-muted);
        font-size: 1.45rem;
    }

    .pos-product__text {
        padding: 0 0.55rem 0.4rem;
        min-height: 42px;
        align-content: start;
        display: grid;
    }

    .pos-product__text strong {
        color: var(--color-text);
        font-size: 0.84rem;
        line-height: 1.24;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: calc(0.84rem * 1.18 * 2);
    }

    .pos-item-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(3, 9, 18, 0.58);
        z-index: 1100;
    }

    .pos-item-modal {
        position: fixed;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 1110;
        width: min(720px, calc(100vw - 2rem));
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 1rem;
        padding: 1rem;
        border-radius: 20px;
        border: 1px solid var(--color-border);
        background: var(--color-panel-strong);
        box-shadow: 0 28px 60px rgba(0, 0, 0, 0.38);
    }

    .pos-item-modal__image {
        display: grid;
        place-items: center;
        min-height: 180px;
        border-radius: 16px;
        background: rgba(148, 163, 184, 0.08);
        overflow: hidden;
    }

    .pos-item-modal__image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    .pos-item-modal__fallback {
        font-size: 2.6rem;
        font-weight: 900;
        color: var(--color-muted);
    }

    .pos-item-modal__body {
        display: grid;
        gap: 0.75rem;
        min-width: 0;
    }

    .pos-item-modal__top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .pos-item-modal__code {
        color: var(--color-muted);
        font-size: 0.95rem;
    }

    .pos-item-modal__title {
        margin: 0.2rem 0 0;
        color: var(--color-text);
        font-size: 1.15rem;
        line-height: 1.25;
    }

    .pos-item-modal__description-edit {
        display: grid;
        gap: 0.4rem;
    }

    .pos-item-modal__description-edit label {
        color: var(--color-muted);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .pos-item-modal__description-edit input {
        min-height: 2.7rem;
        width: 100%;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-panel);
        color: var(--color-text);
    }

    .pos-item-modal__description-save {
        min-height: 2.5rem;
        border: 1px solid rgba(56, 189, 248, 0.4);
        border-radius: 10px;
        background: rgba(56, 189, 248, 0.14);
        color: var(--color-text);
        font-weight: 800;
    }

    .pos-item-modal__description-save:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .pos-item-modal__price {
        color: var(--color-text);
        font-size: 1.9rem;
        font-weight: 900;
    }

    .pos-item-modal__close,
    .pos-item-modal__danger,
    .pos-item-modal__qty-btn,
    .pos-item-modal__qty-value,
    .pos-item-modal__qty-input {
        min-height: 3rem;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        background: rgba(148, 163, 184, 0.08);
        color: var(--color-text);
    }

    .pos-item-modal__close {
        min-width: 3rem;
    }

    .pos-item-modal__danger {
        padding: 0 1rem;
        color: #fecaca;
        background: rgba(239, 68, 68, 0.08);
        border-color: rgba(239, 68, 68, 0.18);
    }

    .pos-item-modal__qty-label {
        color: var(--color-muted);
        font-size: 0.92rem;
        font-weight: 700;
    }

    .pos-item-modal__qty {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 0.55rem;
        align-items: center;
    }

    .pos-item-modal__qty-value {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        padding: 0 0.9rem;
        font-size: 1rem;
        font-weight: 700;
        min-width: 8rem;
    }

    .pos-item-modal__qty-input {
        width: 100%;
        min-width: 0;
        padding: 0 0.9rem;
        color: var(--color-text);
        font-size: 1rem;
        font-weight: 700;
        text-align: center;
    }

    .pos-item-modal__qty-btn {
        min-width: 3.2rem;
        font-size: 1.2rem;
        font-weight: 900;
    }
    .pos-item-modal__observation {
        display: grid;
        gap: .45rem;
        margin-top: .35rem;
        padding: .7rem .75rem .75rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 28%, var(--color-border));
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-primary) 7%, var(--color-panel));
        color: var(--color-text);
        font-size: .82rem;
    }

    .pos-item-modal__observation span {
        display: flex;
        align-items: center;
        gap: .4rem;
        color: var(--color-text);
        font-weight: 800;
    }

    .pos-item-modal__observation span i {
        color: var(--color-primary);
        font-size: .95rem;
    }

    .pos-item-modal__observation textarea {
        width: 100%;
        min-height: 4.8rem;
        padding: .65rem .7rem;
        resize: vertical;
        border: 1px solid var(--color-border);
        border-radius: 9px;
        outline: none;
        background: color-mix(in srgb, var(--color-panel) 88%, #000 12%);
        color: var(--color-text);
        caret-color: var(--color-primary);
        font: inherit;
        line-height: 1.35;
    }

    .pos-item-modal__observation textarea::placeholder { color: var(--color-muted); opacity: .8; }
    .pos-item-modal__observation textarea:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 18%, transparent);
    }

    .pos-item-modal__observation-actions { display:flex; gap:.5rem; margin-top:.15rem; }
    .pos-item-modal__observation-actions button {
        min-height: 2.35rem;
        padding: .45rem .8rem;
        border: 1px solid var(--color-primary);
        border-radius: 9px;
        background: var(--color-primary);
        color: #fff;
        cursor: pointer;
        font-weight: 800;
    }
    .pos-item-modal__observation-actions button.is-muted {
        border-color: var(--color-border);
        background: transparent;
        color: var(--color-muted);
    }

    .pos-manual-article-modal {
        display: block;
        width: min(520px, calc(100vw - 2rem));
    }

    .pos-manual-article-modal__hint {
        margin: 0;
        color: var(--color-muted);
        line-height: 1.45;
    }

    .pos-manual-article-modal__fields {
        display: grid;
        gap: 0.8rem;
        margin-top: 0.25rem;
    }

    .pos-manual-article-modal__fields label {
        display: grid;
        gap: 0.35rem;
        color: var(--color-muted);
        font-size: 0.82rem;
        font-weight: 700;
    }

    .pos-manual-article-modal__fields input {
        min-height: 2.8rem;
        width: 100%;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-panel);
        color: var(--color-text);
    }

    .pos-manual-article-modal__error {
        margin: 0;
        color: #fecaca;
        font-size: 0.86rem;
        font-weight: 700;
    }

    .pos-manual-article-modal__actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
        margin-top: 1rem;
    }

    .pos-manual-article-modal__actions button {
        min-height: 2.8rem;
        padding: 0 1rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: rgba(148, 163, 184, 0.08);
        color: var(--color-text);
        font-weight: 800;
    }

    .pos-manual-article-modal__actions button:last-child {
        border-color: rgba(56, 189, 248, 0.55);
        background: rgba(56, 189, 248, 0.16);
    }

    .pos-topbar__menu {
        position: relative;
    }

    .pos-topbar__menu-panel {
        position: absolute;
        top: calc(100% + 0.55rem);
        right: 0;
        display: grid;
        min-width: 15rem;
        padding: 0.5rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: var(--color-panel-strong);
        box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28);
        z-index: 1200;
    }

    .pos-topbar__menu-item,
    .pos-topbar__menu-link {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 2.85rem;
        padding: 0.7rem 0.85rem;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: var(--color-text);
        text-decoration: none;
        font-weight: 700;
        text-align: left;
    }

    .pos-topbar__menu-item:hover,
    .pos-topbar__menu-link:hover {
        background: rgba(14, 165, 233, 0.1);
    }

    .pos-settings-modal {
        position: fixed;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 1110;
        width: min(980px, calc(100vw - 2rem));
        max-height: calc(100vh - 2rem);
        overflow: auto;
        display: grid;
        gap: 1rem;
        padding: 1rem;
        border-radius: 20px;
        border: 1px solid var(--color-border);
        background: var(--color-panel-strong);
        box-shadow: 0 28px 60px rgba(0, 0, 0, 0.38);
    }

    .pos-reprint-modal {
        overflow: hidden;
        grid-template-rows: auto auto minmax(0, 1fr);
    }

    .pos-settings-modal__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .pos-settings-modal__header h3,
    .pos-settings-modal__section h4 {
        margin: 0;
        color: var(--color-text);
    }

    .pos-settings-modal__header p,
    .pos-settings-modal__section p,
    .pos-settings-modal__flow li {
        color: var(--color-muted);
    }

    .pos-settings-modal__close {
        min-width: 3rem;
        min-height: 3rem;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        background: rgba(148, 163, 184, 0.08);
        color: var(--color-text);
    }

    .pos-settings-modal__grid {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
        gap: 1rem;
    }

    .pos-encargo-detail {
        display: grid;
        gap: 1rem;
        min-width: 0;
        overflow: auto;
        padding-right: 0.15rem;
    }

    .pos-encargo-summary {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) repeat(2, minmax(150px, 0.7fr));
        gap: 0.8rem;
        padding: 1rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(15, 23, 42, 0.28));
    }

    .pos-encargo-summary__main,
    .pos-encargo-summary__status,
    .pos-encargo-summary__metric {
        display: grid;
        align-content: center;
        gap: 0.3rem;
        min-width: 0;
        padding: 0.2rem 0.35rem;
    }

    .pos-encargo-summary__main {
        grid-row: span 2;
        align-content: center;
        padding-right: 1rem;
        border-right: 1px solid var(--color-border);
    }

    .pos-encargo-summary__main strong {
        overflow: hidden;
        color: var(--color-text);
        font-size: 1.1rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pos-encargo-summary__label,
    .pos-encargo-summary__account,
    .pos-encargo-cobranza__values span,
    .pos-encargo-cobranza__bottom,
    .pos-encargo-section__heading p {
        color: var(--color-muted);
        font-size: 0.78rem;
    }

    .pos-encargo-summary__account {
        font-size: 0.75rem;
    }

    .pos-encargo-summary__metric strong {
        color: var(--color-text);
        font-size: 1rem;
    }

    .pos-encargo-summary__metric--total {
        padding: 0.65rem 0.8rem;
        border-radius: 12px;
        background: rgba(34, 211, 238, 0.1);
    }

    .pos-encargo-delivery {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.7rem;
    }

    .pos-encargo-delivery div {
        display: grid;
        gap: 0.25rem;
        padding: 0.7rem 0.8rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: rgba(148, 163, 184, 0.06);
    }

    .pos-encargo-delivery span,
    .pos-encargo-item__description span,
    .pos-encargo-item__description small,
    .pos-encargo-item__numbers span,
    .pos-encargo-item__progress span {
        color: var(--color-muted);
        font-size: 0.76rem;
    }

    .pos-encargo-delivery strong {
        color: var(--color-text);
        font-size: 0.86rem;
    }

    .pos-encargo-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: 0.7rem 0.8rem;
        border: 1px solid rgba(14, 165, 233, 0.25);
        border-radius: 12px;
        background: rgba(14, 165, 233, 0.06);
    }

    .pos-encargo-actions > span {
        color: var(--color-muted);
        font-size: 0.78rem;
    }

    .pos-encargo-observations {
        display: grid;
        gap: 0.25rem;
        padding: 0.75rem 0.8rem;
        border-left: 3px solid var(--color-primary);
        border-radius: 0 10px 10px 0;
        background: rgba(14, 165, 233, 0.08);
    }

    .pos-encargo-observations span {
        color: var(--color-muted);
        font-size: 0.76rem;
    }

    .pos-encargo-observations strong {
        color: var(--color-text);
        font-size: 0.86rem;
        font-weight: 600;
        white-space: pre-wrap;
    }

    .pos-charge-modal__field {
        display: grid;
        gap: 0.35rem;
    }

    .pos-charge-modal__field-row {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(8rem, 0.75fr);
        gap: 0.55rem;
    }

    .pos-charge-modal__field span {
        color: var(--color-muted);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .pos-charge-modal__field input,
    .pos-charge-modal__field textarea {
        width: 100%;
        min-height: 2.7rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 0.65rem 0.75rem;
        background: var(--color-panel);
        color: var(--color-text);
    }

    .pos-charge-modal__field textarea {
        min-height: 4.5rem;
        resize: vertical;
    }

    .pos-encargo-status,
    .pos-encargo-section__count {
        width: fit-content;
        padding: 0.25rem 0.55rem;
        border: 1px solid rgba(34, 211, 238, 0.25);
        border-radius: 999px;
        background: rgba(34, 211, 238, 0.1);
        color: #a5f3fc;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.03em;
    }

    .pos-encargo-alert {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.7rem 0.85rem;
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 12px;
        background: rgba(245, 158, 11, 0.1);
        color: #fde68a;
        font-size: 0.82rem;
    }

    .pos-encargo-alert strong {
        white-space: nowrap;
    }

    .pos-encargo-section {
        display: grid;
        gap: 0.7rem;
        min-width: 0;
    }

    .pos-encargo-section__heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .pos-encargo-section__heading h4 {
        margin: 0;
        color: var(--color-text);
        font-size: 1.05rem;
    }

    .pos-encargo-section__heading p {
        margin: 0.15rem 0 0;
    }

    .pos-encargo-section__count {
        flex: 0 0 auto;
        color: var(--color-text);
    }

    .pos-encargo-cobranzas {
        display: grid;
        gap: 0.65rem;
    }

    .pos-encargo-items {
        display: grid;
        gap: 0.55rem;
    }

    .pos-encargo-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.7rem 1rem;
        padding: 0.8rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: rgba(15, 23, 42, 0.32);
    }

    .pos-encargo-item__description,
    .pos-encargo-item__numbers {
        display: grid;
        align-content: center;
        gap: 0.2rem;
        min-width: 0;
    }

    .pos-encargo-item__description strong,
    .pos-encargo-item__numbers strong {
        color: var(--color-text);
    }

    .pos-encargo-item__description span,
    .pos-encargo-item__description small {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pos-encargo-item__numbers {
        grid-template-columns: auto auto auto;
        align-items: center;
        gap: 0.8rem;
        text-align: right;
    }

    .pos-encargo-item__progress {
        grid-column: 1 / -1;
        display: grid;
        gap: 0.25rem;
    }

    .pos-encargo-item__progress > div {
        height: 0.35rem;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.16);
    }

    .pos-encargo-item__progress i {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--color-primary), #22d3ee);
    }

    .pos-encargo-cobranza {
        display: grid;
        gap: 0.7rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: rgba(15, 23, 42, 0.42);
    }

    .pos-encargo-cobranza__top,
    .pos-encargo-cobranza__bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
    }

    .pos-encargo-cobranza__top strong {
        overflow: hidden;
        color: var(--color-text);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pos-encargo-cobranza__values {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.8rem;
    }

    .pos-encargo-cobranza__values div {
        display: grid;
        gap: 0.2rem;
    }

    .pos-encargo-cobranza__values strong {
        color: var(--color-text);
        font-size: 0.95rem;
    }

    .pos-encargo-cobranza__values div:last-child {
        text-align: right;
    }

    .pos-encargo-cobranza__bottom span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pos-encargo-action .pos-encargo-cobranza__bottom span:last-child {
        flex: 1 1 auto;
        text-align: right;
    }

    .pos-encargo-empty {
        padding: 1rem;
        border: 1px dashed var(--color-border);
        border-radius: 12px;
        color: var(--color-muted);
        text-align: center;
    }

    @@media (max-width: 640px) {
        .pos-encargo-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .pos-encargo-summary__main {
            grid-column: 1 / -1;
            grid-row: auto;
            padding-right: 0.35rem;
            padding-bottom: 0.75rem;
            border-right: 0;
            border-bottom: 1px solid var(--color-border);
        }

        .pos-encargo-cobranza__values {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .pos-encargo-delivery {
            grid-template-columns: 1fr;
        }

        .pos-encargo-item {
            grid-template-columns: 1fr;
        }

        .pos-encargo-item__numbers {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            text-align: left;
        }

        .pos-encargo-cobranza__values div:last-child {
            text-align: left;
        }

        .pos-encargo-cobranza__bottom {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.25rem;
        }

        .pos-encargo-action .pos-encargo-cobranza__bottom span:last-child {
            text-align: left;
        }

        .pos-encargo-alert {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.2rem;
        }
    }

    .pos-settings-modal__section {
        display: grid;
        gap: 0.85rem;
        padding: 1rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.35);
    }

    .pos-settings-modal__field {
        display: grid;
        gap: 0.4rem;
    }

    .pos-settings-modal__check-field {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        padding: 0.8rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: rgba(34, 211, 238, 0.06);
        cursor: pointer;
    }

    .pos-settings-modal__check-field input {
        margin-top: 0.2rem;
        accent-color: #22d3ee;
    }

    .pos-settings-modal__check-field span {
        display: grid;
        gap: 0.25rem;
    }

    .pos-settings-modal__check-field small {
        color: var(--color-text-muted);
        font-size: 0.78rem;
    }

    .pos-settings-modal__field label {
        color: var(--color-text);
        font-size: 0.9rem;
        font-weight: 700;
    }

    .pos-settings-modal__field input,
    .pos-settings-modal__field select,
    .pos-settings-modal__readonly {
        min-height: 2.8rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 0.75rem 0.9rem;
        background: rgba(148, 163, 184, 0.08);
        color: var(--color-text);
    }

    .pos-settings-modal__readonly {
        display: flex;
        align-items: center;
    }

    .pos-settings-modal__flow {
        margin: 0;
        padding-left: 1.2rem;
        display: grid;
        gap: 0.35rem;
    }

    .pos-settings-modal__feedback {
        padding: 0.8rem 0.9rem;
        border-radius: 14px;
        border: 1px solid rgba(34, 197, 94, 0.2);
        background: rgba(34, 197, 94, 0.1);
        color: #dcfce7;
    }

    .pos-settings-modal__feedback--error {
        border-color: rgba(239, 68, 68, 0.22);
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
    }

    .pos-settings-modal__actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .pos-settings-modal__save,
    .pos-settings-modal__ghost {
        min-height: 2.9rem;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        font-weight: 800;
    }

    .pos-settings-modal__save {
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #fff;
        border: 0;
    }

    .pos-settings-modal__ghost {
        background: rgba(148, 163, 184, 0.08);
        color: var(--color-text);
    }

    .pos-panel-modal {
        position: fixed;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 1110;
        width: min(560px, calc(100vw - 2rem));
        display: grid;
        gap: 1rem;
        padding: 1rem;
        border-radius: 20px;
        border: 1px solid var(--color-border);
        background: var(--color-panel-strong);
        box-shadow: 0 28px 60px rgba(0, 0, 0, 0.38);
    }

    .pos-panel-modal--narrow {
        width: min(480px, calc(100vw - 2rem));
    }

    .pos-panel-modal--wide {
        width: min(860px, calc(100vw - 2rem));
        max-height: calc(100dvh - 4rem);
        overflow-y: auto;
    }

    /* ── Ingresos/Egresos ───────────────────────────── */
    .pos-cashinout__body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pos-cashinout__type-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .pos-cashinout__type-btn {
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: transparent;
        color: var(--color-text);
        font-size: 0.9rem;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }

    .pos-cashinout__type-btn--active {
        background: var(--color-primary);
        color: #fff;
        border-color: var(--color-primary);
    }

    .pos-cashinout__amount-wrap {
        display: flex;
        align-items: center;
        flex: 1;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        overflow: hidden;
        background: var(--color-panel);
    }

    .pos-cashinout__currency {
        padding: 0 0.6rem;
        color: var(--color-muted);
        font-size: 0.9rem;
        user-select: none;
    }

    .pos-cashinout__currency-end {
        padding: 0 0.6rem;
        color: var(--color-muted);
        font-size: 0.9rem;
        background: var(--color-panel);
        border-left: 1px solid var(--color-border);
        user-select: none;
    }

    .pos-cashinout__amount {
        flex: 1;
        border: none;
        background: transparent;
        color: var(--color-text);
        font-size: 1rem;
        padding: 0.45rem 0.25rem;
        outline: none;
        text-align: right;
    }

    .pos-cashinout__field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .pos-cashinout__label {
        font-size: 0.8rem;
        color: var(--color-muted);
    }

    .pos-cashinout__select {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: var(--color-panel);
        color: var(--color-text);
        font-size: 0.9rem;
        outline: none;
    }

    .pos-cashinout__textarea {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: var(--color-panel);
        color: var(--color-text);
        font-size: 0.9rem;
        resize: vertical;
        outline: none;
        font-family: inherit;
        box-sizing: border-box;
    }

    .pos-cashinout__loading {
        color: var(--color-muted);
        font-size: 0.85rem;
    }

    .pos-cashinout__feedback {
        padding: 0.55rem 0.9rem;
        border-radius: 8px;
        font-size: 0.88rem;
    }

    .pos-cashinout__feedback--ok {
        color: #166534;
        background: rgba(22, 101, 52, 0.07);
        border: 1px solid rgba(22, 101, 52, 0.18);
    }

    .pos-cashinout__feedback--error {
        color: #991b1b;
        background: rgba(220, 38, 38, 0.06);
        border: 1px solid rgba(220, 38, 38, 0.18);
    }

    /* ── Detalle de caja ────────────────────────────── */
    .pos-cashdetail__tables {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 0 0.25rem;
    }

    .pos-cashdetail__section-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 0.5rem 0;
    }

    .pos-cashdetail__table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.83rem;
    }

    .pos-cashdetail__table th {
        text-align: left;
        padding: 0.4rem 0.6rem;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-muted);
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .pos-cashdetail__table td {
        padding: 0.4rem 0.6rem;
        border-bottom: 1px solid rgba(var(--color-border-rgb, 100 116 139), 0.15);
        color: var(--color-text);
        vertical-align: top;
    }

    .pos-cashdetail__table tfoot td {
        border-top: 1px solid var(--color-border);
        border-bottom: none;
        font-weight: 600;
    }

    .pos-cashdetail__num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .pos-cashdetail__total-label {
        color: var(--color-muted);
        font-size: 0.8rem;
    }

    .pos-cashdetail__total {
        color: var(--color-text);
    }

    .pos-panel-modal__grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .pos-charge-modal {
        position: fixed;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 1110;
        width: min(860px, calc(100vw - 2rem));
        max-height: calc(100dvh - 2rem);
        display: grid;
        /* header, error opcional, totales, carga, listado y acciones */
        grid-template-rows: auto auto auto auto minmax(0, 1fr) auto;
        gap: 1rem;
        padding: 1rem;
        border-radius: 20px;
        border: 1px solid var(--color-border);
        background: var(--color-panel-strong);
        box-shadow: 0 28px 60px rgba(0, 0, 0, 0.38);
        overflow-x: hidden;
        overflow-y: auto;
        isolation: isolate;
    }

    .pos-charge-modal:has(.pos-arca-overlay) {
        overflow: hidden;
    }

    .pos-arca-overlay {
        position: absolute;
        inset: 0;
        z-index: 30;
        display: grid;
        place-items: center;
        padding: 1rem;
        border-radius: inherit;
        background: rgba(2, 6, 23, .78);
        backdrop-filter: blur(3px);
    }

    .pos-arca-overlay__panel {
        width: min(100%, 660px);
        overflow: hidden;
        border: 1px solid rgba(56, 189, 248, .45);
        border-radius: 16px;
        background: #0b1b31;
        box-shadow: 0 24px 55px rgba(0, 0, 0, .48);
    }

    .pos-arca-overlay__brand {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .75rem 1rem;
        color: white;
        background: linear-gradient(115deg, #111a3d, #07122b);
        border-bottom: 1px solid rgba(148, 163, 184, .3);
    }

    .pos-arca-overlay__brand-mark {
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: .08em;
        line-height: 1;
    }

    .pos-arca-overlay__brand-copy {
        display: grid;
        gap: .1rem;
        font-size: .72rem;
        line-height: 1.1;
        text-transform: uppercase;
    }

    .pos-arca-overlay__brand-copy strong {
        font-size: .86rem;
    }

    .pos-arca-overlay__environment {
        margin-left: auto;
        padding: .25rem .55rem;
        color: #dbeafe;
        border: 1px solid rgba(96, 165, 250, .4);
        border-radius: 4px;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .04em;
    }

    .pos-arca-overlay__body {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: 1rem;
    }

    .pos-arca-overlay__spinner {
        display: grid;
        flex: 0 0 auto;
        width: 2.4rem;
        height: 2.4rem;
        place-items: center;
        border-radius: 50%;
        color: #38bdf8;
        background: rgba(14, 165, 233, .18);
        font-size: 1.35rem;
        animation: pos-charge-spin 1.1s linear infinite;
    }

    .pos-arca-overlay__body strong,
    .pos-arca-overlay__body small {
        display: block;
    }

    .pos-arca-overlay__body strong {
        color: #f8fafc;
        font-size: 1rem;
    }

    .pos-arca-overlay__body small {
        margin-top: .25rem;
        color: #93c5fd;
    }

    .pos-charge-modal__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .pos-charge-modal__header h3 {
        margin: 0;
        font-size: 1.2rem;
    }

    .pos-charge-modal__header p {
        margin: 0.2rem 0 0;
        color: var(--color-muted);
    }

    .pos-charge-modal__close {
        min-width: 2.2rem;
        min-height: 2.2rem;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        background: transparent;
        color: var(--color-text);
        font-weight: 800;
    }

    .pos-charge-modal__feedback {
        padding: 0.8rem 0.9rem;
        border-radius: 14px;
        border: 1px solid rgba(34, 197, 94, 0.22);
        background: rgba(34, 197, 94, 0.1);
        color: #d1fae5;
    }

    .pos-success-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .pos-success-banner button {
        min-width: 2.2rem;
        min-height: 2.2rem;
        border-radius: 12px;
        border: 1px solid rgba(209, 250, 229, 0.18);
        background: transparent;
        color: #d1fae5;
        font-weight: 900;
        font-size: 1rem;
        flex: 0 0 auto;
        cursor: pointer;
    }

    .pos-field-hint {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.78rem;
        color: var(--color-muted);
    }

    .pos-billetes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
        gap: 0.6rem;
        margin: 0.6rem 0;
    }

    .pos-billete-row {
        display: grid;
        grid-template-columns: 3.5rem 4.5rem 1fr;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.6rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
    }

    .pos-billete-row input {
        width: 100%;
    }

    .pos-success-banner button:hover {
        background: rgba(209, 250, 229, 0.08);
    }

    .pos-pedido-banner .pos-pedido-banner__volver,
    .pos-pedido-banner__acciones button {
        padding: 0.35rem 0.9rem;
        font-size: 0.9rem;
        font-weight: 700;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .pos-cierre-transf {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin: 0.75rem 0;
        padding: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 0.6rem;
    }

    .pos-cierre-transf__check {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        cursor: pointer;
    }

    .pos-cierre-transf__check input {
        width: auto;
        height: auto;
        margin: 0;
    }

    .pos-cierre-transf__tabla {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .pos-cierre-transf__tabla th,
    .pos-cierre-transf__tabla td {
        padding: 0.35rem 0.4rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
        text-align: left;
    }

    .pos-cierre-transf__tabla th:nth-child(n+2),
    .pos-cierre-transf__tabla td:nth-child(n+2) {
        text-align: right;
    }

    .pos-cierre-transf__tabla input {
        width: 9rem;
        text-align: right;
    }

    .pos-cierre-transf__tabla tfoot td {
        font-weight: 700;
        border-bottom: 0;
    }

    .pos-pedido-banner__acciones .pos-pedido-banner__salir {
        background: #d1fae5;
        border-color: #d1fae5;
        color: #064e3b;
    }

    .pos-pedido-banner__acciones .pos-pedido-banner__salir:hover {
        background: #a7f3d0;
    }

    .pos-pedido-banner__acciones {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .pos-charge-modal__feedback--error {
        border-color: rgba(239, 68, 68, 0.24);
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
    }

    .pos-charge-progress {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .85rem 1rem;
        border: 1px solid rgba(56, 189, 248, .35);
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(8, 47, 73, .78), rgba(15, 23, 42, .9));
        color: #e0f2fe;
    }

    .pos-charge-progress strong,
    .pos-charge-progress small {
        display: block;
    }

    .pos-charge-progress small {
        margin-top: .2rem;
        color: #93c5fd;
    }

    .pos-charge-progress__spinner {
        display: grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        border-radius: 50%;
        background: rgba(14, 165, 233, .2);
        color: #38bdf8;
        font-size: 1.2rem;
        animation: pos-charge-spin 1.1s linear infinite;
    }

    @@keyframes pos-charge-spin {
        to { transform: rotate(360deg); }
    }

    .pos-charge-modal__line-surcharge {
        display: block;
        margin-top: .15rem;
        color: #fbbf24;
        font-size: .75rem;
    }

    .pos-point-status {
        display: flex;
        align-items: center;
        gap: .8rem;
        border-color: rgba(56, 189, 248, .3);
        background: linear-gradient(135deg, rgba(14, 116, 144, .26), rgba(15, 23, 42, .72));
        color: #e0f2fe;
    }

    .pos-point-status__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.2rem;
        height: 2.2rem;
        border-radius: 999px;
        background: rgba(14, 165, 233, .18);
        color: #38bdf8;
        font-size: 1.1rem;
        flex: 0 0 auto;
    }

    .pos-point-status__copy {
        display: grid;
        gap: .15rem;
        min-width: 0;
        flex: 1 1 auto;
    }

    .pos-point-status__copy strong {
        color: #bae6fd;
    }

    .pos-point-status__copy span,
    .pos-point-status__copy small {
        color: #dbeafe;
    }

    .pos-point-status__copy small {
        opacity: .76;
    }

    .pos-point-overlay {
        position: absolute;
        inset: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        border-radius: 20px;
        background: rgba(2, 6, 23, .94);
        backdrop-filter: blur(7px);
    }

    .pos-point-overlay__panel {
        display: grid;
        justify-items: center;
        gap: .7rem;
        width: min(430px, 100%);
        padding: 2rem 1.5rem;
        text-align: center;
        border: 1px solid rgba(56, 189, 248, .4);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(15, 43, 71, .98), rgba(15, 23, 42, .98));
        box-shadow: 0 20px 50px rgba(0, 0, 0, .45);
    }

    .pos-point-overlay--final .pos-point-overlay__panel {
        border-color: rgba(251, 146, 60, .5);
        background: linear-gradient(180deg, rgba(67, 45, 28, .98), rgba(15, 23, 42, .98));
    }

    .pos-point-overlay__title {
        color: #38bdf8;
        font-size: 1.35rem;
        font-weight: 800;
    }

    .pos-point-overlay--final .pos-point-overlay__title {
        color: #fb923c;
    }

    .pos-point-overlay__amount {
        color: #f8fafc;
        font-size: 2rem;
        font-weight: 800;
    }

    .pos-point-overlay__detail {
        color: #dbeafe;
        line-height: 1.45;
    }

    .pos-point-overlay__terminal {
        color: #93c5fd;
        font-size: .82rem;
    }

    .pos-point-overlay__actions {
        display: flex;
        gap: .65rem;
        margin-top: .35rem;
    }

    .pos-charge-modal__totals-head {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.55rem;
    }

    .pos-charge-modal__totals-head > div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.55rem 0.8rem;
        border-radius: 10px;
        background: rgba(2, 6, 23, 0.75);
        color: var(--color-text);
    }

    .pos-charge-modal__totals-head span {
        font-size: 0.85rem;
        font-weight: 700;
    }

    .pos-charge-modal__totals-head strong {
        font-size: 1.25rem;
    }

    .pos-charge-modal__totals-head--pending strong {
        color: #38bdf8;
    }

    .pos-charge-modal__totals-head--change strong,
    .pos-charge-modal__summary-row--change strong {
        color: #f87171;
    }

    .pos-charge-modal__payment-entry {
        display: grid;
        grid-template-columns: minmax(10rem, 1fr) minmax(10rem, 1.2fr) minmax(8rem, 0.7fr) auto;
        gap: 0.55rem;
        align-items: center;
    }

    .pos-charge-modal__test-tools {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.65rem;
        color: #fbbf24;
        font-size: 0.72rem;
    }

    .pos-charge-modal__test-tools .pos-charge-modal__action {
        min-height: 2.2rem;
        padding: 0.45rem 0.7rem;
        border-color: rgba(251, 191, 36, 0.55);
        color: #fbbf24;
        font-size: 0.75rem;
    }

    .pos-charge-modal__selected-method {
        display: grid;
        gap: 0.1rem;
        min-height: 2.7rem;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: var(--color-panel);
    }

    .pos-charge-modal__selected-method span {
        color: var(--color-muted);
        font-size: 0.68rem;
    }

    .pos-charge-modal__selected-method strong {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.84rem;
    }

    .pos-charge-modal__body {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
        gap: 1rem;
        min-height: 0;
    }

    .pos-charge-modal__body--np {
        grid-template-columns: minmax(0, 1fr);
        overflow: auto;
        align-content: start;
        gap: 0.55rem;
    }

    .pos-charge-modal__section--np-info {
        align-content: start;
        min-height: 0;
        padding: 0.55rem 0.75rem;
    }

    .pos-charge-modal__section--np-form {
        gap: 0.5rem;
    }

    .pos-charge-modal:has(.pos-charge-modal__body--np) {
        width: min(720px, calc(100vw - 2rem));
        gap: 0.7rem;
    }

    .pos-charge-modal:has(.pos-charge-modal__body--np) .pos-charge-modal__totals-head {
        margin: 0;
    }

    .pos-charge-modal:has(.pos-charge-modal__body--np) .pos-charge-modal__section--np-form {
        border-color: rgba(56, 189, 248, 0.25);
        background: rgba(7, 20, 38, 0.42);
    }

    .pos-grid-status--np-summary {
        display: block;
        padding: 0.35rem 0.55rem;
        border: 1px solid var(--color-border);
        border-radius: 9px;
        font-size: 0.76rem;
    }

    .pos-np-anticipo {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.7rem;
        padding: 0.55rem 0.65rem;
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 10px;
        background: rgba(56, 189, 248, 0.07);
    }

    .pos-np-anticipo--attention {
        border-color: rgba(245, 158, 11, 0.75);
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.18), rgba(245, 158, 11, 0.06));
        box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.08);
    }

    .pos-np-anticipo__question {
        display: grid;
        gap: 0.1rem;
        color: var(--color-text);
        font-size: 0.8rem;
        font-weight: 800;
    }

    .pos-np-anticipo__question small {
        color: var(--color-muted);
        font-size: 0.7rem;
        font-weight: 500;
    }

    .pos-np-anticipo__options {
        display: flex;
        gap: 0.3rem;
        flex: 0 0 auto;
    }

    .pos-np-anticipo__options button {
        min-width: 3.5rem;
        min-height: 2.2rem;
        padding: 0.3rem 0.65rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-panel);
        color: var(--color-text);
        font-weight: 700;
    }

    .pos-np-anticipo__options button.is-active {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: #fff;
    }

    .pos-np-anticipo__status {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-top: 0.15rem;
        color: #fcd34d;
        font-size: 0.68rem;
        font-weight: 800;
    }

    .pos-np-anticipo__payment {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 0.55rem;
        padding: 0.55rem 0.65rem 0;
        border-left: 1px solid rgba(245, 158, 11, 0.35);
        border-right: 1px solid rgba(245, 158, 11, 0.35);
        background: rgba(245, 158, 11, 0.045);
    }

    .pos-np-anticipo__payment input,
    .pos-np-anticipo__payment select {
        min-height: 2.55rem;
    }

    .pos-np-observations {
        margin-top: 0.1rem;
        padding-top: 0.55rem;
        border-top: 1px solid var(--color-border);
    }

    .pos-np-arca-search {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.55rem;
        padding: 0.7rem;
        border: 1px solid rgba(56, 189, 248, 0.25);
        border-radius: 14px;
        background: rgba(14, 165, 233, 0.07);
    }

    .pos-np-arca-search label {
        grid-column: 1 / -1;
        color: var(--color-text);
        font-size: 0.8rem;
        font-weight: 800;
    }

    .pos-np-arca-search input {
        min-width: 0;
        min-height: 2.55rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-panel);
        color: var(--color-text);
        padding: 0.55rem 0.7rem;
    }

    .pos-np-arca-search button {
        min-height: 2.55rem;
        padding: 0.55rem 0.8rem;
        border: 0;
        border-radius: 10px;
        background: var(--color-primary);
        color: white;
        font-weight: 800;
    }

    .pos-np-arca-message {
        grid-column: 1 / -1;
        margin: 0;
        color: var(--color-muted);
        font-size: 0.78rem;
    }

    .pos-np-arca-options {
        grid-column: 1 / -1;
        display: grid;
        gap: 0.35rem;
    }

    .pos-np-arca-options button {
        text-align: left;
        background: var(--color-panel);
        border: 1px solid var(--color-border);
        color: var(--color-text);
    }

    .pos-charge-modal__section {
        display: grid;
        gap: 0.7rem;
        padding: 0.85rem;
        border-radius: 18px;
        border: 1px solid var(--color-border);
        background: rgba(255, 255, 255, 0.02);
        min-height: 0;
    }

    .pos-charge-modal__section h4 {
        margin: 0;
        font-size: 1rem;
    }

    .pos-charge-modal__methods-scroll {
        min-height: 0;
        overflow: auto;
        padding-right: 0.2rem;
        max-height: 20rem;
    }

    .pos-charge-modal__method-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.65rem;
    }

    .pos-charge-modal__method-btn,
    .pos-charge-modal__action,
    .pos-charge-modal__ghost {
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-panel);
        color: var(--color-text);
    }

    .pos-charge-modal__method-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        min-height: 2.8rem;
        padding: 0.7rem 0.8rem;
        text-align: left;
        transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
    }

    .pos-charge-modal__method-btn:hover {
        border-color: rgba(56, 189, 248, 0.35);
        transform: translateY(-1px);
    }

    .pos-charge-modal__method-btn--active {
        border-color: rgba(56, 189, 248, 0.55);
        background: rgba(56, 189, 248, 0.1);
    }

    .pos-charge-modal__method-btn strong {
        font-size: 0.9rem;
    }

    .pos-charge-modal__method-btn span {
        color: var(--color-muted);
        font-size: 0.78rem;
    }

    .pos-charge-modal__entry {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.65rem;
    }

    .pos-charge-modal__hint {
        margin: -0.05rem 0 0;
        color: var(--color-muted);
        font-size: 0.79rem;
        line-height: 1.28;
    }

    .pos-charge-modal__amount {
        min-height: 3rem;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-panel);
        color: var(--color-text);
        padding: 0.8rem 0.9rem;
        font-size: 1rem;
    }

    .pos-charge-modal__code-filter {
        min-height: 2.7rem;
        width: 100%;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: var(--color-panel);
        color: var(--color-text);
        padding: 0.7rem 0.85rem;
    }

    .pos-charge-modal__code-filter::placeholder {
        color: var(--color-muted);
    }

    .pos-charge-modal__action {
        min-width: 8rem;
        min-height: 3rem;
        padding: 0.75rem 1rem;
        font-weight: 800;
    }

    .pos-charge-modal__list {
        display: grid;
        gap: 0.55rem;
        min-height: 0;
        max-height: 18rem;
        overflow: auto;
    }

    .pos-charge-modal__line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 0.75rem;
        align-items: center;
        padding: 0.7rem 0.8rem;
        border-radius: 14px;
        border: 1px solid var(--color-border);
        background: rgba(255, 255, 255, 0.02);
    }

    .pos-charge-modal__line strong {
        display: block;
        font-size: 0.92rem;
    }

    .pos-charge-modal__line span {
        color: var(--color-muted);
        font-size: 0.8rem;
    }

    .pos-charge-modal__line button {
        min-width: 2.25rem;
        min-height: 2.25rem;
        border-radius: 12px;
        border: 1px solid rgba(239, 68, 68, 0.24);
        background: rgba(239, 68, 68, 0.1);
        color: #fecaca;
        font-weight: 900;
    }

    .pos-charge-modal__summary {
        display: grid;
        gap: 0.65rem;
    }

    .pos-charge-modal__summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        color: var(--color-muted);
    }

    .pos-charge-modal__summary-row strong {
        color: var(--color-text);
    }

    .pos-charge-modal__summary-row--pending strong {
        color: var(--color-primary);
    }

    .pos-charge-modal__actions {
        display: flex;
        justify-content: flex-start;
        gap: 0.7rem;
        flex-wrap: wrap;
    }

    .pos-charge-modal__footer {
        display: grid;
        gap: 0.45rem;
        padding-top: 0.25rem;
        border-top: 1px solid var(--color-border);
    }

    .pos-charge-modal__footer .pos-charge-modal__actions {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(7rem, 0.7fr);
        align-items: stretch;
    }

    .pos-charge-modal__footer .pos-charge-modal__actions > button {
        min-width: 0;
        white-space: normal;
    }

    .pos-charge-modal__ghost,
    .pos-charge-modal__save,
    .pos-charge-modal__accept-print {
        min-height: 3rem;
        padding: 0.75rem 1rem;
        border-radius: 14px;
        font-weight: 800;
    }

    .pos-charge-modal__accept-print {
        border: 2px solid #f5b400;
        background: rgba(245, 180, 0, 0.12);
        color: #fef3c7;
    }

    .pos-charge-modal__accept-print:hover:not(:disabled) {
        background: rgba(245, 180, 0, 0.22);
    }

    .pos-charge-modal__save {
        border: 0;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.85), rgba(6, 182, 212, 0.95));
        color: #f8fafc;
    }

    .pos-product__text span {
        color: var(--color-muted);
        font-size: 0.72rem;
    }

    .pos-product__badges {
        padding: 0 0.7rem 0.7rem;
    }

    @@media (max-width: 1280px) {
        .pos-stage {
            grid-template-columns: 21rem minmax(0, 1fr);
        }

        .pos-stage.pos-stage--quick {
            grid-template-columns: minmax(25rem, 40%) minmax(0, 60%);
        }
    }

    @@media (max-width: 960px) {
        .pos-topbar {
            flex-direction: column;
            align-items: stretch;
        }

        .pos-topbar__brand {
            width: 100%;
            flex-wrap: wrap;
        }

        .pos-topbar__context {
            width: 100%;
            margin-left: 4.15rem;
        }

        .pos-topbar__actions {
            justify-content: stretch;
        }

        .pos-topbar__customer {
            width: 100%;
            max-width: none;
        }

        .pos-stage {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .pos-stage.pos-stage--quick {
            grid-template-columns: 1fr;
        }

        .pos-sidebar {
            order: 2;
        }

        .pos-catalog {
            order: 1;
        }
    }

    @@media (max-width: 640px) {
        .pos-shell {
            min-height: auto;
        }

        .pos-topbar,
        .pos-catalog__toolbar {
            padding-inline: 0.75rem;
        }

        .pos-catalog__toolbar,
        .pos-catalog__filters,
        .pos-catalog__search {
            flex-direction: column;
            align-items: stretch;
        }

        .pos-select {
            min-width: 0;
            width: 100%;
        }

        .pos-sidebar__footer {
            grid-template-columns: 1fr;
        }

        .pos-total-card {
            border-left: 0;
            border-top: 1px solid #d0d7e2;
        }

        .pos-item-modal {
            grid-template-columns: 1fr;
        }

        .pos-charge-modal__totals-head,
        .pos-charge-modal__payment-entry {
            grid-template-columns: 1fr;
        }

        .pos-charge-modal__payment-entry .pos-charge-modal__action {
            width: 100%;
        }
    }

    /* Ajustes finales POS */
    .pos-sidebar {
        display: flex;
        flex-direction: column;
        min-height: 0;
        height: 100%;
    }

    .pos-sidebar__items {
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .pos-sidebar__checkout {
        flex: 0 0 auto;
        margin-top: auto;
        position: relative;
        z-index: 2;
    }

    .pos-grid {
        grid-template-columns: repeat(auto-fill, minmax(142px, 1fr));
    }

    .pos-product {
        gap: 0;
        grid-template-rows: 104px 42px;
        min-height: 154px;
    }

    .pos-product__text {
        min-height: 42px;
        align-content: start;
        padding: 0.3rem 0.55rem 0.35rem;
    }

    .pos-product__text strong {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        font-size: 0.76rem;
        line-height: 1.15;
        min-height: calc(0.76rem * 1.15 * 2);
    }

    .pos-receipt-modal {
        position: fixed;
        inset: 2.5vh 2vw;
        z-index: 1110;
        max-height: calc(100vh - 5vh);
        display: grid;
        grid-template-columns: minmax(0, 3.2fr) minmax(240px, 1fr);
        grid-template-rows: minmax(0, 1fr);
        gap: 1.2rem;
        padding: 1.2rem;
        overflow: auto;
        background: linear-gradient(180deg, rgba(12, 24, 42, 0.96), rgba(10, 20, 35, 0.98));
        border: 1px solid var(--color-border);
        border-radius: 26px;
        box-shadow: 0 28px 72px rgba(0, 0, 0, 0.45);
    }

    .pos-receipt-modal__actions-panel,
    .pos-receipt-modal__preview {
        min-height: 0;
        background: var(--color-panel-strong);
        border: 1px solid var(--color-border);
        border-radius: 18px;
        overflow: hidden;
    }

    .pos-receipt-modal__actions-panel {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.35rem;
        min-height: 0;
        max-height: 100%;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .pos-receipt-modal__preview {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
    }

    .pos-receipt-modal__header,
    .pos-receipt-modal__preview-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .pos-receipt-modal__header h3,
    .pos-receipt-modal__preview-header h4 {
        margin: 0;
        color: var(--color-text);
    }

    .pos-receipt-modal__header p,
    .pos-receipt-modal__preview-header p {
        margin: 0.35rem 0 0;
        color: var(--color-muted);
    }

    .pos-receipt-modal__close {
        min-width: 2.7rem;
        min-height: 2.7rem;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: transparent;
        color: var(--color-text);
        font-size: 1.1rem;
        font-weight: 700;
    }

    .pos-receipt-modal__total {
        display: grid;
        gap: 0.2rem;
        justify-items: center;
        text-align: center;
        padding: 1.15rem 1.1rem;
        border: 1px solid rgba(34, 211, 238, 0.18);
        border-radius: 18px;
        background: rgba(14, 165, 233, 0.08);
    }

    .pos-receipt-modal__total span {
        color: var(--color-muted);
        font-size: 0.9rem;
    }

    .pos-receipt-modal__total strong {
        color: var(--color-text);
        font-size: 2rem;
    }

    .pos-receipt-modal__contact-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 12rem;
        gap: 0.8rem;
        align-items: stretch;
    }

    .pos-receipt-modal__public-qr {
        width: 100%;
        border: 1px solid rgba(34, 211, 238, 0.2);
        border-radius: 12px;
        background: rgba(15, 23, 42, 0.58);
        color: inherit;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.55rem;
        text-align: center;
    }

    .pos-receipt-modal__public-qr:hover {
        border-color: rgba(34, 211, 238, 0.7);
        background: rgba(14, 116, 144, 0.24);
    }

    .pos-public-qr-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1200;
        border: 0;
        background: rgba(2, 8, 23, 0.78);
    }

    .pos-public-qr-modal {
        position: fixed;
        inset: 50% auto auto 50%;
        z-index: 1201;
        transform: translate(-50%, -50%);
        display: grid;
        justify-items: center;
        gap: 1rem;
        width: min(90vw, 27rem);
        padding: 1.25rem;
        border: 1px solid rgba(34, 211, 238, 0.28);
        border-radius: 20px;
        background: #0d1d33;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
        text-align: center;
    }

    .pos-public-qr-modal__close {
        position: absolute;
        top: 0.65rem;
        right: 0.65rem;
        width: 2.2rem;
        height: 2.2rem;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.72);
        color: var(--color-text);
        font-weight: 800;
    }

    .pos-public-qr-modal img {
        width: min(70vw, 18rem);
        height: min(70vw, 18rem);
        padding: 0.7rem;
        border-radius: 12px;
        background: #fff;
    }

    .pos-public-qr-modal h4,
    .pos-public-qr-modal p {
        margin: 0;
    }

    .pos-public-qr-modal h4 {
        color: var(--color-text);
        font-size: 1.1rem;
    }

    .pos-public-qr-modal p {
        color: var(--color-muted);
        font-size: 0.9rem;
    }

    .pos-public-qr-modal__link {
        max-width: 100%;
        color: #67e8f9;
        font-size: 0.78rem;
        overflow-wrap: anywhere;
        text-decoration: underline;
    }

    .pos-receipt-modal__public-qr img {
        width: 120px;
        height: 120px;
        flex: 0 0 120px;
        padding: 0.25rem;
        border-radius: 8px;
        background: #fff;
    }

    .pos-receipt-modal__public-qr strong,
    .pos-receipt-modal__public-qr span {
        display: block;
    }

    .pos-receipt-modal__public-qr strong {
        color: var(--color-text);
        font-size: 0.78rem;
    }

    .pos-receipt-modal__public-qr span {
        margin-top: 0.2rem;
        color: var(--color-muted);
        font-size: 0.7rem;
    }

    .pos-receipt-modal__print {
        width: 100%;
        min-height: 3.2rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 16px;
        background: rgba(148, 163, 184, 0.22);
        color: var(--color-text);
        font-size: 1rem;
        font-weight: 800;
    }

    .pos-receipt-modal__mail {
        display: grid;
        gap: 0.65rem;
        min-width: 0;
        width: 100%;
    }

    @@media (max-width: 760px) {
        .pos-receipt-modal__contact-grid {
            grid-template-columns: 1fr;
        }

        .pos-receipt-modal__public-qr {
            flex-direction: row;
            text-align: left;
        }
    }

    @@media (max-height: 760px) {
        .pos-receipt-modal {
            inset: 1.5vh 1vw;
            gap: 0.75rem;
            padding: 0.75rem;
        }

        .pos-receipt-modal__actions-panel {
            gap: 0.65rem;
            padding: 0.9rem;
        }

        .pos-receipt-modal__total {
            padding: 0.75rem;
        }

        .pos-receipt-modal__total strong {
            font-size: 1.65rem;
        }

        .pos-receipt-modal__new {
            min-height: 3.35rem;
        }
    }

    .pos-receipt-modal__mail label {
        color: var(--color-text);
        font-weight: 700;
    }

    .pos-receipt-modal__mail-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.7rem;
        min-width: 0;
        width: 100%;
        align-items: start;
    }

    .pos-receipt-modal__mail input {
        width: 100%;
        min-height: 2.45rem;
        height: 2.45rem;
        align-self: start;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-panel);
        color: var(--color-text);
        padding: 0.55rem 0.75rem;
    }

    .pos-receipt-modal__mail button,
    .pos-receipt-modal__new {
        min-height: 3rem;
        border: 0;
        border-radius: 14px;
        padding: 0 1.2rem;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #fff;
        font-size: 1rem;
        font-weight: 800;
    }

    .pos-receipt-modal__mail button {
        height: 2.45rem;
        min-height: 2.45rem;
        align-self: start;
    }

    .pos-receipt-modal__new {
        position: sticky;
        bottom: 0;
        z-index: 2;
        min-height: 3.35rem;
        margin-top: auto;
        flex: 0 0 auto;
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        justify-items: start;
        gap: 0.8rem;
        padding: 0.45rem 0.75rem;
        background: linear-gradient(135deg, #12354d, #155e75);
        border: 1px solid rgba(34, 211, 238, 0.34);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
        font-size: 0.95rem;
    }

    .pos-receipt-modal__new:hover {
        background: linear-gradient(135deg, #16445f, #176b82);
    }

    .pos-receipt-modal__new-icon {
        display: grid;
        place-items: center;
        width: 2.35rem;
        height: 2.35rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.96);
        color: var(--color-primary);
        font-size: 1.2rem;
        font-weight: 900;
    }

    .pos-receipt-modal__mail-feedback {
        border-radius: 14px;
        padding: 0.8rem 0.95rem;
        font-size: 0.95rem;
    }

    .pos-receipt-modal__mail-feedback--ok {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.22);
        color: #b7f7d6;
    }

    .pos-receipt-modal__mail-feedback--error {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.22);
        color: #fecaca;
    }

    .pos-receipt-modal__meta {
        display: grid;
        gap: 0.65rem;
        align-content: start;
    }

    .pos-receipt-modal__meta-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: var(--color-muted);
    }

    .pos-receipt-modal__meta-row strong {
        color: var(--color-text);
    }

    .pos-receipt-modal__flag {
        display: inline-flex;
        align-items: center;
        margin-left: 0.55rem;
        padding: 0.16rem 0.45rem;
        border-radius: 999px;
        background: rgba(251, 191, 36, 0.18);
        color: #fbbf24;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    .pos-receipt-modal__cae {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: 10px;
        font-size: 0.82rem;
    }

    .pos-receipt-modal__cae--aprobado {
        background: rgba(34, 197, 94, 0.12);
        border: 1px solid rgba(34, 197, 94, 0.22);
        color: #86efac;
    }

    .pos-receipt-modal__cae--alerta {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.22);
        color: #fecaca;
    }

    .pos-receipt-modal__cae--pendiente {
        background: rgba(251, 191, 36, 0.14);
        border: 1px solid rgba(251, 191, 36, 0.25);
        color: #fde68a;
    }

    .pos-receipt-modal__cae-retry {
        border: 1px solid currentColor;
        background: transparent;
        color: inherit;
        border-radius: 999px;
        padding: 0.25rem 0.7rem;
        font-size: 0.76rem;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }

    .pos-receipt-modal__preview-header {
        padding: 1rem 1rem 0.65rem;
        border-bottom: 1px solid var(--color-border);
    }

    .pos-receipt-modal__frame {
        width: 100%;
        height: 100%;
        border: 0;
        background: #ffffff;
    }

    .pos-receipt-modal__designer-frame {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 0;
        flex: 1 1 auto;
        border: 0;
        border-radius: 0 0 0.8rem 0.8rem;
        background: #ffffff;
    }

    .pos-receipt-modal__preview-loading {
        display: grid;
        min-height: 0;
        height: 100%;
        place-items: center;
        color: var(--color-muted);
        background: #ffffff;
    }

    .pos-receipt-modal__frame--hidden {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .pos-reprint-list {
        display: grid;
        gap: 0.8rem;
        min-height: 0;
        max-height: min(22rem, calc(100vh - 18rem));
        overflow-y: auto;
    }

    .pos-reprint-filters {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.85rem;
        padding: 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-panel);
    }

    .pos-encargos-filters { display: grid; gap: 0.7rem; }
    .pos-encargos-filters__primary { display: grid; grid-template-columns: minmax(18rem, 1fr); gap: 0.65rem; align-items: end; }
    .pos-encargos-filters__secondary { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(9rem, 1fr) auto auto; gap: 0.65rem; align-items: end; }
    .pos-encargos-filters .pos-settings-modal__check-field { position: relative; display: flex; align-items: center; min-height: 2.5rem; padding: 0 0.6rem; border: 1px solid var(--color-border); border-radius: 0.65rem; background: var(--color-input); }
    .pos-encargos-switch__input { position: absolute; opacity: 0; pointer-events: none; }
    .pos-encargos-switch { width: 2.15rem; height: 1.2rem; display: inline-flex; align-items: center; padding: 0.15rem; margin-right: 0.45rem; border-radius: 999px; background: var(--color-border); transition: background .15s ease; }
    .pos-encargos-switch span { width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--color-text-muted); transition: transform .15s ease, background .15s ease; }
    .pos-encargos-switch__input:checked + .pos-encargos-switch { background: var(--color-primary); }
    .pos-encargos-switch__input:checked + .pos-encargos-switch span { transform: translateX(0.95rem); background: white; }
    .pos-encargos-switch__label { color: var(--color-text); font-size: 0.78rem; white-space: nowrap; }
    .pos-encargo-state { display: inline-flex; align-items: center; padding: .22rem .55rem; border-radius: 999px; font-size: .68rem; font-weight: 700; letter-spacing: .03em; }
    .pos-encargo-state--pending { color: #fbbf24; background: rgba(245, 158, 11, .15); border: 1px solid rgba(245, 158, 11, .3); }
    .pos-encargo-state--closed, .pos-encargo-state--finished { color: #86efac; background: rgba(34, 197, 94, .14); border: 1px solid rgba(34, 197, 94, .28); }
    .pos-encargo-state--cancelled, .pos-encargo-state--blocked { color: #fca5a5; background: rgba(239, 68, 68, .14); border: 1px solid rgba(239, 68, 68, .28); }
    .pos-encargo-inline-state { color: var(--color-text); font-weight: 600; }

    .pos-reprint-filters label {
        display: grid;
        gap: 0.25rem;
        color: var(--color-muted);
        font-size: 0.8rem;
    }

    .pos-reprint-filters input {
        min-height: 2.5rem;
        padding: 0.45rem 0.65rem;
        border: 1px solid var(--color-border);
        border-radius: 9px;
        background: var(--color-input);
        color: var(--color-text);
    }

    .pos-reprint-filters small {
        align-self: center;
        margin-left: auto;
        color: var(--color-muted);
    }

    @@media (max-width: 640px) {
        .pos-reprint-filters {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
            align-items: end;
            gap: 0.4rem;
            padding: 0.55rem;
        }

        .pos-reprint-filters label {
            min-width: 0;
            font-size: 0.68rem;
        }

        .pos-reprint-filters input {
            width: 100%;
            min-width: 0;
            min-height: 2.2rem;
            height: 2.2rem;
            padding: 0.3rem 0.35rem;
            font-size: 0.68rem;
        }

        .pos-reprint-filters > .btn {
            min-height: 2.2rem;
            padding: 0 0.55rem;
            white-space: nowrap;
            font-size: 0.72rem;
        }

        .pos-reprint-filters small {
            display: none;
        }
    }

    .pos-reprint-item {
        width: 100%;
        display: grid;
        gap: 0.45rem;
        padding: 0.95rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: var(--color-panel);
        color: var(--color-text);
        text-align: left;
    }

    .pos-reprint-item__header,
    .pos-reprint-item__meta,
    .pos-reprint-item__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
    }

    .pos-reprint-item__meta span,
    .pos-reprint-item__footer span {
        color: var(--color-muted);
    }

    .pos-encargos-table-wrap {
        min-height: 0;
        overflow: auto;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: var(--color-panel);
    }

    .pos-encargos-table {
        width: 100%;
        min-width: 67rem;
        border-collapse: collapse;
        color: var(--color-text);
        font-size: 0.78rem;
    }

    .pos-encargos-table th {
        position: sticky;
        top: 0;
        z-index: 1;
        padding: 0.65rem 0.7rem;
        background: var(--color-surface, var(--color-panel));
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text-muted, var(--color-muted));
        text-align: left;
        white-space: nowrap;
        font-weight: 600;
    }

    .pos-encargos-table td {
        padding: 0.7rem;
        border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
        vertical-align: middle;
        white-space: nowrap;
    }

    .pos-encargos-table__row {
        cursor: pointer;
        transition: background-color .15s ease;
    }

    .pos-encargos-table__row:hover {
        background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    }

    .pos-encargos-table__number {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .pos-encargos-table__actions {
        display: flex;
        gap: 0.35rem;
        justify-content: flex-end;
    }

    .pos-encargos-table .btn--sm {
        min-height: 1.9rem;
        padding: 0.2rem 0.55rem;
        font-size: 0.72rem;
    }

    /* Consulta de pedidos: adaptación visual local a AlfaDesign v1. */
    .pos-encargos-modal {
        width: 100vw;
        height: 100vh;
        max-height: 100vh;
        background: var(--alfa-bg-surface);
        border: 1px solid var(--alfa-border-default);
        color: var(--alfa-text-primary);
        border-radius: 0;
        box-shadow: var(--alfa-shadow-lg, 0 18px 50px rgba(0, 0, 0, .28));
    }

    .pos-encargos-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .65rem;
    }
    .pos-encargos-kpi {
        padding: .7rem .85rem;
        border: 1px solid var(--alfa-border-default);
        border-radius: var(--alfa-radius-sm, 10px);
        background: var(--alfa-bg-surface-raised, var(--alfa-bg-surface));
    }
    .pos-encargos-kpi span { display: block; color: var(--alfa-text-secondary); font-size: .72rem; }
    .pos-encargos-kpi strong { display: block; margin-top: .2rem; color: var(--alfa-text-primary); font-size: 1.05rem; }
    .pos-encargos-kpi--accent { border-color: color-mix(in srgb, var(--alfa-accent) 55%, var(--alfa-border-default)); }
    .pos-charge-modal__mode {
        margin: .2rem 0 0;
        color: var(--alfa-accent);
        font-size: .82rem;
        font-weight: 700;
    }
    .pos-encargos-detail .pos-encargo-actions { display: flex; flex-wrap: wrap; gap: .55rem; align-items: center; }
    @@media (max-width: 760px) {
        .pos-encargos-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pos-encargos-modal { width: calc(100vw - 1rem); height: calc(100vh - 1rem); max-height: calc(100vh - 1rem); }
    }

    .pos-encargos-modal .pos-settings-modal__header { border-bottom-color: var(--alfa-border-default); }
    .pos-encargos-modal .pos-settings-modal__header h3,
    .pos-encargos-modal .pos-settings-modal__header p,
    .pos-encargos-modal .pos-reprint-filters label,
    .pos-encargos-modal .pos-encargos-switch__label,
    .pos-encargos-modal .pos-grid-status { color: var(--alfa-text-primary); }
    .pos-encargos-modal .pos-settings-modal__header p,
    .pos-encargos-modal .pos-reprint-filters label,
    .pos-encargos-modal .pos-grid-status { color: var(--alfa-text-secondary); }
    .pos-encargos-modal .pos-settings-modal__close {
        border-color: var(--alfa-border-default);
        background: transparent;
        color: var(--alfa-text-secondary);
    }
