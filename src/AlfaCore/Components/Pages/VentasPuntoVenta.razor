                Numero = _lastSaleResult.Numero,
                Letra = _lastSaleResult.Letra,
                IdComprobanteTexto = _lastSaleResult.IdComprobanteTexto,
                Total = _lastSaleResult.Total,
                CaeEstado = intento.Estado.ToString(),
                Cae = intento.Cae,
                CaeVencimiento = intento.CaeVencimiento,
                CaeMotivo = intento.Motivo
            };
        }
