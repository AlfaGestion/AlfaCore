@if (_showCloseModuleConfirm)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar confirmación" @onclick="CloseCloseModuleConfirm"></button>
    <section class="pos-panel-modal" aria-label="Confirmar cierre del módulo">
        <div class="pos-settings-modal__header">
            <div>
                <h3>Cerrar punto de venta</h3>
                <p>No hay datos cargados. ¿Querés cerrar este módulo?</p>
            </div>
            <button type="button" class="pos-settings-modal__close" @onclick="CloseCloseModuleConfirm">X</button>
        </div>

        <div class="pos-settings-modal__actions">
            <button type="button" class="pos-settings-modal__ghost" @onclick="CloseCloseModuleConfirm">Cancelar</button>
            <button type="button" class="pos-settings-modal__save" @onclick="ConfirmCloseModule">Cerrar módulo</button>
        </div>
    </section>
}

@if (_showClaveCancelarModal)
{
    <button type="button" class="pos-item-modal-backdrop" aria-label="Cerrar ingreso de clave" @onclick="CerrarModalClaveCancelar"></button>
    <section class="pos-panel-modal" aria-label="@_claveCancelarTitulo">
        <div class="pos-settings-modal__header">
            <div>
                <h3>@_claveCancelarTitulo</h3>
                <p>@_claveCancelarMensaje</p>
            </div>
            <button type="button" class="pos-settings-modal__close" @onclick="CerrarModalClaveCancelar">X</button>
        </div>
        <div class="pos-settings-modal__field">
