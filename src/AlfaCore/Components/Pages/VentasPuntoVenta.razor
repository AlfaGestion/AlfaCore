    private void AddToCart(PuntoVentaArticleDto article, decimal? cantidad = null)
    {
        var ingresoRapidoAplicado = false;
        var cantidadFinal = cantidad ?? 1m;
        if (!cantidad.HasValue && _ingresoRapidoPendiente is not null && _settings.ConfirmarCantidadPrecio)
        {
            // Equivalente a OptThumb1_Click -> TxtAux1_KeyPress cuando la
            // configuración legacy exige confirmar cantidad/precio. El circuito
            // habitual agrega la línea y deja sus controles editables; no se
            // aplica silenciosamente el valor preparado por el panel.
            ConsumirIngresoRapido();
        }
        if (!cantidad.HasValue && _ingresoRapidoPendiente is { } ingresoRapido)
        {
            var existente = _cartItems.FirstOrDefault(x => string.Equals(x.IdArticulo, article.IdArticulo, StringComparison.OrdinalIgnoreCase));
            var precioBase = existente?.PrecioUnitario ?? article.PrecioUnitario;
            if (ingresoRapido.Modo == PosIngresoRapidoModo.Importe)
            {
                if (precioBase <= 0m)
                {
                    _scanError = "El artículo no tiene un precio unitario válido para calcular el importe solicitado.";
                    return;
                }

                if (existente is not null)
                {
                    var cantidadNueva = decimal.Round(
                        existente.Cantidad + ingresoRapido.Valor / precioBase,
                        2,
                        MidpointRounding.AwayFromZero);
                    if (!ValidarCantidadRapida(cantidadNueva, out var errorCantidadExistente))
                    {
                        _scanError = errorCantidadExistente;
                        return;
                    }

                    existente.Cantidad = cantidadNueva;
                    _cartScrollToIndex = _cartItems.IndexOf(existente);
                    _chargeSuccess = null;
                    ConsumirIngresoRapido();
                    return;
                }

                cantidadFinal = decimal.Round(
                    ingresoRapido.Valor / precioBase,
                    2,
                    MidpointRounding.AwayFromZero);
                if (!ValidarCantidadRapida(cantidadFinal, out var errorCantidadNueva))
                {
                    _scanError = errorCantidadNueva;
                    return;
                }

                var precioAjustado = decimal.Round(
                    ingresoRapido.Valor / cantidadFinal,
                    2,
                    MidpointRounding.AwayFromZero);
                AddToCartCore(article, cantidadFinal);
                var lineaNueva = _cartItems.FirstOrDefault(x => string.Equals(x.IdArticulo, article.IdArticulo, StringComparison.OrdinalIgnoreCase));
                if (lineaNueva is not null)
                    lineaNueva.PrecioUnitario = precioAjustado;
                ConsumirIngresoRapido();
                return;
            }

            if (!PosIngresoRapidoCalculador.TryCalcularCantidad(
                    ingresoRapido,
                    article.PrecioUnitario,
                    out cantidadFinal,
                    out var errorIngreso))
            {
                _scanError = errorIngreso;
                return;
            }

            ingresoRapidoAplicado = true;
        }

        var esArticuloManual = EsArticuloManual(article.IdArticulo);
        if (esArticuloManual || article.PrecioUnitario <= 0m)
        {
            if (ingresoRapidoAplicado)
            {
                _scanError = "El artículo requiere un precio unitario válido antes de usar el importe rápido.";
                return;
            }

            OpenManualArticleModal(
                article,
                cantidadFinal,
                esArticuloManual || string.IsNullOrWhiteSpace(article.Descripcion));
            return;
        }

        AddToCartCore(article, cantidadFinal);
        if (ingresoRapidoAplicado)
            ConsumirIngresoRapido();
    }

    private bool ValidarCantidadRapida(decimal cantidad, out string error)
    {
        error = string.Empty;
        if (cantidad <= 0m)
        {
            error = "La cantidad calculada debe ser mayor que cero.";
            return false;
        }

        return true;
    }

    private void ConsumirIngresoRapido()
    {
