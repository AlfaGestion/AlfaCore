    private static string ClaveSaldo(PuntoVentaTurnoSaldoMedioDto s) => $"{s.Cuenta}|{s.Moneda.Trim()}|{s.Cotizacion}";

    // Efectivo propuesto: lo contado (o, sin contar, saldo inicial + efectivo del turno) menos el fondo que queda.
    private decimal EfectivoPropuesto(PuntoVentaTurnoSaldoMedioDto s)
    {
        var disponible = _cierreSaldoFinalDeclarado > 0
            ? _cierreSaldoFinalDeclarado
            : (_turnoActual?.SaldoInicial ?? 0) + s.Saldo;
        return Math.Max(0, Math.Round(disponible - _cierreFondoQueda, 2));
    }

    private decimal GetImporteTransferir(PuntoVentaTurnoSaldoMedioDto s)
        => _cierreImportes.TryGetValue(ClaveSaldo(s), out var importe)
            ? importe
            : s.EsEfectivoLocal ? EfectivoPropuesto(s) : s.Saldo;

    private void SetImporteTransferir(PuntoVentaTurnoSaldoMedioDto s, object? valor)
    {
        var texto = (valor?.ToString() ?? string.Empty).Trim().Replace(',', '.');
        _cierreImportes[ClaveSaldo(s)] = decimal.TryParse(texto, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var importe)
            ? importe
            : 0;
    }

    private decimal TotalATransferir()
        => _cierreTransferir && _cierrePreview is not null
            ? _cierrePreview.Saldos.Sum(GetImporteTransferir)
            : 0;

