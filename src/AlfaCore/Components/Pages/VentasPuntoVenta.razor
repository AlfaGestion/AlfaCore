    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _idPuntoVentaActual > 0)
        {
            try
            {
                await Js.InvokeVoidAsync("localStorage.setItem", "alfacore.pos.puntoVentaId", _idPuntoVentaActual.ToString(System.Globalization.CultureInfo.InvariantCulture));
                await Js.InvokeVoidAsync("alfaCorePwa.preparePuntoVentaInstall", _idPuntoVentaActual);
            }
            catch
            {
                // La instalación y la persistencia local no bloquean el funcionamiento del POS.
            }

            if (IdPedidoQuery is null && _pedidoContexto is null)
                await RecoverPendingDraftAsync();
            else
                _pendingDraftRecoveryChecked = true;
        }

        if (_syncLayoutPanel)
        {
            _syncLayoutPanel = false;
            try { await Js.InvokeVoidAsync("alfaPosLayout.sincronizar"); } catch { /* el ajuste visual no bloquea la venta */ }
        }

        if (_pendingDraftRecoveryChecked
            && !_pendingDraftRestoring
            && _idPuntoVentaActual > 0
            && IdPedidoQuery is null
            && _pedidoContexto is null)
        {
            await PersistPendingDraftAsync();
        }

        if (_accionCajaActiva is not null && !_volviendoAlSalon && !HayVentanaDeCajaAbierta)
        {
            VolverAlSalonDesdeCaja();
            return;
        }

        if (_printReceiptAfterRender && _showReceiptModal && _lastSaleResult is not null)
        {
            _printReceiptAfterRender = false;
            var closeAfterPrint = _closeReceiptAfterPrint;
            _closeReceiptAfterPrint = false;
            await PrintReceiptAsync();
            if (closeAfterPrint && string.IsNullOrWhiteSpace(_receiptPreviewError))
            {
                CloseReceiptAfterAutomaticPrint();
                if (_pedidoContexto is not null)
                {
                    VolverAlOrigenDelPedido();
                    return;
                }
                await InvokeAsync(StateHasChanged);
            }
        }

        if (firstRender)
        {
            await Js.InvokeVoidAsync("alfaPosRegisterShortcuts");
        }

        if (_manualArticleFocusDescription && _manualArticlePending is not null)
        {
            _manualArticleFocusDescription = false;
            try { await _manualArticleDescriptionRef.FocusAsync(); } catch { }
        }
        else if (_manualArticleFocusPrice && _manualArticlePending is not null)
        {
            _manualArticleFocusPrice = false;
            try { await _manualArticlePriceRef.FocusAsync(); } catch { }
        }

        if (_lineObservationFocusPending && SelectedCartItem is not null)
        {
            _lineObservationFocusPending = false;
            try { await _lineObservationRef.FocusAsync(); } catch { }
        }

        if (_needScanFocus && _context is not null && !_loading && !_scanLoading)
        {
            _needScanFocus = false;
            await FocusScanAsync();
        }

        // Si la página actual no alcanza a llenar el área desplazable, no existe
        // un evento de scroll que pueda solicitar la siguiente página. Completar
        // el viewport evita que el usuario quede detenido en el mensaje inferior.
        if (!_catalogLoading
            && !_catalogLoadingMore
            && _catalog.Articulos.Count > 0
            && _catalog.TieneMasResultados)
        {
            var catalogoSinOverflow = await Js.InvokeAsync<bool>(
                "alfaPosCatalogNeedsMore", _catalogGridRef);
            if (catalogoSinOverflow)
            {
                await LoadMoreCatalogAsync();
                await InvokeAsync(StateHasChanged);
            }
        }

        if (_cartScrollToIndex is int cartScrollIndex)
        {
            _cartScrollToIndex = null;
            try
            {
                await Js.InvokeVoidAsync("alfaPosScrollCartTo", _cartItemsRef, cartScrollIndex);
            }
            catch
            {
                // Mostrar la línea agregada es solo una mejora visual; no debe afectar el POS.
            }
        }

        if (_mobileScrollToTop)
        {
            _mobileScrollToTop = false;
            try
            {
                await Js.InvokeVoidAsync("alfaPosScrollToTop", _mobileContentRef);
            }
            catch
            {
                // El reset del scroll es solo una mejora visual; no debe afectar el POS.
            }
        }
    }

    private string PendingDraftStorageKey()
    {
        var baseId = Convert.ToString(
            SessionSvc.GetActiveSession()?.BaseId,
            System.Globalization.CultureInfo.InvariantCulture) ?? "0";
        return $"alfacore.pos.pending.{baseId}.{_idPuntoVentaActual}";
    }

    private async Task RecoverPendingDraftAsync()
    {
        _pendingDraftRecoveryChecked = true;
        try
        {
            var json = await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                PendingDraftStorageKey());
            if (string.IsNullOrWhiteSpace(json))
                return;

            var draft = System.Text.Json.JsonSerializer.Deserialize<PendingPosDraft>(json);
            if (draft is null || draft.IdPuntoVenta != _idPuntoVentaActual || !draft.Items.Any())
            {
                await Js.InvokeVoidAsync("localStorage.removeItem", PendingDraftStorageKey());
                return;
            }

            var recuperar = await Js.InvokeAsync<bool>(
                "confirm",
                $"Hay un comprobante pendiente con {draft.Items.Sum(x => x.Cantidad):0.##} artículo(s) por {FmtMoney(draft.Items.Sum(x => x.Subtotal))}. ¿Querés recuperarlo?");

            if (!recuperar)
            {
                await Js.InvokeVoidAsync("localStorage.removeItem", PendingDraftStorageKey());
                return;
            }

            _pendingDraftRestoring = true;
            CartState.Clear();
            foreach (var item in draft.Items)
                _cartItems.Add(item);

            _tipoComprobanteSeleccionado = draft.TipoComprobante is "FC" or "NC" or "FP" or "NCFP" or "RM" or "NP"
                ? draft.TipoComprobante
                : _tipoComprobanteSeleccionado;
            _cuentaCliente = draft.CuentaCliente ?? string.Empty;
            _cuentaClienteNombre = draft.CuentaClienteNombre ?? string.Empty;
            _clienteDocumentoTipo = draft.ClienteDocumentoTipo ?? string.Empty;
            _clienteNumeroDocumento = draft.ClienteNumeroDocumento ?? string.Empty;
            _clienteIva = draft.ClienteIva ?? string.Empty;

            // Los pagos no se recuperan: si la recarga ocurrió durante una
            // cobranza, volver a cargarlos podría duplicar el importe.
            await RecalculateCartPricesAsync();
            await LoadCatalogAsync();
            _lastPendingDraftJson = null;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // La recuperación es una ayuda local; nunca debe impedir abrir el POS.
        }
        finally
        {
            _pendingDraftRestoring = false;
        }
    }

    private async Task PersistPendingDraftAsync()
    {
        try
        {
            if (!_cartItems.Any())
            {
                if (_lastPendingDraftJson is not null)
                {
                    await Js.InvokeVoidAsync("localStorage.removeItem", PendingDraftStorageKey());
                    _lastPendingDraftJson = null;
                }

                return;
            }

            var draft = new PendingPosDraft
            {
                IdPuntoVenta = _idPuntoVentaActual,
                TipoComprobante = _tipoComprobanteSeleccionado,
                CuentaCliente = _cuentaCliente,
                CuentaClienteNombre = _cuentaClienteNombre,
                ClienteDocumentoTipo = _clienteDocumentoTipo,
                ClienteNumeroDocumento = _clienteNumeroDocumento,
                ClienteIva = _clienteIva,
                Items = _cartItems.ToList()
            };
            var json = System.Text.Json.JsonSerializer.Serialize(draft);
            if (string.Equals(json, _lastPendingDraftJson, StringComparison.Ordinal))
                return;

            await Js.InvokeVoidAsync("localStorage.setItem", PendingDraftStorageKey(), json);
            _lastPendingDraftJson = json;
        }
        catch
        {
            // El borrador local no debe afectar el funcionamiento del POS.
        }
    }

    private sealed class PendingPosDraft
    {
        public int IdPuntoVenta { get; set; }
        public string TipoComprobante { get; set; } = "FC";
        public string CuentaCliente { get; set; } = string.Empty;
        public string CuentaClienteNombre { get; set; } = string.Empty;
        public string ClienteDocumentoTipo { get; set; } = string.Empty;
        public string ClienteNumeroDocumento { get; set; } = string.Empty;
        public string ClienteIva { get; set; } = string.Empty;
