    private async Task AbrirAccionCajaAsync(string accion)
    {
        accion = accion.Trim().ToLowerInvariant();
        switch (accion)
        {
            case "detalle":
                await OpenCashDetailModalAsync();
                break;
            case "movimientos":
                await OpenCashInOutModalAsync();
                break;
            case "saldos":
                await AbrirModalSaldosPorCajaAsync();
                break;
            case "reimprimir":
                await OpenReprintModalAsync();
                break;
            case "apertura":
                if (_turnoActual is not null)
                    return;
                AbrirModalApertura();
                break;
            case "cortex":
            case "cierre":
            case "turno":
                // Sin turno abierto no hay nada que cortar ni cerrar: queda el aviso "Abrir caja".
                if (_turnoActual is null)
                    return;
                if (accion == "cortex")
                    await AbrirModalCorteXAsync();
                else
                    await AbrirModalCierreCajaAsync();
                break;
            default:
                return;
        }

        _accionCajaActiva = accion;
    }

