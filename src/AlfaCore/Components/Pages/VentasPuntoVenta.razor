    /* Encabezado POS compacto y compartido entre escritorio y móvil. */
    .pos-topbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
        min-height: 4.45rem;
        padding: 0.55rem 1rem;
        background: #0d1b30;
        border-bottom: 1px solid var(--color-border);
        box-shadow: none;
    }

    .pos-topbar__brand {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
    }

    .pos-topbar__logo {
        width: 2.7rem;
        height: 2.7rem;
        border-radius: 0.75rem;
        background: linear-gradient(135deg, #14b8a6, #0891b2);
        color: #ffffff;
        font-size: 0.85rem;
        box-shadow: 0 7px 18px rgba(8, 145, 178, 0.2);
