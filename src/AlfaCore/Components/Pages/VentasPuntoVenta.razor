    private Task HandleEscapeShortcutAsync()
    {
        if (_showClaveCancelarModal)
            CerrarModalClaveCancelar();
        else if (_showPublicQrModal)
            ClosePublicQrModal();
        else if (_showReceiptModal)
            CloseReceiptModal();
        else if (_showChargeModal)
            CloseChargeModal();
        else if (_selectedCartItemId is not null)
            CloseCartItemModal();
        else if (_showClienteModal)
            _showClienteModal = false;
        else if (_showClearCartConfirm)
            CloseClearCartConfirm();
        else if (_showCloseModuleConfirm)
            CloseCloseModuleConfirm();
        else if (_showReprintModal)
            CloseReprintModal();
        else if (_showSettingsModal)
            CloseSettingsModal();
        else if (_showCashInOutModal)
            CloseCashInOutModal();
        else if (_showCashDetailModal)
            CloseCashDetailModal();
        else if (_showAperturaModal)
            CerrarModalApertura();
        else if (_showCierreCajaModal)
            CerrarModalCierreCaja();
        else if (_showCorteXModal)
            CerrarModalCorteX();
        else if (_showSaldosPorCajaModal)
            CerrarModalSaldosPorCaja();
        else if (_showPosMenu)
            _showPosMenu = false;
        else if (_cartItems.Any())
            OpenClearCartConfirm();
        else
            OpenCloseModuleConfirm();

        return Task.CompletedTask;
    }

    private async Task OpenChargeModalAsync()
    {
        if (!_cartItems.Any())
            return;

        if (_idPuntoVentaActual > 0 && _turnoActual is null)
        {
            _chargeError = "No hay un turno de caja abierto para este punto de venta. Abrí la caja antes de cobrar.";
            return;
        }

        _chargeError = null;
        _chargeSuccess = null;
        _showPosMenu = false;
        _showChargeModal = true;
        _selectedPaymentCode = string.Empty;
        _paymentMethodCodeFilter = string.Empty;
        _chargeAmountInput = PendingAmountInput();
        if (EsRemitoONotaPedido)
        {
            _npFechaEntregaDateInput = null;
            _npHoraEntregaInput = null;
            _npObservacionesInput = string.Empty;
            _npArcaBuscando = false;
            _npArcaMensaje = null;
            _npArcaOpciones = [];
            _npCargarAnticipoInput = false;
            if (string.IsNullOrWhiteSpace(_npNombreContactoInput))
                _npNombreContactoInput = _cuentaClienteNombre;
            if (string.IsNullOrWhiteSpace(_npDocumentoContactoInput))
                _npDocumentoContactoInput = _clienteNumeroDocumento;
        }
        // Cada cobranza debe iniciar con la simulación Point limpia. Si no se
        // reinicia, una selección anterior de tarjeta/cuotas queda visible al
        // volver a abrir el modal aunque el medio seleccionado sea MP QR.
        _mpPruebaTipo = "QR";
        _mpPruebaTarjetaTipo = "DEBITO";
        _mpPruebaCuotas = 1;
        await CargarLectoresPointParaCobroAsync();
        SelectDefaultPaymentMethod();

        if (_paymentMethods.Any())
        {
            await FocusChargeAmountAsync();
            return;
        }

        try
        {
            _paymentMethodsLoading = true;
            _paymentMethods = await PuntoVentaSvc.GetPaymentMethodsAsync();
            SelectDefaultPaymentMethod();
        }
        catch (Exception ex)
        {
            _chargeError = ex.Message;
        }
        finally
        {
            _paymentMethodsLoading = false;
        }

        SelectDefaultPaymentMethod();
        await FocusChargeAmountAsync();
    }

    private void CloseChargeModal()
    {
        if (_chargeSaving)
            return;

        if (!string.IsNullOrWhiteSpace(_mpUltimaReferenciaAprobada))
        {
            _chargeError = "El pago de Mercado Pago Point ya fue aprobado, pero la venta todavía no se grabó. No cierres esta ventana ni vuelvas a cobrar: presioná Aceptar para reintentar solamente la grabación de la venta.";
            return;
        }

        if (RequiereClaveCancelar())
        {
            AbrirModalClaveCancelar(
                "Cancelar cobranza",
                "Ingresá la clave para cancelar el pago actual.",
                () =>
                {
                    CerrarCobranzaInterno();
                    return Task.CompletedTask;
                });
            return;
        }

        CerrarCobranzaInterno();
    }

    private void CerrarCobranzaInterno()
    {

        // Si hay un cobro con Mercado Pago Point en curso, cerrar el modal no lo corta solo -- la
        // espera sigue corriendo en segundo plano (Blazor Server no la aborta porque el modal se
        // oculte). Se pide la cancelación prolija (misma que el botón "Cancelar cobro") para no
        // dejar una orden huérfana ni que termine agregando un pago a una venta ya cerrada.
        if (_mpCobrando)
            MpPaymentSvc.SolicitarCancelacion();

        _showChargeModal = false;
        _editandoNotaPedidoId = null;
        _facturandoNotaPedidoComprobante = string.Empty;
        _chargeError = null;
        _chargeAmountInput = string.Empty;
        _selectedPaymentCode = string.Empty;
        _paymentMethodCodeFilter = string.Empty;
        var anticiposConservados = _paymentLines
            .Where(x => x.EsAnticipo)
            .ToList();
        _paymentLines.Clear();
        _paymentLines.AddRange(anticiposConservados);
        _mpTerminalesDisponibles = [];
        _mpTerminalSeleccionada = string.Empty;
        _mpPointPuedeReintentar = false;
        _mpPointFueCancelado = false;
        _mpMetodoPointPendiente = null;
        _mpImportePointPendiente = 0m;
    }

    private async Task CargarLectoresPointParaCobroAsync()
    {
        _mpTerminalesDisponibles = [];
        _mpTerminalSeleccionada = string.Empty;

        if (_idPuntoVentaActual <= 0)
            return;

        try
        {
            var config = await MpConfigSvc.GetConfiguracionAsync();
            var puntoVenta = config.PuntosVenta.FirstOrDefault(x => x.Id == _idPuntoVentaActual);
            var terminales = puntoVenta?.TerminalesAsignadas
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? [];

            _mpTerminalesDisponibles = terminales;
            if (terminales.Count == 1)
                _mpTerminalSeleccionada = terminales[0];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudieron cargar los lectores Point del punto de venta {IdPuntoVenta}.", _idPuntoVentaActual);
        }
    }

    private void SeleccionarTipoComprobante(string tipo)
    {
        var comprobante = (tipo ?? string.Empty).Trim().ToUpperInvariant();
        if (!UsuarioTieneComprobante(comprobante))
        {
            _tipoComprobanteSeleccionado = PrimerComprobanteHabilitado();
            return;
        }

        if (comprobante is "FP" or "NCFP")
        {
            if (!PuedeUsarProforma)
                comprobante = "FC";
        }

        _tipoComprobanteSeleccionado = comprobante is "FC" or "NC" or "FP" or "NCFP" or "RM" or "NP"
            ? comprobante
            : "FC";
    }

    private void OnTipoComprobanteChanged(ChangeEventArgs args)
        => SeleccionarTipoComprobante(args.Value?.ToString() ?? "FC");

    /// <summary>Remito interno (RM) y Nota de pedido (NP) quedan pendientes de facturar: no piden medio
    /// de pago, no generan cobranza ni asiento contable (ver PuntoVentaService.CreateSaleAsync). El
    /// checkout del POS salta directo a confirmar en vez de pedir forma de pago para estos dos.</summary>
    private bool EsRemitoONotaPedido
        => _tipoComprobanteSeleccionado.Trim().ToUpperInvariant() is "RM" or "NP";

    private bool EsNotaPedido
        => _tipoComprobanteSeleccionado.Trim().Equals("NP", StringComparison.OrdinalIgnoreCase);

    private string TipoComprobanteSeleccionadoLabel()
        => _tipoComprobanteSeleccionado switch
        {
            "NC" => "NC · Nota de crédito",
            "FP" => "FP · Factura proforma",
            "NCFP" => "NCFP · Nota de crédito proforma",
            "RM" => "RM · Remito interno",
            "NP" => "NP · Nota de pedido",
            _ => "EFC · Factura electrónica (FC)"
        };

    private bool PuedeUsarProforma
        => _context?.UsaProforma == true
           && _context.VerProformaUsuario
           && UsuarioTieneComprobante(PuntoVentaComprobanteKeys.Proforma);

    private bool UsuarioTieneComprobante(string codigo)
        => _comprobantesAutorizados.Contains(codigo.Trim());

    private async Task CargarComprobantesAutorizadosAsync()
    {
        var comprobantes = PuntoVentaComprobanteKeys.Todos;
        var permisos = await Task.WhenAll(comprobantes.Select(async comprobante =>
        {
            var clave = PuntoVentaComprobantePermissionKeys.Para(comprobante);
            return (comprobante, permitido: clave.Length == 0 || await PermissionSvc.HasAccessAsync(clave));
        }));

        _comprobantesAutorizados.Clear();
        foreach (var permiso in permisos.Where(x => x.permitido))
            _comprobantesAutorizados.Add(permiso.comprobante);

        // Si la base todavía no tiene la actualización de tareas, no se bloquea el POS.
        if (_comprobantesAutorizados.Count == 0)
            _comprobantesAutorizados.UnionWith(comprobantes);
    }

    private string PrimerComprobanteHabilitado()
        => new[]
        {
            PuntoVentaComprobanteKeys.Factura,
            PuntoVentaComprobanteKeys.Proforma,
            PuntoVentaComprobanteKeys.NotaPedido,
            PuntoVentaComprobanteKeys.Remito
        }.FirstOrDefault(UsuarioTieneComprobante) ?? PuntoVentaComprobanteKeys.Factura;

    private void SelectPaymentMethod(string codigo)
    {
        _selectedPaymentCode = codigo?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_chargeAmountInput))
            _chargeAmountInput = PendingAmountInput();
    }

    private async Task SeleccionarAnticipoAsync(bool cargar)
    {
        _npCargarAnticipoInput = cargar;
        if (!cargar)
            return;

        if (string.IsNullOrWhiteSpace(_chargeAmountInput))
            _chargeAmountInput = PendingAmountInput();

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try { await Js.InvokeVoidAsync("alfaPosFocusSelect", _chargeAmountRef); } catch { }
    }

    private async Task HandlePaymentMethodClickAsync(string codigo)
    {
        _chargeError = null;
        SelectPaymentMethod(codigo);
        await FocusChargeAmountAsync();
    }

    private void SelectDefaultPaymentMethod()
    {
        var disponibles = PaymentMethodsFiltrados;
        var configurado = _settings.MedioDePagoContado?.Trim() ?? string.Empty;
        var medio = disponibles.FirstOrDefault(x => configurado.Length > 0
            && (string.Equals(x.CodigoOpcional?.Trim(), configurado, StringComparison.OrdinalIgnoreCase)
                || string.Equals(x.Codigo?.Trim(), configurado, StringComparison.OrdinalIgnoreCase)));

        medio ??= disponibles.FirstOrDefault(x =>
            string.Equals(x.CodigoOpcional?.Trim(), "EF", StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.Codigo?.Trim(), "EF", StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.MedioDePago?.Trim(), "EF", StringComparison.OrdinalIgnoreCase));

        medio ??= disponibles.FirstOrDefault(x =>
        {
            var descripcion = x.Descripcion?.Trim() ?? string.Empty;
            return descripcion.Contains("EFECTIVO", StringComparison.OrdinalIgnoreCase)
                || (descripcion.Contains("CAJA", StringComparison.OrdinalIgnoreCase)
                    && descripcion.Contains("EF", StringComparison.OrdinalIgnoreCase));
        });

        _selectedPaymentCode = medio?.Codigo ?? disponibles.FirstOrDefault()?.Codigo ?? string.Empty;
    }

