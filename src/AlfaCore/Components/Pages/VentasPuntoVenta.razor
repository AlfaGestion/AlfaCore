        try { await Js.InvokeVoidAsync("alfaPosFocusPaymentMethodList", _paymentMethodListRef); } catch { }
    }

    private async Task HandlePaymentMethodFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            await FocusPaymentMethodListAsync();
            return;
        }

        if (e.Key != "Enter")
            return;

        var (medio, coincidencias) = ResolverMedioDelFiltro();
        if (medio is null)
        {
            if (coincidencias > 1)
                await FocusPaymentMethodListAsync();
            return;
        }

        SelectPaymentMethod(medio.Codigo);
        await FocusChargeAmountAsync();
    }

    // Código exacto (código o código opcional) o, si el texto deja un único medio, ese medio.
    private (PuntoVentaPaymentMethodDto? Medio, int Coincidencias) ResolverMedioDelFiltro()
    {
        var filtrados = PaymentMethodsFiltrados;
        var texto = _paymentMethodCodeFilter.Trim();
        var coincidenciaCodigo = !string.IsNullOrWhiteSpace(texto)
            ? filtrados.FirstOrDefault(x =>
                string.Equals(x.Codigo?.Trim(), texto, StringComparison.OrdinalIgnoreCase)
                || string.Equals(x.CodigoOpcional?.Trim(), texto, StringComparison.OrdinalIgnoreCase))
            : null;
        return (coincidenciaCodigo ?? (filtrados.Count == 1 ? filtrados[0] : null), filtrados.Count);
    }

    // Al salir del código con Tab (o con el mouse) se resuelve igual que con Enter. Si el texto no identifica un medio
    // se quita la selección anterior, para no cargar el importe en un medio distinto del que se escribió.
    private void HandlePaymentMethodFilterBlur()
    {
        if (_paymentMethodCodeFilter.Trim().Length == 0)
            return;
        var (medio, coincidencias) = ResolverMedioDelFiltro();
        if (medio is not null)
        {
            SelectPaymentMethod(medio.Codigo);
            return;
        }
        _selectedPaymentCode = string.Empty;
        if (coincidencias == 0)
            _chargeError = $"No hay un medio de pago con el código «{_paymentMethodCodeFilter.Trim()}».";
    }

    private async Task AddSelectedPaymentAsync(bool focusFilterAfterAdd = true)
    {
        _chargeError = null;

        if (string.IsNullOrWhiteSpace(_selectedPaymentCode))
        {
            _chargeError = "Seleccioná un medio de pago antes de agregarlo.";
            return;
        }

        if (!TryParseMoney(_chargeAmountInput, out var importe) || importe <= 0)
        {
            _chargeError = "Ingresá un importe válido para el medio de pago.";
            return;
        }

        var method = _paymentMethods.FirstOrDefault(x => x.Codigo == _selectedPaymentCode);
        if (method is null)
        {
            _chargeError = "El medio de pago seleccionado ya no está disponible.";
            return;
        }

        var esEfectivo = IsCashPaymentMethod(method);
        if (_settings.CobranzaPFSoloEfectivo
            && _tipoComprobanteSeleccionado.Trim().ToUpperInvariant() is "FP" or "NCFP"
            && !esEfectivo)
        {
            _chargeError = "Las cobranzas de proforma solo pueden realizarse en efectivo.";
            return;
        }

        if (!esEfectivo && TotalPagado >= TotalCarrito)
        {
            _chargeError = "No podés agregar otro medio de pago: el total ya está cubierto. Solo efectivo puede generar vuelto.";
            return;
        }

        if (!esEfectivo && decimal.Round(TotalPagado + importe - TotalCarrito, 2) > 0)
        {
            _chargeError = $"El importe no puede superar el pendiente de {FmtMoney(PendienteCobro)} para este medio de pago.";
            return;
        }

        if (IsMercadoPagoPointMethod(method))
        {
            if (_mpTerminalesDisponibles.Count > 1 && string.IsNullOrWhiteSpace(_mpTerminalSeleccionada))
            {
                _chargeError = "Seleccioná el lector de Mercado Pago Point que se va a utilizar.";
                return;
            }

            await IniciarCobroMercadoPagoAsync(method, decimal.Round(importe, 2), focusFilterAfterAdd);
            return;
        }

        _paymentLines.Add(new PuntoVentaPaymentLineDto
        {
            CodigoMedioPago = method.Codigo,
            DescripcionMedioPago = method.Descripcion,
            Importe = decimal.Round(importe, 2)
        });

        _chargeAmountInput = TotalPagado >= TotalCarrito
            ? FmtInputAmount(importe)
            : PendingAmountInput();
        if (focusFilterAfterAdd)
            await FocusPaymentMethodFilterAsync();
    }

    private static bool IsCashPaymentMethod(PuntoVentaPaymentMethodDto method)
    {
        var codigo = method.Codigo?.Trim() ?? string.Empty;
        var codigoOpcional = method.CodigoOpcional?.Trim() ?? string.Empty;
        var medio = method.MedioDePago?.Trim() ?? string.Empty;
        var descripcion = method.Descripcion?.Trim() ?? string.Empty;

        return string.Equals(codigo, "EF", StringComparison.OrdinalIgnoreCase)
            || string.Equals(codigoOpcional, "EF", StringComparison.OrdinalIgnoreCase)
            || string.Equals(medio, "EF", StringComparison.OrdinalIgnoreCase)
            || descripcion.Contains("EFECTIVO", StringComparison.OrdinalIgnoreCase)
            || (descripcion.Contains("CAJA", StringComparison.OrdinalIgnoreCase)
                && descripcion.Contains("EF", StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>No hay ningún código fijo tipo "MPPOINT": cada base define sus códigos. Se admiten
    /// tanto Codigo como CodigoOpcional para mantener compatibilidad con las bases donde el formulario
    /// VB6 guardaba CodigoOpcional en Point_Medios_Pago.</summary>
    private bool IsMercadoPagoPointMethod(PuntoVentaPaymentMethodDto method)
        => _mpMediosConfigurados.Count > 0
           && (_mpMediosConfigurados.Contains(method.Codigo?.Trim() ?? string.Empty)
               || _mpMediosConfigurados.Contains(method.CodigoOpcional?.Trim() ?? string.Empty));

    private PuntoVentaPaymentMethodDto ResolverMedioPagoPoint(
        PuntoVentaPaymentMethodDto medioSeleccionado,
        AlfaCore.Services.MercadoPagoPoint.Models.PaymentResult resultado)
    {
        if (!_mpObtenerMedioAutomatico)
            return medioSeleccionado;

        var marca = NormalizarMedioPago(resultado.CardType);
        var tipo = NormalizarMedioPago(resultado.PaymentMethodType);
        var idMedio = NormalizarMedioPago(resultado.PaymentMethodId);
        if (string.IsNullOrWhiteSpace(marca) && string.IsNullOrWhiteSpace(tipo) && string.IsNullOrWhiteSpace(idMedio))
            return medioSeleccionado;

        var candidatos = _paymentMethods
            .Where(x => !string.IsNullOrWhiteSpace(x.Codigo)
                        && (_mpMediosConfigurados.Contains(x.Codigo?.Trim() ?? string.Empty)
                            || _mpMediosConfigurados.Contains(x.CodigoOpcional?.Trim() ?? string.Empty)))
            .Select(x => new
            {
                Medio = x,
                Texto = NormalizarMedioPago($"{x.Descripcion} {x.Codigo} {x.CodigoOpcional} {x.MedioDePago}")
            })
            .Select(x => new
            {
                x.Medio,
                Puntaje = PuntuarMedioPago(x.Texto, marca, tipo, idMedio)
            })
            .Where(x => x.Puntaje > 0)
            .OrderByDescending(x => x.Puntaje)
            .ThenBy(x => x.Medio.Descripcion)
            .FirstOrDefault();

        return candidatos?.Medio ?? medioSeleccionado;
    }

    private static int PuntuarMedioPago(string candidato, string marca, string tipo, string idMedio)
    {
        var puntaje = 0;
        if (!string.IsNullOrWhiteSpace(marca) && candidato.Contains(marca, StringComparison.OrdinalIgnoreCase))
            puntaje += 4;

        var familia = tipo switch
        {
            var valor when valor.Contains("credit", StringComparison.OrdinalIgnoreCase)
                || valor.Contains("credito", StringComparison.OrdinalIgnoreCase) => "credito",
            var valor when valor.Contains("debit", StringComparison.OrdinalIgnoreCase)
                || valor.Contains("debito", StringComparison.OrdinalIgnoreCase) => "debito",
            var valor when valor.Contains("prepaid", StringComparison.OrdinalIgnoreCase)
                || valor.Contains("prepaga", StringComparison.OrdinalIgnoreCase) => "prepaga",
            _ => string.Empty
        };

        if (familia.Length > 0 && candidato.Contains(familia, StringComparison.OrdinalIgnoreCase))
            puntaje += 3;

        if (!string.IsNullOrWhiteSpace(idMedio) && candidato.Contains(idMedio, StringComparison.OrdinalIgnoreCase))
            puntaje += 2;

        // Con una marca o un identificador informado por Point alcanza para elegir
        // un medio específico. Para una respuesta genérica (solo credit_card/debit_card)
        // exigimos que el medio configurado también describa esa familia.
        return puntaje;
    }

    private static string NormalizarMedioPago(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return string.Empty;

        var texto = valor.Trim().Normalize(System.Text.NormalizationForm.FormD);
        var resultado = new System.Text.StringBuilder(texto.Length);
        foreach (var caracter in texto)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(caracter) == System.Globalization.UnicodeCategory.NonSpacingMark)
                continue;

            resultado.Append(char.IsLetterOrDigit(caracter) ? char.ToLowerInvariant(caracter) : ' ');
        }

        return string.Join(' ', resultado.ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries));
    }

    private async Task IniciarCobroMercadoPagoAsync(PuntoVentaPaymentMethodDto method, decimal importe, bool focusFilterAfterAdd)
    {
        if (importe < 15m)
        {
            _chargeError = "El importe mínimo para cobrar con Mercado Pago Point es de $ 15,00. Ingresá un importe mayor o igual a ese valor.";
            return;
        }

        try
        {
            await PuntoVentaSvc.ValidarPrerequisitosCobroAsync(_tipoComprobanteSeleccionado);
        }
        catch (Exception ex)
        {
            _chargeError = MensajeErrorPrerequisitoCobro(ex);
            return;
        }

        _mpCobrando = true;
        _mpPointPuedeReintentar = false;
        _mpPointFueCancelado = false;
        _mpMetodoPointPendiente = method;
        _mpImportePointPendiente = importe;
        _mpEstadoCobro = "Iniciando cobro...";
        _chargeError = null;
        var externalReference = $"POS-{_idPuntoVentaActual}-{DateTime.UtcNow:yyyyMMddHHmmssfff}";
        var grabarAutomaticamente = false;

        try
        {
            var resultado = await MpPaymentSvc.CobrarAsync(importe, externalReference, status =>
            {
                _mpEstadoCobro = status;
                InvokeAsync(StateHasChanged);
            }, idPuntoVenta: _idPuntoVentaActual, terminalId: _mpTerminalSeleccionada);

            if (!resultado.Approved)
            {
                _chargeError = MensajeErrorMercadoPagoPoint(resultado.Message);
                _mpPointFueCancelado = EsCancelacionPoint(resultado.Message);
                _mpPointPuedeReintentar = true;
                return;
            }

            var medioAplicado = ResolverMedioPagoPoint(method, resultado);
            var importeFinal = resultado.ApprovedAmount > 0
                ? decimal.Round((decimal)resultado.ApprovedAmount, 2)
                : importe;
            var recargo = Math.Max(decimal.Round(importeFinal - importe, 2), 0m);
            var detalleRecargo = recargo > 0
                ? $"Recargo tarjeta{(resultado.Installments > 0 ? $" — {resultado.Installments} cuota{(resultado.Installments == 1 ? string.Empty : "s")}" : string.Empty)}: {FmtMoney(recargo)}"
                : string.Empty;
            _mpUltimaReferenciaAprobada = externalReference;
            _paymentLines.Add(new PuntoVentaPaymentLineDto
            {
                CodigoMedioPago = medioAplicado.Codigo,
                DescripcionMedioPago = medioAplicado.Descripcion,
                Observaciones = detalleRecargo,
                Recargo = recargo,
                Importe = importeFinal
            });

            _chargeAmountInput = TotalPagado >= TotalCarrito ? FmtInputAmount(importeFinal) : PendingAmountInput();
            if (focusFilterAfterAdd)
                await FocusPaymentMethodFilterAsync();

            // El pago Point ya fue aprobado. La grabación automática se hace
            // después de salir del estado _mpCobrando para que ConfirmChargeAsync
            // no lo interprete como un cobro todavía en curso.
            grabarAutomaticamente = PendienteCobro <= 0.01m;
        }
        catch (Exception ex)
        {
            _chargeError = MensajeErrorMercadoPagoPoint(ex.Message);
            _mpPointFueCancelado = EsCancelacionPoint(ex.Message);
            _mpPointPuedeReintentar = true;
        }
        finally
        {
            _mpCobrando = false;
        }

        if (grabarAutomaticamente && string.IsNullOrWhiteSpace(_chargeError))
            await ConfirmChargeAsync(false);
    }

    private async Task SimularPagoPointCreditoAsync()
    {
        if (!_mpModoPrueba)
            return;

        if (!TryParseMoney(_chargeAmountInput, out var importe) || importe < 15m)
        {
            _chargeError = "Ingresá un importe de prueba mayor o igual a $ 15,00.";
            return;
        }

        // La simulación debe respetar la misma regla que un cobro Point real:
        // una tarjeta/QR no puede superar el faltante de la cobranza. Sin esta
        // validación se podía simular sobre un importe viejo mayor al carrito
        // y calcular, por ejemplo, el 15 % de $ 6.300 en vez de $ 3.500.
        if (importe > PendienteCobro + 0.01m)
        {
            _chargeError = $"El importe no puede superar el pendiente de {FmtMoney(PendienteCobro)} para este medio de pago.";
            return;
        }

        var method = _paymentMethods.FirstOrDefault(x => x.Codigo == _selectedPaymentCode);
        if (method is null || !IsMercadoPagoPointMethod(method))
        {
            _chargeError = "Seleccioná un medio configurado para Mercado Pago Point.";
            return;
        }

        var esTarjeta = _mpPruebaTipo == "TARJETA";
        var esCredito = esTarjeta && _mpPruebaTarjetaTipo == "CREDITO";
        var porcentajeRecargo = esCredito ? PorcentajeRecargoPrueba(_mpPruebaCuotas) : 0m;
        var recargo = decimal.Round(importe * porcentajeRecargo / 100m, 2, MidpointRounding.AwayFromZero);
        var importeFinal = decimal.Round(importe + recargo, 2, MidpointRounding.AwayFromZero);
        var resultado = new AlfaCore.Services.MercadoPagoPoint.Models.PaymentResult
        {
            Approved = true,
            ApprovedAmount = (double)importeFinal,
            PaymentMethodType = _mpPruebaTipo == "QR"
                ? "qr"
                : _mpPruebaTarjetaTipo == "CREDITO" ? "credit_card" : "debit_card",
            CardType = esTarjeta ? _mpPruebaTarjetaTipo.ToLowerInvariant() : string.Empty,
            PaymentMethodId = esTarjeta ? "visa" : "qr",
            Installments = esCredito ? _mpPruebaCuotas : 0,
            PaymentId = "SIMULADO-POINT"
        };

        var medioAplicado = ResolverMedioPagoPoint(method, resultado);
        _paymentLines.Add(new PuntoVentaPaymentLineDto
        {
            CodigoMedioPago = medioAplicado.Codigo,
            DescripcionMedioPago = $"{medioAplicado.Descripcion} (prueba)",
            Observaciones = esCredito
                ? $"Recargo Point simulado: {FmtMoney(recargo)} · {_mpPruebaCuotas} cuota{(_mpPruebaCuotas == 1 ? string.Empty : "s")} · {FmtPercent(porcentajeRecargo)}"
                : $"Pago Point simulado: {_mpPruebaTipo}{(esTarjeta ? $" {_mpPruebaTarjetaTipo}" : string.Empty)}",
            Recargo = recargo,
            Importe = importeFinal
        });

        _chargeError = null;
        _chargeAmountInput = TotalPagado >= TotalCarrito ? FmtInputAmount(importeFinal) : PendingAmountInput();
        await InvokeAsync(StateHasChanged);

        if (PendienteCobro <= 0.01m)
            await ConfirmChargeAsync(false);
    }

    private static decimal PorcentajeRecargoPrueba(int cuotas)
        => cuotas switch
        {
            1 => 5m,
            2 => 15m,
            >= 3 and <= 12 => 15m + ((cuotas - 1) * 5m),
            _ => 0m
        };

    private static decimal ResolverTasaIvaRecargo(IEnumerable<PuntoVentaCartItemDto> items)
        => items
            .Where(x => !x.Exento && x.TasaIva > 0m && x.Subtotal > 0m)
            .GroupBy(x => decimal.Round(x.TasaIva, 4))
            .Select(x => new { Tasa = x.Key, Importe = x.Sum(i => i.Subtotal) })
            .OrderByDescending(x => x.Importe)
            .ThenByDescending(x => x.Tasa)
            .Select(x => x.Tasa)
            .FirstOrDefault();

    private static string FmtPercent(decimal value) => $"{value:0.##}%";

    private async Task ReintentarCobroPointAsync()
    {
        if (_mpMetodoPointPendiente is null || _mpImportePointPendiente <= 0)
            return;

        _chargeError = null;
        await IniciarCobroMercadoPagoAsync(_mpMetodoPointPendiente, _mpImportePointPendiente, false);
    }

    private void SolicitarCancelarReintentoPoint()
    {
        if (RequiereClaveCancelar())
        {
            AbrirModalClaveCancelar(
                "Cancelar pago",
                "Ingresá la clave para cancelar el pago.",
                () =>
                {
                    CancelarReintentoPoint();
                    return Task.CompletedTask;
                });
            return;
        }

        CancelarReintentoPoint();
    }

    private void CancelarReintentoPoint()
    {
        // Cancela solo la posibilidad de reintentar Point. La cobranza permanece
        // abierta para seleccionar otro medio o corregir el importe.
        _mpPointPuedeReintentar = false;
        _mpPointFueCancelado = false;
        _mpMetodoPointPendiente = null;
        _mpImportePointPendiente = 0m;
        _mpEstadoCobro = string.Empty;
        _chargeError = null;
    }

    private static string MensajeErrorMercadoPagoPoint(string? detalle)
    {
        var texto = detalle?.Trim() ?? string.Empty;
        var normalizado = texto.ToLowerInvariant();

        if (normalizado.Contains("transactions.payments") && normalizado.Contains("amount")
            && (normalizado.Contains("greater than or equal") || normalizado.Contains("minimum")))
        {
            return "El importe mínimo para cobrar con Mercado Pago Point es de $ 15,00. Ingresá un importe mayor o igual a ese valor.";
        }

        if (normalizado.Contains("unauthorized") || normalizado.Contains("invalid access token")
            || normalizado.Contains("invalid token") || normalizado.Contains("401"))
        {
            return "El Access Token de Mercado Pago no es válido o venció. Revisá la configuración de Mercado Pago Point.";
        }

        if (normalizado.Contains("device") && (normalizado.Contains("not found") || normalizado.Contains("unavailable")))
        {
            return "No se encontró una terminal Point disponible para este punto de venta. Actualizá las terminales y revisá su asignación.";
        }

        if (normalizado.Contains("timeout") || normalizado.Contains("timed out") || normalizado.Contains("time out"))
        {
            return "Mercado Pago no respondió a tiempo. Verificá la conexión y el estado de la terminal antes de volver a intentar.";
        }

        if (normalizado.Contains("cancel") || normalizado.Contains("cancelled") || normalizado.Contains("canceled"))
            return "El cobro fue cancelado en la terminal Point.";

        if (string.IsNullOrWhiteSpace(texto))
            return "No se pudo completar el cobro con Mercado Pago Point. Verificá la terminal e intentá nuevamente.";

        return $"No se pudo completar el cobro con Mercado Pago Point. {texto}";
    }

    private static string EstadoPointVisible(string? estado)
        => (estado ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "created" => "Enviando el cobro al lector...",
            "at_terminal" => "Espere por favor. Complete el pago en el lector.",
            "processed" or "approved" => "El pago se realizó correctamente.",
            "failed" or "rejected" => "El pago no fue aprobado.",
            "canceled" or "cancelled" => "La operación fue cancelada.",
            "" => "Conectando con Mercado Pago...",
            _ => "Esperando la respuesta del lector..."
        };

    private static bool EsCancelacionPoint(string? detalle)
