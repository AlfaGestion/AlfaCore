    private async Task ConsultarNpAnticiposAsync()
    {
        if (!EsMostradorProduccion || _npAnticiposLoading)
            return;

        var comprobante = _npAnticiposIdComprobante.Trim();
        if (comprobante.Length == 0)
        {
            _npAnticiposResultado = null;
            _npAnticiposError = "Ingresá el número completo de la nota de pedido.";
