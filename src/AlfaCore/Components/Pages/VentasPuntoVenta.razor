@if (_showAperturaModal)
{
    <div class="cuentas-modal-backdrop" @onclick="CerrarModalApertura">
    <section class="cuentas-modal" role="dialog" aria-label="Abrir caja" @onclick:stopPropagation>
        <header class="cuentas-modal__header">
            <h3>Abrir caja</h3>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarModalApertura">Cerrar</button>
        </header>
        <div class="cuentas-modal__body">
            @if (!string.IsNullOrWhiteSpace(_aperturaError))
            {
                <div class="editor-msg editor-msg--error">
                    <strong>No se pudo abrir la caja</strong>
                    <span>@_aperturaError</span>
                </div>
            }
            <div class="field">
                <label>Saldo inicial</label>
                <input type="number" step="0.01" min="0" @bind="_aperturaSaldoInicial" />
                <span class="pos-field-hint">Escribilo directamente, o contá los billetes y monedas abajo — el total se copia acá solo.</span>
            </div>

            <p>Conteo de billetes y monedas <em>(opcional — solo si preferís contar en vez de escribir el importe)</em></p>
            <div class="pos-billetes-grid">
                @foreach (var d in _denominaciones)
                {
                    <div class="pos-billete-row">
                        <span>@FmtMoney(d.Valor)</span>
                        <input type="number" min="0" value="@GetAperturaCantidad(d.Id)"
                               @onchange="e => SetAperturaCantidad(d.Id, ParseIntSafe(e.Value))" />
                        <span>@FmtMoney(GetAperturaCantidad(d.Id) * d.Valor)</span>
                    </div>
                }
            </div>
            <p><strong>Total contado: @FmtMoney(AperturaTotalBilletes())</strong></p>

            <div class="field">
                <label>Observaciones</label>
                <input @bind="_aperturaObservaciones" placeholder="Opcional" />
            </div>
        </div>
        <footer class="cuentas-modal__actions">
            <button type="button" class="btn btn--primary" @onclick="ConfirmarAperturaAsync" disabled="@_aperturaSaving">
                @(_aperturaSaving ? "Abriendo..." : "Abrir caja")
            </button>
            <button type="button" class="btn btn--ghost" @onclick="CerrarModalApertura">Cancelar</button>
        </footer>
    </section>
    </div>
}

@if (_cierreResultado is not null)
{
    <div class="cuentas-modal-backdrop" @onclick="CerrarResultadoCierre">
    <section class="cuentas-modal" role="dialog" aria-label="Caja cerrada" @onclick:stopPropagation>
        <header class="cuentas-modal__header">
            <h3>Caja cerrada</h3>
        </header>
        <div class="cuentas-modal__body">
            <p>El turno quedó cerrado. Diferencia de arqueo: <strong>@FmtMoney(_cierreResultado.Diferencia)</strong></p>
            @if (!string.IsNullOrWhiteSpace(_cierreResultado.Comprobante))
            {
                <p>Se transfirieron <strong>@FmtMoney(_cierreResultado.ImporteTransferido)</strong> a <strong>@_cierreResultado.CajaDestino</strong> (comprobante @_cierreResultado.Comprobante).</p>
            }
            <p>Fondo que queda en la caja: <strong>@FmtMoney(_cierreFondoQueda)</strong></p>
        </div>
        <footer class="cuentas-modal__actions">
            <button type="button" class="btn btn--primary" @onclick="CerrarResultadoCierre">
                @(_accionCajaActiva == "turno" ? "Abrir el turno siguiente" : "Listo")
            </button>
