    private async Task HandleScanKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var raw = _scanCode.Trim();
        if (raw.Length == 0) return;

        // Soporte formato "cantidad*codigo", ej: 3*7791728001723 o -3*7791728001723 (devolucion)
        decimal cantidad = 1m;
        string codigo;
        var starIdx = raw.IndexOf('*');
        if (starIdx > 0 && starIdx < raw.Length - 1)
        {
            var cantPart = raw[..starIdx].Trim();
            var codPart  = raw[(starIdx + 1)..].Trim().ToUpperInvariant();
            if (decimal.TryParse(cantPart, System.Globalization.NumberStyles.Any,
                                 System.Globalization.CultureInfo.InvariantCulture, out var parsedCant)
                && parsedCant != 0m && codPart.Length > 0)
            {
                cantidad = parsedCant;
                codigo   = codPart;
            }
            else
            {
                codigo = raw.ToUpperInvariant();
            }
        }
        else
        {
            codigo = raw.ToUpperInvariant();
        }

        _scanError = string.Empty;
        _scanLoading = true;
        try
        {
            var art = await PuntoVentaSvc.GetArticuloPorCodigoAsync(codigo);
            if (art is not null)
            {
                AddToCart(art, cantidad);
                _scanCode = string.Empty;
            }
            else
            {
                _scanError = $"No se encontró el artículo con código \"{codigo}\".";
            }
        }
        catch (Exception ex)
        {
            _scanError = ex.Message;
        }
        finally
        {
            _scanLoading = false;
        }
        _needScanFocus = true;
    }

