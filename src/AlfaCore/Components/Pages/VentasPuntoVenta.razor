    private Task AddSelectedPaymentAsync()
    {
        _chargeError = null;

        if (string.IsNullOrWhiteSpace(_selectedPaymentCode))
        {
            _chargeError = "Seleccioná un medio de pago antes de agregarlo.";
            return Task.CompletedTask;
        }

        if (!TryParseMoney(_chargeAmountInput, out var importe) || importe <= 0)
        {
            _chargeError = "Ingresá un importe válido para el medio de pago.";
            return Task.CompletedTask;
        }

        var method = _paymentMethods.FirstOrDefault(x => x.Codigo == _selectedPaymentCode);
        if (method is null)
        {
            _chargeError = "El medio de pago seleccionado ya no está disponible.";
            return Task.CompletedTask;
        }

        _paymentLines.Add(new PuntoVentaPaymentLineDto
        {
            CodigoMedioPago = method.Codigo,
            DescripcionMedioPago = method.Descripcion,
            Importe = decimal.Round(importe, 2)
        });

        _chargeAmountInput = PendingAmountInput();
        return Task.CompletedTask;
    }

    private void RemovePaymentLine(PuntoVentaPaymentLineDto line)
    {
        if (line is null)
            return;

        _paymentLines.Remove(line);
        _chargeError = null;
        _chargeAmountInput = PendingAmountInput();
    }

    private async Task ConfirmChargeAsync()
    {
        _chargeError = null;
        _chargeSuccess = null;

        if (!_cartItems.Any())
        {
            _chargeError = "No hay artículos en el carrito para cobrar.";
            return;
        }

        if (!_paymentLines.Any())
        {
            _chargeError = "Agregá al menos un medio de pago.";
            return;
        }

        if (PendienteCobro > 0.01m)
        {
            _chargeError = "El total cobrado debe cubrir al menos el total del carrito.";
            return;
        }

        if (_idPuntoVentaActual > 0 && _turnoActual is null)
        {
            _chargeError = "No hay un turno de caja abierto para este punto de venta. Abrí la caja antes de cobrar.";
            return;
        }

        try
        {
            _chargeSaving = true;
            var soldItems = _cartItems
                .Select(x => new PuntoVentaCartItemDto
                {
                    IdArticulo = x.IdArticulo,
                    Descripcion = x.Descripcion,
                    Presentacion = x.Presentacion,
                    PrecioUnitario = x.PrecioUnitario,
                    Cantidad = x.Cantidad,
                    TasaIva = x.TasaIva,
                    Exento = x.Exento,
                    Familia = x.Familia
                })
                .ToList();

            var soldPayments = _paymentLines
                .Select(x => new PuntoVentaPaymentLineDto
                {
                    CodigoMedioPago = x.CodigoMedioPago,
                    DescripcionMedioPago = x.DescripcionMedioPago,
                    Importe = x.Importe
                })
                .ToList();

            var result = await PuntoVentaSvc.CreateSaleAsync(new PuntoVentaSaleRequestDto
            {
                CuentaCliente = !string.IsNullOrEmpty(_cuentaCliente) ? _cuentaCliente : _settings.CuentaConsumidorFinal,
                Fecha = DateTime.Today,
                TipoComprobante = _context?.TipoComprobanteDefault ?? "FC",
                Sucursal = _pedidoSucursalOverride ?? _context?.SucursalDefault ?? "0001",
                Items = soldItems,
                Pagos = soldPayments
            });

            _lastSaleResult = result;

            if (_turnoActual is not null)
            {
                try
                {
                    var importeEfectivo = soldPayments
                        .Where(p => string.Equals(
                            _paymentMethods.FirstOrDefault(m => m.Codigo == p.CodigoMedioPago)?.MedioDePago?.Trim(),
                            "EF", StringComparison.OrdinalIgnoreCase))
                        .Sum(p => p.Importe);

                    await TurnoSvc.RegistrarMovimientoAsync(_turnoActual.Id, result.TipoComprobante, result.IdComprobanteTexto, result.Total, importeEfectivo);
                }
                catch (Exception ex)
                {
                    _pedidoError = $"La venta se registró pero no se pudo actualizar el turno de caja: {ex.Message}";
                }
            }

            if (_pedidoContexto is not null)
            {
                try
                {
                    await PedidoSvc.MarcarFacturadoAsync(_pedidoContexto.Id, result.TipoComprobante, result.IdComprobanteTexto, AppUserSession.GetCurrentUserName(string.Empty));
                }
                catch (Exception ex)
                {
                    _pedidoError = $"La venta se registró pero no se pudo actualizar el pedido: {ex.Message}";
                }
            }

            await ShowChargeSuccessAsync($"Venta registrada: {result.TipoComprobante} {result.Sucursal}-{result.Numero}{result.Letra} · total {FmtMoney(result.Total)}.");
            _cartItems.Clear();
            _paymentLines.Clear();
            _showChargeModal = false;
            await OpenReceiptModalAsync(result, soldItems, soldPayments);
        }
        catch (Exception ex)
        {
            _chargeError = ex.Message;
        }
        finally
        {
            _chargeSaving = false;
        }
    }

    private async Task OpenReceiptModalAsync(
        PuntoVentaSaleResultDto result,
        IReadOnlyList<PuntoVentaCartItemDto> soldItems,
        IReadOnlyList<PuntoVentaPaymentLineDto> soldPayments)
    {
        _lastSaleResult = result;
        _receiptItems.Clear();
        _receiptItems.AddRange(soldItems);
        _receiptPayments.Clear();
        _receiptPayments.AddRange(soldPayments);
        _receiptContext = await PuntoVentaSvc.GetReceiptContextAsync(!string.IsNullOrEmpty(_cuentaCliente) ? _cuentaCliente : _settings.CuentaConsumidorFinal);
        _receiptEmail = _receiptContext.EmailSugerido;
        _receiptEmailFeedback = null;
        _receiptEmailError = null;
        _receiptIsReprint = false;
        _showReceiptModal = true;
    }

    private async Task OpenExistingReceiptAsync(int idComprobante)
    {
        try
        {
            var receipt = await PuntoVentaSvc.GetReceiptDataAsync(idComprobante);
            _showReprintModal = false;
            _lastSaleResult = receipt.Resultado;
            _receiptItems.Clear();
            _receiptItems.AddRange(receipt.Items);
            _receiptPayments.Clear();
            _receiptPayments.AddRange(receipt.Pagos);
            _receiptContext = receipt.Contexto;
            _receiptEmail = receipt.Contexto.EmailSugerido;
            _receiptEmailFeedback = null;
            _receiptEmailError = null;
            _receiptIsReprint = receipt.Impreso;
            _showReceiptModal = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void CloseReceiptModal()
    {
        _showReceiptModal = false;
        _receiptEmailFeedback = null;
        _receiptEmailError = null;
        _receiptIsReprint = false;

        // Si el comprobante se generó cerrando un pedido de Delivery/Take Away,
        // no tiene sentido quedarse en Mostrador: se vuelve al tablero de pedidos.
        if (_pedidoContexto is not null)
            Nav.NavigateTo(RouteCtx.BuildRoute($"/ventas/delivery?idPuntoVenta={_pedidoContexto.IdPuntoVenta}"));
    }

    private void ContinueWithNewReceipt()
    {
        CloseReceiptModal();
        _lastSaleResult = null;
        _receiptItems.Clear();
        _receiptPayments.Clear();
        _receiptContext = null;
    }

    private string BuildReceiptPreviewUrl()
    {
        if (_lastSaleResult is null)
            return "about:blank";

        var reimpresion = _receiptIsReprint ? "&reimpresion=1" : string.Empty;
        return $"/comprobantes/viewer/{Uri.EscapeDataString(_lastSaleResult.TipoComprobante)}/{Uri.EscapeDataString(_lastSaleResult.IdComprobanteTexto)}?returnUrl=%2Fventas%2Fpunto-venta{reimpresion}";
    }

    private async Task PrintReceiptAsync()
    {
        var html = BuildReceiptPrintHtml(_receiptIsReprint);

        if (_lastSaleResult is not null)
            await PuntoVentaSvc.MarkReceiptPrintedAsync(_lastSaleResult.IdComprobante);

        await Js.InvokeVoidAsync("alfaPosPrintHtml", "pos-receipt-frame", html);
        _receiptIsReprint = true;
    }

    private async Task SendReceiptEmailAsync()
    {
        _receiptEmailFeedback = null;
        _receiptEmailError = null;

        if (_lastSaleResult is null)
        {
            _receiptEmailError = "No se encontró el comprobante generado para enviarlo por email.";
            return;
        }

        try
        {
            _receiptEmailSending = true;
            await PuntoVentaSvc.SendReceiptByEmailAsync(new PuntoVentaReceiptEmailRequestDto
            {
                IdComprobante = _lastSaleResult.IdComprobante,
                TipoComprobante = _lastSaleResult.TipoComprobante,
                IdComprobanteTexto = _lastSaleResult.IdComprobanteTexto,
                Destinatario = _receiptEmail
            });

            _receiptEmailFeedback = "Comprobante enviado correctamente por email.";
        }
        catch (Exception ex)
        {
            _receiptEmailError = ex.Message;
        }
        finally
        {
            _receiptEmailSending = false;
        }
    }

    private async Task SavePosSettingsAsync()
    {
        try
        {
            _settingsSaving = true;
            _settingsError = null;
            _settingsFeedback = null;

            await PuntoVentaSvc.SaveSettingsAsync(_settings);
            _settings = await PuntoVentaSvc.GetSettingsAsync();
            await LoadCatalogAsync();
            _settingsFeedback = "Configuración guardada. El catálogo se recargó sin perder el carrito actual.";
        }
        catch (Exception ex)
        {
            _settingsError = ex.Message;
        }
        finally
        {
            _settingsSaving = false;
        }
    }

