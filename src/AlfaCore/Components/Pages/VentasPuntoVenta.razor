    private async Task ConfirmarMovimientoCajaAsync()
    {
        _cashInOutFeedback = string.Empty;

        if (_cashInOutImporte <= 0)
        {
            _cashInOutFeedback = "El importe debe ser mayor a cero.";
            _cashInOutOk = false;
            return;
        }
        if (string.IsNullOrWhiteSpace(_cashInOutCuenta))
        {
            _cashInOutFeedback = "Debe seleccionar una cuenta de imputación.";
            _cashInOutOk = false;
            return;
        }

        _cashInOutSaving = true;
        try
        {
            var result = await PuntoVentaSvc.CrearMovimientoCajaAsync(new PuntoVentaMovimientoCajaRequestDto
            {
                Tipo    = _cashInOutTipo,
                Importe = _cashInOutImporte,
                Cuenta  = _cashInOutCuenta,
                Detalle = _cashInOutDetalle
            });

            _cashInOutOk = result.Ok;
            _cashInOutFeedback = result.Ok ? "Movimiento registrado correctamente." : (result.Mensaje.Length > 0 ? result.Mensaje : "No se pudo registrar el movimiento.");

            if (result.Ok)
            {
                _cashInOutImporte = 0;
                _cashInOutCuenta = string.Empty;
                _cashInOutDetalle = string.Empty;
            }
        }
        catch (Exception ex)
        {
            _cashInOutOk = false;
            _cashInOutFeedback = ex.Message;
        }
        finally
        {
            _cashInOutSaving = false;
        }
    }

