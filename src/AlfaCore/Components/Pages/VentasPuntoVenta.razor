    .pos-topbar__copy {
        display: grid;
        gap: 0.22rem;
        min-width: 0;
    }

    .pos-topbar__title-row {
        display: flex;
        align-items: baseline;
        min-width: 0;
    }

    .pos-topbar h1 {
