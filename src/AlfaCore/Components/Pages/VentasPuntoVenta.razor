    /* El menú pertenece al encabezado y no debe ocupar una fila completa en responsive. */
    @@media (max-width: 960px) {
        .pos-topbar {
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
        }

        .pos-topbar__brand {
            width: auto;
            flex: 1 1 auto;
            min-width: 0;
        }

        .pos-topbar__customer {
            order: 3;
            flex: 1 0 100%;
        }

        .pos-topbar__document {
            flex: 1 1 18rem;
            min-width: 0;
        }

        .pos-topbar__actions {
            width: auto;
            flex: 0 0 auto;
            justify-content: flex-end;
        }

        .pos-topbar__menu,
        .pos-topbar__ghost {
            width: auto;
        }

        .pos-topbar__ghost {
            justify-content: center;
        }
    }

    @@media (min-width: 641px) and (max-width: 960px) {
        .pos-topbar {
            flex-wrap: nowrap;
            gap: 0.65rem;
        }

        .pos-topbar__brand {
            flex: 1 1 14rem;
        }

        .pos-topbar__document {
            flex: 1 1 15rem;
        }

        .pos-topbar__customer {
            order: initial;
            flex: 1 1 14rem;
            min-width: 10rem;
            width: auto;
        }

        .pos-topbar__actions {
            flex: 0 0 auto;
        }
    }

    @@media (max-width: 640px) {
        .pos-topbar {
            flex-wrap: wrap;
        }

        .pos-topbar__brand,
        .pos-topbar__document,
        .pos-topbar__customer,
        .pos-topbar__actions {
            flex: 1 1 100%;
        }

        .pos-topbar__actions {
            justify-content: flex-end;
        }
    }

    @@media (min-width: 641px) {
        .pos-topbar {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1.2fr) auto;
            align-items: center;
            gap: 0.8rem;
        }

        .pos-topbar__brand,
        .pos-topbar__document,
        .pos-topbar__customer,
        .pos-topbar__actions {
            order: 0;
            width: auto;
            max-width: none;
            min-width: 0;
        }

        .pos-topbar__brand {
            flex: none;
        }

        .pos-topbar__document {
            flex: none;
        }

        .pos-topbar__customer {
            flex: none;
        }

        .pos-topbar__actions {
            flex: none;
            justify-content: flex-end;
        }
    }

    /* En móvil el encabezado conserva una sola fuente para el comprobante.
       La pantalla de carrito reutiliza el selector del encabezado y no debe
       generar otra fila duplicada dentro del contenido. */
    @@media (max-width: 640px) {
        .pos-topbar {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas:
                "brand menu"
                "document document"
                "customer customer";
            align-items: center;
            gap: 0.4rem 0.5rem;
            padding: 0.45rem 0.65rem 0.55rem;
            flex-direction: initial;
            flex-wrap: initial;
        }

        .pos-topbar__brand {
            grid-area: brand;
            display: flex;
            width: auto;
            min-width: 0;
            flex: none;
        }

        .pos-topbar__copy {
            min-width: 0;
        }

        .pos-topbar h1 {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.9rem;
        }

        .pos-topbar__version {
            font-size: 0.55rem;
        }

        .pos-topbar__context {
            max-width: 100%;
            overflow: hidden;
            white-space: nowrap;
        }

        .pos-topbar__context-item {
            font-size: 0.58rem;
        }

        .pos-topbar__actions {
            grid-area: menu;
            display: flex;
            width: auto;
            min-width: 0;
            flex: none;
            justify-content: flex-end;
        }

        .pos-topbar__menu {
            width: auto;
        }

        .pos-topbar__ghost {
            width: 2.4rem;
            min-width: 2.4rem;
            min-height: 2.4rem;
            justify-content: center;
            padding: 0;
        }

        .pos-topbar__document {
            grid-area: document;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
            width: 100%;
            min-width: 0;
            max-width: none;
            flex: none;
            gap: 0.35rem;
        }

        .pos-topbar__document-label {
            font-size: 0.62rem;
        }

        .pos-topbar__document .pos-select {
            width: 100%;
            min-width: 0;
            min-height: 2.25rem;
            padding: 0.35rem 0.55rem;
            font-size: 0.72rem;
        }

        .pos-topbar__customer {
            grid-area: customer;
            display: grid;
            width: 100%;
            min-width: 0;
            max-width: none;
            padding: 0.35rem 0.5rem;
            font-size: 0.62rem;
            line-height: 1.15;
            flex: none;
        }

        .pos-topbar__customer-main,
        .pos-topbar__customer-data {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .pos-topbar__customer-data {
            gap: 0.35rem;
        }

        /* En el catálogo móvil se priorizan búsqueda y artículos. El
           comprobante y el resumen del cliente se muestran al cobrar. */
        .pos-topbar--mobile-catalog .pos-topbar__document,
        .pos-topbar--mobile-catalog .pos-topbar__customer {
            display: none;
        }

        .pos-topbar--mobile-review .pos-topbar__document,
        .pos-topbar--mobile-review .pos-topbar__customer {
            display: grid;
        }
    }

