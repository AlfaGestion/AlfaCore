        margin-left: 0.45rem;
        color: #7dd3fc;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        white-space: nowrap;
    }

    .pos-topbar__eyebrow {
        display: none;
    }

    .pos-topbar__context {
        display: flex;
        align-items: center;
        min-width: 0;
        margin: 0;
        overflow: hidden;
        color: var(--color-muted);
