@if (_showCierreCajaModal && _turnoActual is not null)
{
    <div class="cuentas-modal-backdrop" @onclick="CerrarModalCierreCaja">
    <section class="cuentas-modal" role="dialog" aria-label="Cerrar caja" @onclick:stopPropagation>
        <header class="cuentas-modal__header">
            <h3>Cerrar caja</h3>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarModalCierreCaja">Cerrar</button>
        </header>
        <div class="cuentas-modal__body">
            @if (!string.IsNullOrWhiteSpace(_cierreError))
            {
                <div class="editor-msg editor-msg--error">
                    <strong>No se pudo cerrar la caja</strong>
                    <span>@_cierreError</span>
                </div>
            }
            <p>Saldo inicial: <strong>@FmtMoney(_turnoActual.SaldoInicial)</strong> · Saldo teórico esperado: <strong>@FmtMoney(_cierreSaldoTeoricoPreview)</strong></p>

            <p>Conteo de billetes y monedas <em>(opcional — solo si preferís contar en vez de escribir el importe)</em></p>
            <div class="pos-billetes-grid">
                @foreach (var d in _denominaciones)
                {
                    <div class="pos-billete-row">
                        <span>@FmtMoney(d.Valor)</span>
                        <input type="number" min="0" value="@GetCierreCantidad(d.Id)"
                               @onchange="e => SetCierreCantidad(d.Id, ParseIntSafe(e.Value))" />
                        <span>@FmtMoney(GetCierreCantidad(d.Id) * d.Valor)</span>
                    </div>
                }
            </div>
            <p><strong>Total contado: @FmtMoney(CierreTotalBilletes())</strong></p>

            <div class="field">
                <label>Saldo final declarado</label>
                <input type="number" step="0.01" min="0" @bind="_cierreSaldoFinalDeclarado" />
                <span class="pos-field-hint">Escribilo directamente, o contá los billetes y monedas arriba — el total se copia acá solo.</span>
            </div>
            <p>Diferencia (declarado − teórico): <strong>@FmtMoney(_cierreSaldoFinalDeclarado - _cierreSaldoTeoricoPreview)</strong></p>

            <div class="field">
                <label>Fondo que queda en la caja</label>
                <input type="number" step="0.01" min="0" @bind="_cierreFondoQueda" />
                <span class="pos-field-hint">Efectivo que se deja para el turno siguiente. La próxima apertura lo propone como saldo inicial.</span>
            </div>

            <section class="pos-cierre-transf">
                <label class="pos-cierre-transf__check">
                    <input type="checkbox" checked="@_cierreTransferir" @onchange="e => _cierreTransferir = e.Value is true" disabled="@(_cierrePreview is null || _cierrePreview.Cajas.Count == 0)" />
                    Transferir a otra caja
                </label>
                @if (!string.IsNullOrWhiteSpace(_cierrePreviewError))
                {
                    <p class="pos-field-hint">@_cierrePreviewError</p>
                }
                else if (_cierrePreview is not null && _cierrePreview.Cajas.Count == 0)
                {
                    <p class="pos-field-hint">No hay otras cajas cargadas para transferir.</p>
                }
                else if (_cierreTransferir && _cierrePreview is not null)
                {
                    <div class="field">
                        <label>Caja destino</label>
                        <select @bind="_cierreCajaDestino">
                            <option value="">Elegí la caja</option>
                            @foreach (var caja in _cierrePreview.Cajas)
                            {
                                <option value="@caja.IdCaja">@caja.IdCaja · @caja.Descripcion</option>
                            }
                        </select>
                    </div>
                    @if (_cierrePreview.Saldos.Count == 0)
                    {
                        <p class="pos-field-hint">No hay saldos de medios de pago en esta caja para transferir.</p>
                    }
                    else
                    {
                        <table class="pos-cierre-transf__tabla">
                            <thead>
                                <tr><th>Medio de pago</th><th>Saldo del turno</th><th>A transferir</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var saldo in _cierrePreview.Saldos)
                                {
                                    var s = saldo;
                                    <tr>
                                        <td>@s.Descripcion@(s.Moneda.Trim() is "" or "1" ? "" : $" (moneda {s.Moneda.Trim()})")</td>
                                        <td>@FmtMoney(s.Saldo)</td>
                                        <td>
                                            <input type="number" step="0.01" value="@GetImporteTransferir(s).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                   @onchange="e => SetImporteTransferir(s, e.Value)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr><td colspan="2">Total a transferir</td><td>@FmtMoney(TotalATransferir())</td></tr>
                            </tfoot>
                        </table>
                        <p class="pos-field-hint">El efectivo propuesto es lo contado menos el fondo que queda. Tarjetas, cheques y transferencias se pasan completos. Podés corregir cualquier importe.</p>
                    }
                }
            </section>

            <div class="field">
                <label>Observaciones</label>
                <input @bind="_cierreObservaciones" placeholder="Opcional" />
            </div>
        </div>
        <footer class="cuentas-modal__actions">
            <button type="button" class="btn btn--primary" @onclick="ConfirmarCierreCajaAsync" disabled="@_cierreSaving">
                @(_cierreSaving ? "Cerrando..." : (_cierreTransferir && TotalATransferir() != 0 ? "Cerrar caja y transferir" : "Cerrar caja"))
            </button>
            <button type="button" class="btn btn--ghost" @onclick="CerrarModalCierreCaja">Cancelar</button>
        </footer>
    </section>
    </div>
}

@if (_showCorteXModal && _turnoActual is not null)
