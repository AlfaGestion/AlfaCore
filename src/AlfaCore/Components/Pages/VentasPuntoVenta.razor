    // Ingreso/Egreso
    private string _cashInOutTipo = "I";
    private decimal _cashInOutImporte;
    private string _cashInOutCuenta = string.Empty;
    private string _cashInOutDetalle = string.Empty;
    private bool _cashInOutSaving;
    private bool _cashInOutCuentasLoading;
    private string _cashInOutFeedback = string.Empty;
    private bool _cashInOutOk;
    private IReadOnlyList<PuntoVentaCuentaImputacionDto> _cashInOutCuentas = [];

    // Detalle de caja
    private bool _cashDetailLoading;
    private IReadOnlyList<PuntoVentaMovimientoCajaDetalleDto> _cashDetailMovimientos = [];
    private IReadOnlyList<PuntoVentaConsolidadoCajaDto> _cashDetailConsolidado = [];
    private bool _showChargeModal;
    private bool _showReceiptModal;
    private bool _showReprintModal;
    private bool _showClearCartConfirm;
    private bool _settingsSaving;
    private bool _paymentMethodsLoading;
    private bool _chargeSaving;
    private bool _receiptEmailSending;
    private bool _reprintLoading;
    private bool _receiptIsReprint;
    private string? _selectedCartItemId;
    private string _scanCode = string.Empty;
    private string _scanError = string.Empty;
    private bool _scanLoading;
    private string _cuentaCliente = string.Empty;
    private string _cuentaClienteNombre = string.Empty;
    private bool _showClienteModal;
    private string _chargeAmountInput = string.Empty;
    private string _selectedPaymentCode = string.Empty;
    private string _receiptEmail = string.Empty;

    [SupplyParameterFromQuery(Name = "idPedido")]
    public int? IdPedidoQuery { get; set; }

    [SupplyParameterFromQuery(Name = "accionPedido")]
    public string? AccionPedidoQuery { get; set; }

    [SupplyParameterFromQuery(Name = "idPuntoVenta")]
    public int? IdPuntoVentaQuery { get; set; }

    private bool EsCierrePedido => string.Equals(AccionPedidoQuery, "cerrar", StringComparison.OrdinalIgnoreCase);

    private PuntoVentaPedidoDto? _pedidoContexto;
    private string? _pedidoError;
    private string? _pedidoSucursalOverride;

    private int _idPuntoVentaActual;
    private string _idCajaActual = string.Empty;
    private PuntoVentaTurnoDto? _turnoActual;
    private IReadOnlyList<PuntoVentaDenominacionDto> _denominaciones = [];

    private bool _showSaldosPorCajaModal;
    private IReadOnlyList<PuntoVentaCajaSaldoDto> _saldosPorCaja = [];
    private string? _saldosPorCajaError;

    private bool _showCorteXModal;
    private decimal? _corteXSaldoContado;
    private string _corteXObservaciones = string.Empty;
    private Dictionary<int, int> _corteXCantidades = [];
    private string? _corteXError;
    private bool _corteXSaving;
    private decimal _corteXSaldoTeoricoPreview;
    private string? _corteXResultadoMensaje;

    private bool _showAperturaModal;
    private decimal _aperturaSaldoInicial;
    private string _aperturaObservaciones = string.Empty;
    private Dictionary<int, int> _aperturaCantidades = [];
    private string? _aperturaError;
    private bool _aperturaSaving;

    private bool _showCierreCajaModal;
    private decimal _cierreSaldoFinalDeclarado;
    private string _cierreObservaciones = string.Empty;
    private Dictionary<int, int> _cierreCantidades = [];
    private string? _cierreError;
    private bool _cierreSaving;
    private decimal _cierreSaldoTeoricoPreview;
    private int _chargeSuccessVersion;
    private readonly List<PuntoVentaCartItemDto> _receiptItems = [];
    private readonly List<PuntoVentaPaymentLineDto> _receiptPayments = [];

    private decimal TotalCarrito => _cartItems.Sum(x => x.Subtotal);
    private decimal TotalPagado => _paymentLines.Sum(x => x.Importe);
    private decimal PendienteCobro => Math.Max(decimal.Round(TotalCarrito - TotalPagado, 2), 0m);
    private decimal VueltoCobro => Math.Max(decimal.Round(TotalPagado - TotalCarrito, 2), 0m);
    private PuntoVentaCartItemDto? SelectedCartItem => _cartItems.FirstOrDefault(x => x.IdArticulo == _selectedCartItemId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            _context = await PuntoVentaSvc.GetContextAsync();
            _settings = await PuntoVentaSvc.GetSettingsAsync();
            _familias = await PuntoVentaSvc.GetFamiliasAsync();
            await LoadCatalogAsync();

            if (IdPedidoQuery is > 0)
            {
                _pedidoContexto = await PedidoSvc.GetPedidoByIdAsync(IdPedidoQuery.Value);
                if (_pedidoContexto is null)
                {
                    _pedidoError = "No se encontró el pedido indicado.";
                }
                else
                {
                    // El carrito es un estado compartido por circuito (no por pedido):
                    // se limpia y se repuebla con los ítems ya guardados del pedido para
                    // no arrastrar un carrito de otra sesión de Mostrador.
                    CartState.Clear();
                    foreach (var item in _pedidoContexto.Items)
                    {
                        _cartItems.Add(new PuntoVentaCartItemDto
                        {
                            IdArticulo = item.IdArticulo,
                            Descripcion = item.Descripcion,
                            Presentacion = item.Presentacion,
                            PrecioUnitario = item.Precio,
                            Cantidad = item.Cantidad,
                            TasaIva = item.TasaIva,
                            Exento = item.Exento,
                            Familia = item.Familia
                        });
                    }

                    if (!string.IsNullOrWhiteSpace(_pedidoContexto.IdCliente))
                    {
                        _cuentaCliente = _pedidoContexto.IdCliente;
                        _cuentaClienteNombre = _pedidoContexto.NombreCliente;
                    }

                    var puntoVentaPedido = await PosConfigSvc.GetPuntoVentaByIdAsync(_pedidoContexto.IdPuntoVenta);
                    _pedidoSucursalOverride = string.IsNullOrWhiteSpace(puntoVentaPedido?.Sucursal) ? null : puntoVentaPedido!.Sucursal;

                    if (EsCierrePedido)
                        await OpenChargeModalAsync();
                }
            }

            _idPuntoVentaActual = _pedidoContexto?.IdPuntoVenta ?? IdPuntoVentaQuery ?? 0;
            _idCajaActual = _context?.CajaActual ?? string.Empty;
            if (_idPuntoVentaActual > 0 && !string.IsNullOrWhiteSpace(_idCajaActual))
            {
                _turnoActual = await TurnoSvc.GetTurnoAbiertoAsync(_idPuntoVentaActual, _idCajaActual);
                _denominaciones = await TurnoSvc.GetDenominacionesAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GuardarPedidoDesdeCarritoAsync()
    {
        if (_pedidoContexto is null)
            return;

        _pedidoError = null;
        var items = _cartItems.Select(x => new PuntoVentaPedidoItemDto
        {
            IdArticulo = x.IdArticulo,
            Descripcion = x.Descripcion,
            Presentacion = x.Presentacion,
            Precio = x.PrecioUnitario,
            Cantidad = x.Cantidad,
            TasaIva = x.TasaIva,
            Exento = x.Exento,
            Familia = x.Familia
        }).ToList();

        var request = new PuntoVentaPedidoSaveRequest
        {
            Id = _pedidoContexto.Id,
            IdPuntoVenta = _pedidoContexto.IdPuntoVenta,
            Modalidad = _pedidoContexto.Modalidad,
            IdCliente = _pedidoContexto.IdCliente,
            NombreCliente = _pedidoContexto.NombreCliente,
            Telefono = _pedidoContexto.Telefono,
            Direccion = _pedidoContexto.Direccion,
            Fecha = _pedidoContexto.Fecha,
            HorarioProgramado = _pedidoContexto.HorarioProgramado,
            Observaciones = _pedidoContexto.Observaciones,
            Items = items,
            UsuarioAccion = AppUserSession.GetCurrentUserName(string.Empty)
        };

        try
        {
            await PedidoSvc.SavePedidoAsync(request);
            CartState.Clear();
            Nav.NavigateTo(RouteCtx.BuildRoute($"/ventas/delivery?idPuntoVenta={_pedidoContexto.IdPuntoVenta}"));
        }
        catch (Exception ex)
        {
            _pedidoError = ex.Message;
        }
    }

    private string GetPedidoContextoTexto()
    {
        if (_pedidoContexto is null)
            return string.Empty;

        var modalidad = _pedidoContexto.Modalidad == PuntoVentaPedidoModalidadKeys.Delivery ? "Delivery" : "Take Away";
        var partes = new List<string> { $"Pedido {modalidad}", _pedidoContexto.NombreCliente };
        if (!string.IsNullOrWhiteSpace(_pedidoContexto.Direccion))
            partes.Add(_pedidoContexto.Direccion);
        if (_pedidoContexto.HorarioProgramado.HasValue)
            partes.Add(_pedidoContexto.HorarioProgramado.Value.ToString("dd/MM HH:mm"));

        return string.Join(" · ", partes);
    }

