    /* Layout definitivo del catálogo: búsqueda, rubros y artículos son filas
       independientes. Estas reglas quedan al final para prevalecer sobre los
       overrides históricos y responsive del POS. */
    .pos-catalog {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .pos-catalog__toolbar {
        display: flex !important;
        flex: 0 0 auto;
        flex-direction: column !important;
        align-items: stretch;
        width: 100%;
        min-width: 0;
        gap: 0.35rem;
    }

    .pos-catalog__search {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        width: 100%;
        min-width: 0;
        flex: 0 0 auto;
    }

    .pos-catalog__rubros {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(95px, 1fr));
        grid-auto-rows: minmax(30px, auto);
        align-content: start;
        width: 100%;
        min-width: 0;
        max-height: 150px;
        overflow-x: hidden;
        overflow-y: auto;
        gap: 4px;
        padding: 0.1rem 0;
    }

    .pos-catalog__rubro {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-width: 0;
        min-height: 30px;
        height: auto;
        max-width: none;
        padding: 0.25rem 0.35rem;
        line-height: 1.1;
        white-space: normal;
        overflow: visible;
        text-overflow: clip;
        text-align: center;
    }

    .pos-catalog__articles {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .pos-catalog__articles .pos-catalog__meta {
        flex: 0 0 auto;
    }

    .pos-catalog__articles .pos-grid {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 0;
        grid-template-columns: repeat(auto-fill, minmax(112px, 1fr));
        gap: 5px;
        overflow-x: hidden;
        overflow-y: auto;
        padding: 5px;
    }

    .pos-catalog__articles .pos-product {
        grid-template-rows: 64px 60px;
        width: 100%;
        min-width: 0;
        min-height: 124px !important;
        height: 124px;
        max-height: 124px;
        gap: 0;
    }

    .pos-catalog__articles .pos-product__image-wrap {
        min-height: 0;
        padding: 0.25rem;
    }

    .pos-catalog__articles .pos-product__text {
        min-height: 0;
        padding: 0.25rem 0.35rem 0.15rem;
