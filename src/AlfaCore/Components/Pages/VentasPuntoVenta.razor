    private static string RubroStyle(PuntoVentaRubroDto rubro)
    {
        if (rubro.Color is not > 0)
            return string.Empty;

        var color = rubro.Color.Value;
        var red = color & 0xFF;
        var green = (color >> 8) & 0xFF;
        var blue = (color >> 16) & 0xFF;
        var luminancia = (red * 299 + green * 587 + blue * 114) / 1000;
        var texto = luminancia >= 150 ? "#172033" : "#ffffff";
        return $"--rubro-color: rgb({red}, {green}, {blue}); --rubro-text: {texto};";
    }

