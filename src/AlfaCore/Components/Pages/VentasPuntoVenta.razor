    private void SetCartQuantity(string idArticulo, string? value, PuntoVentaArticleDto? article)
    {
        if (!TryParseMoney(value, out var quantity) || quantity <= 0m)
        {
            RemoveItem(idArticulo);
            return;
        }

        var existing = _cartItems.FirstOrDefault(x => string.Equals(x.IdArticulo, idArticulo, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            existing.Cantidad = quantity;
            return;
        }

        if (article is not null)
            AddToCart(article, quantity);
    }

