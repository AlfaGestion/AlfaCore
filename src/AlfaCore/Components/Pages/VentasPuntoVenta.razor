    private async Task RecalculateCartPricesAsync()
    {
        if (!_cartItems.Any())
            return;

        try
        {
            foreach (var item in _cartItems.ToList())
            {
                if (EsArticuloManual(item.IdArticulo))
                    continue;

                var article = await PuntoVentaSvc.GetArticuloPorCodigoAsync(item.IdArticulo, _cuentaCliente, _idPuntoVentaActual);
                if (article is null || article.PrecioUnitario <= 0m)
                    continue;

                item.PrecioUnitario = article.PrecioUnitario;
                item.PrecioOriginal = article.PrecioOriginal;
                item.EsPrecioOferta = article.EsPrecioOferta;
                item.TasaIva = article.TasaIva;
                item.Exento = article.Exento;
            }
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron actualizar todos los precios para el cliente seleccionado: {ex.Message}";
        }
    }

