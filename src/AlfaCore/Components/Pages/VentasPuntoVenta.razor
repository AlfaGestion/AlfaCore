    private async Task HandleNpAnticiposKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            await BuscarEncargosDesdeFiltrosAsync();
