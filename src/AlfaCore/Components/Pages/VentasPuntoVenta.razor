        try
        {
            _npAnticiposLoading = true;
            _npAnticiposError = null;
            _npAnticiposResultado = await AnticiposSvc.GetNotaPedidoAsync(comprobante, _npAnticiposCuenta.Trim());
            if (_npAnticiposResultado is null)
                _npAnticiposError = "No se encontró una nota de pedido con esa identidad comercial.";
        }
        catch (Exception ex)
        {
            _npAnticiposResultado = null;
            _npAnticiposError = ex.Message;
        }
        finally
        {
            _npAnticiposLoading = false;
        }
    }

