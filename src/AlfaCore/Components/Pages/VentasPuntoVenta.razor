        _npAnticiposResultado = null;
        _npAnticiposIdComprobante = string.Empty;
        _npAnticiposCuenta = string.Empty;
        _npFechaDesdeInput = null;
        _npFechaHastaInput = null;
        _npEstadoInput = "PENDIENTE";
        _npSucursalInput = SucursalOperativa;
        _npUnidadInput = string.Empty;
        _npIncluirAnuladasInput = false;
        _npAnticiposPagina = 1;
        await BuscarEncargosAsync();
    }

