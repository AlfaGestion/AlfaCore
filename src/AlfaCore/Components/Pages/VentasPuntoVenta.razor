    private void AplicarConfiguracionIngresoRapido(PuntoVentaEntidadDto? puntoVenta)
    {
        if (puntoVenta is null)
            return;

        _settings.CargaRapidaGrafica = puntoVenta.CargaRapidaGrafica;
        _settings.ModoIngresoRapido = string.IsNullOrWhiteSpace(puntoVenta.ModoIngresoRapido)
            ? (puntoVenta.CargaRapidaGrafica ? PuntoVentaIngresoRapidoModoKeys.Completo : PuntoVentaIngresoRapidoModoKeys.Deshabilitado)
            : puntoVenta.ModoIngresoRapido;
        _settings.ImporteRapido1 = puntoVenta.ImporteRapido1.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        _settings.ImporteRapido2 = puntoVenta.ImporteRapido2.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        _settings.ImporteRapido3 = puntoVenta.ImporteRapido3.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        _settings.ImporteRapido4 = puntoVenta.ImporteRapido4.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        _settings.ImporteRapido5 = puntoVenta.ImporteRapido5.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
