@page "/conversaciones/informes"
@page "/{idweb}/{idbase:int}/conversaciones/informes"
@inject AlfaCore.Services.IConversacionesInformesService InformesSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.ISessionService SessionSvc
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime Js
@implements IDisposable
@using AlfaCore.Models

<PageTitle>Informes de conversaciones | Alfa Gestión</PageTitle>

<AlfaNotification Message="@FeedbackMessage" OnDismiss="() => _feedback = null" />

<div class="inf-page">
    <ConversacionesConfigPagina Titulo="Informes mensuales" Amplia="true"
                                Descripcion="Resumen de atención por cliente. Se genera una vez por mes y queda guardado.">
        <Estado>
            @if (_informe is not null)
            {
                <AlfaTag Tone="AlfaTagTone.Neutral">Generado @_informe.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</AlfaTag>
            }
        </Estado>
        <ChildContent>
            <ConversacionesConfigTarjeta>
                <div class="inf-toolbar">
                    <AlfaSelect Id="inf-mes" Label="Mes" Options="MesOptions"
                                Value="@_mes.ToString(System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="OnMesChangedAsync" />
                    <AlfaSelect Id="inf-anio" Label="Año" Options="AnioOptions"
                                Value="@_anio.ToString(System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="OnAnioChangedAsync" />
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi-gear" Disabled="@_trabajando" Loading="@_trabajando"
                                OnClick="GenerarAsync">@(_yaGenerado ? "Regenerar" : "Generar")</AlfaButton>
                    @if (_informes.Count > 0)
                    {
                        <AlfaSelect Id="inf-guardados" Label="Informes guardados" Options="GuardadosOptions" Placeholder="Elegí uno…"
                                    Value="@string.Empty" ValueChanged="AbrirGuardadoAsync" Class="inf-toolbar__saved" />
                    }
                </div>
            </ConversacionesConfigTarjeta>

            @if (_informe is not null)
            {
                <ConversacionesConfigTarjeta Titulo="@($"Período {_informe.PeriodoLabel}")"
                                             Descripcion="@($"{_informe.Filas.Count} clientes/contactos. Tocá una fila para ver el detalle y enviar el resumen.")">
                    <Extra>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi-file-earmark-excel" OnClick="ExportarExcelAsync">Excel</AlfaButton>
                    </Extra>
                    <ChildContent>
                        <div class="inf-table-wrap">
                            <table class="inf-table">
                                <thead>
                                    <tr>
                                        @foreach (var col in Columnas)
                                        {
                                            <th class="@(col.Numerica ? "num" : null)" aria-sort="@AriaSort(col.Key)">
                                                <button type="button" class="inf-sort" @onclick="() => Ordenar(col.Key)">
                                                    @col.Titulo
                                                    <span class="inf-sort__arrow" aria-hidden="true">@SortArrow(col.Key)</span>
                                                </button>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in _informe.Filas)
                                    {
                                        <tr tabindex="0" @onclick="() => AbrirDetalle(f)" @onkeydown="args => AbrirDetalleConTecla(args, f)">
                                            <td>
                                                <span class="inf-name">@f.NombreMostrar</span>
                                                @if (f.TipoFila == "CONTACTO")
                                                {
                                                    <AlfaTag Tone="AlfaTagTone.Accent">Contacto</AlfaTag>
                                                }
                                                else if (f.TipoFila == "SININDENT")
                                                {
                                                    <AlfaTag Tone="AlfaTagTone.Neutral">Sin identificar</AlfaTag>
                                                }
                                            </td>
                                            <td>@f.ClasificacionDesc</td>
                                            <td>@f.CategoriaDesc</td>
                                            <td><AlfaTag Tone="@AbonoTono(f.EstadoAbono)">@AbonoLabel(f.EstadoAbono)</AlfaTag></td>
                                            <td class="num">@f.CantConversaciones</td>
                                            <td class="num">@f.CantDias</td>
                                            <td class="num">@f.CantMensajes</td>
                                            <td class="num">@f.HorasTotalesLabel</td>
                                            <td class="num">@f.HorasFacturablesLabel</td>
                                        </tr>
                                    }
                                </tbody>
                                @if (_informe.Filas.Count > 0)
                                {
                                    <tfoot>
                                        <tr>
                                            <td>Totales (@_informe.Filas.Count)</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="num">@_informe.Filas.Sum(x => x.CantConversaciones)</td>
                                            <td class="num">—</td>
                                            <td class="num">@_informe.Filas.Sum(x => x.CantMensajes)</td>
                                            <td class="num">@FormatHoras(_informe.Filas.Sum(x => x.MinutosTotales))</td>
                                            <td class="num">@FormatHoras(_informe.Filas.Sum(x => x.MinutosFacturables))</td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                        @if (_informe.Filas.Count == 0)
                        {
                            <AlfaEmptyState Title="Sin datos" Message="No hay clientes con abono ni movimientos en este período." />
                        }
                    </ChildContent>
                </ConversacionesConfigTarjeta>

                @if (_tendencia.Count > 0)
                {
                    <ConversacionesConfigTarjeta Titulo="Mensajes por mes" Descripcion="Últimos 12 meses: para ver si las consultas suben, bajan o se mantienen.">
                        <div class="inf-chart" role="img" aria-label="Mensajes por mes en los últimos 12 meses">
                            @foreach (var t in _tendencia)
                            {
                                var h = _tendenciaMax > 0 ? (int)Math.Round(100.0 * t.CantMensajes / _tendenciaMax) : 0;
                                <div class="inf-chart__col" title="@t.Label: @t.CantMensajes mensajes">
                                    <span class="inf-chart__value">@t.CantMensajes</span>
                                    <div class="inf-chart__bar" style="height:@Math.Max(h, 2)%;"></div>
                                    <span class="inf-chart__label">@t.Label</span>
                                </div>
                            }
                        </div>
                    </ConversacionesConfigTarjeta>
                }
            }
            else if (!_trabajando)
            {
                <ConversacionesConfigTarjeta>
                    <AlfaEmptyState Title="Sin informe para este período" Message="Elegí un mes y tocá Generar, o abrí un informe guardado." />
                </ConversacionesConfigTarjeta>
            }
        </ChildContent>
    </ConversacionesConfigPagina>
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse, solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header de la página nueva (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    [SupplyParameterFromQuery(Name = "anio")] public int? AnioQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mes")] public int? MesQuery { get; set; }

    private int _mes;
    private int _anio;
    private bool _trabajando;
    private bool _yaGenerado;
    private string? _feedback;
    private bool _feedbackOk;
    private ConversacionInformeMensualDto? _informe;
    private List<ConversacionInformeListItemDto> _informes = [];
    private List<ConversacionInformeTendenciaDto> _tendencia = [];
    private int _tendenciaMax;
    private string _sortCol = string.Empty;
    private bool _sortAsc = true;
    private readonly AlfaCore.Services.ConversationTenantLoadGuard _tenantLoadGuard = new();
    private AlfaCore.Services.ConversationTenantLoadLease _tenantLoadLease;
    private long _loadGeneration;

    protected override void OnInitialized()
    {
        UpdatePageHeader();
        SessionSvc.SessionChanged += OnTenantContextChanged;
        if (AnioQuery is > 0 && MesQuery is >= 1 and <= 12)
        {
            // Volvemos de un detalle: reabrimos el mismo período.
            _anio = AnioQuery.Value;
            _mes = MesQuery.Value;
        }
        else
        {
            // Por defecto, el mes anterior (se informa sobre un mes ya terminado).
            var previo = DateTime.Today.AddMonths(-1);
            _mes = previo.Month;
            _anio = previo.Year;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadTenantAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Se reafirma acá (no solo en OnInitializedAsync): si se navega desde otra pantalla
        // AlfaDesign, el Dispose() de esa página anterior -- que hace PageHeader.Clear() -- puede
        // correr DESPUÉS del OnInitializedAsync de esta, pisando el header recién seteado.
        // OnAfterRender corre estrictamente después de ese commit de render, así que volver a
        // setearlo acá gana esa carrera de forma confiable (mismo patrón que Conversaciones.razor).
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        SessionSvc.SessionChanged -= OnTenantContextChanged;
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private async Task LoadTenantAsync()
    {
        var generation = ++_loadGeneration;
        _tenantLoadLease = AlfaCore.Services.ConversationTenantLoadLease.Invalid;
        _informe = null;
        _informes = [];
        _tendencia = [];
        _tendenciaMax = 0;
        _feedback = null;

        if (!TryCaptureTenantLoad(out var lease))
        {
            SetFeedback(false, "No se pudo abrir la información de esta base.");
            return;
        }

        _tenantLoadLease = lease;
        await CargarListaAsync();
        if (IsTenantLoadCurrent(lease) && generation == _loadGeneration)
            await AutoAbrirPeriodoAsync();
    }

    private bool TryCaptureTenantLoad(out AlfaCore.Services.ConversationTenantLoadLease lease)
    {
        var routeBaseId = idbase is > 0 ? idbase : null;
        var sessionBaseId = SessionSvc.GetActiveSession()?.BaseId;
        lease = _tenantLoadGuard.Capture(routeBaseId, sessionBaseId);
        return lease.IsValid;
    }

    private bool IsTenantLoadCurrent(AlfaCore.Services.ConversationTenantLoadLease lease)
        => _tenantLoadGuard.IsCurrent(lease, idbase is > 0 ? idbase : null, SessionSvc.GetActiveSession()?.BaseId);

    private void OnTenantContextChanged()
    {
        _tenantLoadGuard.Invalidate();
        _ = InvokeAsync(LoadTenantAsync);
    }

    private int? CurrentExpectedBaseIdOrNull()
        => idbase is > 0 ? idbase : SessionSvc.GetActiveSession()?.BaseId;

    private void UpdatePageHeader()
    {
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems()
        });
    }

    private IReadOnlyList<PageHeaderTopNavItem> BuildTopNavigationItems()
    {
        // Contactos/Clientes se sacaron a propósito: son páginas con su propio menú superior
        // (Contactos, y Clientes vía CuentasComercialesPage -- compartido con Proveedores), y entrar
        // ahí desde acá pisaba este menú con el suyo, dejando la navegación inconsistente.
        var items = new List<PageHeaderTopNavItem>
        {
            BuildTopNavItem("conversaciones", "Conversaciones", "/conversaciones")
        };

        items.Add(BuildTopNavItem("plantillas", "Plantillas", "/conversaciones/plantillas"));
        items.Add(BuildTopNavItem("configuracion", "Configuración", "/conversaciones/configuracion"));
        items.Add(BuildTopNavItem("estadisticas", "Estadísticas", "/conversaciones/estadisticas"));
        items.Add(new() { Key = "informes", Label = "Informes", Url = RouteContext.BuildRoute("/conversaciones/informes"), Active = true });

        return items;
    }

    private PageHeaderTopNavItem BuildTopNavItem(string key, string label, string route)
    {
        var url = RouteContext.BuildRoute(route);
        return new PageHeaderTopNavItem
        {
            Key = key,
            Label = label,
            Url = url,
            OnClick = () =>
            {
                Nav.NavigateTo(url);
                return Task.CompletedTask;
            }
        };
    }

    // Si ya existe un informe guardado para el período elegido, lo abre solo (sin regenerar).
    private async Task AutoAbrirPeriodoAsync()
    {
        try
        {
            _informe = await InformesSvc.GetByPeriodoAsync(_anio, _mes, CurrentExpectedBaseIdOrNull());
            _yaGenerado = _informe is not null;
            _sortCol = string.Empty;
            if (_informe is not null)
                await CargarTendenciaAsync();
            else
            {
                _tendencia = [];
                _tendenciaMax = 0;
            }
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo abrir el informe del período: {ex.Message}");
        }
    }

    private async Task CargarListaAsync()
    {
        try
        {
            _informes = (await InformesSvc.ListarAsync(CurrentExpectedBaseIdOrNull())).ToList();
            _yaGenerado = _informes.Any(i => i.Anio == _anio && i.Mes == _mes);
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo cargar la lista de informes: {ex.Message}");
        }
    }

    private async Task GenerarAsync()
    {
        _trabajando = true;
        _feedback = null;
        StateHasChanged();
        try
        {
            _informe = await InformesSvc.GenerarAsync(_anio, _mes, null, CurrentExpectedBaseIdOrNull());
            _sortCol = string.Empty;
            await CargarListaAsync();
            await CargarTendenciaAsync();
            SetFeedback(true, $"Informe de {MesNombre(_mes)} {_anio} generado: {_informe.Filas.Count} clientes/contactos.");
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo generar el informe: {ex.Message}");
        }
        finally
        {
            _trabajando = false;
        }
    }

    private async Task AbrirGuardadoAsync(string? value)
    {
        if (!int.TryParse(value, out var id) || id <= 0)
            return;
        _trabajando = true;
        StateHasChanged();
        try
        {
            _informe = await InformesSvc.GetAsync(id, CurrentExpectedBaseIdOrNull());
            if (_informe is not null)
            {
                _mes = _informe.Mes;
                _anio = _informe.Anio;
                _yaGenerado = true;
                _sortCol = string.Empty;
                await CargarTendenciaAsync();
            }
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo abrir el informe: {ex.Message}");
        }
        finally
        {
            _trabajando = false;
        }
    }

    private void AbrirDetalle(ConversacionInformeFilaDto fila)
        => Nav.NavigateTo(idbase.HasValue && !string.IsNullOrEmpty(idweb)
            ? $"/{idweb}/{idbase}/conversaciones/informes/detalle/{fila.IdDetalle}"
            : $"/conversaciones/informes/detalle/{fila.IdDetalle}");

    private async Task ExportarExcelAsync()
    {
        if (_informe is null)
            return;
        var url = idbase.HasValue && !string.IsNullOrEmpty(idweb)
            ? $"/{idweb}/{idbase}/conversaciones/informes/{_informe.IdInforme}/excel"
            : $"/conversaciones/informes/{_informe.IdInforme}/excel";
        await Js.InvokeVoidAsync("dashboardExport.downloadFile", url);
    }

    private async Task CargarTendenciaAsync()
    {
        try
        {
            _tendencia = (await InformesSvc.GetTendenciaMensajesAsync(_anio, _mes, CurrentExpectedBaseIdOrNull())).ToList();
            _tendenciaMax = _tendencia.Count > 0 ? _tendencia.Max(t => t.CantMensajes) : 0;
        }
        catch
        {
            _tendencia = [];
            _tendenciaMax = 0;
        }
    }

    private void Ordenar(string col)
    {
        if (_informe is null)
            return;
        if (_sortCol == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortCol = col;
            // Texto: ascendente por defecto; números: descendente (más actividad primero).
            _sortAsc = col is "nombre" or "clasif" or "categoria" or "abono";
        }

        Func<ConversacionInformeFilaDto, object> key = col switch
        {
            "clasif" => f => f.ClasificacionDesc,
            "categoria" => f => f.CategoriaDesc,
            "abono" => f => f.EstadoAbono,
            "conv" => f => f.CantConversaciones,
            "dias" => f => f.CantDias,
            "msj" => f => f.CantMensajes,
            "horas" => f => f.MinutosTotales,
            "fact" => f => f.MinutosFacturables,
            _ => f => f.NombreMostrar
        };
        _informe.Filas = (_sortAsc ? _informe.Filas.OrderBy(key) : _informe.Filas.OrderByDescending(key)).ToList();
    }

    private string SortArrow(string col)
        => _sortCol == col ? (_sortAsc ? "▲" : "▼") : string.Empty;

    private string? AriaSort(string col)
        => _sortCol == col ? (_sortAsc ? "ascending" : "descending") : null;

    private sealed record Columna(string Key, string Titulo, bool Numerica = false);

    private static readonly IReadOnlyList<Columna> Columnas =
    [
        new("nombre", "Cliente / Contacto"),
        new("clasif", "Clasificación"),
        new("categoria", "Categoría"),
        new("abono", "Abono"),
        new("conv", "Conv.", true),
        new("dias", "Días", true),
        new("msj", "Mensajes", true),
        new("horas", "Horas", true),
        new("fact", "Hs. fact.", true)
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> MesOptions
        = Enumerable.Range(1, 12).Select(m => new AlfaSelectOption(m.ToString(System.Globalization.CultureInfo.InvariantCulture), MesNombre(m))).ToList();

    private static IReadOnlyList<AlfaSelectOption> AnioOptions
        => Enumerable.Range(0, 5)
            .Select(i => DateTime.Today.Year - i)
            .Select(y => new AlfaSelectOption(y.ToString(System.Globalization.CultureInfo.InvariantCulture), y.ToString(System.Globalization.CultureInfo.InvariantCulture)))
            .ToList();

    private IReadOnlyList<AlfaSelectOption> GuardadosOptions
        => _informes.Select(it => new AlfaSelectOption(
            it.IdInforme.ToString(System.Globalization.CultureInfo.InvariantCulture),
            $"{it.PeriodoLabel} · {it.CantFilas} clientes")).ToList();

    // AlfaNotification detecta un aviso nuevo por referencia: se reutiliza la misma instancia mientras
    // el texto no cambie, para no reiniciar el aviso en cada render.
    private AppUiMessage? _feedbackMessage;

    private AppUiMessage? FeedbackMessage
    {
        get
        {
            if (_feedback is null)
                return _feedbackMessage = null;

            if (_feedbackMessage is null || _feedbackMessage.Message != _feedback
                || (_feedbackMessage.Severity == AppUiFeedbackSeverity.Success) != _feedbackOk)
            {
                _feedbackMessage = new AppUiMessage
                {
                    Severity = _feedbackOk ? AppUiFeedbackSeverity.Success : AppUiFeedbackSeverity.Error,
                    Title = _feedbackOk ? "Listo" : "No se pudo completar",
                    Message = _feedback
                };
            }

            return _feedbackMessage;
        }
    }

    private async Task OnMesChangedAsync(string? value)
    {
        if (!int.TryParse(value, out var mes) || mes is < 1 or > 12 || mes == _mes)
            return;

        _mes = mes;
        await AutoAbrirPeriodoAsync();
    }

    private async Task OnAnioChangedAsync(string? value)
    {
        if (!int.TryParse(value, out var anio) || anio <= 0 || anio == _anio)
            return;

        _anio = anio;
        await AutoAbrirPeriodoAsync();
    }

    private void AbrirDetalleConTecla(KeyboardEventArgs args, ConversacionInformeFilaDto fila)
    {
        if (args.Key is "Enter" or " ")
            AbrirDetalle(fila);
    }

    private static AlfaTagTone AbonoTono(string estado) => estado switch
    {
        "Abonado" => AlfaTagTone.Success,
        "Suspendido" => AlfaTagTone.Warning,
        _ => AlfaTagTone.Neutral
    };

    private void SetFeedback(bool ok, string msg)
    {
        _feedbackOk = ok;
        _feedback = msg;
    }

    private static string MesNombre(int mes)
    {
        var nombres = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
        return mes >= 1 && mes <= 12 ? nombres[mes] : mes.ToString();
    }

    private static string AbonoLabel(string estado) => estado switch
    {
        "Abonado" => "Abonado",
        "Suspendido" => "Suspendido",
        _ => "Sin abono"
    };

    private static string FormatHoras(int minutos)
    {
        if (minutos <= 0) return "0h";
        var h = minutos / 60;
        var m = minutos % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }
}
