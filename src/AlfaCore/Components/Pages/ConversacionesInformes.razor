@page "/conversaciones/informes"
@page "/{idweb}/{idbase:int}/conversaciones/informes"
@inject AlfaCore.Services.IConversacionesInformesService InformesSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime Js
@implements IDisposable
@using AlfaCore.Models

<PageTitle>Informes de conversaciones | Alfa Gestion</PageTitle>

<style>
    .conv-informes-page { padding: 1.25rem 1.5rem 3rem; max-width: 1400px; margin: 0 auto; }
    .shell.shell--alfa-design .conv-informes-page { height: 100%; overflow-y: auto; }
    .conv-informes-toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: .75rem; margin-bottom: 1rem; }
    .conv-informes-toolbar .field { display: grid; gap: .25rem; }
    .conv-informes-toolbar label { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--color-muted); }
    .conv-informes-toolbar select, .conv-informes-toolbar input { min-height: 34px; padding: .3rem .55rem; border-radius: 8px; border: 1px solid var(--color-border); background: var(--surface-1, #0f172a); color: var(--color-text); }
    .conv-informes-grid-wrap { overflow-x: auto; }
    table.conv-informes-grid { width: 100%; border-collapse: collapse; font-size: .82rem; }
    table.conv-informes-grid th, table.conv-informes-grid td { padding: .45rem .6rem; border-bottom: 1px solid rgba(148,163,184,.14); text-align: left; white-space: nowrap; }
    table.conv-informes-grid th { font-size: .68rem; text-transform: uppercase; letter-spacing: .03em; color: var(--color-muted); position: sticky; top: 0; background: var(--surface-1, #0f172a); }
    table.conv-informes-grid td.num, table.conv-informes-grid th.num { text-align: right; }
    table.conv-informes-grid tbody tr:hover { background: rgba(14,165,233,.07); cursor: pointer; }
    .conv-informes-badge { display: inline-flex; align-items: center; gap: .25rem; padding: .08rem .4rem; border-radius: 999px; font-size: .68rem; font-weight: 700; border: 1px solid transparent; }
    .abono-Abonado { background: rgba(16,185,129,.16); color: #34d399; border-color: rgba(16,185,129,.4); }
    .abono-Suspendido { background: rgba(245,158,11,.16); color: #fbbf24; border-color: rgba(245,158,11,.4); }
    .abono-SinAbono { background: rgba(148,163,184,.14); color: #94a3b8; border-color: rgba(148,163,184,.3); }
    .conv-informes-empty { padding: 2rem; text-align: center; color: var(--color-muted); }
    .conv-informes-total-row td { font-weight: 800; border-top: 2px solid rgba(148,163,184,.3); background: rgba(148,163,184,.05); }
    table.conv-informes-grid th.sortable { cursor: pointer; user-select: none; }
    table.conv-informes-grid th.sortable:hover { color: var(--color-text); }
    .conv-inf-sortarrow { color: #38bdf8; margin-left: .15rem; }
    .conv-inf-chart { display: flex; align-items: flex-end; gap: .4rem; height: 180px; margin-top: .8rem; }
    .conv-inf-bar-wrap { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; min-width: 0; }
    .conv-inf-bar { width: 70%; max-width: 40px; background: linear-gradient(180deg, #38bdf8, #0ea5e9); border-radius: 5px 5px 0 0; }
    .conv-inf-bar-val { font-size: .62rem; color: var(--color-muted); margin-bottom: .15rem; }
    .conv-inf-bar-lbl { font-size: .6rem; color: var(--color-muted); margin-top: .25rem; white-space: nowrap; }
</style>

<div class="conv-informes-page">
    <div class="page-intro">
        <div>
            <h2 class="panel-card__title" style="margin:0;"><i class="bi bi-bar-chart-line-fill"></i> Informes mensuales</h2>
            <p class="panel-card__subtitle" style="margin:.2rem 0 0;">Resumen de atención por cliente. Se genera una vez por mes y queda guardado.</p>
        </div>
        <button type="button" class="btn btn--ghost btn--sm" @onclick="VolverAConversaciones" title="Volver a Conversaciones">
            <i class="bi bi-arrow-left"></i> Conversaciones
        </button>
    </div>

    <div class="conv-informes-toolbar panel-card" style="padding:.85rem 1rem;">
        <div class="field">
            <label for="inf-mes">Mes</label>
            <select id="inf-mes" @bind="_mes" @bind:after="AutoAbrirPeriodoAsync">
                @for (var m = 1; m <= 12; m++)
                {
                    var mm = m;
                    <option value="@mm">@MesNombre(mm)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="inf-anio">Año</label>
            <select id="inf-anio" @bind="_anio" @bind:after="AutoAbrirPeriodoAsync">
                @for (var y = DateTime.Today.Year; y >= DateTime.Today.Year - 4; y--)
                {
                    var yy = y;
                    <option value="@yy">@yy</option>
                }
            </select>
        </div>
        <button type="button" class="btn btn--primary btn--sm" @onclick="GenerarAsync" disabled="@_trabajando">
            <i class="bi @(_trabajando ? "bi-hourglass-split" : "bi-gear-fill")"></i> @(_yaGenerado ? "Regenerar" : "Generar")
        </button>
        @if (_informes.Count > 0)
        {
            <div class="field">
                <label for="inf-guardados">Informes guardados</label>
                <select id="inf-guardados" @onchange="AbrirGuardadoAsync">
                    <option value="">Elegí uno…</option>
                    @foreach (var it in _informes)
                    {
                        <option value="@it.IdInforme">@it.PeriodoLabel · @it.CantFilas clientes</option>
                    }
                </select>
            </div>
        }
    </div>

    @if (_feedback is not null)
    {
        <div class="panel-card" style="padding:.7rem 1rem; margin-bottom:1rem; border-color:@(_feedbackOk ? "rgba(16,185,129,.4)" : "rgba(239,68,68,.4)");">
            @_feedback
        </div>
    }

    @if (_informe is not null)
    {
        <div class="panel-card" style="padding:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.6rem; flex-wrap:wrap; gap:.5rem;">
                <strong>Período @_informe.PeriodoLabel — @_informe.Filas.Count clientes/contactos</strong>
                <div style="display:flex; align-items:center; gap:.6rem;">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="ExportarExcelAsync" title="Descargar el informe en Excel">
                        <i class="bi bi-file-earmark-excel"></i> Excel
                    </button>
                    <span class="panel-card__subtitle" style="margin:0;">Generado @_informe.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
            <div class="conv-informes-grid-wrap">
                <table class="conv-informes-grid">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => Ordenar("nombre")'>Cliente / Contacto @SortArrow("nombre")</th>
                            <th class="sortable" @onclick='() => Ordenar("clasif")'>Clasificación @SortArrow("clasif")</th>
                            <th class="sortable" @onclick='() => Ordenar("categoria")'>Categoría @SortArrow("categoria")</th>
                            <th class="sortable" @onclick='() => Ordenar("abono")'>Abono @SortArrow("abono")</th>
                            <th class="num sortable" @onclick='() => Ordenar("conv")'>Conv. @SortArrow("conv")</th>
                            <th class="num sortable" @onclick='() => Ordenar("dias")'>Días @SortArrow("dias")</th>
                            <th class="num sortable" @onclick='() => Ordenar("msj")'>Mensajes @SortArrow("msj")</th>
                            <th class="num sortable" @onclick='() => Ordenar("horas")'>Horas @SortArrow("horas")</th>
                            <th class="num sortable" @onclick='() => Ordenar("fact")'>Hs. fact. @SortArrow("fact")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in _informe.Filas)
                        {
                            <tr @onclick="() => AbrirDetalle(f)">
                                <td>
                                    @f.NombreMostrar
                                    @if (f.TipoFila == "CONTACTO")
                                    {
                                        <span class="conv-informes-badge" style="background:rgba(59,130,246,.15);color:#93c5fd;border-color:rgba(59,130,246,.35);">contacto</span>
                                    }
                                    else if (f.TipoFila == "SININDENT")
                                    {
                                        <span class="conv-informes-badge" style="background:rgba(148,163,184,.14);color:#94a3b8;">sin identificar</span>
                                    }
                                </td>
                                <td>@f.ClasificacionDesc</td>
                                <td>@f.CategoriaDesc</td>
                                <td><span class="conv-informes-badge abono-@f.EstadoAbono">@AbonoLabel(f.EstadoAbono)</span></td>
                                <td class="num">@f.CantConversaciones</td>
                                <td class="num">@f.CantDias</td>
                                <td class="num">@f.CantMensajes</td>
                                <td class="num">@f.HorasTotalesLabel</td>
                                <td class="num">@f.HorasFacturablesLabel</td>
                            </tr>
                        }
                        @if (_informe.Filas.Count == 0)
                        {
                            <tr><td colspan="9" class="conv-informes-empty">No hay clientes con abono ni movimientos en este período.</td></tr>
                        }
                        else
                        {
                            <tr class="conv-informes-total-row">
                                <td>TOTALES (@_informe.Filas.Count)</td>
                                <td></td><td></td><td></td>
                                <td class="num">@_informe.Filas.Sum(x => x.CantConversaciones)</td>
                                <td class="num">—</td>
                                <td class="num">@_informe.Filas.Sum(x => x.CantMensajes)</td>
                                <td class="num">@FormatHoras(_informe.Filas.Sum(x => x.MinutosTotales))</td>
                                <td class="num">@FormatHoras(_informe.Filas.Sum(x => x.MinutosFacturables))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_tendencia.Count > 0)
        {
            <div class="panel-card" style="padding:1rem; margin-top:1rem;">
                <strong><i class="bi bi-graph-up"></i> Mensajes por mes (últimos 12 meses)</strong>
                <p class="panel-card__subtitle" style="margin:.15rem 0 0;">Para ver si las consultas suben, bajan o se mantienen.</p>
                <div class="conv-inf-chart">
                    @foreach (var t in _tendencia)
                    {
                        var h = _tendenciaMax > 0 ? (int)Math.Round(100.0 * t.CantMensajes / _tendenciaMax) : 0;
                        <div class="conv-inf-bar-wrap" title="@t.Label: @t.CantMensajes mensajes">
                            <span class="conv-inf-bar-val">@t.CantMensajes</span>
                            <div class="conv-inf-bar" style="height:@Math.Max(h, 2)%;"></div>
                            <span class="conv-inf-bar-lbl">@t.Label</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (!_trabajando)
    {
        <div class="panel-card conv-informes-empty">
            Elegí un mes y tocá <strong>Generar</strong>, o abrí un informe guardado.
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "anio")] public int? AnioQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mes")] public int? MesQuery { get; set; }

    private int _mes;
    private int _anio;
    private bool _trabajando;
    private bool _yaGenerado;
    private string? _feedback;
    private bool _feedbackOk;
    private ConversacionInformeMensualDto? _informe;
    private List<ConversacionInformeListItemDto> _informes = [];
    private List<ConversacionInformeTendenciaDto> _tendencia = [];
    private int _tendenciaMax;
    private string _sortCol = string.Empty;
    private bool _sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        UpdatePageHeader();
        if (AnioQuery is > 0 && MesQuery is >= 1 and <= 12)
        {
            // Volvemos de un detalle: reabrimos el mismo período.
            _anio = AnioQuery.Value;
            _mes = MesQuery.Value;
        }
        else
        {
            // Por defecto, el mes anterior (se informa sobre un mes ya terminado).
            var previo = DateTime.Today.AddMonths(-1);
            _mes = previo.Month;
            _anio = previo.Year;
        }
        await CargarListaAsync();
        await AutoAbrirPeriodoAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Se reafirma acá (no solo en OnInitializedAsync): si se navega desde otra pantalla
        // AlfaDesign, el Dispose() de esa página anterior -- que hace PageHeader.Clear() -- puede
        // correr DESPUÉS del OnInitializedAsync de esta, pisando el header recién seteado.
        // OnAfterRender corre estrictamente después de ese commit de render, así que volver a
        // setearlo acá gana esa carrera de forma confiable (mismo patrón que Conversaciones.razor).
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose() => PageHeader.Clear();

    private void UpdatePageHeader()
    {
        PageHeader.Set(new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems()
        });
    }

    private IReadOnlyList<PageHeaderTopNavItem> BuildTopNavigationItems()
    {
        // Contactos/Clientes se sacaron a propósito: son páginas con su propio menú superior
        // (Contactos, y Clientes vía CuentasComercialesPage -- compartido con Proveedores), y entrar
        // ahí desde acá pisaba este menú con el suyo, dejando la navegación inconsistente.
        var items = new List<PageHeaderTopNavItem>
        {
            BuildTopNavItem("conversaciones", "Conversaciones", "/conversaciones")
        };

        items.Add(BuildTopNavItem("plantillas", "Plantillas", "/conversaciones/plantillas"));
        items.Add(BuildTopNavItem("configuracion", "Configuración", "/conversaciones/configuracion"));
        items.Add(BuildTopNavItem("estadisticas", "Estadísticas", "/conversaciones/estadisticas"));
        items.Add(new() { Key = "informes", Label = "Informes", Url = RouteContext.BuildRoute("/conversaciones/informes"), Active = true });

        return items;
    }

    private PageHeaderTopNavItem BuildTopNavItem(string key, string label, string route)
    {
        var url = RouteContext.BuildRoute(route);
        return new PageHeaderTopNavItem
        {
            Key = key,
            Label = label,
            Url = url,
            OnClick = () =>
            {
                Nav.NavigateTo(url);
                return Task.CompletedTask;
            }
        };
    }

    // Si ya existe un informe guardado para el período elegido, lo abre solo (sin regenerar).
    private async Task AutoAbrirPeriodoAsync()
    {
        try
        {
            _informe = await InformesSvc.GetByPeriodoAsync(_anio, _mes);
            _yaGenerado = _informe is not null;
            _sortCol = string.Empty;
            if (_informe is not null)
                await CargarTendenciaAsync();
            else
            {
                _tendencia = [];
                _tendenciaMax = 0;
            }
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo abrir el informe del período: {ex.Message}");
        }
    }

    private async Task CargarListaAsync()
    {
        try
        {
            _informes = (await InformesSvc.ListarAsync()).ToList();
            _yaGenerado = _informes.Any(i => i.Anio == _anio && i.Mes == _mes);
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo cargar la lista de informes: {ex.Message}");
        }
    }

    private async Task GenerarAsync()
    {
        _trabajando = true;
        _feedback = null;
        StateHasChanged();
        try
        {
            _informe = await InformesSvc.GenerarAsync(_anio, _mes, null);
            _sortCol = string.Empty;
            await CargarListaAsync();
            await CargarTendenciaAsync();
            SetFeedback(true, $"Informe de {MesNombre(_mes)} {_anio} generado: {_informe.Filas.Count} clientes/contactos.");
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo generar el informe: {ex.Message}");
        }
        finally
        {
            _trabajando = false;
        }
    }

    private async Task AbrirGuardadoAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id) || id <= 0)
            return;
        _trabajando = true;
        StateHasChanged();
        try
        {
            _informe = await InformesSvc.GetAsync(id);
            if (_informe is not null)
            {
                _mes = _informe.Mes;
                _anio = _informe.Anio;
                _yaGenerado = true;
                _sortCol = string.Empty;
                await CargarTendenciaAsync();
            }
        }
        catch (Exception ex)
        {
            SetFeedback(false, $"No se pudo abrir el informe: {ex.Message}");
        }
        finally
        {
            _trabajando = false;
        }
    }

    private void AbrirDetalle(ConversacionInformeFilaDto fila)
        => Nav.NavigateTo(idbase.HasValue && !string.IsNullOrEmpty(idweb)
            ? $"/{idweb}/{idbase}/conversaciones/informes/detalle/{fila.IdDetalle}"
            : $"/conversaciones/informes/detalle/{fila.IdDetalle}");

    private async Task ExportarExcelAsync()
    {
        if (_informe is null)
            return;
        var url = idbase.HasValue && !string.IsNullOrEmpty(idweb)
            ? $"/{idweb}/{idbase}/conversaciones/informes/{_informe.IdInforme}/excel"
            : $"/conversaciones/informes/{_informe.IdInforme}/excel";
        await Js.InvokeVoidAsync("dashboardExport.downloadFile", url);
    }

    private async Task CargarTendenciaAsync()
    {
        try
        {
            _tendencia = (await InformesSvc.GetTendenciaMensajesAsync(_anio, _mes)).ToList();
            _tendenciaMax = _tendencia.Count > 0 ? _tendencia.Max(t => t.CantMensajes) : 0;
        }
        catch
        {
            _tendencia = [];
            _tendenciaMax = 0;
        }
    }

    private void Ordenar(string col)
    {
        if (_informe is null)
            return;
        if (_sortCol == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortCol = col;
            // Texto: ascendente por defecto; números: descendente (más actividad primero).
            _sortAsc = col is "nombre" or "clasif" or "categoria" or "abono";
        }

        Func<ConversacionInformeFilaDto, object> key = col switch
        {
            "clasif" => f => f.ClasificacionDesc,
            "categoria" => f => f.CategoriaDesc,
            "abono" => f => f.EstadoAbono,
            "conv" => f => f.CantConversaciones,
            "dias" => f => f.CantDias,
            "msj" => f => f.CantMensajes,
            "horas" => f => f.MinutosTotales,
            "fact" => f => f.MinutosFacturables,
            _ => f => f.NombreMostrar
        };
        _informe.Filas = (_sortAsc ? _informe.Filas.OrderBy(key) : _informe.Filas.OrderByDescending(key)).ToList();
    }

    private MarkupString SortArrow(string col)
        => _sortCol == col
            ? new MarkupString($"<span class=\"conv-inf-sortarrow\">{(_sortAsc ? "▲" : "▼")}</span>")
            : new MarkupString(string.Empty);

    private void VolverAConversaciones()
        => Nav.NavigateTo(idbase.HasValue && !string.IsNullOrEmpty(idweb)
            ? $"/{idweb}/{idbase}/conversaciones"
            : "/conversaciones");

    private void SetFeedback(bool ok, string msg)
    {
        _feedbackOk = ok;
        _feedback = msg;
    }

    private static string MesNombre(int mes)
    {
        var nombres = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
        return mes >= 1 && mes <= 12 ? nombres[mes] : mes.ToString();
    }

    private static string AbonoLabel(string estado) => estado switch
    {
        "Abonado" => "Abonado",
        "Suspendido" => "Suspendido",
        _ => "Sin abono"
    };

    private static string FormatHoras(int minutos)
    {
        if (minutos <= 0) return "0h";
        var h = minutos / 60;
        var m = minutos % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }
}
