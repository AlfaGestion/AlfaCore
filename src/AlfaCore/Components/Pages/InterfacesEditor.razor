                "La nota del bloque inferior se agregÃ³ a la observaciÃ³n del documento.");
        }

        if (cambioEstado)
        {
            return AppUiMessage.Success(
                "Documento actualizado",
                "La ficha y el estado del documento se guardaron correctamente.");
        }

        return AppUiMessage.Success(
            "Documento actualizado",
            "La ficha se guardÃ³ correctamente.");
    }

