    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:N1} KB";
        return $"{bytes / 1024d / 1024d:N1} MB";
    }

    private static string BuildComprobanteLecturaLabel(InterfacesCompraIaResultadoDto lectura)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(lectura.TipoComprobante))
            parts.Add(lectura.TipoComprobante.Trim());

        var numero = string.Join("-",
            new[] { lectura.PuntoVenta, lectura.Numero }
                .Where(static x => !string.IsNullOrWhiteSpace(x))
                .Select(static x => x.Trim()));

        var suffix = string.Join(" ",
            new[] { lectura.Letra, numero }
                .Where(static x => !string.IsNullOrWhiteSpace(x))
                .Select(static x => x.Trim()));

        if (!string.IsNullOrWhiteSpace(suffix))
            parts.Add(suffix);

        return parts.Count == 0 ? "Sin dato" : string.Join(" Â· ", parts);
    }

