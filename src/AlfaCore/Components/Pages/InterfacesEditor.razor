    private async Task<List<string>> AgregarArchivosPendientesAsync(List<PendingUploadFile> target, IReadOnlyList<IBrowserFile> files, int maxFiles, long maxBytes)
    {
        var skipped = new List<string>();
        var signatures = target.Select(static x => x.Signature).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var file in files)
        {
            if (target.Count >= maxFiles)
                break;

            var pending = await PendingUploadFile.CreateAsync(file, maxBytes);
            if (!signatures.Add(pending.Signature))
            {
                skipped.Add(file.Name);
                continue;
            }

            target.Add(pending);
        }
        return skipped;
    }

