@page "/interfaces/nuevo"
@page "/{idweb}/{idbase:int}/interfaces/nuevo"
@page "/interfaces/{IdComprobanteRecibido:long}"
@page "/{idweb}/{idbase:int}/interfaces/{IdComprobanteRecibido:long}"
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Forms
@inject AlfaCore.Services.IInterfacesService InterfacesSvc
@inject AlfaCore.Services.IInterfacesConfigService InterfacesConfigSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(_isNewMode ? "Nuevo documento | Interfaces" : $"Documento #{IdComprobanteRecibido} | Interfaces")</PageTitle>

<div class="page-grid interfaces-page interfaces-editor-page">
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">@(_isNewMode ? "Nuevo documento recibido" : $"Documento #{IdComprobanteRecibido}")</h2>
            <p class="page-intro__text">@(_isNewMode ? "CompletÃ¡ los datos del comprobante y adjuntÃ¡ los archivos necesarios antes de registrarlo." : "EditÃ¡ la ficha completa del documento desde una pantalla separada del listado principal.")</p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="/interfaces">
                <i class="bi bi-arrow-left"></i> Volver al listado
            </a>
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>CÃ³digo: @_feedback.Code</small>
                    }
                </div>
                @if (_isNewMode && _lastSavedId.HasValue && _feedback?.Severity == AppUiFeedbackSeverity.Success)
                {
                    <a class="btn btn--ghost btn--sm" href="/interfaces/@_lastSavedId.Value">
                        <i class="bi bi-eye"></i> Ver documento #@_lastSavedId.Value
                    </a>
                }
            </div>
        </section>
    }

    @if (_loading)
    {
        <section class="panel-card">
            <div class="loading">Cargando ficha...</div>
        </section>
    }
    else if (_isNewMode)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Alta de documento</h3>
                    <p class="panel-card__subtitle">La carga usa la configuraciÃ³n activa del mÃ³dulo y exige al menos un adjunto.</p>
                </div>
            </div>

            <div class="contactos-form">
                <div class="contactos-form__grid">
                    <div class="field">
                        <label>Tipo documental</label>
                        <select @bind="_nuevo.IdTipoDocumento" disabled="@_saving">
                            <option value="0">Seleccionar...</option>
                            @foreach (var item in _documentTypes)
                            {
                                <option value="@item.IdTipoDocumento">@item.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="field field--wide">
                        <label>ObservaciÃ³n</label>
                        <textarea class="contactos-observaciones" @bind="_nuevo.Observacion" disabled="@_saving"></textarea>
                    </div>
                    <div class="field field--wide">
                        <label>Prompt adicional para IA (opcional)</label>
                        <textarea class="contactos-observaciones interfaces-prompt-editor"
                                  @bind="_nuevo.PromptIaAdicional"
                                  disabled="@_saving"
                                  placeholder="Ej: esta factura incluye bonificaciÃ³n en pie y el proveedor usa cÃ³digos propios."></textarea>
                    </div>
                </div>

                <div id="interfaces-new-dropzone" class="interfaces-upload-dropzone" tabindex="0">
                    <div class="interfaces-upload-dropzone__head">
                        <div>
                            <h4>Adjuntos iniciales</h4>
                            <p>PodÃ©s cargar archivos desde explorador o cÃ¡mara. TambiÃ©n podÃ©s pegar con Ctrl+V o menÃº contextual Pegar.</p>
                        </div>
                        <div class="interfaces-upload-actions">
                            <InputFile id="interfaces-file-picker"
                                       @key="@($"file-{_filePickerVersion}")"
                                       style="display:none"
                                       OnChange="HandleFilesSelectedAsync"
                                       multiple
                                       disabled="@_saving" />
                            <label class="btn btn--secondary interfaces-file-trigger @(_saving ? "is-disabled" : string.Empty)"
                                   for="interfaces-file-picker"
                                   aria-disabled="@_saving">
                                <i class="bi bi-paperclip"></i>
                                <span>Seleccionar archivos</span>
                            </label>
                            <button type="button" class="btn btn--ghost" @onclick="PegarImagenNuevoAsync" disabled="@_saving">
                                <i class="bi bi-clipboard-image"></i>
                                <span>Pegar imagen</span>
                            </button>
                        </div>
                    </div>

                    @if (_selectedFiles.Count == 0)
                    {
                        <div class="interfaces-empty-upload">TodavÃ­a no agregaste archivos para este documento.</div>
                    }
                    else
                    {
                        <div class="interfaces-pending-files">
                            @foreach (var file in _selectedFiles)
                            {
                                <article class="interfaces-pending-file">
                                    @if (IsImageMime(file.MimeType))
                                    {
                                        <button type="button"
                                                class="interfaces-pending-file__thumb"
                                                title="Ver imagen"
                                                @onclick="() => VerArchivoPendienteAsync(file)"
                                                disabled="@_saving">
                                            <img src="@BuildPreviewDataUrl(file)" alt="@file.NombreArchivo" />
                                        </button>
                                    }
                                    <div>
                                        <strong>@file.NombreArchivo</strong>
                                        <span>@FormatSize(file.TamanoBytes)</span>
                                    </div>
                                    <div class="actions">
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => VerArchivoPendienteAsync(file)" disabled="@_saving">
                                            <i class="bi bi-eye"></i> Ver
                                        </button>
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => QuitarArchivoPendiente(file.Id)" disabled="@_saving">
                                            <i class="bi bi-x-circle"></i> Quitar
                                        </button>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>

                @if (_duplicatesFound is { Count: > 0 } && !_duplicateConfirmed)
                {
                    <div class="interfaces-inline-note interfaces-inline-note--warning">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>Posibles archivos duplicados</strong>
                            <span>
                                @foreach (var dup in _duplicatesFound.DistinctBy(static d => d.IdComprobanteRecibido))
                                {
                                    <span>
                                        "<strong>@dup.NombreOriginal</strong>" ya fue subido en el documento
                                        <a href="/interfaces/@dup.IdComprobanteRecibido" target="_blank">#@dup.IdComprobanteRecibido</a>.
                                    </span>
                                }
                            </span>
                        </div>
                        <div class="actions" style="gap:8px; flex-shrink:0;">
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _duplicateConfirmed = true" disabled="@_saving">
                                <i class="bi bi-check2"></i> Continuar igual
                            </button>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _duplicatesFound = null" disabled="@_saving">
                                <i class="bi bi-x"></i> Cancelar
                            </button>
                        </div>
                    </div>
                }

                <div class="actions usuarios-editor__actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarNuevoAsync" disabled="@_saving">
                        <i class="bi bi-floppy"></i>
                        <span>@(_saving ? "Guardando..." : "Guardar documento")</span>
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="LimpiarNuevo" disabled="@_saving">
                        <i class="bi bi-eraser"></i>
                        <span>Limpiar</span>
                    </button>
                </div>
            </div>
        </section>
    }
    else if (_detail is not null)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Ficha del documento</h3>
                    <p class="panel-card__subtitle">Alta: @_detail.FechaHoraGrabacion.ToString("dd/MM/yyyy HH:mm") Â· Usuario: @_detail.UsuarioAlta Â· Estado actual: @_detail.EstadoDescripcion</p>
                </div>
            </div>

            <div class="contactos-tabs">
                <button type="button" class="btn @(_activeTab == InterfacesTab.Datos ? "btn--primary" : "btn--ghost")" @onclick="() => _activeTab = InterfacesTab.Datos">Datos</button>
                <button type="button" class="btn @(_activeTab == InterfacesTab.Adjuntos ? "btn--primary" : "btn--ghost")" @onclick="() => _activeTab = InterfacesTab.Adjuntos">Adjuntos</button>
                <button type="button" class="btn @(_activeTab == InterfacesTab.Historial ? "btn--primary" : "btn--ghost")" @onclick="() => _activeTab = InterfacesTab.Historial">Historial</button>
            </div>

            @if (_activeTab == InterfacesTab.Datos)
            {
                <div class="contactos-form">
                    <div class="contactos-form__grid">
                        <div class="field">
                            <label>Tipo documental</label>
                            <select @bind="_editForm.IdTipoDocumento" disabled="@(!_detail.PermiteEdicion || _savingEdit)">
                                @foreach (var item in _documentTypes)
                                {
                                    <option value="@item.IdTipoDocumento">@item.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>Estado actual</label>
                            <input value="@_detail.EstadoDescripcion" readonly />
                        </div>
                        <div class="field">
                            <label>Usuario</label>
                            <input value="@_detail.UsuarioAlta" readonly />
                        </div>
                        <div class="field">
                            <label>Fecha</label>
                            <input value="@_detail.FechaHoraGrabacion.ToString("dd/MM/yyyy HH:mm")" readonly />
                        </div>
                    </div>

                    @if (!_detail.PermiteEdicion)
                    {
                        <div class="interfaces-inline-note">
                            <i class="bi bi-info-circle"></i>
                            <div>
                                <strong>EdiciÃ³n limitada por estado</strong>
                                <span>En este estado no se modifican tipo ni adjuntos, pero sÃ­ podÃ©s agregar una nota al documento.</span>
                            </div>
                        </div>
                    }

                    @if (CanDetectCompra)
                    {
                        <div class="interfaces-inline-note">
                            <i class="bi bi-robot"></i>
                            <div>
                                <strong>Lectura automÃ¡tica de factura</strong>
                                <span>EnvÃ­a el documento a la cola del lector de compras para detectar proveedor, comprobante y totales desde los adjuntos activos.</span>
                            </div>
                            <button type="button" class="btn btn--secondary" @onclick="DetectarCompraAsync" disabled="@(_detectingCompra || IsSavingDetalle)">
                                <i class="bi bi-search"></i>
                                <span>@(_detectingCompra ? "Encolando..." : GetDetectCompraButtonLabel())</span>
                            </button>
                        </div>
                    }

                    @if (_detail.LecturaCompra is not null)
                    {
                        <div class="contactos-form__grid">
                            <div class="field">
                                <label>Lectura IA</label>
                                <input value="@_detail.LecturaCompra.Estado" readonly />
                            </div>
                            <div class="field">
                                <label>Proveedor</label>
                                <input value="@_detail.LecturaCompra.ProveedorNombre" readonly />
                            </div>
                            <div class="field">
                                <label>Cuenta proveedor</label>
                                <input value="@_detail.LecturaCompra.CuentaContable" readonly />
                            </div>
                            <div class="field">
                                <label>CUIT</label>
                                <input value="@_detail.LecturaCompra.ProveedorCuit" readonly />
                            </div>
                            <div class="field">
                                <label>Comprobante</label>
                                <input value="@BuildComprobanteLecturaLabel(_detail.LecturaCompra)" readonly />
                            </div>
                            <div class="field">
                                <label>Total</label>
                                <input value="@FormatMoney(_detail.LecturaCompra.Total)" readonly />
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_detail.LecturaCompra.LectorObservaciones))
                        {
                            <div class="field">
                                <label>Observaciones del lector</label>
                                <textarea class="contactos-observaciones" readonly>@_detail.LecturaCompra.LectorObservaciones</textarea>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_detail.LecturaCompra.LectorError))
                        {
                            <div class="field">
                                <label>Error del lector</label>
                                <textarea class="contactos-observaciones" readonly>@_detail.LecturaCompra.LectorError</textarea>
                            </div>
                        }
                    }

                    <div class="field">
                        <label>ObservaciÃ³n</label>
                        <textarea class="contactos-observaciones" @bind="_editForm.Observacion" disabled="@IsSavingDetalle"></textarea>
                    </div>
                    <div class="field">
                        <label>Prompt adicional para IA (opcional)</label>
                        <textarea class="contactos-observaciones interfaces-prompt-editor"
                                  @bind="_editForm.PromptIaAdicional"
                                  disabled="@IsSavingDetalle"
                                  placeholder="Contexto extra para ayudar al lector automÃ¡tico en este comprobante."></textarea>
                    </div>

                    <div class="field">
                        <label>@(_detail.PermiteEdicion ? "Motivo / nota de estado" : "Nueva nota para agregar")</label>
                        <textarea class="contactos-observaciones"
                                  @bind="_statusChange.Observacion"
                                  disabled="@IsSavingDetalle"
                                  placeholder="@(_detail.PermiteEdicion ? "Opcional: explicaciÃ³n del cambio de estado" : "EscribÃ­ la nota que querÃ©s agregar al documento")"></textarea>
                    </div>

                    <div class="contactos-form__grid">
                        <div class="field">
                            <label>Estado</label>
                            <select @bind="_statusChange.IdEstadoNuevo" disabled="@IsSavingDetalle">
                                @foreach (var item in _states)
                                {
                                    <option value="@item.IdEstado">@item.Descripcion</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="actions usuarios-editor__actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarEdicionAsync" disabled="@IsSavingDetalle">
                            <i class="bi bi-floppy"></i>
                            <span>@(IsSavingDetalle ? "Guardando..." : "Guardar")</span>
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="ResetEditarDetalle" disabled="@IsSavingDetalle">
                            <i class="bi bi-eraser"></i>
                            <span>Revertir</span>
                        </button>
                    </div>
                </div>
            }
            else if (_activeTab == InterfacesTab.Adjuntos)
            {
                <div id="interfaces-extra-dropzone" class="interfaces-upload-dropzone" tabindex="0">
                    @if (_detail.PermiteEdicion)
                    {
                        <div class="interfaces-upload-dropzone__head">
                            <div>
                                <h4>Adjuntos activos</h4>
                                <p>PodÃ©s sumar mÃ¡s archivos al documento desde esta ficha o pegarlos con Ctrl+V / menÃº contextual Pegar.</p>
                            </div>
                            <div class="interfaces-upload-actions">
                                <InputFile id="interfaces-extra-picker"
                                           @key="@($"extra-{_extraPickerVersion}")"
                                           style="display:none"
                                           OnChange="HandleExtraFilesSelectedAsync"
                                           multiple
                                           disabled="@_savingExtraAttachments" />
                                <label class="btn btn--secondary interfaces-file-trigger @(_savingExtraAttachments ? "is-disabled" : string.Empty)"
                                       for="interfaces-extra-picker"
                                       aria-disabled="@_savingExtraAttachments">
                                    <i class="bi bi-folder-plus"></i>
                                    <span>Agregar adjuntos</span>
                                </label>
                                <button type="button" class="btn btn--ghost" @onclick="PegarImagenExtraAsync" disabled="@_savingExtraAttachments">
                                    <i class="bi bi-clipboard-image"></i>
                                    <span>Pegar imagen</span>
                                </button>
                                <button type="button" class="btn btn--ghost" @onclick="AgregarAdjuntosAsync" disabled="@(_savingExtraAttachments || _extraFiles.Count == 0)">
                                    <i class="bi bi-upload"></i>
                                    <span>@(_savingExtraAttachments ? "Subiendo..." : "Subir")</span>
                                </button>
                            </div>
                        </div>
                    }

                    @if (_detail.Adjuntos.Count == 0)
                    {
                        <div class="interfaces-empty-upload">Este comprobante todavÃ­a no tiene adjuntos activos.</div>
                    }
                    else
                    {
                        <div class="interfaces-attachments-modern">
                            @foreach (var attachment in _detail.Adjuntos)
                            {
                                <div class="interfaces-attachment-row">
                                    <div class="interfaces-attachment-row__icon">
                                        <i class="bi @GetAttachmentIcon(attachment.NombreOriginal)"></i>
                                    </div>
                                    <div class="interfaces-attachment-row__content">
                                        <strong>@attachment.NombreOriginal</strong>
                                        <span>@FormatSize(attachment.TamanoBytes) Â· @attachment.FechaHoraGrabacion.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="interfaces-attachment-row__actions">
                                        <a class="btn btn--ghost btn--sm" href="@GetAttachmentDownloadUrl(attachment.IdAdjunto)" target="_blank">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        <a class="btn btn--ghost btn--sm" href="@GetAttachmentDownloadUrl(attachment.IdAdjunto)" download="@attachment.NombreOriginal">
                                            <i class="bi bi-download"></i> Descargar
                                        </a>
                                        @if (_detail.PermiteEdicion)
                                        {
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => QuitarAdjuntoAsync(attachment.IdAdjunto)" disabled="@_savingExtraAttachments">
                                                <i class="bi bi-trash"></i> Quitar
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="updates-history-list">
                    @foreach (var item in _detail.Historial)
                    {
                        <article class="updates-history-item">
                            <div class="updates-history-item__head">
                                <strong>@item.Accion</strong>
                                <span>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <p>@item.Observacion</p>
                            <span>@item.Usuario Â· @item.EstadoAnteriorDescripcion @(string.IsNullOrWhiteSpace(item.EstadoNuevoDescripcion) ? string.Empty : $"-> {item.EstadoNuevoDescripcion}")</span>
                        </article>
                    }
                </div>
            }
        </section>
    }

    @if (_previewPendingFile is not null)
    {
        <div class="modal-overlay" @onclick="CerrarPreviewPendiente">
            <article class="modal-card interfaces-pending-preview" @onclick:stopPropagation="true">
                <header class="interfaces-pending-preview__header">
                    <div class="interfaces-pending-preview__meta">
                        <strong title="@_previewPendingFile.NombreArchivo">@_previewPendingFile.NombreArchivo</strong>
                        <span>@FormatSize(_previewPendingFile.TamanoBytes)</span>
                    </div>
                    <div class="interfaces-pending-preview__actions">
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AjustarZoomPreview(-0.15m)">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="ResetZoomPreview">
                            @($"{_previewZoom:0}%")
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AjustarZoomPreview(0.15m)">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="DescargarPreviewPendienteAsync">
                            <i class="bi bi-download"></i> Descargar
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarPreviewPendiente">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </header>
                <div class="interfaces-pending-preview__canvas" @onwheel="OnPreviewWheel" @onwheel:preventDefault="true">
                    <img src="@BuildPreviewDataUrl(_previewPendingFile)"
                         alt="@_previewPendingFile.NombreArchivo"
                         style="@($"transform: scale({_previewZoom / 100m:0.00});")" />
                </div>
            </article>
        </div>
    }
</div>

@code {
    [Parameter] public long? IdComprobanteRecibido { get; set; }

    private readonly InterfacesCrearComprobanteRequest _nuevo = new();
    private readonly InterfacesActualizarComprobanteRequest _editForm = new();
    private readonly InterfacesCambioEstadoRequest _statusChange = new();
    private readonly List<PendingUploadFile> _selectedFiles = [];
    private readonly List<IBrowserFile> _extraFiles = [];
    private readonly List<InterfacesEstadoOptionDto> _states = [];
    private readonly List<InterfacesTipoDocumentoOptionDto> _documentTypes = [];
    private AppUiMessage? _feedback;
    private long? _lastSavedId;
    private List<InterfacesAdjuntoDuplicadoDto>? _duplicatesFound;
    private bool _duplicateConfirmed;
    private InterfacesDetalleDto? _detail;
    private InterfacesUploadSettingsDto? _settings;
    private bool _loading = true;
    private bool _saving;
    private bool _savingEdit;
    private bool _changingState;
    private bool _savingExtraAttachments;
    private bool _detectingCompra;
    private int _filePickerVersion;
    private int _extraPickerVersion;
    private InterfacesTab _activeTab = InterfacesTab.Datos;
    private PendingUploadFile? _previewPendingFile;
    private decimal _previewZoom = 100m;

    private bool _isNewMode => !IdComprobanteRecibido.HasValue;
    private bool IsSavingDetalle => _savingEdit || _changingState;
    private bool CanDetectCompra => _detail is not null
        && !_isNewMode
        && _detail.Adjuntos.Count > 0
        && string.Equals(_detail.TipoDocumentoCodigo, "COMPROBANTE_COMPRA", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            await LoadCatalogsAsync();
            _settings = await InterfacesConfigSvc.GetUploadSettingsAsync();

            if (_isNewMode)
            {
                LimpiarNuevo();
            }
            else
            {
                await CargarDetalleAsync();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.bindPasteDrop", "#interfaces-new-dropzone", "#interfaces-file-picker");
        await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.bindPasteDrop", "#interfaces-extra-dropzone", "#interfaces-extra-picker");
    }

    private async Task LoadCatalogsAsync()
    {
        _states.Clear();
        _states.AddRange(await InterfacesSvc.GetStatesAsync());
        _documentTypes.Clear();
        _documentTypes.AddRange(await InterfacesSvc.GetDocumentTypesAsync());
    }

    private async Task CargarDetalleAsync()
    {
        if (!IdComprobanteRecibido.HasValue)
            return;

        var result = await UiOps.RunAsync(() => InterfacesSvc.GetByIdAsync(IdComprobanteRecibido.Value), "No se pudo cargar el documento.");
        if (!result.Success || result.Value is null)
        {
            SetFeedback(result.Feedback);
            return;
        }

        _detail = result.Value;
        ResetEditarDetalle();
    }

    private async Task GuardarNuevoAsync()
    {
        _lastSavedId = null;
        _duplicatesFound = null;

        if (_settings is null)
        {
            SetFeedback(UiOps.BuildMessage(new InvalidOperationException("No se pudo cargar la configuraciÃ³n de carga."), "No se pudo guardar el documento."));
            return;
        }

        if (_nuevo.IdTipoDocumento <= 0)
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Falta el tipo documental",
                Message = "SeleccionÃ¡ un tipo documental antes de guardar el documento.",
                Suggestion = "CompletÃ¡ el dato requerido y volvÃ© a intentar."
            });
            return;
        }

        if (_selectedFiles.Count == 0)
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Faltan adjuntos",
                Message = "DebÃ©s adjuntar al menos un archivo para registrar el documento.",
                Suggestion = "UsÃ¡ â€œSeleccionar archivosâ€ y luego volvÃ© a guardar."
            });
            return;
        }

        if (!_duplicateConfirmed)
        {
            var hashes = _selectedFiles
                .Where(static f => !string.IsNullOrWhiteSpace(f.ContentHash))
                .Select(static f => f.ContentHash)
                .ToList();

            if (hashes.Count > 0)
            {
                var dupResult = await UiOps.RunAsync(
                    () => InterfacesSvc.FindFilesByHashAsync(hashes),
                    "No se pudo verificar duplicados.");

                if (dupResult.Success && dupResult.Value is { Count: > 0 })
                {
                    _duplicatesFound = dupResult.Value.ToList();
                    return;
                }
            }
        }

        _duplicateConfirmed = false;
        _saving = true;
        try
        {
            var attachments = new List<InterfacesCrearAdjuntoRequest>();
            var streams = new List<Stream>();
            try
            {
                foreach (var file in _selectedFiles)
                {
                    var stream = file.OpenReadStream();
                    streams.Add(stream);
                    attachments.Add(new InterfacesCrearAdjuntoRequest
                    {
                        NombreArchivo = file.NombreArchivo,
                        MimeType = file.MimeType,
                        TamanoBytes = file.TamanoBytes,
                        ContentHash = file.ContentHash,
                        Contenido = stream
                    });
                }

                var result = await UiOps.RunAsync(() => InterfacesSvc.CreateAsync(new InterfacesCrearComprobanteRequest
                {
                    IdTipoDocumento = _nuevo.IdTipoDocumento,
                    Observacion = _nuevo.Observacion,
                    PromptIaAdicional = _nuevo.PromptIaAdicional,
                    UsuarioAccion = CurrentUserName,
                    PcAccion = Environment.MachineName,
                    Adjuntos = attachments
                }), "No se pudo registrar el comprobante.");

                if (!result.Success)
                {
                    SetFeedback(result.Feedback);
                    return;
                }

                _lastSavedId = result.Value;
                LimpiarNuevo();
                SetFeedback(AppUiMessage.Success(
                    "Documento registrado",
                    $"El comprobante #{result.Value} quedÃ³ registrado. El formulario estÃ¡ limpio para ingresar otro."));
            }
            finally
            {
                foreach (var stream in streams)
                    await stream.DisposeAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task GuardarEdicionAsync()
    {
        if (_detail is null || !IdComprobanteRecibido.HasValue)
            return;

        _savingEdit = true;
        try
        {
            var shouldChangeState = _statusChange.IdEstadoNuevo > 0 && _statusChange.IdEstadoNuevo != _detail.IdEstado;
            var originalObservation = _editForm.Observacion;
            _editForm.IdComprobanteRecibido = IdComprobanteRecibido.Value;
            _editForm.UsuarioAccion = CurrentUserName;
            _editForm.PcAccion = Environment.MachineName;

            if (!_detail.PermiteEdicion)
            {
                if (string.IsNullOrWhiteSpace(_statusChange.Observacion))
                {
                    SetFeedback(new AppUiMessage
                    {
                        Severity = AppUiFeedbackSeverity.Warning,
                        Title = "Falta la nota",
                        Message = "EscribÃ­ la nota en el bloque inferior para poder guardarla en este estado."
                    });
                    return;
                }

                _editForm.Observacion = AppendStatusNote(originalObservation, _statusChange.Observacion, CurrentUserName);
            }

            var result = await UiOps.RunAsync(async () =>
            {
                await InterfacesSvc.UpdateAsync(_editForm);
                return true;
            }, "No se pudo guardar el comprobante.");

            if (!result.Success)
            {
                _editForm.Observacion = originalObservation;
                SetFeedback(result.Feedback);
                return;
            }

            if (shouldChangeState)
            {
                await GuardarEstadoAsync();
                if (_feedback?.Severity != AppUiFeedbackSeverity.Success)
                {
                    _editForm.Observacion = originalObservation;
                    return;
                }
            }

            SetFeedback(BuildGuardarDetalleSuccessMessage(_detail.PermiteEdicion, shouldChangeState));
            await CargarDetalleAsync();
        }
        finally
        {
            _savingEdit = false;
        }
    }

