    private void DownloadAnyDeskScript()
    {
        _anyDeskFeedback = null;

        try
        {
            // Solo validamos acá (mismo chequeo que hace el endpoint de descarga) para poder
            // mostrar el error en la página en vez de que el navegador reciba un 400 pelado.
            AnyDeskSvc.BuildRegistryScript(_anyDeskPath);
        }
        catch (InvalidOperationException exception)
        {
            _anyDeskFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Revisá la ruta",
                Message = exception.Message
            };
            return;
        }

        AnyDeskSaving = true;
        var url = $"/api/conversaciones/anydesk/registro.reg?ruta={Uri.EscapeDataString(_anyDeskPath.Trim())}";
        Nav.NavigateTo(url, forceLoad: true);
        AnyDeskSaving = false;
    }

    private async Task TestAlfaKnowledgeConnectionAsync()
    {
        Saving = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => ConfigSvc.TestAlfaKnowledgeConnectionAsync(_alfaKnowledgeConfig),
            "No se pudo probar la conexión con AlfaKnowledge.");

        if (result.Success && result.Value is not null)
        {
            if (result.Value.Success)
            {
                var databasePart = string.IsNullOrWhiteSpace(result.Value.Database)
                    ? "base no informada"
                    : $"base {result.Value.Database}";
                var kbPart = string.IsNullOrWhiteSpace(result.Value.KnowledgeBase)
                    ? string.Empty
                    : $" ({result.Value.KnowledgeBase})";

                _feedback = AppUiMessage.Success(
                    "Conexión verificada",
                    $"AlfaKnowledge respondió OK sobre {databasePart}{kbPart}.");
            }
            else
            {
                _feedback = new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Conexión con observaciones",
                    Message = string.IsNullOrWhiteSpace(result.Value.Message)
                        ? $"AlfaKnowledge respondió HTTP {result.Value.StatusCode}."
                        : result.Value.Message,
                    Suggestion = string.IsNullOrWhiteSpace(result.Value.KnowledgeBase)
                        ? "Revisá la URL, la API Key y el Knowledge Base Id configurados para esta base."
                        : $"Base resuelta: {result.Value.KnowledgeBase}."
                };
            }
        }
        else
        {
            _feedback = result.Feedback;
        }

        Saving = false;
    }

    private void EnsureDefaults()
    {
        if (string.IsNullOrWhiteSpace(_config.WebhookPath))
            _config.WebhookPath = "/api/conversaciones/whatsapp/webhook";

        if (string.IsNullOrWhiteSpace(_config.ApiVersion))
            _config.ApiVersion = "v22.0";
    }

    private void EnsureInstagramDefaults()
    {
        if (string.IsNullOrWhiteSpace(_instagramConfig.WebhookPath))
            _instagramConfig.WebhookPath = "/api/conversaciones/instagram/webhook";

