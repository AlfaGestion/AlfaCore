    /// <summary>
    /// El polling de QR/pairing sólo debe correr en segundo plano mientras el usuario está
    /// efectivamente mirando WhatsApp Business (Canales > WhatsApp > WhatsApp Business). Al salir
    /// de esa vista se detiene (no seguir generando QR fuera de pantalla); al volver, se retoma
    /// sólo si hay un pairing propio de esta sesión todavía pendiente y sin error terminal.
    /// </summary>
    private void SyncWhatsAppPollingWithNavigation()
    {
        var onNumerosView = _activePrimaryTab == "canales"
            && _activeChannelTab == "whatsapp"
            && _activeWhatsAppSection == "numeros";

        if (!onNumerosView)
        {
            StopPolling();
            _ = CleanupAbandonedPairingsAsync();
            return;
        }

        ResumePollingIfPairingActive();
    }

    /// <summary>
    /// No alcanza con cortar el polling de UI al salir de la vista: un pairing que nunca llegó a
    /// conectarse deja el worker Node corriendo indefinidamente esperando un QR que nadie va a
    /// escanear. Se detiene realmente esa sesión (sin tocar auth de cuentas ya vinculadas -- sólo
    /// entra acá si !IsWebSessionReady) y se archiva la fila (Activo=false) para que no quede
    /// pegada en la lista Business. Silencioso a propósito: no es una acción que el usuario disparó
    /// mirando esta pantalla, así que no le mostramos feedback por algo que pasó en background.
    /// </summary>
    private async Task CleanupAbandonedPairingsAsync()
    {
        var pendingIds = _pairingFlowActiveIds
            .Where(id =>
            {
                var pendingNumero = _numeros.FirstOrDefault(x => x.IdNumero == id);
                return pendingNumero is not null && !pendingNumero.IsWebSessionReady;
            })
            .ToList();

        if (pendingIds.Count == 0)
            return;

        foreach (var idNumero in pendingIds)
        {
            _pairingFlowActiveIds.Remove(idNumero);

            var result = await UiOps.RunAsync(
                () => WhatsAppWebSessionSvc.StopSessionAsync(idNumero),
                "No se pudo limpiar un pairing abandonado de WhatsApp Web.");

            if (!result.Success || result.Value is null)
                continue;

            var numero = result.Value;
            if (numero.Activo)
            {
                numero.Activo = false;
                var archived = await UiOps.RunAsync(
                    () => ConfigSvc.SaveWhatsAppNumeroAsync(numero),
                    "No se pudo archivar un número abandonado.");
                if (!archived.Success)
                    continue;
            }

            ReplaceNumero(numero);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResumePollingIfPairingActive()
    {
        if (_pollingCts is not null)
            return;

        foreach (var idNumero in _pairingFlowActiveIds)
        {
            if (idNumero == _pairingRegenerateErrorForIdNumero)
                continue;

            var numero = _numeros.FirstOrDefault(n => n.IdNumero == idNumero);
            if (numero is null || numero.IsWebSessionReady)
                continue;

            StartPolling(numero);
            return;
        }
    }

