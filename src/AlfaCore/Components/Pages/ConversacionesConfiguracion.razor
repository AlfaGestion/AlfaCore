                            <div class="conv-config-tool-row">
                                <div class="conv-config-tool-row__icon"><i class="bi bi-wallet2" aria-hidden="true"></i></div>
                                <div class="conv-config-tool-row__text">
                                    <span class="conv-config-tool-row__title">Saldo de Cliente</span>
                                    <span class="conv-config-tool-row__desc">Puede responder el saldo de cuenta corriente (total, detalle o link al portal, según lo que pida) cuando la conversación está vinculada a un Cliente.</span>
                                </div>
                                <label class="conv-config-checkbox conv-config-tool-row__toggle">
                                    <input type="checkbox" @bind="_automatizacionesConfig.AsistenteHerramientaSaldoCliente" />
                                </label>
                            </div>
                            <div class="conv-config-tool-row">
                                <div class="conv-config-tool-row__icon"><i class="bi bi-truck" aria-hidden="true"></i></div>
