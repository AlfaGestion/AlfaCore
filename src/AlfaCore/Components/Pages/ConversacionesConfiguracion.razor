                                    <span class="conv-config-tool-row__desc">Puede responder el estado de una Nota de Pedido (Pendiente, Aprobado, Finalizado o Anulado) de un Cliente identificado.</span>
                                </div>
                                <label class="conv-config-checkbox conv-config-tool-row__toggle">
                                    <input type="checkbox" @bind="_automatizacionesConfig.AsistenteHerramientaPedidos" />
                                </label>
                            </div>
                            <div class="conv-config-tool-row">
                                <div class="conv-config-tool-row__icon"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></div>
                                <div class="conv-config-tool-row__text">
                                    <span class="conv-config-tool-row__title">Portal de autogestión</span>
                                    <span class="conv-config-tool-row__desc">Puede ofrecer el link para ver la cuenta corriente online (hoy disponible para Cliente; Proveedor está en camino).</span>
                                </div>
                                <label class="conv-config-checkbox conv-config-tool-row__toggle">
                                    <input type="checkbox" @bind="_automatizacionesConfig.AsistenteHerramientaPortalLink" />
                                </label>
                            </div>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label class="conv-config-checkbox">
                                <input type="checkbox" @bind="_automatizacionesConfig.AsistenteFueraHorario" />
                                <span>Fuera de horario, que atienda el asistente (en vez del mensaje fijo): se presenta como IA, intenta ayudar y, si no puede, deja el mensaje para un operador</span>
                            </label>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label for="asis-urgencia">Palabras que marcan urgencia (se atienden en cualquier horario: suben prioridad y avisan al operador)</label>
                            <input id="asis-urgencia" @bind="_automatizacionesConfig.AsistenteUrgenciaPalabras"
                                   placeholder="no puedo facturar, no anda el sistema, no arranca, sistema caido" />
                        </div>
                        <div class="field conv-config-fields__full">
                            <label class="conv-config-checkbox">
                                <input type="checkbox" @bind="_automatizacionesConfig.BotSoloSinAsignar" />
                                <span>Responder solo conversaciones sin asignar (si un humano la tomó, el asistente calla)</span>
                            </label>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label class="conv-config-checkbox">
                                <input type="checkbox" @bind="_automatizacionesConfig.BotSoloFueraHorario" />
                                <span>Responder solo fuera del horario de atención (en horario, lo dejan los agentes humanos)</span>
                            </label>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label for="bot-escalado">Palabras que fuerzan pasar a un humano</label>
                            <input id="bot-escalado" @bind="_automatizacionesConfig.BotPalabrasEscalado" placeholder="humano, persona, reclamo, operador" />
                        </div>
                        <div class="field">
                            <label for="bot-max">Máx. respuestas del asistente por conversación</label>
                            <input id="bot-max" type="number" min="1" @bind="_automatizacionesConfig.BotMaxRespuestas" />
                        </div>
                        <div class="field">
                            <label for="bot-espera">Esperar minutos antes de responder</label>
                            <input id="bot-espera" type="number" min="0" @bind="_automatizacionesConfig.BotEsperaMinutos" />
                            <small class="field__hint">Le da tiempo a un agente humano a responder primero. 0 = el asistente responde de inmediato.</small>
                        </div>
                    </div>
                </details>

                <details class="conv-config-collapsible">
                    <summary class="conv-config-collapsible__summary">
                        <span class="conv-config-collapsible__title"><i class="bi bi-door-closed"></i> Auto-cierre por inactividad</span>
                        <span class="conv-config-collapsible__hint">Aviso y cierre automático cuando el cliente no responde.</span>
                    </summary>
                    <div class="conv-config-collapsible__body conv-config-fields conv-bot-config">
                        <div class="conv-config-fields__full">
                            <p class="panel-card__subtitle">Cierra conversaciones donde estamos esperando al cliente (último mensaje nuestro) y no responde. Manda un aviso previo y, si sigue sin responder, cierra. Aplica a todos los canales. Apagado por defecto.</p>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label class="conv-config-checkbox">
                                <input type="checkbox" @bind="_automatizacionesConfig.AutoCierreActivo" />
                                <span>Activar auto-cierre por inactividad</span>
                            </label>
                        </div>
                        <div class="field">
                            <label for="ac-aviso">Horas de inactividad para el aviso</label>
                            <input id="ac-aviso" type="number" min="1" @bind="_automatizacionesConfig.AutoCierreHorasAviso" />
                        </div>
                        <div class="field">
                            <label for="ac-cierre">Horas tras el aviso para cerrar</label>
                            <input id="ac-cierre" type="number" min="1" @bind="_automatizacionesConfig.AutoCierreHorasCierre" />
                        </div>
                        <div class="field conv-config-fields__full">
                            <label for="ac-msg-aviso">Mensaje de aviso</label>
                            <textarea id="ac-msg-aviso" rows="2" @bind="_automatizacionesConfig.AutoCierreMensajeAviso"></textarea>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label for="ac-msg-cierre">Mensaje de cierre (opcional)</label>
                            <textarea id="ac-msg-cierre" rows="2" @bind="_automatizacionesConfig.AutoCierreMensajeCierre"></textarea>
                        </div>
                    </div>
                </details>

                <details class="conv-config-collapsible">
                    <summary class="conv-config-collapsible__summary">
                        <span class="conv-config-collapsible__title"><i class="bi bi-alarm"></i> Seguimientos / SLA</span>
                        <span class="conv-config-collapsible__hint">Recordatorios internos y reasignación cuando el cliente espera.</span>
                    </summary>
                    <div class="conv-config-collapsible__body conv-config-fields conv-bot-config">
                        <div class="conv-config-fields__full">
                            <p class="panel-card__subtitle">Vigila las conversaciones donde el cliente espera respuesta (último mensaje entrante). A las horas configuradas deja una nota interna de recordatorio; si sigue sin responderse y estaba asignada, la desasigna para que otro la tome. No manda nada al cliente. Aplica a todos los canales. Apagado por defecto.</p>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label class="conv-config-checkbox">
                                <input type="checkbox" @bind="_automatizacionesConfig.SlaActivo" />
                                <span>Activar seguimientos / SLA</span>
                            </label>
                        </div>
                        <div class="field">
                            <label for="sla-recordatorio">Horas sin respuesta para el recordatorio</label>
                            <input id="sla-recordatorio" type="number" min="1" @bind="_automatizacionesConfig.SlaHorasRecordatorio" />
                        </div>
                        <div class="field">
                            <label for="sla-reasignar">Horas sin respuesta para reasignar</label>
                            <input id="sla-reasignar" type="number" min="1" @bind="_automatizacionesConfig.SlaHorasReasignar" />
                        </div>
                    </div>
                </details>

                <details class="conv-config-collapsible">
                    <summary class="conv-config-collapsible__summary">
                        <span class="conv-config-collapsible__title"><i class="bi bi-file-earmark-bar-graph-fill"></i> Informe mensual</span>
                        <span class="conv-config-collapsible__hint">Tono y estilo del resumen IA por cliente.</span>
                    </summary>
                    <div class="conv-config-collapsible__body conv-config-fields conv-bot-config">
                        <div class="conv-config-fields__full">
                            <p class="panel-card__subtitle">Tono e instrucciones que usa la IA al redactar el resumen de atención por cliente en Informes. Definís solo el estilo; el formato (viñetas, largo, no inventar, sin saludo/firma) queda fijo para que siempre salga prolijo. Si lo dejás vacío, se usa el texto por defecto.</p>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label for="informe-instrucciones">Instrucciones del informe (tono / persona)</label>
                            <textarea id="informe-instrucciones" rows="4" @bind="_automatizacionesConfig.InformeInstrucciones"
                                      placeholder="@AlfaCore.Models.ConversacionAutomatizacionesConfigDto.DefaultInformeInstrucciones"></textarea>
                        </div>
                    </div>
                </details>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveAutomatizacionesAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar automatizaciones
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Nivel 0: regla fija, sin IA.</p>
                    </div>
                    <span class="panel-card__tag">WhatsApp</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Se manda solo para mensajes entrantes de WhatsApp fuera del horario/días configurados.</li>
                    <li>Como máximo una vez por conversación mientras siga fuera de horario, para no repetir el mensaje en cada respuesta del cliente.</li>
                    <li>Queda registrado como un mensaje saliente normal, marcado como automático.</li>
                </ol>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Reglas / palabras clave</h3>
                        <p class="panel-card__subtitle">Cuando llega un mensaje entrante (cualquier canal) y coincide una palabra clave, la regla puede responder, derivar a un técnico y/o fijar la prioridad. Se evalúan por orden; la primera que coincide y tiene «detener» corta el resto.</p>
                    </div>
                    <span class="panel-card__tag">CONV_REGLAS</span>
                </div>

                @if (_reglas.Count == 0)
                {
                    <p class="panel-card__subtitle">Todavía no hay reglas cargadas. El motor está inactivo hasta que agregues al menos una.</p>
                }
                else
                {
                    @foreach (var regla in _reglas)
                    {
                        <div class="conv-whatsapp-numero-card">
                            <div class="conv-config-fields__full">
                                <strong>#@regla.Orden — @regla.Nombre</strong>
                                @if (!regla.Activa)
                                {
                                    <span class="panel-card__tag">inactiva</span>
                                }
                                <p class="panel-card__subtitle">@DescribirCanalRegla(regla.Canal) · @regla.TipoCoincidencia.ToLowerInvariant(): @regla.Palabras · @DescribirAccionesRegla(regla)@DescribirCondicionesRegla(regla)@(regla.Detener ? " · detiene" : "")</p>
                            </div>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarRegla(regla)" disabled="@(Loading || Saving)">
                                    <i class="bi bi-pencil"></i> Editar
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EliminarReglaAsync(regla)" disabled="@(Loading || Saving)">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    }
                }

                @if (_reglaEdicion is null)
                {
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="NuevaRegla" disabled="@(Loading || Saving)">
                            <i class="bi bi-plus-lg"></i> Nueva regla
                        </button>
                    </div>
                }
                else
                {
                    <div class="conv-whatsapp-numero-card conv-whatsapp-numero-card--nuevo">
                        <div class="conv-config-fields conv-bot-config">
                            <div class="conv-config-fields__full">
                                <h4 class="conv-bot-config__title"><i class="bi bi-sliders"></i> @(_reglaEsNueva ? "Nueva regla" : $"Editar regla: {_reglaEdicion.Nombre}")</h4>
                            </div>
                            <div class="field">
                                <label>Nombre</label>
                                <input @bind="_reglaEdicion.Nombre" placeholder="Ej: Horarios de atención" />
                            </div>
                            <div class="field">
                                <label>Orden (menor = mayor prioridad)</label>
                                <input type="number" min="1" @bind="_reglaEdicion.Orden" />
                            </div>
                            <div class="field">
                                <label>Canal</label>
                                <select @bind="_reglaEdicion.Canal">
                                    <option value="">Todos los canales</option>
                                    <option value="WHATSAPP">WhatsApp</option>
                                    <option value="INSTAGRAM">Instagram</option>
                                    <option value="FACEBOOK">Facebook</option>
                                    <option value="MERCADOLIBRE">Mercado Libre</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Tipo de coincidencia</label>
                                <select @bind="_reglaEdicion.TipoCoincidencia">
                                    <option value="CONTIENE">El mensaje contiene…</option>
                                    <option value="EMPIEZA">El mensaje empieza con…</option>
                                    <option value="IGUAL">El mensaje es exactamente…</option>
                                </select>
                            </div>
                            <div class="field conv-config-fields__full">
                                <label>Palabras / frases (separadas por coma; coincide con cualquiera)</label>
                                <input @bind="_reglaEdicion.Palabras" placeholder="turnos, horario, atención" />
                            </div>
                            <div class="field conv-config-fields__full">
                                <label>Respuesta automática (opcional)</label>
                                <textarea rows="2" @bind="_reglaEdicion.RespuestaTexto" placeholder="Atendemos de 9 a 18 h. ¿En qué te ayudamos?"></textarea>
                            </div>
                            <div class="field">
                                <label>Derivar a técnico (opcional)</label>
                                <select @bind="_reglaEdicion.AsignarTecnico">
                                    <option value="">No derivar</option>
                                    @foreach (var t in _tecnicos)
                                    {
                                        <option value="@t.IdTecnico">@t.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>Fijar prioridad (opcional)</label>
                                <select @bind="_reglaEdicion.Prioridad">
                                    <option value="">No cambiar</option>
                                    <option value="BAJA">Baja</option>
                                    <option value="MEDIA">Media</option>
                                    <option value="ALTA">Alta</option>
                                    <option value="URGENTE">Urgente</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.Activa" />
                                    <span>Activa</span>
                                </label>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.SoloSinAsignar" />
                                    <span>Solo si nadie la tiene asignada</span>
                                </label>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.Detener" />
                                    <span>Detener otras reglas y auto-respuestas si coincide</span>
                                </label>
                            </div>
                            <div class="field">
                                <label>Horario</label>
                                <select @bind="_reglaEdicion.Horario">
                                    <option value="SIEMPRE">Siempre</option>
                                    <option value="DENTRO">Solo dentro del horario</option>
                                    <option value="FUERA">Solo fuera del horario</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.SoloPrimerContacto" />
                                    <span>Solo en el primer contacto</span>
                                </label>
                            </div>
                        </div>
                        <div class="actions">
                            <button type="button" class="btn btn--primary" @onclick="GuardarReglaAsync" disabled="@(Loading || Saving)">
                                <i class="bi bi-floppy-fill"></i> Guardar regla
                            </button>
                            <button type="button" class="btn btn--ghost" @onclick="CancelarEdicionRegla" disabled="@(Loading || Saving)">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Menú por palabras clave, sin IA.</p>
                    </div>
                    <span class="panel-card__tag">Todos los canales</span>
                </div>

                <ol class="conv-config-steps">
                    <li>En cada mensaje entrante se evalúan las reglas activas por orden (menor primero).</li>
                    <li>La primera que coincide aplica sus acciones: responde, deriva a un técnico y/o fija la prioridad.</li>
                    <li>Si esa regla tiene «detener», no se evalúan más reglas ni se dispara la bienvenida/bot.</li>
                    <li>«Solo si nadie la tiene asignada» evita pisar una conversación que ya atiende una persona.</li>
                    <li>La respuesta se manda si el canal/ventana lo permiten; la derivación y la prioridad se aplican igual.</li>
                </ol>
            </aside>
    </div>

    }

    @if (_activePrimaryTab == "operacion-accesos")
    {
    <header class="settings-content-header">
        <h3>Operación y accesos</h3>
        <p>Prioridad de atención y administradores de Conversaciones.</p>
    </header>
    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Prioridad de atención</h3>
                        <p class="panel-card__subtitle">Qué clasificación de cliente cuenta como prioridad 1 (más importante), 2 o 3 para ordenar la cola de espera. El resto (sin clasificar o con otra clasificación) queda al final.</p>
                    </div>
                    <span class="panel-card__tag">CLASIFICA1/2/3</span>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="prioridad-1">Prioridad 1 (más importante)</label>
                        <select id="prioridad-1" @bind="_prioridadConfig.Clasifica1">
                            <option value="">Sin asignar</option>
                            @foreach (var opcion in _clasificaciones)
                            {
                                <option value="@opcion.Codigo">@opcion.Descripcion</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="prioridad-2">Prioridad 2 (media)</label>
                        <select id="prioridad-2" @bind="_prioridadConfig.Clasifica2">
                            <option value="">Sin asignar</option>
                            @foreach (var opcion in _clasificaciones)
                            {
                                <option value="@opcion.Codigo">@opcion.Descripcion</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="prioridad-3">Prioridad 3 (baja)</label>
                        <select id="prioridad-3" @bind="_prioridadConfig.Clasifica3">
                            <option value="">Sin asignar</option>
                            @foreach (var opcion in _clasificaciones)
                            {
                                <option value="@opcion.Codigo">@opcion.Descripcion</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SavePrioridadAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar prioridad
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Cómo se arma la cola de espera con esto.</p>
                    </div>
                    <span class="panel-card__tag">Cola de espera</span>
                </div>

                <ol class="conv-config-steps">
                    <li>El inbox ordena primero por prioridad (1, 2, 3, resto) y dentro de cada grupo por cuánto tiempo lleva esperando respuesta.</li>
                    <li>La clasificación de cada cliente se carga desde Clientes (Cuentas Comerciales) — acá solo se define qué clasificación pesa más.</li>
                    <li>Estas claves (<code>CLASIFICA1/2/3</code>) son las mismas que ya usa Desktop, no son propias de Conversaciones: configurarlas acá también las cambia allá.</li>
                </ol>
            </aside>
    </div>
    }

    @if (_activePrimaryTab == "canales" && _activeChannelTab == "whatsapp" && _activeWhatsAppSection == "numeros")
    {
    <div class="wa-layout">
            <section class="wa-panel">

                @if (PairingBusy)
                {
                    <div class="wa-pairing wa-pairing--updating" role="status" aria-live="polite">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="wa-field-note">Conectando WhatsApp Web... puede tardar hasta 20 segundos. No cierres ni recargues esta página, ni vuelvas a tocar "Conectar" mientras tanto.</span>
                    </div>
                }

                @if (!ActiveBusinessNumeros.Any())
                {
                    <div class="wa-empty-connect">
                        <p class="wa-content-lead">Conectá tu WhatsApp para atender conversaciones desde AlfaCore.</p>
                        @if (_connectMethodPromptForIdNumero == 0)
                        {
                            <div class="wa-connect-chooser">
                                <p class="wa-field-note">Elegí cómo querés vincular tu cuenta.</p>
                                <div class="wa-connect-chooser__methods">
                                    <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-qr-code" Loading="@(Saving || PairingBusy)" OnClick="@(() => IniciarNuevoWhatsAppBusinessAsync(ConversacionWhatsAppWebSessionModes.Qr, null))">Código QR</AlfaButton>
                                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-keyboard" OnClick="@(() => ShowConnectPhoneInput(0))">Número de teléfono</AlfaButton>
                                </div>
                                @if (_connectPhoneChooserFor == 0)
                                {
                                    <AlfaInput Label="Número de teléfono (con código de país)" @bind-Value="_connectPhoneInput" Placeholder="+54 9 11 1234 5678" />
                                    <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-keyboard" Disabled="@string.IsNullOrWhiteSpace(_connectPhoneInput)" Loading="@(Saving || PairingBusy)" OnClick="@(() => IniciarNuevoWhatsAppBusinessAsync(ConversacionWhatsAppWebSessionModes.PhoneNumber, _connectPhoneInput))">Generar código</AlfaButton>
                                }
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" OnClick="CloseConnectMethodChooser">Cancelar</AlfaButton>
                            </div>
                        }
                        else
                        {
                            <AlfaButton Icon="bi bi-qr-code" OnClick="@(() => OpenConnectMethodChooser(0))">Conectar WhatsApp</AlfaButton>
                        }
                    </div>
                }

                @foreach (var numero in ActiveBusinessNumeros)
                {
                    <div class="wa-number-card">
                        <div class="wa-number-card__header">
                            <div>
                                <strong class="wa-number-card__name">@GetNumeroDisplayName(numero)</strong>
                                @{ var subPhone = string.IsNullOrWhiteSpace(numero.WebPhoneNumber) ? numero.PhoneNumberId : numero.WebPhoneNumber; }
                                @if (!string.Equals(subPhone, GetNumeroDisplayName(numero), StringComparison.Ordinal))
                                {
                                    <span class="wa-number-card__phone">@subPhone</span>
                                }
                            </div>
                        </div>

                        <div class="wa-number-card__status">
                            <AlfaTag Tone="@GetNumeroEstadoTone(numero)">@GetNumeroEstadoLabel(numero)</AlfaTag>
                        </div>

                        @if (numero.WebSessionStatus == ConversacionWhatsAppWebSessionStatuses.Disconnected && !string.IsNullOrWhiteSpace(numero.WebLastError))
                        {
                            <p class="wa-number-card__error"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @numero.WebLastError</p>
                        }

                        @if (HasPairingRegenerateError(numero))
                        {
                            <div class="wa-pairing wa-pairing--error">
                                <div class="wa-pairing__details">
                                    <p class="wa-field-note"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> No pudimos actualizar el código QR.</p>
                                </div>
                            </div>
                        }
                        else if (string.Equals(numero.WebSessionMode, ConversacionWhatsAppWebSessionModes.PhoneNumber, StringComparison.OrdinalIgnoreCase) && ShouldShowPairingSurface(numero) && numero.HasWebPairingCode)
                        {
                            <div class="wa-pairing">
                                <div class="wa-pairing__code">@FormatPairingCodeForDisplay(numero.WebPairingCode)</div>
                                <div class="wa-pairing__details">
                                    <p class="wa-field-note">Ingresá este código en WhatsApp Business → Dispositivos vinculados → Vincular dispositivo → Vincular con número de teléfono.</p>
                                    <p class="wa-field-note">Si el código vence, lo actualizamos automáticamente.</p>
                                </div>
                            </div>
                        }
                        else if (ShouldShowPairingSurface(numero) && numero.HasWebPairingQr)
                        {
                            <div class="wa-pairing">
                                <div class="wa-pairing__qr">
                                    <img src="@numero.WebPairingQrDataUrl" alt="QR de emparejamiento de WhatsApp Business" />
                                </div>
                                <div class="wa-pairing__details">
                                    <p class="wa-field-note">Abrí WhatsApp Business → Dispositivos vinculados → Vincular dispositivo → escaneá este código.</p>
                                    <p class="wa-field-note">Si el código vence, lo actualizamos automáticamente.</p>
                                </div>
                            </div>
                        }
                        else if (IsPairingRegenerating(numero))
                        {
                            <div class="wa-pairing wa-pairing--updating">
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span class="wa-field-note">Actualizando código QR...</span>
                            </div>
                        }

                        @if (numero.IsWebSessionReady)
                        {
                            <div class="wa-number-card__actions">
                                <AlfaButton Variant="AlfaButtonVariant.Danger" Size="AlfaSize.Sm" Icon="bi bi-box-arrow-right" OnClick="@(() => RequestStopWhatsAppWebSession(numero))">Cerrar sesión</AlfaButton>
                            </div>
                        }
                        else if (HasPairingRegenerateError(numero))
                        {
                            <div class="wa-number-card__actions">
                                <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-arrow-repeat" Loading="@(Saving || PairingBusy)" OnClick="@(() => RetryWhatsAppWebPairingAsync(numero))">Reintentar</AlfaButton>
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-x-lg" Disabled="@(Loading || Saving || PairingBusy)" OnClick="@(() => ClearWhatsAppWebPairingAsync(numero))">Cancelar</AlfaButton>
                            </div>
                        }
                        else if (IsPairingFlowVisible(numero))
                        {
                            <div class="wa-number-card__actions">
                                <AlfaIconButton Icon="bi bi-arrow-repeat" Label="Actualizar código" Disabled="@(Loading || Saving || PairingBusy)" OnClick="@(() => RefreshWhatsAppWebSessionAsync(numero))" />
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-x-lg" Disabled="@(Loading || Saving || PairingBusy)" OnClick="@(() => ClearWhatsAppWebPairingAsync(numero))">Cancelar</AlfaButton>
                            </div>
                        }
                        else if (_connectMethodPromptForIdNumero == numero.IdNumero)
                        {
                            <div class="wa-connect-chooser">
                                <p class="wa-field-note">Elegí cómo querés vincular esta cuenta.</p>
                                <div class="wa-connect-chooser__methods">
                                    <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-qr-code" Loading="@(Saving || PairingBusy)" OnClick="@(() => ConectarWhatsAppBusinessAsync(numero, ConversacionWhatsAppWebSessionModes.Qr, null))">Código QR</AlfaButton>
                                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-keyboard" OnClick="@(() => ShowConnectPhoneInput(numero.IdNumero))">Número de teléfono</AlfaButton>
                                </div>
                                @if (_connectPhoneChooserFor == numero.IdNumero)
                                {
                                    <AlfaInput Label="Número de teléfono (con código de país)" @bind-Value="_connectPhoneInput" Placeholder="+54 9 11 1234 5678" />
                                    <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-keyboard" Disabled="@string.IsNullOrWhiteSpace(_connectPhoneInput)" Loading="@(Saving || PairingBusy)" OnClick="@(() => ConectarWhatsAppBusinessAsync(numero, ConversacionWhatsAppWebSessionModes.PhoneNumber, _connectPhoneInput))">Generar código</AlfaButton>
                                }
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" OnClick="CloseConnectMethodChooser">Cancelar</AlfaButton>
                            </div>
                        }
                        else
                        {
                            <div class="wa-number-card__actions">
                                <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-qr-code" OnClick="@(() => OpenConnectMethodChooser(numero.IdNumero))">Conectar WhatsApp</AlfaButton>
                                @if (!string.IsNullOrWhiteSpace(numero.WebInstanceName))
                                {
                                    // Este número tocó WhatsApp Web alguna vez (quedó un WebInstanceName
                                    // grabado) pero no está conectado ahora -- sin este botón no hay forma
                                    // de soltarlo: ResolveWhatsAppDeliveryProviderForNumero() sigue
                                    // ruteando cada envío por Web (y fallando) aunque la base tenga Meta
                                    // Cloud API como proveedor predeterminado, y "Cerrar sesión" solo
                                    // aparecía cuando el estado era Connected.
                                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-box-arrow-right" OnClick="@(() => RequestStopWhatsAppWebSession(numero))">Cerrar sesión</AlfaButton>
                                }
                            </div>
                        }

                        <details class="wa-settings-section">
                            <summary class="wa-settings-section__summary">
                                <span class="wa-settings-section__title">Usuarios con acceso</span>
                                <span class="wa-settings-section__hint">@numero.Usuarios.Count</span>
                                <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                            </summary>
                            <div class="wa-settings-section__body">
                                <div class="wa-user-grid">
                                    @foreach (var usuario in _usuariosSistema)
                                    {
                                        <AlfaCheckbox Value="@numero.Usuarios.Contains(usuario.Nombre, StringComparer.OrdinalIgnoreCase)"
                                                      ValueChanged="@(v => ToggleNumeroUsuario(numero, usuario.Nombre, v ?? false))">
                                            @usuario.Nombre
                                        </AlfaCheckbox>
                                    }
                                    @if (_usuariosSistema.Count == 0)
                                    {
                                        <span class="wa-field-note">No hay usuarios activos en este sistema.</span>
                                    }
                                </div>
                            </div>
                        </details>

                        <details class="wa-settings-section">
                            <summary class="wa-settings-section__summary">
                                <span class="wa-settings-section__title">Opciones avanzadas</span>
                                <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                            </summary>
                            <div class="wa-settings-section__body">
                                <div class="wa-fields">
                                    <AlfaInput Label="Nombre" @bind-Value="numero.Nombre" Placeholder="Ej: Ventas Norte" />
                                    <AlfaInput Label="Phone Number ID" @bind-Value="numero.PhoneNumberId" Placeholder="Ej: 109876543210" />
                                    <AlfaInput Label="Nombre visible sesión Web" @bind-Value="numero.WebDisplayName" Placeholder="Ej: WhatsApp Sucursal Centro" />
                                    <AlfaInput Label="Instancia sesión Web" @bind-Value="numero.WebInstanceName" Placeholder="Se genera sola si la dejás vacía" />
                                    <AlfaSelect Label="Método de inicio" Options="@_webSessionModeOptions" @bind-Value="numero.WebSessionMode" />
                                    <AlfaInput Label="Número para sesión Web" @bind-Value="numero.WebPhoneNumber" Placeholder="Ej: +54 11 1234-5678" />
                                </div>
                                <AlfaCheckbox Value="@_includeTextPairingCode" ValueChanged="@(v => _includeTextPairingCode = v ?? false)">Generar también código de texto al conectar</AlfaCheckbox>
                                <div class="actions">
                                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-floppy-fill" Disabled="@(Loading || Saving)" OnClick="@(() => SaveNumeroAsync(numero))">Guardar opciones</AlfaButton>
                                </div>
                            </div>
                        </details>

                        @if (!string.IsNullOrWhiteSpace(numero.WebRuntimeState) || numero.WebWorkerProcessId.HasValue)
                        {
                            <details class="wa-settings-section">
                                <summary class="wa-settings-section__summary">
                                    <span class="wa-settings-section__title">Soporte y diagnóstico</span>
                                    <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                                </summary>
                                <div class="wa-settings-section__body">
                                    <p class="wa-field-note">
                                        Estado runtime: @DisplayPairingValue(numero.WebRuntimeState)
                                        · PID: @(numero.WebWorkerProcessId?.ToString() ?? "sin proceso")
                                        @if (numero.WebRuntimeUpdatedAtUtc.HasValue)
                                        {
                                            <text> · Actualizado: @numero.WebRuntimeUpdatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</text>
                                        }
                                    </p>
                                </div>
                            </details>
                        }
                    </div>
                }

                @if (ActiveBusinessNumeros.Any())
                {
                    @if (_connectMethodPromptForIdNumero == 0)
                    {
                        <div class="wa-connect-chooser">
                            <p class="wa-field-note">Elegí cómo querés vincular la nueva cuenta.</p>
                            <div class="wa-connect-chooser__methods">
                                <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-qr-code" Loading="@(Saving || PairingBusy)" OnClick="@(() => IniciarNuevoWhatsAppBusinessAsync(ConversacionWhatsAppWebSessionModes.Qr, null))">Código QR</AlfaButton>
                                <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-keyboard" OnClick="@(() => ShowConnectPhoneInput(0))">Número de teléfono</AlfaButton>
                            </div>
                            @if (_connectPhoneChooserFor == 0)
                            {
                                <AlfaInput Label="Número de teléfono (con código de país)" @bind-Value="_connectPhoneInput" Placeholder="+54 9 11 1234 5678" />
                                <AlfaButton Size="AlfaSize.Sm" Icon="bi bi-keyboard" Disabled="@string.IsNullOrWhiteSpace(_connectPhoneInput)" Loading="@(Saving || PairingBusy)" OnClick="@(() => IniciarNuevoWhatsAppBusinessAsync(ConversacionWhatsAppWebSessionModes.PhoneNumber, _connectPhoneInput))">Generar código</AlfaButton>
                            }
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" OnClick="CloseConnectMethodChooser">Cancelar</AlfaButton>
                        </div>
                    }
                    else
                    {
                        <div class="actions">
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-plus-circle" OnClick="@(() => OpenConnectMethodChooser(0))">Conectar otro WhatsApp</AlfaButton>
                        </div>
                    }
                }

                <details class="wa-settings-section">
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-question-circle wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">¿Necesitás ayuda para conectar WhatsApp Business?</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        <ol class="conv-config-steps">
                            <li>Tocá "Conectar WhatsApp" en el número que querés vincular.</li>
                            <li>Abrí WhatsApp Business en el teléfono → Dispositivos vinculados → Vincular dispositivo.</li>
                            <li>Escaneá el código QR que aparece en pantalla.</li>
                            <li>Un usuario normal solo ve, en el inbox, las conversaciones de los números donde está marcado como usuario.</li>
                            <li>Un administrador de conversaciones ve y puede responder por cualquier número, sin restricción.</li>
                            <li>"Cerrar sesión" deja de mostrar el número en esta lista, pero no borra las conversaciones que ya tiene.</li>
                        </ol>
                    </div>
                </details>
            </section>
    </div>

    <AlfaConfirmDialog Open="_stopSessionOpen"
                        Title="Cerrar sesión de WhatsApp"
                        Message="@GetStopSessionMessage()"
                        SecondaryMessage="Las conversaciones anteriores se conservarán."
                        ConfirmLabel="Cerrar sesión"
                        CancelLabel="Cancelar"
                        Loading="_stopSessionBusy"
                        OnConfirm="ConfirmStopWhatsAppWebSessionAsync"
                        OnCancel="CancelStopWhatsAppWebSession" />
    }

    @if (_activePrimaryTab == "operacion-accesos")
    {
    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Administradores de conversaciones</h3>
                        <p class="panel-card__subtitle">Ven y pueden responder por cualquier número de WhatsApp, sin importar a cuáles estén vinculados.</p>
                    </div>
                    <span class="panel-card__tag">CONV_ADMINISTRADORES</span>
                </div>

                <div class="conv-config-checklist">
                    @foreach (var usuario in _usuariosSistema)
                    {
                        <label class="conv-config-checkbox">
                            <input type="checkbox"
                                   checked="@_administradores.Contains(usuario.Nombre)"
                                   @onchange="args => ToggleAdministrador(usuario.Nombre, args.Value is bool b && b)" />
                            <span>@usuario.Nombre</span>
                        </label>
                    }
                    @if (_usuariosSistema.Count == 0)
                    {
                        <span class="panel-card__subtitle">No hay usuarios activos en este sistema.</span>
                    }
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveAdministradoresAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar administradores
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Es propio de Conversaciones, no el admin general del sistema.</p>
                    </div>
                    <span class="panel-card__tag">Solo este módulo</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Es independiente de "Administrador del sistema" (Autorización de tareas) — alguien puede ser admin de conversaciones sin serlo del sistema, y viceversa.</li>
                    <li>Pensado para quien coordina el equipo de atención: supervisores, encargados de WhatsApp, etc.</li>
                </ol>
            </aside>
    </div>
    }

    @if (_activePrimaryTab == "soporte")
    {
    <header class="settings-content-header">
        <h3>Soporte</h3>
        <p>Herramientas técnicas y de diagnóstico. No reemplaza la configuración funcional de cada canal.</p>
    </header>
    @if (AppMode.IsSaaSMode)
    {
        <div class="conversations-inline @(HasWebhookToken ? "conversations-inline--ok" : "conversations-inline--error")">
            <strong>@(HasWebhookToken ? "Webhook identificado por base" : "Webhook sin identificación de base")</strong>
            <div>@GetWebhookTenantHelp("los mensajes entrantes")</div>
        </div>
    }
    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title"><i class="bi bi-display"></i> AnyDesk</h3>
                        <p class="panel-card__subtitle">Generá un archivo para registrar AnyDesk en tu propia PC, no en el servidor.</p>
                    </div>
                    <span class="panel-card__tag">Un paso por PC</span>
                </div>

                <div class="conv-config-fields">
                    <div class="field conv-config-fields__full">
                        <label for="anydesk-path">Ruta del ejecutable de AnyDesk en TU PC</label>
                        <input id="anydesk-path" @bind="_anyDeskPath" placeholder="Ej: C:\Program Files (x86)\AnyDesk\AnyDesk.exe" />
                    </div>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="DownloadAnyDeskScript" disabled="@AnyDeskSaving">
                        <i class="bi bi-download"></i> Descargar script de registro (.reg)
                    </button>
                </div>

                @if (_anyDeskFeedback is not null)
                {
                    <div class="conversations-inline @GetFeedbackClass(_anyDeskFeedback)">
                        <strong>@_anyDeskFeedback.Title</strong>
                        <div>@_anyDeskFeedback.Message</div>
                        @if (_anyDeskFeedback.HasSuggestion)
                        {
                            <div>@_anyDeskFeedback.Suggestion</div>
                        }
                    </div>
                }
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Por qué esto es distinto al resto de esta página.</p>
                    </div>
                    <span class="panel-card__tag">AnyDesk</span>
                </div>

                <ol class="conv-config-steps">
                    <li>AlfaCore corre en un servidor compartido, así que no puede tocar el registro de Windows de tu PC directamente.</li>
                    <li>Cargá acá la ruta a tu AnyDesk (buscala en tu PC: click derecho al acceso directo → Propiedades → Destino).</li>
                    <li>Al descargar, se genera un archivo <code>.reg</code> con esa ruta ya cargada.</li>
                    <li>Hacé doble clic en el archivo descargado (una sola vez) y confirmá el cartel de Windows para agregarlo al registro.</li>
                    <li>Listo: cualquier link "Conectar por AnyDesk" del inbox de Conversaciones va a abrir tu AnyDesk ya conectando al ID. Probalo haciendo clic en un ID de una conversación real.</li>
                    <li>Cada técnico repite esto una vez, en su propia PC.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Qué NO hace esto</span>
                    <strong>No guarda nada en la base de datos</strong>
                    <span class="context-card__muted">La ruta que cargues acá solo se usa para armar el archivo que descargás; no queda guardada en AlfaCore ni se comparte con otros técnicos.</span>
                </div>
            </aside>
    </div>
    }

        </div>
    </div>
</section>

@code {
    private ConversacionWhatsAppConfigDto _config = new();
    private ConversacionInstagramConfigDto _instagramConfig = new();
    private ConversacionFacebookConfigDto _facebookConfig = new();
    private ConversacionMercadoLibreConfigDto _mercadoLibreConfig = new();
    private ConversacionAlfaKnowledgeConfigDto _alfaKnowledgeConfig = new();
    private ConversacionAutomatizacionesConfigDto _automatizacionesConfig = new();
    private IReadOnlyList<ConversacionReglaDto> _reglas = [];
    private IReadOnlyList<ConversacionTecnicoOptionDto> _tecnicos = [];
    private ConversacionReglaDto? _reglaEdicion;
    private bool _reglaEsNueva;
    private ConversacionPrioridadConfigDto _prioridadConfig = new();
    private IReadOnlyList<ConversacionClasificacionOptionDto> _clasificaciones = [];
    private IReadOnlyList<UsuarioSistemaDto> _usuariosSistema = [];
    private IReadOnlyList<ConversacionWhatsAppNumeroDto> _numeros = [];

    /// <summary>
    /// La pestaña WhatsApp Business sólo lista cuentas activas -- "Cerrar sesión" pone Activo=false
    /// (ver ClearWhatsAppWebPairingAsync) sin tocar la fila ni el historial. En Meta Cloud API, en
    /// cambio, también mostramos números inactivos si todavía tienen usuarios asignados o coinciden
    /// con la API global: pueden tener conversaciones históricas o recibir webhooks reales.
    /// </summary>
    // Criterio UI vigente: Business = Web/QR; API = Meta Cloud API por Phone Number ID.
    private IEnumerable<ConversacionWhatsAppNumeroDto> ActiveBusinessNumeros => _numeros.Where(n => n.Activo && IsWhatsAppWebManagedNumero(n));
    private IEnumerable<ConversacionWhatsAppNumeroDto> WhatsAppApiNumeros
        => _numeros
            .Where(n => !IsWhatsAppWebManagedNumero(n) && ShouldShowApiNumero(n))
            .OrderByDescending(n => IsConfiguredGlobalApiNumero(n))
            .ThenByDescending(n => n.Activo)
            .ThenByDescending(n => n.Usuarios.Count)
            .ThenBy(n => n.Nombre);
    private ConversacionWhatsAppNumeroDto _nuevoNumero = new() { Activo = true };
    private HashSet<string> _administradores = new(StringComparer.OrdinalIgnoreCase);
    private string _anyDeskPath = string.Empty;
    private string _activePrimaryTab = "resumen";
    private string _activeChannelTab = "whatsapp";
    private string _activeWhatsAppSection = "numeros";
    private bool Loading { get; set; }
    private bool Saving { get; set; }
    private bool AnyDeskSaving { get; set; }
    private AppUiMessage? _feedback;
    private string? _feedbackScope;
    private AppUiMessage? WhatsAppFeedback => _feedbackScope == "whatsapp" ? _feedback : null;
    private AppUiMessage? _anyDeskFeedback;
    private string _suggestedBaseUrl = string.Empty;
    private string? _webhookToken;
    private bool _includeTextPairingCode = true;
    private bool HasWebhookToken => !string.IsNullOrWhiteSpace(_webhookToken);
    private bool PairingBusy { get; set; }
    private ConversacionWhatsAppNumeroDto? _stopSessionTarget;
    private bool _stopSessionOpen;
    private bool _stopSessionBusy;
    private int? _connectMethodPromptForIdNumero;
    private int? _connectPhoneChooserFor;
    private string _connectPhoneInput = string.Empty;
    private CancellationTokenSource? _pollingCts;

    /// <summary>
    /// Números cuyo QR/código de pairing fue iniciado explícitamente en esta sesión de UI.
    /// El QR/código guardado en base sólo se muestra y se auto-renueva para IDs presentes acá --
    /// evita precargar un pairing viejo/vencido de una sesión anterior solo porque la pantalla
    /// se abrió o se recargó (regla de producto: entrar a WhatsApp Business nunca genera QR solo).
    /// </summary>
    private readonly HashSet<int> _pairingFlowActiveIds = new();
    private int? _pairingRegenerateErrorForIdNumero;
    private int _pairingStaleCycles;
    private int _pairingFailureCount;
    private const int PairingStaleCycleLimit = 5;
    private const int PairingFailureLimit = 3;

    private sealed record SettingsNavItem(string Key, string Label, string Icon, string Hint);

    private static readonly IReadOnlyList<SettingsNavItem> SettingsNavItems =
    [
        new("resumen", "Resumen", "bi-grid-1x2-fill", "Puntos de entrada a la configuración."),
        new("canales", "Canales", "bi-broadcast", "WhatsApp, Instagram, Facebook y Mercado Libre."),
        new("automatizacion", "Automatización", "bi-gear-wide-connected", "Horarios, bienvenida, auto-cierre, SLA y reglas."),
        new("integraciones-ia", "Integraciones IA", "bi-stars", "AlfaKnowledge y el resto de integraciones de IA."),
        new("operacion-accesos", "Operación y accesos", "bi-people-fill", "Prioridad de atención y administradores."),
        new("soporte", "Soporte", "bi-life-preserver", "Herramientas técnicas y de diagnóstico.")
    ];

    private static readonly IReadOnlyList<AlfaTabItem> _channelTabItems =
    [
        new("whatsapp", "WhatsApp"),
        new("instagram", "Instagram"),
        new("facebook", "Facebook"),
        new("mercadolibre", "Mercado Libre")
    ];

    private static readonly IReadOnlyList<AlfaTabItem> _whatsAppSectionTabItems =
    [
        new("numeros", "WhatsApp Business"),
        new("general", "WhatsApp API")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> _providerModeOptions =
    [
        new(ConversacionWhatsAppProviderModes.MetaOnly, "Solo Meta Cloud API"),
        new(ConversacionWhatsAppProviderModes.WebOnly, "Solo WhatsApp Business (QR)"),
        new(ConversacionWhatsAppProviderModes.MetaAndWeb, "Convivencia Meta + WhatsApp Business")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> _defaultProviderOptions =
    [
        new(ConversacionWhatsAppProviders.MetaCloud, "Meta Cloud API"),
        new(ConversacionWhatsAppProviders.WhatsAppWeb, "WhatsApp Business (QR)")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> _webSessionModeOptions =
    [
        new(ConversacionWhatsAppWebSessionModes.Qr, "Escanear QR"),
        new(ConversacionWhatsAppWebSessionModes.PhoneNumber, "Ingresar número de teléfono")
    ];

    private bool IsDirectMode
        => Uri.TryCreate(Nav.Uri, UriKind.Absolute, out var uri)
           && System.Web.HttpUtility.ParseQueryString(uri.Query)["directo"] == "1";

    protected override async Task OnInitializedAsync()
    {
        ApplyStartupQuery();
        _suggestedBaseUrl = GetCurrentBaseUrl();
        UpdatePageHeader();
        await LoadWebhookTokenAsync();
        await LoadAsync();
    }

    private void ApplyStartupQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var seccion = query.TryGetValue("seccion", out var seccionRaw) ? seccionRaw.ToString() : string.Empty;
        var canal = query.TryGetValue("canal", out var canalRaw) ? canalRaw.ToString() : string.Empty;
        var legacyWhatsAppQrOnboarding =
            string.Equals(query.TryGetValue("onboarding", out var onboarding) ? onboarding.ToString() : string.Empty, "whatsapp-qr", StringComparison.OrdinalIgnoreCase);

        if (string.Equals(seccion, "canales", StringComparison.OrdinalIgnoreCase) || legacyWhatsAppQrOnboarding)
        {
            _activePrimaryTab = "canales";
            _activeChannelTab = string.Equals(canal, "whatsapp", StringComparison.OrdinalIgnoreCase) ? "whatsapp" : _activeChannelTab;
            if (_activeChannelTab == "whatsapp")
                _activeWhatsAppSection = "numeros";
        }
    }

