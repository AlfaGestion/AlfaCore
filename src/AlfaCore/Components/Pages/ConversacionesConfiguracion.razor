    private sealed class SecretReplacementDraft(string persistedValue)
    {
        public string PersistedValue { get; } = persistedValue;
        public bool ReplaceRequested { get; set; }
        public string ReplacementValue { get; set; } = string.Empty;
        public string EffectiveValue => ReplaceRequested ? ReplacementValue : PersistedValue;
        public bool HasUnsavedChanges => ReplaceRequested && ReplacementValue != PersistedValue;

        public void CancelReplacement()
        {
            ReplaceRequested = false;
            ReplacementValue = string.Empty;
        }
    }

