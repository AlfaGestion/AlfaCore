    private bool IsDirectMode
        => Uri.TryCreate(Nav.Uri, UriKind.Absolute, out var uri)
           && System.Web.HttpUtility.ParseQueryString(uri.Query)["directo"] == "1";

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += HandleLocationChanged;
        ApplyStartupQuery();
        if (_activePrimaryTab != "resumen")
            _expandedSettingsCategories.Add(_activePrimaryTab);
        _suggestedBaseUrl = GetCurrentBaseUrl();
        UpdatePageHeader();

        if (!await AuthorizationSvc.CanManageAsync())
        {
            Nav.NavigateTo(RouteContext.BuildRoute("/conversaciones"));
            return;
        }

        await LoadWebhookTokenAsync();
        await LoadAsync();
        _navigationReady = true;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(() =>
        {
            if (!_navigationReady)
                return;

            if (string.Equals(_internalNavigationUri, args.Location, StringComparison.Ordinal))
            {
                _internalNavigationUri = null;
            }
            else
            {
                ApplyStartupQuery();
                SyncWhatsAppPollingWithNavigation();
            }

            UpdatePageHeader();
            StateHasChanged();
        });

    private void ApplyStartupQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var seccion = query.TryGetValue("seccion", out var seccionRaw) ? seccionRaw.ToString() : string.Empty;
        var subseccion = query.TryGetValue("subseccion", out var subseccionRaw) ? subseccionRaw.ToString() : string.Empty;
        var canal = query.TryGetValue("canal", out var canalRaw) ? canalRaw.ToString() : string.Empty;
        var legacyWhatsAppQrOnboarding =
            string.Equals(query.TryGetValue("onboarding", out var onboarding) ? onboarding.ToString() : string.Empty, "whatsapp-qr", StringComparison.OrdinalIgnoreCase);

        var category = SettingsNavItems.FirstOrDefault(item =>
            string.Equals(item.Key, seccion, StringComparison.OrdinalIgnoreCase));

        if (category is not null)
        {
            _activePrimaryTab = category.Key;
            _expandedSettingsCategories.Add(category.Key);

            var child = category.Children.FirstOrDefault(item =>
                string.Equals(item.Key, subseccion, StringComparison.OrdinalIgnoreCase));
            if (child is not null)
                SelectSecondaryTabState(category.Key, child.Key);
            else if (category.Children.Count > 0)
                SelectSecondaryTabState(category.Key, category.Children[0].Key);

            _activeSecondaryTab = GetActiveSecondaryTab();
            return;
        }

        if (legacyWhatsAppQrOnboarding)
        {
            _activePrimaryTab = "canales";
            _activeChannelTab = string.Equals(canal, "whatsapp", StringComparison.OrdinalIgnoreCase) ? "whatsapp" : _activeChannelTab;
            if (_activeChannelTab == "whatsapp")
                _activeWhatsAppSection = "numeros";
            _activeSecondaryTab = GetActiveSecondaryTab();
            return;
        }

        _activePrimaryTab = "resumen";
        _activeSecondaryTab = "resumen";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        StopPolling();
        PageHeader.Clear();
    }

    private void UpdatePageHeader()
    {
        var onBusiness = IsWhatsAppBusinessView;
        var editingBusiness = IsEditingBusinessNumero;
        var editingApiNumero = _activePrimaryTab == "canales"
            && _activeChannelTab == "whatsapp"
            && _activeWhatsAppSection == "general"
            && (_apiNumeroDraft is not null || _addingApiNumero);
        var editingRegla = _activePrimaryTab == "automatizacion" && _reglaEdicion is not null;

        IReadOnlyList<PageHeaderAction> actions;
        if (onBusiness && IsBusinessConnectFlowActive)
        {
            actions =
            [
                new()
                {
                    Key = "cancelar-conexion-whatsapp-business",
                    Label = "Cancelar",
                    Icon = "bi-x-circle",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = Saving || PairingBusy,
                    OnClick = CancelBusinessConnectionAsync
                }
            ];
        }
        else if (editingBusiness)
        {
            actions =
            [
                new()
                {
                    Key = "guardar-whatsapp-business",
                    Label = Saving ? "Guardando..." : "Guardar",
                    Icon = "bi-floppy",
                    Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = Saving,
                    Busy = Saving,
                    OnClick = SaveBusinessNumeroDraftAsync
                },
                new()
                {
                    Key = "cancelar-whatsapp-business",
                    Label = "Cancelar",
                    Icon = "bi-x-circle",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = Saving,
                    OnClick = CancelBusinessNumeroEditAsync
                }
            ];
        }
        else if (editingApiNumero || editingRegla)
        {
            actions =
            [
                new()
                {
                    Key = "guardar-numero-api",
                    Label = Saving ? "Guardando..." : "Guardar",
                    Icon = "bi-floppy",
                    Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = Saving,
                    Busy = Saving,
                    OnClick = editingRegla
                        ? GuardarReglaAsync
                        : _addingApiNumero ? AddNumeroAsync : SaveApiNumeroDraftAsync
                },
                new()
                {
                    Key = "cancelar-numero-api",
                    Label = "Cancelar",
                    Icon = "bi-x-circle",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = Saving,
                    OnClick = () =>
                    {
                        if (editingRegla)
                            CancelarEdicionRegla();
                        else if (_addingApiNumero)
                            CancelAddApiNumero();
                        else
                            CancelApiNumeroEdit();
                        return Task.CompletedTask;
                    }
                }
            ];
        }
        else
        {
            var listActions = new List<PageHeaderAction>();
            if (onBusiness)
            {
                var selected = SelectedBusinessNumero;
                if (selected is not null && !IsPairingFlowVisible(selected))
                {
                    listActions.Add(new PageHeaderAction
                    {
                        Key = "editar-whatsapp-business",
                        Label = "Editar",
                        Icon = "bi-pencil",
                        Style = PageHeaderActionStyle.Ghost,
                        Priority = PageHeaderActionPriority.Essential,
                        Disabled = Loading || Saving || PairingBusy,
                        OnClick = StartBusinessNumeroEditAsync
                    });
                }

                if (selected is not null && !selected.IsWebSessionReady && !IsPairingFlowVisible(selected))
                {
                    listActions.Add(new PageHeaderAction
                    {
                        Key = "reconectar-whatsapp-business",
                        Label = "Reconectar",
                        Icon = "bi-arrow-repeat",
                        Style = PageHeaderActionStyle.Primary,
                        Priority = PageHeaderActionPriority.Essential,
                        Disabled = Loading || Saving || PairingBusy,
                        OnClick = () => OpenBusinessConnectionAsync(selected.IdNumero)
                    });
                }

                listActions.Add(new PageHeaderAction
                {
                    Key = "conectar-otro-whatsapp-business",
                    Label = selected is null ? "Conectar WhatsApp" : "Nueva sesión",
                    Icon = "bi-plus-circle",
                    Style = selected is null ? PageHeaderActionStyle.Primary : PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = Loading || Saving || PairingBusy,
                    OnClick = OpenNewBusinessConnectionAsync
                });

                if (selected is not null && (selected.IsWebSessionReady || !string.IsNullOrWhiteSpace(selected.WebInstanceName)))
                {
                    listActions.Add(new PageHeaderAction
                    {
                        Key = "cerrar-sesion-whatsapp-business",
                        Label = "Cerrar sesión",
                        Icon = "bi-box-arrow-right",
                        Style = PageHeaderActionStyle.Danger,
                        Priority = PageHeaderActionPriority.Overflow,
                        Disabled = PairingBusy || Saving,
                        OnClick = () => RequestStopWhatsAppWebSessionAsync(selected)
                    });
                }
            }
            else
            {
                if (_activePrimaryTab == "canales" && _activeChannelTab == "whatsapp" && _activeWhatsAppSection == "general")
                {
                    listActions.Add(new PageHeaderAction
                    {
                        Key = "nuevo-numero-api",
                        Label = "Nuevo número",
                        Icon = "bi-plus-circle",
                        Style = PageHeaderActionStyle.Primary,
                        Priority = PageHeaderActionPriority.Essential,
                        Disabled = Loading || Saving,
                        OnClick = StartAddApiNumero
                    });
                }
                listActions.Add(new PageHeaderAction
                {
                    Key = "recargar",
                    Label = "Recargar",
                    Icon = "bi-arrow-clockwise",
                    Style = PageHeaderActionStyle.Ghost,
                    Disabled = Loading,
                    OnClick = LoadAsync
                });
            }

            actions = listActions;
        }

        actions = [.. BuildHistoryActions(), .. actions];

        PageHeader.Set(new PageHeaderConfig
        {
            Title = GetContextToolbarTitle(),
            State = CurrentEditorMode switch
            {
                SettingsEditorMode.Create => PageHeaderState.Creating,
                SettingsEditorMode.Edit => PageHeaderState.Editing,
                _ => PageHeaderState.List
            },
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            RecordToolbar = IsWhatsAppBusinessView,
            ShowHistoryNavigation = false,
            TopNavigationItems = BuildTopNavigationItems(),
            OnBack = HeaderNavigation.CanGoBack
                ? () => RequestNavigationAsync(() =>
                {
                    HeaderNavigation.GoBack(Nav);
                    return Task.CompletedTask;
                })
                : null,
            OnForward = HeaderNavigation.CanGoForward
                ? () => RequestNavigationAsync(() =>
                {
                    HeaderNavigation.GoForward(Nav);
                    return Task.CompletedTask;
                })
                : null,
            Actions = actions
        });
    }

