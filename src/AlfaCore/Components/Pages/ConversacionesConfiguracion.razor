@page "/conversaciones/configuracion"
@page "/{idweb}/{idbase:int}/conversaciones/configuracion"
@inject AlfaCore.Services.IConversacionesConfigService ConfigSvc
@inject AlfaCore.Services.IConversacionesService ConvSvc
@inject AlfaCore.Services.IConversacionAsistenteService AsistenteSvc
@inject AlfaCore.Services.IWhatsAppWebSessionService WhatsAppWebSessionSvc
@inject AlfaCore.Services.IAnyDeskLocalSettingsService AnyDeskSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Configuración de canales | Alfa Gestión</PageTitle>

<section class="page-grid settings-page">
    <AlfaNotification Message="@WhatsAppFeedback" OnDismiss="DismissWhatsAppFeedback" />

    @if (_feedback is not null && _feedbackScope != "whatsapp")
    {
        <div class="conversations-inline @GetFeedbackClass(_feedback)">
            <strong>@_feedback.Title</strong>
            <div>@_feedback.Message</div>
            @if (_feedback.HasCode)
            {
                <div>Código: @_feedback.Code</div>
            }
            @if (_feedback.HasSuggestion)
            {
                <div>@_feedback.Suggestion</div>
            }
        </div>
    }

    <div class="settings-workspace">
        <nav class="settings-nav" aria-label="Secciones de Configuración">
            @foreach (var item in SettingsNavItems)
            {
                <button type="button" class="@GetPrimaryTabClass(item.Key)" @onclick="() => SelectPrimaryTab(item.Key)">
                    <i class="bi @item.Icon" aria-hidden="true"></i>
                    <span>@item.Label</span>
                </button>
            }
        </nav>

        <div class="settings-content">

    @if (_activePrimaryTab == "resumen")
    {
    <header class="settings-section-header">
        <h2>Resumen</h2>
        <p>Puntos de entrada a la configuración de Conversaciones. El detalle y el estado de cada canal viven dentro de su propia sección.</p>
    </header>
    <div class="settings-summary-grid">
        @foreach (var item in SettingsNavItems.Where(i => i.Key != "resumen"))
        {
            <button type="button" class="settings-summary-card" @onclick="() => SelectPrimaryTab(item.Key)">
                <i class="bi @item.Icon" aria-hidden="true"></i>
                <span class="settings-summary-card__label">@item.Label</span>
                <span class="settings-summary-card__hint">@item.Hint</span>
            </button>
        }
    </div>
    }

    @if (_activePrimaryTab == "canales")
    {
    <header class="settings-section-header">
        <h2>Canales</h2>
        <p>Elegí el canal para administrar su conexión, credenciales y webhook.</p>
    </header>
    <AlfaTabs Items="@_channelTabItems" ActiveKey="@_activeChannelTab" ActiveKeyChanged="@OnChannelTabChanged" AriaLabel="Canales" />
    }
    @if (_activePrimaryTab == "canales" && _activeChannelTab == "whatsapp")
    {
    <header class="settings-content-header">
        <h3>WhatsApp</h3>
    </header>
    <AlfaTabs Items="@_whatsAppSectionTabItems" ActiveKey="@_activeWhatsAppSection" ActiveKeyChanged="@OnWhatsAppSectionChanged" AriaLabel="WhatsApp Business o WhatsApp API" />

    @if (_activeWhatsAppSection == "numeros")
    {
        <p class="wa-content-lead">Conectá los números que usás para atender conversaciones.</p>
        <div class="wa-status-summary">
            <span class="wa-status-chip"><i class="bi bi-telephone-fill" aria-hidden="true"></i> @GetWhatsAppNumerosSummary()</span>
        </div>
    }
    else
    {
        <p class="wa-content-lead">Configuración avanzada para la integración oficial de WhatsApp (Meta Cloud API).</p>
        <div class="wa-status-summary">
            <span class="@GetWhatsAppApiStatusChipClass(_config.IsConfiguredForSend)"><i class="bi bi-circle-fill" aria-hidden="true"></i> API: @GetStatusLabel(_config.IsConfiguredForSend)</span>
            <span class="@GetWhatsAppApiStatusChipClass(_config.IsConfiguredForVerify)"><i class="bi bi-circle-fill" aria-hidden="true"></i> Webhook: @GetStatusLabel(_config.IsConfiguredForVerify)</span>
            <span class="@GetWhatsAppApiStatusChipClass(_config.IsReadyForMetaSetup)"><i class="bi bi-circle-fill" aria-hidden="true"></i> @GetPublicationLabel()</span>
        </div>
    }

    @if (_activeWhatsAppSection == "general")
    {
    <div class="wa-layout">
            <section class="wa-panel">
                <details class="wa-settings-section" open>
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-diagram-3 wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">Conexión</span>
                        <span class="wa-settings-section__hint">Modo del canal, proveedor y datos de identificación en Meta.</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        <p class="wa-field-note">@GetWhatsAppProviderSummary() La integración productiva actual sigue siendo Meta Cloud API; la sesión de WhatsApp Business queda configurada por separado para no mezclar credenciales ni webhook.</p>

                        <div class="wa-fields">
                            <AlfaSelect Label="Modo del canal" Options="@_providerModeOptions" @bind-Value="_config.ProviderMode" />
                            <AlfaSelect Label="Proveedor predeterminado" Options="@_defaultProviderOptions" @bind-Value="_config.DefaultProvider" />
                            <AlfaInput Label="Phone Number ID" @bind-Value="_config.PhoneNumberId" Placeholder="Ej. 123456789012345" />
                            <AlfaInput Label="WhatsApp Business Account ID" @bind-Value="_config.BusinessAccountId" Placeholder="Ej. 109876543210987" />
                        </div>
                    </div>
                </details>

                <details class="wa-settings-section">
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-key-fill wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">Credenciales</span>
                        <span class="wa-settings-section__hint">Access Token, Verify Token y App Secret de Meta.</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        <p class="wa-field-note">@GetWhatsAppMetaSummary()</p>

                        <div class="wa-field wa-fields__full">
                            <label class="wa-field__label" for="wa-access-token">Access Token</label>
                            <textarea id="wa-access-token" class="wa-textarea" rows="4" @bind="_config.AccessToken" placeholder="Pegá acá el token permanente o del sistema"></textarea>
                        </div>

                        <div class="wa-fields">
                            <AlfaInput Label="Verify Token" @bind-Value="_config.VerifyToken" Placeholder="Texto secreto que definís vos" />
                            <AlfaInput Label="App Secret" @bind-Value="_config.AppSecret" Placeholder="Opcional por ahora, recomendado para firma" />
                        </div>
                    </div>
                </details>

                <details class="wa-settings-section">
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-hdd-network wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">Webhook</span>
                        <span class="wa-settings-section__hint">Base pública, versión de Graph API y callback a informar en Meta.</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        <div class="wa-fields">
                            <AlfaInput Label="Base pública HTTPS" @bind-Value="_config.PublicBaseUrl" Placeholder="@_suggestedBaseUrl" />
                            <AlfaInput Label="Versión Graph API" @bind-Value="_config.ApiVersion" Placeholder="v22.0" />
                        </div>

                        <div class="wa-field wa-fields__full">
                            <label class="wa-field__label" for="wa-webhook-path">Webhook interno</label>
                            <input id="wa-webhook-path" class="wa-input-readonly" value="@_config.WebhookPath" readonly />
                        </div>

                        <p class="wa-field-note"><strong>Callback a informar en Meta:</strong> @GetWebhookUrlPreview()</p>
                        <p class="wa-field-note">
                            Routing por base:
                            @if (HasWebhookToken)
                            {
                                <text>configurado — los mensajes entrantes se identifican sin depender de la sesión activa.</text>
                            }
                            else
                            {
                                <text>sin token propio todavía — no usar este callback en producción SaaS hasta generarlo.</text>
                            }
                        </p>
                        <p class="wa-field-note">@GetWhatsAppWebOverviewSummary() La sesión por QR se administra por número en la pestaña "WhatsApp Business".</p>
                    </div>
                </details>

                <details class="wa-settings-section" open>
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-cloud-check wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">Números Meta Cloud API</span>
                        <span class="wa-settings-section__hint">@WhatsAppApiNumeros.Count()</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        @if (!WhatsAppApiNumeros.Any())
                        {
                            <p class="wa-field-note">Todavía no hay números Meta Cloud API cargados para esta base.</p>
                        }
                        @foreach (var numero in WhatsAppApiNumeros)
                        {
                            <div class="wa-number-card">
                                <div class="wa-number-card__header">
                                    <div>
                                        <strong class="wa-number-card__name">@GetNumeroDisplayName(numero)</strong>
                                        <span class="wa-number-card__phone">@numero.PhoneNumberId</span>
                                    </div>
                                </div>
                                <div class="wa-number-card__status">
                                    <AlfaTag Tone="AlfaTagTone.Success">Meta Cloud API</AlfaTag>
                                    @if (IsConfiguredGlobalApiNumero(numero))
                                    {
                                        <AlfaTag Tone="AlfaTagTone.Neutral">API global</AlfaTag>
                                    }
                                    @if (!numero.Activo)
                                    {
                                        <AlfaTag Tone="AlfaTagTone.Warning">Inactivo visible por historial/asignación</AlfaTag>
                                    }
                                    @if (numero.Usuarios.Count == 0)
                                    {
                                        <AlfaTag Tone="AlfaTagTone.Warning">Sin usuarios asignados</AlfaTag>
                                    }
                                    else
                                    {
                                        <AlfaTag Tone="AlfaTagTone.Neutral">@numero.Usuarios.Count usuario(s)</AlfaTag>
                                    }
                                </div>

                                <details class="wa-settings-section" open="@(!numero.Usuarios.Any())">
                                    <summary class="wa-settings-section__summary">
                                        <span class="wa-settings-section__title">Usuarios con acceso</span>
                                        <span class="wa-settings-section__hint">@numero.Usuarios.Count</span>
                                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="wa-settings-section__body">
                                        <div class="wa-user-grid">
                                            @foreach (var usuario in _usuariosSistema)
                                            {
                                                <AlfaCheckbox Value="@numero.Usuarios.Contains(usuario.Nombre, StringComparer.OrdinalIgnoreCase)"
                                                              ValueChanged="@(v => ToggleNumeroUsuario(numero, usuario.Nombre, v ?? false))">
                                                    @usuario.Nombre
                                                </AlfaCheckbox>
                                            }
                                            @if (_usuariosSistema.Count == 0)
                                            {
                                                <span class="wa-field-note">No hay usuarios activos en este sistema.</span>
                                            }
                                        </div>
                                        <div class="actions">
                                            <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-floppy-fill" Disabled="@(Loading || Saving)" OnClick="@(() => SaveNumeroAsync(numero))">Guardar usuarios</AlfaButton>
                                        </div>
                                    </div>
                                </details>

                                <details class="wa-settings-section">
                                    <summary class="wa-settings-section__summary">
                                        <span class="wa-settings-section__title">Datos del número</span>
                                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="wa-settings-section__body">
                                        <div class="wa-fields">
                                            <AlfaInput Label="Nombre" @bind-Value="numero.Nombre" Placeholder="Ej: Ventas Norte" />
                                            <AlfaInput Label="Phone Number ID" @bind-Value="numero.PhoneNumberId" Placeholder="Ej: 109876543210" />
                                        </div>
                                        <div class="actions">
                                            <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-floppy-fill" Disabled="@(Loading || Saving)" OnClick="@(() => SaveNumeroAsync(numero))">Guardar número</AlfaButton>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        }
                    </div>
                </details>

                <details class="wa-settings-section">
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-plus-circle wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">Números por Phone Number ID</span>
                        <span class="wa-settings-section__hint">Para multinúmero configurado directamente contra Meta Cloud API.</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        <p class="wa-field-note">Los números conectados por QR se administran en la pestaña "WhatsApp Business". Usá esto solo si necesitás registrar un número identificado por su <code>Phone Number ID</code> técnico de Meta.</p>
                        <div class="wa-fields">
                            <AlfaInput Label="Nombre del número nuevo" @bind-Value="_nuevoNumero.Nombre" Placeholder="Ej: Ventas Sur" />
                            <AlfaInput Label="Phone Number ID" @bind-Value="_nuevoNumero.PhoneNumberId" Placeholder="Ej: 109876543211" />
                        </div>
                        <div class="actions">
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-plus-circle" Disabled="@(Loading || Saving)" OnClick="AddNumeroAsync">Agregar número</AlfaButton>
                        </div>
                    </div>
                </details>

                <div class="actions">
                    <AlfaButton Icon="bi bi-floppy-fill" Disabled="@(Loading || Saving)" OnClick="SaveAsync">Guardar configuración</AlfaButton>
                </div>
            </section>

            <aside class="wa-help">
                <details class="wa-settings-section">
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-question-circle wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">¿Necesitás ayuda para configurar Meta Cloud API?</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        <ol class="conv-config-steps">
                            <li>Crear o usar una app tipo negocio en Meta for Developers y agregar el producto WhatsApp.</li>
                            <li>Obtener el <code>Phone Number ID</code> del número que vas a conectar.</li>
                            <li>Obtener el <code>WhatsApp Business Account ID</code> de la cuenta de negocio.</li>
                            <li>Generar un <code>Access Token</code> válido para el envío de mensajes.</li>
                            <li>Definir un <code>Verify Token</code> propio y cargar la URL pública del webhook en Meta.</li>
                            <li>Suscribir el webhook al menos a eventos de mensajes y estados.</li>
                            <li>Probar verificación, envío y recepción antes de pasar a producción.</li>
                        </ol>
                    </div>
                </details>

                <details class="wa-settings-section">
                    <summary class="wa-settings-section__summary">
                        <i class="bi bi-info-circle wa-settings-section__icon" aria-hidden="true"></i>
                        <span class="wa-settings-section__title">Información técnica</span>
                        <i class="bi bi-chevron-down wa-settings-section__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="wa-settings-section__body">
                        <p class="wa-field-note">Fuente: <code>TA_CONFIGURACION</code> (@DisplaySource(_config.ConfigSource)). Claves: <code>CONV_WHATSAPP_*</code>.</p>
                        <p class="wa-field-note">Manual interno: <code>docs/conversaciones_whatsapp_conexion.md</code>.</p>
                    </div>
                </details>
            </aside>
    </div>
    }
    }

    @if (_activePrimaryTab == "canales" && _activeChannelTab == "instagram")
    {
    <div class="conv-config-layout">
            <section class="panel-card conv-config-form conv-config-form--instagram">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title"><i class="bi bi-instagram"></i> Instagram</h3>
                        <p class="panel-card__subtitle">Origen actual: @DisplaySource(_instagramConfig.ConfigSource)</p>
                    </div>
                    <span class="panel-card__tag">CONV_INSTAGRAM_*</span>
                </div>

                <div class="conv-config-status-grid">
                    <article class="context-card">
                        <span class="context-card__label">Envío Messaging API</span>
                        <strong class="@GetStatusClass(_instagramConfig.IsConfiguredForSend)">@GetStatusLabel(_instagramConfig.IsConfiguredForSend)</strong>
                        <span class="context-card__muted">Requiere <code>access token</code> e <code>instagram account id</code>.</span>
                    </article>
                    <article class="context-card">
                        <span class="context-card__label">Webhook</span>
                        <strong class="@GetStatusClass(_instagramConfig.IsConfiguredForVerify)">@GetStatusLabel(_instagramConfig.IsConfiguredForVerify)</strong>
                        <span class="context-card__muted">Requiere <code>verify token</code> y URL pública HTTPS.</span>
                    </article>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="ig-public-url">Base pública HTTPS</label>
                        <input id="ig-public-url" @bind="_instagramConfig.PublicBaseUrl" placeholder="@_suggestedBaseUrl" />
                    </div>

                    <div class="field">
                        <label for="ig-api-version">Versión Graph API</label>
                        <input id="ig-api-version" @bind="_instagramConfig.ApiVersion" placeholder="v22.0" />
                    </div>

                    <div class="field">
                        <label for="ig-app-id">App ID</label>
                        <input id="ig-app-id" @bind="_instagramConfig.AppId" placeholder="App ID de Meta" />
                    </div>

                    <div class="field">
                        <label for="ig-page-id">Facebook Page ID</label>
                        <input id="ig-page-id" @bind="_instagramConfig.FacebookPageId" placeholder="Página vinculada a Instagram" />
                    </div>

                    <div class="field">
                        <label for="ig-account-id">Instagram Account ID</label>
                        <input id="ig-account-id" @bind="_instagramConfig.InstagramAccountId" placeholder="Cuenta profesional de Instagram" />
                    </div>

                    <div class="field">
                        <label for="ig-verify-token">Verify Token</label>
                        <input id="ig-verify-token" @bind="_instagramConfig.VerifyToken" placeholder="Texto secreto que definís vos" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ig-access-token">Access Token</label>
                        <textarea id="ig-access-token" rows="4" @bind="_instagramConfig.AccessToken" placeholder="Token de página u OAuth con permisos de Instagram Messaging"></textarea>
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ig-app-secret">App Secret</label>
                        <input id="ig-app-secret" @bind="_instagramConfig.AppSecret" placeholder="App Secret de Meta" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ig-webhook-path">Webhook interno</label>
                        <input id="ig-webhook-path" value="@_instagramConfig.WebhookPath" readonly />
                    </div>
                </div>

                <div class="context-card">
                    <span class="context-card__label">URL de callback a informar en Meta</span>
                    <strong>@GetInstagramWebhookUrlPreview()</strong>
                    <span class="context-card__muted">
                        El endpoint queda preparado para la siguiente etapa de recepción y envío de mensajes.
                        @GetWebhookTenantHelp("los mensajes de Instagram")
                    </span>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveInstagramAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar Instagram
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Credenciales Meta</h3>
                        <p class="panel-card__subtitle">Resumen de lo que tenés que conseguir.</p>
                    </div>
                    <span class="panel-card__tag">Instagram</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Usar una cuenta Instagram profesional vinculada a una página de Facebook.</li>
                    <li>Crear una app en Meta for Developers y agregar Instagram/Messaging según el flujo elegido.</li>
                    <li>Configurar el webhook con la URL pública de AlfaCore y el verify token.</li>
                    <li>Solicitar permisos de mensajería para producción mediante App Review.</li>
                    <li>Guardar en AlfaCore el token, la cuenta de Instagram y la página asociada.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Guía interna</span>
                    <strong><code>docs/modulos/conversaciones_instagram_meta.md</code></strong>
                    <span class="context-card__muted">Incluye el paso a paso para crear la app y pedir permisos.</span>
                </div>
            </aside>
    </div>
    }

    @if (_activePrimaryTab == "canales" && _activeChannelTab == "facebook")
    {
    <div class="conv-config-layout">
            <section class="panel-card conv-config-form conv-config-form--facebook">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title"><i class="bi bi-facebook"></i> Facebook Messenger</h3>
                        <p class="panel-card__subtitle">Origen actual: @DisplaySource(_facebookConfig.ConfigSource)</p>
                    </div>
                    <span class="panel-card__tag">CONV_FACEBOOK_*</span>
                </div>

                <div class="conv-config-status-grid">
                    <article class="context-card">
                        <span class="context-card__label">Envío Messenger API</span>
                        <strong class="@GetStatusClass(_facebookConfig.IsConfiguredForSend)">@GetStatusLabel(_facebookConfig.IsConfiguredForSend)</strong>
                        <span class="context-card__muted">Requiere <code>page access token</code> y <code>page id</code>.</span>
                    </article>
                    <article class="context-card">
                        <span class="context-card__label">Webhook</span>
                        <strong class="@GetStatusClass(_facebookConfig.IsConfiguredForVerify)">@GetStatusLabel(_facebookConfig.IsConfiguredForVerify)</strong>
                        <span class="context-card__muted">Requiere <code>verify token</code>, App Secret y URL pública HTTPS.</span>
                    </article>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="fb-public-url">Base pública HTTPS</label>
                        <input id="fb-public-url" @bind="_facebookConfig.PublicBaseUrl" placeholder="@_suggestedBaseUrl" />
                    </div>

                    <div class="field">
                        <label for="fb-api-version">Versión Graph API</label>
                        <input id="fb-api-version" @bind="_facebookConfig.ApiVersion" placeholder="v22.0" />
                    </div>

                    <div class="field">
                        <label for="fb-app-id">App ID</label>
                        <input id="fb-app-id" @bind="_facebookConfig.AppId" placeholder="App ID de Meta" />
                    </div>

                    <div class="field">
                        <label for="fb-page-id">Facebook Page ID</label>
                        <input id="fb-page-id" @bind="_facebookConfig.PageId" placeholder="ID de la página" />
                    </div>

                    <div class="field">
                        <label for="fb-page-username">Usuario o slug de página</label>
                        <input id="fb-page-username" @bind="_facebookConfig.PageUsername" placeholder="Ej. mi.pagina" />
                    </div>

                    <div class="field">
                        <label for="fb-verify-token">Verify Token</label>
                        <input id="fb-verify-token" @bind="_facebookConfig.VerifyToken" placeholder="Texto secreto que definís vos" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="fb-access-token">Page Access Token</label>
                        <textarea id="fb-access-token" rows="4" @bind="_facebookConfig.AccessToken" placeholder="Token de página con permisos de Messenger"></textarea>
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="fb-app-secret">App Secret</label>
                        <input id="fb-app-secret" @bind="_facebookConfig.AppSecret" placeholder="App Secret de Meta" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="fb-webhook-path">Webhook interno</label>
                        <input id="fb-webhook-path" value="@_facebookConfig.WebhookPath" readonly />
                    </div>
                </div>

                <div class="context-card">
