    private IReadOnlyList<PageHeaderTopNavItem> BuildTopNavigationItems()
    {
        var items = new List<PageHeaderTopNavItem>
        {
            BuildProtectedTopNavItem("conversaciones", "Conversaciones", "/conversaciones")
        };

        if (!IsDirectMode)
        {
            items.Add(BuildProtectedTopNavItem("contactos", "Contactos", "/contactos"));
            items.Add(BuildProtectedTopNavItem("clientes", "Clientes", "/clientes"));
        }

        items.Add(BuildProtectedTopNavItem("plantillas", "Plantillas", "/conversaciones/plantillas"));
        items.Add(new() { Key = "configuracion", Label = "Configuración", Url = RouteContext.BuildRoute("/conversaciones/configuracion"), Active = true });
        items.Add(BuildProtectedTopNavItem("estadisticas", "Estadísticas", "/conversaciones/estadisticas"));
        items.Add(BuildProtectedTopNavItem("informes", "Informes", "/conversaciones/informes"));

        return items;
    }

    private PageHeaderTopNavItem BuildProtectedTopNavItem(string key, string label, string route)
    {
        var url = RouteContext.BuildRoute(route);
        return new PageHeaderTopNavItem
        {
            Key = key,
            Label = label,
            Url = url,
            OnClick = () => RequestNavigationAsync(() =>
            {
                Nav.NavigateTo(url);
                return Task.CompletedTask;
            })
        };
    }

    private async Task LoadWebhookTokenAsync()
    {
        if (!AppMode.IsSaaSMode)
        {
            return;
        }

        var idBase = SessionSvc.GetActiveSession()?.BaseId;
        if (idBase is null or 0)
        {
            return;
        }

        var result = await UiOps.RunAsync(
            () => CentralBasesSvc.GetByIdAsync(idBase.Value),
            "No se pudo consultar el token de webhook de esta base.");

        if (result.Success)
        {
            _webhookToken = result.Value?.WebhookToken;
        }
    }

    /// <summary>
    /// URL de webhook propia de esta base (con token). Cada base necesita la suya para que un
    /// webhook entrante pueda resolver a qué cliente pertenece sin depender de ninguna sesión —
    /// ver TryResolveWebhookTenantAsync en Program.cs.
    /// </summary>
    private string? BuildTokenizedWebhookUrl(string basePath)
        => string.IsNullOrWhiteSpace(_webhookToken) ? null : $"{basePath}/{_webhookToken}";

    private Task SelectPrimaryTab(string tab)
        => RequestNavigationAsync(() =>
        {
            var category = SettingsNavItems.First(item => item.Key == tab);
            NavigateToSettingsState(category.Key, category.Children.FirstOrDefault()?.Key);
            return Task.CompletedTask;
        });

    private void ApplyPrimaryTab(string tab)
    {
        var wasActive = string.Equals(_activePrimaryTab, tab, StringComparison.OrdinalIgnoreCase);
        _activePrimaryTab = tab;
        var category = SettingsNavItems.First(x => x.Key == tab);
        if (category.Children.Count > 0)
        {
            if (wasActive && _expandedSettingsCategories.Contains(tab))
                _expandedSettingsCategories.Remove(tab);
            else
                _expandedSettingsCategories.Add(tab);

            if (!wasActive || string.IsNullOrWhiteSpace(GetActiveSecondaryTab()))
                SelectSecondaryTabState(tab, category.Children[0].Key);
        }
        if (tab != "canales")
            _feedbackScope = null;

        SyncWhatsAppPollingWithNavigation();
        UpdatePageHeader();
    }

    private Task SelectSecondaryTab(string category, string subsection)
        => RequestNavigationAsync(() =>
        {
            NavigateToSettingsState(category, subsection);
            return Task.CompletedTask;
        });

    private void NavigateToSettingsState(string category, string? subsection)
    {
        if (string.IsNullOrWhiteSpace(subsection))
            ApplyPrimaryTab(category);
        else
            ApplySecondaryTab(category, subsection);

        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["seccion"] = category,
            ["subseccion"] = string.IsNullOrWhiteSpace(subsection) ? null : subsection,
            ["canal"] = null,
            ["onboarding"] = null
        });

        if (string.Equals(uri, Nav.Uri, StringComparison.Ordinal))
            return;

        _internalNavigationUri = uri;
        Nav.NavigateTo(uri, forceLoad: false);
    }

    private void ApplySecondaryTab(string category, string subsection)
    {
        _activePrimaryTab = category;
        _expandedSettingsCategories.Add(category);
        SelectSecondaryTabState(category, subsection);
        if (category != "canales")
            _feedbackScope = null;

        SyncWhatsAppPollingWithNavigation();
        UpdatePageHeader();
    }

    private void SelectSecondaryTabState(string category, string subsection)
    {
        _activeSecondaryTab = subsection;
        if (category != "canales")
            return;

        switch (subsection)
        {
            case "whatsapp-business":
                _activeChannelTab = "whatsapp";
                _activeWhatsAppSection = "numeros";
                break;
            case "whatsapp-api":
                _activeChannelTab = "whatsapp";
                _activeWhatsAppSection = "general";
                break;
            default:
                _activeChannelTab = subsection;
                break;
        }
    }

    private SettingsEditorMode CurrentEditorMode
        => _addingApiNumero || (_reglaEsNueva && _reglaEdicion is not null) || (IsWhatsAppBusinessView && _connectMethodPromptForIdNumero == 0)
            ? SettingsEditorMode.Create
            : _apiNumeroDraft is not null || _businessNumeroDraft is not null || _reglaEdicion is not null
                ? SettingsEditorMode.Edit
                : SettingsEditorMode.Read;

    private bool IsWhatsAppBusinessView
        => _activePrimaryTab == "canales"
           && _activeChannelTab == "whatsapp"
           && _activeWhatsAppSection == "numeros";

    private bool IsEditingBusinessNumero
        => IsWhatsAppBusinessView && _businessNumeroDraft is not null;

    private bool IsBusinessConnectFlowActive
        => _connectMethodPromptForIdNumero.HasValue
           || (SelectedBusinessNumero is { } numero && IsPairingFlowActive(numero.IdNumero));

    private bool HasUnsavedChanges
        => (_apiNumeroDraft is not null && SelectedApiNumero is not null && !WhatsAppNumeroEquals(_apiNumeroDraft, SelectedApiNumero))
           || (_businessNumeroDraft is not null && SelectedBusinessNumero is not null && !WhatsAppNumeroEquals(_businessNumeroDraft, SelectedBusinessNumero))
           || (_addingApiNumero && !WhatsAppNumeroEquals(_nuevoNumero, new ConversacionWhatsAppNumeroDto { Activo = true }))
           || (_reglaEdicion is not null && _reglaOriginal is not null && !ReglaEquals(_reglaEdicion, _reglaOriginal))
           || IsAdministradoresDirty
           || IsAutomatizacionesDirty;

    private bool IsAdministradoresDirty
        => !_administradores.OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .SequenceEqual(_administradoresOriginal.OrderBy(x => x, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase);

    private bool IsAutomatizacionesDirty
        => !AutomatizacionesEquals(_automatizacionesConfig, _automatizacionesOriginal);

    private async Task RequestNavigationAsync(Func<Task> navigation)
    {
        if (!HasUnsavedChanges)
        {
            DiscardCurrentEditor();
            await navigation();
            return;
        }

        _pendingNavigation = navigation;
        _discardChangesDialogOpen = true;
    }

    private async Task ConfirmPendingNavigationAsync()
    {
        var navigation = _pendingNavigation;
        _pendingNavigation = null;
        _discardChangesDialogOpen = false;
        DiscardCurrentEditor();
        if (navigation is not null)
            await navigation();
    }

    private void KeepEditing()
    {
        _pendingNavigation = null;
        _discardChangesDialogOpen = false;
    }

    private void DiscardCurrentEditor()
    {
        _apiNumeroDraft = null;
        _businessNumeroDraft = null;
        _addingApiNumero = false;
        _nuevoNumero = new ConversacionWhatsAppNumeroDto { Activo = true };
        _reglaEdicion = null;
        _reglaOriginal = null;
        _reglaEsNueva = false;
        _administradores = CloneAdministradores(_administradoresOriginal);
        _automatizacionesConfig = CloneAutomatizaciones(_automatizacionesOriginal);
        UpdatePageHeader();
    }

    private void SelectChannelTab(string tab)
    {
        _activePrimaryTab = "canales";
        _expandedSettingsCategories.Add("canales");
        _activeChannelTab = tab;
        _activeSecondaryTab = GetActiveSecondaryTab();
        if (tab != "whatsapp")
            _feedbackScope = null;

        SyncWhatsAppPollingWithNavigation();
        UpdatePageHeader();
    }

    private Task OnChannelTabChanged(string? tab)
    {
        SelectChannelTab(tab ?? "whatsapp");
        return Task.CompletedTask;
    }

    /// <summary>
    /// El polling de QR/pairing sólo debe correr en segundo plano mientras el usuario está
    /// efectivamente mirando WhatsApp Business (Canales > WhatsApp > WhatsApp Business). Al salir
    /// de esa vista se detiene (no seguir generando QR fuera de pantalla); al volver, se retoma
    /// sólo si hay un pairing propio de esta sesión todavía pendiente y sin error terminal.
    /// </summary>
    private void SyncWhatsAppPollingWithNavigation()
    {
        var onNumerosView = _activePrimaryTab == "canales"
            && _activeChannelTab == "whatsapp"
            && _activeWhatsAppSection == "numeros";

        if (!onNumerosView)
        {
            StopPolling();
            return;
        }

        ResumePollingIfPairingActive();
    }

    /// <summary>

    private void ResumePollingIfPairingActive()
    {
        if (_pollingCts is not null)
            return;

        foreach (var idNumero in _pairingFlowActiveIds)
        {
            if (idNumero == _pairingRegenerateErrorForIdNumero)
                continue;

            var numero = _numeros.FirstOrDefault(n => n.IdNumero == idNumero);
            if (numero is null || numero.IsWebSessionReady)
                continue;

            StartPolling(numero);
            return;
        }
    }

    private Task OnWhatsAppSectionChanged(string? section)
    {
        _activeWhatsAppSection = section ?? "numeros";
        _activeSecondaryTab = GetActiveSecondaryTab();
        SyncWhatsAppPollingWithNavigation();
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private bool EnsureSaaSWebhookTokenReady()
    {
        if (!AppMode.IsSaaSMode || HasWebhookToken)
            return true;

        _feedback = new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Warning,
            Title = "Token de webhook requerido",
            Message = "Seleccioná una base activa y recargá la pantalla para generar el token propio antes de guardar la configuración del canal.",
            Suggestion = "En SaaS, Meta y Mercado Libre deben usar la URL con token para que AlfaCore identifique el cliente/base sin depender de una sesión."
        };
        return false;
    }

    private string GetWebhookTenantHelp(string subject)
        => HasWebhookToken
            ? $"La URL mostrada incluye el token propio de esta base; {subject} se enrutan sin depender de la sesión activa."
            : $"Falta el token propio de esta base. En SaaS no configures este callback: {subject} podrían ir a la base por defecto.";

    private async Task LoadAsync()
    {
        Loading = true;
        UpdatePageHeader();
        _feedback = null;
        _feedbackScope = null;

        var result = await UiOps.RunAsync(
            () => ConfigSvc.GetWhatsAppConfigAsync(),
            "No se pudo cargar la configuración de WhatsApp.");

        if (result.Success && result.Value is not null)
        {
            _config = result.Value;
            EnsureDefaults();
        }
        else
        {
            EnsureDefaults();
            _feedback = result.Feedback;
        }

        var instagramResult = await UiOps.RunAsync(
            () => ConfigSvc.GetInstagramConfigAsync(),
            "No se pudo cargar la configuración de Instagram.");

        if (instagramResult.Success && instagramResult.Value is not null)
        {
            _instagramConfig = instagramResult.Value;
            EnsureInstagramDefaults();
        }
        else
        {
            EnsureInstagramDefaults();
            _feedback ??= instagramResult.Feedback;
        }

        var facebookResult = await UiOps.RunAsync(
            () => ConfigSvc.GetFacebookConfigAsync(),
            "No se pudo cargar la configuración de Facebook.");

        if (facebookResult.Success && facebookResult.Value is not null)
        {
            _facebookConfig = facebookResult.Value;
            EnsureFacebookDefaults();
        }
        else
        {
            EnsureFacebookDefaults();
            _feedback ??= facebookResult.Feedback;
        }

        var mercadoLibreResult = await UiOps.RunAsync(
            () => ConfigSvc.GetMercadoLibreConfigAsync(),
            "No se pudo cargar la configuración de Mercado Libre.");

        if (mercadoLibreResult.Success && mercadoLibreResult.Value is not null)
        {
            _mercadoLibreConfig = mercadoLibreResult.Value;
            EnsureMercadoLibreDefaults();
        }
        else
        {
            EnsureMercadoLibreDefaults();
            _feedback ??= mercadoLibreResult.Feedback;
        }

        var alfaKnowledgeResult = await UiOps.RunAsync(
            () => ConfigSvc.GetAlfaKnowledgeConfigAsync(),
            "No se pudo cargar la configuración de AlfaKnowledge.");

        if (alfaKnowledgeResult.Success && alfaKnowledgeResult.Value is not null)
        {
            _alfaKnowledgeConfig = alfaKnowledgeResult.Value;
            EnsureAlfaKnowledgeDefaults();
        }
        else
        {
            EnsureAlfaKnowledgeDefaults();
            _feedback ??= alfaKnowledgeResult.Feedback;
        }

        var automatizacionesResult = await UiOps.RunAsync(
            () => ConfigSvc.GetAutomatizacionesConfigAsync(),
            "No se pudo cargar la configuración de automatizaciones.");

        if (automatizacionesResult.Success && automatizacionesResult.Value is not null)
        {
            _automatizacionesOriginal = CloneAutomatizaciones(automatizacionesResult.Value);
            _automatizacionesConfig = CloneAutomatizaciones(automatizacionesResult.Value);
        }
        else
        {
            _feedback ??= automatizacionesResult.Feedback;
        }

        var clasificacionesResult = await UiOps.RunAsync(
            () => ConfigSvc.GetClasificacionesAsync(),
            "No se pudieron cargar las clasificaciones de clientes.");

        if (clasificacionesResult.Success && clasificacionesResult.Value is not null)
        {
            _clasificaciones = clasificacionesResult.Value;
        }
        else
        {
            _feedback ??= clasificacionesResult.Feedback;
        }

        var prioridadResult = await UiOps.RunAsync(
            () => ConfigSvc.GetPrioridadConfigAsync(),
            "No se pudo cargar la configuración de prioridad de atención.");

        if (prioridadResult.Success && prioridadResult.Value is not null)
        {
            _prioridadConfig = prioridadResult.Value;
        }
        else
        {
            _feedback ??= prioridadResult.Feedback;
        }

        var usuariosResult = await UiOps.RunAsync(
            () => ConfigSvc.GetUsuariosSistemaAsync(),
            "No se pudieron cargar los usuarios del sistema.");

        if (usuariosResult.Success && usuariosResult.Value is not null)
        {
            _usuariosSistema = usuariosResult.Value;
        }
        else
        {
            _feedback ??= usuariosResult.Feedback;
        }

        await LoadNumerosAsync();

