    private async Task GenerateWhatsAppWebPairingAsync(ConversacionWhatsAppNumeroDto numero)
    {
        _feedbackScope = "whatsapp";
        if (numero.IdNumero <= 0)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Guardá primero el número",
                Message = "Antes de generar el QR, primero guardá este número para crear su sesión propia."
            };
            return;
        }

        PairingBusy = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => WhatsAppWebSessionSvc.StartSessionAsync(numero.IdNumero, _includeTextPairingCode),
            "No se pudo iniciar la sesión real de WhatsApp Web.");

        if (result.Success && result.Value is not null)
        {
            ReplaceNumero(result.Value);
            _feedback = AppUiMessage.Success(
                "Sesión Web iniciada",
                $"'{result.Value.Nombre}' ya tiene disponible su QR o código temporal según el modo elegido.");
            StartPolling(result.Value);
        }
        else
        {
            _feedback = result.Feedback;

            // StartSessionAsync puede fallar antes de tocar el worker (ej. "no existe el worker de
            // WhatsApp Web") -- en ese caso no corrió ni PrepareSessionDirectory ni escribió
            // status.json nuevo, así que no hay proceso real detrás. Si igual quedó un
            // WebSessionStatus=PendingQr de un intento anterior, la tarjeta mostraría "Esperando
            // escaneo" con la acción "Conectar WhatsApp" ya deshabilitada visualmente por error,
            // sin ningún pairing activo de verdad. Se corrige el estado mostrado (no se toca auth,
            // credenciales ni el registro del número) para que el usuario pueda reintentar.
            _pairingFlowActiveIds.Remove(numero.IdNumero);
            if (numero.WebSessionStatus == ConversacionWhatsAppWebSessionStatuses.PendingQr)
            {
                numero.WebSessionStatus = ConversacionWhatsAppWebSessionStatuses.Disconnected;
            }
        }

        PairingBusy = false;
    }

