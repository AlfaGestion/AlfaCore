    // Criterio UI vigente: Business = Web/QR; API = Meta Cloud API por Phone Number ID.
    private IEnumerable<ConversacionWhatsAppNumeroDto> ActiveBusinessNumeros => _numeros.Where(n => n.Activo && IsWhatsAppWebManagedNumero(n));
    private IEnumerable<ConversacionWhatsAppNumeroDto> WhatsAppApiNumeros
