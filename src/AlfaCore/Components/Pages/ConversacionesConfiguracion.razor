    private string GetContextToolbarTitle()
    {
        if (_activePrimaryTab == "resumen")
            return "Conversaciones · Configuración";

        var category = SettingsNavItems.FirstOrDefault(x => x.Key == _activePrimaryTab);
        var subsection = category?.Children.FirstOrDefault(x => x.Key == GetActiveSecondaryTab());
        var context = subsection?.Label ?? category?.Label ?? "Configuración";

        if (_activePrimaryTab == "canales" && GetActiveSecondaryTab() == "whatsapp-api" && SelectedApiNumero is not null)
            return $"{context} · {GetNumeroDisplayName(SelectedApiNumero)}";

        if (IsWhatsAppBusinessView && _connectMethodPromptForIdNumero == 0)
            return "WhatsApp Business · Conectar";

        if (IsWhatsAppBusinessView && _connectMethodPromptForIdNumero > 0 && SelectedBusinessNumero is not null)
            return $"WhatsApp Business · Reconectar {GetNumeroDisplayName(SelectedBusinessNumero)}";

        if (IsWhatsAppBusinessView && SelectedBusinessNumero is not null)
        {
            var prefix = _businessNumeroDraft is null ? string.Empty : "Editar ";
            return $"WhatsApp Business · {prefix}{GetNumeroDisplayName(SelectedBusinessNumero)}";
        }

        return subsection is null || category is null
            ? context
            : $"{category.Label} · {context}";
    }

