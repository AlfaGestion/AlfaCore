            _mercadoLibreConfig.SiteId = "MLA";
    }

    private void EnsureAlfaKnowledgeDefaults()
    {
        if (_alfaKnowledgeConfig.TimeoutSeconds <= 0)
            _alfaKnowledgeConfig.TimeoutSeconds = 15;
    }

    private string GetCurrentBaseUrl()
    {
        if (!Uri.TryCreate(Nav.BaseUri, UriKind.Absolute, out var uri))
            return string.Empty;

        return $"{uri.Scheme}://{uri.Authority}";
    }

