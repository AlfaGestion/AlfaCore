            return Task.CompletedTask;
        });

    private void ApplyNuevaRegla()
    {
        _reglaEsNueva = true;
        _reglaEdicion = new ConversacionReglaDto
        {
            Nombre = string.Empty,
            Activa = true,
            Orden = (_reglas.Count == 0 ? 0 : _reglas.Max(r => r.Orden)) + 10,
            TipoCoincidencia = "CONTIENE",
            SoloSinAsignar = true,
            Detener = true
        };
