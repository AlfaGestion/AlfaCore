                                <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Martes" /><span>Mar</span></label>
                                <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Miercoles" /><span>Mié</span></label>
                                <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Jueves" /><span>Jue</span></label>
                                <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Viernes" /><span>Vie</span></label>
                                <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Sabado" /><span>Sáb</span></label>
                                <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Domingo" /><span>Dom</span></label>
                            </div>
                        </div>
                    </div>
                </details>

                <details class="conv-config-collapsible">
                    <summary class="conv-config-collapsible__summary">
                        <span class="conv-config-collapsible__title"><i class="bi bi-hand-thumbs-up"></i> Bienvenida al primer contacto</span>
                        <span class="conv-config-collapsible__hint">Saludo inicial una sola vez por conversación nueva.</span>
