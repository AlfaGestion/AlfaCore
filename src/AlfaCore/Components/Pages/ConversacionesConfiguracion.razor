    private string GetMercadoLibreAuthorizationUrl()
    {
        if (string.IsNullOrWhiteSpace(_mercadoLibreConfig.ClientId))
            return string.Empty;

        var redirectUri = GetMercadoLibreOAuthCallbackUrlPreview();
        return $"https://auth.mercadolibre.com.ar/authorization?response_type=code&client_id={Uri.EscapeDataString(_mercadoLibreConfig.ClientId.Trim())}&redirect_uri={Uri.EscapeDataString(redirectUri)}";
    }

