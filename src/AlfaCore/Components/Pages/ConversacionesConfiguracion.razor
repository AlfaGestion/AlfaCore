    /// <summary>
    /// Punto de entrada único para conectar WhatsApp Business por QR o por código de teléfono.
    /// Antes de generar el pairing, persiste el número (nuevo o existente) para que
    /// StartSessionAsync -- que relee el número desde la base -- encuentre el modo y el teléfono
    /// recién elegidos.
    /// </summary>
    private static string NormalizePhoneDigits(string? value)
        => new string((value ?? string.Empty).Where(char.IsDigit).ToArray());

    private async Task ConectarWhatsAppBusinessAsync(ConversacionWhatsAppNumeroDto numero, string method, string? telefono)
    {
        _feedbackScope = "whatsapp";
        numero.WebSessionMode = method;
        if (!string.IsNullOrWhiteSpace(telefono))
            numero.WebPhoneNumber = telefono.Trim();

        if (numero.IdNumero <= 0 && !string.IsNullOrWhiteSpace(telefono))
        {
            var telefonoDigits = NormalizePhoneDigits(telefono);
            var yaConectado = _numeros.FirstOrDefault(n =>
                n.IsWebSessionReady && NormalizePhoneDigits(n.WebPhoneNumber) == telefonoDigits && telefonoDigits.Length > 0);
            if (yaConectado is not null)
            {
                _feedback = new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Ese número ya está conectado",
                    Message = $"\"{yaConectado.Nombre}\" ya está vinculado con ese teléfono. No hace falta conectarlo de nuevo."
                };
                return;
            }
        }

        if (numero.IdNumero <= 0)
        {
            Saving = true;
            var creado = await UiOps.RunAsync(() => ConfigSvc.SaveWhatsAppNumeroAsync(numero), "No se pudo crear el nuevo WhatsApp Business.");
            Saving = false;
            if (!creado.Success)
            {
                _feedback = creado.Feedback;
                return;
            }

            await LoadNumerosAsync();
            var registrado = _numeros.FirstOrDefault(n => n.PhoneNumberId == numero.PhoneNumberId);
            if (registrado is null)
                return;

            numero = registrado;
            _selectedBusinessNumeroId = registrado.IdNumero;
            _provisionalBusinessNumeroIds.Add(registrado.IdNumero);
        }
        else
        {
            await SaveNumeroAsync(numero);
        }

        CloseConnectMethodChooser();
        await GenerateWhatsAppWebPairingAsync(numero);
    }

    private Task IniciarNuevoWhatsAppBusinessAsync(string method, string? telefono)
    {
        var nuevo = new ConversacionWhatsAppNumeroDto
        {
            Nombre = $"WhatsApp Business {_numeros.Count + 1}",
            PhoneNumberId = $"WEBPENDING-{Guid.NewGuid():N}"[..24],
            Activo = true
        };
        return ConectarWhatsAppBusinessAsync(nuevo, method, telefono);
    }

    private void StartPolling(ConversacionWhatsAppNumeroDto numero)
    {
        StopPolling();
        if (numero.IdNumero <= 0 || numero.IsWebSessionReady)
            return;

        _pairingFlowActiveIds.Add(numero.IdNumero);
        if (_pairingRegenerateErrorForIdNumero == numero.IdNumero)
            _pairingRegenerateErrorForIdNumero = null;
        _pairingStaleCycles = 0;
        _pairingFailureCount = 0;

        var cts = new CancellationTokenSource();
        _pollingCts = cts;
        _ = PollPairingStatusAsync(numero.IdNumero, cts.Token);
    }

    private void StopPolling()
    {
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
        _pollingCts = null;
    }

    private void StopPollingWithRegenerateError(int idNumero)
    {
        _pairingRegenerateErrorForIdNumero = idNumero;
        StopPolling();
    }

    private bool IsPairingFlowActive(int idNumero) => _pairingFlowActiveIds.Contains(idNumero);

    private bool HasPairingRegenerateError(ConversacionWhatsAppNumeroDto numero)
        => _pairingRegenerateErrorForIdNumero == numero.IdNumero;

    private static bool IsPairingFresh(ConversacionWhatsAppNumeroDto numero)
        => numero.WebPairingExpiresAtUtc.HasValue && numero.WebPairingExpiresAtUtc.Value > DateTime.UtcNow;

    /// <summary>
    /// El QR/código guardado en base sólo se muestra si esta sesión de UI lo inició explícitamente
    /// (evita precargar un pairing viejo al abrir/recargar la pantalla) y sigue vigente según
    /// expiresAtUtc del worker.
    /// </summary>
    private bool ShouldShowPairingSurface(ConversacionWhatsAppNumeroDto numero)
        => IsPairingFlowActive(numero.IdNumero)
           && !numero.IsWebSessionReady
           && !HasPairingRegenerateError(numero)
           && (numero.HasWebPairingQr || numero.HasWebPairingCode)
           && IsPairingFresh(numero);

    private bool IsPairingRegenerating(ConversacionWhatsAppNumeroDto numero)
        => IsPairingFlowActive(numero.IdNumero)
           && !numero.IsWebSessionReady
           && !HasPairingRegenerateError(numero)
           && (numero.HasWebPairingQr || numero.HasWebPairingCode)
           && !IsPairingFresh(numero);

    private bool IsPairingFlowVisible(ConversacionWhatsAppNumeroDto numero)
        => IsPairingFlowActive(numero.IdNumero) && !numero.IsWebSessionReady;

    /// <summary>
    /// Refresca el estado del pairing cada pocos segundos mientras está pendiente, para que el
    /// cliente no tenga que tocar "Actualizar" manualmente. Baileys rota el QR solo cada ~2 minutos
    /// mientras el worker sigue vivo (nuevo qrPayload/expiresAtUtc en status.json), así que este
    /// polling ya alcanza para reflejar la renovación -- no hace falta pedirle nada extra al backend.
    /// Se detiene solo al conectar, fallar, cancelar, navegar fuera de esta vista o destruirse el
    /// componente -- nunca queda como polling global permanente.
    /// </summary>
    private async Task PollPairingStatusAsync(int idNumero, CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(4), token);
                if (token.IsCancellationRequested)
                    return;

                var numero = _numeros.FirstOrDefault(n => n.IdNumero == idNumero);
                if (numero is null || !IsPairingFlowActive(idNumero))
                    return;

                var previousGeneratedAtUtc = numero.WebPairingGeneratedAtUtc;
                var wasExpired = !IsPairingFresh(numero);

                var refreshed = await RefreshWhatsAppWebSessionCoreAsync(numero, silent: true);

                var actualizado = _numeros.FirstOrDefault(n => n.IdNumero == idNumero);
                if (actualizado is null || !IsPairingFlowActive(idNumero))
                    return;

                if (!refreshed)
                {
                    _pairingFailureCount++;
                    if (_pairingFailureCount >= PairingFailureLimit)
                    {
                        StopPollingWithRegenerateError(idNumero);
                        await InvokeAsync(StateHasChanged);
                        return;
                    }

                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                _pairingFailureCount = 0;

                // Baileys pasa por RECONNECTING (p.ej. "Stream Errored (restart required)") como
                // parte normal del handshake tras escanear el QR; eso queda como PendingQr, no
                // como Disconnected, así que el polling sigue esperando en vez de darlo por fallido.
                if (actualizado.IsWebSessionReady
                    || actualizado.WebSessionStatus == ConversacionWhatsAppWebSessionStatuses.Disconnected)
                {
                    if (actualizado.IsWebSessionReady)
                        _provisionalBusinessNumeroIds.Remove(idNumero);

                    _pairingFlowActiveIds.Remove(idNumero);
                    _pollingCts = null;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (wasExpired && actualizado.WebPairingGeneratedAtUtc == previousGeneratedAtUtc)
                {
                    _pairingStaleCycles++;
                    if (_pairingStaleCycles >= PairingStaleCycleLimit)
                    {
                        StopPollingWithRegenerateError(idNumero);
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                }
                else
                {
                    _pairingStaleCycles = 0;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Cancelado explícitamente (conectado, cancelado por el usuario o componente destruido).
        }
    }

    private Task RefreshWhatsAppWebSessionAsync(ConversacionWhatsAppNumeroDto numero, bool silent = false)
        => RefreshWhatsAppWebSessionCoreAsync(numero, silent);

    private async Task<bool> RefreshWhatsAppWebSessionCoreAsync(ConversacionWhatsAppNumeroDto numero, bool silent)
    {
        _feedbackScope = "whatsapp";
        if (numero.IdNumero <= 0)
            return true;

        if (!silent)
        {
            PairingBusy = true;
            _feedback = null;
        }

        var result = await UiOps.RunAsync(
            () => WhatsAppWebSessionSvc.RefreshSessionAsync(numero.IdNumero),
            "No se pudo refrescar el estado de WhatsApp Web.");

        if (result.Success && result.Value is not null)
        {
            ReplaceNumero(result.Value);
            if (!silent)
            {
                _feedback = AppUiMessage.Success(
                    "Estado actualizado",
                    $"La sesión Web de '{result.Value.Nombre}' fue refrescada con el último estado reportado por el worker.");
            }
        }
        else if (!silent)
        {
            _feedback = result.Feedback;
        }

        if (!silent)
            PairingBusy = false;

        return result.Success;
    }

    private async Task RetryWhatsAppWebPairingAsync(ConversacionWhatsAppNumeroDto numero)
    {
        _pairingRegenerateErrorForIdNumero = null;
        _pairingStaleCycles = 0;
        _pairingFailureCount = 0;
        await GenerateWhatsAppWebPairingAsync(numero);
    }

    private async Task ClearWhatsAppWebPairingAsync(ConversacionWhatsAppNumeroDto numero)
    {
        _feedbackScope = "whatsapp";
        if (numero.IdNumero <= 0)
            return;

        StopPolling();
        _pairingFlowActiveIds.Remove(numero.IdNumero);
        if (_pairingRegenerateErrorForIdNumero == numero.IdNumero)
            _pairingRegenerateErrorForIdNumero = null;
        PairingBusy = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => WhatsAppWebSessionSvc.StopSessionAsync(numero.IdNumero),
            "No se pudo detener la sesión de WhatsApp Web.");

        if (result.Success && result.Value is not null)
        {
            ReplaceNumero(result.Value);
            _feedback = AppUiMessage.Success(
                "Sesión cerrada",
                $"'{GetNumeroDisplayName(result.Value)}' ya no está conectado. Las conversaciones anteriores se conservan.");

            // "Cerrar sesión" saca la cuenta de la lista Business (ActiveBusinessNumeros) sin borrar
            // la fila ni su historial -- mismo campo Activo que ya existía en el modelo, ahora
            // manejado por el sistema en vez de expuesto como checkbox manual del cliente.
            if (result.Value.Activo)
            {
                result.Value.Activo = false;
                var archiveResult = await UiOps.RunAsync(
                    () => ConfigSvc.SaveWhatsAppNumeroAsync(result.Value),
                    "La sesión se cerró, pero no se pudo actualizar la lista de números.");
                if (archiveResult.Success)
                    ReplaceNumero(result.Value);
            }
        }
        else
        {
            _feedback = result.Feedback;
        }

        PairingBusy = false;
    }

