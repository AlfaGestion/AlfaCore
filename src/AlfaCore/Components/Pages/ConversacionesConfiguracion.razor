                            </label>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label for="bienvenida-msg">Mensaje de bienvenida</label>
                            <textarea id="bienvenida-msg" rows="2" @bind="_automatizacionesConfig.BienvenidaMensaje"></textarea>
                        </div>
                    </div>
                </details>

                <details class="conv-config-collapsible">
                    <summary class="conv-config-collapsible__summary">
                        <span class="conv-config-collapsible__title"><i class="bi bi-robot"></i> Asistente IA</span>
