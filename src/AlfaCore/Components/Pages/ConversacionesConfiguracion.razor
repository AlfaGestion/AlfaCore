@page "/conversaciones/configuracion"
@page "/{idweb}/{idbase:int}/conversaciones/configuracion"
@inject AlfaCore.Services.IConversacionesConfigService ConfigSvc
@inject AlfaCore.Services.IConversacionesService ConvSvc
@inject AlfaCore.Services.IAnyDeskLocalSettingsService AnyDeskSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject NavigationManager Nav

<PageTitle>Configuración de canales | Alfa Gestión</PageTitle>

<section class="page-grid">
    <div class="page-intro">
        <div>
            <h2 class="page-intro__title">Configuración de canales</h2>
            <p class="page-intro__text">Administrá desde AlfaCore los parámetros de mensajería por canal. Esta configuración se guarda en <code>TA_CONFIGURACION</code> y <code>appsettings</code> queda solo como respaldo mínimo.</p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="/conversaciones">
                <i class="bi bi-arrow-left"></i> Volver al inbox
            </a>
            <button type="button" class="btn btn--ghost" @onclick="LoadAsync" disabled="@(Loading || Saving)">
                <i class="bi bi-arrow-clockwise"></i> Recargar
            </button>
        </div>
    </div>

    @if (_feedback is not null)
    {
        <div class="conversations-inline @GetFeedbackClass(_feedback)">
            <strong>@_feedback.Title</strong>
            <div>@_feedback.Message</div>
            @if (_feedback.HasCode)
            {
                <div>Código: @_feedback.Code</div>
            }
            @if (_feedback.HasSuggestion)
            {
                <div>@_feedback.Suggestion</div>
            }
        </div>
    }
    @if (AppMode.IsSaaSMode)
    {
        <div class="conversations-inline @(HasWebhookToken ? "conversations-inline--ok" : "conversations-inline--error")">
            <strong>@(HasWebhookToken ? "Webhook identificado por base" : "Webhook sin identificación de base")</strong>
            <div>@GetWebhookTenantHelp("los mensajes entrantes")</div>
        </div>
    }
    <div class="conv-config-status-grid">
            <article class="panel-card conv-status-card">
                <span class="panel-card__tag">Envío Cloud API</span>
                <strong class="@GetStatusClass(_config.IsConfiguredForSend)">@GetStatusLabel(_config.IsConfiguredForSend)</strong>
                <p class="panel-card__subtitle">Requiere <code>access token</code> y <code>phone_number_id</code>.</p>
            </article>

            <article class="panel-card conv-status-card">
                <span class="panel-card__tag">Webhook de verificación</span>
                <strong class="@GetStatusClass(_config.IsConfiguredForVerify)">@GetStatusLabel(_config.IsConfiguredForVerify)</strong>
                <p class="panel-card__subtitle">Requiere <code>verify_token</code> para validar el callback de Meta.</p>
            </article>

            <article class="panel-card conv-status-card">
                <span class="panel-card__tag">Publicación</span>
                <strong class="@GetStatusClass(_config.IsReadyForMetaSetup)">@GetPublicationLabel()</strong>
                <p class="panel-card__subtitle">Meta necesita una URL pública HTTPS para llamar al webhook.</p>
            </article>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Parámetros del canal</h3>
                        <p class="panel-card__subtitle">Origen actual: @DisplaySource(_config.ConfigSource)</p>
                    </div>
                    <span class="panel-card__tag">TA_CONFIGURACION</span>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="wa-public-url">Base pública HTTPS</label>
                        <input id="wa-public-url" @bind="_config.PublicBaseUrl" placeholder="@_suggestedBaseUrl" />
                    </div>

                    <div class="field">
                        <label for="wa-api-version">Versión Graph API</label>
                        <input id="wa-api-version" @bind="_config.ApiVersion" placeholder="v22.0" />
                    </div>

                    <div class="field">
                        <label for="wa-phone-id">Phone Number ID</label>
                        <input id="wa-phone-id" @bind="_config.PhoneNumberId" placeholder="Ej. 123456789012345" />
                    </div>

                    <div class="field">
                        <label for="wa-business-id">WhatsApp Business Account ID</label>
                        <input id="wa-business-id" @bind="_config.BusinessAccountId" placeholder="Ej. 109876543210987" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="wa-access-token">Access Token</label>
                        <textarea id="wa-access-token" rows="4" @bind="_config.AccessToken" placeholder="Pegá acá el token permanente o del sistema"></textarea>
                    </div>

                    <div class="field">
                        <label for="wa-verify-token">Verify Token</label>
                        <input id="wa-verify-token" @bind="_config.VerifyToken" placeholder="Texto secreto que definís vos" />
                    </div>

                    <div class="field">
                        <label for="wa-app-secret">App Secret</label>
                        <input id="wa-app-secret" @bind="_config.AppSecret" placeholder="Opcional por ahora, recomendado para firma" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="wa-webhook-path">Webhook interno</label>
                        <input id="wa-webhook-path" value="@_config.WebhookPath" readonly />
                    </div>
                </div>

                <div class="context-card">
                    <span class="context-card__label">URL de callback a informar en Meta</span>
                    <strong>@GetWebhookUrlPreview()</strong>
                    <span class="context-card__muted">
                        Si no cargás la base pública, se sugiere la URL actual del navegador.
                        @if (string.IsNullOrWhiteSpace(_webhookToken))
                        {
                            <text> Esta base todavía no tiene token de webhook propio. No uses este callback para producción SaaS porque el servidor no puede identificar el cliente del mensaje entrante.</text>
                        }
                        else
                        {
                            <text> El token al final de la URL es propio de esta base: identifica a qué cliente pertenece cada mensaje entrante, sin depender de ninguna sesión.</text>
                        }
                    </span>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar configuración
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Qué necesitás en Meta</h3>
                        <p class="panel-card__subtitle">Guía rápida para dejar operativo el canal.</p>
                    </div>
                    <span class="panel-card__tag">Cloud API</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Crear o usar una app tipo negocio en Meta for Developers y agregar el producto WhatsApp.</li>
                    <li>Obtener el <code>Phone Number ID</code> del número que vas a conectar.</li>
                    <li>Obtener el <code>WhatsApp Business Account ID</code> de la cuenta de negocio.</li>
                    <li>Generar un <code>Access Token</code> válido para el envío de mensajes.</li>
                    <li>Definir un <code>Verify Token</code> propio y cargar la URL pública del webhook en Meta.</li>
                    <li>Suscribir el webhook al menos a eventos de mensajes y estados.</li>
                    <li>Probar verificación, envío y recepción antes de pasar a producción.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Dónde queda guardado</span>
                    <strong>dbo.TA_CONFIGURACION</strong>
                    <span class="context-card__muted">Claves usadas: <code>CONV_WHATSAPP_*</code>.</span>
                </div>

                <div class="context-card">
                    <span class="context-card__label">Manual interno</span>
                    <strong><code>docs/conversaciones_whatsapp_conexion.md</code></strong>
                    <span class="context-card__muted">Ahí te dejo el paso a paso completo y el mapa entre Meta y AlfaCore.</span>
                </div>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form conv-config-form--instagram">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title"><i class="bi bi-instagram"></i> Instagram</h3>
                        <p class="panel-card__subtitle">Origen actual: @DisplaySource(_instagramConfig.ConfigSource)</p>
                    </div>
                    <span class="panel-card__tag">CONV_INSTAGRAM_*</span>
                </div>

                <div class="conv-config-status-grid">
                    <article class="context-card">
                        <span class="context-card__label">Envío Messaging API</span>
                        <strong class="@GetStatusClass(_instagramConfig.IsConfiguredForSend)">@GetStatusLabel(_instagramConfig.IsConfiguredForSend)</strong>
                        <span class="context-card__muted">Requiere <code>access token</code> e <code>instagram account id</code>.</span>
                    </article>
                    <article class="context-card">
                        <span class="context-card__label">Webhook</span>
                        <strong class="@GetStatusClass(_instagramConfig.IsConfiguredForVerify)">@GetStatusLabel(_instagramConfig.IsConfiguredForVerify)</strong>
                        <span class="context-card__muted">Requiere <code>verify token</code> y URL pública HTTPS.</span>
                    </article>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="ig-public-url">Base pública HTTPS</label>
                        <input id="ig-public-url" @bind="_instagramConfig.PublicBaseUrl" placeholder="@_suggestedBaseUrl" />
                    </div>

                    <div class="field">
                        <label for="ig-api-version">Versión Graph API</label>
                        <input id="ig-api-version" @bind="_instagramConfig.ApiVersion" placeholder="v22.0" />
                    </div>

                    <div class="field">
                        <label for="ig-app-id">App ID</label>
                        <input id="ig-app-id" @bind="_instagramConfig.AppId" placeholder="App ID de Meta" />
                    </div>

                    <div class="field">
                        <label for="ig-page-id">Facebook Page ID</label>
                        <input id="ig-page-id" @bind="_instagramConfig.FacebookPageId" placeholder="Página vinculada a Instagram" />
                    </div>

                    <div class="field">
                        <label for="ig-account-id">Instagram Account ID</label>
                        <input id="ig-account-id" @bind="_instagramConfig.InstagramAccountId" placeholder="Cuenta profesional de Instagram" />
                    </div>

                    <div class="field">
                        <label for="ig-verify-token">Verify Token</label>
                        <input id="ig-verify-token" @bind="_instagramConfig.VerifyToken" placeholder="Texto secreto que definís vos" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ig-access-token">Access Token</label>
                        <textarea id="ig-access-token" rows="4" @bind="_instagramConfig.AccessToken" placeholder="Token de página u OAuth con permisos de Instagram Messaging"></textarea>
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ig-app-secret">App Secret</label>
                        <input id="ig-app-secret" @bind="_instagramConfig.AppSecret" placeholder="App Secret de Meta" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ig-webhook-path">Webhook interno</label>
                        <input id="ig-webhook-path" value="@_instagramConfig.WebhookPath" readonly />
                    </div>
                </div>

                <div class="context-card">
                    <span class="context-card__label">URL de callback a informar en Meta</span>
                    <strong>@GetInstagramWebhookUrlPreview()</strong>
                    <span class="context-card__muted">
                        El endpoint queda preparado para la siguiente etapa de recepción y envío de mensajes.
                        @GetWebhookTenantHelp("los mensajes de Instagram")
                    </span>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveInstagramAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar Instagram
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Credenciales Meta</h3>
                        <p class="panel-card__subtitle">Resumen de lo que tenés que conseguir.</p>
                    </div>
                    <span class="panel-card__tag">Instagram</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Usar una cuenta Instagram profesional vinculada a una página de Facebook.</li>
                    <li>Crear una app en Meta for Developers y agregar Instagram/Messaging según el flujo elegido.</li>
                    <li>Configurar el webhook con la URL pública de AlfaCore y el verify token.</li>
                    <li>Solicitar permisos de mensajería para producción mediante App Review.</li>
                    <li>Guardar en AlfaCore el token, la cuenta de Instagram y la página asociada.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Guía interna</span>
                    <strong><code>docs/modulos/conversaciones_instagram_meta.md</code></strong>
                    <span class="context-card__muted">Incluye el paso a paso para crear la app y pedir permisos.</span>
                </div>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form conv-config-form--facebook">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title"><i class="bi bi-facebook"></i> Facebook Messenger</h3>
                        <p class="panel-card__subtitle">Origen actual: @DisplaySource(_facebookConfig.ConfigSource)</p>
                    </div>
                    <span class="panel-card__tag">CONV_FACEBOOK_*</span>
                </div>

                <div class="conv-config-status-grid">
                    <article class="context-card">
                        <span class="context-card__label">Envío Messenger API</span>
                        <strong class="@GetStatusClass(_facebookConfig.IsConfiguredForSend)">@GetStatusLabel(_facebookConfig.IsConfiguredForSend)</strong>
                        <span class="context-card__muted">Requiere <code>page access token</code> y <code>page id</code>.</span>
                    </article>
                    <article class="context-card">
                        <span class="context-card__label">Webhook</span>
                        <strong class="@GetStatusClass(_facebookConfig.IsConfiguredForVerify)">@GetStatusLabel(_facebookConfig.IsConfiguredForVerify)</strong>
                        <span class="context-card__muted">Requiere <code>verify token</code>, App Secret y URL pública HTTPS.</span>
                    </article>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="fb-public-url">Base pública HTTPS</label>
                        <input id="fb-public-url" @bind="_facebookConfig.PublicBaseUrl" placeholder="@_suggestedBaseUrl" />
                    </div>

                    <div class="field">
                        <label for="fb-api-version">Versión Graph API</label>
                        <input id="fb-api-version" @bind="_facebookConfig.ApiVersion" placeholder="v22.0" />
                    </div>

                    <div class="field">
                        <label for="fb-app-id">App ID</label>
                        <input id="fb-app-id" @bind="_facebookConfig.AppId" placeholder="App ID de Meta" />
                    </div>

                    <div class="field">
                        <label for="fb-page-id">Facebook Page ID</label>
                        <input id="fb-page-id" @bind="_facebookConfig.PageId" placeholder="ID de la página" />
                    </div>

                    <div class="field">
                        <label for="fb-page-username">Usuario o slug de página</label>
                        <input id="fb-page-username" @bind="_facebookConfig.PageUsername" placeholder="Ej. mi.pagina" />
                    </div>

                    <div class="field">
                        <label for="fb-verify-token">Verify Token</label>
                        <input id="fb-verify-token" @bind="_facebookConfig.VerifyToken" placeholder="Texto secreto que definís vos" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="fb-access-token">Page Access Token</label>
                        <textarea id="fb-access-token" rows="4" @bind="_facebookConfig.AccessToken" placeholder="Token de página con permisos de Messenger"></textarea>
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="fb-app-secret">App Secret</label>
                        <input id="fb-app-secret" @bind="_facebookConfig.AppSecret" placeholder="App Secret de Meta" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="fb-webhook-path">Webhook interno</label>
                        <input id="fb-webhook-path" value="@_facebookConfig.WebhookPath" readonly />
                    </div>
                </div>

                <div class="context-card">
                    <span class="context-card__label">URL de callback a informar en Meta</span>
                    <strong>@GetFacebookWebhookUrlPreview()</strong>
                    <span class="context-card__muted">
                        Suscribir el producto Messenger al evento <code>messages</code> de la página.
                        @GetWebhookTenantHelp("los mensajes de Facebook")
                    </span>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveFacebookAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar Facebook
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help conv-config-help--facebook">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Messenger</h3>
                        <p class="panel-card__subtitle">Datos técnicos de la página y del webhook.</p>
                    </div>
                    <span class="panel-card__tag">Facebook</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Usar una app de Meta con el producto Messenger habilitado.</li>
                    <li>Generar un Page Access Token para la página que va a recibir mensajes.</li>
                    <li>Configurar el webhook con la URL pública y el verify token.</li>
                    <li>Suscribir la página al webhook de Messenger, al menos al evento <code>messages</code>.</li>
                    <li>Completar el usuario o slug de página para tener una referencia pública de la página conectada.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Perfil del cliente</span>
                    <strong>PSID + User Profile API</strong>
                    <span class="context-card__muted">AlfaCore intenta traer nombre, apellido y foto de perfil cuando entra el primer mensaje. Meta no garantiza una URL pública del perfil personal.</span>
                </div>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form conv-config-form--mercadolibre">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title"><i class="bi bi-bag-fill"></i> Mercado Libre</h3>
                        <p class="panel-card__subtitle">Origen actual: @DisplaySource(_mercadoLibreConfig.ConfigSource)</p>
                    </div>
                    <span class="panel-card__tag">CONV_MELI_*</span>
                </div>

                <div class="conv-config-status-grid">
                    <article class="context-card">
                        <span class="context-card__label">OAuth vendedor</span>
                        <strong class="@GetStatusClass(_mercadoLibreConfig.IsConfiguredForAuth)">@GetStatusLabel(_mercadoLibreConfig.IsConfiguredForAuth)</strong>
                        <span class="context-card__muted">Requiere <code>client id</code> y <code>client secret</code>.</span>
                    </article>
                    <article class="context-card">
                        <span class="context-card__label">API preguntas</span>
                        <strong class="@GetStatusClass(_mercadoLibreConfig.IsConfiguredForApi)">@GetStatusLabel(_mercadoLibreConfig.IsConfiguredForApi)</strong>
                        <span class="context-card__muted">Requiere <code>access token</code> de la cuenta vendedora.</span>
                    </article>
                    <article class="context-card">
                        <span class="context-card__label">Notificaciones</span>
                        <strong class="@GetStatusClass(_mercadoLibreConfig.IsReadyForWebhook)">@GetStatusLabel(_mercadoLibreConfig.IsReadyForWebhook)</strong>
                        <span class="context-card__muted">Requiere una URL pública HTTPS.</span>
                    </article>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="meli-public-url">Base pública HTTPS</label>
                        <input id="meli-public-url" @bind="_mercadoLibreConfig.PublicBaseUrl" placeholder="@_suggestedBaseUrl" />
                    </div>

                    <div class="field">
                        <label for="meli-site-id">Sitio</label>
                        <input id="meli-site-id" @bind="_mercadoLibreConfig.SiteId" placeholder="MLA" />
                    </div>

                    <div class="field">
                        <label for="meli-client-id">Client ID</label>
                        <input id="meli-client-id" @bind="_mercadoLibreConfig.ClientId" placeholder="App ID de Mercado Libre" />
                    </div>

                    <div class="field">
                        <label for="meli-seller-id">Seller/User ID</label>
                        <input id="meli-seller-id" @bind="_mercadoLibreConfig.SellerId" placeholder="ID de la cuenta vendedora" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="meli-client-secret">Client Secret</label>
                        <input id="meli-client-secret" @bind="_mercadoLibreConfig.ClientSecret" placeholder="Client Secret de la app" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="meli-access-token">Access Token</label>
                        <textarea id="meli-access-token" rows="4" @bind="_mercadoLibreConfig.AccessToken" placeholder="Token OAuth de la cuenta vendedora"></textarea>
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="meli-refresh-token">Refresh Token</label>
                        <textarea id="meli-refresh-token" rows="3" @bind="_mercadoLibreConfig.RefreshToken" placeholder="Refresh token para renovar el acceso"></textarea>
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="meli-api-base">Base API</label>
                        <input id="meli-api-base" @bind="_mercadoLibreConfig.ApiBaseUrl" placeholder="https://api.mercadolibre.com" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="meli-webhook-path">Webhook interno</label>
                        <input id="meli-webhook-path" value="@_mercadoLibreConfig.WebhookPath" readonly />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="meli-oauth-path">Callback OAuth interno</label>
                        <input id="meli-oauth-path" value="@_mercadoLibreConfig.OAuthCallbackPath" readonly />
                    </div>
                </div>

                <div class="context-card">
                    <span class="context-card__label">URL de notificaciones a informar en Mercado Libre</span>
                    <strong>@GetMercadoLibreWebhookUrlPreview()</strong>
                    <span class="context-card__muted">
                        Suscribir el topic <code>questions</code> para preguntas de publicaciones.
                        @GetWebhookTenantHelp("las notificaciones de Mercado Libre")
                    </span>
                </div>

                <div class="context-card">
                    <span class="context-card__label">Redirect URI OAuth</span>
                    <strong>@GetMercadoLibreOAuthCallbackUrlPreview()</strong>
                    <span class="context-card__muted">Usala en la app de Mercado Libre para autorizar la cuenta vendedora.</span>
                </div>

                <div class="context-card">
                    <span class="context-card__label">URL para autorizar vendedor</span>
                    @if (!string.IsNullOrWhiteSpace(GetMercadoLibreAuthorizationUrl()))
                    {
                        <a href="@GetMercadoLibreAuthorizationUrl()" target="_blank" rel="noopener noreferrer">
                            Abrir autorización OAuth
                        </a>
                    }
                    else
                    {
                        <strong>Completá Client ID para generarla</strong>
                    }
                    <span class="context-card__muted">Al volver del login, AlfaCore intenta guardar access token, refresh token y seller id.</span>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveMercadoLibreAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar Mercado Libre
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help conv-config-help--mercadolibre">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Chatter preventa</h3>
                        <p class="panel-card__subtitle">Preguntas de publicaciones dentro de Conversaciones.</p>
                    </div>
                    <span class="panel-card__tag">Meli</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Crear una app en Mercado Libre Developers.</li>
                    <li>Cargar la Redirect URI de OAuth mostrada por AlfaCore.</li>
                    <li>Autorizar la cuenta vendedora para obtener access token y refresh token.</li>
                    <li>Configurar la URL de notificaciones y suscribir el topic <code>questions</code>.</li>
                    <li>Cuando entra una notificación, AlfaCore consulta la API y crea o actualiza la conversación.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Visual</span>
                    <strong>Amarillo Mercado Libre</strong>
                    <span class="context-card__muted">El canal queda separado de Facebook/Instagram con acentos amarillos para evitar confusiones.</span>
                </div>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">AlfaKnowledge</h3>
                        <p class="panel-card__subtitle">Origen actual: @DisplaySource(_alfaKnowledgeConfig.ConfigSource)</p>
                    </div>
                    <span class="panel-card__tag">CONV_ALFAKNOWLEDGE_*</span>
                </div>

                <div class="conv-config-status-grid">
                    <article class="context-card">
                        <span class="context-card__label">Asistente contextual</span>
                        <strong class="@GetStatusClass(_alfaKnowledgeConfig.IsConfigured)">@GetStatusLabel(_alfaKnowledgeConfig.IsConfigured)</strong>
                        <span class="context-card__muted">Se usa desde Conversaciones para sugerencias y correcciones.</span>
                    </article>
                </div>

                <div class="conv-config-fields">
                    <div class="field conv-config-fields__full">
                        <label for="ak-base-url">Base URL</label>
                        <input id="ak-base-url" @bind="_alfaKnowledgeConfig.BaseUrl" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ak-api-key">API Key</label>
                        <input id="ak-api-key" @bind="_alfaKnowledgeConfig.ApiKey" placeholder="Clave X-Api-Key de AlfaKnowledge" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ak-kb-id">Knowledge Base Id</label>
                        <input id="ak-kb-id" @bind="_alfaKnowledgeConfig.KnowledgeBaseId" placeholder="GUID de la base/sector en AlfaKnowledgeMaster" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="ak-instrucciones">Instrucciones del asistente</label>
                        <textarea id="ak-instrucciones" rows="6" maxlength="4000"
                                  @bind="_alfaKnowledgeConfig.Instrucciones"
                                  placeholder="Cómo debe actuar y responder el asistente: persona, tono, reglas, qué escalar a un humano, qué NO responder. Ej: 'Sos el asistente de Alfa Net. Respondé cordial y breve, en español rioplatense. No inventes precios: si preguntan precio, ofrecé pasar con un vendedor...'"></textarea>
                        <small>Se anteponen a cada sugerencia de respuesta. Es el "sector Conversaciones": combinalas con la base de conocimiento (Knowledge Base Id) para guiar al asistente.</small>
                    </div>

                    <div class="field">
                        <label for="ak-timeout">Timeout (segundos)</label>
                        <input id="ak-timeout" type="number" min="1" @bind="_alfaKnowledgeConfig.TimeoutSeconds" />
                    </div>
                </div>

                <div class="context-card">
                    <span class="context-card__label">Acceso directo</span>
                    <strong>@GetAlfaKnowledgeUrlPreview()</strong>
                    <span class="context-card__muted">Esta URL se usa para abrir AlfaKnowledge completo y para llamar a <code>/api/external/suggest-reply</code>.</span>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveAlfaKnowledgeAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar AlfaKnowledge
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="TestAlfaKnowledgeConnectionAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-plug"></i> Probar conexión
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Uso en Conversaciones</h3>
                        <p class="panel-card__subtitle">Parámetros del panel lateral de asistencia.</p>
                    </div>
                    <span class="panel-card__tag">IA</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Cargar la URL base pública o interna con la que AlfaCore puede llegar a AlfaKnowledge.</li>
                    <li>Definir la misma API Key configurada en AlfaKnowledge para el endpoint externo.</li>
                    <li>Copiar el `Knowledge Base Id` exacto de la base habilitada en AlfaKnowledge para que el copiloto consulte la base correcta.</li>
                    <li>Probar desde una conversación real para validar sugerencias, citas y guardado de correcciones.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Persistencia</span>
                    <strong>dbo.TA_CONFIGURACION</strong>
                    <span class="context-card__muted">Claves usadas: <code>CONV_ALFAKNOWLEDGE_BASE_URL</code>, <code>CONV_ALFAKNOWLEDGE_API_KEY</code>, <code>CONV_ALFAKNOWLEDGE_KNOWLEDGE_BASE_ID</code> y <code>CONV_ALFAKNOWLEDGE_TIMEOUT_SECONDS</code>.</span>
                </div>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Automatizaciones</h3>
                        <p class="panel-card__subtitle">Respuesta automática fija cuando llega un WhatsApp fuera del horario de atención — sin IA, sin aprobación de operador.</p>
                    </div>
                    <span class="panel-card__tag">CONV_AUTOMATIZACIONES_*</span>
                </div>

                <div class="conv-config-status-grid">
                    <article class="context-card">
                        <span class="context-card__label">Estado</span>
                        <strong class="@GetStatusClass(_automatizacionesConfig.IsConfigured)">@GetStatusLabel(_automatizacionesConfig.IsConfigured)</strong>
                        <span class="context-card__muted">Activa y con mensaje cargado.</span>
                    </article>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label class="conv-config-checkbox">
                            <input type="checkbox" @bind="_automatizacionesConfig.Activo" />
                            <span>Activar respuesta fuera de horario</span>
                        </label>
                    </div>

                    <div class="field conv-config-fields__full">
                        <label for="auto-mensaje">Mensaje fuera de horario</label>
                        <textarea id="auto-mensaje" rows="3" @bind="_automatizacionesConfig.MensajeFueraHorario"></textarea>
                    </div>

                    <div class="field">
                        <label for="auto-desde">Horario de atención — desde</label>
                        <input id="auto-desde" type="text" placeholder="09:00" @bind="_automatizacionesConfig.HoraDesde" />
                    </div>

                    <div class="field">
                        <label for="auto-hasta">Horario de atención — hasta</label>
                        <input id="auto-hasta" type="text" placeholder="18:00" @bind="_automatizacionesConfig.HoraHasta" />
                    </div>

                    <div class="field conv-config-fields__full">
                        <label>Días de atención</label>
                        <div class="conv-config-dias">
                            <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Lunes" /><span>Lun</span></label>
                            <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Martes" /><span>Mar</span></label>
                            <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Miercoles" /><span>Mié</span></label>
                            <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Jueves" /><span>Jue</span></label>
                            <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Viernes" /><span>Vie</span></label>
                            <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Sabado" /><span>Sáb</span></label>
                            <label class="conv-config-checkbox"><input type="checkbox" @bind="_automatizacionesConfig.Domingo" /><span>Dom</span></label>
                        </div>
                    </div>
                </div>

                <div class="conv-config-fields conv-bot-config">
                    <div class="conv-config-fields__full">
                        <h4 class="conv-bot-config__title"><i class="bi bi-hand-thumbs-up"></i> Bienvenida al primer contacto</h4>
                        <p class="panel-card__subtitle">Se manda una sola vez, cuando llega el primer mensaje de una conversación nueva de WhatsApp y todavía no le respondimos nada.</p>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label class="conv-config-checkbox">
                            <input type="checkbox" @bind="_automatizacionesConfig.BienvenidaActivo" />
                            <span>Activar mensaje de bienvenida</span>
                        </label>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label for="bienvenida-msg">Mensaje de bienvenida</label>
                        <textarea id="bienvenida-msg" rows="2" @bind="_automatizacionesConfig.BienvenidaMensaje"></textarea>
                    </div>
                </div>

                <div class="conv-config-fields conv-bot-config">
                    <div class="conv-config-fields__full">
                        <h4 class="conv-bot-config__title"><i class="bi bi-robot"></i> Asistente IA (responde solo)</h4>
                        <p class="panel-card__subtitle">Un asistente estilo «proyecto de GPT»: definís su comportamiento y le pegás la información del negocio, y responde solo las consultas entrantes (todos los canales). Apagado por defecto. Requiere la API key de OpenAI configurada en el servidor. Los archivos (base de conocimiento) llegan en una fase siguiente.</p>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label class="conv-config-checkbox">
                            <input type="checkbox" @bind="_automatizacionesConfig.BotActivo" />
                            <span>Activar el asistente (responde automáticamente)</span>
                        </label>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label for="asis-comportamiento">Comportamiento (quién es, tono, qué puede y qué no)</label>
                        <textarea id="asis-comportamiento" rows="3" @bind="_automatizacionesConfig.AsistenteComportamiento"
                                  placeholder="Sos el asesor de ventas de [Empresa]. Cordial y breve. No des precios que no figuren en la información. Si piden hablar con una persona, derivá."></textarea>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label for="asis-informacion">Información del negocio (la fuente de verdad para responder)</label>
                        <textarea id="asis-informacion" rows="8" @bind="_automatizacionesConfig.AsistenteInformacion"
                                  placeholder="Pegá acá lo que el asistente tiene que saber: horario de soporte, canales, cómo actualizar el sistema, pasos de las consultas más frecuentes, qué derivar a una persona… Cuanto más concreto, mejor responde."></textarea>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label for="asis-politica">¿Qué hace cuando la información no alcanza?</label>
                        <select id="asis-politica" @bind="_automatizacionesConfig.AsistentePolitica">
                            <option value="SOLO_INFO">Responder solo con la información dada; si no sabe, pasar a un humano</option>
                            <option value="GENERAL_AVISA">Responder igual con conocimiento general, avisando que un asesor confirmará</option>
                            <option value="GENERAL">Responder igual con conocimiento general (mayor cobertura, más riesgo)</option>
                        </select>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label class="conv-config-checkbox">
                            <input type="checkbox" @bind="_automatizacionesConfig.BotSoloSinAsignar" />
                            <span>Responder solo conversaciones sin asignar (si un humano la tomó, el asistente calla)</span>
                        </label>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label for="bot-escalado">Palabras que fuerzan pasar a un humano</label>
                        <input id="bot-escalado" @bind="_automatizacionesConfig.BotPalabrasEscalado" placeholder="humano, persona, reclamo, operador" />
                    </div>
                    <div class="field">
                        <label for="bot-max">Máx. respuestas del asistente por conversación</label>
                        <input id="bot-max" type="number" min="1" @bind="_automatizacionesConfig.BotMaxRespuestas" />
                    </div>
                </div>

                <div class="conv-config-fields conv-bot-config">
                    <div class="conv-config-fields__full">
                        <h4 class="conv-bot-config__title"><i class="bi bi-door-closed"></i> Auto-cierre por inactividad</h4>
                        <p class="panel-card__subtitle">Cierra conversaciones donde estamos esperando al cliente (último mensaje nuestro) y no responde. Manda un aviso previo y, si sigue sin responder, cierra. Aplica a todos los canales. Apagado por defecto.</p>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label class="conv-config-checkbox">
                            <input type="checkbox" @bind="_automatizacionesConfig.AutoCierreActivo" />
                            <span>Activar auto-cierre por inactividad</span>
                        </label>
                    </div>
                    <div class="field">
                        <label for="ac-aviso">Horas de inactividad para el aviso</label>
                        <input id="ac-aviso" type="number" min="1" @bind="_automatizacionesConfig.AutoCierreHorasAviso" />
                    </div>
                    <div class="field">
                        <label for="ac-cierre">Horas tras el aviso para cerrar</label>
                        <input id="ac-cierre" type="number" min="1" @bind="_automatizacionesConfig.AutoCierreHorasCierre" />
                    </div>
                    <div class="field conv-config-fields__full">
                        <label for="ac-msg-aviso">Mensaje de aviso</label>
                        <textarea id="ac-msg-aviso" rows="2" @bind="_automatizacionesConfig.AutoCierreMensajeAviso"></textarea>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label for="ac-msg-cierre">Mensaje de cierre (opcional)</label>
                        <textarea id="ac-msg-cierre" rows="2" @bind="_automatizacionesConfig.AutoCierreMensajeCierre"></textarea>
                    </div>
                </div>

                <div class="conv-config-fields conv-bot-config">
                    <div class="conv-config-fields__full">
                        <h4 class="conv-bot-config__title"><i class="bi bi-alarm"></i> Seguimientos / SLA</h4>
                        <p class="panel-card__subtitle">Vigila las conversaciones donde el cliente espera respuesta (último mensaje entrante). A las horas configuradas deja una nota interna de recordatorio; si sigue sin responderse y estaba asignada, la desasigna para que otro la tome. No manda nada al cliente. Aplica a todos los canales. Apagado por defecto.</p>
                    </div>
                    <div class="field conv-config-fields__full">
                        <label class="conv-config-checkbox">
                            <input type="checkbox" @bind="_automatizacionesConfig.SlaActivo" />
                            <span>Activar seguimientos / SLA</span>
                        </label>
                    </div>
                    <div class="field">
                        <label for="sla-recordatorio">Horas sin respuesta para el recordatorio</label>
                        <input id="sla-recordatorio" type="number" min="1" @bind="_automatizacionesConfig.SlaHorasRecordatorio" />
                    </div>
                    <div class="field">
                        <label for="sla-reasignar">Horas sin respuesta para reasignar</label>
                        <input id="sla-reasignar" type="number" min="1" @bind="_automatizacionesConfig.SlaHorasReasignar" />
                    </div>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveAutomatizacionesAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar automatizaciones
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Nivel 0: regla fija, sin IA.</p>
                    </div>
                    <span class="panel-card__tag">WhatsApp</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Se manda solo para mensajes entrantes de WhatsApp fuera del horario/días configurados.</li>
                    <li>Como máximo una vez por conversación mientras siga fuera de horario, para no repetir el mensaje en cada respuesta del cliente.</li>
                    <li>Queda registrado como un mensaje saliente normal, marcado como automático.</li>
                </ol>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Reglas / palabras clave</h3>
                        <p class="panel-card__subtitle">Cuando llega un mensaje entrante (cualquier canal) y coincide una palabra clave, la regla puede responder, derivar a un técnico y/o fijar la prioridad. Se evalúan por orden; la primera que coincide y tiene «detener» corta el resto.</p>
                    </div>
                    <span class="panel-card__tag">CONV_REGLAS</span>
                </div>

                @if (_reglas.Count == 0)
                {
                    <p class="panel-card__subtitle">Todavía no hay reglas cargadas. El motor está inactivo hasta que agregues al menos una.</p>
                }
                else
                {
                    @foreach (var regla in _reglas)
                    {
                        <div class="conv-whatsapp-numero-card">
                            <div class="conv-config-fields__full">
                                <strong>#@regla.Orden — @regla.Nombre</strong>
                                @if (!regla.Activa)
                                {
                                    <span class="panel-card__tag">inactiva</span>
                                }
                                <p class="panel-card__subtitle">@DescribirCanalRegla(regla.Canal) · @regla.TipoCoincidencia.ToLowerInvariant(): @regla.Palabras · @DescribirAccionesRegla(regla)@DescribirCondicionesRegla(regla)@(regla.Detener ? " · detiene" : "")</p>
                            </div>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarRegla(regla)" disabled="@(Loading || Saving)">
                                    <i class="bi bi-pencil"></i> Editar
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EliminarReglaAsync(regla)" disabled="@(Loading || Saving)">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    }
                }

                @if (_reglaEdicion is null)
                {
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="NuevaRegla" disabled="@(Loading || Saving)">
                            <i class="bi bi-plus-lg"></i> Nueva regla
                        </button>
                    </div>
                }
                else
                {
                    <div class="conv-whatsapp-numero-card conv-whatsapp-numero-card--nuevo">
                        <div class="conv-config-fields conv-bot-config">
                            <div class="conv-config-fields__full">
                                <h4 class="conv-bot-config__title"><i class="bi bi-sliders"></i> @(_reglaEsNueva ? "Nueva regla" : $"Editar regla: {_reglaEdicion.Nombre}")</h4>
                            </div>
                            <div class="field">
                                <label>Nombre</label>
                                <input @bind="_reglaEdicion.Nombre" placeholder="Ej: Horarios de atención" />
                            </div>
                            <div class="field">
                                <label>Orden (menor = mayor prioridad)</label>
                                <input type="number" min="1" @bind="_reglaEdicion.Orden" />
                            </div>
                            <div class="field">
                                <label>Canal</label>
                                <select @bind="_reglaEdicion.Canal">
                                    <option value="">Todos los canales</option>
                                    <option value="WHATSAPP">WhatsApp</option>
                                    <option value="INSTAGRAM">Instagram</option>
                                    <option value="FACEBOOK">Facebook</option>
                                    <option value="MERCADOLIBRE">Mercado Libre</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Tipo de coincidencia</label>
                                <select @bind="_reglaEdicion.TipoCoincidencia">
                                    <option value="CONTIENE">El mensaje contiene…</option>
                                    <option value="EMPIEZA">El mensaje empieza con…</option>
                                    <option value="IGUAL">El mensaje es exactamente…</option>
                                </select>
                            </div>
                            <div class="field conv-config-fields__full">
                                <label>Palabras / frases (separadas por coma; coincide con cualquiera)</label>
                                <input @bind="_reglaEdicion.Palabras" placeholder="turnos, horario, atención" />
                            </div>
                            <div class="field conv-config-fields__full">
                                <label>Respuesta automática (opcional)</label>
                                <textarea rows="2" @bind="_reglaEdicion.RespuestaTexto" placeholder="Atendemos de 9 a 18 h. ¿En qué te ayudamos?"></textarea>
                            </div>
                            <div class="field">
                                <label>Derivar a técnico (opcional)</label>
                                <select @bind="_reglaEdicion.AsignarTecnico">
                                    <option value="">No derivar</option>
                                    @foreach (var t in _tecnicos)
                                    {
                                        <option value="@t.IdTecnico">@t.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>Fijar prioridad (opcional)</label>
                                <select @bind="_reglaEdicion.Prioridad">
                                    <option value="">No cambiar</option>
                                    <option value="BAJA">Baja</option>
                                    <option value="MEDIA">Media</option>
                                    <option value="ALTA">Alta</option>
                                    <option value="URGENTE">Urgente</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.Activa" />
                                    <span>Activa</span>
                                </label>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.SoloSinAsignar" />
                                    <span>Solo si nadie la tiene asignada</span>
                                </label>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.Detener" />
                                    <span>Detener otras reglas y auto-respuestas si coincide</span>
                                </label>
                            </div>
                            <div class="field">
                                <label>Horario</label>
                                <select @bind="_reglaEdicion.Horario">
                                    <option value="SIEMPRE">Siempre</option>
                                    <option value="DENTRO">Solo dentro del horario</option>
                                    <option value="FUERA">Solo fuera del horario</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="conv-config-checkbox">
                                    <input type="checkbox" @bind="_reglaEdicion.SoloPrimerContacto" />
                                    <span>Solo en el primer contacto</span>
                                </label>
                            </div>
                        </div>
                        <div class="actions">
                            <button type="button" class="btn btn--primary" @onclick="GuardarReglaAsync" disabled="@(Loading || Saving)">
                                <i class="bi bi-floppy-fill"></i> Guardar regla
                            </button>
                            <button type="button" class="btn btn--ghost" @onclick="CancelarEdicionRegla" disabled="@(Loading || Saving)">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Menú por palabras clave, sin IA.</p>
                    </div>
                    <span class="panel-card__tag">Todos los canales</span>
                </div>

                <ol class="conv-config-steps">
                    <li>En cada mensaje entrante se evalúan las reglas activas por orden (menor primero).</li>
                    <li>La primera que coincide aplica sus acciones: responde, deriva a un técnico y/o fija la prioridad.</li>
                    <li>Si esa regla tiene «detener», no se evalúan más reglas ni se dispara la bienvenida/bot.</li>
                    <li>«Solo si nadie la tiene asignada» evita pisar una conversación que ya atiende una persona.</li>
                    <li>La respuesta se manda si el canal/ventana lo permiten; la derivación y la prioridad se aplican igual.</li>
                </ol>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Prioridad de atención</h3>
                        <p class="panel-card__subtitle">Qué clasificación de cliente cuenta como prioridad 1 (más importante), 2 o 3 para ordenar la cola de espera. El resto (sin clasificar o con otra clasificación) queda al final.</p>
                    </div>
                    <span class="panel-card__tag">CLASIFICA1/2/3</span>
                </div>

                <div class="conv-config-fields">
                    <div class="field">
                        <label for="prioridad-1">Prioridad 1 (más importante)</label>
                        <select id="prioridad-1" @bind="_prioridadConfig.Clasifica1">
                            <option value="">Sin asignar</option>
                            @foreach (var opcion in _clasificaciones)
                            {
                                <option value="@opcion.Codigo">@opcion.Descripcion</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="prioridad-2">Prioridad 2 (media)</label>
                        <select id="prioridad-2" @bind="_prioridadConfig.Clasifica2">
                            <option value="">Sin asignar</option>
                            @foreach (var opcion in _clasificaciones)
                            {
                                <option value="@opcion.Codigo">@opcion.Descripcion</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="prioridad-3">Prioridad 3 (baja)</label>
                        <select id="prioridad-3" @bind="_prioridadConfig.Clasifica3">
                            <option value="">Sin asignar</option>
                            @foreach (var opcion in _clasificaciones)
                            {
                                <option value="@opcion.Codigo">@opcion.Descripcion</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SavePrioridadAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar prioridad
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Cómo se arma la cola de espera con esto.</p>
                    </div>
                    <span class="panel-card__tag">Cola de espera</span>
                </div>

                <ol class="conv-config-steps">
                    <li>El inbox ordena primero por prioridad (1, 2, 3, resto) y dentro de cada grupo por cuánto tiempo lleva esperando respuesta.</li>
                    <li>La clasificación de cada cliente se carga desde Clientes (Cuentas Comerciales) — acá solo se define qué clasificación pesa más.</li>
                    <li>Estas claves (<code>CLASIFICA1/2/3</code>) son las mismas que ya usa Desktop, no son propias de Conversaciones: configurarlas acá también las cambia allá.</li>
                </ol>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Números de WhatsApp</h3>
                        <p class="panel-card__subtitle">Cada número queda atendido por los usuarios que marques. Un número sin usuarios queda visible solo para los administradores de conversaciones.</p>
                    </div>
                    <span class="panel-card__tag">CONV_WHATSAPP_NUMEROS</span>
                </div>

                @foreach (var numero in _numeros)
                {
                    <div class="conv-whatsapp-numero-card">
                        <div class="conv-config-fields">
                            <div class="field">
                                <label>Nombre</label>
                                <input @bind="numero.Nombre" placeholder="Ej: Ventas Norte" />
                            </div>
                            <div class="field">
                                <label>Phone Number ID</label>
                                <input @bind="numero.PhoneNumberId" placeholder="Ej: 109876543210" />
                            </div>
                        </div>
                        <div class="field">
                            <label class="conv-config-checkbox">
                                <input type="checkbox" @bind="numero.Activo" />
                                <span>Activo</span>
                            </label>
                        </div>
                        <div class="field conv-config-fields__full">
                            <label>Usuarios con acceso a este número</label>
                            <div class="conv-config-checklist">
                                @foreach (var usuario in _usuariosSistema)
                                {
                                    <label class="conv-config-checkbox">
                                        <input type="checkbox"
                                               checked="@numero.Usuarios.Contains(usuario.Nombre, StringComparer.OrdinalIgnoreCase)"
                                               @onchange="args => ToggleNumeroUsuario(numero, usuario.Nombre, args.Value is bool b && b)" />
                                        <span>@usuario.Nombre</span>
                                    </label>
                                }
                                @if (_usuariosSistema.Count == 0)
                                {
                                    <span class="panel-card__subtitle">No hay usuarios activos en este sistema.</span>
                                }
                            </div>
                        </div>
                        <div class="actions">
                            <button type="button" class="btn btn--primary btn--sm" @onclick="() => SaveNumeroAsync(numero)" disabled="@(Loading || Saving)">
                                <i class="bi bi-floppy-fill"></i> Guardar número
                            </button>
                        </div>
                    </div>
                }

                <div class="conv-whatsapp-numero-card conv-whatsapp-numero-card--nuevo">
                    <div class="conv-config-fields">
                        <div class="field">
                            <label>Nombre del número nuevo</label>
                            <input @bind="_nuevoNumero.Nombre" placeholder="Ej: Ventas Sur" />
                        </div>
                        <div class="field">
                            <label>Phone Number ID</label>
                            <input @bind="_nuevoNumero.PhoneNumberId" placeholder="Ej: 109876543211" />
                        </div>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--ghost" @onclick="AddNumeroAsync" disabled="@(Loading || Saving)">
                            <i class="bi bi-plus-circle"></i> Agregar número
                        </button>
                    </div>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Qué cambia al tener más de un número.</p>
                    </div>
                    <span class="panel-card__tag">Multi-número</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Un usuario normal solo ve, en el inbox, las conversaciones de los números donde está marcado como usuario acá.</li>
                    <li>Un administrador de conversaciones (sección de abajo) ve y puede responder por cualquier número, sin restricción.</li>
                    <li>Apenas entra el primer mensaje de un cliente, la conversación queda fijada a ese número para siempre — Meta habilita 24 h de respuesta por par número-cliente, así que no conviene cambiarlo después.</li>
                    <li>Desactivar un número (sin borrarlo) deja de mostrarlo para asignar usuarios nuevos, pero no toca las conversaciones que ya tiene.</li>
                </ol>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Administradores de conversaciones</h3>
                        <p class="panel-card__subtitle">Ven y pueden responder por cualquier número de WhatsApp, sin importar a cuáles estén vinculados.</p>
                    </div>
                    <span class="panel-card__tag">CONV_ADMINISTRADORES</span>
                </div>

                <div class="conv-config-checklist">
                    @foreach (var usuario in _usuariosSistema)
                    {
                        <label class="conv-config-checkbox">
                            <input type="checkbox"
                                   checked="@_administradores.Contains(usuario.Nombre)"
                                   @onchange="args => ToggleAdministrador(usuario.Nombre, args.Value is bool b && b)" />
                            <span>@usuario.Nombre</span>
                        </label>
                    }
                    @if (_usuariosSistema.Count == 0)
                    {
                        <span class="panel-card__subtitle">No hay usuarios activos en este sistema.</span>
                    }
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="SaveAdministradoresAsync" disabled="@(Loading || Saving)">
                        <i class="bi bi-floppy-fill"></i> Guardar administradores
                    </button>
                </div>
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Es propio de Conversaciones, no el admin general del sistema.</p>
                    </div>
                    <span class="panel-card__tag">Solo este módulo</span>
                </div>

                <ol class="conv-config-steps">
                    <li>Es independiente de "Administrador del sistema" (Autorización de tareas) — alguien puede ser admin de conversaciones sin serlo del sistema, y viceversa.</li>
                    <li>Pensado para quien coordina el equipo de atención: supervisores, encargados de WhatsApp, etc.</li>
                </ol>
            </aside>
    </div>

    <div class="conv-config-layout">
            <section class="panel-card conv-config-form">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title"><i class="bi bi-display"></i> AnyDesk</h3>
                        <p class="panel-card__subtitle">Generá un archivo para registrar AnyDesk en tu propia PC, no en el servidor.</p>
                    </div>
                    <span class="panel-card__tag">Un paso por PC</span>
                </div>

                <div class="conv-config-fields">
                    <div class="field conv-config-fields__full">
                        <label for="anydesk-path">Ruta del ejecutable de AnyDesk en TU PC</label>
                        <input id="anydesk-path" @bind="_anyDeskPath" placeholder="Ej: C:\Program Files (x86)\AnyDesk\AnyDesk.exe" />
                    </div>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="DownloadAnyDeskScript" disabled="@AnyDeskSaving">
                        <i class="bi bi-download"></i> Descargar script de registro (.reg)
                    </button>
                </div>

                @if (_anyDeskFeedback is not null)
                {
                    <div class="conversations-inline @GetFeedbackClass(_anyDeskFeedback)">
                        <strong>@_anyDeskFeedback.Title</strong>
                        <div>@_anyDeskFeedback.Message</div>
                        @if (_anyDeskFeedback.HasSuggestion)
                        {
                            <div>@_anyDeskFeedback.Suggestion</div>
                        }
                    </div>
                }
            </section>

            <aside class="panel-card conv-config-help">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Cómo funciona</h3>
                        <p class="panel-card__subtitle">Por qué esto es distinto al resto de esta página.</p>
                    </div>
                    <span class="panel-card__tag">AnyDesk</span>
                </div>

                <ol class="conv-config-steps">
                    <li>AlfaCore corre en un servidor compartido, así que no puede tocar el registro de Windows de tu PC directamente.</li>
                    <li>Cargá acá la ruta a tu AnyDesk (buscala en tu PC: click derecho al acceso directo → Propiedades → Destino).</li>
                    <li>Al descargar, se genera un archivo <code>.reg</code> con esa ruta ya cargada.</li>
                    <li>Hacé doble clic en el archivo descargado (una sola vez) y confirmá el cartel de Windows para agregarlo al registro.</li>
                    <li>Listo: cualquier link "Conectar por AnyDesk" del inbox de Conversaciones va a abrir tu AnyDesk ya conectando al ID. Probalo haciendo clic en un ID de una conversación real.</li>
                    <li>Cada técnico repite esto una vez, en su propia PC.</li>
                </ol>

                <div class="context-card">
                    <span class="context-card__label">Qué NO hace esto</span>
                    <strong>No guarda nada en la base de datos</strong>
                    <span class="context-card__muted">La ruta que cargues acá solo se usa para armar el archivo que descargás; no queda guardada en AlfaCore ni se comparte con otros técnicos.</span>
                </div>
            </aside>
    </div>
</section>

@code {
    private ConversacionWhatsAppConfigDto _config = new();
    private ConversacionInstagramConfigDto _instagramConfig = new();
    private ConversacionFacebookConfigDto _facebookConfig = new();
    private ConversacionMercadoLibreConfigDto _mercadoLibreConfig = new();
    private ConversacionAlfaKnowledgeConfigDto _alfaKnowledgeConfig = new();
    private ConversacionAutomatizacionesConfigDto _automatizacionesConfig = new();
    private IReadOnlyList<ConversacionReglaDto> _reglas = [];
    private IReadOnlyList<ConversacionTecnicoOptionDto> _tecnicos = [];
    private ConversacionReglaDto? _reglaEdicion;
    private bool _reglaEsNueva;
    private ConversacionPrioridadConfigDto _prioridadConfig = new();
    private IReadOnlyList<ConversacionClasificacionOptionDto> _clasificaciones = [];
    private IReadOnlyList<UsuarioSistemaDto> _usuariosSistema = [];
    private IReadOnlyList<ConversacionWhatsAppNumeroDto> _numeros = [];
    private ConversacionWhatsAppNumeroDto _nuevoNumero = new() { Activo = true };
    private HashSet<string> _administradores = new(StringComparer.OrdinalIgnoreCase);
    private string _anyDeskPath = string.Empty;
    private bool Loading { get; set; }
    private bool Saving { get; set; }
    private bool AnyDeskSaving { get; set; }
    private AppUiMessage? _feedback;
    private AppUiMessage? _anyDeskFeedback;
    private string _suggestedBaseUrl = string.Empty;
    private string? _webhookToken;
    private bool HasWebhookToken => !string.IsNullOrWhiteSpace(_webhookToken);

    protected override async Task OnInitializedAsync()
    {
        _suggestedBaseUrl = GetCurrentBaseUrl();
        await LoadWebhookTokenAsync();
        await LoadAsync();
    }

    private async Task LoadWebhookTokenAsync()
    {
        if (!AppMode.IsSaaSMode)
        {
            return;
        }

        var idBase = SessionSvc.GetActiveSession()?.BaseId;
        if (idBase is null or 0)
        {
            return;
        }

        var result = await UiOps.RunAsync(
            () => CentralBasesSvc.EnsureWebhookTokenAsync(idBase.Value),
            "No se pudo generar el token de webhook de esta base.");

        if (result.Success)
        {
            _webhookToken = result.Value;
        }
    }

    /// <summary>
    /// URL de webhook propia de esta base (con token). Cada base necesita la suya para que un
    /// webhook entrante pueda resolver a qué cliente pertenece sin depender de ninguna sesión —
    /// ver TryResolveWebhookTenantAsync en Program.cs.
    /// </summary>
    private string? BuildTokenizedWebhookUrl(string basePath)
        => string.IsNullOrWhiteSpace(_webhookToken) ? null : $"{basePath}/{_webhookToken}";

    private bool EnsureSaaSWebhookTokenReady()
    {
        if (!AppMode.IsSaaSMode || HasWebhookToken)
            return true;

        _feedback = new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Warning,
            Title = "Token de webhook requerido",
            Message = "Seleccioná una base activa y recargá la pantalla para generar el token propio antes de guardar la configuración del canal.",
            Suggestion = "En SaaS, Meta y Mercado Libre deben usar la URL con token para que AlfaCore identifique el cliente/base sin depender de una sesión."
        };
        return false;
    }

    private string GetWebhookTenantHelp(string subject)
        => HasWebhookToken
            ? $"La URL mostrada incluye el token propio de esta base; {subject} se enrutan sin depender de la sesión activa."
            : $"Falta el token propio de esta base. En SaaS no configures este callback: {subject} podrían ir a la base por defecto.";

    private async Task LoadAsync()
    {
        Loading = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => ConfigSvc.GetWhatsAppConfigAsync(),
            "No se pudo cargar la configuración de WhatsApp.");

        if (result.Success && result.Value is not null)
        {
            _config = result.Value;
            EnsureDefaults();
        }
        else
        {
            EnsureDefaults();
            _feedback = result.Feedback;
        }

        var instagramResult = await UiOps.RunAsync(
            () => ConfigSvc.GetInstagramConfigAsync(),
            "No se pudo cargar la configuración de Instagram.");

        if (instagramResult.Success && instagramResult.Value is not null)
        {
            _instagramConfig = instagramResult.Value;
            EnsureInstagramDefaults();
        }
        else
        {
            EnsureInstagramDefaults();
            _feedback ??= instagramResult.Feedback;
        }

        var facebookResult = await UiOps.RunAsync(
            () => ConfigSvc.GetFacebookConfigAsync(),
            "No se pudo cargar la configuración de Facebook.");

        if (facebookResult.Success && facebookResult.Value is not null)
        {
            _facebookConfig = facebookResult.Value;
            EnsureFacebookDefaults();
        }
        else
        {
            EnsureFacebookDefaults();
            _feedback ??= facebookResult.Feedback;
        }

        var mercadoLibreResult = await UiOps.RunAsync(
            () => ConfigSvc.GetMercadoLibreConfigAsync(),
            "No se pudo cargar la configuración de Mercado Libre.");

        if (mercadoLibreResult.Success && mercadoLibreResult.Value is not null)
        {
            _mercadoLibreConfig = mercadoLibreResult.Value;
            EnsureMercadoLibreDefaults();
        }
        else
        {
            EnsureMercadoLibreDefaults();
            _feedback ??= mercadoLibreResult.Feedback;
        }

        var alfaKnowledgeResult = await UiOps.RunAsync(
            () => ConfigSvc.GetAlfaKnowledgeConfigAsync(),
            "No se pudo cargar la configuración de AlfaKnowledge.");

        if (alfaKnowledgeResult.Success && alfaKnowledgeResult.Value is not null)
        {
            _alfaKnowledgeConfig = alfaKnowledgeResult.Value;
            EnsureAlfaKnowledgeDefaults();
        }
        else
        {
            EnsureAlfaKnowledgeDefaults();
            _feedback ??= alfaKnowledgeResult.Feedback;
        }

        var automatizacionesResult = await UiOps.RunAsync(
            () => ConfigSvc.GetAutomatizacionesConfigAsync(),
            "No se pudo cargar la configuración de automatizaciones.");

        if (automatizacionesResult.Success && automatizacionesResult.Value is not null)
        {
            _automatizacionesConfig = automatizacionesResult.Value;
        }
        else
        {
            _feedback ??= automatizacionesResult.Feedback;
        }

        var clasificacionesResult = await UiOps.RunAsync(
            () => ConfigSvc.GetClasificacionesAsync(),
            "No se pudieron cargar las clasificaciones de clientes.");

        if (clasificacionesResult.Success && clasificacionesResult.Value is not null)
        {
            _clasificaciones = clasificacionesResult.Value;
        }
        else
        {
            _feedback ??= clasificacionesResult.Feedback;
        }

        var prioridadResult = await UiOps.RunAsync(
            () => ConfigSvc.GetPrioridadConfigAsync(),
            "No se pudo cargar la configuración de prioridad de atención.");

        if (prioridadResult.Success && prioridadResult.Value is not null)
        {
            _prioridadConfig = prioridadResult.Value;
        }
        else
        {
            _feedback ??= prioridadResult.Feedback;
        }

        var usuariosResult = await UiOps.RunAsync(
            () => ConfigSvc.GetUsuariosSistemaAsync(),
            "No se pudieron cargar los usuarios del sistema.");

        if (usuariosResult.Success && usuariosResult.Value is not null)
        {
            _usuariosSistema = usuariosResult.Value;
        }
        else
        {
            _feedback ??= usuariosResult.Feedback;
        }

        await LoadNumerosAsync();

        var administradoresResult = await UiOps.RunAsync(
            () => ConfigSvc.GetConversacionAdministradoresAsync(),
            "No se pudieron cargar los administradores de conversaciones.");

        if (administradoresResult.Success && administradoresResult.Value is not null)
        {
            _administradores = new HashSet<string>(administradoresResult.Value, StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            _feedback ??= administradoresResult.Feedback;
        }

        await LoadReglasAsync();

        var tecnicosResult = await UiOps.RunAsync(
            () => ConvSvc.GetTechniciansAsync(),
            "No se pudieron cargar los técnicos.");

        if (tecnicosResult.Success && tecnicosResult.Value is not null)
        {
            _tecnicos = tecnicosResult.Value;
        }
        else
        {
            _feedback ??= tecnicosResult.Feedback;
        }

        Loading = false;
    }

    private async Task LoadReglasAsync()
    {
        var result = await UiOps.RunAsync(
            () => ConfigSvc.GetReglasAsync(),
            "No se pudieron cargar las reglas de palabras clave.");

        if (result.Success && result.Value is not null)
        {
            _reglas = result.Value;
        }
        else
        {
            _feedback ??= result.Feedback;
        }
    }

    private void NuevaRegla()
    {
        _reglaEsNueva = true;
        _reglaEdicion = new ConversacionReglaDto
        {
            Nombre = string.Empty,
            Activa = true,
            Orden = (_reglas.Count == 0 ? 0 : _reglas.Max(r => r.Orden)) + 10,
            TipoCoincidencia = "CONTIENE",
            SoloSinAsignar = true,
            Detener = true
        };
    }

    private void EditarRegla(ConversacionReglaDto regla)
    {
        _reglaEsNueva = false;
        _reglaEdicion = new ConversacionReglaDto
        {
            IdRegla = regla.IdRegla,
            Nombre = regla.Nombre,
            Activa = regla.Activa,
            Orden = regla.Orden,
            TipoCoincidencia = regla.TipoCoincidencia,
            Palabras = regla.Palabras,
            Canal = regla.Canal,
            SoloSinAsignar = regla.SoloSinAsignar,
            RespuestaTexto = regla.RespuestaTexto,
            AsignarTecnico = regla.AsignarTecnico,
            Prioridad = regla.Prioridad,
            Detener = regla.Detener
        };
    }

    private void CancelarEdicionRegla()
    {
        _reglaEdicion = null;
        _reglaEsNueva = false;
    }

    private async Task GuardarReglaAsync()
    {
        if (_reglaEdicion is null)
            return;

        if (string.IsNullOrWhiteSpace(_reglaEdicion.Nombre))
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Falta el nombre",
                Message = "Poné un nombre para identificar la regla."
            };
            return;
        }

        Saving = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => ConfigSvc.SaveReglaAsync(_reglaEdicion),
            "No se pudo guardar la regla.");

        if (result.Success)
        {
            _feedback = AppUiMessage.Success("Regla guardada", $"'{_reglaEdicion.Nombre}' quedó actualizada.");
            _reglaEdicion = null;
            _reglaEsNueva = false;
            await LoadReglasAsync();
        }
        else
        {
            _feedback = result.Feedback;
        }

        Saving = false;
    }

    private async Task EliminarReglaAsync(ConversacionReglaDto regla)
    {
        Saving = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => ConfigSvc.DeleteReglaAsync(regla.IdRegla),
            "No se pudo eliminar la regla.");

        if (result.Success)
        {
            _feedback = AppUiMessage.Success("Regla eliminada", $"'{regla.Nombre}' fue eliminada.");
            if (_reglaEdicion?.IdRegla == regla.IdRegla)
                _reglaEdicion = null;
            await LoadReglasAsync();
        }
        else
        {
            _feedback = result.Feedback;
        }

        Saving = false;
    }

    private static string DescribirCanalRegla(string? canal)
        => (canal ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            "WHATSAPP" => "WhatsApp",
            "INSTAGRAM" => "Instagram",
            "FACEBOOK" => "Facebook",
            "MERCADOLIBRE" => "Mercado Libre",
            _ => "Todos los canales"
        };

    private static string DescribirAccionesRegla(ConversacionReglaDto regla)
    {
        var acciones = new List<string>();
        if (!string.IsNullOrWhiteSpace(regla.RespuestaTexto)) acciones.Add("responde");
        if (!string.IsNullOrWhiteSpace(regla.AsignarTecnico)) acciones.Add("deriva");
        if (!string.IsNullOrWhiteSpace(regla.Prioridad)) acciones.Add($"prioridad {regla.Prioridad.ToLowerInvariant()}");
        return acciones.Count == 0 ? "—" : string.Join(" · ", acciones);
    }

    private static string DescribirCondicionesRegla(ConversacionReglaDto regla)
    {
        var cond = new List<string>();
        if (string.Equals(regla.Horario, "DENTRO", StringComparison.OrdinalIgnoreCase)) cond.Add("dentro de horario");
        else if (string.Equals(regla.Horario, "FUERA", StringComparison.OrdinalIgnoreCase)) cond.Add("fuera de horario");
        if (regla.SoloPrimerContacto) cond.Add("primer contacto");
        return cond.Count == 0 ? string.Empty : " · " + string.Join(" · ", cond);
    }

    private async Task LoadNumerosAsync()
    {
        var result = await UiOps.RunAsync(
            () => ConfigSvc.GetWhatsAppNumerosAsync(),
            "No se pudieron cargar los números de WhatsApp.");

        if (result.Success && result.Value is not null)
        {
            _numeros = result.Value;
        }
        else
        {
            _feedback ??= result.Feedback;
        }
    }

    private static void ToggleNumeroUsuario(ConversacionWhatsAppNumeroDto numero, string usuario, bool isChecked)
    {
        if (isChecked)
        {
            if (!numero.Usuarios.Contains(usuario, StringComparer.OrdinalIgnoreCase))
                numero.Usuarios.Add(usuario);
        }
        else
        {
            numero.Usuarios.RemoveAll(u => string.Equals(u, usuario, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task SaveNumeroAsync(ConversacionWhatsAppNumeroDto numero)
    {
        Saving = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => ConfigSvc.SaveWhatsAppNumeroAsync(numero),
