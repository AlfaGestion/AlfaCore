    private string GetWhatsAppNumerosSummary()
    {
        if (_numeros.Count == 0)
            return "Todavía no agregaste ningún número.";

        var conectados = _numeros.Count(n => n.IsWebSessionReady);
        var plural = _numeros.Count == 1 ? "número" : "números";
        var conectadosPlural = conectados == 1 ? "conectado" : "conectados";
        return $"{_numeros.Count} {plural} · {conectados} {conectadosPlural}";
    }

