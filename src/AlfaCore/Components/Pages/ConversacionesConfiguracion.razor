    private void EnsureMercadoLibreDefaults()
    {
        if (string.IsNullOrWhiteSpace(_mercadoLibreConfig.WebhookPath))
            _mercadoLibreConfig.WebhookPath = "/api/conversaciones/mercadolibre/webhook";

        if (string.IsNullOrWhiteSpace(_mercadoLibreConfig.OAuthCallbackPath))
            _mercadoLibreConfig.OAuthCallbackPath = "/api/conversaciones/mercadolibre/oauth/callback";

