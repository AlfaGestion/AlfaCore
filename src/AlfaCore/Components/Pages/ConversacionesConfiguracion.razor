    private void ReplaceNumero(ConversacionWhatsAppNumeroDto numero)
    {
        var actualizados = _numeros.ToList();
        var index = actualizados.FindIndex(x => x.IdNumero == numero.IdNumero);
        if (index >= 0)
            actualizados[index] = numero;
        else
            actualizados.Add(numero);

        _numeros = actualizados;
        if (IsWhatsAppBusinessView)
            UpdatePageHeader();
    }

    private static bool IsWhatsAppWebManagedNumero(ConversacionWhatsAppNumeroDto numero)
    {
        var phoneNumberId = (numero.PhoneNumberId ?? string.Empty).Trim();
        if (phoneNumberId.Length > 0
            && !phoneNumberId.StartsWith("WEBPENDING-", StringComparison.OrdinalIgnoreCase)
            && string.IsNullOrWhiteSpace(numero.WebInstanceName))
        {
            return false;
        }

        if (phoneNumberId.StartsWith("WEBPENDING-", StringComparison.OrdinalIgnoreCase))
            return true;

        if (numero.WebWorkerProcessId.HasValue
            || numero.WebPairingGeneratedAtUtc.HasValue
            || numero.WebPairingExpiresAtUtc.HasValue
            || numero.WebRuntimeUpdatedAtUtc.HasValue)
            return true;

        if (!string.IsNullOrWhiteSpace(numero.WebPhoneNumber)
            || !string.IsNullOrWhiteSpace(numero.WebDisplayName)
            || !string.IsNullOrWhiteSpace(numero.WebInstanceName)
            || !string.IsNullOrWhiteSpace(numero.WebPairingToken)
            || !string.IsNullOrWhiteSpace(numero.WebPairingCode)
            || !string.IsNullOrWhiteSpace(numero.WebPairingQrPayload)
            || !string.IsNullOrWhiteSpace(numero.WebRuntimeState)
            || !string.IsNullOrWhiteSpace(numero.WebLastError))
            return true;

        return string.Equals(numero.WebSessionStatus, ConversacionWhatsAppWebSessionStatuses.PendingQr, StringComparison.OrdinalIgnoreCase)
            || string.Equals(numero.WebSessionStatus, ConversacionWhatsAppWebSessionStatuses.Connected, StringComparison.OrdinalIgnoreCase);
    }

    private bool ShouldShowApiNumero(ConversacionWhatsAppNumeroDto numero)
        => numero.Activo
           || numero.Usuarios.Count > 0
           || IsConfiguredGlobalApiNumero(numero);

    private bool IsConfiguredGlobalApiNumero(ConversacionWhatsAppNumeroDto numero)
        => !string.IsNullOrWhiteSpace(numero.PhoneNumberId)
           && !string.IsNullOrWhiteSpace(_config.PhoneNumberId)
           && string.Equals(numero.PhoneNumberId.Trim(), _config.PhoneNumberId.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// El estado de sesión manda sobre el último error: Baileys reporta "Stream Errored (restart
    /// required)" como parte normal y transitoria del handshake al escanear el QR (reconecta solo
    /// con las credenciales ya guardadas). Mientras el worker sigue en PENDING_QR/RECONNECTING no
    /// es un error real, aunque WebLastError tenga texto — sólo se muestra "Error" cuando el
    /// worker ya no está reintentando (WebSessionStatus == Disconnected).
    /// </summary>
    /// <summary>
    /// WebSessionStatus=PENDING_QR persiste en base tal cual lo dejó el último poll -- si el usuario
    /// canceló, navegó fuera o recargó sin que StopPolling llegara a correr un último refresh, ese
    /// PENDING_QR puede quedar viejo. Sólo es un "Esperando escaneo" real si además hay un pairing
    /// activo de ESTA sesión de UI (_pairingFlowActiveIds); si no, es un pairing abandonado y se
    /// trata visualmente como Desconectado -- nunca queda pegado en la card fuera del flujo activo.
    /// </summary>
    private bool IsStalePendingQr(ConversacionWhatsAppNumeroDto numero)
        => numero.WebSessionStatus == ConversacionWhatsAppWebSessionStatuses.PendingQr
           && !IsPairingFlowActive(numero.IdNumero);

    private AlfaTagTone GetNumeroEstadoTone(ConversacionWhatsAppNumeroDto numero)
        => numero.WebSessionStatus switch
        {
            ConversacionWhatsAppWebSessionStatuses.Connected => AlfaTagTone.Success,
            ConversacionWhatsAppWebSessionStatuses.PendingQr when !IsStalePendingQr(numero) => AlfaTagTone.Warning,
            _ when !string.IsNullOrWhiteSpace(numero.WebInstanceName) && string.IsNullOrWhiteSpace(numero.WebLastError) => AlfaTagTone.Warning,
            _ when !string.IsNullOrWhiteSpace(numero.WebLastError) => AlfaTagTone.Danger,
            _ => AlfaTagTone.Neutral
        };

    private string GetNumeroEstadoLabel(ConversacionWhatsAppNumeroDto numero)
        => numero.WebSessionStatus switch
        {
            ConversacionWhatsAppWebSessionStatuses.Connected => "Conectado",
            ConversacionWhatsAppWebSessionStatuses.PendingQr when !IsStalePendingQr(numero) => "Esperando escaneo",
            _ when !string.IsNullOrWhiteSpace(numero.WebLastError) => "Error",
            _ when !string.IsNullOrWhiteSpace(numero.WebInstanceName) => "Requiere reconexión",
            _ => "Desconectado"
        };

