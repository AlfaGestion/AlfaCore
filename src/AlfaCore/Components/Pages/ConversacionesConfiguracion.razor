    private async Task AddNumeroAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevoNumero.PhoneNumberId) || string.IsNullOrWhiteSpace(_nuevoNumero.Nombre))
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Faltan datos",
                Message = "Completá nombre y Phone Number ID antes de agregar el número."
            };
            return;
        }

        Saving = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => ConfigSvc.SaveWhatsAppNumeroAsync(_nuevoNumero),
            "No se pudo agregar el número de WhatsApp.");

        if (result.Success)
        {
            _feedback = AppUiMessage.Success("Número agregado", $"'{_nuevoNumero.Nombre}' ya está disponible.");
            _nuevoNumero = new ConversacionWhatsAppNumeroDto { Activo = true };
            await LoadNumerosAsync();
        }
        else
        {
            _feedback = result.Feedback;
        }

        Saving = false;
    }

