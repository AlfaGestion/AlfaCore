    private async Task CancelWhatsAppWebPairingAsync(ConversacionWhatsAppNumeroDto numero)
    {
        var isProvisionalNewSession = _provisionalBusinessNumeroIds.Contains(numero.IdNumero);
        StopPolling();

        PairingBusy = true;
        UpdatePageHeader();
        await InvokeAsync(StateHasChanged);

        var result = await UiOps.RunAsync(
            () => WhatsAppWebSessionSvc.StopSessionAsync(numero.IdNumero),
            "No se pudo cancelar la vinculación de WhatsApp Web.");

        if (result.Success && result.Value is not null)
        {
            _pairingFlowActiveIds.Remove(numero.IdNumero);
            if (_pairingRegenerateErrorForIdNumero == numero.IdNumero)
                _pairingRegenerateErrorForIdNumero = null;

            if (isProvisionalNewSession)
            {
                result.Value.Activo = false;
                var archiveResult = await UiOps.RunAsync(
                    () => ConfigSvc.SaveWhatsAppNumeroAsync(result.Value),
                    "Se canceló el pairing, pero no se pudo archivar el alta provisional.");

                if (archiveResult.Success)
                {
                    _provisionalBusinessNumeroIds.Remove(numero.IdNumero);
                    await LoadNumerosAsync();
                    _feedback = AppUiMessage.Success(
                        "Alta cancelada",
                        "Se detuvo el pairing y se archivó la nueva sesión incompleta.");
                }
                else
                {
                    await LoadNumerosAsync();
                    _feedback = archiveResult.Feedback;
                }
            }
            else
            {
                ReplaceNumero(result.Value);
                _feedback = AppUiMessage.Success(
                    "Vinculación cancelada",
                    "Se detuvo el pairing temporal. La sesión y sus conversaciones se conservaron.");
            }
        }
        else
        {
            _feedback = result.Feedback;
        }

        _feedbackScope = "whatsapp";
        PairingBusy = false;
        CloseConnectMethodChooser();
        UpdatePageHeader();
        await InvokeAsync(StateHasChanged);
    }

