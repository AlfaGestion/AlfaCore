@page "/auditoria/usuarios"
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Text.RegularExpressions
@inject AlfaCore.Services.IAuditoriaService AuditoriaSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject IJSRuntime JS

<PageTitle>Auditoría de usuarios | Alfa Gestión</PageTitle>

<div class="page-grid contactos-page" @onclick="HandlePageClickAsync">
        <section class="page-intro">
            <div>
                <h2 class="page-intro__title">Auditoría de usuarios</h2>
                <p class="page-intro__text">Detectá actividad sospechosa sobre comprobantes comerciales, remitos, accesos sensibles y patrones anómalos de operación.</p>
                @if (_loading)
                {
                    <p class="page-intro__text"><i class="bi bi-hourglass-split"></i> Preparando pantalla de auditoría...</p>
                }
            </div>
            <div class="actions">
                <button type="button" class="btn btn--ghost" @onclick="RecargarAsync" @onclick:stopPropagation disabled="@_loadingRows">
                    <i class="bi bi-arrow-clockwise"></i> Recargar
                </button>
            </div>
        </section>

        @if (_feedback is not null)
        {
            <section class="panel-card">
                <div class="editor-msg editor-msg--animated @GetFeedbackClass(_feedback)">
                    <div>
                        <strong>@_feedback.Title</strong>
                        <p>@_feedback.Message</p>
                        @if (_feedback.HasSuggestion)
                        {
                            <small>@_feedback.Suggestion</small>
                        }
                        @if (_feedback.HasCode)
                        {
                            <small>Código: @_feedback.Code</small>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Estado de lectura</h3>
                    <p class="panel-card__subtitle">@GetLoadingStatusMessage()</p>
                </div>
            </div>
        </section>

        @if (_showSettingsPanel)
        {
            <section class="panel-card" @onclick:stopPropagation>
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Configuración de auditoría</h3>
                        <p class="panel-card__subtitle">Definí cómo se detecta actividad fuera de horario. La sugerencia se calcula automáticamente con los últimos 90 días.</p>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarConfiguracion">
                            <i class="bi bi-x-circle"></i>
                            <span>Cerrar</span>
                        </button>
                    </div>
                </div>

                @if (_loadingSettings)
                {
                    <div class="muted">Cargando configuración e inferencia automática...</div>
                }
                else
                {
                    <div class="contactos-form__grid">
                        <div class="field field--sm">
                            <label>Hora inicio laboral</label>
                            <select @bind="_cfgHoraInicio">
                                @foreach (var hour in Enumerable.Range(0, 24))
                                {
                                    <option value="@hour">@($"{hour:00}:00")</option>
                                }
                            </select>
                        </div>
                        <div class="field field--sm">
                            <label>Hora fin laboral</label>
                            <select @bind="_cfgHoraFin">
                                @foreach (var hour in Enumerable.Range(1, 24))
                                {
                                    <option value="@hour">@($"{hour:00}:00")</option>
                                }
                            </select>
                        </div>
                        <div class="field field--md">
                            <label>Controlar PC habitual</label>
                            <select @bind="_cfgControlarPcHabitualText">
                                <option value="SI">Sí</option>
                                <option value="NO">No</option>
                            </select>
                        </div>
                        <div class="field field--full">
                            <label>Días laborales</label>
                            <div class="checkbox-row">
                                @foreach (var day in _diasSemanaOpciones)
                                {
                                    <label class="checkbox-row__item">
                                        <input type="checkbox" checked="@_cfgDiasLaborales.Contains(day.Id)" @onchange="args => ToggleDiaLaboral(day.Id, args)" />
                                        <span>@day.Label</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="field field--full">
                            <label>Sugerencia automática</label>
                            <textarea rows="3" readonly>@_settings.ResumenInferencia</textarea>
                        </div>
                    </div>

                    <div class="actions">
                        <button type="button" class="btn btn--secondary btn--sm" @onclick="AplicarSugerenciaConfiguracion" disabled="@_savingSettings">
                            <i class="bi bi-magic"></i>
                            <span>Usar sugerencia 90 días</span>
                        </button>
                        <button type="button" class="btn btn--primary btn--sm" @onclick="GuardarConfiguracionAsync" disabled="@_savingSettings">
                            <i class="bi bi-save"></i>
                            <span>Guardar configuración</span>
                        </button>
                    </div>
                }
            </section>
        }

        <section class="panel-card smart-search-card" @onclick:stopPropagation>
            <div class="smart-search">
                <div class="smart-search__bar">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           placeholder="Buscar por usuario, PC, comprobante, cliente, motivo..."
                           @bind="_texto"
                           @bind:event="oninput"
                           @onfocus="OpenSearchPanelAsync"
                           @onkeydown="HandleApplyKeyDownAsync" />
                    <button type="button" class="smart-search__toggle" @onclick="ToggleSearchPanel" aria-label="Mostrar filtros">
                        <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                    </button>
                </div>

                <div class="smart-search__chips" aria-live="polite">
                    @foreach (var chip in BuildFilterChips())
                    {
                        <button type="button" class="smart-chip" @onclick="() => RemoveChipAsync(chip.Key)">
                            @chip.Label <i class="bi bi-x"></i>
                        </button>
                    }
                    @if (BuildFilterChips().Count == 0)
                    {
                        <span class="smart-search__hint">Click en el buscador para filtros rápidos y agrupación del análisis.</span>
                    }
                </div>

                @if (_showSearchPanel)
                {
                    <div class="smart-search__panel" @onkeydown="HandleApplyKeyDownAsync">
                        <div class="smart-search__column">
                            <h4><i class="bi bi-funnel-fill"></i> Filtros</h4>
                            <div class="smart-search__inline">
                                <label>Desde</label>
                                <InputDate @bind-Value="_desde" />
                            </div>
                            <div class="smart-search__inline">
                                <label>Hasta</label>
                                <InputDate @bind-Value="_hasta" />
                            </div>
                            <div class="smart-search__inline">
                                <label>Usuario</label>
                                <select @bind="_usuario" disabled="@_loadingLookups">
                                    <option value="">Todos</option>
                                    @foreach (var item in _lookups.Usuarios)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>PC</label>
                                <select @bind="_pc" disabled="@_loadingLookups">
                                    <option value="">Todos</option>
                                    @foreach (var item in _lookups.Pcs)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="smart-search__column">
                            <h4><i class="bi bi-shield-fill-exclamation"></i> Controles</h4>
                            <div class="smart-search__inline">
                                <label>Tipo control</label>
                                <select @bind="_tipoControl" disabled="@_loadingLookups">
                                    <option value="">Todos</option>
                                    @foreach (var item in _lookups.TiposControl)
                                    {
                                        <option value="@item.Value">@item.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>Riesgo</label>
                                <select @bind="_riesgo" disabled="@_loadingLookups">
                                    <option value="">Todos</option>
                                    @foreach (var item in _lookups.Riesgos)
                                    {
                                        <option value="@item.Value">@item.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>Tipo movimiento</label>
                                <select @bind="_tipoMovimiento" disabled="@_loadingLookups">
                                    <option value="">Todos</option>
                                    @foreach (var item in _lookups.TiposMovimiento)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>TC</label>
                                <select @bind="_tipoComprobante" disabled="@_loadingLookups">
                                    <option value="">Todos</option>
                                    @foreach (var item in _lookups.TiposComprobante)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>Cliente / cuenta</label>
                                <input type="text" @bind="_cuentaCliente" list="auditoria-usuarios-clientes" placeholder="Cuenta o nombre..." disabled="@_loadingLookups" />
                                <datalist id="auditoria-usuarios-clientes">
                                    @foreach (var item in _lookups.CuentasClientes)
                                    {
                                        <option value="@item"></option>
                                    }
                                </datalist>
                            </div>
                        </div>
                        <div class="smart-search__column">
                            <h4><i class="bi bi-sliders"></i> Umbrales</h4>
                            <div class="smart-search__inline">
                                <label>Días mín. RM sin factura</label>
                                <input type="number" min="1" @bind="_diasMinimosSinFactura" />
                            </div>
                            <div class="smart-search__inline">
                                <label>Umbral modificaciones</label>
                                <input type="number" min="2" @bind="_umbralModificaciones" />
                            </div>
                            <div class="smart-search__inline">
                                <label>Días tolerancia duplicados</label>
                                <input type="number" min="0" @bind="_diasToleranciaDuplicados" />
                            </div>
                            <div class="smart-search__inline">
                                <label>Solo dif. sucursal</label>
                                <select @bind="_soloDiferenciasSucursalText">
                                    <option value="SI">Sí</option>
                                    <option value="NO">No</option>
                                </select>
                            </div>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="ToggleSettingsPanelAsync" disabled="@(_loadingRows || _savingSettings)">
                                    <i class="bi bi-sliders"></i> Configuración
                                </button>
                                <button type="button" class="btn btn--primary btn--sm" @onclick="ApplyFiltersAsync" disabled="@_loadingRows">
                                    <i class="bi bi-search"></i> Aplicar
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarAsync" disabled="@_loadingRows">
                                    <i class="bi bi-eraser"></i> Limpiar
                                </button>
                            </div>
                            @if (_loadingLookups)
                            {
                                <p class="smart-search__hint">Cargando opciones reales del período seleccionado...</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="kpi-grid">
            @if (IsActivityMode)
            {
                <article class="kpi-card">
                    <div class="kpi-card__label">Movimientos</div>
                    <div class="kpi-card__value">@_stats.TotalAlertas</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Usuarios</div>
                    <div class="kpi-card__value">@_stats.UsuariosInvolucrados</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Equipos</div>
                    <div class="kpi-card__value">@_stats.EquiposInvolucrados</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Comprobantes</div>
                    <div class="kpi-card__value">@_stats.ComprobantesInvolucrados</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Días con actividad</div>
                    <div class="kpi-card__value">@_stats.DiasConActividad</div>
                </article>
            }
            else if (IsStartedNotSavedMode)
            {
                <article class="kpi-card">
                    <div class="kpi-card__label">Comprobantes cancelados</div>
                    <div class="kpi-card__value">@_stats.TotalAlertas</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Promedio min. cancelación</div>
                    <div class="kpi-card__value">@FormatMinutesMetric(_stats.PromedioMinutosCancelacion)</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Máx. min. cancelación</div>
                    <div class="kpi-card__value">@FormatMinutesMetric(_stats.MaximoMinutosCancelacion)</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Importe total cancelado</div>
                    <div class="kpi-card__value">@FormatMoney(_stats.ImporteTotalCancelado)</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Usuarios involucrados</div>
                    <div class="kpi-card__value">@_stats.UsuariosInvolucrados</div>
                </article>
            }
            else
            {
                <article class="kpi-card">
                    <div class="kpi-card__label">@GetTotalKpiLabel()</div>
                    <div class="kpi-card__value">@GetTotalKpiValue()</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Riesgo alto</div>
                    <div class="kpi-card__value">@_stats.RiesgoAlto</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">Riesgo medio</div>
                    <div class="kpi-card__value">@_stats.RiesgoMedio</div>
                </article>
                <article class="kpi-card">
                    <div class="kpi-card__label">@GetFourthKpiLabel()</div>
                    <div class="kpi-card__value">@GetFourthKpiValue()</div>
                </article>
                @if (IsDuplicateMode)
                {
                    <article class="kpi-card">
                        <div class="kpi-card__label">Contables duplicados</div>
                        <div class="kpi-card__value">@_stats.ContablesDuplicados</div>
                    </article>
                }
            }
        </section>

        @if (_selected is not null)
        {
            <section class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">@(IsActivityMode ? "Detalle de actividad" : "Detalle de alerta")</h3>
                        <p class="panel-card__subtitle">@_selected.TipoControlLabel · @_selected.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--secondary btn--sm" @onclick="CerrarDetalle">
                            <i class="bi bi-arrow-left-circle"></i>
                            <span>Volver al listado</span>
                        </button>
                        @if (!IsCompraDuplicadoAudit(_selected) && CanOpenComprobante(_selected))
                        {
                            <a class="btn btn--ghost btn--sm" href="@BuildComprobanteViewerUrl(_selected)">
                                <i class="bi bi-box-arrow-up-right"></i>
                                <span>Abrir comprobantes</span>
                            </a>
                        }
                    </div>
                </div>

                @if (IsActivityMode)
                {
                    <div class="contactos-form__grid">
                        <div class="field">
                            <label>Fecha y hora</label>
                            <input value="@_selected.FechaHora.ToString("dd/MM/yyyy HH:mm")" readonly />
                        </div>
                        <div class="field">
                            <label>Usuario</label>
                            <input value="@_selected.Usuario" readonly />
                        </div>
                        <div class="field">
                            <label>PC</label>
                            <input value="@_selected.Pc" readonly />
                        </div>
                        <div class="field">
                            <label>Origen</label>
                            <input value="@_selected.Origen" readonly />
                        </div>
                        <div class="field">
                            <label>Tipo movimiento</label>
                            <input value="@_selected.TipoMovimiento" readonly />
                        </div>
                        <div class="field">
                            <label>TC / comprobante</label>
                            <input value="@($"{_selected.TipoComprobante} {_selected.IdComprobante}".Trim())" readonly />
                        </div>
                        <div class="field">
                            <label>Cliente / cuenta</label>
                            <input value="@FormatCliente(_selected)" readonly />
                        </div>
                        <div class="field">
                            <label>Proceso / formulario</label>
                            <input value="@BuildProcessLabel(_selected)" readonly />
                        </div>
                        <div class="field">
                            <label>Importe</label>
                            <input value="@FormatMoney(_selected.ImporteOriginal)" readonly />
                        </div>
                        <div class="field">
                            <label>Tiene asiento</label>
                            <input value="@FormatBool(_selected.TieneAsiento)" readonly />
                        </div>
                        <div class="field">
                            <label>Tiene stock</label>
                            <input value="@FormatBool(_selected.TieneStock)" readonly />
                        </div>
                        <div class="field field--full">
                            <label>Descripción</label>
                            <textarea rows="3" readonly>@_selected.Descripcion</textarea>
                        </div>
                        <div class="field field--full">
                            <label>Motivo</label>
                            <textarea rows="3" readonly>@_selected.Motivo</textarea>
                        </div>
                        <div class="field field--full">
                            <label>Observaciones</label>
                            <textarea rows="4" readonly>@_selected.Observaciones</textarea>
                        </div>
                    </div>
                }
                else if (IsCompraDuplicadoAudit(_selected))
                {
                    <div class="contactos-form__grid">
                        <div class="field">
                            <label>Riesgo</label>
                            <input value="@_selected.Riesgo" readonly />
                        </div>
                        <div class="field">
                            <label>Proveedor / cuenta</label>
                            <input value="@FormatCliente(_selected)" readonly />
                        </div>
                        <div class="field">
                            <label>TC</label>
                            <input value="@_selected.TipoComprobante" readonly />
                        </div>
                        <div class="field">
                            <label>Número normalizado</label>
                            <input value="@_selected.NumeroNormalizado" readonly />
                        </div>
                        <div class="field">
                            <label>Importe</label>
                            <input value="@FormatMoney(_selected.ImporteOriginal)" readonly />
                        </div>
                        <div class="field">
                            <label>Coincidencias</label>
                            <input value="@_selected.CantidadOcurrencias.ToString()" readonly />
                        </div>
                        <div class="field">
                            <label>Sucursales detectadas</label>
                            <input value="@_selected.SucursalesDetectadas" readonly />
                        </div>
                        <div class="field">
                            <label>Usuarios detectados</label>
                            <input value="@_selected.UsuariosDetectados" readonly />
                        </div>
                        <div class="field">
                            <label>Fecha mínima</label>
                            <input value="@_selected.FechaHora.ToString("dd/MM/yyyy HH:mm")" readonly />
                        </div>
                        <div class="field">
                            <label>Fecha máxima</label>
                            <input value="@(_selected.FechaHoraHasta?.ToString("dd/MM/yyyy HH:mm") ?? "—")" readonly />
                        </div>
                        <div class="field">
                            <label>Impacto contable</label>
                            <input value="@_selected.ImpactoContable" readonly />
                        </div>
                        <div class="field">
                            <label>Comprobantes con asiento</label>
                            <input value="@_selected.ContablesDuplicados.ToString()" readonly />
                        </div>
                        <div class="field field--full">
                            <label>Motivo</label>
                            <textarea rows="3" readonly>@_selected.Motivo</textarea>
                        </div>
                        <div class="field field--full">
                            <label>Criterio aplicado</label>
                            <textarea rows="3" readonly>@_selected.Observaciones</textarea>
                        </div>
                        <div class="field field--full">
                            <label>Comprobantes involucrados</label>
                            <textarea rows="12" readonly>@_selected.DetalleGrupo</textarea>
                        </div>
                    </div>
                }
                else
                {
                    <div class="contactos-form__grid">
                        <div class="field">
                            <label>Riesgo</label>
                            <input value="@_selected.Riesgo" readonly />
                        </div>
                        <div class="field">
                            <label>Usuario</label>
                            <input value="@_selected.Usuario" readonly />
                        </div>
                        <div class="field">
                            <label>PC</label>
                            <input value="@_selected.Pc" readonly />
                        </div>
                        <div class="field">
                            <label>TC / comprobante</label>
                            <input value="@($"{_selected.TipoComprobante} {_selected.IdComprobante}")" readonly />
                        </div>
                        <div class="field">
                            <label>Cliente / cuenta</label>
                            <input value="@FormatCliente(_selected)" readonly />
                        </div>
                        <div class="field">
                            <label>Proceso / formulario</label>
                            <input value="@BuildProcessLabel(_selected)" readonly />
                        </div>
                        <div class="field">
                            <label>Importe original</label>
                            <input value="@FormatMoney(_selected.ImporteOriginal)" readonly />
                        </div>
                        <div class="field">
                            <label>Importe aplicado</label>
                            <input value="@FormatMoney(_selected.ImporteAplicado)" readonly />
                        </div>
                        <div class="field">
                            <label>Diferencia</label>
                            <input value="@FormatMoney(_selected.Diferencia)" readonly />
                        </div>
                        <div class="field">
                            <label>Ocurrencias</label>
                            <input value="@_selected.CantidadOcurrencias.ToString()" readonly />
                        </div>
                        <div class="field">
                            <label>Factura relacionada</label>
                            <input value="@_selected.FacturaRelacionada" readonly />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_selected.EstadoFacturacion))
                        {
                            <div class="field">
                                <label>Estado de facturación</label>
                                <input value="@_selected.EstadoFacturacion" readonly />
                            </div>
                        }
                        @if (HasCancellationTrace(_selected))
                        {
                            <div class="field">
                                <label>Hora cancelación</label>
                                <input value="@GetCancellationTimeText(_selected)" readonly />
                            </div>
                            <div class="field">
                                <label>Minutos hasta cancelación</label>
                                <input value="@GetCancellationMinutesText(_selected)" readonly />
                            </div>
                            <div class="field">
                                <label>Importe al cancelar</label>
                                <input value="@GetCancellationAmountText(_selected)" readonly />
                            </div>
                            <div class="field field--full">
                                <label>Traza original del sistema</label>
                                <textarea rows="3" readonly>@_selected.SystemUserDetalle</textarea>
                            </div>
                        }
                        <div class="field">
                            <label>Días pendientes</label>
                            <input value="@(_selected.DiasPendientes > 0 ? _selected.DiasPendientes.ToString() : string.Empty)" readonly />
                        </div>
                        @if (IsRemitoAudit(_selected))
                        {
                            <div class="field field--full">
                                <label>Detalle técnico de comparación</label>
                                <textarea rows="6" readonly>@BuildRemitoTechnicalDetail(_selected)</textarea>
                            </div>
                            <div class="field field--full">
                                <label>Tablas y vínculos usados</label>
                                <textarea rows="4" readonly>@BuildRemitoTechnicalSources(_selected)</textarea>
                            </div>
                            <div class="field field--full">
                                <div class="actions">
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="ToggleRemitoSqlPreview">
                                        <i class="bi bi-code-slash"></i>
                                        <span>@(_showRemitoSqlPreview ? "Ocultar consulta SQL" : "Ver consulta SQL")</span>
                                    </button>
                                </div>
                            </div>
                            @if (_showRemitoSqlPreview)
                            {
                                <div class="field field--full">
                                    <label>Consulta SQL simplificada</label>
                                    <textarea rows="16" readonly>@BuildRemitoSqlPreview()</textarea>
                                </div>
                            }
                        }
                        <div class="field field--full">
                            <label>Motivo</label>
                            <textarea rows="3" readonly>@_selected.Motivo</textarea>
                        </div>
                        <div class="field field--full">
                            <label>Observaciones</label>
                            <textarea rows="4" readonly>@_selected.Observaciones</textarea>
                        </div>
                    </div>
                }
            </section>
        }
        else
        {
            @if (!_hasSearched)
            {
                <section class="three-grid">
                    <article class="panel-card">
                        <div class="panel-card__header">
                            <div>
                                <h3 class="panel-card__title">Carga inicial liviana</h3>
                                <p class="panel-card__subtitle">La auditoría no consulta movimientos hasta que apliques filtros.</p>
                            </div>
                        </div>
                        <p class="page-intro__text">Abrí el panel de filtros, elegí período o usuario y luego presioná <code>Aplicar</code>.</p>
                    </article>
                    <article class="panel-card">
                        <div class="panel-card__header">
                            <div>
                                <h3 class="panel-card__title">Actividad de usuario</h3>
                                <p class="panel-card__subtitle">Timeline operativo agrupado por día.</p>
                            </div>
                        </div>
                        <p class="page-intro__text">Sirve para reconstruir qué hizo un usuario, desde qué PC y sobre qué comprobantes.</p>
                    </article>
                    <article class="panel-card">
                        <div class="panel-card__header">
                            <div>
                                <h3 class="panel-card__title">Alertas bajo demanda</h3>
                                <p class="panel-card__subtitle">Remitos, bajas, duplicados y controles existentes.</p>
                            </div>
                        </div>
                        <p class="page-intro__text">Se cargan solo cuando ejecutás la búsqueda para evitar esperas al ingresar.</p>
                    </article>
                </section>
            }

            <section class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Resultados</h3>
                        <p class="panel-card__subtitle @(_loadingRows ? "audit-reading-text" : string.Empty)">
                            @if (_loadingRows)
                            {
                                <span>Leyendo datos de auditoría. Esperá unos segundos...</span>
                            }
                            else if (_hasSearched)
                            {
                                @(IsActivityMode ? $"{_result.TotalRegistros} movimiento(s) detectado(s)." : $"{_result.TotalRegistros} alerta(s) detectada(s).")
                                <span> Página @_pagina de @TotalPaginas.</span>
                            }
                            else
                            {
                                <span>Definí filtros y ejecutá la búsqueda para cargar resultados.</span>
                            }
                        </p>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="ExportarPdfAsync" disabled="@(_loadingRows || !_hasSearched)">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>PDF</span>
                        </button>
                        <a class="btn btn--ghost btn--sm @(!_hasSearched ? "is-disabled" : string.Empty)" href="@(_hasSearched ? BuildExcelExportUrl() : "#")" aria-disabled="@(!_hasSearched)">
                            <i class="bi bi-file-earmark-excel"></i>
                            <span>Excel</span>
                        </a>
                        <div class="field field--inline">
                            <label>Tamaño</label>
                            <select value="@_tamanioPagina" @onchange="OnPageSizeChangedAsync">
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                    </div>
                </div>

                @if (_loadingRows)
                {
                    <div class="audit-reading-banner">
                        <div>
                            <strong>Procesando consulta</strong>
                            <p>La auditoría está leyendo información de la base activa.</p>
                        </div>
                    </div>
                }

                <div class="table-wrap">
                    <table class="data-table usuarios-table audit-users-table">
                        <thead>
                            @if (IsActivityMode)
                            {
                                <tr>
                                    <th><button type="button" class="table-sort @GetSortClass("fecha")" @onclick='() => ToggleSortAsync("fecha")'><span class="table-sort__label">Fecha y hora</span><span class="table-sort__mark">@SortMark("fecha")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("usuario")" @onclick='() => ToggleSortAsync("usuario")'><span class="table-sort__label">Usuario</span><span class="table-sort__mark">@SortMark("usuario")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("pc")" @onclick='() => ToggleSortAsync("pc")'><span class="table-sort__label">PC</span><span class="table-sort__mark">@SortMark("pc")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("origen")" @onclick='() => ToggleSortAsync("origen")'><span class="table-sort__label">Origen</span><span class="table-sort__mark">@SortMark("origen")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("tipomovimiento")" @onclick='() => ToggleSortAsync("tipomovimiento")'><span class="table-sort__label">Tipo de movimiento</span><span class="table-sort__mark">@SortMark("tipomovimiento")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("tc")" @onclick='() => ToggleSortAsync("tc")'><span class="table-sort__label">TC</span><span class="table-sort__mark">@SortMark("tc")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("comprobante")" @onclick='() => ToggleSortAsync("comprobante")'><span class="table-sort__label">Comprobante</span><span class="table-sort__mark">@SortMark("comprobante")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("cliente")" @onclick='() => ToggleSortAsync("cliente")'><span class="table-sort__label">Cuenta / nombre</span><span class="table-sort__mark">@SortMark("cliente")</span></button></th>
                                    <th>Descripción</th>
                                    <th><button type="button" class="table-sort @GetSortClass("importe")" @onclick='() => ToggleSortAsync("importe")'><span class="table-sort__label">Importe</span><span class="table-sort__mark">@SortMark("importe")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("asiento")" @onclick='() => ToggleSortAsync("asiento")'><span class="table-sort__label">Asiento</span><span class="table-sort__mark">@SortMark("asiento")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("stock")" @onclick='() => ToggleSortAsync("stock")'><span class="table-sort__label">Stock</span><span class="table-sort__mark">@SortMark("stock")</span></button></th>
                                    <th>Acciones</th>
                                </tr>
                            }
                            else if (IsDuplicateMode)
                            {
                                <tr>
                                    <th><button type="button" class="table-sort @GetSortClass("riesgo")" @onclick='() => ToggleSortAsync("riesgo")'><span class="table-sort__label">Riesgo</span><span class="table-sort__mark">@SortMark("riesgo")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("cliente")" @onclick='() => ToggleSortAsync("cliente")'><span class="table-sort__label">Proveedor / cuenta</span><span class="table-sort__mark">@SortMark("cliente")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("tc")" @onclick='() => ToggleSortAsync("tc")'><span class="table-sort__label">TC</span><span class="table-sort__mark">@SortMark("tc")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("numero")" @onclick='() => ToggleSortAsync("numero")'><span class="table-sort__label">Número normalizado</span><span class="table-sort__mark">@SortMark("numero")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("importe")" @onclick='() => ToggleSortAsync("importe")'><span class="table-sort__label">Importe</span><span class="table-sort__mark">@SortMark("importe")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("cantidad")" @onclick='() => ToggleSortAsync("cantidad")'><span class="table-sort__label">Coincidencias</span><span class="table-sort__mark">@SortMark("cantidad")</span></button></th>
                                    <th>Sucursales</th>
                                    <th>Usuarios</th>
                                    <th><button type="button" class="table-sort @GetSortClass("fecha")" @onclick='() => ToggleSortAsync("fecha")'><span class="table-sort__label">Fecha mínima</span><span class="table-sort__mark">@SortMark("fecha")</span></button></th>
                                    <th>Fecha máxima</th>
                                    <th><button type="button" class="table-sort @GetSortClass("impactocontable")" @onclick='() => ToggleSortAsync("impactocontable")'><span class="table-sort__label">Impacto contable</span><span class="table-sort__mark">@SortMark("impactocontable")</span></button></th>
                                    <th>Acciones</th>
                                </tr>
                            }
                            else if (IsStartedNotSavedMode)
                            {
                                <tr>
                                    <th><button type="button" class="table-sort @GetSortClass("fecha")" @onclick='() => ToggleSortAsync("fecha")'><span class="table-sort__label">Fecha inicio</span><span class="table-sort__mark">@SortMark("fecha")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("control")" @onclick='() => ToggleSortAsync("control")'><span class="table-sort__label">Tipo de control</span><span class="table-sort__mark">@SortMark("control")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("riesgo")" @onclick='() => ToggleSortAsync("riesgo")'><span class="table-sort__label">Nivel de riesgo</span><span class="table-sort__mark">@SortMark("riesgo")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("usuario")" @onclick='() => ToggleSortAsync("usuario")'><span class="table-sort__label">Usuario</span><span class="table-sort__mark">@SortMark("usuario")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("pc")" @onclick='() => ToggleSortAsync("pc")'><span class="table-sort__label">Equipo</span><span class="table-sort__mark">@SortMark("pc")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("tc")" @onclick='() => ToggleSortAsync("tc")'><span class="table-sort__label">Tipo comp.</span><span class="table-sort__mark">@SortMark("tc")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("comprobante")" @onclick='() => ToggleSortAsync("comprobante")'><span class="table-sort__label">N° comprobante</span><span class="table-sort__mark">@SortMark("comprobante")</span></button></th>
                                    <th>Hora cancelación</th>
                                    <th>Minutos</th>
                                    <th>Importe al cancelar</th>
                                    <th>Acciones</th>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <th><button type="button" class="table-sort @GetSortClass("fecha")" @onclick='() => ToggleSortAsync("fecha")'><span class="table-sort__label">Fecha y hora</span><span class="table-sort__mark">@SortMark("fecha")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("control")" @onclick='() => ToggleSortAsync("control")'><span class="table-sort__label">Tipo de control</span><span class="table-sort__mark">@SortMark("control")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("riesgo")" @onclick='() => ToggleSortAsync("riesgo")'><span class="table-sort__label">Nivel de riesgo</span><span class="table-sort__mark">@SortMark("riesgo")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("usuario")" @onclick='() => ToggleSortAsync("usuario")'><span class="table-sort__label">Usuario</span><span class="table-sort__mark">@SortMark("usuario")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("pc")" @onclick='() => ToggleSortAsync("pc")'><span class="table-sort__label">Equipo</span><span class="table-sort__mark">@SortMark("pc")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("tc")" @onclick='() => ToggleSortAsync("tc")'><span class="table-sort__label">Tipo comp.</span><span class="table-sort__mark">@SortMark("tc")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("comprobante")" @onclick='() => ToggleSortAsync("comprobante")'><span class="table-sort__label">N° comprobante</span><span class="table-sort__mark">@SortMark("comprobante")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("cliente")" @onclick='() => ToggleSortAsync("cliente")'><span class="table-sort__label">Cliente / cuenta</span><span class="table-sort__mark">@SortMark("cliente")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("estadofacturacion")" @onclick='() => ToggleSortAsync("estadofacturacion")'><span class="table-sort__label">Estado remito</span><span class="table-sort__mark">@SortMark("estadofacturacion")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("importe")" @onclick='() => ToggleSortAsync("importe")'><span class="table-sort__label">Importe base</span><span class="table-sort__mark">@SortMark("importe")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("diferencia")" @onclick='() => ToggleSortAsync("diferencia")'><span class="table-sort__label">Diferencia</span><span class="table-sort__mark">@SortMark("diferencia")</span></button></th>
                                    <th><button type="button" class="table-sort @GetSortClass("cantidad")" @onclick='() => ToggleSortAsync("cantidad")'><span class="table-sort__label">Ocurrencias</span><span class="table-sort__mark">@SortMark("cantidad")</span></button></th>
                                    <th>Acciones</th>
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @if (!_hasSearched)
                            {
                                <tr>
                                    <td colspan="@GetResultColumnCount()" class="muted">Todavía no se ejecutó una búsqueda.</td>
                                </tr>
                            }
                            else if (_loadingRows)
                            {
                                <tr>
                                    <td colspan="@GetResultColumnCount()" class="muted">Cargando resultados de auditoría...</td>
                                </tr>
                            }
                            else if (_rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="@GetResultColumnCount()" class="muted">@(IsActivityMode ? "No se encontraron movimientos con los filtros actuales." : "No se encontraron alertas con los filtros actuales.")</td>
                                </tr>
                            }
                            else
                            {
                                @if (IsActivityMode)
                                {
                                    @foreach (var userGroup in BuildActivityGroups())
                                    {
                                        <tr class="usuarios-group-row audit-activity-group audit-activity-group--user">
                                            <td colspan="@GetResultColumnCount()">@userGroup.Label</td>
                                        </tr>
                                        @foreach (var dayGroup in userGroup.Days)
                                        {
                                            <tr class="usuarios-group-row audit-activity-group audit-activity-group--day">
                                                <td colspan="@GetResultColumnCount()">@dayGroup.Label</td>
                                            </tr>
                                            @foreach (var item in dayGroup.Items)
                                            {
                                                <tr @ondblclick="() => Seleccionar(item)">
                                                    <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@item.Usuario</td>
                                                    <td>@item.Pc</td>
                                                    <td>@item.Origen</td>
                                                    <td>@item.TipoMovimiento</td>
                                                    <td>@item.TipoComprobante</td>
                                                    <td>@item.IdComprobante</td>
                                                    <td>@FormatCliente(item)</td>
                                                    <td>@item.Descripcion</td>
                                                    <td>@FormatMoney(item.ImporteOriginal)</td>
                                                    <td>@FormatBool(item.TieneAsiento)</td>
                                                    <td>@FormatBool(item.TieneStock)</td>
                                                    <td>
                                                        <div class="actions">
                                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => Seleccionar(item)">
                                                                <i class="bi bi-eye"></i>
                                                                <span>Detalle</span>
                                                            </button>
                                                            @if (CanOpenComprobante(item))
                                                            {
                                                                <a class="btn btn--ghost btn--sm" href="@BuildComprobanteViewerUrl(item)">
                                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                                    <span>Comprobante</span>
                                                                </a>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    @foreach (var item in _rows)
                                    {
                                        @if (IsCompraDuplicadoAudit(item))
                                        {
                                            <tr @ondblclick="() => Seleccionar(item)">
                                                <td><span class="@GetRiskBadgeClass(item.Riesgo)">@item.Riesgo</span></td>
                                                <td>@FormatCliente(item)</td>
                                                <td>@item.TipoComprobante</td>
                                                <td>@item.NumeroNormalizado</td>
                                                <td>@FormatMoney(item.ImporteOriginal)</td>
                                                <td>@item.CantidadOcurrencias</td>
                                                <td>@item.SucursalesDetectadas</td>
                                                <td>@item.UsuariosDetectados</td>
                                                <td>@item.FechaHora.ToString("dd/MM/yyyy")</td>
                                                <td>@(item.FechaHoraHasta?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td>@item.ImpactoContable</td>
                                                <td>
                                                    <div class="actions">
                                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => Seleccionar(item)">
                                                            <i class="bi bi-eye"></i>
                                                            <span>Detalle</span>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else if (string.Equals(item.TipoControl, "IN_NO_GRABADO", StringComparison.OrdinalIgnoreCase) && IsStartedNotSavedMode)
                                        {
                                            <tr @ondblclick="() => Seleccionar(item)">
                                                <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@item.TipoControlLabel</td>
                                                <td><span class="@GetRiskBadgeClass(item.Riesgo)">@item.Riesgo</span></td>
                                                <td>@item.Usuario</td>
                                                <td>@item.Pc</td>
                                                <td>@item.TipoComprobante</td>
                                                <td>@item.IdComprobante</td>
                                                <td>@GetCancellationTimeText(item)</td>
                                                <td>@GetCancellationMinutesText(item)</td>
                                                <td>@GetCancellationAmountText(item)</td>
                                                <td>
                                                    <div class="actions">
                                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => Seleccionar(item)">
                                                            <i class="bi bi-eye"></i>
                                                            <span>Detalle</span>
                                                        </button>
                                                        <a class="btn btn--ghost btn--sm" href="@BuildComprobanteViewerUrl(item)">
                                                            <i class="bi bi-box-arrow-up-right"></i>
                                                            <span>Comprobantes</span>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr @ondblclick="() => Seleccionar(item)">
                                                <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@item.TipoControlLabel</td>
                                                <td><span class="@GetRiskBadgeClass(item.Riesgo)">@item.Riesgo</span></td>
                                                <td>@item.Usuario</td>
                                                <td>@item.Pc</td>
                                                <td>@item.TipoComprobante</td>
                                                <td>@item.IdComprobante</td>
                                                <td>@FormatCliente(item)</td>
                                                <td>@FormatEstadoFacturacion(item)</td>
                                                <td>@FormatMoney(item.ImporteOriginal)</td>
                                                <td>@FormatMoney(item.Diferencia)</td>
                                                <td>@item.CantidadOcurrencias</td>
                                                <td>
                                                    <div class="actions">
                                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => Seleccionar(item)">
                                                            <i class="bi bi-eye"></i>
                                                            <span>Detalle</span>
                                                        </button>
                                                        <a class="btn btn--ghost btn--sm" href="@BuildComprobanteViewerUrl(item)">
                                                            <i class="bi bi-box-arrow-up-right"></i>
                                                            <span>Comprobantes</span>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pager-bar">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="AnteriorAsync" disabled="@(_pagina <= 1 || _loadingRows)">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </button>
                    <span>Página @_pagina de @TotalPaginas</span>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="SiguienteAsync" disabled="@(_pagina >= TotalPaginas || _loadingRows)">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </section>
        }
</div>

@code {
    private bool _loading = true;
    private bool _loadingLookups;
    private bool _loadingRows;
    private bool _loadingSettings;
    private bool _savingSettings;
    private bool _showSearchPanel;
    private bool _showSettingsPanel;
    private bool _showRemitoSqlPreview;
    private bool _initialLoadDone;
    private bool _hasSearched;
    private bool _lookupsLoaded;
    private bool _settingsLoaded;
    private AppUiMessage? _feedback;
    private AuditoriaUsuarioLookupsDto _lookups = new();
    private AuditoriaUsuarioSettingsDto _settings = new();
    private AuditoriaUsuarioResultDto _result = new();
    private AuditoriaUsuarioStatsDto _stats = new();
    private List<AuditoriaUsuarioRowDto> _rows = [];
    private AuditoriaUsuarioRowDto? _selected;
    private DateTime? _desde = DateTime.Today.AddDays(-15);
    private DateTime? _hasta = DateTime.Today;
    private string _texto = string.Empty;
    private string _usuario = string.Empty;
    private string _pc = string.Empty;
    private string _tipoMovimiento = string.Empty;
    private string _tipoComprobante = string.Empty;
    private string _riesgo = string.Empty;
    private string _tipoControl = string.Empty;
    private string _cuentaCliente = string.Empty;
    private int _diasMinimosSinFactura = 2;
    private int _umbralModificaciones = 3;
    private int _diasToleranciaDuplicados = 7;
    private string _soloDiferenciasSucursalText = "SI";
    private int _pagina = 1;
    private int _tamanioPagina = 50;
    private string _ordenCampo = "fecha";
    private string _ordenDireccion = "desc";
    private int _cfgHoraInicio = 6;
    private int _cfgHoraFin = 21;
    private HashSet<int> _cfgDiasLaborales = [1, 2, 3, 4, 5];
    private string _cfgControlarPcHabitualText = "SI";
    private static readonly (int Id, string Label)[] _diasSemanaOpciones =
    [
        (1, "Lun"),
        (2, "Mar"),
        (3, "Mié"),
        (4, "Jue"),
        (5, "Vie"),
        (6, "Sáb"),
        (7, "Dom")
    ];

    protected override Task OnInitializedAsync()
        => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadDone)
            return;

        _initialLoadDone = true;
        await InicializarAsync();
    }

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling((_result.TotalRegistros <= 0 ? 1m : _result.TotalRegistros) / (decimal)Math.Max(1, _tamanioPagina)));
    private bool IsActivityMode => string.Equals(_tipoControl, "ACTIVIDAD_USUARIO", StringComparison.OrdinalIgnoreCase);
    private bool IsDuplicateMode => string.Equals(_tipoControl, "CPRA_DUPLICADO", StringComparison.OrdinalIgnoreCase);
    private bool IsStartedNotSavedMode => string.Equals(_tipoControl, "IN_NO_GRABADO", StringComparison.OrdinalIgnoreCase);
    private bool SoloDiferenciasSucursal => string.Equals(_soloDiferenciasSucursalText, "SI", StringComparison.OrdinalIgnoreCase);

    private AuditoriaUsuarioFilterDto _filters => new()
    {
        Desde = _desde,
        Hasta = _hasta,
        Texto = _texto,
        Usuario = _usuario,
        Pc = _pc,
        TipoMovimiento = _tipoMovimiento,
        TipoComprobante = _tipoComprobante,
        Riesgo = _riesgo,
        TipoControl = _tipoControl,
        CuentaCliente = _cuentaCliente,
        DiasMinimosSinFactura = _diasMinimosSinFactura,
        UmbralModificaciones = _umbralModificaciones,
        DiasToleranciaDuplicados = _diasToleranciaDuplicados,
        SoloDiferenciasSucursal = SoloDiferenciasSucursal,
        Pagina = _pagina,
        TamanioPagina = _tamanioPagina,
        SoloResumen = false,
        OrdenCampo = _ordenCampo,
        OrdenDireccion = _ordenDireccion
    };

    private async Task BuscarAsync()
    {
        _loadingRows = true;
        _feedback = null;
        var result = await UiOps.RunAsync(async () =>
        {
            _result = await AuditoriaSvc.SearchUserAuditAsync(_filters);
            _stats = _result.Stats;
            _rows = _result.Items.ToList();
            if (_selected is not null)
            {
                _selected = _rows.FirstOrDefault(x =>
                    x.TipoControl == _selected.TipoControl
                    && x.FechaHora == _selected.FechaHora
                    && x.Usuario == _selected.Usuario
                    && x.IdComprobante == _selected.IdComprobante
                    && x.NumeroNormalizado == _selected.NumeroNormalizado
                    && x.Descripcion == _selected.Descripcion);
            }
        }, IsActivityMode ? "No se pudieron cargar los movimientos de actividad." : "No se pudieron cargar las alertas de auditoría.");

        _feedback = result.Success ? null : result.Feedback;
        _hasSearched = result.Success;
        _loadingRows = false;
    }

    private async Task RecargarAsync()
    {
        await CargarLookupsAsync(force: true);
        await CargarConfiguracionAsync(force: true);
        if (_hasSearched)
            await BuscarAsync();
    }

    private async Task LimpiarAsync()
    {
        _desde = DateTime.Today.AddDays(-15);
        _hasta = DateTime.Today;
        _texto = string.Empty;
        _usuario = string.Empty;
        _pc = string.Empty;
        _tipoMovimiento = string.Empty;
        _tipoComprobante = string.Empty;
        _riesgo = string.Empty;
        _tipoControl = string.Empty;
        _cuentaCliente = string.Empty;
        _diasMinimosSinFactura = _lookups.DiasMinimosSinFacturaDefault > 0 ? _lookups.DiasMinimosSinFacturaDefault : 2;
        _umbralModificaciones = _lookups.UmbralModificacionesDefault > 0 ? _lookups.UmbralModificacionesDefault : 3;
        _diasToleranciaDuplicados = _lookups.DiasToleranciaDuplicadosDefault > 0 ? _lookups.DiasToleranciaDuplicadosDefault : 7;
        _soloDiferenciasSucursalText = _lookups.SoloDiferenciasSucursalDefault ? "SI" : "NO";
        _pagina = 1;
        _showSearchPanel = false;
        _hasSearched = false;
        _rows.Clear();
        _selected = null;
    }

