    private static string BuildRemitoTechnicalDetail(AuditoriaUsuarioRowDto item)
    {
        var lines = new List<string>
        {
            $"Regla evaluada: {item.EstadoFacturacion}.",
            $"Importe remito (V_MV_Cpte.IMPORTE): {FormatMoney(item.ImporteOriginal)}.",
            $"Importe aplicado (SUM(MV_APLICACION.IMPORTE)): {FormatMoney(item.ImporteAplicado)}.",
            $"Diferencia calculada: {FormatMoney(item.Diferencia)}."
        };

        if (!string.IsNullOrWhiteSpace(item.FacturaRelacionada))
            lines.Add($"Comprobantes relacionados detectados: {item.FacturaRelacionada}.");

        lines.Add(item.TipoControl switch
        {
            "RM_PARCIAL" => "Criterio: el importe aplicado es mayor que cero y menor que el importe original del remito.",
            "RM_SIN_FACTURA" => "Criterio: el importe aplicado es cero y superó el umbral mínimo de días configurado.",
            "RM_DE_MAS" => "Criterio: el importe aplicado es mayor que el importe original del remito.",
            _ => string.Empty
        });

        return string.Join(Environment.NewLine, lines.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string BuildRemitoTechnicalSources(AuditoriaUsuarioRowDto item)
    {
        var relation = string.IsNullOrWhiteSpace(item.FacturaRelacionada)
            ? "Se buscó relación por MV_APLICACION usando TCO_ORIGEN = 'RM' e IDComprobante_Origen = IDCOMPROBANTE del remito."
            : $"Relación encontrada en MV_APLICACION: {item.FacturaRelacionada}.";

        return string.Join(Environment.NewLine, new[]
        {
            "1. V_MV_Cpte: cabecera del remito, fecha, cuenta, cliente e importe original.",
            "2. MV_APLICACION: suma de importes aplicados al remito para TC FC, FP, TK y TKFC.",
            "3. MA_CUENTAS: nombre de cliente como respaldo cuando la vista no lo informa.",
            relation
        });
    }

    private static string BuildRemitoSqlPreview()
        => string.Join(Environment.NewLine, new[]
        {
            "SELECT",
            "    r.TC,",
            "    r.IDCOMPROBANTE,",
            "    r.FECHA,",
            "    r.Usuario,",
            "    r.CUENTA,",
            "    r.NOMBRE,",
            "    r.IMPORTE,",
            "    ROUND(ISNULL(ar.ImporteAplicado, 0), 2) AS ImporteAplicado,",
            "    ROUND(r.IMPORTE - ISNULL(ar.ImporteAplicado, 0), 2) AS Diferencia,",
            "    ISNULL(fr.Facturas, '') AS FacturasRelacionadas,",
            "    CASE",
            "        WHEN ROUND(ISNULL(ar.ImporteAplicado, 0), 2) = 0 THEN 'SIN FACTURAR'",
            "        WHEN ROUND(ISNULL(ar.ImporteAplicado, 0), 2) < ROUND(r.IMPORTE, 2) THEN 'FACTURADO PARCIAL'",
            "        WHEN ROUND(ISNULL(ar.ImporteAplicado, 0), 2) = ROUND(r.IMPORTE, 2) THEN 'FACTURADO TOTAL'",
            "        WHEN ROUND(ISNULL(ar.ImporteAplicado, 0), 2) > ROUND(r.IMPORTE, 2) THEN 'FACTURADO DE MAS'",
            "        ELSE 'REVISAR'",
            "    END AS EstadoFacturacion",
            "FROM dbo.V_MV_Cpte r",
            "LEFT JOIN (",
            "    SELECT",
            "        ap.IDComprobante_Origen,",
            "        SUM(CASE",
            "            WHEN ap.TC IN ('FC','FP','TK','TKFC') THEN ISNULL(ap.IMPORTE, 0)",
            "            ELSE 0",
            "        END) AS ImporteAplicado",
            "    FROM dbo.MV_APLICACION ap",
            "    WHERE ap.TCO_ORIGEN = 'RM'",
            "    GROUP BY ap.IDComprobante_Origen",
            ") ar",
            "    ON ar.IDComprobante_Origen = r.IDCOMPROBANTE",
            "LEFT JOIN (",
            "    SELECT",
            "        ap.IDComprobante_Origen,",
            "        STUFF((",
            "            SELECT DISTINCT ', ' + ap2.TC + ' ' + ISNULL(ap2.IDComprobante, '')",
            "            FROM dbo.MV_APLICACION ap2",
            "            WHERE ap2.TCO_ORIGEN = 'RM'",
            "              AND ap2.IDComprobante_Origen = ap.IDComprobante_Origen",
            "              AND ap2.TC IN ('FC','FP','TK','TKFC')",
            "            FOR XML PATH(''), TYPE",
            "        ).value('.', 'nvarchar(max)'), 1, 2, '') AS Facturas",
            "    FROM dbo.MV_APLICACION ap",
            "    WHERE ap.TCO_ORIGEN = 'RM'",
            "      AND ap.TC IN ('FC','FP','TK','TKFC')",
            "    GROUP BY ap.IDComprobante_Origen",
            ") fr",
            "    ON fr.IDComprobante_Origen = r.IDCOMPROBANTE",
            "WHERE r.TC = 'RM'",
            "  AND r.ANULADA = 0;"
        });

    private static string GetCancellationTimeText(AuditoriaUsuarioRowDto item)
        => TryParseCancellationTrace(item.SystemUserDetalle, out var when, out _)
            ? when
            : "—";

    private static string GetCancellationAmountText(AuditoriaUsuarioRowDto item)
        => TryParseCancellationTrace(item.SystemUserDetalle, out _, out var amount)
            ? amount
            : "—";

    private static string GetCancellationMinutesText(AuditoriaUsuarioRowDto item)
    {
        if (!TryParseCancellationTraceParts(item.SystemUserDetalle, out var cancellationAt, out _))
            return "—";

        var startAt = item.FechaHora;
        if (!cancellationAt.HasValue || startAt == DateTime.MinValue || cancellationAt.Value < startAt)
            return "—";

        return Math.Round((cancellationAt.Value - startAt).TotalMinutes, 0).ToString("N0");
    }

    private static bool TryParseCancellationTrace(string source, out string when, out string amount)
    {
        when = string.Empty;
        amount = string.Empty;
        if (!TryParseCancellationTraceParts(source, out var cancellationAt, out var cancellationAmount))
            return false;

        when = cancellationAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? string.Empty;
        if (cancellationAmount.HasValue)
            amount = cancellationAmount.Value.ToString("N2", CultureInfo.GetCultureInfo("es-AR"));

        return !string.IsNullOrWhiteSpace(when) || !string.IsNullOrWhiteSpace(amount);
    }

    private static bool TryParseCancellationTraceParts(string source, out DateTime? cancellationAt, out decimal? cancellationAmount)
    {
        cancellationAt = null;
        cancellationAmount = null;
        if (string.IsNullOrWhiteSpace(source))
            return false;

        var dateMatch = Regex.Match(source, @"(?<fecha>\d{2}/\d{2}/\d{4}\s+\d{2}:\d{2}:\d{2})");
        if (dateMatch.Success && DateTime.TryParseExact(dateMatch.Groups["fecha"].Value.Trim(), "dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
            cancellationAt = parsedDate;

        var moneyMatch = Regex.Match(source, @"\$\s*(?<importe>[0-9][0-9\.,]*)");
        if (moneyMatch.Success)
        {
            var rawAmount = moneyMatch.Groups["importe"].Value.Trim();
            if (TryNormalizeAmount(rawAmount, out var parsedAmount))
                cancellationAmount = parsedAmount;
        }

        return cancellationAt.HasValue || cancellationAmount.HasValue;
    }

    private static bool TryNormalizeAmount(string rawAmount, out decimal amount)
    {
        amount = 0m;
        if (string.IsNullOrWhiteSpace(rawAmount))
            return false;

        var normalized = rawAmount.Trim();
        var lastDot = normalized.LastIndexOf('.');
        var lastComma = normalized.LastIndexOf(',');

        if (lastDot >= 0 && lastComma >= 0)
        {
            if (lastDot > lastComma)
            {
                normalized = normalized.Replace(",", string.Empty);
            }
            else
            {
                normalized = normalized.Replace(".", string.Empty).Replace(',', '.');
            }
        }
        else if (lastComma >= 0)
        {
            normalized = normalized.Replace(".", string.Empty).Replace(',', '.');
        }
        else if (lastDot >= 0)
        {
            var decimals = normalized.Length - lastDot - 1;
            if (decimals == 3 && normalized.Count(ch => ch == '.') == 1)
                normalized = normalized.Replace(".", string.Empty);
        }

        return decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out amount);
    }

