    private IReadOnlyList<ActivityUserGroup> BuildActivityGroups()
        => _rows
            .GroupBy(item => string.IsNullOrWhiteSpace(item.Usuario) ? "(sin usuario)" : item.Usuario)
            .OrderBy(group => group.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(group => new ActivityUserGroup
            {
                Label = group.Key,
                Days = group
                    .GroupBy(item => item.FechaHora.Date)
                    .OrderBy(day => day.Key)
                    .Select(day => new ActivityDayGroup
                    {
                        Label = day.Key.ToString("dddd dd/MM/yyyy", CultureInfo.GetCultureInfo("es-AR")),
                        Items = day.OrderBy(item => item.FechaHora).ToList()
                    })
                    .ToList()
            })
            .ToList();

