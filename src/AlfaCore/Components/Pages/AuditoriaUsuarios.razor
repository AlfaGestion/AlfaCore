        AddQuery(parts, "desde", _desde?.ToString("yyyy-MM-dd"));
        AddQuery(parts, "hasta", _hasta?.ToString("yyyy-MM-dd"));
        AddQuery(parts, "texto", _texto);
        AddQuery(parts, "usuario", _usuario);
        AddQuery(parts, "pc", _pc);
        AddQuery(parts, "tipoMovimiento", _tipoMovimiento);
        AddQuery(parts, "tipoComprobante", _tipoComprobante);
        AddQuery(parts, "riesgo", _riesgo);
        AddQuery(parts, "tipoControl", _tipoControl);
        AddQuery(parts, "cuentaCliente", _cuentaCliente);
        AddQuery(parts, "diasMinimosSinFactura", _diasMinimosSinFactura.ToString(CultureInfo.InvariantCulture));
        AddQuery(parts, "umbralModificaciones", _umbralModificaciones.ToString(CultureInfo.InvariantCulture));
        AddQuery(parts, "diasToleranciaDuplicados", _diasToleranciaDuplicados.ToString(CultureInfo.InvariantCulture));
