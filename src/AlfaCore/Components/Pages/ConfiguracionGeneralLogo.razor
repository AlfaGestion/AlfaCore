@page "/configuracion-general/logo"
@page "/{idweb}/{idbase:int}/configuracion-general/logo"
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Forms
@inject AlfaCore.Services.IConfiguracionGeneralService ConfigSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Logo y Estilo | Alfa Gestión</PageTitle>

<div class="page-grid cfglogo-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <section class="panel-card">
        <h3 class="panel-card__title">Logo de la empresa</h3>
        <p class="panel-card__subtitle">Se usa en la impresión de comprobantes y en las propuestas/cotizaciones que se comparten con clientes.</p>

        <div class="cfglogo-uploader">
            <div class="cfglogo-uploader__preview">
                @if (!string.IsNullOrWhiteSpace(_previewUrl))
                {
                    <img src="@_previewUrl" alt="Logo de la empresa" />
                }
                else
                {
                    <i class="bi bi-image"></i>
                }
            </div>
            <div class="cfglogo-uploader__content">
                <strong>@(_tieneLogo ? "Logo cargado" : "Sin logo")</strong>
                <span>JPG o PNG, hasta 2 MB.</span>
                <div class="cfglogo-uploader__actions">
                    <div class="cfglogo-picker">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendo">@(_tieneLogo ? "Cambiar logo" : "Subir logo")</AlfaButton>
                        <InputFile class="cfglogo-input" OnChange="HandleLogoSelectedAsync" accept=".jpg,.jpeg,.png,image/jpeg,image/png" disabled="@_subiendo" />
                    </div>
                    @if (_tieneLogo)
                    {
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-trash" Disabled="@_subiendo" OnClick="QuitarLogoAsync">Quitar</AlfaButton>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="panel-card">
        <h3 class="panel-card__title">Incluir logo en la impresión de comprobantes</h3>
        <div class="cfglogo-checks">
            <AlfaCheckbox Value="@_logo.IncluirEnFacturas" ValueChanged="v => _logo.IncluirEnFacturas = v == true">Facturas / Notas de crédito / débito</AlfaCheckbox>
            <AlfaCheckbox Value="@_logo.IncluirEnPresupuestos" ValueChanged="v => _logo.IncluirEnPresupuestos = v == true">Presupuestos</AlfaCheckbox>
            <AlfaCheckbox Value="@_logo.IncluirEnOtrosComprobantes" ValueChanged="v => _logo.IncluirEnOtrosComprobantes = v == true">Otros comprobantes (NP / RM / PR / OC / OT / CB / PG / OPG)</AlfaCheckbox>
        </div>

        <h4 class="cfglogo-subtitle">Ubicación del logo</h4>
        <div class="cfglogo-position">
            <label class="cfglogo-position__option">
                <input type="radio" name="logoPosicion" checked="@(!_logo.PosicionIzquierda)" @onchange="() => _logo.PosicionIzquierda = false" />
                <span>Centro (7.6 x 2.3 cm)</span>
            </label>
            <label class="cfglogo-position__option">
                <input type="radio" name="logoPosicion" checked="@_logo.PosicionIzquierda" @onchange="() => _logo.PosicionIzquierda = true" />
                <span>Izquierda (3 x 2.3 cm)</span>
            </label>
        </div>
    </section>

    <div class="cfglogo-save-bar">
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-floppy" Loading="@_saving" OnClick="GuardarAsync">Guardar</AlfaButton>
    </div>
</div>

@code {
    private ConfiguracionLogoDto _logo = new();
    private bool _tieneLogo;
    private string? _previewUrl;
    private bool _subiendo;
    private bool _saving;
    private AppUiMessage? _feedback;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose() => PageHeader.Clear();

    protected override async Task OnInitializedAsync()
    {
        var result = await UiOps.RunAsync(() => ConfigSvc.GetLogoInfoAsync(), "No se pudo cargar la configuración del logo.");
        if (result.Success && result.Value is not null)
        {
            _logo = result.Value;
            _tieneLogo = _logo.TieneLogo;
            if (_tieneLogo)
                _previewUrl = RouteContext.BuildRoute("/api/configuracion-general/logo") + $"?v={Guid.NewGuid():N}";
        }
    }

    private void UpdatePageHeader() => PageHeader.Set(new PageHeaderConfig
    {
        Title = "Logo y Estilo",
        Breadcrumb = ["Configuración General", "Logo y Estilo"],
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildConfiguracionGeneral(RouteContext, Nav, "logo")
    });

    private async Task HandleLogoSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
            return;

        _subiendo = true;
        try
        {
            await using var stream = file.OpenReadStream(2 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            var result = await UiOps.RunAsync(async () => { await ConfigSvc.SaveLogoAsync(bytes); return true; }, "No se pudo subir el logo.");
            if (result.Success)
            {
                _tieneLogo = true;
                var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
                _previewUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
                SetFeedback(AppUiMessage.Success("Logo actualizado", "El logo se guardó correctamente."));
            }
            else
            {
                SetFeedback(result.Feedback);
            }
        }
        finally
        {
            _subiendo = false;
        }
    }

    private async Task QuitarLogoAsync()
    {
        _subiendo = true;
        var result = await UiOps.RunAsync(async () => { await ConfigSvc.DeleteLogoAsync(); return true; }, "No se pudo quitar el logo.");
        _subiendo = false;
        if (result.Success)
        {
            _tieneLogo = false;
            _previewUrl = null;
        }
        else
        {
            SetFeedback(result.Feedback);
        }
    }

    private async Task GuardarAsync()
    {
        _saving = true;
        var result = await UiOps.RunAsync(async () => { await ConfigSvc.SaveLogoOpcionesAsync(_logo); return true; }, "No se pudo guardar la configuración del logo.");
        _saving = false;
        _feedback = result.Success
            ? AppUiMessage.Success("Guardado", "La configuración del logo se guardó correctamente.")
            : result.Feedback;
    }

    private void SetFeedback(AppUiMessage? message) => _feedback = message;
}
