@page "/compras/carga"
@page "/{idweb}/{idbase:int}/compras/carga"
@using System.Globalization
@using AlfaCore.Models
@using AlfaCore.Services
@inject CompraCargaService Servicio
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject ISaaSTenantRouteGuard TenantGuard
@inject ISessionService Sesiones
@inject IAppUserSessionService Usuarios
@inject IAppUiOperationService UiOps
@inject IAppEventService Eventos
@inject NavigationManager Nav
@inject IPermissionService Permisos
@implements IDisposable

<PageTitle>Preparar compra | AlfaCore</PageTitle>
<div class="gd-page gd compra-carga">
    <AlfaNotification Message="_feedback" OnDismiss="()=>_feedback=null" />
    <AlfaFeedbackPanel Message="@(_busy?AppUiMessage.InProgress("Preparando compra…","Consultando proveedor, configuración y controles de la base activa."):AppUiMessage.Info("Preparación de compras","Seleccioná un comprobante configurado. Revisá el asiento y luego registrá FCC A/C de servicios y gastos en pesos. No incluye stock ni pagos."))" Dismissible="false" />
    @if(_contexto is {} contexto)
    {
        <div class="compra-carga-layout">
            <div class="compra-carga-editor">
                <section class="panel-card" aria-label="Datos del comprobante de compra">
                    <div class="compra-carga-campos">
                        <AlfaLookup TItem="CompraCargaProveedor" Label="Proveedor" Placeholder="Código, razón social o CUIT" MinimumCharacters="1"
                            SearchText="@_buscarProveedor" SearchTextChanged="v=>_buscarProveedor=v" SelectedItem="_proveedor" SelectedItemChanged="ProveedorChanged"
                            SearchFunc="BuscarProveedores" ItemKey="p=>p.Codigo" Disabled="EdicionBloqueada">
                            <ItemTemplate Context="p">@p.Codigo · @p.Nombre · @p.Documento</ItemTemplate>
                        </AlfaLookup>
                        <AlfaSelect Label="Unidad de negocio" Value="@_borrador.Unidad" ValueChanged="CambiarUnidad" Options="@Opciones(contexto.Unidades)" Disabled="EdicionBloqueada" />
                        <AlfaSelect Label="Comprobante / talonario" Value="@TipoActual?.Clave" ValueChanged="CambiarTipo" Options="TiposComprobantes" Disabled="EdicionBloqueada" />
                        <AlfaSelect Label="Motivo de compra" Value="@_borrador.Motivo" ValueChanged="v=>Cambiar(()=>_borrador.Motivo=v)" Options="@Opciones(contexto.Motivos)" Disabled="EdicionBloqueada" />
                        <AlfaSelect Label="Letra habilitada" Value="@_borrador.Letra" ValueChanged="v=>Cambiar(()=>_borrador.Letra=v)" Options="Letras" Disabled="EdicionBloqueada" />
                        @if(TipoActual?.Externo==true||TipoActual?.VistaPreviaDisponible==true)
                        {
                            <AlfaInput Label="Punto de venta" Value="@_borrador.Sucursal" ValueChanged="v=>Cambiar(()=>_borrador.Sucursal=v??string.Empty)" MaxLength="4" Disabled="EdicionBloqueada" />
                            <AlfaInput Label="@(TipoActual?.Externo==true?"Número del proveedor":"Número propuesto (sin reserva)")" Value="@_borrador.Numero" ValueChanged="v=>Cambiar(()=>_borrador.Numero=v??string.Empty)" MaxLength="8" Disabled="EdicionBloqueada" />
                        }
                        else{<p>Numeración interna: se asignará al registrar en el circuito correspondiente. No se reserva ningún número en esta etapa.</p>}
                        <AlfaInput Label="Fecha del comprobante" Type="date" Value="@FechaTexto(_borrador.Fecha)" ValueChanged="v=>CambiarFecha(v,0)" Disabled="EdicionBloqueada" />
                        <AlfaInput Label="Fecha contable / subdiario" Type="date" Value="@FechaTexto(_borrador.FechaContable)" ValueChanged="v=>CambiarFecha(v,1)" Disabled="EdicionBloqueada" />
                        <AlfaInput Label="Vencimiento" Type="date" Value="@FechaTexto(_borrador.Vencimiento)" ValueChanged="v=>CambiarFecha(v,2)" Disabled="EdicionBloqueada" />
                        <AlfaInput Label="CAE / CAI (opcional)" Value="@_borrador.AutorizacionFiscal" ValueChanged="v=>Cambiar(()=>_borrador.AutorizacionFiscal=v??string.Empty)" MaxLength="14" Disabled="EdicionBloqueada" />
                        <AlfaInput Label="Vencimiento CAE / CAI" Type="date" Value="@(_borrador.VencimientoAutorizacion?.ToString("yyyy-MM-dd")??string.Empty)" ValueChanged="v=>Cambiar(()=>_borrador.VencimientoAutorizacion=DateTime.TryParse(v,out var f)?f:null)" Disabled="EdicionBloqueada" />
                    </div>
                    <AlfaFeedbackPanel Message="@AppUiMessage.Info(TipoActual?.Descripcion??"Elegí un comprobante",TipoActual?.Alcance??"No hay un tipo/talonario seleccionado para esta unidad.")" Dismissible="false" />
                    @if(TipoActual?.VistaPreviaDisponible==true&&!PuedeVista){<p role="status">La letra seleccionada está configurada, pero esta etapa solo calcula FCC A/C.</p>}
                    @if(_proveedor is {} proveedor){<p><strong>@proveedor.Nombre</strong> · @proveedor.Documento · Condición IVA @proveedor.CondicionIva</p>}
                    @if(_origen is not null)
                    {
                        <AlfaCheckbox Value="@_borrador.ServiciosGastosConfirmados" ValueChanged="v=>Cambiar(()=>_borrador.ServiciosGastosConfirmados=v==true)" Disabled="EdicionBloqueada">Confirmo que esta carga es de servicios o gastos y no requiere movimientos de mercadería.</AlfaCheckbox>
                        @foreach(var aviso in _origen.Avisos){<p class="compra-carga-aviso">@aviso</p>}
                    }
                </section>
                @if(PuedeVista)
                {
                <section class="panel-card" aria-label="Conceptos de la compra">
                    <div class="compra-carga-scroll"><table><thead><tr><th>Concepto</th><th>Imputación contable</th><th>Tratamiento</th><th>Neto</th><th>IVA %</th><th>IVA informado</th><th></th></tr></thead><tbody>
                    @foreach(var fila in _filas)
                    {
                        <tr @key="fila"><td><AlfaInput Label="Descripción" Value="@fila.Descripcion" ValueChanged="v=>Cambiar(()=>fila.Descripcion=v??string.Empty)" MaxLength="200" Disabled="EdicionBloqueada" /></td>
                        <td><AlfaSelect Label="Cuenta" Value="@fila.Cuenta" ValueChanged="v=>Cambiar(()=>fila.Cuenta=v)" Options="Cuentas" Disabled="EdicionBloqueada" /></td>
                        <td><AlfaSelect Label="Tratamiento fiscal" Value="@fila.Tratamiento" ValueChanged="v=>CambiarTratamiento(fila,v)" Options="Tratamientos" Disabled="EdicionBloqueada" /></td>
                        <td><AlfaInput Label="Neto en pesos" Type="number" Step="0.01" Value="@fila.Neto" ValueChanged="v=>Cambiar(()=>fila.Neto=v??string.Empty)" Disabled="EdicionBloqueada" /></td>
                        <td><AlfaSelect Label="Alícuota" Value="@fila.Tasa" ValueChanged="v=>Cambiar(()=>fila.Tasa=v)" Options="Tasas" Disabled="EdicionBloqueada" /></td>
                        <td><AlfaInput Label="IVA del documento" Type="number" Step="0.01" Value="@fila.Iva" ValueChanged="v=>Cambiar(()=>fila.Iva=v??string.Empty)" Placeholder="Calcular" Disabled="EdicionBloqueada" /></td>
                        <td><AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi-trash" Disabled="EdicionBloqueada" OnClick="()=>Quitar(fila)">Quitar</AlfaButton></td></tr>
                    }
                    </tbody></table></div>
                    <p class="compra-carga-ayuda">Cuenta automática: imputación del proveedor y luego cuenta del motivo. Podés elegir otra por concepto. IVA informado vacío calcula por tasa; si lo completás se conserva y se muestra cualquier diferencia.</p>
                    <div class="compra-carga-campos">
                        <AlfaInput Label="Percepción IVA" Type="number" Step="0.01" Value="@_percIva" ValueChanged="v=>Cambiar(()=>_percIva=v??string.Empty)" Disabled="EdicionBloqueada" />
                        <AlfaInput Label="Percepción Ingresos Brutos" Type="number" Step="0.01" Value="@_percIibb" ValueChanged="v=>Cambiar(()=>_percIibb=v??string.Empty)" Disabled="EdicionBloqueada" />
                        <AlfaInput Label="Percepción Ganancias" Type="number" Step="0.01" Value="@_percGan" ValueChanged="v=>Cambiar(()=>_percGan=v??string.Empty)" Disabled="EdicionBloqueada" />
                        <AlfaInput Label="Total del documento" Type="number" Step="0.01" Value="@_totalDocumento" ValueChanged="v=>Cambiar(()=>_totalDocumento=v??string.Empty)" Disabled="EdicionBloqueada" HelpText="Se coteja con el cálculo; no genera ajustes." />
                    </div>
                </section>
                @if(_vista is {} vista)
                {
                    <section class="panel-card" aria-label="Vista previa de la compra">
                        <p><strong>@_borrador.Tipo @vista.IdComprobante</strong> · Neto @Dinero(vista.Neto) · IVA @Dinero(vista.Iva) · Total @Dinero(vista.Total)</p>
                        @if(vista.Errores.Count>0){<AlfaFeedbackPanel Message="@AppUiMessage.Error("Revisar la propuesta",string.Join(" ",vista.Errores))" Dismissible="false" />}
                        @foreach(var aviso in vista.Avisos){<p class="compra-carga-aviso">@aviso</p>}
                        <div class="compra-carga-scroll"><table><thead><tr><th>Cuenta</th><th>Descripción</th><th>Debe</th><th>Haber</th><th>Datos de IVA</th></tr></thead><tbody>
                        @foreach(var a in vista.Asiento){<tr><td>@(a.Cuenta.Length>0?a.Cuenta:"Sin cuenta")</td><td>@a.Descripcion</td><td class="numero">@Dinero(a.Debe)</td><td class="numero">@Dinero(a.Haber)</td><td>@(a.CabeceraIva?"Cabecera fiscal propuesta":"")</td></tr>}
                        </tbody><tfoot><tr><th colspan="2">Diferencia @Dinero(vista.DiferenciaAsiento)</th><th class="numero">@Dinero(vista.Asiento.Sum(x=>x.Debe))</th><th class="numero">@Dinero(vista.Asiento.Sum(x=>x.Haber))</th><th></th></tr></tfoot></table></div>
                        <div class="compra-carga-scroll"><table><thead><tr><th>Base fiscal propuesta</th><th>IVA %</th><th>Neto</th><th>IVA</th></tr></thead><tbody>
                        @foreach(var b in vista.Bases.GroupBy(x=>(x.Tratamiento,x.Tasa))){<tr><td>@b.Key.Tratamiento</td><td>@b.Key.Tasa</td><td class="numero">@Dinero(b.Sum(x=>x.Neto))</td><td class="numero">@Dinero(b.Sum(x=>x.Iva))</td></tr>}
                        </tbody></table></div>
                    </section>
                }
                }
            </div>
            @if(_origen is {} origen)
            {
                <aside class="panel-card compra-carga-original" aria-label="Documento original recibido">
                    <strong>Recepción documental #@origen.Documento.IdComprobanteRecibido</strong>
                    <p>@origen.Documento.LecturaCompra?.ProveedorNombre · Total leído @Dinero(origen.Documento.LecturaCompra?.Total??0)</p>
                    @foreach(var adjunto in origen.Documento.Adjuntos.Where(a=>!a.Eliminado))
                    {<p><a href="@UrlAdjunto(adjunto.IdAdjunto)" target="_blank" rel="noopener">@adjunto.NombreOriginal</a></p>}
                    @if(AdjuntoVista is {} a){<iframe title="Documento original de compra" src="@UrlAdjunto(a.IdAdjunto)"></iframe>}
                </aside>
            }
        </div>
    }
    else if(!_busy){<AlfaEmptyState Kind="AlfaEmptyStateKind.NoData" Title="No se pudo abrir la preparación de compras" Message="Revisá el mensaje y la sesión activa." />}
</div>
@if(_sesion is {} sesion&&_contexto is {} ctx)
{
    <ProveedorAltaRapida Open="_mostrarAltaProveedor" Sesion="sesion" BaseEsperada="_baseCargada" MotivoInicial="@_borrador.Motivo" Motivos="ctx.Motivos" Cuentas="ctx.Cuentas" OnSeleccionado="ProveedorCreado" OnClose="CerrarAltaProveedor" />
}
<AlfaDialog Open="_confirmarRegistro" Title="Registrar factura de compra" Size="AlfaDialogSize.Lg" CloseOnBackdrop="false" Loading="_busy" OnClose="CerrarRegistro">
    <ChildContent>
        <AlfaFeedbackPanel Message="@(_busy?AppUiMessage.InProgress("Guardando compra…","Registrando comprobante, asiento y datos fiscales. Esperá la confirmación."):_feedback)" Dismissible="false" />
        @if(_vista is {} revision)
        {
            <p><strong>@_proveedor?.Nombre · FCC @revision.IdComprobante</strong></p>
            <p>Total: <strong>@Dinero(revision.Total)</strong>. Se generará una deuda con el proveedor y su asiento contable. Los datos fiscales se guardan según la configuración del libro de IVA.</p>
            <p>Revisá las cuentas e importes del asiento antes de confirmar. Esta compra no mueve stock ni registra un pago.</p>
            @foreach(var aviso in revision.Avisos.Where(a=>!a.StartsWith("Vista previa")&&!a.StartsWith("Comprobante C"))){<p>@aviso</p>}
        }
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="_busy" OnClick="CerrarRegistro">Volver a revisar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Loading="_busy" Disabled="@(_busy||_registrada is not null)" OnClick="RegistrarCompra">Confirmar registración</AlfaButton>
    </Footer>
</AlfaDialog>
