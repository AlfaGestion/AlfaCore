@page "/archivos/tablas"
@page "/{idweb}/{idbase:int}/archivos/tablas"
@layout AlfaCore.Components.Layout.MainLayout
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ITablasReferenciaService TablasSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject AlfaCore.Services.IPageHeaderService PageHeader
@implements IDisposable

<PageTitle>Tablas | AlfaNet</PageTitle>

<div class="gd-page gd gd-legacy tablas-ref">
    <AlfaNotification Message="@_notificacion.For(string.IsNullOrWhiteSpace(_error) ? _message : _error, isError: !string.IsNullOrWhiteSpace(_error), title: string.IsNullOrWhiteSpace(_error) ? "Listo" : "No se pudo completar la acción")"
                      OnDismiss="() => { _message = string.Empty; _error = string.Empty; }" />

    <header class="gd-header">
        <h2>Tablas de referencia</h2>
        <p>Catálogos chicos que usan otras pantallas del sistema (clasificaciones de clientes, categorías, etc.). Están disponibles siempre, para todos, sin costo.</p>
    </header>

    @if (_loadingTablas)
    {
        <p class="gd-hint" role="status">Cargando tablas...</p>
    }
    else if (_tablas.Count == 0)
    {
        <AlfaEmptyState Title="Sin tablas de referencia" Message="No hay tablas de referencia registradas todavía." />
    }
    else
    {
        <div class="tablas-ref__layout">
            <nav class="panel-card tablas-ref__lista" aria-label="Tablas">
                <div class="panel-card__header">
                    <h3 class="panel-card__title">Tablas</h3>
                </div>
                <div class="tablas-ref__items">
                    @foreach (var tabla in _tablas)
                    {
                        <button type="button"
                                class="tablas-ref__item @(tabla.Clave == _selectedClave ? "is-active" : null)"
                                aria-current="@(tabla.Clave == _selectedClave ? "true" : null)"
                                @onclick="() => SelectTablaAsync(tabla.Clave)">
                            @tabla.NombreVisible
                        </button>
                    }
                </div>
            </nav>

            <div class="tablas-ref__main">
                @if (_selectedTabla is not null)
                {
                    <section class="panel-card">
                        <div class="panel-card__header">
                            <div>
                                <h3 class="panel-card__title">@(_editingCodigo is not null ? $"Editar {_editingCodigo}" : "Nueva fila")</h3>
                                <p class="panel-card__subtitle">@_selectedTabla.NombreVisible</p>
                            </div>
                        </div>
                        <div class="tablas-ref__form">
                            <AlfaInput Label="Código" Value="@_filaForm.Codigo" ValueChanged="v => _filaForm.Codigo = v ?? string.Empty" MaxLength="8" Disabled="@(_editingCodigo is not null)" />
                            <AlfaInput Label="Descripción" Value="@_filaForm.Descripcion" ValueChanged="v => _filaForm.Descripcion = v ?? string.Empty" MaxLength="100" />
                            @if (_selectedTabla.TieneColor)
                            {
                                <div class="field">
                                    <label>Color</label>
                                    <input type="color" value="@(_filaForm.ColorHex ?? "#888888")" @onchange="OnColorChanged" />
                                </div>
                            }
                            <div class="actions tablas-ref__acciones">
                                <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-floppy" Loading="@_savingFila" Disabled="@_savingFila" OnClick="_ => GuardarFilaAsync()">
                                    @(_editingCodigo is not null ? "Guardar cambios" : "Crear fila")
                                </AlfaButton>
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-eraser" Disabled="@_savingFila" OnClick="_ => StartNewFila()">Limpiar</AlfaButton>
                            </div>
                        </div>
                    </section>

                    <section class="panel-card">
                        <div class="panel-card__header">
                            <div>
                                <h3 class="panel-card__title">Filas cargadas</h3>
                                <p class="panel-card__subtitle">@(_loadingFilas ? "Cargando..." : $"{_filas.Count} fila(s)")</p>
                            </div>
                        </div>
                        @if (!_loadingFilas && _filas.Count == 0)
                        {
                            <AlfaEmptyState Title="Sin filas" Message="Todavía no hay filas cargadas en esta tabla." />
                        }
                        else if (!_loadingFilas)
                        {
                            <div class="table-wrap">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            @if (_selectedTabla.TieneColor)
                                            {
                                                <th>Color</th>
                                            }
                                            <th class="tablas-ref__col-acciones"><span class="visually-hidden">Acciones</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var fila in _filas)
                                        {
                                            <tr class="@(fila.Codigo == _editingCodigo ? "row--selected" : null)">
                                                <td>@fila.Codigo</td>
                                                <td>@fila.Descripcion</td>
                                                @if (_selectedTabla.TieneColor)
                                                {
                                                    <td><span class="tablas-ref__color" style="background:@(fila.ColorHex ?? "transparent");"></span></td>
                                                }
                                                <td class="tablas-ref__col-acciones">
                                                    <div class="tablas-ref__botones">
                                                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-pencil" OnClick="_ => EditFila(fila)">Editar</AlfaButton>
                                                        <AlfaButton Variant="AlfaButtonVariant.Danger" Size="AlfaSize.Sm" Icon="bi bi-trash" OnClick="_ => EliminarFilaAsync(fila.Codigo)">Eliminar</AlfaButton>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly AlfaNotificationSlot _notificacion = new();
    private List<AlfaCore.Models.TablaReferenciaDto> _tablas = [];
    private List<AlfaCore.Models.TablaReferenciaFilaDto> _filas = [];
    private AlfaCore.Models.TablaReferenciaDto? _selectedTabla;
    private string _selectedClave = string.Empty;
    private readonly AlfaCore.Models.GuardarFilaTablaReferenciaRequest _filaForm = new();
    private string? _editingCodigo;

    private bool _loadingTablas = true;
    private bool _loadingFilas;
    private bool _savingFila;
    private string _message = string.Empty;
    private string _error = string.Empty;


    private PageHeaderConfig? _pageHeaderPublicado;
    private string _headerSnapshot = string.Empty;

    // Estado que muestra la barra superior (acciones habilitadas, buscador): si cambia, se
    // republica el header después del render de la página.
    private string HeaderSnapshot() => string.Empty;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || HeaderSnapshot() != _headerSnapshot)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader()
    {
        _headerSnapshot = HeaderSnapshot();
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "archivos",
            Title = "Tablas de referencia",
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildArchivos(RouteContext, Nav, "tablas"),
        });
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tablas = (await TablasSvc.GetTablasAsync()).ToList();
            if (_tablas.Count > 0)
                await SelectTablaAsync(_tablas[0].Clave);
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
        }
        finally
        {
            _loadingTablas = false;
        }
    }

    private async Task SelectTablaAsync(string clave)
    {
        _selectedClave = clave;
        _selectedTabla = _tablas.FirstOrDefault(t => t.Clave == clave);
        await LoadFilasAsync();
        StartNewFila();
    }

    private async Task LoadFilasAsync()
    {
        if (_selectedTabla is null)
            return;

        _loadingFilas = true;
        _error = string.Empty;
        try
        {
            _filas = (await TablasSvc.GetFilasAsync(_selectedTabla.Clave)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
            _filas = [];
        }
        finally
        {
            _loadingFilas = false;
        }
    }

    private void StartNewFila()
    {
        _editingCodigo = null;
        _filaForm.CodigoOriginal = null;
        _filaForm.Codigo = ProponerCodigo();
        _filaForm.Descripcion = string.Empty;
        _filaForm.ColorHex = "#888888";
        _message = string.Empty;
        _error = string.Empty;
    }

    private string ProponerCodigo()
    {
        var max = 0;
        var hayNumericos = false;
        foreach (var f in _filas)
        {
            if (int.TryParse(f.Codigo.Trim(), out var n))
            {
                hayNumericos = true;
                if (n > max)
                    max = n;
            }
        }
        if (hayNumericos)
            return (max + 1).ToString();
        return _filas.Count == 0 ? "1" : string.Empty;
    }

    private void EditFila(AlfaCore.Models.TablaReferenciaFilaDto fila)
    {
        _editingCodigo = fila.Codigo;
        _filaForm.CodigoOriginal = fila.Codigo;
        _filaForm.Codigo = fila.Codigo;
        _filaForm.Descripcion = fila.Descripcion;
        _filaForm.ColorHex = fila.ColorHex ?? "#888888";
        _message = string.Empty;
        _error = string.Empty;
    }

    private void OnColorChanged(ChangeEventArgs args)
        => _filaForm.ColorHex = Convert.ToString(args.Value);

    private async Task GuardarFilaAsync()
    {
        if (_selectedTabla is null)
            return;

        _savingFila = true;
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            var eraEdicion = _editingCodigo is not null;
            await TablasSvc.GuardarFilaAsync(_selectedTabla.Clave, _filaForm);
            await LoadFilasAsync();
            StartNewFila();
            _message = eraEdicion ? "Fila actualizada." : "Fila creada.";
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
        }
        finally
        {
            _savingFila = false;
        }
    }

    private async Task EliminarFilaAsync(string codigo)
    {
        if (_selectedTabla is null)
            return;

        _message = string.Empty;
        _error = string.Empty;

        try
        {
            await TablasSvc.EliminarFilaAsync(_selectedTabla.Clave, codigo);
            await LoadFilasAsync();
            _message = "Fila eliminada.";
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
        }
    }
}
