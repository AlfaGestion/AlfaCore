@page "/stock/movimientos"
@page "/{idweb}/{idbase:int}/stock/movimientos"
@using System.Globalization
@using System.Text.Json
@using AlfaCore.Services
@inject IStockMovimientosService Service
@inject IPageHeaderService PageHeader
@inject IAppUiOperationService UiOps
@inject ISessionService Sessions
@inject IAppUserSessionService Users
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Movimientos de stock | AlfaCore</PageTitle>
<div class="gd-page gd stockmov-page">
    <AlfaNotification Message="@_feedback" />
    @if (_contexto is null)
    {
        @if (_busy) { <AlfaEmptyState Loading="true" Title="Cargando movimientos de stock…" /> }
    }
    else if (_modo == Modo.Lista)
    {
        @* Browse: comprobantes de stock. Filtros en el Smart Search del header, paginador en el Context Toolbar. *@
        @if (_lista is null) { <AlfaEmptyState Loading="true" Title="Buscando comprobantes…" /> }
        else if (_lista.Filas.Count == 0)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="No hay comprobantes de stock con esos filtros"
                Message="Cambiá el período o los filtros, o cargá uno nuevo con «Nuevo movimiento»." />
        }
        else
        {
            <div class="table-wrap stockmov-lista">
                <table class="data-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th>Fecha</th><th>Comprobante</th><th>Tipo</th><th>Depósito</th><th>Motivo</th>
                            <th class="num">Ítems</th><th class="num">Cantidad</th><th>Observaciones</th><th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _lista.Filas)
                        {
                            <tr class="is-clickable @(c.Anulado ? "is-anulado" : null)" tabindex="0" title="Ver el comprobante"
                                @onclick="() => VerAsync(c.Tc, c.Comprobante)" @onkeydown="e => FilaKeyDown(e, c)">
                                <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="stockmov-nro">@c.Tc @c.Comprobante</td>
                                <td>@TipoNombre(c.Tc, c.UnidadNegocio)</td>
                                <td>@NombreDeposito(c.Deposito)@if (c.DepositoDestino.Length > 0) { <span class="stockmov-muted"> → @NombreDeposito(c.DepositoDestino)</span> }</td>
                                <td>@NombreMotivo(c.Motivo)</td>
                                <td class="num">@c.Items</td>
                                <td class="num">@Num(c.Cantidad)</td>
                                <td class="stockmov-obs" title="@c.Observaciones">@c.Observaciones</td>
                                <td>@if (c.Anulado) { <span class="stockmov-tag stockmov-tag--anulado">Anulado</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="stockmov-lista-pie">@_lista.Total comprobantes · página @_lista.Pagina de @_lista.TotalPaginas</div>
        }
    }
    else
    {
        @if (_modo == Modo.Ver && _cargado is { } vc)
        {
            @if (vc.Anulado)
            {
                <AlfaNotification Message="@AppUiMessage.Warning("Comprobante anulado", "No cuenta en el stock. Se muestra solo para consulta.")" />
            }
            else if (!vc.Editable)
            {
                <AlfaNotification Message="@AppUiMessage.Info("Solo consulta", vc.MotivoNoEditable)" />
            }
        }
        <section class="stockmov-fields" aria-label="Datos del movimiento">
            <AlfaSelect Label="Tipo de movimiento" Value="@_draft.Tc" ValueChanged="TipoChanged" Disabled="@(Bloqueado || Editando)" Options="@TiposOpciones" Placeholder="Elegí el tipo" />
            <AlfaSelect Label="Unidad de negocio" Value="@_draft.UnidadNegocio" ValueChanged="UnidadChanged" Disabled="@(Bloqueado || Editando)"
                Options="@_contexto.UnidadesNegocio.Select(x => new AlfaSelectOption(x.Codigo, $"{x.Codigo} · {x.Descripcion}")).ToList()" Placeholder="Elegí una unidad" />
            <AlfaInput Type="date" Label="Fecha" Value="@_draft.Fecha.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" ValueChanged="FechaChanged" Disabled="@Bloqueado"
                HelpText="@(EsAjuste && _modo == Modo.Edicion ? "Lo contado queda como saldo del depósito al terminar ese día." : null)" />
            <AlfaSelect Label="@(EsTransferencia ? "Depósito de origen" : "Depósito")" Value="@_draft.Deposito" ValueChanged="DepositoChanged" Disabled="@Bloqueado"
                Options="@Depositos(null)" Placeholder="Elegí un depósito" />
            @if (EsTransferencia)
            {
                <AlfaSelect Label="Depósito de destino" Value="@_draft.DepositoDestino" ValueChanged="v => Cambiar(() => _draft.DepositoDestino = v ?? string.Empty)" Disabled="@Bloqueado"
                    Options="@Depositos(_draft.Deposito)" Placeholder="Elegí el destino" />
            }
            <AlfaSelect Label="Motivo" Value="@_draft.Motivo" ValueChanged="v => Cambiar(() => _draft.Motivo = v ?? string.Empty)" Disabled="@Bloqueado"
                Options="@_contexto.Motivos.Select(x => new AlfaSelectOption(x.Codigo, $"{x.Codigo} · {x.Descripcion}")).ToList()" Placeholder="Sin motivo" />
        </section>

        @* Grilla como la de Alfa: Código → Enter → Cantidad → Enter → línea siguiente. F5 busca por descripción. *@
        <div class="stockmov-scroll">
            <table class="stockmov-table">
                <thead>
                    <tr>
                        <th class="col-n">#</th><th class="col-cod">Código</th><th>Descripción</th><th class="col-ud">Unidad</th>
                        <th class="num col-cant">@(EsAjuste ? "Contado" : "Cantidad")</th><th class="num col-cant">Bultos</th>
                        <th class="num col-cant">@ColumnaSaldo</th><th class="num col-cant">@(EsAjuste ? "Diferencia" : "Queda")</th>
                        @if (MuestraVencimiento) { <th class="col-vto">Vence</th> }
                        @if (_modo == Modo.Edicion) { <th class="col-acc"></th> }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _draft.Lineas.Count; i++)
                    {
                        var item = _draft.Lineas[i];
                        var art = _articulos.GetValueOrDefault(item.Articulo);
                        var pl = LineaPlan(item.Articulo);
                        <tr @key="item.Articulo">
                            <td class="col-n">@(i + 1)</td>
                            <td class="col-cod">@item.Articulo</td>
                            <td>@art?.Descripcion</td>
                            <td class="col-ud">@art?.Unidad</td>
                            <td class="num"><input class="stockmov-cell" inputmode="decimal" aria-label="@($"Cantidad {item.Articulo}")"
                                value="@(item.Bultos.HasValue ? (pl is null ? "" : Num(pl.Cantidad)) : Num(item.Cantidad))"
                                @onchange="e => CantidadChanged(item, e.Value?.ToString())" disabled="@(Bloqueado || item.Bultos.HasValue)" /></td>
                            <td class="num"><input class="stockmov-cell" inputmode="decimal" aria-label="@($"Bultos {item.Articulo}")" value="@(item.Bultos is { } b ? Num(b) : "")"
                                @onchange="e => BultosChanged(item, e.Value?.ToString())" disabled="@Bloqueado" /></td>
                            <td class="num">@SaldoTexto(item.Articulo, art, pl)</td>
                            <td class="num @ClaseMovimiento(pl)">@MovimientoTexto(pl)</td>
                            @if (MuestraVencimiento)
                            {
                                <td class="col-vto">
                                    @if (art?.Perecedero == true && PideVencimiento(pl))
                                    {
                                        <input class="stockmov-cell" type="date" aria-label="@($"Vencimiento {item.Articulo}")" disabled="@Bloqueado"
                                               value="@VencimientoLinea(item, art, pl).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                               @onchange="e => VencimientoChanged(item, e.Value?.ToString())" />
                                    }
                                    else if (art?.Perecedero == true) { <span class="stockmov-muted" title="Las salidas no registran vencimiento">—</span> }
                                </td>
                            }
                            @if (_modo == Modo.Edicion)
                            {
                                <td class="col-acc"><AlfaIconButton Icon="bi-trash" Label="Quitar línea" Disabled="@Bloqueado" OnClick="() => Cambiar(() => _draft.Lineas.Remove(item))" /></td>
                            }
                        </tr>
                    }
                    @if (_modo == Modo.Edicion)
                    {
                        <tr class="stockmov-nueva">
                            <td class="col-n">@(_draft.Lineas.Count + 1)</td>
                            <td class="col-cod"><input id="sm-codigo" class="stockmov-cell" placeholder="Código" autocomplete="off" aria-label="Código del artículo"
                                value="@_nuevoCodigo" @oninput="e => { _nuevoCodigo = e.Value?.ToString() ?? string.Empty; _nuevoArticulo = null; }"
                                @onkeydown="CodigoKeyDown" disabled="@NuevaLineaBloqueada" /></td>
                            <td>
                                @if (_nuevoArticulo is { } na) { @na.Descripcion }
                                else if (NuevaLineaBloqueada && !Bloqueado) { <span class="stockmov-muted">@FaltaParaCargar</span> }
                                else { <span class="stockmov-muted">Código o código de barras y Enter · cantidad*código lo agrega directo · F5 busca por descripción</span> }
                            </td>
                            <td class="col-ud">@_nuevoArticulo?.Unidad</td>
                            <td class="num"><input id="sm-cantidad" class="stockmov-cell" inputmode="decimal" aria-label="Cantidad" value="@_nuevoCantidad"
                                @oninput="e => _nuevoCantidad = e.Value?.ToString() ?? string.Empty" @onkeydown="CantidadKeyDown" disabled="@(NuevaLineaBloqueada || _nuevoArticulo is null)" /></td>
                            <td></td>
                            <td class="num">@(_nuevoArticulo is { } ns && !EsAjuste ? Num(ns.Stock) : "")</td>
                            <td></td>
                            @if (MuestraVencimiento) { <td class="col-vto">@(_nuevoArticulo is { Perecedero: true } np && !EsTransferencia ? $"{np.DiasVencimiento} días" : "")</td> }
                            <td class="col-acc"><AlfaIconButton Icon="bi-search" Label="Buscar artículo (F5)" Disabled="@NuevaLineaBloqueada" OnClick="AbrirBuscadorAsync" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <section class="stockmov-pie" aria-label="Totales">
            <span>Ítems: <strong>@_draft.Lineas.Count</strong></span>
            <span>@(EsAjuste ? "Contado" : "Cantidad"): <strong>@Num(_plan?.Lineas.Sum(x => x.Cantidad) ?? _draft.Lineas.Sum(x => x.Cantidad))</strong></span>
            @if (_plan is { } p)
            {
                @if (EsAjuste) { <span>Diferencia neta: <strong>@Num(p.Lineas.Sum(x => x.Movimiento))</strong></span> }
                @foreach (var aviso in p.Avisos) { <span class="stockmov-aviso">@aviso</span> }
            }
            else if (_planError is { Length: > 0 } pe && _modo == Modo.Edicion) { <span class="stockmov-aviso">@pe</span> }
            <span class="stockmov-pie__ayuda">@DescripcionTipo</span>
        </section>
        <AlfaInput Label="Observaciones" Value="@_draft.Observaciones" ValueChanged="v => Cambiar(() => _draft.Observaciones = v ?? string.Empty)" MaxLength="50" Disabled="@Bloqueado" />
    }
</div>

<ArticuloStockBuscadorDialog Open="_buscadorAbierto" TextoInicial="@_buscadorTexto" ResultadosIniciales="_buscadorIniciales"
    SearchFunc="BuscarArticulos" StockLabel="@($"Stock dep. {_draft.Deposito}")" InputId="sm-buscar"
    OnElegir="ElegirArticuloAsync" OnClose="CerrarBuscadorAsync" />

@if (_confirmarGrabar && _plan is { } cp)
{
    <AlfaConfirmDialog Open="true" Title="@(Editando ? $"Grabar cambios en {_draft.Tc} {_draft.Comprobante}" : $"Grabar {TipoDescripcion}")"
        Message="@ResumenConfirmacion(cp)" SecondaryMessage="@string.Join(" ", cp.Avisos)"
        ConfirmLabel="Grabar" OnConfirm="GrabarAsync" OnCancel="() => _confirmarGrabar = false" />
}
@if (_confirmarAnular)
{
    <AlfaConfirmDialog Open="true" Title="@($"Anular {_draft.Tc} {_draft.Comprobante}")"
        Message="El comprobante queda anulado y deja de contar en el stock." SecondaryMessage="No se borra: se marca como anulado, igual que en Alfa Gestión."
        ConfirmLabel="Anular" OnConfirm="AnularAsync" OnCancel="() => _confirmarAnular = false" />
}
@if (_confirmarCancelar)
{
    <AlfaConfirmDialog Open="true" Title="Descartar los cambios"
        Message="@(Editando ? $"Se pierden los cambios sin grabar de {_draft.Tc} {_draft.Comprobante}." : "Se pierde la carga sin grabar.")"
        ConfirmLabel="Descartar" OnConfirm="DescartarAsync" OnCancel="() => { _confirmarCancelar = false; }" />
}

@code {
    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");
    [SupplyParameterFromQuery(Name = "tipo")] public string? TipoInicial { get; set; }

    // Lista (Browse) → Ver (ficha de solo lectura) → Edición (nuevo o modificar), como el resto de AlfaDesign.
    private enum Modo { Lista, Ver, Edicion }
    private Modo _modo = Modo.Lista;

    private StockMovimientosContexto? _contexto;
    private StockMovimientoBorrador _draft = new();
    private Dictionary<string, StockMovimientoArticulo> _articulos = new(StringComparer.OrdinalIgnoreCase);
    private StockMovimientoPlan? _plan;
    private string? _planError;
    private AppUiMessage? _feedback;
    private Guid _operacion = Guid.NewGuid();
    private bool _busy, _disposed, _jsListo, _borradorRevisado, _confirmarGrabar, _confirmarAnular, _confirmarCancelar, _sucio;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _calculoCts;
    private DotNetObjectReference<StockMovimientos>? _dotNetRef;
    private int? _baseInicial;
    private string _usuarioInicial = "";

    // Lista y filtros (Smart Search del header).
    private StockMovimientoFiltro _filtro = FiltroInicial();
    private StockMovimientoFiltro _filtroAplicado = FiltroInicial();
    private StockMovimientoPagina? _lista;
    private bool _filtrosAbiertos;
    private StockMovimientoCargado? _cargado;

    // Línea nueva al pie de la grilla.
    private string _nuevoCodigo = "", _nuevoCantidad = "1";
    private StockMovimientoArticulo? _nuevoArticulo;

    // Buscador F5.
    private bool _buscadorAbierto;
    private string _buscadorTexto = "";
    private IReadOnlyList<StockMovimientoArticulo>? _buscadorIniciales;

    private bool Bloqueado => _busy || _modo != Modo.Edicion;
    private bool Editando => _draft.Comprobante.Length > 0;
    private bool EsAjuste => StockMovimientosCalculo.EsAjuste(_draft.Tc);
    private bool EsTransferencia => StockMovimientosCalculo.EsTransferencia(_draft.Tc);
    private bool NuevaLineaBloqueada => Bloqueado || _contexto is null || _draft.Tc.Length == 0 || _draft.Deposito.Length == 0;
    private string FaltaParaCargar => _draft.Tc.Length == 0 ? "Elegí el tipo de movimiento para cargar artículos." : "Elegí el depósito para cargar artículos.";
    // Perecederos (UsaPerecederos=SI): los ingresos llevan vencimiento; las salidas y transferencias no.
    private bool MuestraVencimiento => _contexto?.UsaPerecederos == true && !EsTransferencia && _draft.Tc.Length > 0
        && _draft.Lineas.Any(l => _articulos.GetValueOrDefault(l.Articulo)?.Perecedero == true);
    private bool PideVencimiento(StockMovimientoPlanLinea? pl)
        => _draft.Tc is "IR" or "SI" or "AJP" && (!EsAjuste || pl is null || pl.Movimiento > 0);
    private DateTime VencimientoLinea(StockMovimientoLinea item, StockMovimientoArticulo art, StockMovimientoPlanLinea? pl)
        => item.Vencimiento ?? pl?.Vencimiento ?? StockMovimientosCalculo.VencimientoPropuesto(_draft.Fecha, art.DiasVencimiento);
    private void VencimientoChanged(StockMovimientoLinea item, string? value)
        => Cambiar(() => item.Vencimiento = DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var f) ? f.Date : null);
    private string ColumnaSaldo => EsAjuste ? $"Saldo al {_draft.Fecha:dd/MM}" : EsTransferencia ? "Stock origen" : "Stock actual";

    private IEnumerable<StockMovimientoTipo> TiposUnidad => (_contexto?.Tipos ?? [])
        .Where(t => t.UnidadNegocio.Length == 0 || t.UnidadNegocio == _draft.UnidadNegocio);
    private IReadOnlyList<AlfaSelectOption> TiposOpciones => StockMovimientosCalculo.Tipos
        .Select(tc => TiposUnidad.Where(t => t.Tc == tc).OrderBy(t => t.UnidadNegocio == _draft.UnidadNegocio ? 0 : 1).FirstOrDefault())
        .Where(t => t is not null).Select(t => new AlfaSelectOption(t!.Tc, $"{t.Tc} · {t.Descripcion}")).ToList();
    // Tipos del filtro de la lista: los cinco de stock con la descripción de la tabla de comprobantes.
    private IReadOnlyList<AlfaSelectOption> TiposFiltro => StockMovimientosCalculo.Tipos
        .Select(tc => new AlfaSelectOption(tc, (_contexto?.Tipos ?? []).FirstOrDefault(t => t.Tc == tc)?.Descripcion is { Length: > 0 } d ? $"{tc} · {d}" : tc)).ToList();
    private string TipoDescripcion => TiposUnidad.FirstOrDefault(t => t.Tc == _draft.Tc)?.Descripcion is { Length: > 0 } d ? $"{_draft.Tc} · {d}" : _draft.Tc;
    private string TipoNombre(string tc, string unidad) => (_contexto?.Tipos ?? []).Where(t => t.Tc == tc)
        .OrderBy(t => t.UnidadNegocio == unidad ? 0 : 1).FirstOrDefault()?.Descripcion ?? tc;
    private string NombreDeposito(string codigo) => (_contexto?.Depositos ?? []).FirstOrDefault(d => string.Equals(d.Codigo, codigo, StringComparison.OrdinalIgnoreCase)) is { } d
        ? $"{d.Codigo} · {d.Descripcion}" : codigo;
    private string NombreMotivo(string codigo) => codigo.Length == 0 ? "" : (_contexto?.Motivos ?? []).FirstOrDefault(m => string.Equals(m.Codigo, codigo, StringComparison.OrdinalIgnoreCase))?.Descripcion ?? codigo;
    private string DescripcionTipo => _draft.Tc switch
    {
        "IR" => "Ingreso: suma la cantidad al depósito.",
        "VS" => "Vale de salida: resta la cantidad del depósito.",
        "TR" => "Transferencia: sale del depósito de origen y entra al de destino en el mismo comprobante.",
        "AJP" => "Ajuste: carga lo contado; se graba la diferencia para que el saldo a la fecha quede igual a lo contado.",
        "SI" => "Saldo inicial: carga lo contado; se graba la diferencia para que el saldo a la fecha quede igual a lo contado.",
        _ => ""
    };

    // FMT_VALIDA_DEPOSITO: depósitos de la unidad de negocio o compartidos.
    private IReadOnlyList<AlfaSelectOption> Depositos(string? excluir) => (_contexto?.Depositos ?? [])
        .Where(d => (d.Compartido || d.UnidadNegocio == _draft.UnidadNegocio) && !string.Equals(d.Codigo, excluir, StringComparison.OrdinalIgnoreCase))
        .Where(d => !EsTransferencia || d.Empresa.Length == 0)
        .Select(d => new AlfaSelectOption(d.Codigo, $"{d.Codigo} · {d.Descripcion}")).ToList();

    private StockMovimientoPlanLinea? LineaPlan(string articulo)
        => _plan?.Lineas.FirstOrDefault(x => string.Equals(x.Articulo, articulo, StringComparison.OrdinalIgnoreCase));
    private string SaldoTexto(string articulo, StockMovimientoArticulo? art, StockMovimientoPlanLinea? pl)
        => pl is not null ? Num(pl.Saldo) : !EsAjuste && art is not null && _modo == Modo.Edicion ? Num(art.Stock) : "—";
    private string MovimientoTexto(StockMovimientoPlanLinea? pl)
        => pl is null ? "—" : EsAjuste ? (pl.Movimiento > 0 ? "+" : "") + Num(pl.Movimiento) : Num(pl.Saldo + pl.Movimiento);
    private string? ClaseMovimiento(StockMovimientoPlanLinea? pl)
        => pl is null ? null : EsAjuste ? (pl.Movimiento > 0 ? "is-positivo" : pl.Movimiento < 0 ? "is-negativo" : null) : pl.Saldo + pl.Movimiento < 0 ? "is-negativo" : null;

    // ---------------------------------------------------------------- Ciclo de vida

    protected override void OnInitialized()
    {
        _baseInicial = Sessions.GetActiveSession()?.BaseId;
        _usuarioInicial = Users.CurrentUser?.UserName ?? "";
        Sessions.SessionChanged += ContextChanged; Users.StateChanged += ContextChanged;
        UpdateHeader();
    }
    protected override Task OnInitializedAsync() => InicializarAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            UpdateHeader();
            _dotNetRef = DotNetObjectReference.Create(this);
            try { await Js.InvokeVoidAsync("cargaDirecta.init", _dotNetRef); _jsListo = true; }
            catch (JSDisconnectedException) { return; }
        }
        if (_jsListo && _contexto is not null && !_borradorRevisado)
        {
            _borradorRevisado = true;
            await RestaurarBorradorAsync();
        }
    }

    private Task InicializarAsync() => RunAsync(async () =>
    {
        var contexto = await Service.GetContextoAsync(_lifetime.Token);
        if (_disposed) return;
        _contexto = contexto;
        if (contexto.Tipos.Count == 0)
            _feedback = AppUiMessage.Warning("Sin comprobantes de stock", "No hay comprobantes IR, VS, TR, AJP ni SI con sistema Stock en la tabla de comprobantes.");
        var tipo = (TipoInicial ?? "").Trim().ToUpperInvariant();
        if (StockMovimientosCalculo.Tipos.Contains(tipo)) { EmpezarNuevo(tipo); return; }
        await CargarListaAsync();
    });

    private static StockMovimientoFiltro FiltroInicial()
    {
        var (desde, hasta) = GestionRangosFecha.Calcular("mes");
        return new() { Desde = desde, Hasta = hasta };
    }
    private static StockMovimientoFiltro Copiar(StockMovimientoFiltro f) => new()
    {
        Tc = f.Tc, Desde = f.Desde, Hasta = f.Hasta, Deposito = f.Deposito, Texto = f.Texto,
        IncluirAnulados = f.IncluirAnulados, Pagina = f.Pagina, TamanoPagina = f.TamanoPagina
    };

    // ---------------------------------------------------------------- Lista

    private async Task CargarListaAsync()
    {
        _filtroAplicado = Copiar(_filtro);
        _lista = await Service.ListarComprobantesAsync(Copiar(_filtro), _lifetime.Token);
    }
    private Task BuscarAsync()
    {
        _filtrosAbiertos = false; _filtro.Pagina = 1;
        return RunAsync(CargarListaAsync);
    }
    private Task PaginarAsync(int delta)
    {
        if (_lista is null) return Task.CompletedTask;
        _filtro = Copiar(_filtroAplicado);
        _filtro.Pagina = Math.Clamp(_lista.Pagina + delta, 1, _lista.TotalPaginas);
        return RunAsync(CargarListaAsync);
    }
    private Task LimpiarFiltrosAsync()
    {
        _filtro = FiltroInicial();
        return BuscarAsync();
    }
    private Task QuitarFiltroAsync(string key)
    {
        _filtro = Copiar(_filtroAplicado);
        switch (key)
        {
            case "periodo": (_filtro.Desde, _filtro.Hasta) = GestionRangosFecha.Calcular("mes"); break;
            case "tipo": _filtro.Tc = ""; break;
            case "deposito": _filtro.Deposito = ""; break;
            case "anulados": _filtro.IncluirAnulados = false; break;
            case "texto": _filtro.Texto = ""; break;
        }
        return BuscarAsync();
    }
    private List<(string Key, string Label)> FiltrosActivos()
    {
        var f = _filtroAplicado;
        var chips = new List<(string, string)> { ("periodo", GestionRangosFecha.Etiqueta(f.Desde, f.Hasta)) };
        if (f.Tc.Length > 0) chips.Add(("tipo", $"Tipo: {f.Tc}"));
        if (f.Deposito.Length > 0) chips.Add(("deposito", $"Depósito: {f.Deposito}"));
        if (f.IncluirAnulados) chips.Add(("anulados", "Con anulados"));
        return chips;
    }
    private void AlternarFiltros() { _filtrosAbiertos = !_filtrosAbiertos; UpdateHeader(); }
    private void CerrarFiltros() { _filtrosAbiertos = false; UpdateHeader(); }
    private void CambiarFiltro(Action cambio) { cambio(); UpdateHeader(); }
    private Task TeclaBusquedaAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") return BuscarAsync();
        if (args.Key == "Escape") CerrarFiltros();
        return Task.CompletedTask;
    }
    private Task FilaKeyDown(KeyboardEventArgs e, StockMovimientoResumen c)
        => e.Key == "Enter" ? VerAsync(c.Tc, c.Comprobante) : Task.CompletedTask;

    private RenderFragment RenderBusqueda() => @<div class="smart-search" @onclick:stopPropagation>
        @{ var chips = FiltrosActivos(); }
        <div class="smart-search__bar @(_filtrosAbiertos ? "is-open" : string.Empty)">
            <span class="smart-search__search-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
            <button type="button" class="smart-search__filter-button @(_filtrosAbiertos || chips.Count > 1 ? "is-active" : string.Empty)"
                aria-label="Abrir filtros" title="Abrir filtros" aria-expanded="@_filtrosAbiertos" disabled="@_busy" @onclick="AlternarFiltros">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
            </button>
            <div class="smart-search__active-filters" aria-label="Filtros activos">
                @foreach (var chip in chips.Take(2))
                {
                    <button type="button" class="smart-search__active-filter" disabled="@_busy" aria-label="@($"Quitar filtro {chip.Label}")"
                        title="@chip.Label" @onclick="() => QuitarFiltroAsync(chip.Key)">
                        <span>@chip.Label</span>
                        <span class="smart-search__active-filter-remove" aria-hidden="true"><i class="bi bi-x"></i></span>
                    </button>
                }
                @if (chips.Count > 2) { <span class="smart-search__more-filters" title="@string.Join(", ", chips.Skip(2).Select(x => x.Label))">+@(chips.Count - 2)</span> }
            </div>
            <input type="search" aria-label="Buscar comprobante" placeholder="Número, artículo u observaciones..." maxlength="50"
                value="@_filtro.Texto" disabled="@_busy" @oninput="e => _filtro.Texto = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaBusquedaAsync" />
            <button type="button" class="smart-search__toggle" aria-label="Mostrar filtros" aria-expanded="@_filtrosAbiertos"
                disabled="@_busy" @onclick="AlternarFiltros"><i class="bi @(_filtrosAbiertos ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i></button>
        </div>
        @if (_filtrosAbiertos && _contexto is not null)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CerrarFiltros"></button>
            <div class="smart-search__panel" @onclick:stopPropagation @onkeydown="TeclaBusquedaAsync" @onkeydown:stopPropagation>
                <FiltroPeriodo Desde="@_filtro.Desde" Hasta="@_filtro.Hasta" IncluirTodo="true" Disabled="@_busy"
                               PeriodoChanged="p => CambiarFiltro(() => (_filtro.Desde, _filtro.Hasta) = p)" />
                <div class="smart-search__column">
                    <h4><i class="bi bi-box-seam"></i> Comprobante</h4>
                    <AlfaSelect Label="Tipo" Value="@_filtro.Tc" ValueChanged="v => CambiarFiltro(() => _filtro.Tc = v ?? string.Empty)" Options="@TiposFiltro" Placeholder="Todos" Disabled="@_busy" />
                    <AlfaSelect Label="Depósito" Value="@_filtro.Deposito" ValueChanged="v => CambiarFiltro(() => _filtro.Deposito = v ?? string.Empty)"
                        Options="@_contexto.Depositos.Select(d => new AlfaSelectOption(d.Codigo, $"{d.Codigo} · {d.Descripcion}")).ToList()" Placeholder="Todos" Disabled="@_busy" />
                    <AlfaCheckbox Value="@_filtro.IncluirAnulados" ValueChanged="v => CambiarFiltro(() => _filtro.IncluirAnulados = v == true)">Incluir anulados</AlfaCheckbox>
                </div>
                <div class="smart-search__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-eraser" Disabled="@_busy" OnClick="_ => LimpiarFiltrosAsync()">Limpiar</AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-search" Disabled="@_busy" OnClick="_ => BuscarAsync()">Aplicar</AlfaButton>
                </div>
            </div>
        }
    </div>;

    // ---------------------------------------------------------------- Ver / nuevo / modificar / cancelar

    private Task VerAsync(string tc, string comprobante) => RunAsync(async () =>
    {
        var cargado = await Service.VerComprobanteAsync(tc, comprobante, _lifetime.Token);
        _cargado = cargado;
        _draft = cargado.Borrador;
        _articulos = new(cargado.Articulos, StringComparer.OrdinalIgnoreCase);
        _plan = null; _planError = null; _sucio = false;
        _modo = Modo.Ver;
        if (cargado.Editable) _ = RecalcularAsync();
    });

    private void EmpezarNuevo(string? tipo = null)
    {
        var c = _contexto!;
        // Repite unidad, fecha, depósitos y motivo de la última carga: agiliza cargar varios seguidos.
        var anterior = _modo == Modo.Edicion || _draft.Tc.Length > 0 ? _draft : null;
        _draft = new()
        {
            UnidadNegocio = anterior?.UnidadNegocio is { Length: > 0 } u ? u : c.UnidadNegocio.Length > 0 ? c.UnidadNegocio : c.UnidadesNegocio.FirstOrDefault()?.Codigo ?? "",
            Motivo = anterior?.Motivo ?? c.MotivoDefault
        };
        if (anterior is not null && anterior.Comprobante.Length == 0) { _draft.Fecha = anterior.Fecha; _draft.Deposito = anterior.Deposito; _draft.DepositoDestino = anterior.DepositoDestino; }
        _articulos.Clear(); _plan = null; _planError = null; _cargado = null; _sucio = false; _operacion = Guid.NewGuid();
        _nuevoArticulo = null; _nuevoCodigo = ""; _nuevoCantidad = "1";
        _modo = Modo.Edicion;
        var tc = (tipo ?? anterior?.Tc ?? "").Trim().ToUpperInvariant();
        if (TiposOpciones.Any(t => t.Value == tc)) AplicarTipo(tc);
        UpdateHeader();
    }
    private Task NuevoAsync()
    {
        if (_busy || _contexto is null) return Task.CompletedTask;
        _feedback = null;
        EmpezarNuevo();
        _ = FocoAsync("sm-codigo");
        return Task.CompletedTask;
    }
    private Task ModificarAsync()
    {
        if (_busy || _cargado is not { Editable: true }) return Task.CompletedTask;
        _modo = Modo.Edicion; _sucio = false; _operacion = Guid.NewGuid(); _feedback = null;
        _nuevoArticulo = null; _nuevoCodigo = ""; _nuevoCantidad = "1";
        UpdateHeader();
        _ = RecalcularAsync();
        _ = FocoAsync("sm-codigo");
        return Task.CompletedTask;
    }
    private Task CancelarAsync()
    {
        if (_busy) return Task.CompletedTask;
        if (_sucio && _draft.Lineas.Count > 0) { _confirmarCancelar = true; StateHasChanged(); return Task.CompletedTask; }
        return DescartarAsync();
    }
    // Cancelar: una modificación vuelve a la ficha del comprobante; una carga nueva, a la lista.
    private async Task DescartarAsync()
    {
        _confirmarCancelar = false; _calculoCts?.Cancel();
        await BorrarBorradorAsync();
        if (Editando) { await VerAsync(_draft.Tc, _draft.Comprobante); return; }
        await VolverAListaAsync();
    }
    private Task VolverAListaAsync()
    {
        _modo = Modo.Lista; _cargado = null; _plan = null; _planError = null; _sucio = false;
        _draft = new(); _articulos.Clear();
        return RunAsync(CargarListaAsync);
    }

    private void AplicarTipo(string tc)
    {
        _draft.Tc = tc;
        var deposito = TiposUnidad.Where(t => t.Tc == tc).Select(t => t.IdDeposito).FirstOrDefault(d => d.Length > 0);
        var opciones = Depositos(null);
        if (deposito is not null && opciones.Any(o => o.Value == deposito)) _draft.Deposito = deposito;
        else if (opciones.All(o => o.Value != _draft.Deposito)) _draft.Deposito = opciones.Count == 1 ? opciones[0].Value : "";
        if (!EsTransferencia || _draft.DepositoDestino == _draft.Deposito) _draft.DepositoDestino = "";
    }

    // ---------------------------------------------------------------- Cambios de la carga

    private void Cambiar(Action change)
    {
        if (Bloqueado) return;
        change(); _plan = null; _planError = null; _feedback = null; _sucio = true; UpdateHeader();
        _ = GuardarBorradorAsync();
        _ = RecalcularAsync();
    }
    private void TipoChanged(string? value)
    {
        Cambiar(() => AplicarTipo(value ?? ""));
        _ = RefrescarArticulosAsync();
    }
    private void UnidadChanged(string? value) => Cambiar(() =>
    {
        _draft.UnidadNegocio = value ?? "";
        if (TiposOpciones.All(t => t.Value != _draft.Tc)) _draft.Tc = "";
        if (Depositos(null).All(o => o.Value != _draft.Deposito)) _draft.Deposito = "";
        if (Depositos(null).All(o => o.Value != _draft.DepositoDestino)) _draft.DepositoDestino = "";
    });
    private void DepositoChanged(string? value)
    {
        Cambiar(() => { _draft.Deposito = value ?? ""; if (_draft.DepositoDestino == _draft.Deposito) _draft.DepositoDestino = ""; });
        _ = RefrescarArticulosAsync();
    }
    private void FechaChanged(string? value)
    {
        if (DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var f)) Cambiar(() => _draft.Fecha = f.Date);
    }
    private void CantidadChanged(StockMovimientoLinea item, string? value) => Cambiar(() => item.Cantidad = ParseNumero(value) ?? 0);
    private void BultosChanged(StockMovimientoLinea item, string? value)
        => Cambiar(() => item.Bultos = string.IsNullOrWhiteSpace(value) ? null : ParseNumero(value) ?? -1);

    // Stock del depósito de los artículos ya cargados (cambió el depósito o el tipo).
    private async Task RefrescarArticulosAsync()
    {
        if (_draft.Lineas.Count == 0 || _draft.Deposito.Length == 0 || _disposed) return;
        try
        {
            var articulos = await Service.GetArticulosAsync(_draft.Lineas.Select(x => x.Articulo).ToList(), _draft.Tc, _draft.Deposito, _lifetime.Token);
            foreach (var a in articulos) _articulos[a.Codigo] = a;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { }
    }

    // Saldo y diferencia por artículo mientras se carga (informativo; al grabar se vuelve a calcular).
    private async Task RecalcularAsync()
    {
        _calculoCts?.Cancel();
        if (_contexto is null || _disposed || _modo == Modo.Lista || _draft.Lineas.Count == 0 || _draft.Tc.Length == 0 || _draft.Deposito.Length == 0
            || EsTransferencia && _draft.DepositoDestino.Length == 0) return;
        var cts = _calculoCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(350, cts.Token);
            var plan = await Service.CalcularAsync(Copia(_draft), cts.Token);
            if (cts.IsCancellationRequested || _disposed) return;
            _plan = plan; _planError = null;
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            if (cts.IsCancellationRequested || _disposed) return;
            _plan = null; _planError = Mensaje(ex);
        }
        UpdateHeader();
        await InvokeAsync(StateHasChanged);
    }

    // ---------------------------------------------------------------- Grilla

    private async Task CodigoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || NuevaLineaBloqueada) return;
        var (cantidad, texto) = SepararCantidad(_nuevoCodigo);
        if (texto.Length == 0) return;
        if (_nuevoArticulo is not null && cantidad is null) { await FocoAsync("sm-cantidad"); return; }
        try
        {
            var exacto = await Service.GetArticuloPorCodigoAsync(texto, _draft.Tc, _draft.Deposito, _lifetime.Token);
            if (exacto is not null)
            {
                if (!await PrepararNuevaLineaAsync(exacto)) return;
                if (cantidad is { } c) { _nuevoCantidad = Num(c); await AgregarNuevaLineaAsync(); }
                return;
            }
            var resultados = await BuscarArticulos(texto, _lifetime.Token);
            if (resultados.Count == 0)
            {
                _feedback = AppUiMessage.Warning("Artículo no encontrado", $"No hay artículos para \"{texto}\". Probá con F5 para buscar por descripción.");
                await FocoAsync("sm-codigo");
                return;
            }
            AbrirBuscador(texto, resultados);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _feedback = AppUiMessage.Error("No se pudo buscar el artículo", Mensaje(ex));
        }
    }
    // "3*7791234567890" o "1,5*826": lo anterior al asterisco es la cantidad (como el POS y ventas).
    private static (decimal? Cantidad, string Codigo) SepararCantidad(string? entrada)
    {
        var raw = (entrada ?? "").Trim();
        var i = raw.IndexOf('*');
        if (i > 0 && i < raw.Length - 1 && ParseNumero(raw[..i].Trim()) is { } c && c >= 0)
            return (c, raw[(i + 1)..].Trim());
        return (null, raw);
    }
    private Task CantidadKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? AgregarNuevaLineaAsync() : Task.CompletedTask;

    private async Task<bool> PrepararNuevaLineaAsync(StockMovimientoArticulo articulo)
    {
        if (articulo.Restriccion.Length > 0)
        {
            _feedback = AppUiMessage.Warning("Artículo no disponible acá", $"{articulo.Codigo} {articulo.Descripcion} {articulo.Restriccion}: por ahora movelo desde Alfa Gestión.");
            _nuevoArticulo = null;
            await FocoAsync("sm-codigo");
            return false;
        }
        _nuevoArticulo = articulo; _nuevoCodigo = articulo.Codigo; _nuevoCantidad = EsAjuste ? "" : "1"; _feedback = null;
        await FocoAsync("sm-cantidad");
        return true;
    }
    private async Task AgregarNuevaLineaAsync()
    {
        if (_nuevoArticulo is not { } a || NuevaLineaBloqueada) return;
        var cantidad = ParseNumero(_nuevoCantidad);
        var error = cantidad is null ? "Ingresá la cantidad." : StockMovimientosCalculo.ValidarCantidad(_draft.Tc, cantidad.Value);
        if (error is not null)
        {
            _feedback = AppUiMessage.Warning("Cantidad inválida", error);
            await FocoAsync("sm-cantidad"); return;
        }
        var sumada = false;
        Cambiar(() =>
        {
            _articulos[a.Codigo] = a;
            var existente = _draft.Lineas.FirstOrDefault(x => string.Equals(x.Articulo, a.Codigo, StringComparison.OrdinalIgnoreCase));
            // Mismo artículo otra vez: se suma (en un conteo, lo contado en dos lugares). Si la línea iba en bultos, pasa a unidades.
            if (existente is not null) { existente.Cantidad = (existente.Bultos.HasValue ? LineaPlan(a.Codigo)?.Cantidad ?? 0 : existente.Cantidad) + cantidad!.Value; existente.Bultos = null; sumada = true; }
            else _draft.Lineas.Add(new() { Articulo = a.Codigo, Cantidad = cantidad!.Value });
            _nuevoArticulo = null; _nuevoCodigo = ""; _nuevoCantidad = "1";
        });
        if (sumada) _feedback = AppUiMessage.Info("Artículo repetido", $"{a.Codigo} ya estaba cargado: se sumó la cantidad.");
        await FocoAsync("sm-codigo");
    }

    // ---- Buscador F5 ----
    [JSInvokable]
    public Task AbrirBusquedaDesdeTeclado() => InvokeAsync(AbrirBuscadorAsync);
    private Task AbrirBuscadorAsync()
    {
        if (_modo != Modo.Edicion) return Task.CompletedTask;
        if (NuevaLineaBloqueada || _buscadorAbierto)
        {
            if (!_buscadorAbierto && _contexto is not null && !_busy) _feedback = AppUiMessage.Info("Faltan datos", FaltaParaCargar);
            StateHasChanged();
            return Task.CompletedTask;
        }
        AbrirBuscador(_nuevoArticulo is null ? _nuevoCodigo.Trim() : "", null);
        return Task.CompletedTask;
    }
    private void AbrirBuscador(string texto, IReadOnlyList<StockMovimientoArticulo>? resultados)
    {
        _buscadorTexto = texto; _buscadorIniciales = resultados; _buscadorAbierto = true;
        StateHasChanged();
    }
    private Task<IReadOnlyList<StockMovimientoArticulo>> BuscarArticulos(string texto, CancellationToken ct)
        => Service.BuscarArticulosAsync(texto, _draft.Tc, _draft.Deposito, ct);
    private async Task ElegirArticuloAsync(StockMovimientoArticulo articulo)
    {
        _buscadorAbierto = false;
        await PrepararNuevaLineaAsync(articulo);
    }
    private async Task CerrarBuscadorAsync()
    {
        _buscadorAbierto = false;
        await FocoAsync(_nuevoArticulo is null ? "sm-codigo" : "sm-cantidad");
    }

    // ---------------------------------------------------------------- Grabar / anular

    private Task CalcularParaGrabarAsync() => RunAsync(async () =>
    {
        _calculoCts?.Cancel();
        _plan = await Service.CalcularAsync(Copia(_draft), _lifetime.Token);
        _planError = null;
        _confirmarGrabar = true;
    });
    private string ResumenConfirmacion(StockMovimientoPlan plan)
    {
        var deposito = EsTransferencia ? $"del depósito {_draft.Deposito} al {_draft.DepositoDestino}" : $"en el depósito {_draft.Deposito}";
        var cantidad = EsAjuste ? $"diferencia neta {Num(plan.Lineas.Sum(x => x.Movimiento))}" : $"{Num(plan.Lineas.Sum(x => x.Cantidad))} unidades";
        return $"{plan.Lineas.Count} artículos {deposito}, fecha {plan.Fecha:dd/MM/yyyy} · {cantidad}.";
    }
    private Task GrabarAsync()
    {
        _confirmarGrabar = false;
        StockMovimientoResultado? resultado = null;
        return RunAsync(async () =>
        {
            var plan = _plan ?? throw new InvalidOperationException("Volvé a calcular antes de grabar.");
            var envio = Copia(_draft);
            // En ajustes se manda el saldo que se mostró: si cambió mientras tanto, el servidor pide recalcular.
            if (EsAjuste) foreach (var l in envio.Lineas) l.SaldoEsperado = plan.Lineas.FirstOrDefault(x => string.Equals(x.Articulo, l.Articulo, StringComparison.OrdinalIgnoreCase))?.Saldo;
            resultado = await Service.GrabarAsync(envio, _operacion, _lifetime.Token);
            await BorrarBorradorAsync();
            await TerminadoAsync();
        }, () => resultado is { } r ? AppUiMessage.Success(r.Accion == "M" ? "Cambios grabados" : "Movimiento grabado",
            $"{r.Tc} {r.Comprobante} · {r.Lineas} artículos.") : null);
    }
    private Task AnularAsync()
    {
        _confirmarAnular = false;
        StockMovimientoResultado? resultado = null;
        return RunAsync(async () =>
        {
            resultado = await Service.AnularAsync(_draft.Tc, _draft.Comprobante, _operacion, _lifetime.Token);
            await BorrarBorradorAsync();
            await TerminadoAsync();
        }, () => resultado is { } r ? AppUiMessage.Success("Comprobante anulado", $"{r.Tc} {r.Comprobante} ya no cuenta en el stock.") : null);
    }
    // Después de grabar o anular se vuelve a la lista actualizada (el comprobante queda arriba de todo).
    private async Task TerminadoAsync()
    {
        _modo = Modo.Lista; _cargado = null; _plan = null; _planError = null; _sucio = false; _operacion = Guid.NewGuid();
        _nuevoArticulo = null; _nuevoCodigo = ""; _nuevoCantidad = "1";
        await CargarListaAsync();
    }

    // ---------------------------------------------------------------- Infraestructura

    private async Task RunAsync(Func<Task> action, Func<AppUiMessage?>? exito = null)
    {
        if (_busy || _disposed) return;
        _busy = true; _feedback = null; UpdateHeader(); await InvokeAsync(StateHasChanged);
        try
        {
            var result = await UiOps.RunAsync(action, "Movimientos de stock", _lifetime.Token);
            if (!_disposed) _feedback = result.Success ? exito?.Invoke() : result.Feedback;
        }
        finally { _busy = false; if (!_disposed) { UpdateHeader(); await InvokeAsync(StateHasChanged); } }
    }

    private void ContextChanged()
    {
        if (_disposed) return;
        var baseActual = Sessions.GetActiveSession()?.BaseId;
        var usuarioActual = Users.CurrentUser?.UserName ?? "";
        if (baseActual == _baseInicial && string.Equals(usuarioActual, _usuarioInicial, StringComparison.OrdinalIgnoreCase)) return;
        _baseInicial = baseActual; _usuarioInicial = usuarioActual;
        _ = InvokeAsync(() =>
        {
            _contexto = null; _draft = new(); _articulos.Clear(); _plan = null; _lista = null; _cargado = null; _modo = Modo.Lista;
            _buscadorAbierto = false; _confirmarGrabar = false; _confirmarAnular = false; _confirmarCancelar = false;
            _feedback = AppUiMessage.Warning("Cambió la sesión", "Volvé a cargar el módulo.");
            UpdateHeader(); StateHasChanged();
        });
    }

    // ---- Borrador: sobrevive a una recarga de la página o a un corte de conexión (un conteo largo no se pierde) ----
    private sealed class Borrador
    {
        public StockMovimientoBorrador Draft { get; set; } = new();
        public Dictionary<string, StockMovimientoArticulo> Articulos { get; set; } = new();
    }
    private string BorradorKey => $"alfacore.stockMovimientos.{_baseInicial}.{_usuarioInicial}".ToLowerInvariant();
    private async Task GuardarBorradorAsync()
    {
        if (!_jsListo || _disposed || _contexto is null || _modo != Modo.Edicion) return;
        if (_draft.Lineas.Count == 0) { await BorrarBorradorAsync(); return; }
        try { await Js.InvokeVoidAsync("localStorage.setItem", BorradorKey, JsonSerializer.Serialize(new Borrador { Draft = _draft, Articulos = _articulos })); } catch { }
    }
    private async Task BorrarBorradorAsync()
    {
        if (!_jsListo) return;
        try { await Js.InvokeVoidAsync("localStorage.removeItem", BorradorKey); } catch { }
    }
    private async Task RestaurarBorradorAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string?>("localStorage.getItem", BorradorKey);
            if (string.IsNullOrWhiteSpace(json)) return;
            var b = JsonSerializer.Deserialize<Borrador>(json);
            if (b is null || b.Draft.Lineas.Count == 0 || _draft.Lineas.Count > 0) return;
            _draft = b.Draft;
            _articulos = new(b.Articulos, StringComparer.OrdinalIgnoreCase);
            _modo = Modo.Edicion; _sucio = true; _cargado = null; _operacion = Guid.NewGuid();
            _feedback = AppUiMessage.Info("Carga recuperada", b.Draft.Comprobante.Length > 0
                ? $"Recuperamos la modificación de {b.Draft.Tc} {b.Draft.Comprobante} que tenías sin grabar. Grabala o tocá Cancelar para descartarla."
                : "Recuperamos la carga que tenías sin grabar. Grabala o tocá Cancelar para descartarla.");
            UpdateHeader(); StateHasChanged();
            _ = RecalcularAsync();
        }
        catch { /* Borrador ilegible: se ignora. */ }
    }

    private static StockMovimientoBorrador Copia(StockMovimientoBorrador b)
        => JsonSerializer.Deserialize<StockMovimientoBorrador>(JsonSerializer.Serialize(b))!;
    private static string Mensaje(Exception ex) => ex is AppUserFacingException u ? $"{u.UserMessage} Código: {u.ErrorCode}" : ex is InvalidOperationException ? ex.Message : "Volvé a intentar.";
    private async Task FocoAsync(string id)
    {
        StateHasChanged();
        try { await Js.InvokeVoidAsync("cargaDirecta.focus", id); } catch { }
    }
    // Acepta coma o punto decimal (es-AR).
    private static decimal? ParseNumero(string? value)
    {
        var texto = (value ?? "").Trim();
        if (texto.Length == 0) return null;
        if (texto.Contains(',') && texto.Contains('.')) texto = texto.Replace(".", "");
        texto = texto.Replace(',', '.');
        return decimal.TryParse(texto, NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var n) ? n : null;
    }
    private static string Num(decimal x) => x.ToString("0.####", Ar);

    // ---------------------------------------------------------------- Header (Context Toolbar)

    private void UpdateHeader()
    {
        if (_disposed) return;
        var lista = _modo == Modo.Lista;
        PageHeader.Set(new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot, ModuleKey = "stock",
            Title = _modo switch
            {
                Modo.Lista => "Movimientos de stock",
                Modo.Ver => $"{_draft.Tc} {_draft.Comprobante}",
                _ => Editando ? $"Modificar {_draft.Tc} {_draft.Comprobante}" : "Nuevo movimiento de stock"
            },
            Breadcrumb = ["Stock", "Movimientos"], ShowHistoryNavigation = false,
            TopNavigationItems = ModuleTopNavPresets.BuildStock(RouteContext, Nav, "movimientos"),
            State = _busy ? PageHeaderState.Loading : _modo switch
            {
                Modo.Lista => PageHeaderState.List,
                Modo.Ver => PageHeaderState.Detail,
                _ => Editando ? PageHeaderState.Editing : PageHeaderState.Creating
            },
            Search = lista && _contexto is not null ? new() : null,
            SearchContent = lista && _contexto is not null ? RenderBusqueda() : null,
            Pagination = lista && _lista is { } p ? new()
            {
                PageLabel = $"{p.Pagina} / {p.TotalPaginas}", Label = $"{p.Total} comprobantes",
                HasPrevious = p.Pagina > 1, HasNext = p.Pagina < p.TotalPaginas, Disabled = _busy,
                OnPrevious = () => PaginarAsync(-1), OnNext = () => PaginarAsync(1)
            } : null,
            Actions = Acciones()
        });
    }
    private List<PageHeaderAction> Acciones()
    {
        var acciones = new List<PageHeaderAction>();
        if (_contexto is null)
        {
            acciones.Add(new() { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Disabled = _busy, OnClick = InicializarAsync });
            return acciones;
        }
        switch (_modo)
        {
            case Modo.Lista:
                acciones.Add(new() { Key = "nuevo", Label = "Nuevo movimiento", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential, Disabled = _busy || _contexto.Tipos.Count == 0, OnClick = NuevoAsync });
                acciones.Add(new() { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost,
                    Disabled = _busy, OnClick = () => RunAsync(CargarListaAsync) });
                break;
            case Modo.Ver:
                var editable = _cargado is { Editable: true };
                acciones.Add(new() { Key = "modificar", Label = "Modificar", Icon = "bi-pencil", Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential, Disabled = _busy || !editable, Title = _cargado?.MotivoNoEditable ?? "", OnClick = ModificarAsync });
                acciones.Add(new() { Key = "volver", Label = "Volver", Icon = "bi-arrow-left", Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = VolverAListaAsync });
                acciones.Add(new() { Key = "anular", Label = "Anular", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _busy || !editable, Title = _cargado?.MotivoNoEditable ?? "", OnClick = () => { _confirmarAnular = true; return InvokeAsync(StateHasChanged); } });
                break;
            default:
                acciones.Add(new() { Key = "grabar", Label = _busy ? "Grabando..." : Editando ? "Grabar cambios" : "Grabar", Icon = "bi-floppy", Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential, Busy = _busy,
                    Disabled = _busy || _draft.Lineas.Count == 0 || _draft.Deposito.Length == 0 || EsTransferencia && _draft.DepositoDestino.Length == 0, OnClick = CalcularParaGrabarAsync });
                acciones.Add(new() { Key = "cancelar", Label = "Cancelar", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = CancelarAsync });
                acciones.Add(new() { Key = "buscar-articulo", Label = "Buscar artículo (F5)", Icon = "bi-box-seam", Priority = PageHeaderActionPriority.Overflow, Disabled = NuevaLineaBloqueada, OnClick = AbrirBuscadorAsync });
                if (Editando)
                    acciones.Add(new() { Key = "anular", Label = "Anular", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow,
                        Disabled = _busy, OnClick = () => { _confirmarAnular = true; return InvokeAsync(StateHasChanged); } });
                break;
        }
        return acciones;
    }

    public void Dispose()
    {
        _disposed = true; Sessions.SessionChanged -= ContextChanged; Users.StateChanged -= ContextChanged;
        _calculoCts?.Cancel();
        _lifetime.Cancel(); _lifetime.Dispose(); PageHeader.Clear();
        if (_jsListo) { try { _ = Js.InvokeVoidAsync("cargaDirecta.dispose"); } catch { } }
        _dotNetRef?.Dispose();
    }
}
