    private async Task HandleContactApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            CloseSearchPanel();
            return;
        }

        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase) || _loadingList)
            return;

        await AplicarFiltrosAsync();
    }

    private async Task BuscarAsync()
    {
        _listSearchCts?.Cancel();
        _listSearchCts?.Dispose();
        var searchCts = new CancellationTokenSource();
        _listSearchCts = searchCts;
        var token = searchCts.Token;

        _loadingList = true;
        _listErrorMessage = string.Empty;
        SyncFilters();
        var searchFilters = CloneContactFilters(_filters);
        searchFilters.PageNumber = _filters.PageNumber;

        try
        {
            var result = await ContactosSvc.SearchAsync(searchFilters, token);
            if (token.IsCancellationRequested || !ReferenceEquals(_listSearchCts, searchCts))
                return;

            _items.Clear();
            _items.AddRange(result.Items);
            _selectedIds.IntersectWith(_items.Select(item => item.Id));
            if (_selectedId > 0 && !_items.Any(item => item.Id == _selectedId))
                _selectedId = 0;
            _pagedTotal  = result.Total;
            _pageNumber  = result.PageNumber;
            _totalPages  = result.TotalPages;
            _hasPrev     = result.HasPrev;
            _hasNext     = result.HasNext;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (token.IsCancellationRequested || !ReferenceEquals(_listSearchCts, searchCts))
                return;

            SetFeedback(UiOps.BuildMessage(ex, "No se pudieron cargar los contactos."));
            _listErrorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Reintentá la búsqueda o revisá la base activa."
                : ex.Message;
        }
        finally
        {
            if (ReferenceEquals(_listSearchCts, searchCts))
            {
                _loadingList = false;
                _listSearchCts = null;
                searchCts.Dispose();
                UpdatePageHeader();
            }
            else
            {
                searchCts.Dispose();
            }
        }
    }

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page > _totalPages || _loadingList)
            return;
        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private async Task SortContactsByAsync(string columnKey)
    {
        if (_loadingList)
            return;

        if (string.Equals(_filters.OrdenarPor, columnKey, StringComparison.OrdinalIgnoreCase))
            _filters.OrdenDescendente = !_filters.OrdenDescendente;
        else
        {
            _filters.OrdenarPor = columnKey;
            _filters.OrdenDescendente = false;
        }

        _filters.PageNumber = 1;
        await BuscarAsync();
    }

