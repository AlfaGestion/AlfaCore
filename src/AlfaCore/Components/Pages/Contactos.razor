    private async Task LoadBulkTemplatesAsync()
    {
        _loadingBulkTemplates = true;
        _bulkTemplateError = string.Empty;
        try
        {
            var result = await UiOps.RunAsync(
                () => ConversacionesSvc.GetTemplatesAsync(new ConversacionPlantillaFilters { EstadoMeta = "APPROVED", IncluirInactivas = false }),
                "No se pudieron cargar las plantillas aprobadas.");

            if (!result.Success || result.Value is null)
            {
                _bulkTemplateError = result.Feedback?.Message ?? "No se pudieron cargar las plantillas aprobadas.";
                return;
            }

            _bulkTemplates.Clear();
            _bulkTemplates.AddRange(result.Value.Where(template => template.Activa && string.Equals(template.EstadoMeta, "APPROVED", StringComparison.OrdinalIgnoreCase)));
            if (_bulkTemplates.Count == 0)
                _bulkTemplateError = "No hay plantillas aprobadas disponibles para envío masivo.";
        }
        finally
        {
            _loadingBulkTemplates = false;
        }
