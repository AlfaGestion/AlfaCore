            return;
        }

        var phone = FirstNonEmpty(contact.Celular, contact.Telefono);
        if (string.IsNullOrWhiteSpace(phone))
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Teléfono requerido",
                Message = "Cargá un teléfono o celular para crear una conversación de WhatsApp."
            });
            return;
        }

        _openingConversation = true;
        try
        {
            var result = await UiOps.RunAsync(
                () => ConversacionesSvc.CreateOrGetWhatsAppConversationAsync(new ConversacionCrearWhatsAppRequest { TelefonoWhatsApp = phone }),
                "No se pudo crear la conversación.");

            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            Nav.NavigateTo($"/conversaciones?id={result.Value.IdConversacion.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        }
        finally
        {
            _openingConversation = false;
        }
    }

    private static bool HasContactPhone(ContactoGridItemDto contact)
        => !string.IsNullOrWhiteSpace(FirstNonEmpty(contact.Celular, contact.Telefono));

    private static bool HasRecordPhone(ContactoDetailDto contact)
        => !string.IsNullOrWhiteSpace(FirstNonEmpty(contact.Celular, contact.Telefono));

    private IEnumerable<ContactoGridItemDto> GetSelectedContactsWithPhone()
        => _items
            .Where(item => _selectedIds.Contains(item.Id))
            .Where(HasContactPhone)
            .OrderBy(item => item.NombreApellido, StringComparer.CurrentCultureIgnoreCase);

    private IEnumerable<ContactoGridItemDto> GetTemplateContactsWithPhone()
    {
        if (_bulkTemplateTargetIds.Length == 0)
            return GetSelectedContactsWithPhone();

        var targetIds = _bulkTemplateTargetIds.ToHashSet();
        var contacts = _items.Where(item => targetIds.Contains(item.Id)).ToList();
        if (_recordDetail is not null && targetIds.Contains(_recordDetail.Id) && contacts.All(item => item.Id != _recordDetail.Id))
            contacts.Add(ToGridItem(_recordDetail));

        return contacts
            .Where(HasContactPhone)
            .OrderBy(item => item.NombreApellido, StringComparer.CurrentCultureIgnoreCase);
    }

    private Task OpenConversationForRecordAsync()
    {
        if (_recordDetail is null)
