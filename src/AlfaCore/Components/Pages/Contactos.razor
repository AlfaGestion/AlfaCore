    private async Task SearchMergeCandidatesAsync()
    {
        if (_selectedId <= 0)
            return;

        _mergeError = string.Empty;
        _mergeCandidates.Clear();
        _mergeSearchExecuted = true;

        if (_mergeSearchText.Trim().Length < 2)
        {
            _mergeError = "Escribí al menos dos caracteres para buscar duplicados.";
            return;
        }

        _loadingMergeCandidates = true;
        try
        {
            var result = await UiOps.RunAsync(
                () => ContactosSvc.SearchMergeCandidatesAsync(_selectedId, _mergeSearchText),
                "No se pudieron buscar contactos para unificar.");

            if (!result.Success || result.Value is null)
            {
                _mergeError = result.Feedback?.Message ?? "No se pudieron buscar contactos para unificar.";
                return;
            }

            _mergeCandidates.AddRange(result.Value);
        }
        finally
        {
            _loadingMergeCandidates = false;
        }
    }

    private void OpenMergeConfirm(ContactoMergeCandidateDto candidate)
    {
        if (_selectedId <= 0 || candidate.Id <= 0 || _mergingContact)
            return;

        _mergeError = string.Empty;
        _mergeConfirmCandidate = candidate;
        _showMergeConfirm = true;
    }

    private async Task ConfirmMergeAsync()
    {
        var candidate = _mergeConfirmCandidate;
        if (_selectedId <= 0 || candidate is null || candidate.Id <= 0 || _mergingContact)
            return;

        _showMergeConfirm = false;
        _mergeError = string.Empty;
        _mergingContact = true;
        try
        {
            var result = await UiOps.RunAsync(
                () => ContactosSvc.MergeContactsAsync(new ContactoMergeRequest
                {
                    ContactoPrincipalId = _selectedId,
                    ContactoDuplicadoId = candidate.Id
                }),
                "No se pudieron unificar los contactos.");

            if (!result.Success)
            {
                _mergeError = result.Feedback?.Message ?? "No se pudieron unificar los contactos.";
                return;
            }

            if (result.Value is not null)
                MapDetailToForm(result.Value);
            else
                await SeleccionarAsync(_selectedId);

            _mergingContact = false;
            CloseMergeModal();
            _selectedIds.Clear();
            SetFeedback(AppUiMessage.Success("Contactos unificados", $"Se unificó {candidate.NombreApellido} dentro de {_form.NombreApellido}."));
            await BuscarAsync();
        }
        finally
        {
            _mergingContact = false;
        }
    }

    private async Task GuardarAsync()
    {
        ClearFieldErrors();
        _saving = true;
        UpdatePageHeader();
        try
        {
            try
            {
                var savedId = await ContactosSvc.SaveAsync(_form);
                SetFeedback(AppUiMessage.Success("Contacto guardado", $"El contacto #{savedId} se guardó correctamente."));
                await BuscarAsync();
                _selectedId = savedId;
                _showEditor = false;
                _isNewMode = false;
                NavigateToContactosState(ContactosUrlState.Base, replace: true);
            }
            catch (AppValidationException validationEx)
            {
                ApplyFieldErrors(validationEx.Validation);
                SetFeedback(new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Revisá los datos del contacto",
                    Message = validationEx.UserMessage,
                    Suggestion = "Corregí los campos marcados y volvé a intentar."
                });
            }
            catch (Exception ex)
            {
                SetFeedback(UiOps.BuildMessage(ex, "No se pudo guardar el contacto."));
            }
        }
        finally
        {
            _saving = false;
            UpdatePageHeader();
        }
    }

