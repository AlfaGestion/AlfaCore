    private static string GetInitial(string? value)
    {
        var normalized = value?.Trim();
        return string.IsNullOrWhiteSpace(normalized)
            ? "?"
            : normalized[0].ToString().ToUpperInvariant();
    }

    private static string TruncateText(string? value, int maxLength)
    {
        var normalized = value?.Trim() ?? string.Empty;
        if (normalized.Length <= maxLength)
            return normalized;

        return $"{normalized[..Math.Max(0, maxLength - 1)]}…";
    }

    private static int CountTemplateVariables(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return 0;

        var max = 0;
        foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(text, @"\{\{\s*(\d+)\s*\}\}"))
        {
            if (int.TryParse(match.Groups[1].Value, out var index))
                max = Math.Max(max, index);
        }

        return max;
    }

    private static IReadOnlyList<string> ParseTemplateValues(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return [];

        var normalized = text.Replace("\r\n", "\n").Replace('\r', '\n');
        if (normalized.Split('\n').Any(x => string.Equals(x.Trim(), "---", StringComparison.Ordinal)))
        {
            var result = new List<string>();
            var current = new List<string>();
            foreach (var line in normalized.Split('\n'))
            {
                if (string.Equals(line.Trim(), "---", StringComparison.Ordinal))
                {
                    AddTemplateValueBlock(result, current);
                    current.Clear();
                    continue;
                }

                current.Add(line);
            }

            AddTemplateValueBlock(result, current);
            return result;
        }

        return normalized
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .ToList();
    }

    private static AppUiMessage BuildBulkTemplateFeedback(int acceptedByMeta, int failed, int pendingConfirmation)
    {
        var hasUnconfirmed = pendingConfirmation > 0;
        return new AppUiMessage
        {
            Severity = failed > 0 || hasUnconfirmed ? AppUiFeedbackSeverity.Warning : AppUiFeedbackSeverity.Success,
            Title = "Envío masivo finalizado",
            Message = BuildBulkTemplateResultMessage(acceptedByMeta, failed, pendingConfirmation),
            Suggestion = hasUnconfirmed
                ? "La entrega final puede actualizarse después cuando WhatsApp informe el estado."
                : string.Empty
        };
    }

    private static string BuildBulkTemplateResultMessage(int acceptedByMeta, int failed, int pendingConfirmation)
    {
        var parts = new List<string>
        {
            $"Solicitudes aceptadas por Meta: {acceptedByMeta}.",
            $"Fallidas al intentar enviar: {failed}."
        };

        if (pendingConfirmation > 0)
            parts.Add($"Pendientes de confirmación de entrega: {pendingConfirmation}.");

        return string.Join(" ", parts);
    }

    private static bool IsKnownFailedDeliveryState(string? state)
        => !string.IsNullOrWhiteSpace(state)
           && state.Contains("ERROR", StringComparison.OrdinalIgnoreCase);

    private static bool IsKnownDeliveredDeliveryState(string? state)
        => string.Equals(state, "ENTREGADO", StringComparison.OrdinalIgnoreCase)
           || string.Equals(state, "LEIDO", StringComparison.OrdinalIgnoreCase);

    private static void AddTemplateValueBlock(List<string> result, List<string> lines)
    {
        var block = string.Join(Environment.NewLine, lines).Trim();
        if (block.Length > 0)
            result.Add(block);
    }

