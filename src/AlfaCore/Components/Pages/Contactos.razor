        => new()
        {
            Label = $"{_pagedTotal} registro(s)",
            PageLabel = $"{_pageNumber} / {_totalPages}",
            HasPrevious = _hasPrev,
            HasNext = _hasNext,
            Disabled = _loadingList,
            OnPrevious = () => CambiarPaginaAsync(_pageNumber - 1),
            OnNext = () => CambiarPaginaAsync(_pageNumber + 1)
        };

    protected override async Task OnInitializedAsync()
    {
        AppUserSession.StateChanged += OnAppUserSessionChanged;
        Nav.LocationChanged += OnLocationChanged;
        UpdatePageHeader();
        await EnsureViewSettingsLoadedAsync();
        await CargarProvinciasAsync();
        ApplyStartupQuery();
        await BuscarAsync();
        if (_startupEditId is int id)
        {
            await AbrirEditorAsync(id, updateUrl: false);
            if (_startupOpenMerge && _selectedId > 0)
                await OpenMergeModalAsync();
        }
        else if (_startupRecordId is int recordId)
        {
            await AbrirFichaAsync(recordId, updateUrl: false);
        }
        UpdatePageHeader();
    }

    public void Dispose()
    {
        AppUserSession.StateChanged -= OnAppUserSessionChanged;
        Nav.LocationChanged -= OnLocationChanged;
        PageHeader.Clear();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _listSearchCts?.Cancel();
        _listSearchCts?.Dispose();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(DismissFeedbackAsync);
        _ = InvokeAsync(ApplyCurrentLocationAsync);
    }

    private async Task ApplyCurrentLocationAsync()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _returnUrl = ReadSafeReturnUrl(query);

        if (query.TryGetValue("contacto", out var contactRaw)
            && int.TryParse(contactRaw.ToString(), out var contactId)
            && contactId > 0)
        {
            if (query.ContainsKey("editar"))
                Nav.NavigateTo(BuildContactosQueryUrl("contacto", contactId), replace: true);

            if (!_showRecordView || _selectedId != contactId)
                await AbrirFichaAsync(contactId, updateUrl: false);
            return;
        }

        if (query.TryGetValue("editar", out var editRaw)
            && int.TryParse(editRaw.ToString(), out var editId)
            && editId > 0)
        {
            if (!_showEditor || _selectedId != editId)
                await AbrirEditorAsync(editId, updateUrl: false);
            return;
        }

        if (_showEditor && !_isNewMode)
            CerrarEditor(useReturnUrl: false);
        if (_showRecordView)
            await VolverDesdeFichaCoreAsync(updateUrl: false);
    }

    private void OnAppUserSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await EnsureViewSettingsLoadedAsync(force: true);
            StateHasChanged();
        });
