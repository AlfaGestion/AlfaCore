    private async Task HandleContactEmptyActionAsync()
    {
        if (HasContactSearchFilters())
        {
            await ClearContactFiltersAsync();
            return;
        }

        BeginNew();
    }

    private bool HasContactSearchFilters()
        => !string.IsNullOrWhiteSpace(_filters.Texto)
           || !string.IsNullOrWhiteSpace(_filters.ProvinciaCodigo)
           || _filters.TieneEmail.HasValue
           || _filters.TieneCelular.HasValue
           || _filters.TieneWhatsApp.HasValue
           || !string.Equals(_activoFiltro, "1", StringComparison.OrdinalIgnoreCase)
           || _viewSettings.AgruparPor != ContactosViewGroupKeys.None;

    private async Task ClearContactFiltersAsync()
    {
        _filters.Texto = string.Empty;
        _filters.ProvinciaCodigo = string.Empty;
        _filters.TieneEmail = null;
        _filters.TieneCelular = null;
        _filters.TieneWhatsApp = null;
        _filters.Activo = true;
        _filters.PageNumber = 1;
        _activoFiltro = "1";
        if (_viewSettings.AgruparPor != ContactosViewGroupKeys.None)
        {
            _viewSettings.AgruparPor = ContactosViewGroupKeys.None;
            var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
            if (!string.IsNullOrWhiteSpace(currentUser))
                await ContactosSvc.SaveViewSettingsAsync(currentUser, _viewSettings);
        }
        await BuscarAsync();
    }

