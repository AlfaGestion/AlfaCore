            return $"Ordenar {column.Label} de menor a mayor";

        return _filters.OrdenDescendente
            ? $"Ordenar {column.Label} de menor a mayor"
            : $"Ordenar {column.Label} de mayor a menor";
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
            _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task SeleccionarAsync(int id)
    {
        if (id <= 0)
            return;

        var result = await UiOps.RunAsync(() => ContactosSvc.GetByIdAsync(id), "No se pudo cargar el contacto.");
        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }

        if (result.Value is null)
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Contacto no disponible",
                Message = "El contacto seleccionado ya no existe en la base activa."
            });
            await BuscarAsync();
            BeginNew();
            return;
        }

        MapDetailToForm(result.Value);
    }

    private async Task AbrirFichaAsync(int id, bool updateUrl = true)
    {
        if (id <= 0)
            return;

        if (updateUrl)
            NavigateToRecordUrl(id);

        _recordReturnViewMode = _viewMode == ContactosViewModeKeys.Kanban
            ? ContactosViewModeKeys.Kanban
            : ContactosViewModeKeys.Listado;
        _showEditor = false;
        _showRecordView = true;
        _isNewMode = false;
        _showViewSettings = false;
        _recordActiveTab = ContactosRecordTabKeys.Informacion;
        SetFeedback(null);
        await CargarFichaAsync(id);
        UpdatePageHeader();
    }

    private async Task CargarFichaAsync(int id)
    {
        _loadingRecord = true;
        _recordErrorMessage = string.Empty;
        _recordDetail = null;
        _selectedId = id;
        UpdatePageHeader();

        try
        {
            var result = await UiOps.RunAsync(() => ContactosSvc.GetByIdAsync(id), "No se pudo cargar el contacto.");
            if (!result.Success)
            {
                _recordErrorMessage = result.Feedback?.Message ?? "Reintentá la carga o revisá la base activa.";
                return;
            }

            if (result.Value is null)
            {
                _selectedActivo = false;
                _selectedConversationId = null;
                return;
            }

            _recordDetail = result.Value;
            ApplyDetailState(result.Value);
            _isNewMode = false;
        }
        finally
        {
            _loadingRecord = false;
            UpdatePageHeader();
        }
    }

    private Task RecargarFichaAsync()
        => _selectedId > 0 ? CargarFichaAsync(_selectedId) : Task.CompletedTask;

    private Task VolverDesdeFichaAsync()
        => VolverDesdeFichaCoreAsync(updateUrl: true);

    private Task VolverDesdeFichaCoreAsync(bool updateUrl)
    {
        if (updateUrl)
        {
            NavigateToContactosState(ContactosUrlState.Base, replace: true);
            return Task.CompletedTask;
        }

        _showRecordView = false;
        _recordDetail = null;
        _recordErrorMessage = string.Empty;
        _loadingRecord = false;
        _viewMode = _recordReturnViewMode == ContactosViewModeKeys.Kanban
            ? ContactosViewModeKeys.Kanban
            : ContactosViewModeKeys.Listado;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private async Task EditarFichaAsync()
    {
        if (_selectedId <= 0)
            return;

        if (_recordDetail is not null)
            MapDetailToForm(_recordDetail);
        else
            await SeleccionarAsync(_selectedId);

        _showEditor = true;
        _showRecordView = false;
        UpdatePageHeader();
    }

    private Task SetRecordTabAsync(string tab)
    {
        _recordActiveTab = string.IsNullOrWhiteSpace(tab)
            ? ContactosRecordTabKeys.Informacion
            : tab;
        return Task.CompletedTask;
    }

    private string GetRecordProvinciaDisplay()
    {
        var code = _recordDetail?.ProvinciaCodigo;
        if (string.IsNullOrWhiteSpace(code))
            return string.Empty;

        return _provincias.FirstOrDefault(x => string.Equals(x.Codigo, code, StringComparison.OrdinalIgnoreCase))?.Descripcion
            ?? code.Trim();
    }

    private void BeginNew()
    {
        ClearFieldErrors();
        SetFeedback(null);
        _showEditor = true;
        _showRecordView = false;
        _recordDetail = null;
        _recordErrorMessage = string.Empty;
        _isNewMode = true;
        _activeTab = ContactoTab.Datos;
        _selectedId = 0;
        _selectedActivo = true;
        _selectedConversationId = null;
        _linkedAccounts.Clear();

        _form.Id = null;
        _form.NombreApellido = string.Empty;
        _form.Domicilio = string.Empty;
        _form.Localidad = string.Empty;
        _form.ProvinciaCodigo = string.Empty;
        _form.CodigoPostal = string.Empty;
        _form.NumeroDocumento = string.Empty;
        _form.Telefono = string.Empty;
        _form.TelefonoAlternativo = string.Empty;
        _form.Celular = string.Empty;
        _form.Email = string.Empty;
        _form.MailPagosCobranzas = false;
        _form.MailOrdenCompra = false;
        _form.MailOrdenTrabajo = false;
        _form.Website = string.Empty;
        _form.Cargo = string.Empty;
