@page "/contactos"
@using AlfaCore.Models
@using AlfaCore.Services
@using Microsoft.AspNetCore.WebUtilities
@inject IContactosService ContactosSvc
@inject IConversacionesService ConversacionesSvc
@inject IAppUiOperationService UiOps
@inject IAppUserSessionService AppUserSession
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Contactos | Alfa Gestión</PageTitle>

<div class="page-grid contactos-page" @onclick="HandlePageClickAsync">
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">Contactos</h2>
            <p class="page-intro__text">Administrá la agenda general del sistema con datos de contacto, observaciones y baja lógica.</p>
        </div>
        <div class="actions">
            <button type="button" class="btn btn--primary" @onclick="BeginNew">
                <i class="bi bi-plus-circle"></i> Nuevo contacto
            </button>
            <button type="button" class="btn btn--ghost" @onclick="RecargarAsync" disabled="@_loadingList">
                <i class="bi bi-arrow-clockwise"></i> Recargar
            </button>
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg editor-msg--animated @GetFeedbackClass(_feedback) @(_feedbackLeaving ? "is-leaving" : string.Empty)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel-card smart-search-card" @onclick:stopPropagation>
        <div class="smart-search">
            <div class="smart-search__bar">
                <i class="bi bi-search"></i>
                <input type="search"
                       placeholder="Buscar contactos..."
                       value="@_filters.Texto"
                       @onfocus="OpenContactSearchPanel"
                       @oninput="OnContactSearchInput" />
                <button type="button" class="smart-search__toggle" @onclick="ToggleContactSearchPanel" aria-label="Mostrar filtros">
                    <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                </button>
            </div>

            <div class="smart-search__chips" aria-live="polite">
                @foreach (var chip in BuildContactFilterChips())
                {
                    <button type="button" class="smart-chip" @onclick="() => RemoveContactChipAsync(chip.Key)">
                        @chip.Label <i class="bi bi-x"></i>
                    </button>
                }
                @if (BuildContactFilterChips().Count == 0)
                {
                    <span class="smart-search__hint">Click en el buscador para filtros, agrupaciones y favoritos.</span>
                }
            </div>

            @if (_showSearchPanel)
            {
                <div class="smart-search__panel">
                    <div class="smart-search__column">
                        <h4><i class="bi bi-funnel-fill"></i> Filtros</h4>
                        <button type="button" class='@GetSmartOptionClass(_activoFiltro == "1")' @onclick='() => SetContactStatusFilterAsync("1")'>Personas activas</button>
                        <button type="button" class='@GetSmartOptionClass(_activoFiltro == "0")' @onclick='() => SetContactStatusFilterAsync("0")'>Inactivos</button>
                        <button type="button" class="@GetSmartOptionClass(_filters.TieneEmail == true)" @onclick='() => ToggleContactBoolFilterAsync("email")'>Con email</button>
                        <button type="button" class="@GetSmartOptionClass(_filters.TieneEmail == false)" @onclick='() => ToggleContactBoolFilterAsync("sin-email")'>Sin email</button>
                        <button type="button" class="@GetSmartOptionClass(_filters.TieneCelular == true)" @onclick='() => ToggleContactBoolFilterAsync("celular")'>Con celular</button>
                        <button type="button" class="@GetSmartOptionClass(_filters.TieneWhatsApp == true)" @onclick='() => ToggleContactBoolFilterAsync("whatsapp")'>Con conversación WhatsApp</button>
                    </div>
                    <div class="smart-search__column">
                        <h4><i class="bi bi-stack"></i> Agrupar por</h4>
                        <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == ContactosViewGroupKeys.None)" @onclick='() => SetContactGroupAsync(ContactosViewGroupKeys.None)'>Sin agrupar</button>
                        <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == ContactosViewGroupKeys.Activo)" @onclick='() => SetContactGroupAsync(ContactosViewGroupKeys.Activo)'>Estado</button>
                        <div class="smart-search__inline">
                            <label>Provincia</label>
                            <select value="@_filters.ProvinciaCodigo" @onchange="OnContactProvinciaChangedAsync">
                                <option value="">Todas</option>
                                @foreach (var provincia in _provincias)
                                {
                                    <option value="@provincia.Codigo">@provincia.Descripcion</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="smart-search__column">
                        <h4><i class="bi bi-star-fill"></i> Favoritos</h4>
                        <button type="button" @onclick='() => ApplyContactFavoriteAsync("contactables")'>Contactables</button>
                        <button type="button" @onclick='() => ApplyContactFavoriteAsync("para-soporte")'>Para soporte</button>
                        <button type="button" @onclick="SaveContactFavorite">Guardar búsqueda actual</button>
                        @foreach (var favorite in _contactFavorites)
                        {
                            <button type="button" @onclick="() => ApplySavedContactFavoriteAsync(favorite)">@favorite.Label</button>
                        }
                    </div>
                    <div class="smart-search__custom">
                        <h4><i class="bi bi-sliders"></i> Filtro personalizado</h4>
                        <select @bind="_contactRuleDraft.Campo">
                            <option value="nombre">Nombre</option>
                            <option value="email">Email</option>
                            <option value="telefono">Teléfono</option>
                            <option value="celular">Celular</option>
                            <option value="localidad">Localidad</option>
                            <option value="provincia">Provincia</option>
                            <option value="cargo">Cargo</option>
                        </select>
                        <select @bind="_contactRuleDraft.Operador">
                            <option value="contains">contiene</option>
                            <option value="equals">es igual a</option>
                            <option value="starts">empieza con</option>
                            <option value="empty">está vacío</option>
                            <option value="not-empty">no está vacío</option>
                        </select>
                        <input type="text" placeholder="Valor" @bind="_contactRuleDraft.Valor" disabled="@IsValueOptionalOperator(_contactRuleDraft.Operador)" />
                        <button type="button" class="btn btn--primary btn--sm" @onclick="AddContactRuleAsync">Agregar regla</button>
                    </div>
                </div>
            }
        </div>
    </section>

    @if (_showViewSettings && !_showEditor)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Elegí columnas visibles, su orden y agrupación para la grilla de contactos.</p>
                </div>
            </div>

            <div class="usuarios-view-settings">
                <div class="field">
                    <label>Agrupar por</label>
                    <select @bind="_draftAgruparPor">
                        <option value="@ContactosViewGroupKeys.None">Sin agrupar</option>
                        <option value="@ContactosViewGroupKeys.Activo">Estado (Activo / Inactivo)</option>
                    </select>
                </div>

                <div class="usuarios-view-settings__list">
                    @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="checkbox">
                                <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                <span>@column.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">
                        <i class="bi bi-floppy"></i> Guardar vista
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </div>
        </section>
    }

    @if (_showEditor)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@(_isNewMode ? "Nuevo contacto" : $"Editar {_form.NombreApellido}")</h3>
                    <p class="panel-card__subtitle">@(_isNewMode ? "Completá los datos principales del contacto." : $"Código interno: {_selectedId} · Estado: {(_selectedActivo ? "Activo" : "Inactivo")}")</p>
                </div>
                <div class="actions">
                    @if (!_isNewMode)
                    {
                        <button type="button" class="btn btn--primary" @onclick="OpenConversationForSelectedAsync" disabled="@(_saving || _openingConversation)">
                            <i class="bi bi-whatsapp"></i>
                            <span>@GetConversationActionLabel(_selectedConversationId)</span>
                        </button>
                    }
                    <button type="button" class="btn btn--ghost" @onclick="CerrarEditor" disabled="@_saving">
                        <i class="bi bi-arrow-left"></i>
                        <span>Volver al listado</span>
                    </button>
                </div>
            </div>

            <div class="contactos-tabs">
                <button type="button"
                        class="btn @(_activeTab == ContactoTab.Datos ? "btn--primary" : "btn--ghost")"
                        @onclick="() => _activeTab = ContactoTab.Datos">
                    Datos generales
                </button>
                <button type="button"
                        class="btn @(_activeTab == ContactoTab.Observaciones ? "btn--primary" : "btn--ghost")"
                        @onclick="() => _activeTab = ContactoTab.Observaciones">
                    Observaciones
                </button>
                <button type="button"
                        class="btn @(_activeTab == ContactoTab.Cuentas ? "btn--primary" : "btn--ghost")"
                        @onclick="() => _activeTab = ContactoTab.Cuentas">
                    Clientes / proveedores
                </button>
            </div>

            @if (_activeTab == ContactoTab.Datos)
            {
                <div class="contactos-form">
                    <div class="contactos-form__grid">
                        <div class="field">
                            <label>Nombre y apellido</label>
                            <input type="text" class="@GetFieldInputClass("nombre")" maxlength="100" @bind="_form.NombreApellido" disabled="@_saving" />
                            @if (HasFieldError("nombre"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("nombre")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Domicilio</label>
                            <input type="text" class="@GetFieldInputClass("domicilio")" maxlength="100" @bind="_form.Domicilio" disabled="@_saving" />
                            @if (HasFieldError("domicilio"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("domicilio")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Localidad</label>
                            <input type="text" class="@GetFieldInputClass("localidad")" maxlength="100" @bind="_form.Localidad" disabled="@_saving" />
                            @if (HasFieldError("localidad"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("localidad")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Código postal</label>
                            <input type="text" class="@GetFieldInputClass("codigo-postal")" maxlength="20" @bind="_form.CodigoPostal" disabled="@_saving" />
                            @if (HasFieldError("codigo-postal"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("codigo-postal")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Provincia</label>
                            <select class="@GetFieldInputClass("provincia")" @bind="_form.ProvinciaCodigo" disabled="@(_saving || _loadingProvincias)">
                                <option value="">Seleccionar...</option>
                                @foreach (var item in _provincias)
                                {
                                    <option value="@item.Codigo">@item.Descripcion</option>
                                }
                            </select>
                            @if (HasFieldError("provincia"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("provincia")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Nro. documento</label>
                            <input type="text" class="@GetFieldInputClass("numero-documento")" maxlength="13" @bind="_form.NumeroDocumento" disabled="@_saving" />
                            @if (HasFieldError("numero-documento"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("numero-documento")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Teléfono</label>
                            <input type="text" class="@GetFieldInputClass("telefono")" maxlength="100" @bind="_form.Telefono" disabled="@_saving" />
                            @if (HasFieldError("telefono"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("telefono")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Tel. alternativo</label>
                            <input type="text" class="@GetFieldInputClass("telefono-alternativo")" maxlength="100" @bind="_form.TelefonoAlternativo" disabled="@_saving" />
                            @if (HasFieldError("telefono-alternativo"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("telefono-alternativo")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Celular</label>
                            <input type="text" class="@GetFieldInputClass("celular")" maxlength="100" @bind="_form.Celular" disabled="@_saving" />
                            @if (HasFieldError("celular"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("celular")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>E-mail</label>
                            <input type="email" class="@GetFieldInputClass("email")" maxlength="100" @bind="_form.Email" disabled="@_saving" />
                            @if (HasFieldError("email"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("email")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Página web</label>
                            <input type="text" class="@GetFieldInputClass("website")" maxlength="100" @bind="_form.Website" disabled="@_saving" />
                            @if (HasFieldError("website"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("website")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Cargo</label>
                            <input type="text" class="@GetFieldInputClass("cargo")" maxlength="100" @bind="_form.Cargo" disabled="@_saving" />
                            @if (HasFieldError("cargo"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("cargo")</small>
                            }
                        </div>
                    </div>

                    <div class="contactos-flags">
                        <label class="checkbox">
                            <input type="checkbox" @bind="_form.MailPagosCobranzas" disabled="@_saving" />
                            <span>Pagos/Cobranzas</span>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" @bind="_form.MailOrdenCompra" disabled="@_saving" />
                            <span>Órdenes de compra</span>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" @bind="_form.MailOrdenTrabajo" disabled="@_saving" />
                            <span>Órdenes de trabajo</span>
                        </label>
                    </div>
                </div>
            }
            else if (_activeTab == ContactoTab.Observaciones)
            {
                <div class="field">
                    <label>Observaciones</label>
                    <textarea class="contactos-observaciones" @bind="_form.Observaciones" disabled="@_saving"></textarea>
                </div>
            }
            else
            {
                <div class="contactos-form">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Cuentas vinculadas</h3>
                            <p class="panel-card__subtitle">Clientes y proveedores relacionados con este contacto.</p>
                        </div>
                    </div>
                    @if (_linkedAccounts.Count == 0)
                    {
                        <div class="usuarios-empty">Este contacto no tiene clientes o proveedores vinculados.</div>
                    }
                    else
                    {
                        <div class="usuarios-table-wrap">
                            <table class="data-table usuarios-table">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>CÃ³digo</th>
                                        <th>Cuenta</th>
                                        <th>RelaciÃ³n</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in _linkedAccounts)
                                    {
                                        <tr>
                                            <td>@account.Tipo</td>
                                            <td>@account.Codigo</td>
                                            <td><strong>@DisplayOrFallback(account.RazonSocial, account.Codigo)</strong></td>
                                            <td>
                                                @if (account.VinculadoPorTabla)
                                                {
                                                    <span>RelaciÃ³n mÃºltiple</span>
                                                }
                                                @if (account.VinculadoPorCuentaRel)
                                                {
                                                    <span>@(account.VinculadoPorTabla ? " / " : string.Empty)CuentaRel</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

            <div class="actions usuarios-editor__actions">
                <button type="button" class="btn btn--primary" @onclick="GuardarAsync" disabled="@_saving">
                    <i class="bi bi-floppy"></i>
                    <span>@(_saving ? "Guardando..." : "Guardar contacto")</span>
                </button>
                <button type="button" class="btn btn--ghost" @onclick="ResetForm" disabled="@_saving">
                    <i class="bi bi-eraser"></i>
                    <span>@(_isNewMode ? "Limpiar" : "Revertir")</span>
                </button>
                @if (!_isNewMode && _selectedActivo)
                {
                    <button type="button" class="btn btn--ghost usuarios-btn-danger" @onclick="DarDeBajaAsync" disabled="@_saving">
                        <i class="bi bi-person-dash"></i>
                        <span>Dar de baja</span>
                    </button>
                }
            </div>
        </section>
    }
    else
    {
        var visibleColumns = GetVisibleColumns();
        var groups = BuildGridGroups();

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Contactos</h3>
                    <p class="panel-card__subtitle">@_pagedTotal registro(s) · Página @_pageNumber de @_totalPages · podés abrir la ficha con el botón editar o con doble clic.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="AbrirConfiguracionVista">
                        <i class="bi bi-sliders"></i> Configurar vista
                    </button>
                    <span class="panel-card__subtitle">Agrupación: @GetGroupingLabel(_viewSettings.AgruparPor)</span>
                </div>
            </div>

            <div class="interfaces-bulkbar">
                <div class="field interfaces-bulkbar__field">
                    <label>Acciones masivas</label>
                    <select @bind="_bulkAction" disabled="@(_loadingList || _selectedIds.Count == 0)">
                        <option value="@BulkActionDeactivate">Dar de baja seleccionados</option>
                    </select>
                </div>
                <button type="button"
                        class="btn btn--ghost interfaces-bulkbar__apply"
                        @onclick="EjecutarAccionSeleccionadaAsync"
                        disabled="@(_loadingList || _selectedIds.Count == 0)">
                    <i class="bi bi-lightning-charge"></i> Aplicar
                </button>
                <span class="panel-card__subtitle">@GetSelectionSummary()</span>
            </div>

            @if (_loadingList)
            {
                <div class="usuarios-empty">Cargando contactos...</div>
            }
            else if (_items.Count == 0)
            {
                <div class="usuarios-empty">No hay contactos para los filtros seleccionados.</div>
            }
            else
            {
                <div class="usuarios-table-wrap">
                    <table class="data-table usuarios-table">
                        <thead>
                            <tr>
                                <th class="interfaces-table__selector">
                                    <input type="checkbox"
                                           class="interfaces-table__checkbox"
                                           checked="@AreAllCurrentPageSelected"
                                           @onchange="ToggleSelectAll"
                                           title="Seleccionar todos los contactos visibles" />
                                </th>
                                @foreach (var col in visibleColumns)
                                {
                                    <th>@col.Label</th>
                                }
                                <th class="interfaces-table__actions">Acciones</th>
                                <th class="contactos-table__actions-head">Conversación</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@(visibleColumns.Count + 3)">@group.Label</td>
                                    </tr>
                                }
                                @foreach (var item in group.Items)
                                {
                                    <tr class="@(_selectedId == item.Id ? "usuarios-table__row is-selected" : "usuarios-table__row")"
                                        @onclick="() => _selectedId = item.Id"
                                        @ondblclick="() => AbrirEditorAsync(item.Id)">
                                        <td class="interfaces-table__selector" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   class="interfaces-table__checkbox"
                                                   checked="@_selectedIds.Contains(item.Id)"
                                                   @onchange="args => ToggleRowSelection(item.Id, args)"
                                                   title="Seleccionar contacto" />
                                        </td>
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td>
                                                @switch (col.Key)
                                                {
                                                    case ContactosViewColumnKeys.Nombre:
                                                        <strong>@item.NombreApellido</strong>
                                                        break;
                                                    case ContactosViewColumnKeys.Localidad:
                                                        @(string.IsNullOrWhiteSpace(item.Localidad) ? "—" : item.Localidad)
                                                        break;
                                                    case ContactosViewColumnKeys.Provincia:
                                                        @(string.IsNullOrWhiteSpace(item.ProvinciaDescripcion) ? item.ProvinciaCodigo : item.ProvinciaDescripcion)
                                                        break;
                                                    case ContactosViewColumnKeys.Telefono:
                                                        @(string.IsNullOrWhiteSpace(item.Telefono) ? "—" : item.Telefono)
                                                        break;
                                                    case ContactosViewColumnKeys.Celular:
                                                        @(string.IsNullOrWhiteSpace(item.Celular) ? "—" : item.Celular)
                                                        break;
                                                    case ContactosViewColumnKeys.Email:
                                                        @(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)
                                                        break;
                                                    case ContactosViewColumnKeys.Cargo:
                                                        @(string.IsNullOrWhiteSpace(item.Cargo) ? "—" : item.Cargo)
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td class="interfaces-table__actions" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
                                            <button type="button"
                                                    class="btn btn--ghost btn--sm interfaces-table__edit"
                                                    @onclick="() => AbrirEditorAsync(item.Id)">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Editar</span>
                                            </button>
                                        </td>
                                        <td class="contactos-table__actions" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
                                            <button type="button"
                                                    class="btn btn--ghost btn--sm contactos-conversation-btn"
                                                    @onclick="() => OpenConversationForContactAsync(item)"
                                                    disabled="@(_openingConversation || !HasContactPhone(item))">
                                                <i class="bi @(item.IdConversacionWhatsApp.HasValue ? "bi-chat-left-text" : "bi-plus-circle")"></i>
                                                <span>@GetConversationActionLabel(item.IdConversacionWhatsApp)</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>

                <div class="result-pagination">
                    <span class="result-pagination__info">@_pagedTotal registro(s)</span>
                    <div class="result-pagination__controls">
                        <button class="result-pagination__btn" title="Página anterior"
                                @onclick="() => CambiarPaginaAsync(_pageNumber - 1)"
                                disabled="@(!_hasPrev || _loadingList)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="result-pagination__btn result-pagination__btn--active">@_pageNumber / @_totalPages</span>
                        <button class="result-pagination__btn" title="Página siguiente"
                                @onclick="() => CambiarPaginaAsync(_pageNumber + 1)"
                                disabled="@(!_hasNext || _loadingList)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <select class="result-pagination__size" title="Registros por página"
                            value="@_filters.PageSize"
                            @onchange="OnPageSizeChangedAsync"
                            disabled="@_loadingList">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            }
        </section>
    }
</div>

@code {
    private readonly ContactosFilters _filters = new();
    private readonly ContactoSaveRequest _form = new();
    private readonly List<ContactoGridItemDto> _items = [];
    private readonly List<ContactoCuentaDto> _linkedAccounts = [];
    private readonly List<ProvinciaOptionDto> _provincias = [];
    private readonly List<ContactoViewColumnDto> _viewSettingsDraft = [];
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<int> _selectedIds = [];
    private AppUiMessage? _feedback;
    private bool _feedbackLeaving;
    private DateTime _feedbackSetAtUtc = DateTime.MinValue;
    private ContactosViewSettingsDto _viewSettings = BuildDefaultViewSettings();
    private bool _loadingList;
    private bool _loadingProvincias;
    private bool _saving;
    private bool _openingConversation;
    private bool _isNewMode = true;
    private bool _showEditor;
    private bool _showViewSettings;
    private bool _viewSettingsLoaded;
    private bool _selectedActivo = true;
    private int _selectedId;
    private int _pagedTotal;
    private int _pageNumber = 1;
    private int _totalPages = 1;
    private bool _hasPrev;
    private bool _hasNext;
    private string _activoFiltro = "1";
    private string _draftAgruparPor = ContactosViewGroupKeys.None;
    private string _viewSettingsUserName = string.Empty;
    private string _bulkAction = BulkActionDeactivate;
    private ContactoTab _activeTab = ContactoTab.Datos;
    private int? _startupEditId;
    private long? _selectedConversationId;
    private bool _showSearchPanel;
    private CancellationTokenSource? _searchDebounceCts;
    private SearchRuleDto _contactRuleDraft = new() { Campo = "nombre", Operador = "contains" };
    private readonly List<SavedContactSearch> _contactFavorites = [];
    private bool AreAllCurrentPageSelected => _items.Count > 0 && _items.All(item => _selectedIds.Contains(item.Id));

    protected override async Task OnInitializedAsync()
    {
        AppUserSession.StateChanged += OnAppUserSessionChanged;
        Nav.LocationChanged += OnLocationChanged;
        await EnsureViewSettingsLoadedAsync();
        await CargarProvinciasAsync();
        ApplyStartupQuery();
        await BuscarAsync();
        if (_startupEditId is int id)
            await AbrirEditorAsync(id);
    }

    public void Dispose()
    {
        AppUserSession.StateChanged -= OnAppUserSessionChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(DismissFeedbackAsync);

    private void OnAppUserSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await EnsureViewSettingsLoadedAsync(force: true);
            StateHasChanged();
        });
    }

    private async Task CargarProvinciasAsync()
    {
        _loadingProvincias = true;
        try
        {
            var result = await UiOps.RunAsync(() => ContactosSvc.GetProvinciasAsync(), "No se pudieron cargar las provincias.");
            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _provincias.Clear();
            _provincias.AddRange(result.Value);
        }
        finally
        {
            _loadingProvincias = false;
        }
    }

    private async Task RecargarAsync()
    {
        await CargarProvinciasAsync();
        await BuscarAsync();
        if (!_isNewMode && _selectedId > 0)
            await SeleccionarAsync(_selectedId);
    }

    private void OpenContactSearchPanel()
        => _showSearchPanel = true;

    private void ToggleContactSearchPanel()
        => _showSearchPanel = !_showSearchPanel;

    private void CloseSearchPanel()
        => _showSearchPanel = false;

    private async Task HandlePageClickAsync()
    {
        CloseSearchPanel();
        await DismissFeedbackAsync();
    }

    private void OnContactSearchInput(ChangeEventArgs e)
    {
        _filters.Texto = e.Value?.ToString() ?? string.Empty;
        DebounceContactSearch();
    }

    private void DebounceContactSearch()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounceCts = cts;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(300, cts.Token);
                if (cts.IsCancellationRequested)
                    return;

                _filters.PageNumber = 1;
                await BuscarAsync();
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private async Task SetContactStatusFilterAsync(string value)
    {
        _activoFiltro = _activoFiltro == value ? string.Empty : value;
        await AplicarFiltrosAsync();
    }

    private async Task ToggleContactBoolFilterAsync(string key)
    {
        switch (key)
        {
            case "email":
                _filters.TieneEmail = _filters.TieneEmail == true ? null : true;
                break;
            case "sin-email":
                _filters.TieneEmail = _filters.TieneEmail == false ? null : false;
                break;
            case "celular":
                _filters.TieneCelular = _filters.TieneCelular == true ? null : true;
                break;
            case "whatsapp":
                _filters.TieneWhatsApp = _filters.TieneWhatsApp == true ? null : true;
                break;
        }

        await AplicarFiltrosAsync();
    }

    private async Task OnContactProvinciaChangedAsync(ChangeEventArgs e)
    {
        _filters.ProvinciaCodigo = e.Value?.ToString() ?? string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task SetContactGroupAsync(string group)
    {
        _viewSettings.AgruparPor = group;
        await AplicarFiltrosAsync();
    }

    private async Task AddContactRuleAsync()
    {
        if (!IsValueOptionalOperator(_contactRuleDraft.Operador) && string.IsNullOrWhiteSpace(_contactRuleDraft.Valor))
            return;

        _filters.Reglas.Add(new SearchRuleDto
        {
            Campo = _contactRuleDraft.Campo,
            Operador = _contactRuleDraft.Operador,
            Valor = _contactRuleDraft.Valor
        });
        _contactRuleDraft = new SearchRuleDto { Campo = "nombre", Operador = "contains" };
        await AplicarFiltrosAsync();
    }

    private async Task RemoveContactChipAsync(string key)
    {
        switch (key)
        {
            case "texto":
                _filters.Texto = string.Empty;
                break;
            case "activo":
                _activoFiltro = string.Empty;
                break;
            case "email":
                _filters.TieneEmail = null;
                break;
            case "celular":
                _filters.TieneCelular = null;
                break;
            case "whatsapp":
                _filters.TieneWhatsApp = null;
                break;
            case "provincia":
                _filters.ProvinciaCodigo = string.Empty;
                break;
            case "localidad":
                _filters.Localidad = string.Empty;
                break;
            case "cargo":
                _filters.Cargo = string.Empty;
                break;
            default:
                if (key.StartsWith("rule:", StringComparison.OrdinalIgnoreCase)
                    && int.TryParse(key[5..], out var index)
                    && index >= 0
                    && index < _filters.Reglas.Count)
                {
                    _filters.Reglas.RemoveAt(index);
                }
                break;
        }

        await AplicarFiltrosAsync();
    }

    private async Task ApplyContactFavoriteAsync(string key)
    {
        if (key == "contactables")
        {
            _activoFiltro = "1";
            _filters.TieneCelular = true;
            _filters.TieneEmail = null;
            _filters.TieneWhatsApp = null;
        }
        else if (key == "para-soporte")
        {
            _activoFiltro = "1";
            _filters.TieneWhatsApp = true;
            _filters.TieneCelular = null;
            _filters.TieneEmail = null;
        }

        await AplicarFiltrosAsync();
    }

    private void SaveContactFavorite()
    {
        var label = BuildContactFilterChips().Count == 0
            ? "Búsqueda sin filtros"
            : string.Join(" + ", BuildContactFilterChips().Take(2).Select(c => c.Label));
        _contactFavorites.Add(new SavedContactSearch(label, CloneContactFilters(_filters), _activoFiltro, _viewSettings.AgruparPor));
    }

    private async Task ApplySavedContactFavoriteAsync(SavedContactSearch favorite)
    {
        CopyContactFilters(favorite.Filters, _filters);
        _activoFiltro = favorite.ActivoFiltro;
        _viewSettings.AgruparPor = favorite.GroupBy;
        await AplicarFiltrosAsync();
    }

    private async Task AplicarFiltrosAsync()
    {
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _loadingList = true;
        SyncFilters();

        try
        {
            var result = await UiOps.RunAsync(() => ContactosSvc.SearchAsync(_filters), "No se pudieron cargar los contactos.");
            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _items.Clear();
            _items.AddRange(result.Value.Items);
            _selectedIds.IntersectWith(_items.Select(item => item.Id));
            if (_selectedId > 0 && !_items.Any(item => item.Id == _selectedId))
                _selectedId = 0;
            _pagedTotal  = result.Value.Total;
            _pageNumber  = result.Value.PageNumber;
            _totalPages  = result.Value.TotalPages;
            _hasPrev     = result.Value.HasPrev;
            _hasNext     = result.Value.HasNext;
        }
        finally
        {
            _loadingList = false;
        }
    }

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page > _totalPages || _loadingList)
            return;
        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
            _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task SeleccionarAsync(int id)
    {
        if (id <= 0)
            return;

        var result = await UiOps.RunAsync(() => ContactosSvc.GetByIdAsync(id), "No se pudo cargar el contacto.");
        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }

        if (result.Value is null)
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Contacto no disponible",
                Message = "El contacto seleccionado ya no existe en la base activa."
            });
            await BuscarAsync();
            BeginNew();
            return;
        }

        MapDetailToForm(result.Value);
    }

    private void BeginNew()
    {
        ClearFieldErrors();
        _showEditor = true;
        _isNewMode = true;
        _activeTab = ContactoTab.Datos;
        _selectedId = 0;
        _selectedActivo = true;
        _selectedConversationId = null;
        _linkedAccounts.Clear();

        _form.Id = null;
        _form.NombreApellido = string.Empty;
        _form.Domicilio = string.Empty;
        _form.Localidad = string.Empty;
        _form.ProvinciaCodigo = string.Empty;
        _form.CodigoPostal = string.Empty;
        _form.NumeroDocumento = string.Empty;
        _form.Telefono = string.Empty;
        _form.TelefonoAlternativo = string.Empty;
        _form.Celular = string.Empty;
        _form.Email = string.Empty;
        _form.MailPagosCobranzas = false;
        _form.MailOrdenCompra = false;
        _form.MailOrdenTrabajo = false;
        _form.Website = string.Empty;
        _form.Cargo = string.Empty;
        _form.Observaciones = string.Empty;
    }

    private void ApplyStartupQuery()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("editar", out var editRaw)
            && int.TryParse(editRaw.ToString(), out var editId)
            && editId > 0)
        {
            _startupEditId = editId;
            return;
        }

        if (!query.TryGetValue("nuevo", out _))
            return;

        BeginNew();
        if (query.TryGetValue("nombre", out var nombre))
            _form.NombreApellido = nombre.ToString();
        if (query.TryGetValue("celular", out var celular))
            _form.Celular = celular.ToString();
        if (query.TryGetValue("telefono", out var telefono))
            _form.Telefono = telefono.ToString();
        if (query.TryGetValue("email", out var email))
            _form.Email = email.ToString();

        _filters.Texto = _form.NombreApellido;
        SetFeedback(new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Info,
            Title = "Nuevo contacto desde conversaciones",
            Message = "Completá los datos que falten y guardá el contacto para usarlo en soporte."
        });
    }

    private void CerrarEditor()
    {
        ClearFieldErrors();
        _showEditor = false;
        _linkedAccounts.Clear();
    }

    private void ResetForm()
    {
        ClearFieldErrors();
        if (_isNewMode)
        {
            BeginNew();
            return;
        }

        _ = SeleccionarAsync(_selectedId);
    }

    private async Task GuardarAsync()
    {
        ClearFieldErrors();
        _saving = true;
        try
        {
            try
            {
                var savedId = await ContactosSvc.SaveAsync(_form);
                SetFeedback(AppUiMessage.Success("Contacto guardado", $"El contacto #{savedId} se guardó correctamente."));
                await BuscarAsync();
                await SeleccionarAsync(savedId);
            }
            catch (AppValidationException validationEx)
            {
                ApplyFieldErrors(validationEx.Validation);
                SetFeedback(new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Revisá los datos del contacto",
                    Message = validationEx.UserMessage,
                    Suggestion = "Corregí los campos marcados y volvé a intentar."
                });
            }
            catch (Exception ex)
            {
                SetFeedback(UiOps.BuildMessage(ex, "No se pudo guardar el contacto."));
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AbrirEditorAsync(int id)
    {
        _showEditor = true;
        await SeleccionarAsync(id);
    }

    private void ToggleRowSelection(int id, ChangeEventArgs args)
    {
        if (id <= 0)
            return;

        if (args.Value is bool flag && flag)
            _selectedIds.Add(id);
        else
            _selectedIds.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var shouldSelect = args.Value is bool flag && flag;
        foreach (var id in _items.Select(item => item.Id))
        {
            if (shouldSelect)
                _selectedIds.Add(id);
            else
                _selectedIds.Remove(id);
        }
    }

    private async Task DarDeBajaAsync()
    {
        if (_isNewMode || _selectedId <= 0)
            return;

        _saving = true;
        try
        {
            var result = await UiOps.RunAsync(() => ContactosSvc.DeactivateAsync(_selectedId), "No se pudo dar de baja el contacto.");
            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            SetFeedback(AppUiMessage.Success("Contacto dado de baja", $"El contacto #{_selectedId} quedó inactivo."));
            BeginNew();
            _showEditor = false;
            await BuscarAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task EjecutarAccionSeleccionadaAsync()
    {
        if (_selectedIds.Count == 0 || _loadingList)
            return;

        if (!string.Equals(_bulkAction, BulkActionDeactivate, StringComparison.OrdinalIgnoreCase))
            return;

        var ids = _selectedIds.OrderBy(id => id).ToArray();
        var confirm = await Js.InvokeAsync<bool>("confirm", $"Se van a dar de baja {ids.Length} contacto(s) seleccionados. ¿Querés continuar?");
        if (!confirm)
            return;

        _saving = true;
        try
        {
            foreach (var id in ids)
                await ContactosSvc.DeactivateAsync(id);

            _selectedIds.Clear();
            if (ids.Contains(_selectedId))
                _selectedId = 0;

            _showEditor = false;
            SetFeedback(AppUiMessage.Success("Contactos actualizados", $"Se dieron de baja {ids.Length} contacto(s) seleccionados."));
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            SetFeedback(UiOps.BuildMessage(ex, "No se pudieron actualizar los contactos seleccionados."));
        }
        finally
        {
            _saving = false;
        }
    }

    private void LimpiarFiltros()
    {
        _filters.Texto = string.Empty;
        _activoFiltro = "1";
        _filters.TieneEmail = null;
        _filters.TieneCelular = null;
        _filters.TieneWhatsApp = null;
        _filters.ProvinciaCodigo = string.Empty;
        _filters.Localidad = string.Empty;
        _filters.Cargo = string.Empty;
        _filters.Reglas.Clear();
    }

    private void SyncFilters()
    {
        _filters.Activo = _activoFiltro switch
        {
            "1" => true,
            "0" => false,
            _ => null
        };
    }

    private void MapDetailToForm(ContactoDetailDto detail)
    {
        ClearFieldErrors();
        _isNewMode = false;
        _showEditor = true;
        _activeTab = ContactoTab.Datos;
        _selectedId = detail.Id;
        _selectedActivo = detail.Activo;
        _selectedConversationId = detail.IdConversacionWhatsApp;
        _linkedAccounts.Clear();
        _linkedAccounts.AddRange(detail.CuentasVinculadas);

        _form.Id = detail.Id;
        _form.NombreApellido = detail.NombreApellido;
        _form.Domicilio = detail.Domicilio;
        _form.Localidad = detail.Localidad;
        _form.ProvinciaCodigo = detail.ProvinciaCodigo;
        _form.CodigoPostal = detail.CodigoPostal;
        _form.NumeroDocumento = detail.NumeroDocumento;
        _form.Telefono = detail.Telefono;
        _form.TelefonoAlternativo = detail.TelefonoAlternativo;
        _form.Celular = detail.Celular;
        _form.Email = detail.Email;
        _form.MailPagosCobranzas = detail.MailPagosCobranzas;
        _form.MailOrdenCompra = detail.MailOrdenCompra;
        _form.MailOrdenTrabajo = detail.MailOrdenTrabajo;
        _form.Website = detail.Website;
        _form.Cargo = detail.Cargo;
        _form.Observaciones = detail.Observaciones;
    }

    private Task OpenConversationForSelectedAsync()
    {
        if (_selectedId <= 0)
            return Task.CompletedTask;

        var item = new ContactoGridItemDto
        {
            Id = _selectedId,
            NombreApellido = _form.NombreApellido,
            Telefono = _form.Telefono,
            Celular = _form.Celular,
            IdConversacionWhatsApp = _selectedConversationId
        };

        return OpenConversationForContactAsync(item);
    }

    private async Task OpenConversationForContactAsync(ContactoGridItemDto contact)
    {
        if (contact.IdConversacionWhatsApp.HasValue)
        {
            Nav.NavigateTo($"/conversaciones?id={contact.IdConversacionWhatsApp.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
            return;
        }

        var phone = FirstNonEmpty(contact.Celular, contact.Telefono);
        if (string.IsNullOrWhiteSpace(phone))
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Teléfono requerido",
                Message = "Cargá un teléfono o celular para crear una conversación de WhatsApp."
            });
            return;
        }

        _openingConversation = true;
        try
        {
            var result = await UiOps.RunAsync(
                () => ConversacionesSvc.CreateOrGetWhatsAppConversationAsync(new ConversacionCrearWhatsAppRequest { TelefonoWhatsApp = phone }),
                "No se pudo crear la conversación.");

            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            Nav.NavigateTo($"/conversaciones?id={result.Value.IdConversacion.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        }
        finally
        {
            _openingConversation = false;
        }
    }

    private static bool HasContactPhone(ContactoGridItemDto contact)
        => !string.IsNullOrWhiteSpace(FirstNonEmpty(contact.Celular, contact.Telefono));

    private static string GetConversationActionLabel(long? idConversacion)
        => idConversacion.HasValue ? "Ver conversación" : "Crear conversación";

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
                return value.Trim();
        }

        return string.Empty;
    }

    private void ClearFieldErrors()
        => _fieldErrors.Clear();

    private void ApplyFieldErrors(ValidationResult validation)
    {
        ClearFieldErrors();
        foreach (var issue in validation.Issues)
        {
            if (!string.IsNullOrWhiteSpace(issue.FieldKey))
                _fieldErrors[issue.FieldKey.Trim()] = issue.Message;
        }
    }

    private bool HasFieldError(string key)
        => !string.IsNullOrWhiteSpace(key) && _fieldErrors.ContainsKey(key.Trim());

    private string GetFieldError(string key)
        => HasFieldError(key) ? _fieldErrors[key.Trim()] : string.Empty;

    private string GetFieldInputClass(string key)
        => HasFieldError(key) ? "usuarios-input usuarios-input--invalid" : "usuarios-input";

    private void SetFeedback(AppUiMessage? message)
    {
        _feedback = message;
        _feedbackLeaving = false;
        _feedbackSetAtUtc = message is null ? DateTime.MinValue : DateTime.UtcNow;
    }

    private async Task DismissFeedbackAsync()
    {
        if (_feedback is null || _feedbackLeaving)
            return;

        if (DateTime.UtcNow - _feedbackSetAtUtc < TimeSpan.FromMilliseconds(350))
            return;

        _feedbackLeaving = true;
        StateHasChanged();
        await Task.Delay(180);
        _feedback = null;
        _feedbackLeaving = false;
    }

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--ok",
            AppUiFeedbackSeverity.Info => "editor-msg--ok",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            _ => "editor-msg--error"
        };

    private async Task EnsureViewSettingsLoadedAsync(bool force = false)
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (!force && _viewSettingsLoaded && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            ApplyViewSettings(BuildDefaultViewSettings(), string.Empty);
            return;
        }

        var result = await UiOps.RunAsync(() => ContactosSvc.GetViewSettingsAsync(currentUser), "No se pudo cargar la configuración de vista.");
        if (!result.Success || result.Value is null)
        {
            ApplyViewSettings(BuildDefaultViewSettings(), currentUser);
            return;
        }

        ApplyViewSettings(result.Value, currentUser);
    }

    private void ApplyViewSettings(ContactosViewSettingsDto settings, string userName)
    {
        _viewSettings = settings;
        _viewSettingsUserName = userName;
        _viewSettingsLoaded = true;
        _draftAgruparPor = settings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(settings.Columnas));
    }

    private void AbrirConfiguracionVista()
    {
        _showViewSettings = true;
        _draftAgruparPor = _viewSettings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
    }

    private void CancelarConfiguracionVista()
    {
        _showViewSettings = false;
    }

    private void ToggleViewColumn(string key, ChangeEventArgs args)
    {
        var column = _viewSettingsDraft.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null) return;
        column.Visible = args.Value is bool flag && flag;
        if (!_viewSettingsDraft.Any(c => c.Visible))
            column.Visible = true;
    }

    private void MoveViewColumn(string key, int offset)
    {
        var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        var target = index + offset;
        if (target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(ordered);
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Sesión requerida", Message = "Necesitás iniciar sesión para guardar la configuración de vista." });
            return;
        }

        var settings = new ContactosViewSettingsDto { AgruparPor = _draftAgruparPor, Columnas = CloneColumns(_viewSettingsDraft) };
        var result = await UiOps.RunAsync(async () => { await ContactosSvc.SaveViewSettingsAsync(currentUser, settings); return true; }, "No se pudo guardar la configuración de vista.");
        if (!result.Success) { SetFeedback(result.Feedback); return; }

        ApplyViewSettings(settings, currentUser);
        _showViewSettings = false;
        SetFeedback(AppUiMessage.Success("Vista guardada", "La configuración de la grilla quedó actualizada para tu usuario."));
    }

    private IReadOnlyList<ContactoViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private IReadOnlyList<ContactoGridGroup> BuildGridGroups()
    {
        if (_viewSettings.AgruparPor != ContactosViewGroupKeys.Activo)
            return [new ContactoGridGroup { Label = string.Empty, ShowHeader = false, Items = _items.ToList() }];

        return _items
            .GroupBy(item => item.Activo ? "Activos" : "Inactivos")
            .OrderByDescending(g => g.Key)
            .Select(g => new ContactoGridGroup { Label = g.Key, ShowHeader = true, Items = g.ToList() })
            .ToList();
    }

    private static string GetGroupingLabel(string grouping)
        => grouping == ContactosViewGroupKeys.Activo ? "Estado" : "Sin agrupar";

    private static string DisplayOrFallback(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? "-";

    private IReadOnlyList<SmartFilterChip> BuildContactFilterChips()
    {
        var chips = new List<SmartFilterChip>();
        if (!string.IsNullOrWhiteSpace(_filters.Texto))
            chips.Add(new("texto", $"Buscar: {_filters.Texto}"));
        if (!string.IsNullOrWhiteSpace(_activoFiltro))
            chips.Add(new("activo", _activoFiltro == "1" ? "Activos" : "Inactivos"));
        if (_filters.TieneEmail.HasValue)
            chips.Add(new("email", _filters.TieneEmail.Value ? "Con email" : "Sin email"));
        if (_filters.TieneCelular.HasValue)
            chips.Add(new("celular", _filters.TieneCelular.Value ? "Con celular" : "Sin celular"));
        if (_filters.TieneWhatsApp.HasValue)
            chips.Add(new("whatsapp", _filters.TieneWhatsApp.Value ? "Con WhatsApp" : "Sin WhatsApp"));
        if (!string.IsNullOrWhiteSpace(_filters.ProvinciaCodigo))
        {
            var label = _provincias.FirstOrDefault(p => string.Equals(p.Codigo, _filters.ProvinciaCodigo, StringComparison.OrdinalIgnoreCase))?.Descripcion ?? _filters.ProvinciaCodigo;
            chips.Add(new("provincia", $"Provincia: {label}"));
        }
        if (!string.IsNullOrWhiteSpace(_filters.Localidad))
            chips.Add(new("localidad", $"Localidad: {_filters.Localidad}"));
        if (!string.IsNullOrWhiteSpace(_filters.Cargo))
            chips.Add(new("cargo", $"Cargo: {_filters.Cargo}"));

        for (var i = 0; i < _filters.Reglas.Count; i++)
            chips.Add(new($"rule:{i}", $"{GetContactRuleFieldLabel(_filters.Reglas[i].Campo)} {GetRuleOperatorLabel(_filters.Reglas[i].Operador)} {_filters.Reglas[i].Valor}".Trim()));

        return chips;
    }

    private static string GetSmartOptionClass(bool active)
        => active ? "smart-option is-active" : "smart-option";

    private string GetSelectionSummary()
        => _selectedIds.Count == 0
            ? "Seleccioná uno o más contactos para ejecutar acciones."
            : $"{_selectedIds.Count} contacto(s) seleccionado(s).";

    private static bool IsValueOptionalOperator(string? op)
        => NormalizeRuleOperator(op) is "empty" or "not-empty";

    private static string NormalizeRuleOperator(string? op)
        => (op ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "equals" => "equals",
            "starts" => "starts",
            "empty" => "empty",
            "not-empty" => "not-empty",
            _ => "contains"
        };

    private static string GetRuleOperatorLabel(string? op)
        => NormalizeRuleOperator(op) switch
        {
            "equals" => "es igual a",
            "starts" => "empieza con",
            "empty" => "está vacío",
            "not-empty" => "no está vacío",
            _ => "contiene"
        };

    private static string GetContactRuleFieldLabel(string? field)
        => (field ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "email" => "Email",
            "telefono" => "Teléfono",
            "celular" => "Celular",
            "localidad" => "Localidad",
            "provincia" => "Provincia",
            "cargo" => "Cargo",
            _ => "Nombre"
        };

    private static ContactosFilters CloneContactFilters(ContactosFilters source)
        => new()
        {
            Texto = source.Texto,
            Activo = source.Activo,
            TieneEmail = source.TieneEmail,
            TieneCelular = source.TieneCelular,
            TieneWhatsApp = source.TieneWhatsApp,
            ProvinciaCodigo = source.ProvinciaCodigo,
            Localidad = source.Localidad,
            Cargo = source.Cargo,
            PageNumber = 1,
            PageSize = source.PageSize,
            Reglas = source.Reglas.Select(r => new SearchRuleDto { Campo = r.Campo, Operador = r.Operador, Valor = r.Valor }).ToList()
        };

    private static void CopyContactFilters(ContactosFilters source, ContactosFilters target)
    {
        target.Texto = source.Texto;
        target.Activo = source.Activo;
        target.TieneEmail = source.TieneEmail;
        target.TieneCelular = source.TieneCelular;
        target.TieneWhatsApp = source.TieneWhatsApp;
        target.ProvinciaCodigo = source.ProvinciaCodigo;
        target.Localidad = source.Localidad;
        target.Cargo = source.Cargo;
        target.PageNumber = 1;
        target.PageSize = source.PageSize;
        target.Reglas = source.Reglas.Select(r => new SearchRuleDto { Campo = r.Campo, Operador = r.Operador, Valor = r.Valor }).ToList();
    }

