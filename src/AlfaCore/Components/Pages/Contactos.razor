@page "/contactos"
@page "/{idweb}/{idbase:int}/contactos"
@using AlfaCore.Models
@using AlfaCore.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Web
@inject IContactosService ContactosSvc
@inject IConversacionesService ConversacionesSvc
@inject IAppUiOperationService UiOps
@inject IAppUserSessionService AppUserSession
@inject IRouteContextService RouteContext
@inject IPageHeaderService PageHeader
@inject NavigationManager Nav
@inject ILogger<Contactos> Logger
@implements IDisposable

<PageTitle>Contactos | Alfa Gestión</PageTitle>

<div class="@GetContactosPageClass()" @onclick="HandlePageClickAsync">

    @if (_feedback is not null)
    {
        <section class="contactos-feedback" aria-live="polite">
            <div class="editor-msg editor-msg--animated @GetFeedbackClass(_feedback) @(_feedbackLeaving ? "is-leaving" : string.Empty)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
                <button type="button"
                        class="contactos-feedback__close"
                        title="Cerrar aviso"
                        aria-label="Cerrar aviso"
                        @onclick="DismissFeedbackAsync">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
        </section>
    }

    @if (_showViewSettings && !_showEditor && !_showRecordView)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Elegí columnas visibles, su orden y agrupación para la grilla de contactos.</p>
                </div>
            </div>

            <div class="usuarios-view-settings">
                <div class="field">
                    <label>Agrupar por</label>
                    <select @bind="_draftAgruparPor">
                        <option value="@ContactosViewGroupKeys.None">Sin agrupar</option>
                        <option value="@ContactosViewGroupKeys.Activo">Estado (Activo / Inactivo)</option>
                    </select>
                </div>

                <div class="usuarios-view-settings__list">
                    @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="checkbox">
                                <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                <span>@column.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">
                        <i class="bi bi-floppy"></i> Guardar vista
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </div>
        </section>
    }

    @if (_showEditor)
    {
        <section class="panel-card contactos-editor-panel">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Datos principales</h3>
                    <p class="panel-card__subtitle">@(_isNewMode ? "Completá los datos principales del contacto." : $"Código interno: {_selectedId} · Estado: {(_selectedActivo ? "Activo" : "Inactivo")}")</p>
                </div>
            </div>

            <div class="contactos-editor-scroll">
                <div class="contactos-tabs">
                    <button type="button"
                            class="btn @(_activeTab == ContactoTab.Datos ? "btn--primary" : "btn--ghost")"
                            @onclick="() => _activeTab = ContactoTab.Datos">
                        Datos generales
                    </button>
                    <button type="button"
                            class="btn @(_activeTab == ContactoTab.Observaciones ? "btn--primary" : "btn--ghost")"
                            @onclick="() => _activeTab = ContactoTab.Observaciones">
                        Observaciones
                    </button>
                    <button type="button"
                            class="btn @(_activeTab == ContactoTab.Cuentas ? "btn--primary" : "btn--ghost")"
                            @onclick="() => _activeTab = ContactoTab.Cuentas">
                        Clientes / proveedores
                    </button>
                </div>

                @if (_activeTab == ContactoTab.Datos)
                {
                    <div class="contactos-form">
                        <div class="contactos-form__grid">
                        <div class="field">
                            <label>Nombre y apellido</label>
                            <input type="text" class="@GetFieldInputClass("nombre")" maxlength="100" @bind="_form.NombreApellido" disabled="@_saving" />
                            @if (HasFieldError("nombre"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("nombre")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Domicilio</label>
                            <input type="text" class="@GetFieldInputClass("domicilio")" maxlength="100" @bind="_form.Domicilio" disabled="@_saving" />
                            @if (HasFieldError("domicilio"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("domicilio")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Localidad</label>
                            <input type="text" class="@GetFieldInputClass("localidad")" maxlength="100" @bind="_form.Localidad" disabled="@_saving" />
                            @if (HasFieldError("localidad"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("localidad")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Código postal</label>
                            <input type="text" class="@GetFieldInputClass("codigo-postal")" maxlength="20" @bind="_form.CodigoPostal" disabled="@_saving" />
                            @if (HasFieldError("codigo-postal"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("codigo-postal")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Provincia</label>
                            <select class="@GetFieldInputClass("provincia")" @bind="_form.ProvinciaCodigo" disabled="@(_saving || _loadingProvincias)">
                                <option value="">Seleccionar...</option>
                                @foreach (var item in _provincias)
                                {
                                    <option value="@item.Codigo">@item.Descripcion</option>
                                }
                            </select>
                            @if (HasFieldError("provincia"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("provincia")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Nro. documento</label>
                            <input type="text" class="@GetFieldInputClass("numero-documento")" maxlength="13" @bind="_form.NumeroDocumento" disabled="@_saving" />
                            @if (HasFieldError("numero-documento"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("numero-documento")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Teléfono</label>
                            <input type="text" class="@GetFieldInputClass("telefono")" maxlength="100" @bind="_form.Telefono" disabled="@_saving" />
                            @if (HasFieldError("telefono"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("telefono")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Tel. alternativo</label>
                            <input type="text" class="@GetFieldInputClass("telefono-alternativo")" maxlength="100" @bind="_form.TelefonoAlternativo" disabled="@_saving" />
                            @if (HasFieldError("telefono-alternativo"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("telefono-alternativo")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Celular</label>
                            <input type="text" class="@GetFieldInputClass("celular")" maxlength="100" @bind="_form.Celular" disabled="@_saving" />
                            @if (HasFieldError("celular"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("celular")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>E-mail</label>
                            <input type="email" class="@GetFieldInputClass("email")" maxlength="100" @bind="_form.Email" disabled="@_saving" />
                            @if (HasFieldError("email"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("email")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Página web</label>
                            <input type="text" class="@GetFieldInputClass("website")" maxlength="100" @bind="_form.Website" disabled="@_saving" />
                            @if (HasFieldError("website"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("website")</small>
                            }
                        </div>
                        <div class="field field--md">
                            <label>Cargo</label>
                            <input type="text" class="@GetFieldInputClass("cargo")" maxlength="100" @bind="_form.Cargo" disabled="@_saving" />
                            @if (HasFieldError("cargo"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("cargo")</small>
                            }
                        </div>
                        </div>

                        <div class="contactos-flags">
                            <label class="checkbox">
                                <input type="checkbox" @bind="_form.MailPagosCobranzas" disabled="@_saving" />
                                <span>Pagos/Cobranzas</span>
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" @bind="_form.MailOrdenCompra" disabled="@_saving" />
                                <span>Órdenes de compra</span>
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" @bind="_form.MailOrdenTrabajo" disabled="@_saving" />
                                <span>Órdenes de trabajo</span>
                            </label>
                        </div>
                    </div>
                }
                else if (_activeTab == ContactoTab.Observaciones)
                {
                    <div class="field">
                        <label>Observaciones</label>
                        <textarea class="contactos-observaciones" @bind="_form.Observaciones" disabled="@_saving"></textarea>
                    </div>
                }
                else
                {
                    <div class="contactos-form">
                        <div class="panel-card__header">
                            <div>
                                <h3 class="panel-card__title">Cuentas vinculadas</h3>
                                <p class="panel-card__subtitle">Clientes y proveedores relacionados con este contacto.</p>
                            </div>
                        </div>
                        @if (_linkedAccounts.Count == 0)
                        {
                            <div class="usuarios-empty">Este contacto no tiene clientes o proveedores vinculados.</div>
                        }
                        else
                        {
                            <div class="usuarios-table-wrap">
                                <table class="data-table usuarios-table">
                                    <thead>
                                        <tr>
                                            <th>Tipo</th>
                                            <th>C&oacute;digo</th>
                                            <th>Cuenta</th>
                                            <th>Relaci&oacute;n</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var account in _linkedAccounts)
                                        {
                                            <tr>
                                                <td>@account.Tipo</td>
                                                <td>@account.Codigo</td>
                                                <td><strong>@DisplayOrFallback(account.RazonSocial, account.Codigo)</strong></td>
                                                <td>
                                                    @if (account.VinculadoPorTabla)
                                                    {
                                                        <span>Relaci&oacute;n m&uacute;ltiple</span>
                                                    }
                                                    @if (account.VinculadoPorCuentaRel)
                                                    {
                                                        <span>@(account.VinculadoPorTabla ? " / " : string.Empty)CuentaRel</span>
                                                    }
                                                </td>
                                                <td>
                                                    <a class="btn btn--ghost btn--sm" href="@BuildCuentaLink(account)">
                                                        <i class="bi bi-box-arrow-up-right"></i>
                                                        Ver / editar
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>

        </section>
    }
    else if (_showRecordView)
    {
        <ContactosRecordView Contact="_recordDetail"
                             ProvinciaDisplay="@GetRecordProvinciaDisplay()"
                             Loading="_loadingRecord"
                             ErrorMessage="@_recordErrorMessage"
                             ActiveTab="_recordActiveTab"
                             ActiveTabChanged="SetRecordTabAsync"
                             OnBack="VolverDesdeFichaAsync"
                             OnRetry="RecargarFichaAsync"
                             OnConversation="OpenConversationForRecordAsync" />
    }
    else
    {
        var visibleColumns = GetVisibleColumns();
        var groups = BuildGridGroups();

        <section class="contactos-list-shell @(_viewMode == ContactosViewModeKeys.Kanban ? "contactos-list-shell--kanban" : _selectedIds.Count > 0 ? "contactos-list-shell--selection" : string.Empty)" aria-label="Listado de contactos">
            @if (_viewMode != ContactosViewModeKeys.Kanban)
            {
                <div class="contactos-list-shell__summary">
                    <div>
                        <span class="contactos-list-shell__eyebrow">Contactos</span>
                        <strong>@GetContactListSummary()</strong>
                    </div>
                    @if (_selectedIds.Count > 0)
                    {
                        <AlfaTag Tone="AlfaTagTone.Accent">@_selectedIds.Count seleccionados</AlfaTag>
                    }
                </div>
            }

            @if (_viewMode == ContactosViewModeKeys.Kanban)
            {
                <ContactosKanbanView Items="_items"
                                     SelectedIds="_selectedIds"
                                     PageNumber="@_pageNumber"
                                     ShowActiveStatus="@(_activoFiltro != "1")"
                                     Loading="_loadingList"
                                     ConversationBusy="_openingConversation"
                                     DeactivateDisabled="_saving"
                                     ErrorMessage="@_listErrorMessage"
                                     EmptyKind="@GetContactEmptyStateKind()"
                                     EmptyTitle="@GetContactEmptyTitle()"
                                     EmptyMessage="@GetContactEmptyMessage()"
                                     EmptyActionLabel="@GetContactEmptyActionLabel()"
                                     EmptyActionIcon="@GetContactEmptyActionIcon()"
                                     OnToggleSelection="ToggleCardSelection"
                                     OnOpenRecord="@(id => AbrirFichaAsync(id))"
                                     OnEdit="@(id => AbrirEditorAsync(id))"
                                     OnOpenConversation="OpenConversationForContactAsync"
                                     OnCreateConversation="OpenConversationForContactAsync"
                                     OnDeactivate="DarDeBajaDesdeFilaAsync"
                                     OnRetry="RecargarAsync"
                                     OnEmptyAction="HandleContactEmptyActionAsync" />
            }
            else if (_loadingList)
            {
                <div class="contactos-list-shell__state">
                    <AlfaEmptyState Title="Cargando contactos"
                                    Message="Estamos consultando la base activa con los filtros actuales." />
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_listErrorMessage))
            {
                <div class="contactos-list-shell__state">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.Error"
                                    Title="No se pudieron cargar los contactos"
                                    Message="@_listErrorMessage"
                                    ActionLabel="Reintentar"
                                    ActionIcon="bi bi-arrow-clockwise"
                                    OnAction="RecargarAsync" />
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="contactos-list-shell__state">
                    <AlfaEmptyState Kind="@GetContactEmptyStateKind()"
                                    Title="@GetContactEmptyTitle()"
                                    Message="@GetContactEmptyMessage()"
                                    ActionLabel="@GetContactEmptyActionLabel()"
                                    ActionIcon="@GetContactEmptyActionIcon()"
                                    OnAction="HandleContactEmptyActionAsync" />
                </div>
            }
            else
            {
                <div class="contactos-list-shell__table-scroll">
                    <table class="contactos-list-table contactos-list-table--local-sticky">
                        <thead>
                            <tr>
                                <th class="contactos-list-table__select">
                                    <input type="checkbox"
                                           class="contactos-list-table__checkbox"
                                           checked="@AreAllCurrentPageSelected"
                                           @onchange="ToggleSelectAll"
                                           aria-label="Seleccionar todos los contactos visibles"
                                           title="Seleccionar todos los contactos visibles" />
                                </th>
                                @foreach (var col in visibleColumns)
                                {
                                    <th class="@GetColumnCssClass(col.Key)">
                                        <button type="button"
                                                class="table-sort @GetContactSortClass(col.Key)"
                                                title="@GetContactSortTitle(col)"
                                                aria-label="@GetContactSortTitle(col)"
                                                @onclick="() => SortContactsByAsync(col.Key)">
                                            <span class="table-sort__label">@col.Label</span>
                                            <span class="table-sort__mark">@GetContactSortMark(col.Key)</span>
                                        </button>
                                    </th>
                                }
                                <th class="contactos-list-table__actions" aria-label="Acciones">…</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@(visibleColumns.Count + 2)">@group.Label</td>
                                    </tr>
                                }
                                @foreach (var item in group.Items)
                                {
                                    <tr class="@GetContactRowClass(item.Id)"
                                        @onclick="() => _selectedId = item.Id"
                                        @ondblclick="() => AbrirEditorAsync(item.Id)">
                                        <td class="contactos-list-table__select" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   class="contactos-list-table__checkbox"
                                                   checked="@_selectedIds.Contains(item.Id)"
                                                   @onchange="args => ToggleRowSelection(item.Id, args)"
                                                   aria-label="@($"Seleccionar contacto {item.NombreApellido}")"
                                                   title="Seleccionar contacto" />
                                        </td>
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td class="@GetColumnCssClass(col.Key)">
                                                @switch (col.Key)
                                                {
                                                    case ContactosViewColumnKeys.Nombre:
                                                        <button type="button"
                                                                class="contactos-list-table__record-link"
                                                                title="@($"Abrir ficha de {item.NombreApellido}")"
                                                                @onclick="() => AbrirFichaAsync(item.Id)"
                                                                @onclick:stopPropagation="true"
                                                                @ondblclick:stopPropagation="true">
                                                            <strong>@item.NombreApellido</strong>
                                                        </button>
                                                        break;
                                                    case ContactosViewColumnKeys.Localidad:
                                                        @GetDisplayValue(item.Localidad)
                                                        break;
                                                    case ContactosViewColumnKeys.Provincia:
                                                        @GetDisplayValue(string.IsNullOrWhiteSpace(item.ProvinciaDescripcion) ? item.ProvinciaCodigo : item.ProvinciaDescripcion)
                                                        break;
                                                    case ContactosViewColumnKeys.Telefono:
                                                        @GetDisplayValue(item.Telefono)
                                                        break;
                                                    case ContactosViewColumnKeys.Celular:
                                                        @GetDisplayValue(item.Celular)
                                                        break;
                                                    case ContactosViewColumnKeys.Email:
                                                        @GetDisplayValue(item.Email)
                                                        break;
                                                    case ContactosViewColumnKeys.Cargo:
                                                        @GetDisplayValue(item.Cargo)
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td class="contactos-list-table__actions" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
                                            <AlfaActionMenu Items="@BuildContactActionMenu(item)"
                                                            TriggerLabel="Acciones del contacto"
                                                            MenuLabel="Acciones del contacto"
                                                            Align="AlfaActionMenuAlign.End" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>

            }
        </section>
    }
</div>

@if (_showMergeModal && !_isNewMode)
{
    <div class="cuentas-modal-backdrop" @onclick="CloseMergeModal">
        <section class="cuentas-modal" role="dialog" aria-modal="true" aria-labelledby="contactos-merge-title" @onclick:stopPropagation="true">
            <header class="cuentas-modal__header">
                <div>
                    <span class="cuentas-modal__eyebrow">Contacto principal</span>
                    <h3 id="contactos-merge-title">Unificar @_form.NombreApellido</h3>
                </div>
                <button type="button" class="cuentas-modal__close" @onclick="CloseMergeModal" disabled="@_mergingContact" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="cuentas-modal__body">
                @if (!string.IsNullOrWhiteSpace(_mergeError))
                {
                    <div class="editor-msg editor-msg--warning">@_mergeError</div>
                }

                <div class="cuentas-link-search">
                    <div class="field">
                        <label>Buscar contacto duplicado</label>
                        <input type="search"
                               class="usuarios-input"
                               placeholder="Nombre, email, celular o tel&eacute;fono..."
                               @bind="_mergeSearchText"
                               @bind:event="oninput"
                               @onkeydown="OnMergeSearchKeyDownAsync"
                               disabled="@(_loadingMergeCandidates || _mergingContact)" />
                    </div>
                    <button type="button" class="btn btn--primary" @onclick="SearchMergeCandidatesAsync" disabled="@(_loadingMergeCandidates || _mergingContact)">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>

                <div class="conversations-context__hint">
                    <i class="bi bi-info-circle"></i>
                    <span>El contacto elegido se absorbe en el principal: se copian datos faltantes, se mueven cuentas, conversaciones y tickets, y el duplicado queda inactivo si la base lo permite.</span>
                </div>

                @if (_loadingMergeCandidates)
                {
                    <div class="usuarios-empty">Buscando contactos...</div>
                }
                else if (_mergeSearchExecuted && _mergeCandidates.Count == 0)
                {
                    <div class="usuarios-empty">No encontramos contactos para unificar con ese texto.</div>
                }
                else if (_mergeCandidates.Count > 0)
                {
                    <div class="cuentas-link-results">
                        @foreach (var candidate in _mergeCandidates)
                        {
                            <button type="button" class="cuentas-link-result" @onclick="() => OpenMergeConfirm(candidate)" disabled="@_mergingContact">
                                <span class="cuentas-contacto-item__avatar cuentas-contacto-item__avatar--2">
                                    @GetInitial(candidate.NombreApellido)
                                </span>
                                <span class="cuentas-link-result__body">
                                    <strong>@candidate.NombreApellido</strong>
                                    @if (!string.IsNullOrWhiteSpace(candidate.Cargo))
                                    {
                                        <small>@candidate.Cargo</small>
                                    }
                                    <span>@FormatMergeCandidateSummary(candidate)</span>
                                </span>
                                <i class="bi bi-intersect"></i>
                            </button>
                        }
                    </div>
                }
            </div>

            <footer class="cuentas-modal__actions">
                <button type="button" class="btn btn--ghost" @onclick="CloseMergeModal" disabled="@_mergingContact">
                    Cerrar
                </button>
            </footer>
        </section>
    </div>
}

@if (_showMergeConfirm && _mergeConfirmCandidate is not null)
{
    <div class="cuentas-modal-backdrop" @onclick="CloseMergeConfirm">
        <section class="cuentas-modal cuentas-modal--compact" role="dialog" aria-modal="true" aria-labelledby="contactos-merge-confirm-title" @onclick:stopPropagation="true">
            <header class="cuentas-modal__header">
                <div>
                    <span class="cuentas-modal__eyebrow">Confirmación</span>
                    <h3 id="contactos-merge-confirm-title">Unificar contactos</h3>
                </div>
                <button type="button" class="cuentas-modal__close" @onclick="CloseMergeConfirm" disabled="@_mergingContact" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>
            <div class="cuentas-modal__body">
                <div class="context-card">
                    <span class="context-card__label">Contacto duplicado</span>
                    <strong>@_mergeConfirmCandidate.NombreApellido</strong>
                    <span class="context-card__muted">Se unificará dentro de @_form.NombreApellido. Se conservarán los datos y relaciones del contacto principal.</span>
                </div>
            </div>
            <footer class="cuentas-modal__actions">
                <button type="button" class="btn btn--primary" @onclick="ConfirmMergeAsync" disabled="@_mergingContact">
                    <i class="bi bi-intersect"></i>
                    @(_mergingContact ? "Unificando..." : "Confirmar unificación")
                </button>
                <button type="button" class="btn btn--ghost" @onclick="CloseMergeConfirm" disabled="@_mergingContact">
                    Cancelar
                </button>
            </footer>
        </section>
    </div>
}

@if (_showBulkTemplateModal)
{
    <div class="cuentas-modal-backdrop" @onclick="CloseBulkTemplateModal">
        <section class="cuentas-modal" role="dialog" aria-modal="true" aria-labelledby="contactos-bulk-template-title" @onclick:stopPropagation="true">
            <header class="cuentas-modal__header">
                <div>
                    <span class="cuentas-modal__eyebrow">Acción masiva</span>
                    <h3 id="contactos-bulk-template-title">Enviar plantilla WhatsApp</h3>
                </div>
                <button type="button" class="cuentas-modal__close" @onclick="CloseBulkTemplateModal" disabled="@_sendingBulkTemplate" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="cuentas-modal__body">
                @if (!string.IsNullOrWhiteSpace(_bulkTemplateError))
                {
                    <div class="editor-msg editor-msg--warning">@_bulkTemplateError</div>
                }

                <div class="conversations-context__hint">
                    <i class="bi bi-info-circle"></i>
                    <span>Se enviará a contactos seleccionados que tengan celular o teléfono. Si la conversación no existe, se crea automáticamente.</span>
                </div>

                <div class="field">
                    <label>Plantilla aprobada</label>
                    <select class="usuarios-input" @bind="_bulkTemplateId" disabled="@(_loadingBulkTemplates || _sendingBulkTemplate)">
                        <option value="0">@(_loadingBulkTemplates ? "Cargando plantillas..." : "Seleccionar plantilla...")</option>
                        @foreach (var template in _bulkTemplates)
                        {
                            <option value="@template.IdPlantilla">@template.NombreVisible</option>
                        }
                    </select>
                </div>

                @if (SelectedBulkTemplate is not null)
                {
                    <div class="context-card">
                        <span class="context-card__label">Vista previa</span>
                        <strong>@SelectedBulkTemplate.NombreVisible</strong>
                        <span class="context-card__muted">@TruncateText(SelectedBulkTemplate.CuerpoTexto, 220)</span>
                    </div>

                    @if (CountTemplateVariables(SelectedBulkTemplate.CuerpoTexto) > 0)
                    {
                        <div class="field">
                            <label>Valores de variables</label>
                            <textarea class="usuarios-input"
                                      rows="4"
                                      placeholder="Un valor por línea. Para textos largos separá variables con ---"
                                      @bind="_bulkTemplateValuesText"
                                      disabled="@_sendingBulkTemplate"></textarea>
                            <small class="panel-card__subtitle">Esta plantilla requiere @CountTemplateVariables(SelectedBulkTemplate.CuerpoTexto) valor(es). Se usarán los mismos para todos los contactos seleccionados.</small>
                        </div>
                    }
                }
            </div>

            <footer class="cuentas-modal__actions">
                <button type="button" class="btn btn--primary" @onclick="SendBulkTemplateAsync" disabled="@(_sendingBulkTemplate || _bulkTemplateId <= 0)">
                    <i class="bi bi-send"></i>
                    @(_sendingBulkTemplate ? "Enviando..." : "Enviar plantilla")
                </button>
                <button type="button" class="btn btn--ghost" @onclick="CloseBulkTemplateModal" disabled="@_sendingBulkTemplate">
                    Cerrar
                </button>
            </footer>
        </section>
    </div>
}

<AlfaConfirmDialog Open="@_showDeactivateConfirm"
                   Title="@DeactivateConfirmTitle"
                   Message="@DeactivateConfirmMessage"
                   SecondaryMessage="@DeactivateConfirmSecondaryMessage"
                   ConfirmLabel="@DeactivateConfirmButtonLabel"
                   LoadingLabel="Dando de baja..."
