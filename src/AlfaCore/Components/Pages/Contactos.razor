    private async Task SetViewModeAsync(string mode)
    {
        var normalized = mode == ContactosViewModeKeys.Kanban
            ? ContactosViewModeKeys.Kanban
            : ContactosViewModeKeys.Listado;
        if (_viewMode == normalized)
            return;

        _viewMode = normalized;
        _viewSettings.Vista = normalized;
        if (!_showEditor && !_showRecordView)
            NavigateToContactosState(ContactosUrlState.Base, replace: true);
        UpdatePageHeader();
        Logger.LogDebug(
            "Contactos: cambio de vista. Vista={ViewMode}, Items={ItemCount}, Loading={IsLoading}, TieneErrorCarga={HasLoadError}",
            _viewMode,
            _items.Count,
            _loadingList,
            !string.IsNullOrWhiteSpace(_listErrorMessage));

        StateHasChanged();

        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            Logger.LogDebug("Contactos: vista activa en sesión sin persistencia por falta de usuario.");
            return;
        }

        var result = await UiOps.RunAsync(
            async () =>
            {
                await ContactosSvc.SaveViewSettingsAsync(currentUser, _viewSettings);
                return true;
            },
            "No se pudo guardar la vista seleccionada.");
        Logger.LogDebug(
            "Contactos: persistencia de vista finalizada. Vista={ViewMode}, Success={Success}, Items={ItemCount}",
            _viewMode,
            result.Success,
            _items.Count);
        if (!result.Success)
            SetFeedback(result.Feedback);
    }

