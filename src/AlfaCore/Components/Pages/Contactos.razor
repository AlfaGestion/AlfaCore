    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateConfirmLoading || _pendingDeactivateIds.Length == 0)
            return;

        var ids = _pendingDeactivateIds.ToArray();
        var isBulk = _pendingDeactivateIsBulk;
        var selectedAffected = ids.Contains(_selectedId) ? _selectedId : 0;
        _deactivateConfirmLoading = true;
        _saving = true;
        _deactivateConfirmError = string.Empty;
        try
        {
            foreach (var id in ids)
                await ContactosSvc.DeactivateAsync(id);

            if (isBulk)
                _selectedIds.Clear();

            if (selectedAffected > 0 && !_showRecordView)
                _selectedId = 0;

            _showEditor = false;
            SetFeedback(isBulk
                ? AppUiMessage.Success("Contactos actualizados", $"Se dieron de baja {ids.Length} contacto(s) seleccionados.")
                : AppUiMessage.Success("Contacto dado de baja", "El contacto quedó inactivo."));
            await BuscarAsync();
            if (_showRecordView && selectedAffected > 0)
                await CargarFichaAsync(selectedAffected);
            _showDeactivateConfirm = false;
            _pendingDeactivateIds = [];
            _pendingDeactivateName = string.Empty;
            _pendingDeactivateIsBulk = false;
        }
        catch (Exception)
        {
            _deactivateConfirmError = isBulk
                ? "No se pudieron dar de baja los contactos seleccionados. Podés reintentar o cancelar."
                : "No se pudo dar de baja el contacto. Podés reintentar o cancelar.";
        }
        finally
        {
            _deactivateConfirmLoading = false;
            _saving = false;
            UpdatePageHeader();
        }
    }

    private async Task CrearConversacionesSeleccionadasAsync()
    {
        var contacts = GetSelectedContactsWithPhone().ToList();
        if (contacts.Count == 0)
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Teléfono requerido",
                Message = "Seleccioná contactos con celular o teléfono para crear conversaciones."
            });
            return;
        }

        _openingConversation = true;
        try
        {
            long? firstConversation = null;
            var created = 0;
            foreach (var contact in contacts)
            {
                var phone = FirstNonEmpty(contact.Celular, contact.Telefono);
                var result = await UiOps.RunAsync(
                    () => ConversacionesSvc.CreateOrGetWhatsAppConversationAsync(new ConversacionCrearWhatsAppRequest { TelefonoWhatsApp = phone }),
                    $"No se pudo crear la conversación de {DisplayOrFallback(contact.NombreApellido, phone)}.");

                if (!result.Success || result.Value is null)
                {
                    SetFeedback(result.Feedback);
                    continue;
                }

                firstConversation ??= result.Value.IdConversacion;
                if (result.Value.Creada)
                    created++;
            }

            SetFeedback(AppUiMessage.Success("Conversaciones listas", $"Se prepararon {contacts.Count} conversación(es). Nuevas: {created}."));
            if (contacts.Count == 1 && firstConversation.HasValue)
                Nav.NavigateTo($"/conversaciones?id={firstConversation.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        }
        finally
        {
            _openingConversation = false;
        }
    }

