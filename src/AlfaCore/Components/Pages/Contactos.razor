    private async Task AddContactRuleAsync()
    {
        if (!IsValueOptionalOperator(_contactRuleDraft.Operador) && string.IsNullOrWhiteSpace(_contactRuleDraft.Valor))
            return;

        _filters.Reglas.Add(new SearchRuleDto
        {
            Campo = _contactRuleDraft.Campo,
            Operador = _contactRuleDraft.Operador,
            Valor = _contactRuleDraft.Valor
        });
        _contactRuleDraft = new SearchRuleDto { Campo = "nombre", Operador = "contains" };
        await AplicarFiltrosAsync();
    }

    private async Task RemoveContactChipAsync(string key)
    {
        switch (key)
        {
            case "texto":
                _filters.Texto = string.Empty;
                break;
            case "activo":
                _activoFiltro = string.Empty;
                break;
            case "email":
                _filters.TieneEmail = null;
                break;
            case "celular":
                _filters.TieneCelular = null;
                break;
            case "whatsapp":
                _filters.TieneWhatsApp = null;
                break;
            case "provincia":
                _filters.ProvinciaCodigo = string.Empty;
                break;
            case "localidad":
                _filters.Localidad = string.Empty;
                break;
            case "cargo":
                _filters.Cargo = string.Empty;
                break;
            default:
                if (key.StartsWith("rule:", StringComparison.OrdinalIgnoreCase)
                    && int.TryParse(key[5..], out var index)
                    && index >= 0
                    && index < _filters.Reglas.Count)
                {
                    _filters.Reglas.RemoveAt(index);
                }
                break;
        }

        await AplicarFiltrosAsync();
    }

    private async Task ApplyContactFavoriteAsync(string key)
    {
        if (key == "contactables")
        {
            _activoFiltro = "1";
            _filters.TieneCelular = true;
            _filters.TieneEmail = null;
            _filters.TieneWhatsApp = null;
