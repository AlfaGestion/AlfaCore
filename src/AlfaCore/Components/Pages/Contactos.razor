            @if (activeChips.Count > 2)
            {
                <span class="smart-search__more-filters" title="@string.Join(", ", activeChips.Skip(2).Select(chip => chip.Label))">+@(activeChips.Count - 2)</span>
            }
            </div>
            <input type="search"
                   placeholder="Buscar..."
                   value="@_filters.Texto"
                   @onfocus="OpenContactSearchPanel"
                   @oninput="OnContactSearchInput"
                   @onkeydown="HandleContactApplyKeyDownAsync" />
            <button type="button" class="smart-search__toggle" @onclick="ToggleContactSearchPanel" aria-label="Mostrar filtros" aria-expanded="@_showSearchPanel">
                <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_showSearchPanel)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CloseSearchPanel"></button>
            <div class="smart-search__panel" @onclick:stopPropagation @onkeydown="HandleContactApplyKeyDownAsync">
                <div class="smart-search__column">
                    <h4><i class="bi bi-funnel-fill"></i> Filtros</h4>
                    <button type="button" class='@GetSmartOptionClass(_activoFiltro == "1")' @onclick='() => SetContactStatusFilterAsync("1")'>Personas activas</button>
                    <button type="button" class='@GetSmartOptionClass(_activoFiltro == "0")' @onclick='() => SetContactStatusFilterAsync("0")'>Inactivos</button>
                    <button type="button" class="@GetSmartOptionClass(_filters.TieneEmail == true)" @onclick='() => ToggleContactBoolFilterAsync("email")'>Con email</button>
                    <button type="button" class="@GetSmartOptionClass(_filters.TieneEmail == false)" @onclick='() => ToggleContactBoolFilterAsync("sin-email")'>Sin email</button>
