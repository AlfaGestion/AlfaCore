                </div>
            </div>
        }
    </div>;

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();

        if (_showRecordView)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "volver",
                Label = "Atrás",
                Icon = "bi-arrow-left",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _loadingRecord,
                OnClick = VolverDesdeFichaAsync
            });
            actions.Add(new PageHeaderAction
            {
                Key = "editar",
                Label = "Editar",
                Icon = "bi-pencil-square",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _loadingRecord || _recordDetail is null,
                OnClick = EditarFichaAsync
            });
            foreach (var action in BuildRecordOverflowActions())
                actions.Add(action);
        }
        else if (_showEditor)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "guardar",
                Label = _saving ? "Guardando..." : "Guardar",
                Icon = "bi-floppy",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                Busy = _saving,
                OnClick = GuardarAsync
            });
            actions.Add(new PageHeaderAction
            {
                Key = "cancelar",
                Label = "Cancelar",
                Icon = "bi-x-circle",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                OnClick = () =>
                {
                    CerrarEditor();
                    return Task.CompletedTask;
                }
            });
            if (!_isNewMode && _selectedActivo)
            {
                actions.Add(new PageHeaderAction
                {
                    Key = "baja",
                    Label = "Dar de baja",
                    Icon = "bi-person-dash",
                    Style = PageHeaderActionStyle.Danger,
                    Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _saving,
                    OnClick = DarDeBajaAsync
                });
            }
            if (!_isNewMode)
            {
                actions.Add(new PageHeaderAction
                {
                    Key = "conversacion",
                    Label = GetConversationActionLabel(_selectedConversationId),
                    Icon = "bi-whatsapp",
                    Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = _saving || _openingConversation,
                    OnClick = OpenConversationForSelectedAsync
                });
                actions.Add(new PageHeaderAction
                {
                    Key = "unificar",
                    Label = "Unificar",
                    Icon = "bi-intersect",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _saving || _mergingContact,
                    OnClick = OpenMergeModalAsync
                });
            }
        }
        else
        {
            if (_selectedIds.Count > 0)
            {
                actions.Add(new PageHeaderAction
                {
                    Key = "seleccion",
                    Label = $"{_selectedIds.Count} seleccionados",
                    Icon = "bi-check2-square",
                    Style = PageHeaderActionStyle.Ghost,
                    Disabled = true
                });
                if (CanMergeSelectedContacts())
                {
                    actions.Add(new PageHeaderAction
                    {
                        Key = "unificar-seleccion",
                        Label = "Unificar",
                        Icon = "bi-intersect",
                        Style = PageHeaderActionStyle.Ghost,
                        Priority = PageHeaderActionPriority.Essential,
                        Disabled = _loadingList || _mergingContact,
                        OnClick = OpenMergeFromSelectionAsync
                    });
                }
                actions.Add(new PageHeaderAction
                {
                    Key = "baja-masiva",
                    Label = "Dar de baja",
                    Icon = "bi-person-dash",
                    Style = PageHeaderActionStyle.Danger,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = _loadingList,
                    OnClick = () => EjecutarAccionMasivaAsync(BulkActionDeactivate)
                });
                actions.Add(new PageHeaderAction
                {
                    Key = "whatsapp-masivo",
                    Label = "Conversaciones",
                    Icon = "bi-whatsapp",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _loadingList,
                    OnClick = () => EjecutarAccionMasivaAsync(BulkActionOpenWhatsApp)
                });
                actions.Add(new PageHeaderAction
                {
                    Key = "plantilla-masiva",
                    Label = "Enviar plantilla",
                    Icon = "bi-lightning-charge",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _loadingList,
                    OnClick = () => EjecutarAccionMasivaAsync(BulkActionSendTemplate)
                });
                actions.Add(new PageHeaderAction
                {
                    Key = "cancelar-seleccion",
                    Label = "Limpiar selección",
                    Icon = "bi-x-lg",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential,
                    OnClick = ClearContactSelectionAsync
                });
            }
            else
            {
                actions.Add(new PageHeaderAction
                {
                    Key = "nuevo",
                    Label = "Nuevo contacto",
                    Icon = "bi-plus-circle",
                    Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential,
                    OnClick = () =>
                    {
                        BeginNew();
                        return Task.CompletedTask;
                    }
                });
                actions.Add(new PageHeaderAction
                {
                    Key = "recargar",
                    Label = "Recargar",
                    Icon = "bi-arrow-clockwise",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _loadingList,
                    OnClick = RecargarAsync
                });
                actions.Add(new PageHeaderAction
                {
                    Key = "vista",
                    Label = "Configurar vista",
                    Icon = "bi-sliders",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    OnClick = () =>
                    {
                        AbrirConfiguracionVista();
                        UpdatePageHeader();
                        return Task.CompletedTask;
                    }
                });
                actions.Add(new PageHeaderAction
                {
                    Key = "agrupar",
                    Label = GetGroupingLabel(_viewSettings.AgruparPor),
                    Icon = "bi-collection",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    OnClick = ToggleContactSearchPanelAsync
                });
            }
        }

        PageHeader.Set(new PageHeaderConfig
        {
            Title = _showRecordView
                ? DisplayOrFallback(_recordDetail?.NombreApellido, _loadingRecord ? "Cargando contacto" : "Contacto")
                : _showEditor ? (_isNewMode ? "Nuevo contacto" : $"Editar {_form.NombreApellido}") : "Contactos",
            Breadcrumb = ["Conversaciones", "Contactos"],
            State = _saving
                ? PageHeaderState.Loading
                : _showRecordView
                    ? (_loadingRecord ? PageHeaderState.Loading : PageHeaderState.ReadOnly)
                    : _showEditor
                    ? (_isNewMode ? PageHeaderState.Creating : PageHeaderState.Editing)
                    : _selectedIds.Count > 0
                        ? PageHeaderState.Selection
                        : _viewMode == ContactosViewModeKeys.Kanban ? PageHeaderState.Kanban : PageHeaderState.List,
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems(),
            OnBack = _showRecordView
                ? VolverDesdeFichaAsync
                : _showEditor && _isNewMode ? new Func<Task>(() => { CerrarEditor(); return Task.CompletedTask; }) : null,
            Search = _showEditor || _showRecordView
                ? null
                : new PageHeaderSearchConfig(),
            SearchContent = _showEditor || _showRecordView ? null : RenderContactSmartSearch(),
            ViewButtons = _showEditor || _showRecordView ? [] : BuildHeaderViewButtons(),
            Pagination = _showEditor || _showRecordView ? null : BuildHeaderPagination(),
            Actions = actions
        });
        _ = InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<PageHeaderAction> BuildRecordOverflowActions()
    {
        if (_recordDetail is null)
            return [];

        var actions = new List<PageHeaderAction>();
        if (HasRecordPhone(_recordDetail))
        {
            actions.Add(new PageHeaderAction
            {
                Key = "conversacion",
                Label = _recordDetail.IdConversacionWhatsApp.HasValue ? "Abrir conversación" : "Crear conversación",
                Icon = _recordDetail.IdConversacionWhatsApp.HasValue ? "bi-chat-left-text" : "bi-plus-circle",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                Disabled = _openingConversation,
                OnClick = OpenConversationForRecordAsync
            });
            actions.Add(new PageHeaderAction
            {
                Key = "plantilla",
                Label = "Enviar plantilla",
                Icon = "bi-lightning-charge",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                Disabled = _openingConversation || _sendingBulkTemplate,
                OnClick = OpenRecordTemplateModalAsync
            });
        }

        actions.Add(new PageHeaderAction
        {
            Key = "unificar",
            Label = "Unificar",
            Icon = "bi-intersect",
            Style = PageHeaderActionStyle.Ghost,
            Priority = PageHeaderActionPriority.Overflow,
            Disabled = _mergingContact,
            OnClick = OpenMergeModalAsync
        });

        if (_recordDetail.Activo)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "baja",
