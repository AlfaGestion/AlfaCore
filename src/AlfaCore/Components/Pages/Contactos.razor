    private string BuildContactosQueryUrl(string key, int id)
        => BuildContactosUrl(
            string.Equals(key, "contacto", StringComparison.OrdinalIgnoreCase)
                ? ContactosUrlState.Record
                : ContactosUrlState.Editor,
            id);

    private string BuildContactosBaseUrl()
        => BuildContactosUrl(ContactosUrlState.Base);

    private bool NavigateToContactosState(ContactosUrlState state, int? id = null, bool replace = false)
    {
        var target = BuildContactosUrl(state, id);
        if (string.Equals(Nav.ToBaseRelativePath(Nav.Uri), target.TrimStart('/'), StringComparison.Ordinal))
            return false;

        Nav.NavigateTo(target, replace: replace);
        return true;
    }

    private string BuildContactosUrl(ContactosUrlState state, int? id = null)
    {
        var target = RouteContext.BuildRoute("/contactos");
        var invariantId = id.GetValueOrDefault().ToString(System.Globalization.CultureInfo.InvariantCulture);

        if (state == ContactosUrlState.Record && id.GetValueOrDefault() > 0)
            target = QueryHelpers.AddQueryString(target, "contacto", invariantId);
        else if (state == ContactosUrlState.Editor && id.GetValueOrDefault() > 0)
            target = QueryHelpers.AddQueryString(target, "editar", invariantId);

        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("directo", out var directo)
            && string.Equals(directo.ToString(), "1", StringComparison.OrdinalIgnoreCase))
            target = QueryHelpers.AddQueryString(target, "directo", "1");

        return target;
    }

