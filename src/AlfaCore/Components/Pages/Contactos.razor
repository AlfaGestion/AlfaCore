    private void SendBulkTemplateAsync()
    {
        var template = SelectedBulkTemplate;
        if (template is null)
        {
            _bulkTemplateError = "Seleccioná una plantilla aprobada.";
            return;
        }

        var values = ParseTemplateValues(_bulkTemplateValuesText).ToList();
        var required = CountTemplateVariables(template.CuerpoTexto);
        if (values.Count < required)
        {
            _bulkTemplateError = $"Esta plantilla requiere {required} valor(es) de variables.";
            return;
        }

        var contacts = GetTemplateContactsWithPhone().ToList();
        if (contacts.Count == 0)
        {
            _bulkTemplateError = "No hay contactos seleccionados con teléfono o celular.";
            return;
        }

        _bulkTemplateError = string.Empty;
        _bulkTemplateConfirmName = template.NombreVisible;
        _bulkTemplateConfirmCount = contacts.Count;
        _showBulkTemplateConfirm = true;
    }

    private async Task ConfirmBulkTemplateSendAsync()
    {
        var template = SelectedBulkTemplate;
        if (template is null)
        {
            _showBulkTemplateConfirm = false;
            _bulkTemplateError = "Seleccioná una plantilla aprobada.";
            return;
        }

        var values = ParseTemplateValues(_bulkTemplateValuesText).ToList();
        var contacts = GetTemplateContactsWithPhone().ToList();
        if (contacts.Count == 0)
        {
            _showBulkTemplateConfirm = false;
            _bulkTemplateError = "No hay contactos seleccionados con teléfono o celular.";
            return;
        }

        _showBulkTemplateConfirm = false;
        _sendingBulkTemplate = true;
        _bulkTemplateError = string.Empty;
        var acceptedByMeta = 0;
        var pendingConfirmation = 0;
        var failed = 0;
        try
        {
            foreach (var contact in contacts)
            {
                var phone = FirstNonEmpty(contact.Celular, contact.Telefono);
                try
                {
                    var conversation = await ConversacionesSvc.CreateOrGetWhatsAppConversationAsync(new ConversacionCrearWhatsAppRequest { TelefonoWhatsApp = phone });
                    var result = await ConversacionesSvc.SendTemplateMessageAsync(new ConversacionPlantillaSendRequest
                    {
                        IdConversacion = conversation.IdConversacion,
                        IdPlantilla = template.IdPlantilla,
                        ValoresVariables = values
                    });

                    if (IsKnownFailedDeliveryState(result.EstadoEnvio))
                        failed++;
                    else
                    {
                        acceptedByMeta++;
                        if (!IsKnownDeliveredDeliveryState(result.EstadoEnvio))
                            pendingConfirmation++;
                    }
                }
                catch
                {
                    failed++;
                }
            }

            _sendingBulkTemplate = false;
            CloseBulkTemplateModal();
            SetFeedback(BuildBulkTemplateFeedback(acceptedByMeta, failed, pendingConfirmation));
        }
        finally
        {
            _sendingBulkTemplate = false;
        }
    }

