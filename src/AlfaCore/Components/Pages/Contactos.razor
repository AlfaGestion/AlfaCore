                   OnCancel="CloseDeactivateConfirm" />

@if (_showBulkTemplateConfirm)
{
    <div class="cuentas-modal-backdrop" @onclick="CloseBulkTemplateConfirm">
        <section class="cuentas-modal cuentas-modal--compact" role="dialog" aria-modal="true" aria-labelledby="contactos-bulk-template-confirm-title" @onclick:stopPropagation="true">
            <header class="cuentas-modal__header">
                <div>
                    <span class="cuentas-modal__eyebrow">Confirmación</span>
                    <h3 id="contactos-bulk-template-confirm-title">Enviar plantilla</h3>
                </div>
                <button type="button" class="cuentas-modal__close" @onclick="CloseBulkTemplateConfirm" disabled="@_sendingBulkTemplate" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>
            <div class="cuentas-modal__body">
                <div class="context-card">
                    <span class="context-card__label">Plantilla</span>
                    <strong>@_bulkTemplateConfirmName</strong>
                    <span class="context-card__muted">Se enviará a @_bulkTemplateConfirmCount contacto(s). La entrega final puede confirmarse después por WhatsApp.</span>
