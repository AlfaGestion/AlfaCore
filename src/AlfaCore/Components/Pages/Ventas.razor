@page "/ventas"
@page "/{idweb}/{idbase:int}/ventas"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.GestionFilterStateService FilterState
@inject IJSRuntime JS

<PageTitle>Ventas | Alfa GestiÃ³n</PageTitle>

<div class="page-grid">
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">Ventas</h2>
            <p class="page-intro__text">Vista gerencial para facturaciÃ³n, cartera pendiente y concentraciÃ³n comercial.</p>
        </div>
    </section>

    <section class="panel-card filters-card" @onkeydown="HandleApplyKeyDownAsync">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Filtros de ventas</h3>
                <p class="panel-card__subtitle">Clientes, fechas y circuitos comerciales para acotar el anÃ¡lisis.</p>
            </div>
            <div class="quick-range">
                <button class="btn btn--ghost" @onclick="HoyAsync">Hoy</button>
                <button class="btn btn--ghost" @onclick="SemanaAsync">Esta semana</button>
                <button class="btn btn--ghost" @onclick="MesAsync">Este mes</button>
                <button class="btn btn--ghost" @onclick="MesAnteriorAsync">Mes anterior</button>
                <button class="btn btn--ghost" @onclick="UltimosTresAsync">Ãšltimos 3 meses</button>
                <button class="btn btn--ghost" @onclick="AnioAsync">AÃ±o actual</button>
            </div>
        </div>

        <div class="filters-grid filters-grid--dates">
            <div class="field">
                <label>Fecha desde</label>
                <InputDate @bind-Value="_filters.FechaDesde" />
            </div>
            <div class="field">
                <label>Fecha hasta</label>
                <InputDate @bind-Value="_filters.FechaHasta" />
            </div>
            <div class="filters-toggle-wrap">
                <button type="button" class="btn btn--ghost filters-toggle" @onclick="ToggleAdvanced">
                    @(_showAdvanced ? "Ocultar filtros" : "Mostrar filtros")
                </button>
            </div>
        </div>

        <div class="filters-summary" aria-live="polite">
            <span class="filters-summary__label">Filtros activos</span>
            <span class="filters-summary__text">@BuildSummary()</span>
        </div>

        @if (_showAdvanced)
        {
            <div class="filters-grid filters-grid--wide">
                <div class="field">
                    <label>Cliente</label>
                    <InputText @bind-Value="_filters.Cliente" />
                </div>
                <div class="field">
                    <label>Usuario</label>
                    <InputSelect @bind-Value="_filters.Usuario">
                        <option value="">Todos</option>
                        @foreach (var item in _options.Usuarios)
                        {
                            <option value="@item">@item</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label>Sucursal</label>
                    <InputSelect @bind-Value="_filters.Sucursal">
                        <option value="">Todas</option>
                        @foreach (var item in _options.Sucursales)
                        {
                            <option value="@item">@item</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label>DepÃ³sito</label>
                    <InputSelect @bind-Value="_filters.Deposito">
                        <option value="">Todos</option>
                        @foreach (var item in _options.Depositos)
                        {
                            <option value="@item">@item</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label>TC</label>
                    <InputSelect @bind-Value="_filters.TipoComprobante">
                        <option value="">Todos</option>
                        @foreach (var item in _options.TiposComprobante)
                        {
                            <option value="@item">@item</option>
                        }
                    </InputSelect>
                </div>
            </div>
        }

        <div class="actions">
            <button class="btn btn--primary" @onclick="LoadAsync">Aplicar filtros</button>
            <button class="btn btn--ghost" @onclick="ClearAsync">Limpiar</button>
        </div>
    </section>

    @if (_loading)
    {
        <div class="consultas-loading"><i class="bi bi-hourglass-split"></i> Cargandoâ€¦</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="consultas-error"><i class="bi bi-exclamation-triangle"></i> @_error</div>
    }
    else
    {
        <section class="kpi-grid">
            <article class="kpi-card"><div class="kpi-card__label">Facturado perÃ­odo</div><div class="kpi-card__value">@FmtMoney(_data.TotalFacturadoMes)</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Ticket promedio</div><div class="kpi-card__value">@FmtMoney(_data.TicketPromedioMes)</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Comprobantes</div><div class="kpi-card__value">@_data.ComprobantesMes</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Clientes activos</div><div class="kpi-card__value">@_data.ClientesActivos</div></article>
        </section>

        <article class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">EvoluciÃ³n mensual</h3>
                    <p class="panel-card__subtitle">Ãšltimos 12 meses consolidados</p>
                </div>
                <div class="chart-type-switch" title="Tipo de grÃ¡fico">
                    <button class="chart-type-switch__btn @(_chartType == "area" ? "chart-type-switch__btn--active" : "")"
                            @onclick='() => SetChartTypeAsync("area")' title="Ãrea">
                        <i class="bi bi-bar-chart-line"></i>
                    </button>
                    <button class="chart-type-switch__btn @(_chartType == "line" ? "chart-type-switch__btn--active" : "")"
                            @onclick='() => SetChartTypeAsync("line")' title="LÃ­nea">
                        <i class="bi bi-graph-up"></i>
                    </button>
                    <button class="chart-type-switch__btn @(_chartType == "bars" ? "chart-type-switch__btn--active" : "")"
                            @onclick='() => SetChartTypeAsync("bars")' title="Barras">
                        <i class="bi bi-bar-chart-fill"></i>
                    </button>
                </div>
            </div>
            <LineChart Data="_data.EvolucionMensual" ChartType="_chartType" />
        </article>

        <section class="two-grid">
            <article class="panel-card">
                <HorizontalBarChart Data="_data.TopArticulos" Titulo="Top artÃ­culos vendidos" Subtitulo="ArtÃ­culos mÃ¡s relevantes del perÃ­odo" />
            </article>
            <article class="panel-card">
                <HorizontalBarChart Data="_data.TopClientes" Titulo="Top clientes" Subtitulo="ConcentraciÃ³n de facturaciÃ³n" />
            </article>
        </section>
    }
</div>

@code {
    private const string ChartTypeKey = "alfacore_ventas_charttype";

    private bool _loading = true;
    private string _error = string.Empty;
    private bool _showAdvanced;
    private string _chartType = "area";

    private VentasDashboardDto _data = new();
    private VentasDashboardFilters _filters = null!;
    private VentasFilterOptionsDto _options = new();

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Ventas;
        try
        {
            _options = await GestionSvc.GetVentasFilterOptionsAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ChartTypeKey);
            if (!string.IsNullOrEmpty(saved) && saved != _chartType)
            {
                _chartType = saved;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SetChartTypeAsync(string type)
    {
        _chartType = type;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ChartTypeKey, type); }
        catch { }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        try
        {
            _data = await GestionSvc.GetVentasAsync(_filters);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private Task HoyAsync() => ApplyQuickRangeAsync("hoy");
    private Task SemanaAsync() => ApplyQuickRangeAsync("semana");
    private Task MesAsync() => ApplyQuickRangeAsync("mes");
    private Task MesAnteriorAsync() => ApplyQuickRangeAsync("mes-anterior");
    private Task UltimosTresAsync() => ApplyQuickRangeAsync("ultimos-3");
    private Task AnioAsync() => ApplyQuickRangeAsync("anio");
    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;

    private async Task HandleApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase) || _loading)
            return;

        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        var today = DateTime.Today;
        _filters.FechaDesde = new DateTime(today.Year, today.Month, 1);
        _filters.FechaHasta = today;
        _filters.Cliente = null;
        _filters.Usuario = null;
        _filters.Sucursal = null;
        _filters.Deposito = null;
        _filters.TipoComprobante = null;
        await LoadAsync();
    }

    private async Task ApplyQuickRangeAsync(string key)
    {
        var today = DateTime.Today;
        switch (key)
        {
            case "hoy":
                _filters.FechaDesde = today;
                _filters.FechaHasta = today;
                break;
            case "semana":
                var diff = ((int)today.DayOfWeek + 6) % 7;
                _filters.FechaDesde = today.AddDays(-diff);
                _filters.FechaHasta = today;
                break;
            case "mes":
                _filters.FechaDesde = new DateTime(today.Year, today.Month, 1);
                _filters.FechaHasta = today;
                break;
            case "mes-anterior":
                var firstThisMonth = new DateTime(today.Year, today.Month, 1);
                _filters.FechaDesde = firstThisMonth.AddMonths(-1);
                _filters.FechaHasta = firstThisMonth.AddDays(-1);
                break;
            case "ultimos-3":
                _filters.FechaDesde = today.AddMonths(-3);
                _filters.FechaHasta = today;
                break;
            case "anio":
                _filters.FechaDesde = new DateTime(today.Year, 1, 1);
                _filters.FechaHasta = today;
                break;
        }

        await LoadAsync();
    }

    private string BuildSummary()
    {
        var parts = new List<string>();
        if (_filters.FechaDesde.HasValue || _filters.FechaHasta.HasValue)
        {
            parts.Add($"Fecha: {_filters.FechaDesde:dd/MM/yyyy} a {_filters.FechaHasta:dd/MM/yyyy}");
        }

        AddIfPresent(parts, "Cliente", _filters.Cliente);
        AddIfPresent(parts, "Usuario", _filters.Usuario);
        AddIfPresent(parts, "Sucursal", _filters.Sucursal);
        AddIfPresent(parts, "DepÃ³sito", _filters.Deposito);
        AddIfPresent(parts, "TC", _filters.TipoComprobante);

        return parts.Count == 0 ? "Sin filtros seleccionados." : string.Join(" | ", parts);
    }

    private static void AddIfPresent(List<string> parts, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            parts.Add($"{label}: {value}");
    }

    private static string FmtMoney(decimal value)
        => value.ToString("$ #,##0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
