@page "/ventas"
@page "/{idweb}/{idbase:int}/ventas"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.GestionFilterStateService FilterState
@inject IJSRuntime JS

<PageTitle>Ventas | Alfa Gestión</PageTitle>

<div class="page-grid">
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">Ventas</h2>
            <p class="page-intro__text">Vista gerencial para facturación, cartera pendiente y concentración comercial.</p>
        </div>
    </section>

    <VentasFiltersBar Model="_filters" Options="_options" OnApply="LoadAsync" Titulo="Filtros de ventas" Subtitulo="Clientes, fechas y circuitos comerciales para acotar el análisis." MostrarComparativoUnidadNegocio="true" />

    @if (_loading)
    {
        <div class="consultas-loading"><i class="bi bi-hourglass-split"></i> Cargando…</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="consultas-error"><i class="bi bi-exclamation-triangle"></i> @_error</div>
    }
    else
    {
        <section class="kpi-grid">
            <article class="kpi-card">
                <div class="kpi-card__label">Facturado período</div>
                <div class="kpi-card__value">@FmtMoney(_data.TotalFacturadoMes)</div>
                @if (_comparativo is not null)
                {
                    <div class="kpi-card__compare">
                        @VariacionTexto("vs. período anterior", _comparativo.VariacionPeriodoAnterior)
                        @VariacionTexto("vs. año anterior", _comparativo.VariacionAnioAnterior)
                    </div>
                }
            </article>
            <article class="kpi-card"><div class="kpi-card__label">Ticket promedio</div><div class="kpi-card__value">@FmtMoney(_data.TicketPromedioMes)</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Comprobantes</div><div class="kpi-card__value">@_data.ComprobantesMes</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Clientes activos</div><div class="kpi-card__value">@_data.ClientesActivos</div></article>
        </section>

        @if (SepararPorUnidad)
        {
            @if (_porUnidad.Count == 0)
            {
                <div class="panel-card empty-state"><p>No hay datos por unidad de negocio para el período filtrado.</p></div>
            }
            else
            {
                <DataTable Titulo="Unidades de negocio" Subtitulo="Facturación del período por unidad de negocio">
                    <Header>
                        <tr>
                            <th>Unidad de negocio</th>
                            <th style="text-align:right;">Facturado</th>
                            <th style="text-align:right;">Comprobantes</th>
                            <th style="text-align:right;">Ticket promedio</th>
                            <th style="text-align:right;">Clientes activos</th>
                        </tr>
                    </Header>
                    <Rows>
                        @foreach (var item in _porUnidad)
                        {
                            <tr>
                                <td><strong>@item.Descripcion</strong></td>
                                <td style="text-align:right;">@FmtMoney(item.TotalFacturado)</td>
                                <td style="text-align:right;">@item.Comprobantes</td>
                                <td style="text-align:right;">@FmtMoney(item.TicketPromedio)</td>
                                <td style="text-align:right;">@item.ClientesActivos</td>
                            </tr>
                        }
                    </Rows>
                </DataTable>
            }
        }

        <article class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Evolución mensual</h3>
                    <p class="panel-card__subtitle">Últimos 12 meses consolidados</p>
                </div>
                <div class="chart-type-switch" title="Tipo de gráfico">
                    <button class="chart-type-switch__btn @(_chartType == "area" ? "chart-type-switch__btn--active" : "")"
                            @onclick='() => SetChartTypeAsync("area")' title="Área">
                        <i class="bi bi-bar-chart-line"></i>
                    </button>
                    <button class="chart-type-switch__btn @(_chartType == "line" ? "chart-type-switch__btn--active" : "")"
                            @onclick='() => SetChartTypeAsync("line")' title="Línea">
                        <i class="bi bi-graph-up"></i>
                    </button>
                    <button class="chart-type-switch__btn @(_chartType == "bars" ? "chart-type-switch__btn--active" : "")"
                            @onclick='() => SetChartTypeAsync("bars")' title="Barras">
                        <i class="bi bi-bar-chart-fill"></i>
                    </button>
                </div>
            </div>
            <LineChart Data="_data.EvolucionMensual" ChartType="_chartType" />
        </article>

        <section class="two-grid">
            <article class="panel-card">
                <HorizontalBarChart Data="_data.TopArticulos" Titulo="Top artículos vendidos" Subtitulo="Artículos más relevantes del período" />
            </article>
            <article class="panel-card">
                <HorizontalBarChart Data="_data.TopClientes" Titulo="Top clientes" Subtitulo="Concentración de facturación" />
            </article>
        </section>
    }
</div>

@code {
    private const string ChartTypeKey = "alfacore_ventas_charttype";

    private bool _loading = true;
    private string _error = string.Empty;
    private string _chartType = "area";

    private VentasDashboardDto _data = new();
    private VentasComparativoPeriodoDto? _comparativo;
    private IReadOnlyList<VentasUnidadNegocioResumenDto> _porUnidad = [];
    private VentasDashboardFilters _filters = null!;
    private VentasFilterOptionsDto _options = new();

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Ventas;
        try
        {
            _options = await GestionSvc.GetVentasFilterOptionsAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ChartTypeKey);
            if (!string.IsNullOrEmpty(saved) && saved != _chartType)
            {
                _chartType = saved;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SetChartTypeAsync(string type)
    {
        _chartType = type;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ChartTypeKey, type); }
        catch { }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        try
        {
            _data = await GestionSvc.GetVentasAsync(_filters);
            _comparativo = await GestionSvc.GetVentasComparativoPeriodoAsync(_filters);
            _porUnidad = SepararPorUnidad
                ? await GestionSvc.GetVentasPorUnidadNegocioAsync(_filters)
                : [];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static string FmtMoney(decimal value)
        => value.ToString("$ #,##0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private bool SepararPorUnidad => _filters.UnidadesNegocio.Count > 1;

    private static RenderFragment VariacionTexto(string label, decimal? variacion) => builder =>
    {
        if (!variacion.HasValue)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "kpi-card__compare-item kpi-card__compare-item--neutral");
            builder.AddContent(2, $"{label}: s/d");
            builder.CloseElement();
            return;
        }

        var signo = variacion.Value > 0 ? "+" : string.Empty;
        var clase = variacion.Value > 0 ? "kpi-card__compare-item--up" : variacion.Value < 0 ? "kpi-card__compare-item--down" : "kpi-card__compare-item--neutral";
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"kpi-card__compare-item {clase}");
        builder.AddContent(2, $"{label}: {signo}{variacion.Value.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))}%");
        builder.CloseElement();
    };
}
