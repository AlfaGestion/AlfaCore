@page "/admin/cargos"
@page "/{idweb}/{idbase:int}/admin/cargos"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ICentralAdminService AdminSvc
@inject AlfaCore.Services.IBillingService BillingSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav

<PageTitle>Cargos | AlfaNet</PageTitle>

<div class="page-grid admin-home-page">
<div class="panel-card">
    <div class="panel-card__header">
        <div>
            <h1 class="panel-card__title">Cargos</h1>
            <p class="panel-card__subtitle">Cargos de suscripción generados por el sistema (período facturado de cada módulo contratado). No se cargan a mano acá — los genera el job diario de facturación.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-light" @onclick="AbrirConfiguracionVista">Configurar vista</button>
            <button type="button" class="btn btn-outline-light" @onclick="GoHome">Inicio</button>
        </div>
    </div>

    @if (!IsSuperAdmin)
    {
        <div class="editor-msg editor-msg--warning">
            <strong>Acceso restringido</strong>
            <p>Solo los superadmin pueden ver esta sección.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="editor-msg editor-msg--warning">
                <strong>No se pudo completar la operación</strong>
                <p>@_error</p>
            </div>
        }

        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-lg-3">
                <label class="form-label">Cliente</label>
                <select class="form-select" @bind="_filters.IdCliente">
                    <option value="">Todos</option>
                    @foreach (var cliente in _clientes)
                    {
                        <option value="@cliente.IdCliente">@cliente.RazonSocial (@cliente.IdCliente)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-3">
                <label class="form-label">Estado</label>
                <select class="form-select" @bind="_filters.Estado">
                    <option value="">Todos</option>
                    <option value="@CargoEstados.Pendiente">Pendiente</option>
                    <option value="@CargoEstados.Pagado">Pagado</option>
                    <option value="@CargoEstados.PagoParcial">Pago parcial</option>
                    <option value="@CargoEstados.Vencido">Vencido</option>
                    <option value="@CargoEstados.Anulado">Anulado</option>
                    <option value="@CargoEstados.Borrador">Borrador</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Vence desde</label>
                <input class="form-control" type="date" @bind="_fechaVencimientoDesde" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Vence hasta</label>
                <input class="form-control" type="date" @bind="_fechaVencimientoHasta" />
            </div>
            <div class="col-12 col-lg-2">
                <button type="button" class="btn btn-primary w-100" @onclick="() => BuscarAsync()">Buscar</button>
            </div>
        </div>

        @if (_loading)
        {
            <p>Cargando cargos...</p>
        }
        else if (_items.Count == 0)
        {
            <div class="shell-empty-state">
                <strong>No hay cargos para los filtros seleccionados.</strong>
                <span>Los cargos los genera el job diario de facturación sobre módulos contratados con plan.</span>
            </div>
        }
        else
        {
            var visibleColumns = GetVisibleColumns();

            <div class="table-responsive admin-table-wrap">
                <table class="table table-sm align-middle admin-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            @foreach (var column in visibleColumns)
                            {
                                <th>@column.Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr>
                                @foreach (var column in visibleColumns)
                                {
                                    <td>@RenderCell(item, column.Key)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
                <span class="shell-empty-state__eyebrow">@_total registro(s) — página @_pageNumber de @Math.Max(_totalPages, 1)</span>
                <div class="d-inline-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-light" disabled="@(!_hasPrev)" @onclick="() => CambiarPaginaAsync(_pageNumber - 1)">Anterior</button>
                    <button type="button" class="btn btn-sm btn-outline-light" disabled="@(!_hasNext)" @onclick="() => CambiarPaginaAsync(_pageNumber + 1)">Siguiente</button>
                </div>
            </div>
        }
    }
</div>
</div>

@if (_showViewSettings)
{
    <div class="modal-overlay" @onclick="CancelarConfiguracionVista">
        <section class="panel-card app-modal admin-modal" role="dialog" aria-modal="true" aria-labelledby="cargos-view-settings-title" @onclick:stopPropagation="true">
            <div class="panel-card__header">
                <div>
                    <h2 id="cargos-view-settings-title" class="panel-card__title">Configurar vista</h2>
                    <p class="panel-card__subtitle">Elegí las columnas visibles y su orden.</p>
                </div>
                <button type="button" class="btn btn-outline-light" @onclick="CancelarConfiguracionVista">Cerrar</button>
            </div>

            <div class="d-flex flex-column gap-2">
                @{
                    var ordered = _viewDraft.OrderBy(c => c.Order).ToList();
                }
                @for (var i = 0; i < ordered.Count; i++)
                {
                    var column = ordered[i];
                    var index = i;
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check flex-grow-1">
                            <input class="form-check-input" type="checkbox" id="@("cargos-col-" + column.Key)" checked="@column.Visible" @onchange="args => SetColumnVisibility(column.Key, args.Value is bool v && v)" />
                            <label class="form-check-label" for="@("cargos-col-" + column.Key)">@column.Label</label>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" disabled="@(index == 0)" @onclick="() => MoveColumn(column.Key, -1)"><i class="bi bi-arrow-up"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-light" disabled="@(index == ordered.Count - 1)" @onclick="() => MoveColumn(column.Key, 1)"><i class="bi bi-arrow-down"></i></button>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-primary" disabled="@_savingViewSettings" @onclick="GuardarConfiguracionVistaAsync">Guardar vista</button>
                <button type="button" class="btn btn-outline-light" disabled="@_savingViewSettings" @onclick="CancelarConfiguracionVista">Cancelar</button>
            </div>
        </section>
    </div>
}

@code {
    private readonly CargosFilters _filters = new();
    private readonly List<CargoDto> _items = [];
    private readonly List<AdminClienteDto> _clientes = [];
    private List<CargosViewColumnDto> _viewSettings = [];
    private List<CargosViewColumnDto> _viewDraft = [];

    private bool _loading = true;
    private bool IsSuperAdmin => AppUserSession.CurrentUser?.SuperAdmin == true;
    private string _error = string.Empty;
    private DateTime? _fechaVencimientoDesde;
    private DateTime? _fechaVencimientoHasta;

    private int _pageNumber = 1;
    private int _totalPages;
    private int _total;
    private bool _hasPrev;
    private bool _hasNext;

    private bool _showViewSettings;
    private bool _savingViewSettings;

    protected override async Task OnInitializedAsync()
    {
        if (!IsSuperAdmin)
        {
            _loading = false;
            return;
        }

        try
        {
            _clientes.AddRange(await AdminSvc.GetClientesAsync());
            _viewSettings = (await BillingSvc.GetCargosViewSettingsAsync(CurrentUserName())).Columnas;
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
        }

        await BuscarAsync(resetPage: true);
    }

    private void GoHome()
        => Nav.NavigateTo(RouteContext.BuildRoute("/admin"));

    private string CurrentUserName()
        => AppUserSession.CurrentUser?.UserName ?? string.Empty;

    private async Task BuscarAsync(bool resetPage = true)
    {
        _loading = true;
        _error = string.Empty;
        if (resetPage)
            _filters.PageNumber = 1;

        _filters.FechaVencimientoDesde = _fechaVencimientoDesde;
        _filters.FechaVencimientoHasta = _fechaVencimientoHasta?.Date.AddDays(1).AddTicks(-1);

        try
        {
            var result = await BillingSvc.SearchCargosAsync(_filters);
            _items.Clear();
            _items.AddRange(result.Items);
            _pageNumber = result.PageNumber;
            _totalPages = result.TotalPages;
            _total = result.Total;
            _hasPrev = result.HasPrev;
            _hasNext = result.HasNext;
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1)
            return;

        _filters.PageNumber = page;
        await BuscarAsync(resetPage: false);
    }

    private List<CargosViewColumnDto> GetVisibleColumns()
        => _viewSettings.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private static string RenderCell(CargoDto item, string key) => key switch
    {
        CargosViewColumnKeys.Cliente => string.IsNullOrWhiteSpace(item.ClienteNombre) ? item.IdCliente : $"{item.ClienteNombre} ({item.IdCliente})",
        CargosViewColumnKeys.Concepto => item.Concepto,
        CargosViewColumnKeys.Periodo => FormatPeriodo(item),
        CargosViewColumnKeys.Importe => item.Importe.ToString("N2"),
        CargosViewColumnKeys.Moneda => item.Moneda,
        CargosViewColumnKeys.Vencimiento => item.FechaVencimiento.ToString("dd/MM/yyyy"),
        CargosViewColumnKeys.Estado => GetEstadoLabel(item.Estado),
        _ => string.Empty
    };

    private static string FormatPeriodo(CargoDto item)
        => item.PeriodoDesde is null || item.PeriodoHasta is null
            ? "—"
            : $"{item.PeriodoDesde.Value:dd/MM/yyyy} a {item.PeriodoHasta.Value:dd/MM/yyyy}";

    private static string GetEstadoLabel(string estado) => estado switch
    {
        CargoEstados.Borrador => "Borrador",
        CargoEstados.Pendiente => "Pendiente",
        CargoEstados.Pagado => "Pagado",
        CargoEstados.PagoParcial => "Pago parcial",
        CargoEstados.Vencido => "Vencido",
        CargoEstados.Anulado => "Anulado",
        _ => estado
    };

    private void AbrirConfiguracionVista()
    {
        _viewDraft = _viewSettings.Select(c => new CargosViewColumnDto { Key = c.Key, Label = c.Label, Visible = c.Visible, Order = c.Order }).ToList();
        _showViewSettings = true;
    }

    private void CancelarConfiguracionVista()
        => _showViewSettings = false;

    private void SetColumnVisibility(string key, bool visible)
    {
        var column = _viewDraft.FirstOrDefault(c => c.Key == key);
        if (column is null)
            return;

        // Al menos una columna visible siempre (regla 26.6 de CODEX_RULES.md).
        if (!visible && _viewDraft.Count(c => c.Visible) <= 1)
            return;

        column.Visible = visible;
    }

    private void MoveColumn(string key, int delta)
    {
        var ordered = _viewDraft.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => c.Key == key);
        var newIndex = index + delta;
        if (index < 0 || newIndex < 0 || newIndex >= ordered.Count)
            return;

        (ordered[index], ordered[newIndex]) = (ordered[newIndex], ordered[index]);
        for (var i = 0; i < ordered.Count; i++)
            ordered[i].Order = i;

        _viewDraft = ordered;
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        _savingViewSettings = true;
        try
        {
            var settings = new CargosViewSettingsDto { AgruparPor = CargosViewGroupKeys.None, Columnas = _viewDraft };
            await BillingSvc.SaveCargosViewSettingsAsync(CurrentUserName(), settings);
            _viewSettings = (await BillingSvc.GetCargosViewSettingsAsync(CurrentUserName())).Columnas;
            _showViewSettings = false;
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;
        }
        finally
        {
            _savingViewSettings = false;
        }
    }
}
