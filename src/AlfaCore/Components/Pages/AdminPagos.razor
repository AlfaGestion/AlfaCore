@page "/admin/pagos"
@page "/{idweb}/{idbase:int}/admin/pagos"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@implements IDisposable
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ICentralAdminService AdminSvc
@inject AlfaCore.Services.IBillingService BillingSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav

<PageTitle>Pagos | AlfaNet</PageTitle>

@* Administrar → Pagos (AlfaDesign v1, 2026-10-07). Listado con paginación en la Context Toolbar y
   alta manual de pagos en AlfaDialog (el formulario completo es el paso de confirmación). *@

<AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

<div class="adm-page">
    <div class="adm">
        <header class="adm-header">
            <div>
                <h2>Pagos</h2>
                <p>Pagos registrados contra cargos de suscripción. En esta versión los pagos se cargan a mano (transferencia u otro medio confirmado por fuera del sistema): Mercado Pago todavía no está integrado.</p>
            </div>
        </header>

        @if (!IsSuperAdmin)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="Acceso restringido" Message="Solo los superadmin pueden ver esta sección." />
        }
        else
        {
            <section class="adm-card" aria-label="Filtros">
                <div class="adm-card__body">
                    <div class="adm-toolbar">
                        <AlfaSelect Label="Cliente" Placeholder="Todos" Options="ClienteOptions" Value="@_filters.IdCliente" ValueChanged="@(v => _filters.IdCliente = v ?? string.Empty)" />
                        <AlfaSelect Label="Estado" Placeholder="Todos" Options="EstadoOptions" Value="@_filters.Estado" ValueChanged="@(v => _filters.Estado = v ?? string.Empty)" />
                        <AlfaSelect Label="Medio de pago" Placeholder="Todos" Options="MedioPagoOptions" Value="@_filters.MedioPago" ValueChanged="@(v => _filters.MedioPago = v ?? string.Empty)" />
                        <AlfaInput Label="Desde" Type="date" Value="@FormatDate(_fechaDesde)" ValueChanged="@(v => _fechaDesde = ParseDate(v))" />
                        <AlfaInput Label="Hasta" Type="date" Value="@FormatDate(_fechaHasta)" ValueChanged="@(v => _fechaHasta = ParseDate(v))" />
                        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-search" Loading="@_loading" OnClick="_ => BuscarAsync()">Buscar</AlfaButton>
                    </div>
                </div>
            </section>

            @if (_loading && _items.Count == 0)
            {
                <AlfaEmptyState Title="Cargando pagos" Message="Buscando pagos para los filtros seleccionados." />
            }
            else if (_loadError is not null)
            {
                <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudieron cargar los pagos" Message="@_loadError" ActionLabel="Reintentar" ActionIcon="bi bi-arrow-clockwise" OnAction="_ => BuscarAsync(resetPage: false)" />
            }
            else if (_items.Count == 0)
            {
                <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin pagos" Message="No hay pagos para los filtros seleccionados. Usá “Registrar pago” para cargar uno manual contra un cargo pendiente." ActionLabel="Registrar pago" ActionIcon="bi bi-plus-circle" OnAction="_ => AbrirRegistrarPago()" />
            }
            else
            {
                var visibleColumns = GetVisibleColumns();

                <section class="adm-card" aria-label="Pagos">
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    @foreach (var column in visibleColumns)
                                    {
                                        <th class="@(column.Key == PagosViewColumnKeys.Importe ? "is-number" : null)">@column.Label</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _items)
                                {
                                    <tr>
                                        @foreach (var column in visibleColumns)
                                        {
                                            @if (column.Key == PagosViewColumnKeys.Estado)
                                            {
                                                <td><AlfaTag Tone="@GetEstadoTone(item.Estado)">@GetEstadoLabel(item.Estado)</AlfaTag></td>
                                            }
                                            else
                                            {
                                                <td class="@(column.Key == PagosViewColumnKeys.Importe ? "is-number" : null)">@RenderCell(item, column.Key)</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer class="alfa-data-view-footer">
                        <span class="alfa-data-view-footer__summary">@(_total == 1 ? "1 registro" : $"{_total} registros") · Página @_pageNumber de @Math.Max(_totalPages, 1)</span>
                    </footer>
                </section>
            }
        }
    </div>
</div>

<AlfaDialog Open="@_showRegistrarPago"
            Title="Registrar pago manual"
            Eyebrow="Pagos"
            Description="El pago queda aprobado directo (ya fue confirmado por fuera del sistema) y marca el cargo como pagado."
            ErrorMessage="@_registrarError"
            Loading="@_registrando"
            Size="AlfaDialogSize.Lg"
            OnClose="CancelarRegistrarPago">
    <ChildContent>
        <div class="adm-grid">
            <AlfaSelect Label="Cliente" Placeholder="Elegí un cliente..." Options="ClienteOptions" Value="@_registrarForm.IdCliente" ValueChanged="OnClienteSeleccionadoAsync" Disabled="@_registrando" />
            <div>
                <AlfaSelect Label="Cargo" Placeholder="Elegí un cargo pendiente..." Options="CargoOptions" Value="@(_registrarForm.IdCargo > 0 ? _registrarForm.IdCargo.ToString(Inv) : null)" ValueChanged="@(v => _registrarForm.IdCargo = int.TryParse(v, out var id) ? id : 0)" Disabled="@(_registrando || _cargosDelCliente.Count == 0)" />
                @if (!string.IsNullOrWhiteSpace(_registrarForm.IdCliente) && _cargosDelCliente.Count == 0)
                {
                    <p class="adm-hint">Este cliente no tiene cargos pendientes ni vencidos.</p>
                }
            </div>
        </div>
        <div class="adm-grid adm-grid--4">
            <AlfaInput Label="Fecha" Type="date" Value="@FormatDate(_registrarFecha)" ValueChanged="@(v => _registrarFecha = ParseDate(v) ?? DateTime.Today)" Disabled="@_registrando" />
            <AlfaInput Label="Importe" Type="number" Value="@_registrarForm.Importe.ToString("0.##", Inv)" ValueChanged="@(v => _registrarForm.Importe = ParseDecimal(v) ?? 0)" Disabled="@_registrando" />
            <AlfaSelect Label="Moneda" Options="MonedaOptions" Value="@_registrarForm.Moneda" ValueChanged="@(v => _registrarForm.Moneda = v ?? MonedaValores.Ars)" Disabled="@_registrando" />
            <AlfaSelect Label="Medio de pago" Options="MedioPagoOptions" Value="@_registrarForm.MedioPago" ValueChanged="@(v => _registrarForm.MedioPago = v ?? MedioPagoValores.Transferencia)" Disabled="@_registrando" />
        </div>
        <AlfaInput Label="Referencia" Placeholder="Nº de transferencia, comprobante, etc." Value="@_registrarForm.Referencia" ValueChanged="@(v => _registrarForm.Referencia = v)" Disabled="@_registrando" />
        <div class="adm-textarea">
            <label for="pago-observaciones">Observaciones</label>
            <textarea id="pago-observaciones" rows="2" value="@_registrarForm.Observaciones" @oninput="@(e => _registrarForm.Observaciones = e.Value?.ToString())" disabled="@_registrando"></textarea>
        </div>
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_registrando" OnClick="_ => CancelarRegistrarPago()">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check2-circle" Loading="@_registrando" OnClick="_ => ConfirmarRegistrarPagoAsync()">Registrar pago</AlfaButton>
    </Footer>
</AlfaDialog>

<AlfaDialog Open="@_showViewSettings"
            Title="Configurar vista"
            Eyebrow="Pagos"
            Description="Elegí las columnas visibles y su orden."
            Loading="@_savingViewSettings"
            OnClose="CancelarConfiguracionVista">
    <ChildContent>
        <div class="adm-view-columns">
            @{
                var ordered = _viewDraft.OrderBy(c => c.Order).ToList();
            }
            @for (var i = 0; i < ordered.Count; i++)
            {
                var column = ordered[i];
                var index = i;
                <div class="adm-view-column">
                    <AlfaCheckbox Value="@column.Visible" ValueChanged="@(v => SetColumnVisibility(column.Key, v == true))">@column.Label</AlfaCheckbox>
                    <AlfaIconButton Icon="bi bi-arrow-up" Label="@($"Subir {column.Label}")" Size="AlfaSize.Sm" Disabled="@(index == 0)" OnClick="_ => MoveColumn(column.Key, -1)" />
                    <AlfaIconButton Icon="bi bi-arrow-down" Label="@($"Bajar {column.Label}")" Size="AlfaSize.Sm" Disabled="@(index == ordered.Count - 1)" OnClick="_ => MoveColumn(column.Key, 1)" />
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_savingViewSettings" OnClick="_ => CancelarConfiguracionVista()">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-floppy" Loading="@_savingViewSettings" OnClick="_ => GuardarConfiguracionVistaAsync()">Guardar vista</AlfaButton>
    </Footer>
</AlfaDialog>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private readonly PagosFilters _filters = new();
    private readonly List<PagoDto> _items = [];
    private readonly List<AdminClienteDto> _clientes = [];
    private readonly List<CargoDto> _cargosDelCliente = [];
    private List<PagosViewColumnDto> _viewSettings = [];
    private List<PagosViewColumnDto> _viewDraft = [];

    private bool _loading = true;
    private bool IsSuperAdmin => AppUserSession.CurrentUser?.SuperAdmin == true;
    private string? _loadError;
    private AppUiMessage? _feedback;
    private DateTime? _fechaDesde;
    private DateTime? _fechaHasta;

    private int _pageNumber = 1;
    private int _totalPages;
    private int _total;
    private bool _hasPrev;
    private bool _hasNext;

    private bool _showViewSettings;
    private bool _savingViewSettings;

    private bool _showRegistrarPago;
    private bool _registrando;
    private string _registrarError = string.Empty;
    private RegistrarPagoManualRequest _registrarForm = new();
    private DateTime _registrarFecha = DateTime.Today;

    private static readonly IReadOnlyList<AlfaSelectOption> EstadoOptions =
    [
        new(PagoEstados.Creado, "Creado"),
        new(PagoEstados.Pendiente, "Pendiente"),
        new(PagoEstados.Aprobado, "Aprobado"),
        new(PagoEstados.Rechazado, "Rechazado"),
        new(PagoEstados.Cancelado, "Cancelado"),
        new(PagoEstados.Reembolsado, "Reembolsado")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> MedioPagoOptions
        = MedioPagoValores.Todos.Select(medio => new AlfaSelectOption(medio, GetMedioPagoLabel(medio))).ToList();

    private static readonly IReadOnlyList<AlfaSelectOption> MonedaOptions
        = MonedaValores.Todas.Select(moneda => new AlfaSelectOption(moneda, moneda)).ToList();

    private IReadOnlyList<AlfaSelectOption> ClienteOptions
        => _clientes.Select(c => new AlfaSelectOption(c.IdCliente, $"{c.RazonSocial} ({c.IdCliente})")).ToList();

    private IReadOnlyList<AlfaSelectOption> CargoOptions
        => _cargosDelCliente
            .Select(cargo => new AlfaSelectOption(
                cargo.Id.ToString(Inv),
                $"#{cargo.Id} — {cargo.Concepto} — {cargo.Importe:N2} {cargo.Moneda} (vence {cargo.FechaVencimiento:dd/MM/yyyy})"))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!IsSuperAdmin)
        {
            _loading = false;
            return;
        }

        try
        {
            _clientes.AddRange(await AdminSvc.GetClientesAsync());
            _viewSettings = (await BillingSvc.GetPagosViewSettingsAsync(CurrentUserName())).Columnas;
        }
        catch (Exception ex)
        {
            _feedback = AppUiMessage.Error("No se pudieron cargar los datos", UserMessage(ex));
        }

        await BuscarAsync(resetPage: true);
    }

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        Title = "Pagos",
        Breadcrumb = ["Administrar", "Pagos"],
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "admin",
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildAdministrar(RouteContext, Nav, "pagos"),
        Pagination = IsSuperAdmin && _total > 0
            ? new PageHeaderPaginationConfig
            {
                Label = _total == 1 ? "1 registro" : $"{_total} registros",
                PageLabel = $"{_pageNumber} / {Math.Max(_totalPages, 1)}",
                HasPrevious = _hasPrev,
                HasNext = _hasNext,
                Disabled = _loading,
                OnPrevious = () => InvokeAsync(() => CambiarPaginaAsync(_pageNumber - 1)),
                OnNext = () => InvokeAsync(() => CambiarPaginaAsync(_pageNumber + 1))
            }
            : null,
        Actions =
        [
            // Los clics llegan desde la Context Toolbar (otro componente): hay que pedir el re-render de esta página.
            new PageHeaderAction { Key = "registrar-pago", Label = "Registrar pago", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = !IsSuperAdmin, OnClick = () => InvokeAsync(() => { AbrirRegistrarPago(); StateHasChanged(); }) },
            new PageHeaderAction { Key = "configurar-vista", Label = "Configurar vista", Icon = "bi-sliders", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = !IsSuperAdmin, OnClick = () => InvokeAsync(() => { AbrirConfiguracionVista(); StateHasChanged(); }) }
        ]
    });

    private string CurrentUserName()
        => AppUserSession.CurrentUser?.UserName ?? string.Empty;

    private async Task BuscarAsync(bool resetPage = true)
    {
        _loading = true;
        _loadError = null;
        if (resetPage)
            _filters.PageNumber = 1;

        _filters.FechaDesde = _fechaDesde;
        _filters.FechaHasta = _fechaHasta?.Date.AddDays(1).AddTicks(-1);

        try
        {
            var result = await BillingSvc.SearchPagosAsync(_filters);
            _items.Clear();
            _items.AddRange(result.Items);
            _pageNumber = result.PageNumber;
            _totalPages = result.TotalPages;
            _total = result.Total;
            _hasPrev = result.HasPrev;
            _hasNext = result.HasNext;
        }
        catch (Exception ex)
        {
            _loadError = UserMessage(ex);
        }
        finally
        {
            _loading = false;
            UpdatePageHeader();
            StateHasChanged();
        }
    }

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1)
            return;

        _filters.PageNumber = page;
        await BuscarAsync(resetPage: false);
    }

    private List<PagosViewColumnDto> GetVisibleColumns()
        => _viewSettings.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private static string RenderCell(PagoDto item, string key) => key switch
    {
        PagosViewColumnKeys.Cliente => string.IsNullOrWhiteSpace(item.ClienteNombre) ? item.IdCliente : $"{item.ClienteNombre} ({item.IdCliente})",
        PagosViewColumnKeys.Fecha => item.Fecha.ToString("dd/MM/yyyy HH:mm"),
        PagosViewColumnKeys.Importe => item.Importe.ToString("N2"),
        PagosViewColumnKeys.Moneda => item.Moneda,
        PagosViewColumnKeys.MedioPago => GetMedioPagoLabel(item.MedioPago),
        PagosViewColumnKeys.Estado => GetEstadoLabel(item.Estado),
        PagosViewColumnKeys.Referencia => item.Referencia ?? string.Empty,
        _ => string.Empty
    };

    private static string GetMedioPagoLabel(string medio) => medio switch
    {
        MedioPagoValores.Efectivo => "Efectivo",
        MedioPagoValores.Transferencia => "Transferencia",
        MedioPagoValores.MercadoPago => "Mercado Pago",
        MedioPagoValores.Tarjeta => "Tarjeta",
        MedioPagoValores.DebitoAutomatico => "Débito automático",
        MedioPagoValores.Otro => "Otro",
        _ => medio
    };

    private static string GetEstadoLabel(string estado) => estado switch
    {
        PagoEstados.Creado => "Creado",
        PagoEstados.Pendiente => "Pendiente",
        PagoEstados.Aprobado => "Aprobado",
        PagoEstados.Rechazado => "Rechazado",
        PagoEstados.Cancelado => "Cancelado",
        PagoEstados.Reembolsado => "Reembolsado",
        _ => estado
    };

    private static AlfaTagTone GetEstadoTone(string estado) => estado switch
    {
        PagoEstados.Aprobado => AlfaTagTone.Success,
        PagoEstados.Pendiente or PagoEstados.Creado => AlfaTagTone.Warning,
        PagoEstados.Rechazado => AlfaTagTone.Danger,
        _ => AlfaTagTone.Neutral
    };

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");

    private static DateTime? ParseDate(string? value)
        => DateTime.TryParseExact(value, "yyyy-MM-dd", Inv, System.Globalization.DateTimeStyles.None, out var parsed) ? parsed : null;

    private static decimal? ParseDecimal(string? value)
        => decimal.TryParse((value ?? string.Empty).Trim().Replace(',', '.'), System.Globalization.NumberStyles.Number, Inv, out var parsed) ? parsed : null;

    private static string UserMessage(Exception ex)
        => ex is AlfaCore.Services.AppUserFacingException userFacing ? userFacing.UserMessage : ex.Message;

    private void AbrirConfiguracionVista()
    {
        _viewDraft = _viewSettings.Select(c => new PagosViewColumnDto { Key = c.Key, Label = c.Label, Visible = c.Visible, Order = c.Order }).ToList();
        _showViewSettings = true;
    }

    private void CancelarConfiguracionVista()
    {
        if (!_savingViewSettings)
            _showViewSettings = false;
    }

    private void SetColumnVisibility(string key, bool visible)
    {
        var column = _viewDraft.FirstOrDefault(c => c.Key == key);
        if (column is null)
            return;

        if (!visible && _viewDraft.Count(c => c.Visible) <= 1)
            return;

        column.Visible = visible;
    }

    private void MoveColumn(string key, int delta)
    {
        var ordered = _viewDraft.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => c.Key == key);
        var newIndex = index + delta;
        if (index < 0 || newIndex < 0 || newIndex >= ordered.Count)
            return;

        (ordered[index], ordered[newIndex]) = (ordered[newIndex], ordered[index]);
        for (var i = 0; i < ordered.Count; i++)
            ordered[i].Order = i;

        _viewDraft = ordered;
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        _savingViewSettings = true;
        try
        {
            var settings = new PagosViewSettingsDto { AgruparPor = PagosViewGroupKeys.None, Columnas = _viewDraft };
            await BillingSvc.SavePagosViewSettingsAsync(CurrentUserName(), settings);
            _viewSettings = (await BillingSvc.GetPagosViewSettingsAsync(CurrentUserName())).Columnas;
            _showViewSettings = false;
            _feedback = AppUiMessage.Success("Vista guardada", "Las columnas se guardaron para tu usuario.");
        }
        catch (Exception ex)
        {
            _feedback = AppUiMessage.Error("No se pudo guardar la vista", UserMessage(ex));
        }
        finally
        {
            _savingViewSettings = false;
        }
    }

    private void AbrirRegistrarPago()
    {
        _registrarForm = new RegistrarPagoManualRequest { Moneda = MonedaValores.Ars, MedioPago = MedioPagoValores.Transferencia };
        _registrarFecha = DateTime.Today;
        _cargosDelCliente.Clear();
        _registrarError = string.Empty;
        _showRegistrarPago = true;
    }

    private void CancelarRegistrarPago()
    {
        if (!_registrando)
            _showRegistrarPago = false;
    }

    private async Task OnClienteSeleccionadoAsync(string? idCliente)
    {
        _registrarForm.IdCliente = idCliente ?? string.Empty;
        _registrarForm.IdCargo = 0;
        _cargosDelCliente.Clear();

        if (string.IsNullOrWhiteSpace(_registrarForm.IdCliente))
            return;

        try
        {
            var pendientes = await BillingSvc.SearchCargosAsync(new CargosFilters { IdCliente = _registrarForm.IdCliente, Estado = CargoEstados.Pendiente, PageSize = 100 });
            var vencidos = await BillingSvc.SearchCargosAsync(new CargosFilters { IdCliente = _registrarForm.IdCliente, Estado = CargoEstados.Vencido, PageSize = 100 });
            _cargosDelCliente.AddRange(pendientes.Items);
            _cargosDelCliente.AddRange(vencidos.Items);
        }
        catch (Exception ex)
        {
            _registrarError = UserMessage(ex);
        }
    }

    private async Task ConfirmarRegistrarPagoAsync()
    {
        _registrarError = string.Empty;

        if (string.IsNullOrWhiteSpace(_registrarForm.IdCliente))
        {
            _registrarError = "Elegí un cliente.";
            return;
        }

        if (_registrarForm.IdCargo <= 0)
        {
            _registrarError = "Elegí un cargo.";
            return;
        }

        _registrando = true;
        try
        {
            _registrarForm.Fecha = _registrarFecha;
            await BillingSvc.RegistrarPagoManualAsync(_registrarForm, CurrentUserName());

            _showRegistrarPago = false;
            _feedback = AppUiMessage.Success("Pago registrado", "El pago quedó aprobado y el cargo se marcó como pagado.");
            await BuscarAsync(resetPage: true);
        }
        catch (Exception ex)
        {
            _registrarError = UserMessage(ex);
        }
        finally
        {
            _registrando = false;
        }
    }
}
