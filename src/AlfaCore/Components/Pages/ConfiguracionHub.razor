@page "/configuracion"
@page "/{idweb}/{idbase:int}/configuracion"
@implements IDisposable
@inject AlfaCore.Services.IMenuService MenuSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject NavigationManager Nav
@using AlfaCore.Services

<PageTitle>Configuración | Alfa Gestión</PageTitle>

@* Punto de entrada único a la configuración del sistema (2026-10-05). Cada módulo sigue siendo dueño de
   su pantalla; acá se listan todas, agrupadas y con buscador (ConfiguracionCatalogo). *@

<div class="hub-page">
    <div class="hub">
        <header class="hub__header">
            <div>
                <h2>Configuración</h2>
                <p>Todas las configuraciones del sistema a las que tenés acceso, en un solo lugar.</p>
            </div>
        </header>

        @if (Resultados.Count == 0)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin resultados"
                            Message="@($"No encontramos configuraciones para «{_texto}». Probá con otra palabra.")" />
        }
        else
        {
            @foreach (var area in ConfiguracionCatalogo.Areas)
            {
                var entradas = Resultados.Where(e => e.Area == area).ToList();
                if (entradas.Count == 0)
                {
                    continue;
                }

                <section class="hub__area" aria-label="@area">
                    <h3>@area</h3>
                    <div class="hub__grid">
                        @foreach (var entrada in entradas)
                        {
                            <a class="hub__card @(entrada.Principal ? "is-main" : null)" href="@RouteContext.BuildRoute(entrada.Ruta)">
                                <i class="bi @entrada.Icono" aria-hidden="true"></i>
                                <span class="hub__card-text">
                                    <strong>@entrada.Titulo</strong>
                                    <span>@entrada.Descripcion</span>
                                </span>
                            </a>
                        }
                    </div>
                </section>
            }
        }
    </div>
</div>

@code {
    private PageHeaderConfig? _pageHeaderPublicado;

    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarQuery { get; set; }

    private string _texto = string.Empty;
    private string _area = string.Empty;
    private bool _filtrosAbiertos;
    private IReadOnlyList<ConfiguracionEntrada> _visibles = ConfiguracionCatalogo.Entradas;

    private bool EsDirecto => Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("directo",out var v) && v.ToString() == "1";
    private IReadOnlyList<ConfiguracionEntrada> Resultados => ConfiguracionCatalogo.Buscar(_visibles.Where(e => (!EsDirecto || e.Modulo == "configuracion") && (string.IsNullOrEmpty(_area) || e.Area == _area)), _texto);

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    protected override async Task OnParametersSetAsync()
    {
        _texto = BuscarQuery ?? string.Empty;
        try
        {
            var modulos = await MenuSvc.GetModulesAsync();
            var rutas = await MenuSvc.GetSearchItemsAsync();
            _visibles = ConfiguracionCatalogo.Visibles(modulos.Select(m => m.RutaWeb), rutas.Select(r => r.RutaWeb));
        }
        catch
        {
            // Sin menú dinámico se listan todas: cada pantalla aplica su propio control de acceso.
            _visibles = ConfiguracionCatalogo.Entradas;
        }
        UpdatePageHeader();
    }

    private void OnTextoChanged(string? value) { _texto = value ?? string.Empty; UpdatePageHeader(); }

    private void UpdatePageHeader()
        => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "configuracion",
            Title = "Configuración",
            Search = new PageHeaderSearchConfig(),
            SearchContent = RenderBusqueda()
        });

    private void AlternarFiltros() { _filtrosAbiertos = !_filtrosAbiertos; UpdatePageHeader(); }
    private void CambiarArea(string? value) { _area = value ?? ""; UpdatePageHeader(); }
    private RenderFragment RenderBusqueda() => @<div class="smart-search" @onclick:stopPropagation>
        <div class="smart-search__bar @(_filtrosAbiertos ? "is-open" : "")">
            <span class="smart-search__search-icon"><i class="bi bi-search"></i></span>
            <button type="button" class="smart-search__filter-button" aria-label="Filtrar configuraciones" aria-expanded="@_filtrosAbiertos" @onclick="AlternarFiltros"><i class="bi bi-funnel-fill"></i></button>
            @if (!string.IsNullOrEmpty(_area)) { <button type="button" class="smart-search__active-filter" @onclick='() => CambiarArea("")'>@_area ×</button> }
            <input type="search" aria-label="Buscar configuración" placeholder="Buscar opción, módulo o palabra clave…" value="@_texto" @oninput="e => OnTextoChanged(e.Value?.ToString())" />
            <button type="button" class="smart-search__toggle" aria-label="Mostrar filtros de configuración" @onclick="AlternarFiltros"><i class="bi bi-caret-down-fill"></i></button>
        </div>
        @if (_filtrosAbiertos)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="AlternarFiltros"></button>
            <div class="smart-search__panel smart-search__panel--compact" @onclick:stopPropagation>
                <div class="smart-search__column"><h4>Área</h4>
                    <AlfaSelect Label="Área de configuración" Value="@_area" ValueChanged="CambiarArea" Options="@(new List<AlfaSelectOption> { new("", "Todas") }.Concat(ConfiguracionCatalogo.Areas.Select(a => new AlfaSelectOption(a,a))).ToList())" />
                </div>
                <div class="smart-search__actions"><AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick='() => { _texto=""; _area=""; _filtrosAbiertos=false; UpdatePageHeader(); }'>Limpiar</AlfaButton><AlfaButton OnClick="AlternarFiltros">Aplicar</AlfaButton></div>
            </div>
        }
    </div>;

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }
}
