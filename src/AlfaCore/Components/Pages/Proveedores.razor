@page "/compras/proveedores"
@page "/{idweb}/{idbase:int}/compras/proveedores"
@inject AlfaCore.Services.IComprasDashboardService DashboardService
@inject AlfaCore.Services.FilterStateService FilterState
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Proveedores | Compras</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Proveedores</h2>
            <p>Tablero de compras por proveedor para analizar gasto, concentración y variación contra el período anterior.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudieron cargar los datos" Message="@_error" />
    }
    else if (_loading)
    {
        <AlfaEmptyState Title="Cargando" Message="Buscando datos del período." />
    }
    else
    {
        <section class="kpi-grid">
            <article class="kpi-card"><div class="kpi-card__label">Total comprado</div><div class="kpi-card__value">@FmtMoney(_page.Kpis.TotalComprado)</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Proveedores activos</div><div class="kpi-card__value">@_page.Kpis.ProveedoresActivos.ToString("N0")</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Top proveedor</div><div class="kpi-card__value">@Display(_page.Kpis.TopProveedorNombre)</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Concentración top 5</div><div class="kpi-card__value">@_page.Kpis.ConcentracionTop5.ToString("P1", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</div></article>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Proveedores del período</h3>
                    <p class="panel-card__subtitle">@_page.Proveedores.Count registro(s) consolidados.</p>
                </div>
            </div>

            <div class="usuarios-table-wrap">
                <table class="data-table usuarios-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th>Cuenta</th>
                            <th>Proveedor</th>
                            <th>Total comprado</th>
                            <th>Participación</th>
                            <th>Comprobantes</th>
                            <th>Ticket promedio</th>
                            <th>Última compra</th>
                            <th>Variación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _page.Proveedores)
                        {
                            <tr>
                                <td>@item.Cuenta</td>
                                <td>@item.RazonSocial</td>
                                <td>@FmtMoney(item.TotalComprado)</td>
                                <td>@item.Participacion.ToString("P1", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td>
                                <td>@item.CantidadComprobantes.ToString("N0")</td>
                                <td>@FmtMoney(item.TicketPromedio)</td>
                                <td>@FmtDate(item.UltimaCompra)</td>
                                <td>@FmtPercent(item.VariacionVsAnterior)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private DashboardFilters _filters = null!;
    private FilterOptionsDto _options = new();
    private ProveedoresPageDto _page = new();
    private bool _loading = true;
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        _filters = FilterState.Current;
        UpdatePageHeader();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    // Filtros en el Context Toolbar (Smart Search). El fragmento lee _filters/_options al dibujarse:
    // después de cargar las opciones se vuelve a publicar el header.
    private RenderFragment RenderSmartSearch() => @<ComprasSmartSearch Model="_filters" Options="_options" OnApply="LoadAsync" />;

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "compras",
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCompras(RouteContext, Nav, "proveedores")
    });

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Current;
        try
        {
            _options = await DashboardService.GetFilterOptionsAsync();
            UpdatePageHeader();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        try
        {
            _page = await DashboardService.GetProveedoresPageDataAsync(_filters);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FmtMoney(decimal value)
        => value.ToString("$ #,##0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static string FmtDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "—";

    private static string FmtPercent(decimal? value)
        => value.HasValue ? value.Value.ToString("P1", System.Globalization.CultureInfo.GetCultureInfo("es-AR")) : "—";

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
}
