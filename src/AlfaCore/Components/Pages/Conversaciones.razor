    private async Task StopAndUploadAudioAsync()
    {
        _recording = false;
        _uploadingAudio = true;
        _actionMessage = null;
        _actionError = null;

        try
        {
            var fileName = $"audio_{DateTime.Now:yyyyMMdd_HHmmss}";
            var result = await JS.InvokeAsync<RecordedAudioFileResult>("conversacionesAudio.stopRecordingToInput", "conv-file-drop-input", fileName);
            if (!result.Ok)
                _actionError = string.IsNullOrWhiteSpace(result.Message)
                    ? "No se pudo preparar el audio grabado."
                    : result.Message;
        }
