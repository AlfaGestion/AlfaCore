    private IReadOnlyList<ConversacionInboxItemDto> BuildMercadoLibreInboxGroups()
    {
        return _inbox
            .GroupBy(GetMercadoLibreGroupKey, StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var ordered = group
                    .OrderByDescending(x => x.FechaHoraUltimoMensaje)
                    .ThenByDescending(x => x.IdConversacion)
                    .ToList();
                var latest = ordered[0];
                return new ConversacionInboxItemDto
                {
                    IdConversacion = latest.IdConversacion,
                    Canal = latest.Canal,
                    TelefonoWhatsApp = latest.TelefonoWhatsApp,
                    NombreVisible = latest.NombreVisible,
                    UsuarioExterno = latest.UsuarioExterno,
                    FotoPerfilUrl = latest.FotoPerfilUrl,
                    PerfilExternoVerificado = latest.PerfilExternoVerificado,
                    ClienteCodigo = latest.ClienteCodigo,
                    ClienteNombre = latest.ClienteNombre,
                    IdContacto = latest.IdContacto,
                    ContactoNombre = latest.ContactoNombre,
                    CodigoEstado = latest.CodigoEstado,
                    EstadoDescripcion = latest.EstadoDescripcion,
                    IdTecnico = latest.IdTecnico,
                    TecnicoNombre = latest.TecnicoNombre,
                    ResumenUltimoMensaje = latest.ResumenUltimoMensaje,
                    DireccionUltimoMensaje = latest.DireccionUltimoMensaje,
                    EstadoUltimoMensaje = latest.EstadoUltimoMensaje,
                    TipoUltimoMensaje = latest.TipoUltimoMensaje,
                    FechaHoraUltimoMensaje = latest.FechaHoraUltimoMensaje,
                    FechaHoraUltimoMensajeCliente = ordered
                        .Where(x => x.FechaHoraUltimoMensajeCliente.HasValue)
                        .Select(x => x.FechaHoraUltimoMensajeCliente)
                        .OrderByDescending(x => x)
                        .FirstOrDefault(),
                    IdUltimoMensajeCliente = latest.IdUltimoMensajeCliente,
                    CantidadMensajesCliente = ordered.Sum(x => x.CantidadMensajesCliente),
                    MensajesNoLeidosUsuario = ordered.Sum(x => x.MensajesNoLeidosUsuario),
                    VentanaWhatsAppActiva = latest.VentanaWhatsAppActiva,
                    FechaHoraVencimientoVentanaWhatsApp = latest.FechaHoraVencimientoVentanaWhatsApp,
                    Archivada = ordered.All(x => x.Archivada),
                    Bloqueada = ordered.Any(x => x.Bloqueada),
                    FijadaPorUsuario = ordered.Any(x => x.FijadaPorUsuario),
                    FechaHoraFijada = ordered
                        .Where(x => x.FechaHoraFijada.HasValue)
                        .Select(x => x.FechaHoraFijada)
                        .OrderByDescending(x => x)
                        .FirstOrDefault()
                };
            })
            .OrderByDescending(x => x.FijadaPorUsuario)
            .ThenByDescending(x => x.FechaHoraFijada ?? DateTime.MinValue)
            .ThenByDescending(x => x.FechaHoraUltimoMensaje)
            .ToList();
    }

