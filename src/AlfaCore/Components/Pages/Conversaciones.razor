    private static List<ConversacionMensajeDto> OrderConversationMessages(IEnumerable<ConversacionMensajeDto> messages)
        => messages
            .OrderBy(x => x.FechaHora == DateTime.MinValue ? DateTime.MaxValue : x.FechaHora)
            .ThenBy(x => x.IdMensaje)
            .ToList();

    private void ApplyConversationMessagesPage(
        ConversacionMensajesPaginaDto page,
        IReadOnlyList<ConversacionAdjuntoDto> attachments)
    {
        _messages = OrderConversationMessages(page.Messages);
        _adjuntosPorMensaje = GroupAttachmentsByMessage(attachments);
        _conversationTotalMessageCount = Math.Max(page.TotalMessages, _messages.Count);
        _hasMoreOlderMessages = page.HasMoreBefore;
    }

    private void PrependConversationMessagesPage(
        ConversacionMensajesPaginaDto page,
        IReadOnlyList<ConversacionAdjuntoDto> attachments)
    {
        if (page.Messages.Count > 0)
        {
            _messages = OrderConversationMessages(_messages.Concat(page.Messages));
            foreach (var attachment in attachments)
            {
                if (!_adjuntosPorMensaje.TryGetValue(attachment.IdMensaje, out var list))
                {
                    list = [];
                    _adjuntosPorMensaje[attachment.IdMensaje] = list;
                }

                if (list.All(existing => existing.IdAdjunto != attachment.IdAdjunto))
                    list.Add(attachment);
            }
        }

        _conversationTotalMessageCount = Math.Max(page.TotalMessages, _messages.Count);
        _hasMoreOlderMessages = page.HasMoreBefore;
    }

    private static Dictionary<long, List<ConversacionAdjuntoDto>> GroupAttachmentsByMessage(IEnumerable<ConversacionAdjuntoDto> attachments)
        => attachments
            .GroupBy(a => a.IdMensaje)
            .ToDictionary(g => g.Key, g => g.ToList());

    private static string FormatShortDate(DateTime value)
    {
        if (value == DateTime.MinValue)
            return "--";

        var date = value.Date;
        var today = DateTime.Today;
        var time = value.ToString("HH:mm", System.Globalization.CultureInfo.CurrentCulture);

        if (date == today)
            return $"Hoy {time}";

        if (date == today.AddDays(-1))
            return $"Ayer {time}";

        return value.ToString("dd/MM HH:mm", System.Globalization.CultureInfo.CurrentCulture);
    }

    private static string FormatConversationDateDivider(DateTime value)
    {
        if (value == DateTime.MinValue)
            return string.Empty;

        var date = value.Date;
        var today = DateTime.Today;

        if (date == today)
            return "Hoy";

        if (date == today.AddDays(-1))
            return "Ayer";

        return value.ToString("dddd d 'de' MMMM", System.Globalization.CultureInfo.CurrentCulture);
    }

