    /// <summary>
    /// Técnicos para el combo "Asignar a": si la conversación tiene un número de WhatsApp propio
    /// con usuarios vinculados, se filtra a esos usuarios (salvo administrador de conversaciones,
    /// que ve la lista completa). Sin número fijado, sin usuarios vinculados, o sin poder resolver
    /// nada de esto, se muestra la lista completa como siempre.
    /// </summary>
    private IReadOnlyList<ConversacionTecnicoOptionDto> GetAssignableTechnicians()
    {
        if (_esAdministradorConversaciones || _selectedConversation?.IdNumeroWhatsApp is not int idNumero)
            return _technicians;

        var numero = _whatsappNumeros.FirstOrDefault(n => n.IdNumero == idNumero);
        if (numero is null || numero.Usuarios.Count == 0)
            return _technicians;

        var usuariosDelNumero = new HashSet<string>(numero.Usuarios, StringComparer.OrdinalIgnoreCase);
        var filtrados = _technicians.Where(t => usuariosDelNumero.Contains(t.UsuarioAsociado ?? string.Empty)).ToList();
        return filtrados.Count > 0 ? filtrados : _technicians;
    }

