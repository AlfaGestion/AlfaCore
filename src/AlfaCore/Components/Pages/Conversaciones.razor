    private async Task RequestAiSuggestionAsync(
        string? instruction = null,
        IReadOnlyList<AlfaKnowledgeAssistantMessage>? assistantHistory = null)
    {
        if (!_showAiSuggestionPanel
            || _selectedConversation is null
            || _selectedConversationId is not { } conversationId)
        {
            return;
        }

        _aiSuggestionError = null;

        if (!AlfaKnowledgeSvc.IsConfigured)
        {
            _aiSuggestion = null;
            _aiSuggestionConversationId = conversationId;
            _aiSuggestionError = "AlfaKnowledge no está configurado en este servidor.";
            return;
        }

        var contextMessages = GetAiContextMessages();
        var imageCandidate = GetAiImageCandidate(contextMessages);
        var focusMessage = string.Equals(_aiContextScope, AiContextScopes.FocusedMessage, StringComparison.Ordinal)
            ? GetAiFocusedMessage()
            : contextMessages
                .Where(IsIncomingMessage)
                .Where(message => !string.IsNullOrWhiteSpace(message.Texto))
                .OrderByDescending(message => message.FechaHora)
                .FirstOrDefault();

        focusMessage ??= imageCandidate?.Message;

        if (focusMessage is null && !string.IsNullOrWhiteSpace(instruction))
        {
            focusMessage = contextMessages
                .Where(CanUseMessageAsAiFocus)
                .OrderByDescending(message => message.FechaHora)
                .FirstOrDefault();
        }

        if (focusMessage is null)
        {
            _aiSuggestion = null;
            _aiSuggestionConversationId = conversationId;
            _aiSuggestionError = string.Equals(_aiContextScope, AiContextScopes.FocusedMessage, StringComparison.Ordinal)
                ? "Marcá un mensaje de texto o una imagen para usarlo como foco."
                : "El contexto elegido no tiene texto ni imágenes para analizar.";
            return;
        }

        CancelAiSuggestionRequest();
        var requestCts = new CancellationTokenSource();
        _aiSuggestionRequestCts = requestCts;
        _loadingAiSuggestion = true;
        _aiSuggestion = null;
        _aiSuggestionConversationId = conversationId;
        var customerMessage = string.IsNullOrWhiteSpace(focusMessage.Texto)
            ? "El cliente envió una imagen con un error o una pantalla para analizar."
            : focusMessage.Texto.Trim();
        _aiSuggestionOriginalQuestion = customerMessage;
        StateHasChanged();

        try
        {
            var image = imageCandidate is null
                ? null
                : await BuildAiImageInputAsync(imageCandidate.Value.Attachment, requestCts.Token);
            var result = await AlfaKnowledgeSvc.SuggestReplyAsync(
                customerMessage,
                contextMessages,
                conversationId,
                AlfaKnowledgeSuggestionModes.ReplySuggestion,
                instruction,
                assistantHistory,
                image,
                null,
                requestCts.Token);

            if (requestCts.IsCancellationRequested
                || !_showAiSuggestionPanel
                || !ReferenceEquals(_aiSuggestionRequestCts, requestCts))
            {
                return;
            }

            _aiSuggestion = result;
            if (_aiSuggestion is not null
                && image is not null
                && (IsGenericImageQuestion(_aiSuggestionOriginalQuestion)
                    || !string.IsNullOrWhiteSpace(_aiSuggestion.ImageContext)))
            {
                var visualQuestion = !string.IsNullOrWhiteSpace(_aiSuggestion.ImageContext)
                    ? _aiSuggestion.ImageContext
                    : ExtractVisibleErrorFromSuggestion(_aiSuggestion.SuggestedReply);
                if (!string.IsNullOrWhiteSpace(visualQuestion))
                {
                    _aiSuggestionOriginalQuestion = visualQuestion.Trim();
                }
            }

            if (_aiSuggestion is null)
            {
                _aiSuggestionError = "AlfaKnowledge no respondió o no pudo analizar este contexto.";
            }
            else if (image is not null && !_aiSuggestion.ImageAnalyzed)
            {
                _aiSuggestionError = "La imagen no llegó a AlfaKnowledge. Reintentá luego de actualizar el servicio.";
                _aiSuggestion = null;
            }
            else if (!string.IsNullOrWhiteSpace(instruction))
            {
                _aiChatHistory.Add(new AlfaKnowledgeAssistantMessage
                {
                    Role = "assistant",
                    Content = !string.IsNullOrWhiteSpace(_aiSuggestion.SuggestedReply)
                        ? _aiSuggestion.SuggestedReply
                        : _aiSuggestion.ClarificationQuestion ?? "No pude responder con el contexto disponible."
                });
            }
        }
        catch (OperationCanceledException) when (requestCts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            _aiSuggestion = null;
            _aiSuggestionError = ex is AlfaCore.Services.AppUserFacingException
                ? ex.Message
                : "No se pudo consultar AlfaKnowledge para este contexto.";
        }
        finally
        {
            if (ReferenceEquals(_aiSuggestionRequestCts, requestCts))
            {
                _aiSuggestionRequestCts = null;
                _loadingAiSuggestion = false;
                StateHasChanged();
            }

            requestCts.Dispose();
        }
    }

    private void CancelAiSuggestionRequest()
    {
        if (_aiSuggestionRequestCts is null)
        {
            return;
        }

        _aiSuggestionRequestCts.Cancel();
        _aiSuggestionRequestCts = null;
        _loadingAiSuggestion = false;
    }

    private async Task SendAiInstructionAsync()
    {
        var instruction = _aiInstruction.Trim();
        if (string.IsNullOrWhiteSpace(instruction) || _loadingAiSuggestion)
        {
            return;
