    private static async Task AddFilesToPendingAttachmentsAsync(IReadOnlyList<IBrowserFile> files, List<PendingAttachment> target, string? forcedType = null)
    {
        const long maxSize = 25 * 1024 * 1024;
        foreach (var file in files)
        {
            if (file.Size == 0)
                continue;

            await using var stream = file.OpenReadStream(maxSize);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var content = buffer.ToArray();

            target.Add(new PendingAttachment
            {
                NombreArchivo = file.Name,
                MimeType = file.ContentType,
                TipoArchivo = string.IsNullOrWhiteSpace(forcedType) ? InferTipoArchivo(file.ContentType) : forcedType,
                Contenido = content,
                TamanoBytes = file.Size,
                PreviewDataUrl = BuildPendingPreviewDataUrl(file.ContentType, content, forcedType)
            });
        }
    }

    private static string? BuildPendingPreviewDataUrl(string mimeType, byte[] content, string? forcedType)
    {
        var type = string.IsNullOrWhiteSpace(forcedType) ? InferTipoArchivo(mimeType) : forcedType;
        if (!string.Equals(type, "IMAGE", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(type, "STICKER", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var safeMime = string.IsNullOrWhiteSpace(mimeType) || !mimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
            ? "image/png"
            : mimeType;
        return $"data:{safeMime};base64,{Convert.ToBase64String(content)}";
    }

    private static List<PreparingAttachment> BuildPreparingAttachments(IEnumerable<IBrowserFile> files, string? forcedType = null)
        => files
            .Where(file => file.Size > 0)
            .Select(file => new PreparingAttachment
            {
                NombreArchivo = file.Name,
                TipoArchivo = string.IsNullOrWhiteSpace(forcedType) ? InferTipoArchivo(file.ContentType) : forcedType
            })
            .ToList();

    private static bool CanPreviewPendingAttachment(PendingAttachment attachment)
        => !string.IsNullOrWhiteSpace(attachment.PreviewDataUrl);

