    private IReadOnlyList<ConversacionMensajeDto> GetAiContextMessages()
    {
        var ordered = _messages
            .OrderBy(message => message.FechaHora)
            .ThenBy(message => message.IdMensaje)
            .ToList();

        if (string.Equals(_aiContextScope, AiContextScopes.FocusedMessage, StringComparison.Ordinal))
        {
            var focused = GetAiFocusedMessage();
            return focused is null ? [] : [focused];
        }

        if (string.Equals(_aiContextScope, AiContextScopes.EntireConversation, StringComparison.Ordinal))
        {
            return ordered;
        }

        var closureIndexes = ordered
            .Select((message, index) => new { message, index })
            .Where(item => IsConversationClosureEvent(item.message))
            .Select(item => item.index)
            .ToList();

        var startIndex = 0;
        var endIndex = ordered.Count;
        if (IsSelectedConversationClosed && closureIndexes.Count > 0)
        {
            endIndex = closureIndexes[^1];
            startIndex = closureIndexes.Count > 1 ? closureIndexes[^2] + 1 : 0;
        }
        else if (closureIndexes.Count > 0)
        {
            startIndex = closureIndexes[^1] + 1;
        }

        var currentCycle = ordered
            .Skip(startIndex)
            .Take(Math.Max(0, endIndex - startIndex))
            .ToList();

        return currentCycle.Any(CanUseMessageAsAiFocus) ? currentCycle : ordered;
    }

    private ConversacionMensajeDto? GetAiFocusedMessage()
        => _aiFocusedMessageId is { } messageId
            ? _messages.FirstOrDefault(message => message.IdMensaje == messageId)
            : null;

    private static bool CanUseMessageAsAiFocus(ConversacionMensajeDto message)
        => (IsIncomingMessage(message) || IsOutgoingMessage(message))
           && !string.IsNullOrWhiteSpace(message.Texto);

    private static bool IsConversationClosureEvent(ConversacionMensajeDto message)
    {
        if (!IsInternalEventMessage(message) || string.IsNullOrWhiteSpace(message.Texto))
        {
            return false;
        }

        var text = message.Texto.Trim();
        return text.Contains("cerró la conversación", StringComparison.OrdinalIgnoreCase)
               || text.Contains("conversación cerrada", StringComparison.OrdinalIgnoreCase);
    }

    private string GetAiContextDescription()
    {
        var count = GetAiContextMessages().Count(CanUseMessageAsAiFocus);
        var sentCount = count > 60 ? $"los últimos 60 de {count}" : count.ToString();
        return _aiContextScope switch
        {
            AiContextScopes.FocusedMessage => "La IA leerá únicamente el mensaje marcado.",
            AiContextScopes.EntireConversation => $"La IA recibirá {sentCount} mensajes de texto cargados en este hilo.",
            _ => $"La IA recibirá {sentCount} mensajes del tramo abierto desde el último cierre detectado."
        };
    }

    private static string GetAiMessagePreview(ConversacionMensajeDto message)
    {
