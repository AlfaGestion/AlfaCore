    /// <summary>
    /// Busca solo entre los mensajes ya cargados en el hilo (no dispara "Leer más" automáticamente
    /// si el mensaje buscado está en historial todavía no traído).
    /// </summary>
    private void RecomputeMessageSearchMatches()
    {
        var term = _messageSearchText.Trim();
        if (term.Length == 0)
        {
            _messageSearchMatchIds = [];
            _messageSearchActiveIndex = -1;
            return;
        }

        _messageSearchMatchIds = VisibleMessages
            .Where(m => !IsInternalEventMessage(m) && m.Texto.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Select(m => m.IdMensaje)
            .ToList();

        if (_messageSearchActiveIndex >= _messageSearchMatchIds.Count)
            _messageSearchActiveIndex = _messageSearchMatchIds.Count > 0 ? 0 : -1;
    }

    private async Task GoToNextMessageMatchAsync()
    {
        if (_messageSearchMatchIds.Count == 0)
            return;

        _messageSearchActiveIndex = (_messageSearchActiveIndex + 1) % _messageSearchMatchIds.Count;
        await ScrollToActiveMessageMatchAsync();
    }

    private async Task GoToPreviousMessageMatchAsync()
    {
        if (_messageSearchMatchIds.Count == 0)
            return;

        _messageSearchActiveIndex = _messageSearchActiveIndex <= 0
            ? _messageSearchMatchIds.Count - 1
            : _messageSearchActiveIndex - 1;
        await ScrollToActiveMessageMatchAsync();
    }

