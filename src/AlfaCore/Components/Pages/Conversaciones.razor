    private void AddParteHoraLinea()
    {
        var previous = _parteHoraLineas.LastOrDefault();
        _parteHoraLineas.Add(new ParteHoraConversacionLinea
        {
            IdTecnico = previous?.IdTecnico ?? CurrentMessageTechnicianId,
            TipoTrabajo = previous?.TipoTrabajo ?? _parteHoraTipo,
            Horas = 0,
            Minutos = 1
        });
    }

    private void RemoveParteHoraLinea(int index)
    {
        if (_parteHoraLineas.Count <= 1 || index < 0 || index >= _parteHoraLineas.Count)
            return;

        _parteHoraLineas.RemoveAt(index);
    }

    private Task HandleParteHoraLineaKeyDownAsync(KeyboardEventArgs args, int index)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return InsertParteHoraLineaAfterAsync(index);

        return Task.CompletedTask;
    }

    private Task InsertParteHoraLineaAfterAsync(int index)
    {
        var previous = index >= 0 && index < _parteHoraLineas.Count ? _parteHoraLineas[index] : _parteHoraLineas.LastOrDefault();
        var nueva = new ParteHoraConversacionLinea
        {
            IdTecnico = previous?.IdTecnico ?? CurrentMessageTechnicianId,
            TipoTrabajo = previous?.TipoTrabajo ?? _parteHoraTipo,
            Horas = 0,
            Minutos = 1
        };

        if (index < 0 || index >= _parteHoraLineas.Count - 1)
            _parteHoraLineas.Add(nueva);
        else
            _parteHoraLineas.Insert(index + 1, nueva);

        _pendingParteHoraLineaDescripcionFocusIndex = Math.Min(index + 1, _parteHoraLineas.Count - 1);
        return Task.CompletedTask;
    }

