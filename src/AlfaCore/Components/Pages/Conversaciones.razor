    private bool NavigateToConversationUrl(long idConversacion)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var values = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var item in QueryHelpers.ParseQuery(uri.Query))
            values[item.Key] = item.Value.ToString();

        values["id"] = idConversacion.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var target = QueryHelpers.AddQueryString(uri.AbsolutePath, values);
        if (string.Equals(Nav.ToBaseRelativePath(Nav.Uri), target.TrimStart('/'), StringComparison.Ordinal))
            return false;

        Nav.NavigateTo(target);
        return true;
    }

    private async Task LoadConversationAsync(long idConversacion, bool showLoading, bool clearActionState)
    {
        var conversationChanged = _selectedConversationId != idConversacion;
        _selectedConversationId = idConversacion;
        if (conversationChanged)
        {
            _replyText = string.Empty;
            _syncReplyTextAfterRender = true;
            ResetAiConversation(clearFocus: true);
        }

        var hasWarmCache = _conversationCache.TryGetValue(idConversacion, out var cachedConversation);

        if (hasWarmCache && cachedConversation is not null)
        {
            ApplyConversationCache(idConversacion, cachedConversation, showLoading || clearActionState || conversationChanged);
            showLoading = false;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (clearActionState && IsConversationCacheFresh(cachedConversation))
            {
                QueueContextTicketsLoad();
                QueueContextNotesLoad();
                return;
            }
        }

        if (showLoading)
        {
            _loadingConversation = true;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
        }

        _conversationError = null;
        if (clearActionState)
        {
            _actionMessage = null;
            _actionError = null;
        }

        try
        {
            var conversationTask = ConversacionesSvc.GetConversationAsync(idConversacion);
            var typingTask = ConversacionesSvc.GetTypingAsync(idConversacion, _typingClientId);
            var pageSize = conversationChanged || clearActionState
                ? ConversationMessagePageSize
                : Math.Max(ConversationMessagePageSize, _messages.Count);
            var messagesTask = ConversacionesSvc.GetMessagesPageAsync(idConversacion, pageSize);

            await Task.WhenAll(conversationTask, messagesTask, typingTask);

            _selectedConversation = await conversationTask;
            RefreshSelectedMercadoLibreGroup();
            if (conversationChanged || clearActionState || !_editingConversationName)
            {
                _editingConversationName = false;
                _savingConversationName = false;
                _conversationNameDraft = _selectedConversation is null ? string.Empty : GetConversationHeader(_selectedConversation);
            }
            var messagesPage = await messagesTask;
            var messageIds = messagesPage.Messages
                .Select(x => x.IdMensaje)
                .Distinct()
                .ToArray();
            var adjuntos = messageIds.Length == 0
                ? []
                : await ConversacionesSvc.GetMessageAttachmentsAsync(idConversacion, messageIds);
            ApplyConversationMessagesPage(messagesPage, adjuntos);
            _typingUsers = (await typingTask).ToList();

            StoreConversationCache(idConversacion);
            if (ShouldRecoverConversationAttachments(_messages, adjuntos))
                QueueConversationAttachmentRecovery(idConversacion);
            _assignmentTechnicianId = _selectedConversation?.IdTecnico ?? string.Empty;
            _statusCode = _selectedConversation?.CodigoEstado ?? (_states.FirstOrDefault()?.CodigoEstado ?? "ABIERTA");

            if (showLoading || clearActionState || conversationChanged)
            {
                ClearNewMessageState();
                _showReturnToLatest = false;
                _scrollThreadToBottomAfterRender = true;
                _threadAnchoringToBottom = true;
                _focusReplyAfterRender = true;
                _scrollHandlerConversationId = null;
                RestoreSelectedNewMessageMarker(idConversacion);
                MarkSelectedConversationAsRead();
            }

            if (IsWhatsAppConversation)
            {
                if (conversationChanged)
                    _templateValuesText = string.Empty;
            }
            else
            {
                ClearTemplateSelection();
            }

            if (showLoading)
            {
                _loadingConversation = false;
                await InvokeAsync(StateHasChanged);
                await Task.Yield();
                showLoading = false;
            }

            QueueContextTicketsLoad();
            QueueContextNotesLoad();
        }
        catch (Exception ex)
        {
            _conversationError = ex.Message;
            _selectedConversation = null;
            _messages = [];
            _typingUsers = [];
            _adjuntosPorMensaje = [];
            _hasMoreOlderMessages = false;
            _conversationTotalMessageCount = 0;
            ClearContextNotesState();
        }
        finally
        {
            if (showLoading)
                _loadingConversation = false;
        }
    }

    private void QueueConversationAttachmentRecovery(long idConversacion)
    {
        if (!_recoveredAttachmentConversations.Add(idConversacion))
            return;

        if (!_recoveringAttachmentConversations.Add(idConversacion))
            return;

        _ = RecoverConversationAttachmentsInBackgroundAsync(idConversacion);
    }

    private static bool ShouldRecoverConversationAttachments(
        IReadOnlyList<ConversacionMensajeDto> messages,
        IReadOnlyList<ConversacionAdjuntoDto> attachments)
    {
        if (attachments.Any(x => !x.ArchivoDisponible && x.PuedeRecuperarse))
            return true;

        return messages.Any(message =>
            !message.TieneAdjuntos
            && IsRecentRecoverableMediaMessage(message)
            && IsGeneratedMediaFileName(message.Texto.Trim(), message.MessageType));
    }

    private static bool IsRecentRecoverableMediaMessage(ConversacionMensajeDto message)
    {
        if (message.FechaHora == DateTime.MinValue)
            return false;

        var age = DateTime.Now - message.FechaHora;
        return age >= TimeSpan.Zero && age <= TimeSpan.FromDays(30);
    }

    private async Task RecoverConversationAttachmentsInBackgroundAsync(long idConversacion)
    {
        var hadRecoveryProgress = false;
        try
        {
            var recovery = await ConversacionesSvc.RecoverConversationAttachmentsAsync(idConversacion);
            hadRecoveryProgress = recovery.MensajesHidratados > 0 || recovery.AdjuntosRecuperados > 0;
            if (recovery.MensajesHidratados <= 0 && recovery.AdjuntosRecuperados <= 0)
                return;

            await InvokeAsync(async () =>
            {
                if (_selectedConversationId != idConversacion)
                    return;

                var pageSize = Math.Max(ConversationMessagePageSize, _messages.Count);
                var page = await ConversacionesSvc.GetMessagesPageAsync(idConversacion, pageSize);
                var messageIds = page.Messages
                    .Select(x => x.IdMensaje)
                    .Distinct()
                    .ToArray();
                var adjuntos = messageIds.Length == 0
                    ? []
                    : await ConversacionesSvc.GetMessageAttachmentsAsync(idConversacion, messageIds);
                ApplyConversationMessagesPage(page, adjuntos);

                StoreConversationCache(idConversacion);
                StateHasChanged();
            });
        }
        catch
        {
        }
        finally
        {
            try
            {
                await InvokeAsync(() => _recoveringAttachmentConversations.Remove(idConversacion));
                if (!hadRecoveryProgress)
                    _recoveredAttachmentConversations.Remove(idConversacion);
            }
            catch
            {
            }
        }
    }

