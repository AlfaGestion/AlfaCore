    private long AddOptimisticOutgoingMessage(string text)
    {
        if (_selectedConversation is null)
            return 0;

        var id = _nextOptimisticMessageId--;
        _messages.Add(new ConversacionMensajeDto
        {
            IdMensaje = id,
            IdConversacion = _selectedConversation.IdConversacion,
            TelefonoWhatsApp = _selectedConversation.TelefonoWhatsApp,
            MessageType = "TEXT",
            Direction = "SALIENTE",
            EstadoEnvio = "PENDIENTE",
            Texto = text,
            FechaHora = DateTime.Now,
