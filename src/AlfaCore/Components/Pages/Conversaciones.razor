    private static string BuildRelatedReason(TicketRelatedMatchDto match)
    {
        var parts = new List<string>();
        if (match.MismaConversacion) parts.Add("misma conversación");
        if (match.MismoContacto) parts.Add("mismo contacto");
        if (match.MismoCliente) parts.Add("mismo cliente");
        if (match.Terminos.Count > 0) parts.Add($"coincide: {string.Join(", ", match.Terminos.Take(3))}");
        return parts.Count == 0 ? "posible relación por texto" : string.Join(" · ", parts);
    }

    private static string BuildContextTicketPreview(TicketRelatedMatchDto match)
    {
        var text = (match.PrimerMensajeTexto ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(text))
            return BuildRelatedReason(match);

        return text.Length <= 120 ? text : $"{text[..120]}...";
    }

