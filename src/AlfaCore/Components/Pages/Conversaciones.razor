    private bool CanSaveAiCorrection
        => !string.IsNullOrWhiteSpace(_aiCorrectionTitle)
           && !string.IsNullOrWhiteSpace(_aiCorrectionQuestion)
           && !string.IsNullOrWhiteSpace(_aiCorrectionAnswer);

    private async Task SaveAiCorrectionAsync()
    {
        if (_aiSuggestion is null || !CanSaveAiCorrection || _savingAiCorrection)
        {
            return;
        }

        _savingAiCorrection = true;
        _aiCorrectionError = null;

        try
        {
            var saved = await AlfaKnowledgeSvc.SaveCorrectionAsync(
                new AlfaKnowledgeCorrectionRequest
                {
                    InteractionId = _aiSuggestion.InteractionId == Guid.Empty
                        ? null
                        : _aiSuggestion.InteractionId,
                    Title = _aiCorrectionTitle.Trim(),
                    OriginalQuestion = _aiCorrectionQuestion.Trim(),
                    OriginalAnswer = _aiSuggestion.SuggestedReply,
                    CorrectedAnswer = _aiCorrectionAnswer.Trim(),
                    SourceReference = _aiSuggestion.Citations
                        .Select(static citation => citation.SourceReference)
                        .FirstOrDefault(static source => !string.IsNullOrWhiteSpace(source)),
                    CorrectionNotes = string.IsNullOrWhiteSpace(_aiCorrectionNotes)
                        ? null
                        : _aiCorrectionNotes.Trim(),
                    CreatedBy = FirstNonEmpty(CurrentUserNameForAudit, "AlfaCore")
                });

            if (!saved)
            {
                _aiCorrectionError = "No se pudo guardar la corrección. Revisá la conexión con AlfaKnowledge e intentá nuevamente.";
                return;
            }

            _aiSuggestion.SuggestedReply = _aiCorrectionAnswer.Trim();
            _showAiCorrectionModal = false;
            _actionMessage = "La respuesta corregida se guardó en AlfaKnowledge.";
        }
        finally
        {
            _savingAiCorrection = false;
        }
    }

    private static string BuildAiCorrectionTitle(string question)
    {
        var normalized = string.IsNullOrWhiteSpace(question)
            ? "respuesta sugerida"
            : question.Trim();
        const int maxQuestionLength = 90;
        if (normalized.Length > maxQuestionLength)
        {
            normalized = $"{normalized[..maxQuestionLength].TrimEnd()}…";
        }

        return $"Corrección: {normalized}";
    }

    private async Task ImproveReplyWithAiAsync()
    {
        if (_improvingReplyWithAi
            || _selectedConversationId is not { } conversationId
            || !AlfaKnowledgeSvc.IsConfigured)
        {
            return;
        }

        var draft = (await GetReplyTextareaValueAsync()).Trim();
        if (string.IsNullOrWhiteSpace(draft))
            return;

        var focusMessage = _messages
            .Where(IsIncomingMessage)
            .Where(static message => !string.IsNullOrWhiteSpace(message.Texto))
            .OrderByDescending(static message => message.FechaHora)
            .FirstOrDefault();
        if (focusMessage is null)
            return;

        _improvingReplyWithAi = true;
        StateHasChanged();

        try
        {
            var instruction =
                "Mejorá únicamente la redacción del siguiente borrador, manteniendo exactamente su intención, " +
                "los datos y el tono profesional cercano. No agregues información, explicaciones, saludos ni " +
                $"contenido nuevo. Devolvé solamente el texto final mejorado. Borrador: {draft}";
            var result = await AlfaKnowledgeSvc.SuggestReplyAsync(
                focusMessage.Texto,
                _messages,
                conversationId,
                AlfaKnowledgeSuggestionModes.TextImprovement,
                instruction,
                null,
                null,
                new AlfaKnowledgeTextImprovementInput
                {
                    TextToImprove = draft
                });

            if (result is null || string.IsNullOrWhiteSpace(result.SuggestedReply))
                return;

            var currentDraft = (await GetReplyTextareaValueAsync()).Trim();
            if (!string.Equals(currentDraft, draft, StringComparison.Ordinal))
                return;

            _replyText = result.SuggestedReply.Trim();
            await SetReplyTextareaValueAsync(_replyText, focus: true);
        }
        catch
        {
        }

        finally
        {
            _improvingReplyWithAi = false;
            StateHasChanged();
        }
    }

    private async Task RegenerateAiSuggestionAsync()
    {
        var lastUserIndex = _aiChatHistory.FindLastIndex(
            static message => string.Equals(message.Role, "user", StringComparison.OrdinalIgnoreCase));
        if (lastUserIndex < 0)
        {
            await RequestAiSuggestionAsync();
            return;
        }

        var instruction = _aiChatHistory[lastUserIndex].Content;
        var previousHistory = _aiChatHistory.Take(lastUserIndex).ToList();
        _aiChatHistory = _aiChatHistory.Take(lastUserIndex + 1).ToList();
        await RequestAiSuggestionAsync(instruction, previousHistory);
    }

