    protected override async Task OnInitializedAsync()
    {
        _floatingWindowRegistration = FloatingWindows.Register(AlfaCore.Services.FloatingWindowType.DropdownMenu, CloseFloatingWindowsAsync);
        Nav.LocationChanged += OnLocationChanged;
        ApplyStartupQuery();
        _ticketsModuloActivo = await AdminSvc.IsModuloActivoParaClienteActualAsync("TICKETS");
        _alfaKnowledgeModuloActivo = await AdminSvc.IsModuloActivoParaClienteActualAsync("ALFAKNOWLEDGE");
        await LoadWhatsAppNumerosAndAdminStatusAsync();
        await Task.WhenAll(LoadLookupsAsync(), LoadFavoriteStickersAsync());
        if (_loadError is null)
        {
            await LoadInboxAsync();
            if (_startupConversationId.HasValue)
                await SelectConversationAsync(_startupConversationId.Value, showMobileChat: true, updateUrl: false);
        }

        StartPolling();
        StartTypingPolling();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(ApplyCurrentLocationAsync);

    private async Task ApplyCurrentLocationAsync()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("id", out var idRaw)
            && long.TryParse(idRaw.ToString(), out var id)
            && id > 0)
        {
            if (_selectedConversationId != id)
                await SelectConversationAsync(id, showMobileChat: true, updateUrl: false);
            return;
        }

        if (_selectedConversationId.HasValue && InboxDisplayItems.Count > 0 && !ShouldKeepAuditResultsOpen)
            await SelectInboxItemAsync(InboxDisplayItems[0]);
        else if (_selectedConversationId.HasValue)
            ClearSelection();
    }

    private void ApplyStartupQuery()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("modo", out var modoRaw))
        {
            var modo = modoRaw.ToString();
            if (_modeOptions.Any(x => string.Equals(x.Value, modo, StringComparison.OrdinalIgnoreCase)))
                _filters.Modo = modo;
        }

        if (query.TryGetValue("estado", out var estadoRaw))
        {
            _filters.CodigoEstado = estadoRaw.ToString();
            if (!query.ContainsKey("modo"))
                _filters.Modo = "todas";
        }

        if (query.TryGetValue("tecnico", out var tecnicoRaw))
            _filters.IdTecnicoActual = tecnicoRaw.ToString();

        if (query.TryGetValue("cliente", out var clienteRaw))
            _filters.ClienteCodigo = clienteRaw.ToString();

        if (query.TryGetValue("buscar", out var buscarRaw))
            _filters.Search = buscarRaw.ToString();

        if (query.TryGetValue("desde", out var desdeRaw)
            && DateTime.TryParse(desdeRaw.ToString(), out var desde))
        {
            _filters.Desde = desde.Date;
        }

        if (query.TryGetValue("hasta", out var hastaRaw)
            && DateTime.TryParse(hastaRaw.ToString(), out var hasta))
        {
            _filters.Hasta = hasta.Date;
        }

        if (query.TryGetValue("auditoria", out var auditoriaRaw))
        {
            _filters.Auditoria = auditoriaRaw.ToString();
            if (!query.ContainsKey("modo"))
                _filters.Modo = "todas";
        }

        if (query.TryGetValue("tipoMensaje", out var tipoMensajeRaw))
            _filters.TipoMensaje = tipoMensajeRaw.ToString();

        if (query.TryGetValue("id", out var idRaw)
            && long.TryParse(idRaw.ToString(), out var id)
            && id > 0)
        {
            _startupConversationId = id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("conversacionesUi.bindColumnResizers", "conversations-page");
                await JS.InvokeVoidAsync("conversacionesUi.initNotifications", "AlfaCore - Alfa Gestión");
                await UpdateSoundDiagnosticsAsync();
            }
            catch
            {
            }

            // Restaura si el usuario había dejado el asistente de IA abierto la última vez
            // (preferencia global guardada en localStorage, no ligada a una conversación puntual).
            // Si todavía no hay preferencia guardada (primera vez) y el cliente tiene AlfaKnowledge
            // activo, arranca abierto — una vez que el usuario lo cierra o abre a mano, se respeta
            // esa elección de ahí en más.
            if (!_showAiSuggestionPanel && _alfaKnowledgeModuloActivo && _selectedConversationId is not null)
            {
                try
                {
                    var storedOpen = await JS.InvokeAsync<string?>("localStorage.getItem", AiPanelOpenStorageKey);
                    if (storedOpen == "1" || storedOpen is null)
                    {
                        _showAiSuggestionPanel = true;
                        await OpenAiSuggestionPanelAsync();
                        StateHasChanged();
                    }
                }
                catch
                {
                }
            }
        }

        try
        {
            await JS.InvokeVoidAsync("conversacionesUi.initAudioPlayers");
        }
        catch
        {
        }

        if (_showAiSuggestionPanel && _selectedConversation is not null)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeAsync<bool>(
                    "conversacionesUi.bindAiInstructionEnter",
                    _aiInstructionTextArea,
                    _dotNetRef);
            }
            catch
            {
            }
        }

        try
        {
            await JS.InvokeVoidAsync("conversacionesUi.bindDateDividers", _threadElement);
        }
        catch
        {
        }

        await SyncBrowserUnreadCountAsync();

        if (_pendingParteHoraLineaDescripcionFocusIndex.HasValue)
        {
            var focusIndex = _pendingParteHoraLineaDescripcionFocusIndex.Value;
            _pendingParteHoraLineaDescripcionFocusIndex = null;
            try
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{GetParteHoraLineaDescripcionId(focusIndex)}')?.focus()");
            }
            catch
            {
            }
        }

        if (_focusParteHorasDialogAfterRender)
        {
            _focusParteHorasDialogAfterRender = false;
            try
            {
                await _parteHorasDialogElement.FocusAsync();
            }
            catch
            {
            }
        }

        if (_selectedConversationId.HasValue && _scrollHandlerConversationId != _selectedConversationId)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _scrollHandlerConversationId = _selectedConversationId;

            try
            {
                _showReturnToLatest = await JS.InvokeAsync<bool>("conversacionesUi.watchThreadScroll", _threadElement, _dotNetRef);
            }
            catch
            {
                _showReturnToLatest = false;
            }
        }

        if (_selectedConversationId.HasValue && _selectedConversation is not null && !IsWhatsAppWindowExpired)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);

            try
            {
                var bound = await JS.InvokeAsync<bool>("conversacionesUi.bindReplyEnter", _replyTextArea, _dotNetRef);
                _replyEnterHandlerConversationId = bound ? _selectedConversationId : null;
            }
            catch
            {
                _replyEnterHandlerConversationId = null;
            }

            if (_fileDropHandlerConversationId != _selectedConversationId)
            {
                try
                {
                    var bound = await JS.InvokeAsync<bool>("conversacionesUi.bindFileDrop", _composerDropZone, "conv-file-drop-input");
                    _fileDropHandlerConversationId = bound ? _selectedConversationId : null;
                }
                catch
                {
                    _fileDropHandlerConversationId = null;
                }
            }
        }

        if (_selectedConversationId.HasValue && _selectedConversation is not null)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);

            try
            {
                await JS.InvokeAsync<bool>("conversacionesUi.bindInternalNoteEnter", _internalNoteTextArea, _dotNetRef);
                await JS.InvokeAsync<bool>("conversacionesUi.bindInternalNoteEnter", _internalNoteMobileTextArea, _dotNetRef);
            }
            catch
            {
            }
        }

        if (_syncReplyTextAfterRender)
        {
            _syncReplyTextAfterRender = false;
            await SetReplyTextareaValueAsync(_replyText, focus: false);
        }

        if (_scrollThreadToBottomAfterRender)
        {
            _scrollThreadToBottomAfterRender = false;
            await ScrollThreadToBottomAsync(stabilize: true);
        }

        if (_pendingThreadScrollRestoreAfterPrepend is not null)
        {
            var scrollRestore = _pendingThreadScrollRestoreAfterPrepend;
            _pendingThreadScrollRestoreAfterPrepend = null;
            try
            {
                await JS.InvokeVoidAsync(
                    "conversacionesUi.restoreScrollAfterPrepend",
                    _threadElement,
                    scrollRestore.ScrollTop,
                    scrollRestore.ScrollHeight);
            }
            catch
            {
            }
        }

        if (_scrollThreadToBottomStabilizePasses > 0)
        {
            _scrollThreadToBottomStabilizePasses--;
            await ScrollThreadToBottomAsync(stabilize: false);
            if (_scrollThreadToBottomStabilizePasses > 0)
                _ = InvokeAsync(StateHasChanged);
        }

        if (_focusReplyAfterRender)
        {
            _focusReplyAfterRender = false;
            await FocusReplyAsync();
        }

        if (_focusConversationNameAfterRender)
        {
            _focusConversationNameAfterRender = false;
            try
            {
                await _conversationNameInput.FocusAsync(preventScroll: true);
            }
            catch
            {
            }
        }

        if (_focusMessageSearchAfterRender)
        {
            _focusMessageSearchAfterRender = false;
            try
            {
                await _messageSearchInput.FocusAsync();
            }
            catch
            {
            }
        }

        if (_bindPreviewPanAfterRender && _previewAttachment is not null)
        {
            _bindPreviewPanAfterRender = false;
            try
            {
                await JS.InvokeVoidAsync("conversacionesUi.bindAttachmentPreviewPan", _previewCanvas);
            }
            catch
            {
            }
        }

        if (_bindPreviewKeyboardAfterRender && _previewAttachment is not null)
        {
            _bindPreviewKeyboardAfterRender = false;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("conversacionesUi.bindAttachmentPreviewKeyboard", _dotNetRef);
            }
            catch
            {
            }
        }

        if (_scrollPreviewThumbAfterRender && _previewAttachment is not null)
        {
            _scrollPreviewThumbAfterRender = false;
            try
            {
                await JS.InvokeVoidAsync("conversacionesUi.scrollActiveAttachmentPreviewThumb", _previewAttachment.IdAdjunto);
            }
            catch
            {
            }
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            _technicians = (await ConversacionesSvc.GetTechniciansAsync()).ToList();
            _states = (await ConversacionesSvc.GetStatesAsync()).ToList();
            _statusCode = _states.FirstOrDefault()?.CodigoEstado ?? "ABIERTA";
            EnsureCurrentTechnicianFilterForCurrentMode();

            var prioridad = await ConfigSvc.GetPrioridadConfigAsync();
            _filters.Clasifica1 = string.IsNullOrWhiteSpace(prioridad.Clasifica1) ? null : prioridad.Clasifica1;
            _filters.Clasifica2 = string.IsNullOrWhiteSpace(prioridad.Clasifica2) ? null : prioridad.Clasifica2;
            _filters.Clasifica3 = string.IsNullOrWhiteSpace(prioridad.Clasifica3) ? null : prioridad.Clasifica3;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
