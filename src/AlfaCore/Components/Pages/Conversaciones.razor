    private sealed record ContextNoteSectionVm(ContextNoteKind Kind, string Label, string Text);

    private sealed class ContextNotesVm
    {
        public static ContextNotesVm Empty { get; } = new([]);
        public ContextNotesVm(IReadOnlyList<ContextNoteSectionVm> sections)
        {
            Sections = sections;
            ObservationSections = sections.Where(x => x.Kind == ContextNoteKind.Observacion).ToList();
            OtherSections = sections.Where(x => x.Kind == ContextNoteKind.OtraNota).ToList();
        }

        public IReadOnlyList<ContextNoteSectionVm> Sections { get; }
        public IReadOnlyList<ContextNoteSectionVm> ObservationSections { get; }
        public IReadOnlyList<ContextNoteSectionVm> OtherSections { get; }
        public bool HasContent => Sections.Count > 0;
        public string Preview => ObservationSections.Count > 0 ? ObservationSections[0].Text : Sections.Count == 0 ? string.Empty : Sections[0].Text;

        public static ContextNotesVm FromSections(IReadOnlyList<ContextNoteSectionVm> sections)
            => sections.Count == 0 ? Empty : new ContextNotesVm(sections);
    }

