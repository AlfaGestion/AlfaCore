        var previousHistory = _aiChatHistory.ToList();
        _aiChatHistory.Add(new AlfaKnowledgeAssistantMessage
        {
            Role = "user",
            Content = instruction
        });
        _aiInstruction = string.Empty;
        await RequestAiSuggestionAsync(instruction, previousHistory);
    }

    private static bool IsGenericImageQuestion(string? value)
    {
        var normalized = value?.Trim();
        return string.Equals(normalized, "[image]", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, "[imagen]", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, "image", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, "imagen", StringComparison.OrdinalIgnoreCase);
    }

    private static string? ExtractVisibleErrorFromSuggestion(string? suggestion)
    {
        if (string.IsNullOrWhiteSpace(suggestion))
        {
            return null;
        }

        var text = suggestion.Trim();
        var errorIndex = text.IndexOf("error", StringComparison.OrdinalIgnoreCase);
        if (errorIndex < 0)
        {
            return null;
        }

        var openingQuote = text.IndexOfAny(['“', '"'], errorIndex);
        if (openingQuote >= 0)
        {
            var closingQuote = text.IndexOf(text[openingQuote] == '“' ? '”' : '"', openingQuote + 1);
            if (closingQuote > openingQuote + 1)
            {
                return text[(openingQuote + 1)..closingQuote].Trim();
            }
        }

        var end = text.IndexOfAny(['.', '?', '¿', '\n', '\r'], errorIndex);
        return (end > errorIndex ? text[errorIndex..end] : text[errorIndex..]).Trim(' ', ':');
    }

