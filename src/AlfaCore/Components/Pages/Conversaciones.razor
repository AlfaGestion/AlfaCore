    private static bool IsInternalEventMessage(ConversacionMensajeDto message)
        => string.Equals(message.Direction, "EVENTO_INTERNO", StringComparison.OrdinalIgnoreCase)
           || (string.Equals(message.Direction, "NOTA_INTERNA", StringComparison.OrdinalIgnoreCase)
               && string.Equals(message.MessageType, "SYSTEM", StringComparison.OrdinalIgnoreCase));

    private static bool TryGetTicketIdFromEvent(ConversacionMensajeDto message, out long idTicket)
    {
        idTicket = 0;
        if (!IsInternalEventMessage(message) || string.IsNullOrWhiteSpace(message.Texto))
            return false;

        var match = System.Text.RegularExpressions.Regex.Match(
            message.Texto,
            @"\bticket\s*#\s*(\d+)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

        return match.Success
               && long.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out idTicket)
               && idTicket > 0;
    }

    private bool CanReactToMessage(ConversacionMensajeDto message)
        => IsWhatsAppConversation
           && !IsWhatsAppWindowExpired
           && IsIncomingMessage(message)
           && !string.IsNullOrWhiteSpace(message.WhatsAppMessageId);

    private static bool IsReactionMessage(ConversacionMensajeDto message)
        => string.Equals(message.MessageType, "REACTION", StringComparison.OrdinalIgnoreCase)
           || IsLegacyReactionText(message.Texto)
           || TryExtractReactionEmojiFromPayload(message.PayloadJson, out _);

    private IReadOnlyList<string> GetInlineReactions(ConversacionMensajeDto message)
    {
        if (string.IsNullOrWhiteSpace(message.WhatsAppMessageId))
            return [];

        return _messages
            .Where(IsReactionMessage)
            .Where(x => string.Equals(x.WhatsAppReplyToMessageId, message.WhatsAppMessageId, StringComparison.OrdinalIgnoreCase))
            .GroupBy(x => (x.Direction ?? string.Empty).Trim().ToUpperInvariant())
            .Select(group => group
                .OrderByDescending(x => x.FechaHora)
                .ThenByDescending(x => x.IdMensaje)
                .First())
            .Select(ExtractReactionEmoji)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();
    }

    private static string ExtractReactionEmoji(ConversacionMensajeDto message)
    {
        if (TryExtractReactionEmojiFromPayload(message.PayloadJson, out var payloadEmoji))
            return payloadEmoji;

        var text = message.Texto ?? string.Empty;
        if (string.Equals(message.MessageType, "REACTION", StringComparison.OrdinalIgnoreCase)
            && !IsLegacyReactionText(text))
            return text.Trim();

        var separator = text.LastIndexOf(':');
        return separator >= 0 && separator < text.Length - 1
            ? text[(separator + 1)..].Trim()
            : string.Empty;
    }

    private static bool IsLegacyReactionText(string? text)
    {
        var value = text?.Trim() ?? string.Empty;
        return value.StartsWith("Reacci", StringComparison.OrdinalIgnoreCase)
               && (value.Contains("recibida", StringComparison.OrdinalIgnoreCase)
                   || value.Contains("enviada", StringComparison.OrdinalIgnoreCase));
    }

    private static bool TryExtractReactionEmojiFromPayload(string? payloadJson, out string emoji)
    {
        emoji = string.Empty;
        if (string.IsNullOrWhiteSpace(payloadJson))
            return false;

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(payloadJson);
            var root = document.RootElement;
            if (!root.TryGetProperty("type", out var type)
                || !string.Equals(type.GetString(), "reaction", StringComparison.OrdinalIgnoreCase)
                || !root.TryGetProperty("reaction", out var reaction))
                return false;

            emoji = reaction.TryGetProperty("emoji", out var value)
                ? value.GetString()?.Trim() ?? string.Empty
                : string.Empty;
            return true;
        }
        catch (System.Text.Json.JsonException)
        {
            return false;
        }
    }

    private bool TryGetQuotedMessage(ConversacionMensajeDto message, out ConversacionMensajeDto quotedMessage)
    {
        quotedMessage = default!;
        if (string.IsNullOrWhiteSpace(message.WhatsAppReplyToMessageId))
            return false;

        quotedMessage = _messages.FirstOrDefault(x =>
            !string.IsNullOrWhiteSpace(x.WhatsAppMessageId)
            && string.Equals(x.WhatsAppMessageId, message.WhatsAppReplyToMessageId, StringComparison.OrdinalIgnoreCase))!;

        return quotedMessage is not null;
    }

