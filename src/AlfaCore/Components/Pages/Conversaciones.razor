    /// <summary>
    /// Hace cuánto espera respuesta esta conversación (solo tiene sentido si el último mensaje es
    /// del cliente) — para el badge de tiempo de espera en la lista. Sin la palabra "esperando":
    /// el ícono de reloj de arena ya lo dice, esto es solo el tiempo, para ahorrar espacio.
    /// </summary>
    private static string GetEsperandoDesdeLabel(ConversacionInboxItemDto item)
    {
        var minutos = (int)Math.Max(0, (DateTime.Now - item.FechaHoraUltimoMensaje).TotalMinutes);
        if (minutos < 1)
            return "ahora";
        if (minutos < 60)
            return $"{minutos} min";

        var horas = minutos / 60;
        if (horas < 24)
            return $"{horas} h";

        var dias = horas / 24;
        return $"{dias} d";
    }

