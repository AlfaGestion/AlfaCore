    private async Task SendReplyAsync()
    {
        if (_selectedConversation is null)
            return;

        var textToSend = _replyText.Trim();
        var attachmentsToSend = _pendingAttachments.ToList();
        if (string.IsNullOrWhiteSpace(textToSend) && attachmentsToSend.Count == 0)
            return;

        _busyAction = true;
        _actionMessage = null;
        _actionError = null;

        var quotedMessageId = _quotedMessage?.WhatsAppMessageId;
        long? optimisticMessageId = null;
        if (!string.IsNullOrWhiteSpace(textToSend))
        {
            _replyText = string.Empty;
            _quotedMessage = null;
            optimisticMessageId = AddOptimisticOutgoingMessage(textToSend);
        }

        await InvokeAsync(StateHasChanged);
        await AutoResizeReplyTextareaAsync();

        try
        {
            if (!string.IsNullOrWhiteSpace(textToSend))
            {
                await ConversacionesSvc.SendMessageAsync(new ConversacionSendMessageRequest
                {
                    IdConversacion = _selectedConversation.IdConversacion,
                    Texto = textToSend,
                    MessageType = "TEXT",
                    WhatsAppReplyToMessageId = quotedMessageId,
                    IdTecnicoAutor = CurrentMessageTechnicianId,
                    UsuarioAccion = CurrentUserNameForAudit,
                    SistemaAccion = CurrentUserSystemForAudit
                });
            }

            await UploadPendingAttachmentsAsync(attachmentsToSend, RemovePendingAttachment);

            _actionMessage = "Mensaje registrado correctamente.";
            await SelectConversationAsync(_selectedConversation.IdConversacion);
            await LoadInboxAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
            MarkPendingAttachmentsError(ex.Message);
            if (optimisticMessageId.HasValue)
                RemoveOptimisticMessage(optimisticMessageId.Value);

            if (_selectedConversation is not null)
                await SelectConversationAsync(_selectedConversation.IdConversacion);

            foreach (var pending in _pendingAttachments)
                pending.Error ??= "No se pudo enviar. Reintentá con el botón de enviar.";

            if (!string.IsNullOrWhiteSpace(textToSend) && !_messages.Any(x => x.Texto == textToSend && IsOutgoingMessage(x)))
                _replyText = textToSend;
        }
        finally
        {
            _busyAction = false;
            await ClearTypingAsync();
        }
    }

