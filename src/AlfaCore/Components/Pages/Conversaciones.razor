    }

    private void OnConversationNameInput(ChangeEventArgs args)
        => _conversationNameDraft = args.Value?.ToString() ?? string.Empty;

    private async Task OnConversationNameKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            await SaveConversationNameAsync();
        else if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            CancelConversationNameEdit();
    }

    private void CancelConversationNameEdit()
    {
        _conversationNameDraft = _selectedConversation is null ? string.Empty : GetConversationHeader(_selectedConversation);
        _editingConversationName = false;
    }

    private async Task SaveConversationNameAsync()
    {
        if (!_editingConversationName || _selectedConversation is null || _savingConversationName)
            return;

        var nextName = _conversationNameDraft.Trim();
        var currentName = GetConversationHeader(_selectedConversation).Trim();
        if (string.IsNullOrWhiteSpace(nextName))
        {
            _conversationNameDraft = currentName;
            _editingConversationName = false;
            return;
        }

        if (string.Equals(nextName, currentName, StringComparison.Ordinal))
        {
            _editingConversationName = false;
            return;
        }

        _savingConversationName = true;
        try
        {
            await ConversacionesSvc.RenameConversationAsync(new ConversacionRenameRequest
            {
                IdConversacion = _selectedConversation.IdConversacion,
                NombreVisible = nextName,
                UsuarioAccion = CurrentUserNameForAudit,
                SistemaAccion = CurrentUserSystemForAudit
            });

            _selectedConversation.NombreVisible = nextName;
            var inboxItem = _inbox.FirstOrDefault(item => item.IdConversacion == _selectedConversation.IdConversacion);
            if (inboxItem is not null)
                inboxItem.NombreVisible = nextName;
            StoreConversationCache(_selectedConversation.IdConversacion);
            _editingConversationName = false;
        }
        catch (Exception ex)
        {
            _conversationError = ex.Message;
            _conversationNameDraft = currentName;
            _editingConversationName = false;
        }
        finally
        {
            _savingConversationName = false;
        }
    }

