    private async Task CreateTicketFromSelectionAsync()
    {
        if (_selectedConversation is null)
            return;
        if (_selectedTicketMessageIds.Count == 0)
        {
            _ticketError = "Seleccioná al menos un mensaje para crear el ticket.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_ticketTitle))
        {
            _ticketError = "Ingresá el nombre del ticket.";
            return;
        }
        var creatorTechnicianId = CurrentMessageTechnicianId;
        if (string.IsNullOrWhiteSpace(creatorTechnicianId))
        {
            _ticketError = "No se pudo crear el ticket porque tu usuario no tiene un técnico asociado.";
            return;
        }

        if (_relatedTicketMatches.Count > 0 && !_allowCreateDespiteRelated)
        {
            _ticketError = "Revisá los tickets relacionados o elegí Crear igual para continuar.";
            return;
        }

        _creatingTicket = true;
        _ticketError = null;
        try
        {
            var orderedMessageIds = VisibleMessages
                .Where(x => _selectedTicketMessageIds.Contains(x.IdMensaje))
                .Select(x => x.IdMensaje)
                .ToList();

            var idTicket = await TicketsSvc.CreateAsync(new TicketCreateRequest
            {
                Titulo = _ticketTitle,
                Descripcion = _ticketDescription,
                CodigoEstado = TicketEstadoKeys.Nuevo,
                Prioridad = _ticketPriority,
                IdTecnico = creatorTechnicianId,
                ClienteCodigo = _selectedConversation.ClienteCodigo,
                IdContacto = _selectedConversation.IdContacto,
                IdConversacion = _selectedConversation.IdConversacion,
                IdMensajes = orderedMessageIds,
                UsuarioAccion = CurrentUserNameForAudit
            });

            await ConversacionesSvc.AddInternalEventAsync(new ConversacionEventoInternoRequest
            {
                IdConversacion = _selectedConversation.IdConversacion,
                Texto = $"{CurrentMessageTechnicianName} cre\u00f3 el ticket #{idTicket.ToString(System.Globalization.CultureInfo.InvariantCulture)}.",
                IdTecnicoAutor = creatorTechnicianId,
                NombreTecnicoAccion = CurrentMessageTechnicianName,
                UsuarioAccion = CurrentUserNameForAudit,
                SistemaAccion = CurrentUserSystemForAudit
            });

            _ticketSelectionMode = false;
            _showTicketDialog = false;
            _selectedTicketMessageIds.Clear();
            _ticketDescription = string.Empty;
            _relatedTicketMatches.Clear();
            _allowCreateDespiteRelated = false;
            _actionMessage = $"Ticket #{idTicket.ToString(System.Globalization.CultureInfo.InvariantCulture)} creado correctamente.";
            await LoadConversationAsync(_selectedConversation.IdConversacion, showLoading: false, clearActionState: false);
        }
        catch (Exception ex)
        {
            _ticketError = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.Message
                : "No se pudo crear el ticket. Revisá la base activa y volvé a intentar.";
        }
        finally
        {
            _creatingTicket = false;
        }
    }

    private async Task CheckRelatedTicketsForSelectionAsync()
    {
        if (_selectedConversation is null || _selectedTicketMessageIds.Count == 0)
        {
            _relatedTicketMatches.Clear();
            return;
        }

        _checkingRelatedTickets = true;
        _allowCreateDespiteRelated = false;
        _relatedTicketMatches.Clear();
        try
        {
            var selectedText = BuildSelectedTicketText();
            var searchText = BuildRelatedTicketSearchText(selectedText);
            if (string.IsNullOrWhiteSpace(searchText))
                return;

            var matches = await TicketsSvc.FindRelatedOpenTicketsAsync(new TicketRelatedSearchRequest
            {
                ClienteCodigo = _selectedConversation.ClienteCodigo,
                IdContacto = _selectedConversation.IdContacto,
                IdConversacion = _selectedConversation.IdConversacion,
                Texto = searchText
            });

            _relatedTicketMatches = matches
                .Where(match => match.Terminos.Count > 0)
                .ToList();
        }
        catch (Exception ex)
        {
            _ticketError = $"No se pudieron revisar tickets relacionados: {ex.Message}";
        }
        finally
        {
            _checkingRelatedTickets = false;
        }
    }

    private string BuildSelectedTicketText()
        => string.Join(" ", VisibleMessages
            .Where(x => _selectedTicketMessageIds.Contains(x.IdMensaje))
            .Where(ShouldUseMessageForRelatedTicketSearch)
            .Select(x => x.Texto)
            .Where(x => !string.IsNullOrWhiteSpace(x)));

    private string BuildRelatedTicketSearchText(string selectedText)
    {
        var defaultTitle = BuildDefaultTicketTitle();
        var titleWasEdited = !string.IsNullOrWhiteSpace(_ticketTitle)
                             && !string.Equals(_ticketTitle.Trim(), defaultTitle.Trim(), StringComparison.OrdinalIgnoreCase);

        return titleWasEdited
            ? $"{_ticketTitle} {selectedText}".Trim()
            : selectedText.Trim();
    }

    private bool ShouldUseMessageForRelatedTicketSearch(ConversacionMensajeDto message)
    {
        if (string.IsNullOrWhiteSpace(message.Texto))
            return false;

        if (IsContactMessage(message) || IsReactionMessage(message) || IsUnsupportedMessage(message))
            return false;

        if (message.MessageType is "IMAGE" or "AUDIO" or "VIDEO" or "DOCUMENT" or "STICKER")
            return HasHumanAttachmentText(message);

        return string.Equals(message.MessageType, "TEXT", StringComparison.OrdinalIgnoreCase)
               || string.IsNullOrWhiteSpace(message.MessageType);
    }

