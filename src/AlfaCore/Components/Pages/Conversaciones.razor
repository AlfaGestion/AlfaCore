    private bool HasAiContextImage()
        => GetAiImageCandidate(GetAiContextMessages()) is not null;

    private (ConversacionMensajeDto Message, ConversacionAdjuntoDto Attachment)? GetAiImageCandidate(
        IReadOnlyCollection<ConversacionMensajeDto> contextMessages)
    {
        var candidates = string.Equals(_aiContextScope, AiContextScopes.FocusedMessage, StringComparison.Ordinal)
            && _aiFocusedMessageId.HasValue
                ? contextMessages.Where(message => message.IdMensaje == _aiFocusedMessageId.Value)
                : contextMessages;

        foreach (var message in candidates
                     .Where(IsIncomingMessage)
                     .OrderByDescending(static message => message.FechaHora)
                     .ThenByDescending(static message => message.IdMensaje))
        {
            if (!_adjuntosPorMensaje.TryGetValue(message.IdMensaje, out var attachments))
            {
                continue;
            }

            var image = attachments
                .Where(static attachment => attachment.ArchivoDisponible)
                .Where(IsImageAttachment)
                .Where(static attachment => !IsStickerAttachment(attachment))
                .OrderByDescending(static attachment => attachment.IdAdjunto)
                .FirstOrDefault();
            if (image is not null)
            {
                return (message, image);
            }
        }

        return null;
    }

    private async Task<AlfaKnowledgeImageInput?> BuildAiImageInputAsync(
        ConversacionAdjuntoDto attachment,
        CancellationToken cancellationToken)
    {
        const long maxImageBytes = 10 * 1024 * 1024;
        if (attachment.TamanoBytes > maxImageBytes)
        {
            return null;
        }

        var file = await ConversacionesSvc.GetAttachmentForServeAsync(
            attachment.IdAdjunto,
            includeDownloadName: false,
            ct: cancellationToken);
        if (file is null || file.Contenido.Length == 0 || file.Contenido.LongLength > maxImageBytes)
        {
            return null;
        }

        var mimeType = file.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
            ? file.MimeType
            : GetAttachmentMime(attachment);
        if (!mimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return new AlfaKnowledgeImageInput
        {
            DataUrl = $"data:{mimeType};base64,{Convert.ToBase64String(file.Contenido)}",
            FileName = FirstNonEmpty(file.NombreArchivo, attachment.NombreArchivo)
        };
    }

