    private async Task UploadPendingAttachmentsAsync(
        IReadOnlyList<PendingAttachment> attachmentsToSend,
        Action<Guid> removeAttachment,
        bool allowExpiredWhatsAppWindow = false)
    {
        if (_selectedConversation is null)
            return;

        foreach (var attachmentToSend in attachmentsToSend)
        {
            attachmentToSend.Error = null;
            await using var stream = new MemoryStream(attachmentToSend.Contenido);
            await ConversacionesSvc.UploadAttachmentAsync(new ConversacionUploadAdjuntoRequest
            {
                IdConversacion = _selectedConversation.IdConversacion,
                NombreArchivo = attachmentToSend.NombreArchivo,
                MimeType = attachmentToSend.MimeType,
                TipoArchivo = attachmentToSend.TipoArchivo,
                Contenido = stream,
                TamanoBytes = attachmentToSend.TamanoBytes,
                IdTecnicoAutor = string.IsNullOrWhiteSpace(CurrentMessageTechnicianId) ? null : CurrentMessageTechnicianId,
                UsuarioAccion = CurrentUserNameForAudit,
                SistemaAccion = CurrentUserSystemForAudit,
                PermitirEnvioConVentanaVencida = allowExpiredWhatsAppWindow
            });

            removeAttachment(attachmentToSend.Id);
        }
    }

