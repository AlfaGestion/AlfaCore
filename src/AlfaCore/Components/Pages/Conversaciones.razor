    private static string FormatInboxSummary(string? summary)
    {
        var value = summary?.Trim() ?? string.Empty;
        if (!value.StartsWith("Reacci", StringComparison.OrdinalIgnoreCase))
            return value;

        var separator = value.LastIndexOf(':');
        var detail = separator >= 0 && separator < value.Length - 1
            ? value[(separator + 1)..].Trim()
            : string.Empty;

        if (detail.StartsWith("wamid.", StringComparison.OrdinalIgnoreCase))
            return "Reacción eliminada.";

        if (value.Contains("recibida", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(detail) ? "Reacción recibida." : $"Reacción recibida: {detail}";

        if (value.Contains("enviada", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(detail) ? "Reacción enviada." : $"Reacción enviada: {detail}";

        return value;
    }

