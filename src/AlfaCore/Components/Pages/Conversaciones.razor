    private async Task RefreshTypingAsync()
    {
        if (_selectedConversationId is not { } idConversacion)
        {
            if (_typingUsers.Count > 0)
            {
                _typingUsers = [];
                StateHasChanged();
            }

            return;
        }

        try
        {
            var typing = (await ConversacionesSvc.GetTypingAsync(idConversacion, _typingClientId)).ToList();
            if (AreSameTypingUsers(_typingUsers, typing))
                return;

            _typingUsers = typing;
            StateHasChanged();
        }
        catch
        {
        }
    }

    private static bool AreSameTypingUsers(IReadOnlyList<ConversacionTypingDto> current, IReadOnlyList<ConversacionTypingDto> next)
    {
        if (current.Count != next.Count)
            return false;

        var currentKeys = current
            .Select(BuildTypingDisplayKey)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase);
        var nextKeys = next
            .Select(BuildTypingDisplayKey)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase);

        return currentKeys.SequenceEqual(nextKeys, StringComparer.OrdinalIgnoreCase);
    }

    private static string BuildTypingDisplayKey(ConversacionTypingDto item)
        => FirstNonEmpty(item.ClienteId, item.Usuario, item.IdTecnico, item.NombreTecnico);

    private async Task AutoRefreshAsync()
    {
        if (ShouldSkipAutoRefresh())
            return;

        var selectedId = _selectedConversationId;
        var shouldKeepAtBottom = await IsThreadNearBottomAsync();
        var previousLastMessageId = GetLastMessageId();

        var newMessagesDetected = await RefreshInboxAsync(showLoading: false, allowSelectionChange: false, trackNewMessages: true);

        if (selectedId.HasValue && _selectedConversationId == selectedId)
            await LoadConversationAsync(selectedId.Value, showLoading: false, clearActionState: false);

        var currentLastMessageId = GetLastMessageId();
        var hasNewMessages = previousLastMessageId.HasValue
                             && currentLastMessageId.HasValue
                             && currentLastMessageId > previousLastMessageId;

        if (hasNewMessages && previousLastMessageId is { } lastSeenMessageId)
        {
            var newMessages = _messages
                .Where(x => x.IdMensaje > lastSeenMessageId && IsIncomingMessage(x))
                .ToList();
            if (newMessages.Count > 0)
            {
                newMessagesDetected += newMessages.Count;

                if (!shouldKeepAtBottom)
                {
                    _firstNewMessageId ??= newMessages.FirstOrDefault()?.IdMensaje;
                    _newMessagesCount += newMessages.Count;
                    _showReturnToLatest = true;
                }
            }
        }

        if (shouldKeepAtBottom)
        {
            await ScrollThreadToBottomAsync();
            MarkSelectedConversationAsRead();
        }

        StateHasChanged();

        if (newMessagesDetected > 0)
            await PlayNewMessageSoundAsync();
    }

    private bool ShouldSkipAutoRefresh()
        => _loadingInbox
           || _loadingConversation
           || _busyAction
           || _uploadingFile
           || _uploadingAudio
           || _recording
           || _showNuevoHilo
           || _showTemplatePanel;

