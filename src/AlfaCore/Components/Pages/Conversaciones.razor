    private bool ShouldShowMessageText(ConversacionMensajeDto message)
    {
        if (string.IsNullOrWhiteSpace(message.Texto))
            return false;

        if (IsContactMessage(message) && GetSharedContacts(message).Count > 0)
            return false;

        if (IsAttachmentOnlyMessage(message))
        {
            return HasHumanAttachmentText(message);
        }

        return true;
    }

    private bool ShouldShowMessageFooter(ConversacionMensajeDto message)
        => !IsAttachmentOnlyMessage(message);

    private bool IsAttachmentOnlyMessage(ConversacionMensajeDto message)
        => (message.MessageType ?? string.Empty).Trim().ToUpperInvariant() is "IMAGE" or "AUDIO" or "VIDEO" or "DOCUMENT" or "STICKER"
           && (message.TieneAdjuntos
               || (_adjuntosPorMensaje.TryGetValue(message.IdMensaje, out var adjuntos) && adjuntos.Count > 0));

    private bool HasHumanAttachmentText(ConversacionMensajeDto message)
    {
        var text = message.Texto.Trim();
        if (text.StartsWith("[", StringComparison.Ordinal))
            return false;

        if (_adjuntosPorMensaje.TryGetValue(message.IdMensaje, out var adjuntos)
            && adjuntos.Any(x => string.Equals(x.NombreArchivo, text, StringComparison.OrdinalIgnoreCase)))
            return false;

        if (IsGeneratedMediaFileName(text, message.MessageType))
            return false;

        return true;
    }

    private static bool IsGeneratedMediaFileName(string text, string messageType)
    {
        var normalizedType = (messageType ?? string.Empty).Trim().ToUpperInvariant();
        var prefix = normalizedType switch
        {
            "IMAGE" or "STICKER" => "image_",
            "VIDEO" => "video_",
            "AUDIO" => "audio_",
            _ => string.Empty
        };

        return !string.IsNullOrWhiteSpace(prefix)
               && text.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
               && Path.HasExtension(text);
    }

    private static string GetMessageDisplayText(ConversacionMensajeDto message)
    {
        if (!IsUnsupportedMessage(message))
            return message.Texto;

        var unsupportedType = ExtractUnsupportedType(message.PayloadJson);
        return string.IsNullOrWhiteSpace(unsupportedType)
            ? "WhatsApp envió un tipo de mensaje que todavía no es compatible con el módulo."
            : $"WhatsApp envió un formato no compatible: {unsupportedType}.";
    }

    private static readonly Regex MessageUrlRegex = new(
        @"(?i)\b((?:https?://|www\.)[^\s<]+)",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);

    // Formato con el que AnyDesk muestra el ID en su propio cliente (3-3-3 o 3-3-4 dígitos
    // separados por un espacio). Detectar solo ese patrón evita falsos positivos con
    // teléfonos, DNI o números de pedido que no vienen agrupados así.
    private static readonly Regex AnyDeskIdRegex = new(
        @"\b\d{3} \d{3} \d{3,4}\b",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);

    private MarkupString RenderMessageText(ConversacionMensajeDto message)
        => new(LinkifyMessageText(GetMessageDisplayText(message), _messageSearchText, message.IdMensaje == ActiveMessageSearchId));

    private static string LinkifyMessageText(string? text, string searchTerm, bool isActiveMatch)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        var encoded = WebUtility.HtmlEncode(text);
        encoded = HighlightSearchTerm(encoded, searchTerm, isActiveMatch);
        encoded = AnyDeskIdRegex.Replace(encoded, match =>
            $"""<a class="message-card__anydesk-chip" href="{BuildAnyDeskUri(match.Value)}" title="Conectar por AnyDesk"><i class="bi bi-display"></i>{match.Value}</a>""");

        return MessageUrlRegex.Replace(encoded, match =>
        {
            var display = match.Value;
            var trailing = string.Empty;

            while (display.Length > 0 && IsUrlTrailingPunctuation(display[^1]))
            {
                trailing = display[^1] + trailing;
                display = display[..^1];
            }

            if (string.IsNullOrWhiteSpace(display))
                return match.Value;

            var href = display.StartsWith("www.", StringComparison.OrdinalIgnoreCase)
                ? $"https://{display}"
                : display;

            return $"""<a class="message-card__link" href="{href}" target="_blank" rel="noopener noreferrer">{display}</a>{trailing}""";
        });
    }

    private static bool IsUrlTrailingPunctuation(char value)
        => value is '.' or ',' or ';' or ':' or ')' or ']' or '}' or '!' or '?';

    /// <summary>
    /// Corre sobre el texto YA escapado con HtmlEncode (antes de linkificar URLs/AnyDesk) para no
    /// terminar insertando &lt;mark&gt; adentro de un atributo href y corromper el HTML resultante.
    /// </summary>
    private static string HighlightSearchTerm(string encodedText, string searchTerm, bool isActiveMatch)
    {
        var term = searchTerm?.Trim() ?? string.Empty;
        if (term.Length == 0)
            return encodedText;

        var encodedTerm = WebUtility.HtmlEncode(term);
        if (encodedTerm.Length == 0)
            return encodedText;

        var markClass = isActiveMatch ? "message-search-mark message-search-mark--active" : "message-search-mark";
        return Regex.Replace(
            encodedText,
            Regex.Escape(encodedTerm),
            match => $"""<mark class="{markClass}">{match.Value}</mark>""",
            RegexOptions.IgnoreCase);
    }

    private static string BuildAnyDeskUri(string? rawId)
        => $"anydesk:{NormalizeAnyDeskId(rawId)}";

    private static string NormalizeAnyDeskId(string? rawId)
        => rawId is null ? string.Empty : new string(rawId.Where(char.IsDigit).ToArray());

