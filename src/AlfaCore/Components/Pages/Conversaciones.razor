    private static IReadOnlyList<SharedContactPayload> GetSharedContacts(ConversacionMensajeDto message)
    {
        if (string.IsNullOrWhiteSpace(message.PayloadJson))
            return [];

        try
        {
            using var doc = JsonDocument.Parse(message.PayloadJson);
            if (!doc.RootElement.TryGetProperty("contacts", out var contacts) || contacts.ValueKind != JsonValueKind.Array)
                return [];

            var parsed = new List<SharedContactPayload>();
            foreach (var contact in contacts.EnumerateArray())
            {
                var name = ExtractSharedContactName(contact);
                var phone = ExtractSharedContactPhone(contact);
                var email = ExtractSharedContactEmail(contact);

                if (!string.IsNullOrWhiteSpace(name) || !string.IsNullOrWhiteSpace(phone) || !string.IsNullOrWhiteSpace(email))
                    parsed.Add(new SharedContactPayload(name, phone, email));
            }

            return parsed;
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static string ExtractSharedContactName(JsonElement contact)
    {
        if (!contact.TryGetProperty("name", out var name))
            return string.Empty;

        return FirstNonEmpty(
            ExtractJsonString(name, "formatted_name"),
            ExtractJsonString(name, "first_name"),
            ExtractJsonString(name, "last_name"));
    }

    private static string ExtractSharedContactPhone(JsonElement contact)
    {
        if (!contact.TryGetProperty("phones", out var phones) || phones.ValueKind != JsonValueKind.Array)
            return string.Empty;

        foreach (var phone in phones.EnumerateArray())
        {
            var value = FirstNonEmpty(ExtractJsonString(phone, "phone"), ExtractJsonString(phone, "wa_id"));
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }

        return string.Empty;
    }

    private static string ExtractSharedContactEmail(JsonElement contact)
    {
        if (!contact.TryGetProperty("emails", out var emails) || emails.ValueKind != JsonValueKind.Array)
            return string.Empty;

        foreach (var email in emails.EnumerateArray())
        {
            var value = ExtractJsonString(email, "email");
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }

        return string.Empty;
    }

    private static string ExtractJsonString(JsonElement element, string propertyName)
        => element.ValueKind == JsonValueKind.Object && element.TryGetProperty(propertyName, out var property)
            ? property.GetString() ?? string.Empty
            : string.Empty;

    private static string GetQuotePreview(ConversacionMensajeDto message)
    {
        var text = string.IsNullOrWhiteSpace(message.Texto)
            ? $"[{GetMessageTypeLabel(message)}]"
            : message.Texto.Trim();

        return text.Length <= 90 ? text : $"{text[..90]}...";
    }

    private static string GetUnsupportedMessageTrace(ConversacionMensajeDto message)
    {
        var parts = new List<string>();
        var originalType = ExtractPayloadString(message.PayloadJson, "type");
        if (!string.IsNullOrWhiteSpace(originalType))
            parts.Add($"Tipo recibido: {originalType}");

        var unsupportedType = ExtractUnsupportedType(message.PayloadJson);
        if (!string.IsNullOrWhiteSpace(unsupportedType))
            parts.Add($"Formato no compatible: {unsupportedType}");

        var metaReason = ExtractUnsupportedReason(message.PayloadJson);
        if (!string.IsNullOrWhiteSpace(metaReason))
            parts.Add(metaReason);

        if (!string.IsNullOrWhiteSpace(message.WhatsAppMessageId))
            parts.Add($"ID WhatsApp: {message.WhatsAppMessageId}");

        return parts.Count == 0
            ? "Sin detalle técnico disponible en el webhook."
            : string.Join(" · ", parts);
    }

    private static bool IsUnsupportedMessage(ConversacionMensajeDto message)
    {
        var text = (message.Texto ?? string.Empty).Trim();
        return string.Equals(message.MessageType, "UNKNOWN", StringComparison.OrdinalIgnoreCase)
               || string.Equals(message.MessageType, "UNSUPPORTED", StringComparison.OrdinalIgnoreCase)
               || string.Equals(text, "[unsupported]", StringComparison.OrdinalIgnoreCase)
               || string.Equals(text, "[unknown]", StringComparison.OrdinalIgnoreCase);
    }

    private static string ExtractPayloadString(string payloadJson, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(payloadJson))
            return string.Empty;

        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            return doc.RootElement.TryGetProperty(propertyName, out var prop)
                ? prop.GetString() ?? string.Empty
                : string.Empty;
        }
        catch (JsonException)
        {
            return string.Empty;
        }
    }

    private static string ExtractUnsupportedType(string payloadJson)
    {
        if (string.IsNullOrWhiteSpace(payloadJson))
            return string.Empty;

        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            if (doc.RootElement.TryGetProperty("unsupported", out var unsupported)
                && unsupported.ValueKind == JsonValueKind.Object
                && unsupported.TryGetProperty("type", out var typeProp))
            {
                return typeProp.GetString() ?? string.Empty;
            }
        }
        catch (JsonException)
        {
            return string.Empty;
        }

        return string.Empty;
    }

    private static string ExtractUnsupportedReason(string payloadJson)
    {
        if (string.IsNullOrWhiteSpace(payloadJson))
            return string.Empty;

        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            if (!doc.RootElement.TryGetProperty("errors", out var errors) || errors.ValueKind != JsonValueKind.Array)
                return string.Empty;

            foreach (var error in errors.EnumerateArray())
            {
                var title = error.TryGetProperty("title", out var titleProp) ? titleProp.GetString() ?? string.Empty : string.Empty;
                var message = error.TryGetProperty("message", out var messageProp) ? messageProp.GetString() ?? string.Empty : string.Empty;
                var details = string.Empty;
                if (error.TryGetProperty("error_data", out var errorData) &&
                    errorData.TryGetProperty("details", out var detailsProp))
                {
                    details = detailsProp.GetString() ?? string.Empty;
                }

                var reason = FirstNonEmpty(details, message, title);
                if (!string.IsNullOrWhiteSpace(reason))
                    return $"Motivo: {reason}";
            }
        }
        catch (JsonException)
        {
            return string.Empty;
        }

        return string.Empty;
    }

