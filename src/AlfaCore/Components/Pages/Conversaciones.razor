    private async Task ToggleMensajeMarcaAsync(ConversacionMensajeDto message, string marca)
    {
        var nuevaMarca = string.Equals(message.MarcaInterna, marca, StringComparison.OrdinalIgnoreCase) ? null : marca;
        var previa = message.MarcaInterna;
        message.MarcaInterna = nuevaMarca;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            await ConversacionesSvc.SetMensajeMarcaInternaAsync(message.IdConversacion, message.IdMensaje, nuevaMarca, timeout.Token);
        }
        catch (Exception ex)
        {
            message.MarcaInterna = previa;
            _actionError = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : "No se pudo actualizar la marca del mensaje.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleAnyDeskPromptAsync(ConversacionMensajeDto message)
    {
        _anyDeskIdDraft = string.Empty;
        _showAnyDeskToolbarPrompt = false;

        if (_anyDeskPromptMessageId == message.IdMensaje)
        {
            _anyDeskPromptMessageId = null;
            return;
        }

        _anyDeskPromptMessageId = message.IdMensaje;

        var imageAttachment = GetMessageImageAttachment(message);
        if (imageAttachment is null || !AlfaKnowledgeSvc.IsConfigured)
        {
            return;
        }

        _anyDeskReadingImageMessageId = message.IdMensaje;
        StateHasChanged();

        try
        {
            var imageInput = await BuildAiImageInputAsync(imageAttachment, CancellationToken.None);
            if (imageInput is null || _anyDeskPromptMessageId != message.IdMensaje)
            {
                return;
            }

            var result = await AlfaKnowledgeSvc.SuggestReplyAsync(
                "Leer ID de AnyDesk desde la imagen adjunta.",
                Array.Empty<ConversacionMensajeDto>(),
                message.IdConversacion,
                mode: AlfaKnowledgeSuggestionModes.AnyDeskId,
                image: imageInput);

            // Solo completar si el técnico sigue con este mismo cuadro abierto: pudo cerrarlo
            // o abrir el de otro mensaje mientras se esperaba la respuesta de la IA.
            if (_anyDeskPromptMessageId != message.IdMensaje)
            {
                return;
            }

            if (result is not null && result.HasSufficientContext && !string.IsNullOrWhiteSpace(result.SuggestedReply))
            {
                _anyDeskIdDraft = result.SuggestedReply;
            }
        }
        finally
        {
            _anyDeskReadingImageMessageId = null;
        }
    }

    private ConversacionAdjuntoDto? GetMessageImageAttachment(ConversacionMensajeDto message)
    {
        if (!_adjuntosPorMensaje.TryGetValue(message.IdMensaje, out var attachments))
        {
            return null;
        }

        return attachments
            .Where(static attachment => attachment.ArchivoDisponible)
            .Where(IsImageAttachment)
            .Where(static attachment => !IsStickerAttachment(attachment))
            .OrderByDescending(static attachment => attachment.IdAdjunto)
            .FirstOrDefault();
    }

