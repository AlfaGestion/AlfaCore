    private void MarkSelectedConversationAsRead()
    {
        if (_selectedConversationId is { } id)
        {
            var hadUnread = _newMessagesByConversation.Remove(id);
            if (_inbox.FirstOrDefault(x => x.IdConversacion == id) is { } inboxItem)
            {
                hadUnread = hadUnread || inboxItem.MensajesNoLeidosUsuario > 0;
                inboxItem.MensajesNoLeidosUsuario = 0;
            }

            if (hadUnread || _newMessagesCount > 0)
                _ = InvokeAsync(() => PersistConversationReadAsync(id));
        }

        ClearNewMessageState();
        _showReturnToLatest = false;
    }

    private int GetConversationNewCount(long idConversacion)
    {
        var count = _newMessagesByConversation.TryGetValue(idConversacion, out var storedCount) ? storedCount : 0;
        if (_inbox.FirstOrDefault(x => x.IdConversacion == idConversacion) is { } inboxItem)
            count = Math.Max(count, inboxItem.MensajesNoLeidosUsuario);

        if (_selectedConversationId == idConversacion)
            count = Math.Max(count, _newMessagesCount);

        return count;
    }

