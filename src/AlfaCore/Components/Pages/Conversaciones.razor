    private async Task SaveParteHorasAsync()
    {
        if (_parteHoraConversationId is null)
            return;

        var lineas = _parteHoraLineas
            .Where(linea => linea.TotalMinutos > 0 || !string.IsNullOrWhiteSpace(linea.Descripcion) || !string.IsNullOrWhiteSpace(linea.IdTecnico))
            .ToList();

        if (lineas.Count == 0)
        {
            _parteHoraError = "Agregá al menos una línea para el parte de horas.";
            return;
        }

        if (lineas.Any(linea => linea.TotalMinutos <= 0))
        {
            _parteHoraError = "Todas las líneas deben tener una duración mayor a cero.";
            return;
        }

        if (lineas.Any(linea => linea.Horas < 0 || linea.Minutos < 0 || linea.Minutos > 59))
        {
            _parteHoraError = "Revisá horas y minutos: los minutos deben estar entre 0 y 59.";
            return;
        }

        if (lineas.Any(linea => linea.TotalMinutos > 24 * 60))
        {
            _parteHoraError = "Ninguna línea puede superar 24 horas.";
            return;
        }

        _savingParteHora = true;
        _parteHoraError = null;

        try
        {
            var idsPartes = new List<long>();
            foreach (var linea in lineas)
            {
                idsPartes.Add(await PartesHorasSvc.SaveAsync(new ParteHoraSaveRequest
                {
                    Fecha = _parteHoraFecha,
                    ClienteCodigo = _parteHoraClienteCodigo,
                    IdContacto = _parteHoraIdContacto,
                    IdTicket = _parteHoraTicketId,
                    IdTecnico = linea.IdTecnico,
                    Usuario = CurrentUserNameForAudit,
                    TipoTrabajo = linea.TipoTrabajo,
                    Minutos = linea.TotalMinutos,
                    Facturable = _parteHoraFacturable,
                    Estado = ParteHoraEstadoKeys.Presentado,
                    Descripcion = linea.Descripcion,
                    UsuarioAccion = CurrentUserNameForAudit
                }));
            }

            var totalMinutes = lineas.Sum(linea => linea.TotalMinutos);

            await ConversacionesSvc.AddInternalEventAsync(new ConversacionEventoInternoRequest
            {
                IdConversacion = _parteHoraConversationId.Value,
                Texto = idsPartes.Count == 1
                    ? $"{CurrentMessageTechnicianName} guardó el parte de horas #{idsPartes[0].ToString(System.Globalization.CultureInfo.InvariantCulture)} por {FormatParteHorasDuration(totalMinutes)}."
                    : $"{CurrentMessageTechnicianName} guardó {idsPartes.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)} líneas de parte de horas por {FormatParteHorasDuration(totalMinutes)}.",
                IdTecnicoAutor = CurrentMessageTechnicianId,
                NombreTecnicoAccion = CurrentMessageTechnicianName,
                UsuarioAccion = CurrentUserNameForAudit,
                SistemaAccion = CurrentUserSystemForAudit
            });

            if (await FinalizePendingConversationCloseAsync(idsPartes.Count == 1
                    ? $"Parte de horas #{idsPartes[0].ToString(System.Globalization.CultureInfo.InvariantCulture)} guardado y conversación cerrada."
                    : $"{idsPartes.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)} líneas de parte de horas guardadas y conversación cerrada."))
                _showParteHorasDialog = false;
        }
        catch (Exception ex)
        {
            _parteHoraError = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.Message
                : "No se pudo guardar el parte de horas. Revisá los datos y volvé a intentar.";
        }
        finally
        {
            _savingParteHora = false;
        }
    }

    private async Task<bool> FinalizePendingConversationCloseAsync(string successMessage)
    {
        if (_selectedConversation is null || string.IsNullOrWhiteSpace(_parteHoraPendingCloseStatusCode))
        {
            _parteHoraError = "No se encontró un cierre pendiente para confirmar.";
            return false;
        }

        var previousValue = string.IsNullOrWhiteSpace(_parteHoraPreviousStatusCode)
            ? _statusCode
            : _parteHoraPreviousStatusCode;

        _statusCode = _parteHoraPendingCloseStatusCode;
        if (!await SaveStatusAsync())
        {
            _statusCode = previousValue;
            _parteHoraError = _actionError ?? "No se pudo cerrar la conversación. El parte quedó cargado, pero la conversación sigue abierta.";
            return false;
        }

        _parteHoraPendingCloseStatusCode = string.Empty;
        _parteHoraPreviousStatusCode = string.Empty;
        _actionMessage = successMessage;
        return true;
    }

    private ParteHorasPromptVm? BuildParteHorasPrompt(DateTime closedAt)
    {
        if (_selectedConversation is null)
            return null;

        var relevantMessages = VisibleMessages
            .Where(x => x.FechaHora != DateTime.MinValue && x.FechaHora <= closedAt.AddMinutes(2))
            .OrderBy(x => x.FechaHora)
            .ThenBy(x => x.IdMensaje)
            .ToList();

        var segment = GetParteHorasSegment(relevantMessages, _selectedConversation, closedAt);
        var minutes = (int)Math.Ceiling(Math.Max(1d, (closedAt - segment).TotalMinutes));
        minutes = Math.Clamp(minutes, 1, 24 * 60);

        return new ParteHorasPromptVm
        {
            IdConversacion = _selectedConversation.IdConversacion,
            ClienteCodigo = _selectedConversation.ClienteCodigo,
            ClienteNombre = _selectedConversation.ClienteNombre,
            IdContacto = _selectedConversation.IdContacto,
            TecnicoNombre = CurrentMessageTechnicianName,
            Inicio = segment,
            Fin = closedAt,
            MinutosSugeridos = minutes
        };
    }

    private static DateTime GetParteHorasSegment(IReadOnlyList<ConversacionMensajeDto> messages, ConversacionDetalleDto conversation, DateTime closedAt)
    {
        if (messages.Count == 0)
            return conversation.FechaHoraUltimoMensajeCliente ?? conversation.FechaHoraPrimerMensaje ?? closedAt.AddMinutes(-15);

        var boundary = messages
            .Where(IsConversationStateBoundaryMessage)
            .Select(x => x.FechaHora)
            .DefaultIfEmpty(DateTime.MinValue)
            .Max();

        var candidates = messages
            .Where(x => x.FechaHora > boundary)
            .OrderBy(x => x.FechaHora)
            .ThenBy(x => x.IdMensaje)
            .ToList();

        if (candidates.Count == 0)
            candidates = messages.ToList();

        var anchorIndex = candidates.FindLastIndex(x => IsIncomingMessage(x));
        if (anchorIndex < 0)
            anchorIndex = candidates.Count - 1;

        var startIndex = anchorIndex;
        for (var i = anchorIndex; i > 0; i--)
        {
            var gap = candidates[i].FechaHora - candidates[i - 1].FechaHora;
            if (gap > TimeSpan.FromHours(1))
                break;

            startIndex = i - 1;
        }

        var start = candidates[startIndex].FechaHora;
        if (start > closedAt)
            return closedAt.AddMinutes(-1);

        return start;
    }

    private static bool IsConversationStateBoundaryMessage(ConversacionMensajeDto message)
    {
        if (!string.Equals(message.Direction, "NOTA_INTERNA", StringComparison.OrdinalIgnoreCase)
            || !string.Equals(message.MessageType, "SYSTEM", StringComparison.OrdinalIgnoreCase))
            return false;

        var text = NormalizeSimpleText(message.Texto);
        return text.Contains("cerro la conversacion", StringComparison.Ordinal)
               || text.Contains("cambio el estado", StringComparison.Ordinal)
               || text.Contains("reabr", StringComparison.Ordinal);
    }

    private static string NormalizeSimpleText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return value.Trim().ToLowerInvariant()
            .Replace('á', 'a')
            .Replace('é', 'e')
            .Replace('í', 'i')
            .Replace('ó', 'o')
            .Replace('ú', 'u')
            .Replace('ü', 'u')
            .Replace('ñ', 'n');
    }

    private static string BuildParteHoraDescription(ParteHorasPromptVm prompt)
    {
        var tecnico = string.IsNullOrWhiteSpace(prompt.TecnicoNombre) ? "Sin técnico" : prompt.TecnicoNombre;
        return $"Atención de conversación #{prompt.IdConversacion.ToString(System.Globalization.CultureInfo.InvariantCulture)}. Tiempo sugerido {FormatParteHorasDuration(prompt.MinutosSugeridos)}. Tramo {prompt.Inicio:dd/MM HH:mm} - {prompt.Fin:dd/MM HH:mm}. Técnico: {tecnico}.";
    }

    private void QueueContextNotesLoad()
    {
        var conversation = _selectedConversation;
        var idConversacion = conversation?.IdConversacion;
        var sourceKey = BuildContextNotesSourceKey(conversation);
        var sameSource = _contextNotesConversationId == idConversacion
                         && string.Equals(_contextNotesSourceKey, sourceKey, StringComparison.Ordinal);

        if (conversation is null || conversation.Canal == "INTERNO")
        {
            if (!sameSource)
                ClearContextNotesState();
            return;
        }

        if (!conversation.IdContacto.HasValue
            && string.IsNullOrWhiteSpace(conversation.ClienteCodigo)
            && !HasContactLookupData(conversation))
        {
            if (!sameSource)
                ClearContextNotesState();
            return;
        }

        if (sameSource && (_loadingContextNotes || _contextNotesLoaded))
            return;

        if (!sameSource)
        {
            _contextNotes = _contextNotesCache.TryGetValue(sourceKey, out var cachedNotes)
                ? cachedNotes
                : ContextNotesVm.Empty;
            _showContextNotesModal = false;
            _contextNotesTab = _contextNotes.ObservationSections.Count > 0
                ? ContextNotesTabs.Observaciones
                : ContextNotesTabs.OtrasNotas;
            _contextNotesLoaded = false;
        }

        _contextNotesConversationId = idConversacion;
        _contextNotesSourceKey = sourceKey;
        _loadingContextNotes = true;
        _ = InvokeAsync(async () =>
        {
            await LoadContextNotesAsync(idConversacion!.Value);
            StateHasChanged();
        });
    }

    private async Task LoadContextNotesAsync(long idConversacion)
    {
        var conversation = _selectedConversation;
        if (conversation is null || conversation.IdConversacion != idConversacion || conversation.Canal == "INTERNO")
            return;

        try
        {
            var sections = new List<ContextNoteSectionVm>();

            var hasContactObservation = AddContextNoteSection(sections, ContextNoteKind.Observacion, "Contacto - Observaciones", conversation.ContactoObservaciones);
            if (!hasContactObservation)
            {
                var contact = await ResolveContextContactAsync(conversation);
                AddContextNoteSection(sections, ContextNoteKind.Observacion, "Contacto - Observaciones", contact?.Observaciones);
            }
            AddContextNoteSection(sections, ContextNoteKind.OtraNota, "Contacto - Notas", conversation.ContactoNotas);

            if (!string.IsNullOrWhiteSpace(conversation.ClienteCodigo))
            {
                var hasClientObservation = AddContextNoteSection(sections, ContextNoteKind.Observacion, "Cliente - Observaciones", conversation.ClienteObservaciones);
                var hasClientExpandedNote = AddContextNoteSection(sections, ContextNoteKind.OtraNota, "Cliente - Nota ampliada", conversation.ClienteNotaCuenta);

                var client = await CuentasSvc.GetByIdAsync(CuentaComercialTipo.Cliente, conversation.ClienteCodigo);

                if (!hasClientObservation)
                    AddContextNoteSection(sections, ContextNoteKind.Observacion, "Cliente - Observaciones", client?.Observaciones);
                AddContextNoteSection(sections, ContextNoteKind.OtraNota, "Cliente - Manual interno", client?.Manual);
                if (!hasClientExpandedNote)
                    AddContextNoteSection(sections, ContextNoteKind.OtraNota, "Cliente - Nota ampliada", client?.NotaCuenta);
            }

            if (_contextNotesConversationId == idConversacion && _selectedConversation?.IdConversacion == idConversacion)
            {
                var notes = ContextNotesVm.FromSections(sections);
                _contextNotes = notes;
                var sourceKey = BuildContextNotesSourceKey(conversation);
                if (notes.HasContent)
                    _contextNotesCache[sourceKey] = notes;
                else
                    _contextNotesCache.Remove(sourceKey);
            }
        }
        catch
        {
            if (_contextNotesConversationId == idConversacion && !_contextNotes.HasContent)
                _contextNotes = ContextNotesVm.Empty;
        }
        finally
        {
            if (_contextNotesConversationId == idConversacion)
            {
                _loadingContextNotes = false;
                _contextNotesLoaded = true;
            }
        }
    }

    private static string BuildContextNotesSourceKey(ConversacionDetalleDto? conversation)
        => conversation is null
            ? string.Empty
            : $"{conversation.Canal}|{conversation.IdContacto?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty}|{conversation.ClienteCodigo?.Trim() ?? string.Empty}|{NormalizePhoneForCompare(conversation.TelefonoWhatsApp)}|{NormalizePhoneForCompare(conversation.ContactoCelular)}|{NormalizePhoneForCompare(conversation.ContactoTelefono)}|{conversation.ContactoEmail?.Trim().ToUpperInvariant() ?? string.Empty}|{BuildContextNotesVersion(conversation.ContactoObservaciones)}|{BuildContextNotesVersion(conversation.ContactoNotas)}|{BuildContextNotesVersion(conversation.ClienteObservaciones)}|{BuildContextNotesVersion(conversation.ClienteNotaCuenta)}";

    private static string BuildContextNotesVersion(string? value)
    {
        var clean = NormalizeContextNoteText(value);
        return clean.Length == 0
            ? "0"
            : $"{clean.Length}:{clean.GetHashCode(StringComparison.Ordinal)}";
    }

    private async Task<ContactoDetailDto?> ResolveContextContactAsync(ConversacionDetalleDto conversation)
    {
        if (conversation.IdContacto is int idContacto)
            return await ContactosSvc.GetByIdAsync(idContacto);

        var candidate = await FindContextContactCandidateAsync(conversation);
        return candidate is null ? null : await ContactosSvc.GetByIdAsync(candidate.Id);
    }

    private async Task<ContactoGridItemDto?> FindContextContactCandidateAsync(ConversacionDetalleDto conversation)
    {
        foreach (var term in GetContextContactLookupTerms(conversation))
        {
            var result = await ContactosSvc.SearchAsync(new ContactosFilters
            {
                Texto = term,
                Activo = true,
                PageNumber = 1,
                PageSize = 8
            });

            var match = result.Items.FirstOrDefault(item => IsSameContextContact(item, conversation));
            if (match is not null)
                return match;
        }

        return null;
    }

    private static bool HasContactLookupData(ConversacionDetalleDto conversation)
        => GetContextContactLookupTerms(conversation).Any();

    private static IEnumerable<string> GetContextContactLookupTerms(ConversacionDetalleDto conversation)
    {
        foreach (var value in new[]
        {
            conversation.TelefonoWhatsApp,
            conversation.ContactoCelular,
            conversation.ContactoTelefono,
            conversation.ContactoEmail
        })
        {
            var clean = (value ?? string.Empty).Trim();
            if (clean.Length >= 4)
                yield return clean;
        }
    }

    private static bool IsSameContextContact(ContactoGridItemDto item, ConversacionDetalleDto conversation)
    {
        var targetPhones = new[]
        {
            conversation.TelefonoWhatsApp,
            conversation.ContactoCelular,
            conversation.ContactoTelefono
        }
            .Select(NormalizePhoneForCompare)
            .Where(static value => value.Length >= 6)
            .ToHashSet(StringComparer.Ordinal);

        if (targetPhones.Count > 0)
        {
            var itemPhones = new[] { item.Celular, item.Telefono }
                .Select(NormalizePhoneForCompare)
                .Where(static value => value.Length >= 6);

            if (itemPhones.Any(phone => targetPhones.Any(target => PhonesLookEquivalent(target, phone))))
                return true;
        }

        return !string.IsNullOrWhiteSpace(conversation.ContactoEmail)
               && !string.IsNullOrWhiteSpace(item.Email)
               && string.Equals(conversation.ContactoEmail.Trim(), item.Email.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePhoneForCompare(string? phone)
        => Regex.Replace(phone ?? string.Empty, @"\D+", string.Empty);

    private static bool PhonesLookEquivalent(string left, string right)
        => left == right
           || (left.Length >= 8 && right.EndsWith(left[^Math.Min(left.Length, 10)..], StringComparison.Ordinal))
           || (right.Length >= 8 && left.EndsWith(right[^Math.Min(right.Length, 10)..], StringComparison.Ordinal));

    private static bool AddContextNoteSection(List<ContextNoteSectionVm> sections, ContextNoteKind kind, string label, string? text)
    {
        var clean = NormalizeContextNoteText(text);
        if (string.IsNullOrWhiteSpace(clean))
            return false;

        sections.Add(new ContextNoteSectionVm(kind, label, clean));
        return true;
    }

    private static string NormalizeContextNoteText(string? text)
        => AlfaCore.Services.TextoEnriquecidoCompat.NormalizarComoTextoPlano(text)
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Replace('\r', '\n')
            .Trim();

    private static string BuildOneLinePreview(string text)
    {
        var oneLine = Regex.Replace(text ?? string.Empty, @"\s+", " ").Trim();
        if (oneLine.Length <= 120)
            return oneLine;

        return $"{oneLine[..120]}...";
    }

    private void QueueContextTicketsLoad()
    {
        var idConversacion = _selectedConversation?.IdConversacion;
        var conversationChanged = _contextTicketsConversationId != idConversacion;
        _contextTicketsConversationId = idConversacion;

        if (_selectedConversation is null || _selectedConversation.Canal == "INTERNO")
        {
            _contextTicketMatches.Clear();
            _loadingContextTickets = false;
            return;
        }

        // Al refrescar la MISMA conversación (poll cada 3s) no limpiamos la lista antes de
        // tener el resultado nuevo: hacerlo hacía que la sección de tickets parpadeara
        // (vacía -> repoblada) cada vez que corría el auto-refresh.
        if (conversationChanged)
        {
            _contextTicketMatches.Clear();
            _loadingContextTickets = true;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadContextTicketsAsync(idConversacion!.Value);
            StateHasChanged();
        });
    }

    private async Task LoadContextTicketsAsync(long idConversacion)
    {
        var conversation = _selectedConversation;
        if (conversation is null || conversation.IdConversacion != idConversacion || conversation.Canal == "INTERNO")
            return;

        try
        {
            var matches = await TicketsSvc.FindRelatedOpenTicketsAsync(new TicketRelatedSearchRequest
            {
                ClienteCodigo = conversation.ClienteCodigo,
                IdContacto = conversation.IdContacto,
                IdConversacion = conversation.IdConversacion
            });

            if (_contextTicketsConversationId == idConversacion && _selectedConversation?.IdConversacion == idConversacion)
                _contextTicketMatches = matches.ToList();
        }
        catch
        {
            // Background refresh failure for the same conversation: keep showing the last
            // known-good list instead of flashing it empty.
        }
        finally
        {
            if (_contextTicketsConversationId == idConversacion)
                _loadingContextTickets = false;
        }
    }

    private string GetContextTicketsSubtitle()
    {
        if (_loadingContextTickets)
            return "Buscando tickets abiertos relacionados.";
        if (_contextTicketMatches.Count == 0)
            return "Sin tickets abiertos relacionados.";
        return $"{_contextTicketMatches.Count} ticket(s) abierto(s) relacionados.";
    }

    private string BuildDefaultTicketTitle()
    {
        var source = FirstNonEmpty(
            _selectedConversation?.ResumenUltimoMensaje,
            _selectedConversation?.ClienteNombre,
            _selectedConversation?.ContactoNombre,
            _selectedConversation?.NombreVisible,
            "Nuevo ticket de asistencia");

        return source.Length <= 80 ? source : source[..80];
    }

    private async Task DebounceContactSuggestionsAsync()
    {
        CancelContactSearch();

        if (!ShouldShowContactSuggestions)
        {
            _showContactSuggestions = false;
            _contactSuggestions = [];
            _conversationSuggestions = [];
            return;
        }

        _showContactSuggestions = true;
        _loadingContactSuggestions = true;
        var cts = new CancellationTokenSource();
        _contactSearchCts = cts;

        try
        {
            await Task.Delay(220, cts.Token);
            var contactTask = ContactosSvc.SearchAsync(new ContactosFilters
            {
                Texto = _filters.Search.Trim(),
                Activo = true,
                PageNumber = 1,
                PageSize = 6
            }, cts.Token);
            var conversationTask = ConversacionesSvc.GetInboxAsync(new ConversacionesInboxFilters
            {
                Canal = _canalActivo,
                Modo = "todas",
                Search = _filters.Search.Trim(),
                IdTecnicoActual = string.Empty,
                CodigoEstado = string.Empty,
                UsuarioActual = CurrentUserNameForAudit,
                SistemaActual = CurrentUserSystemForAudit,
                Limit = 6
            }, cts.Token);

            await Task.WhenAll(contactTask, conversationTask);

            if (!cts.IsCancellationRequested)
            {
                _conversationSuggestions = (await conversationTask)
                    .Where(x => MatchesConversationSearch(x, _filters.Search.Trim()))
                    .Take(6)
                    .ToList();
                _contactSuggestions = (await contactTask).Items
                    .Where(contact => !_conversationSuggestions.Any(conversation => IsSameContactSuggestion(conversation, contact)))
                    .Take(6)
                    .ToList();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _contactSuggestions = [];
            _conversationSuggestions = [];
            _actionError = ex.Message;
        }
        finally
        {
            if (_contactSearchCts == cts)
            {
                _loadingContactSuggestions = false;
                _contactSearchCts = null;
            }
        }
    }

    private void StoreConversationCache(long idConversacion)
    {
        if (_selectedConversation is null)
            return;

        _conversationCache[idConversacion] = new ConversationViewCache(
            _selectedConversation,
            OrderConversationMessages(_messages),
            _adjuntosPorMensaje.ToDictionary(x => x.Key, x => x.Value.ToList()),
            _conversationTotalMessageCount,
            _hasMoreOlderMessages,
            DateTime.UtcNow);

        const int maxCachedConversations = 16;
        if (_conversationCache.Count <= maxCachedConversations)
            return;

        var firstKey = _conversationCache.Keys.FirstOrDefault(x => x != idConversacion);
        if (firstKey > 0)
            _conversationCache.Remove(firstKey);
    }

    private void ApplyConversationCache(long idConversacion, ConversationViewCache cache, bool scrollToBottom)
    {
        _selectedConversation = cache.Conversation;
        _messages = OrderConversationMessages(cache.Messages);
        _adjuntosPorMensaje = cache.AttachmentsByMessage.ToDictionary(x => x.Key, x => x.Value.ToList());
        _conversationTotalMessageCount = cache.TotalMessages;
        _hasMoreOlderMessages = cache.HasMoreOlderMessages;
        _assignmentTechnicianId = _selectedConversation.IdTecnico;
        _statusCode = _selectedConversation.CodigoEstado;
        _conversationError = null;
        _scrollThreadToBottomAfterRender = scrollToBottom;
        _threadAnchoringToBottom = scrollToBottom;
        _focusReplyAfterRender = scrollToBottom;
        _scrollHandlerConversationId = null;
        _fileDropHandlerConversationId = null;
        RestoreSelectedNewMessageMarker(idConversacion);
    }

    private static bool IsConversationCacheFresh(ConversationViewCache cache)
        => DateTime.UtcNow - cache.CachedAtUtc <= ConversationCacheTtl;

    private void StoreChannelCache(string canal)
    {
        _channelCache[canal] = new ConversationChannelCache(
            CloneFilters(_filters),
            _inbox.ToList(),
            _selectedConversationId);
    }

    private bool TryApplyChannelCache(string canal)
    {
        if (!_channelCache.TryGetValue(canal, out var cache))
            return false;

        _filters = CloneFilters(cache.Filters);
        _filters.Canal = canal;
        _inbox = cache.Inbox.ToList();

        if (cache.SelectedConversationId is long selectedId
            && _conversationCache.TryGetValue(selectedId, out var conversationCache))
        {
            _selectedConversationId = selectedId;
            ApplyConversationCache(selectedId, conversationCache, scrollToBottom: true);
        }
        else
        {
            ClearSelection();
        }

        return true;
    }

    private static ConversacionesInboxFilters CloneFilters(ConversacionesInboxFilters filters)
        => new()
        {
            Modo = filters.Modo,
            Search = filters.Search,
            ClienteCodigo = filters.ClienteCodigo,
