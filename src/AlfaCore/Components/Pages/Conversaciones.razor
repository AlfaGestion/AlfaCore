        {
            var userName = NormalizeComparable(CurrentUserNameForAudit);
            if (string.IsNullOrWhiteSpace(userName))
                return null;

            var systemCode = NormalizeComparable(CurrentUserSystemForAudit);
            return _technicians.FirstOrDefault(tech =>
                NormalizeComparable(tech.UsuarioAsociado) == userName
                && (string.IsNullOrWhiteSpace(systemCode)
                    || string.IsNullOrWhiteSpace(NormalizeComparable(tech.SistemaAsociado))
                    || NormalizeComparable(tech.SistemaAsociado) == systemCode))
                ?? _technicians.FirstOrDefault(tech => NormalizeComparable(tech.UsuarioAsociado) == userName)
                ?? _technicians.FirstOrDefault(tech => NormalizeComparable(tech.Nombre) == userName);
        }
    }

