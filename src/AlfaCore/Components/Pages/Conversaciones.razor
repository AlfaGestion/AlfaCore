    private async Task SendReactionAsync(long messageId, string emoji)
    {
        if (_selectedConversation is null || _reactionSendingMessageId.HasValue)
            return;

        var target = _messages.FirstOrDefault(x => x.IdMensaje == messageId);
        if (target is null || string.IsNullOrWhiteSpace(target.WhatsAppMessageId))
            return;

        var conversationId = _selectedConversation.IdConversacion;
        var optimisticId = -DateTime.UtcNow.Ticks;
        _openReactionMessageId = null;
        _reactionSendingMessageId = messageId;
        _actionMessage = null;
        _actionError = null;
        _messages.Add(new ConversacionMensajeDto
        {
            IdMensaje = optimisticId,
            IdConversacion = conversationId,
            WhatsAppReplyToMessageId = target.WhatsAppMessageId,
            MessageType = "REACTION",
            Direction = "SALIENTE",
            EstadoEnvio = "PENDIENTE",
            Texto = emoji,
            FechaHora = DateTime.Now,
            UsuarioAutor = CurrentUserNameForAudit,
            SistemaAutor = CurrentUserSystemForAudit,
            IdTecnicoAutor = CurrentMessageTechnicianId
        });
        await InvokeAsync(StateHasChanged);

        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(25));
            var result = await ConversacionesSvc.SendReactionAsync(new ConversacionReaccionRequest
            {
                IdConversacion = conversationId,
                IdMensaje = messageId,
                Emoji = emoji,
                IdTecnicoAutor = CurrentMessageTechnicianId,
                UsuarioAccion = CurrentUserNameForAudit,
                SistemaAccion = CurrentUserSystemForAudit
            }, timeout.Token);

            var optimistic = _messages.FirstOrDefault(x => x.IdMensaje == optimisticId);
            if (optimistic is not null)
            {
                optimistic.IdMensaje = result.IdMensaje;
                optimistic.WhatsAppMessageId = result.WhatsAppMessageId;
                optimistic.EstadoEnvio = result.EstadoEnvio;
            }
        }
        catch (OperationCanceledException)
        {
            _messages.RemoveAll(x => x.IdMensaje == optimisticId);
            _actionError = "No se pudo enviar la reacción a tiempo. Revisá la conexión y reintentá.";
        }
        catch (Exception ex)
        {
            _messages.RemoveAll(x => x.IdMensaje == optimisticId);
            _actionError = ex.Message;
        }
        finally
        {
            _reactionSendingMessageId = null;
        }
    }

