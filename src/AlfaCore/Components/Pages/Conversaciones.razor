    private void ShowRelativePreviewAttachment(int offset)
    {
        if (_previewAttachment is null)
            return;

        var gallery = PreviewGallery;
        if (gallery.Count <= 1)
            return;

        var index = gallery.ToList().FindIndex(item => item.IdAdjunto == _previewAttachment.IdAdjunto);
        if (index < 0)
            index = 0;

        var nextIndex = (index + offset + gallery.Count) % gallery.Count;
        OpenAttachmentPreview(gallery[nextIndex]);
    }

