    private string TypingIndicatorText
    {
        get
        {
            var names = _typingUsers
                .Select(x => FirstNonEmpty(x.NombreTecnico, x.Usuario))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(3)
                .ToList();

            return names.Count switch
            {
                0 => string.Empty,
                1 => $"{names[0]} est\u00e1 escribiendo...",
                2 => $"{names[0]} y {names[1]} est\u00e1n escribiendo...",
                _ => $"{names[0]}, {names[1]} y alguien m\u00e1s est\u00e1n escribiendo..."
            };
        }
    }
