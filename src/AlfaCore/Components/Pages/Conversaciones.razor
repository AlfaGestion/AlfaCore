    private async Task DismissConversationNoticesAsync()
    {
        if (_showComposerTools)
        {
            _showComposerTools = false;
            StateHasChanged();
        }

        var signature = BuildNoticeSignature();
        if (string.IsNullOrWhiteSpace(signature))
        {
            _noticeLeaving = false;
            _noticeSignature = string.Empty;
            _noticeSetAtUtc = DateTime.MinValue;
            return;
        }

        if (!string.Equals(signature, _noticeSignature, StringComparison.Ordinal))
        {
            _noticeSignature = signature;
            _noticeSetAtUtc = DateTime.UtcNow;
            _noticeLeaving = false;
            return;
        }

        if (_noticeLeaving || DateTime.UtcNow - _noticeSetAtUtc < TimeSpan.FromMilliseconds(350))
            return;

        _noticeLeaving = true;
        StateHasChanged();
        await Task.Delay(180);
        _conversationError = null;
        _actionMessage = null;
        _actionError = null;
        _nuevoHiloError = null;
        _ticketError = null;
        _noticeLeaving = false;
        _noticeSignature = string.Empty;
        _noticeSetAtUtc = DateTime.MinValue;
    }

    private string GetConversationNoticeLeavingClass()
        => _noticeLeaving ? "is-leaving" : string.Empty;

    private string BuildNoticeSignature()
        => string.Join("|", new[]
        {
            _conversationError,
            _actionMessage,
            _actionError,
            _nuevoHiloError,
            _ticketError
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

