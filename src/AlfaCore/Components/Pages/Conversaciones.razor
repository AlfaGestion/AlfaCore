    private async Task SaveParteHoraTicketAsync()
    {
        if (string.IsNullOrWhiteSpace(_parteHoraTicketTitle))
        {
            _parteHoraError = "Ingresá el título del ticket.";
            return;
        }

        _savingParteHoraTicket = true;
        _parteHoraTicketError = null;
        _parteHoraError = null;
        try
        {
            if (_parteHoraTicketMode == ParteHoraTicketPanelMode.Create)
            {
                var id = await TicketsSvc.CreateAsync(new TicketCreateRequest
                {
                    Titulo = _parteHoraTicketTitle,
                    Descripcion = _parteHoraTicketDescription,
                    CodigoEstado = _parteHoraTicketState,
                    Prioridad = _parteHoraTicketPriority,
                    IdTecnico = CurrentMessageTechnicianId,
                    ClienteCodigo = _parteHoraClienteCodigo,
                    IdContacto = _parteHoraIdContacto,
                    IdConversacion = _parteHoraConversationId,
                    UsuarioAccion = CurrentUserNameForAudit
                });
                _parteHoraTicketId = id;
            }
            else if (_parteHoraTicketMode == ParteHoraTicketPanelMode.Edit && _parteHoraTicketDetail is not null)
            {
                await TicketsSvc.UpdateAsync(new TicketUpdateRequest
                {
                    IdTicket = _parteHoraTicketDetail.IdTicket,
                    Titulo = _parteHoraTicketTitle,
                    Descripcion = _parteHoraTicketDescription,
                    CodigoEstado = _parteHoraTicketState,
                    Prioridad = _parteHoraTicketPriority,
                    IdTecnico = FirstNonEmpty(_parteHoraTicketDetail.IdTecnico, CurrentMessageTechnicianId),
                    ClienteCodigo = _parteHoraClienteCodigo,
                    IdContacto = _parteHoraIdContacto,
                    IdEtiquetas = _parteHoraTicketDetail.Etiquetas.Select(x => x.IdEtiqueta).ToList(),
                    UsuarioAccion = CurrentUserNameForAudit
                });
                _parteHoraTicketId = _parteHoraTicketDetail.IdTicket;
            }

            await RefreshParteHoraTicketsAsync();
            if (_parteHoraTicketId.HasValue)
                await PreviewParteHoraTicketAsync();
        }
        catch (Exception ex)
        {
            _parteHoraError = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.Message
                : "No se pudo guardar el ticket.";
            _parteHoraTicketError = ex.Message;
        }
        finally
        {
            _savingParteHoraTicket = false;
        }
    }

    private async Task CloseParteHoraTicketAsync()
    {
        if (!_parteHoraTicketId.HasValue)
            return;

        _loadingParteHoraTicket = true;
        _parteHoraError = null;
        try
        {
            await TicketsSvc.QuickUpdateAsync(new TicketQuickUpdateRequest
            {
                IdTicket = _parteHoraTicketId.Value,
                CodigoEstado = TicketEstadoKeys.Cerrado,
                UsuarioAccion = CurrentUserNameForAudit
            });

            var closedId = _parteHoraTicketId.Value;
            await RefreshParteHoraTicketsAsync();
            if (_parteHoraTicketId == closedId)
                _parteHoraTicketId = null;

            _parteHoraTicketDetail = null;
            _parteHoraTicketMode = ParteHoraTicketPanelMode.None;
        }
        catch (Exception ex)
        {
            _parteHoraError = $"No se pudo eliminar el ticket de la lista: {ex.Message}";
        }
        finally
        {
