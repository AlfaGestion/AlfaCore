    private async Task EnsureGeneralThreadSelectedAsync()
    {
        var general = _inbox.FirstOrDefault(x =>
            string.Equals(x.Canal, "INTERNO", StringComparison.OrdinalIgnoreCase)
            && string.Equals(x.NombreVisible, HiloGeneralNombre, StringComparison.OrdinalIgnoreCase));

