    private async Task LoadOlderMessagesAsync()
    {
        if (_selectedConversationId is not { } idConversacion
            || _loadingOlderMessages
            || !_hasMoreOlderMessages
            || _messages.Count == 0)
            return;

        var oldestLoadedMessage = GetOldestLoadedMessage();
        if (oldestLoadedMessage is null)
            return;

        _loadingOlderMessages = true;
        try
        {
            var scrollBeforePrepend = await GetThreadScrollStateAsync();
            var page = await ConversacionesSvc.GetMessagesPageAsync(
                idConversacion,
                ConversationMessagePageSize,
                oldestLoadedMessage.FechaHora,
                oldestLoadedMessage.IdMensaje);

            var messageIds = page.Messages
                .Select(x => x.IdMensaje)
                .Distinct()
                .ToArray();
            var adjuntos = messageIds.Length == 0
                ? []
                : await ConversacionesSvc.GetMessageAttachmentsAsync(idConversacion, messageIds);

            PrependConversationMessagesPage(page, adjuntos);
            _pendingThreadScrollRestoreAfterPrepend = scrollBeforePrepend;
            StoreConversationCache(idConversacion);
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _loadingOlderMessages = false;
        }
    }

