@page "/conversaciones"
@page "/{idweb}/{idbase:int}/conversaciones"
@using System.IO
@using System.Net
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.WebUtilities
@inject AlfaCore.Services.IConversacionesService ConversacionesSvc
@inject AlfaCore.Services.IConversacionesConfigService ConfigSvc
@inject AlfaCore.Services.IContactosService ContactosSvc
@inject AlfaCore.Services.ICuentasComercialesService CuentasSvc
@inject AlfaCore.Services.ITicketsService TicketsSvc
@inject AlfaCore.Services.IPartesHorasService PartesHorasSvc
@inject AlfaCore.Services.ICentralAdminService AdminSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IFloatingWindowService FloatingWindows
@inject AlfaCore.Services.IAlfaKnowledgeSuggestionService AlfaKnowledgeSvc
@inject AlfaCore.Services.INotificacionesPushService PushSvc
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>@ConversationPageTitle</PageTitle>

<style>
    .conversations-hours-lines {
        display: grid;
        gap: 8px;
        grid-column: 1 / -1;
    }

    .conversations-hours-lines__header,
    .conversations-hours-lines__row {
        display: grid;
        grid-template-columns: minmax(135px, .8fr) minmax(125px, .65fr) minmax(240px, 1.45fr) 84px 92px 38px;
        gap: 8px;
        align-items: center;
    }

    .conversations-hours-lines__header {
        color: var(--color-muted);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .conversations-hours-lines__row input,
    .conversations-hours-lines__row select {
        min-width: 0;
        width: 100%;
        border: 1px solid rgba(125, 161, 207, .28);
        border-radius: 8px;
        background: rgba(15, 23, 42, .62);
        color: var(--color-text);
        outline: none;
    }

    .conversations-hours-lines__row input:focus,
    .conversations-hours-lines__row select:focus {
        border-color: rgba(8, 197, 218, .85);
        box-shadow: 0 0 0 1px rgba(8, 197, 218, .18);
    }

    .conversations-hours-lines__row select option {
        background: #111827;
        color: var(--color-text);
    }

    @@media (max-width: 720px) {
        .conversations-hours-lines__header {
            display: none;
        }

        .conversations-hours-lines__row {
            grid-template-columns: 1fr 1fr;
            padding: 10px;
            border: 1px solid var(--color-border);
            border-radius: 8px;
        }

        .conversations-hours-lines__row input[type="text"] {
            grid-column: 1 / -1;
        }
    }

    .conversations-hours-dialog {
        width: min(980px, calc(100vw - 48px)) !important;
        max-width: min(980px, calc(100vw - 48px)) !important;
        padding: 0 !important;
        overflow: hidden;
    }

    .conversations-hours-form {
        grid-template-columns: minmax(150px, 190px) minmax(170px, 210px) minmax(0, 1fr) !important;
        align-items: end;
        padding: 0 24px 18px !important;
        gap: 16px 14px !important;
    }

    .conversations-hours-ticket-field select {
        min-height: 42px;
    }

    .conversations-hours-ticket-tools {
        display: none !important;
    }

    .conversations-hours-dialog__head {
        margin: 0 !important;
        padding: 24px 24px 20px !important;
        border-bottom: 1px solid rgba(125, 161, 207, .18);
        background: linear-gradient(90deg, rgba(8, 47, 73, .72), rgba(15, 23, 42, .18));
    }

    .conversations-hours-summary {
        padding: 18px 24px 10px !important;
        gap: 12px !important;
    }

    .conversations-hours-summary > div {
        min-height: 76px;
    }

    .conversations-hours-lines {
        margin-top: 2px;
        padding: 14px 14px 12px;
        border: 1px solid rgba(125, 161, 207, .16);
        border-radius: 10px;
        background: rgba(4, 12, 24, .32);
    }

    .conversations-hours-lines__row {
        padding: 8px;
        border: 1px solid rgba(125, 161, 207, .12);
        border-radius: 9px;
        background: rgba(8, 18, 32, .78);
    }

    .conversations-hours-lines__row input,
    .conversations-hours-lines__row select {
        min-height: 38px;
    }

    .conversations-hours-lines .actions {
        margin-top: 4px;
    }

    .conversations-hours-actions {
        margin: 0 !important;
        padding: 16px 24px 20px !important;
        border-top: 1px solid rgba(125, 161, 207, .16);
        background: rgba(15, 23, 42, .38) !important;
    }
</style>

<section id="conversations-page"
         class="page-grid conversations-page conversations-page--odoo @GetChannelCssClass() @(IsMobileChatView ? "conversations-page--chat-active" : string.Empty) @(_showAiSuggestionPanel ? "conversations-page--ai-open" : string.Empty)"
         @onclick="DismissConversationNoticesAsync">
    @if (_loadError is not null)
    {
        <div class="panel-card empty-state">
            <span class="empty-state__eyebrow">Conversaciones</span>
            <h3>No fue posible cargar el módulo</h3>
            <p>@_loadError</p>
            @if (IsInitializationPending(_loadError))
            {
                <p>Pasos sugeridos: ejecutar <code>docs/conversaciones_modelo_inicial.sql</code> en la base activa, recargar la pantalla y revisar <code>AUX_ERR</code> si el incidente persiste.</p>
            }
        </div>
    }
    else
    {
        <div class="conversations-core-workspace">
        <section class="panel-card conversations-filters conversations-mobile-filters mobile-only" @onclick:stopPropagation>
            <div class="conversations-mobile-header">
                <div>
                    <h2>Conversaciones</h2>
                    <span>@_inbox.Count conversación(es)</span>
                </div>
                <button type="button" class="conversations-mobile-icon-button" @onclick="RecargarAsync" disabled="@(_loadingInbox || _loadingConversation)" title="Recargar">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <div class="conversations-mobile-actions mobile-actions">
                <button type="button"
                        class="conversations-mobile-action @(_canalActivo == "SOCIAL" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("SOCIAL")'>
                    <i class="bi bi-inboxes"></i>
                    <span>Todos</span>
                </button>
                <button type="button"
                        class="conversations-mobile-action @(_canalActivo == "WHATSAPP" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("WHATSAPP")'>
                    <i class="bi bi-whatsapp"></i>
                    <span>WhatsApp</span>
                </button>
                <button type="button"
                        class="conversations-mobile-action conversations-mobile-action--instagram @(_canalActivo == "INSTAGRAM" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("INSTAGRAM")'>
                    <i class="bi bi-instagram"></i>
                    <span>Instagram</span>
                </button>
                <button type="button"
                        class="conversations-mobile-action @(_canalActivo == "FACEBOOK" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("FACEBOOK")'>
                    <i class="bi bi-facebook"></i>
                    <span>Facebook</span>
                </button>
                <button type="button"
                        class="conversations-mobile-action conversations-mobile-action--mercadolibre @(_canalActivo == "MERCADOLIBRE" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("MERCADOLIBRE")'>
                    <i class="bi bi-bag-fill"></i>
                    <span>Mercado Libre</span>
                </button>
                <button type="button"
                        class="conversations-mobile-action @(_canalActivo == "INTERNO" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("INTERNO")'>
                    <i class="bi bi-people-fill"></i>
                    <span>Chat interno</span>
                </button>
                <button type="button"
                        class="conversations-mobile-action"
                        @onclick="ToggleContextPanel"
                        disabled="@(_selectedConversation is null)">
                    <i class="bi bi-layout-sidebar-inset-reverse"></i>
                    <span>Contexto</span>
                    @if (HasContextNotes)
                    {
                        <span class="conversation-badge" style="margin-left:.25rem;border-color:rgba(45,212,191,.85);color:#67e8f9;background:rgba(14,116,144,.28);">Notas</span>
                    }
                </button>
                @if (_ticketsModuloActivo)
                {
                    <button type="button"
                            class="conversations-mobile-action"
                            @onclick="StartTicketSelection"
                            disabled="@(_selectedConversation is null || _messages.Count == 0)">
                        <i class="bi bi-plus-lg"></i>
                        <span>Ticket</span>
                    </button>
                }
            </div>

            <div class="conversations-mobile-quick-filters mobile-filter-chips" aria-label="Filtros rápidos">
                <button type="button"
                        class="conversations-mobile-chip @(_filters.Modo == "todas" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeModeAsync("todas")'>
                    Todas
                </button>
                <button type="button"
                        class="conversations-mobile-chip @(_filters.Modo == "sin_asignar" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeModeAsync("sin_asignar")'>
                    Sin asignar
                </button>
                <button type="button"
                        class="conversations-mobile-chip @(_filters.Modo == "asignadas_a_mi" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeModeAsync("asignadas_a_mi")'>
                    Asignadas a mí
                </button>
                <button type="button"
                        class="conversations-mobile-chip conversations-mobile-chip--icon"
                        @onclick="OpenMobileAdvancedFilters"
                        aria-label="Filtros avanzados">
                    <i class="bi bi-sliders"></i>
                </button>
            </div>

            <div class="conversations-mobile-states mobile-status-cards" aria-label="Estados">
                <button type="button"
                        class="conversations-mobile-state-card @(_filters.Modo == "pendientes" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeModeAsync("pendientes")'>
                    <span><i class="bi bi-clock-history"></i> Pendientes</span>
                    <strong>@MobilePendingCount</strong>
                </button>
                <button type="button"
                        class="conversations-mobile-state-card @(_filters.Modo == "cerradas" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeModeAsync("cerradas")'>
                    <span><i class="bi bi-check2-circle"></i> Cerradas</span>
                    <strong>@MobileClosedCount</strong>
                </button>
            </div>

            <div class="conversations-filters__fields">
                <div class="field">
                    <label for="conv-mobile-search">Buscar</label>
                    <input id="conv-mobile-search"
                           type="text"
                           placeholder="Buscar por teléfono, cliente, contacto, email, resumen o mensaje..."
                           value="@_filters.Search"
                           @oninput="HandleSearchInputAsync"
                           @onkeydown="HandleSearchEnter" />
                </div>

                <div class="field">
                    <label for="conv-mobile-my-tech">Técnico</label>
                    <select id="conv-mobile-my-tech" value="@_filters.IdTecnicoActual" @onchange="HandleTechnicianFilterChangedAsync">
                        <option value="">Todos</option>
                        @foreach (var tech in _technicians)
                        {
                            <option value="@tech.IdTecnico">@tech.Nombre (@tech.IdTecnico)</option>
                        }
                    </select>
                </div>
                <button type="button" class="btn btn--primary" @onclick="LoadInboxAsync" disabled="@_loadingInbox">
                    <i class="bi bi-funnel"></i> Aplicar
                </button>
                <button type="button"
                        class="btn btn--ghost conversations-filter-clear"
                        title="Limpiar filtros"
                        aria-label="Limpiar filtros"
                        @onclick="ClearConversationFiltersAsync"
                        disabled="@_loadingInbox">
                    <i class="bi bi-eraser"></i>
                </button>
            </div>
        </section>

        <section class="panel-card conversations-filters desktop-only" @onclick:stopPropagation style="position:relative;z-index:500;">
            <div class="conversations-canal">
                <div class="conversations-mode-select">
                    <button type="button"
                            popovertarget="conversations-canal-menu"
                            onclick="conversacionesUi.positionCanalMenu(this)"
                            class="conversations-filter-pill conversations-filter-pill--dropdown @(IsSocialCanalActive ? "is-active" : string.Empty)"
                            aria-haspopup="listbox"
                            aria-label="Filtro de mensajes">
                        <i class="bi @GetCurrentCanalSocialIcon()"></i>
                        @GetCurrentCanalSocialLabel()
                        <i class="bi bi-chevron-down conversations-mode-caret" style="display:inline-flex;"></i>
                    </button>
                    <div id="conversations-canal-menu" popover="auto" role="listbox"
                         style="position:fixed;right:auto;bottom:auto;margin:0;min-width:178px;padding:.28rem;border:1px solid rgba(14,165,233,.28);border-radius:12px;background:rgba(15,23,42,.98);box-shadow:0 16px 32px rgba(2,6,23,.34);">
                        @foreach (var canal in _canalSocialOptions)
                        {
                            var isCurrent = canal.Value == _canalActivo;
                            <button type="button"
                                    popovertarget="conversations-canal-menu"
                                    popovertargetaction="hide"
                                    class="conversation-header-state__option @(isCurrent ? "is-active" : string.Empty)"
                                    @onclick="() => ChangeCanalAsync(canal.Value)"
                                    role="option"
                                    aria-selected="@isCurrent">
                                <i class="bi @canal.Icono"></i> @canal.Label
                            </button>
                        }
                    </div>
                </div>
                <button type="button"
                        class="conversations-filter-pill conversations-filter-pill--mercadolibre @(_canalActivo == "MERCADOLIBRE" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("MERCADOLIBRE")'>
                    <i class="bi bi-bag-fill"></i> Mercado Libre
                </button>
                <button type="button"
                        class="conversations-filter-pill @(_canalActivo == "INTERNO" ? "is-active" : string.Empty)"
                        @onclick='() => ChangeCanalAsync("INTERNO")'>
                    <i class="bi bi-people-fill"></i> Chat interno
                </button>
                @if (_canalActivo == "INTERNO")
                {
                    <button type="button" class="btn btn--primary btn--sm" @onclick='() => _showNuevoHilo = true'>
                        <i class="bi bi-plus-circle-fill"></i> Nuevo hilo
                    </button>
                }
                @if (_canalActivo == "MERCADOLIBRE")
                {
                    <button type="button" class="btn btn--primary btn--sm conversations-sync-meli-button" @onclick="SyncMercadoLibreQuestionsAsync" disabled="@(_syncingMercadoLibre || _loadingInbox)">
                        <i class="bi bi-arrow-repeat"></i> Sincronizar
                    </button>
                }
            </div>

            <div class="conversations-module-actions">
                <button type="button" class="btn btn--ghost btn--sm conversations-context-button" @onclick="ToggleContextPanel" disabled="@(_selectedConversation is null)" title="Contexto">
                    <i class="bi bi-layout-sidebar-inset-reverse"></i>
                    <span>Contexto</span>
                    @if (HasContextNotes)
                    {
                        <span style="width:.55rem;height:.55rem;border-radius:999px;background:#22d3ee;box-shadow:0 0 0 4px rgba(34,211,238,.16),0 0 14px rgba(34,211,238,.9);display:inline-block;margin-left:.15rem;" title="Hay observaciones del cliente o contacto"></span>
                    }
                </button>
                @if (_ticketsModuloActivo)
                {
                    <button type="button" class="btn btn--primary btn--sm conversations-ticket-button" @onclick="StartTicketSelection" disabled="@(_selectedConversation is null || _messages.Count == 0)" title="Crear ticket desde mensajes">
                        <i class="bi bi-life-preserver"></i>
                        <span>Crear ticket</span>
                    </button>
                }
                @if (_alfaKnowledgeModuloActivo)
                {
                    <button type="button" class="btn btn--ghost btn--sm conversations-ai-suggestion-button @(_showAiSuggestionPanel ? "is-active" : string.Empty)" @onclick="ToggleAiSuggestionPanel" disabled="@(_selectedConversation is null)" title="Sugerencia IA">
                        <i class="bi bi-stars"></i>
                    </button>
                }
                <button type="button" class="btn btn--ghost btn--sm conversations-message-search-button @(_showMessageSearch ? "is-active" : string.Empty)" @onclick="ToggleMessageSearchAsync" disabled="@(_selectedConversation is null)" title="Buscar en esta conversación">
                    <i class="bi bi-search"></i>
                </button>
                <button type="button" class="btn btn--ghost btn--sm conversations-wait-time-button @(EsColaEspera ? "is-active" : string.Empty)" @onclick="ToggleColaEsperaAsync" title="Ordenar por tiempo de espera y prioridad, en vez de por actividad reciente">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Tiempo de espera</span>
                </button>
            </div>

            <div class="conversations-mode-select">
                <button type="button"
                        popovertarget="conversations-mode-menu"
                        onclick="conversacionesUi.positionModeMenu(this)"
                        class="conversations-filter-pill conversations-filter-pill--dropdown"
                        aria-haspopup="listbox"
                        aria-label="Filtro de conversaciones">
                    @GetCurrentModeLabel()
                    <i class="bi bi-chevron-down conversations-mode-caret" style="display:inline-flex;"></i>
                </button>
                <div id="conversations-mode-menu" popover="auto" role="listbox"
                     style="position:fixed;right:auto;bottom:auto;margin:0;min-width:178px;padding:.28rem;border:1px solid rgba(14,165,233,.28);border-radius:12px;background:rgba(15,23,42,.98);box-shadow:0 16px 32px rgba(2,6,23,.34);">
                    @foreach (var mode in _modeOptions)
                    {
                        var isCurrent = mode.Value == _filters.Modo;
                        <button type="button"
                                popovertarget="conversations-mode-menu"
                                popovertargetaction="hide"
                                class="conversation-header-state__option @(isCurrent ? "is-active" : string.Empty)"
                                @onclick="() => SelectModeAsync(mode.Value)"
                                role="option"
                                aria-selected="@isCurrent">
                            @mode.Label
                        </button>
                    }
                    <div class="conversations-mode-menu__divider"></div>
                    <label for="conv-mode-tecnico" class="conversations-mode-menu__tecnico-label">Ver de un técnico</label>
                    <select id="conv-mode-tecnico" class="conversations-mode-menu__tecnico-select" value="@_filters.IdTecnicoActual" @onchange="HandleTechnicianModeChangedAsync">
                        <option value="">Todos</option>
                        @if (CurrentUserTechnician is not null)
                        {
                            <option value="@CurrentUserTechnician.IdTecnico">Yo mismo (@CurrentUserTechnician.Nombre)</option>
                        }
                        @foreach (var tech in _technicians.Where(t => CurrentUserTechnician is null || !string.Equals(t.IdTecnico, CurrentUserTechnician.IdTecnico, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@tech.IdTecnico">@tech.Nombre (@tech.IdTecnico)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="conversations-filters__fields">
                <div class="field">
                    <label for="conv-search">Buscar</label>
                    <input id="conv-search"
                           type="text"
                           placeholder="Buscar por teléfono, cliente, contacto, email, resumen o mensaje..."
                           value="@_filters.Search"
                           @oninput="HandleSearchInputAsync"
                           @onkeydown="HandleSearchEnter"
                           @onfocus="() => _showContactSuggestions = ShouldShowContactSuggestions" />
                    @if (_showContactSuggestions)
                    {
                        <button type="button"
                                class="conversations-contact-suggest-backdrop"
                                aria-label="Cerrar sugerencias"
                                @onclick="CloseContactSuggestions"></button>
                        <div class="conversations-contact-suggest">
                            @if (_loadingContactSuggestions)
                            {
                                <div class="conversations-contact-suggest__state">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>Buscando contactos...</span>
                                </div>
                            }
                            else if (_conversationSuggestions.Count > 0 || _contactSuggestions.Count > 0)
                            {
                                @if (_conversationSuggestions.Count > 0)
                                {
                                    <div class="conversations-contact-suggest__header">
                                        <span>Coincidencias encontradas</span>
                                    </div>
                                    @foreach (var conversation in _conversationSuggestions)
                                    {
                                        <div class="conversations-contact-suggest__item">
                                            <div class="conversations-contact-suggest__main">
                                                <strong>@GetDisplayName(conversation)</strong>
                                                <small>@DisplayOrFallback(conversation.TelefonoWhatsApp)</small>
                                            </div>
                                            <div class="conversations-contact-suggest__actions">
                                                <button type="button" class="btn btn--primary btn--sm" @onclick="() => SelectConversationFromSuggestionAsync(conversation.IdConversacion)">
                                                    <i class="bi bi-whatsapp"></i> Conversar
                                                </button>
                                                @if (!HasUsableLinkedContact(conversation))
                                                {
                                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenNewContactFromConversation(conversation)">
                                                        <i class="bi bi-person-plus-fill"></i> Crear contacto
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                @if (_contactSuggestions.Count > 0)
                                {
                                    <div class="conversations-contact-suggest__header">
                                        <span>Contactos encontrados</span>
                                    </div>
                                    @foreach (var contact in _contactSuggestions)
                                    {
                                        var phone = GetContactPhone(contact);
                                        <div class="conversations-contact-suggest__item">
                                            <div class="conversations-contact-suggest__main">
                                                <strong>@contact.NombreApellido</strong>
                                                <span>@DisplayOrFallback(contact.Cargo)</span>
                                                <small>@DisplayOrFallback(phone, contact.Email)</small>
                                            </div>
                                            <div class="conversations-contact-suggest__actions">
                                                <button type="button" class="btn btn--primary btn--sm" disabled="@string.IsNullOrWhiteSpace(phone)" @onclick="() => OpenWhatsAppForContactAsync(contact)">
                                                    <i class="bi bi-whatsapp"></i> Conversar
                                                </button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenContactEditor(contact)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                var conversationMatch = GetBestConversationMatchForSearch();
                                <div class="conversations-contact-suggest__state">
                                    <i class="bi bi-person-plus"></i>
                                    <span>No encontramos contactos con ese texto.</span>
                                </div>
                                @if (conversationMatch is not null)
                                {
                                    <div class="conversations-contact-suggest__item">
                                        <div class="conversations-contact-suggest__main">
                                            <strong>@GetDisplayName(conversationMatch)</strong>
                                            <span>@("Ya existe conversaci\u00f3n sin contacto asociado")</span>
                                            <small>@DisplayOrFallback(conversationMatch.TelefonoWhatsApp)</small>
                                        </div>
                                        <div class="conversations-contact-suggest__actions">
                                            <button type="button" class="btn btn--primary btn--sm" @onclick="() => SelectConversationFromSuggestionAsync(conversationMatch.IdConversacion)">
                                                <i class="bi bi-whatsapp"></i> Conversar
                                            </button>
                                            <button type="button" class="btn btn--primary btn--sm" @onclick="() => OpenNewContactFromConversation(conversationMatch)">
                                                <i class="bi bi-person-plus-fill"></i> Crear contacto vinculado
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn--primary btn--sm" @onclick="OpenNewContactFromSearch">
                                        <i class="bi bi-plus-circle-fill"></i> Crear contacto nuevo
                                    </button>
                                }
                            }
                        </div>
                    }
                    @if (CanCreateWhatsAppFromSearch)
                    {
                        <button type="button"
                                class="btn btn--primary btn--sm"
                                style="margin-top: .45rem; width: fit-content;"
                                @onclick="CreateWhatsAppFromSearchAsync"
                                disabled="@_busyAction">
                            <i class="bi bi-plus-circle-fill"></i> Crear conversación con este celular
                        </button>
                    }
                </div>

                <div class="field">
                    <label for="conv-my-tech">Mi técnico</label>
                    <select id="conv-my-tech" @bind="_filters.IdTecnicoActual">
                        <option value="">Todos</option>
                        @foreach (var tech in _technicians)
                        {
                            <option value="@tech.IdTecnico">@tech.Nombre (@tech.IdTecnico)</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="conv-state-filter">Estado</label>
                    <select id="conv-state-filter" @bind="_filters.CodigoEstado">
                        <option value="">Todos</option>
                        <option value="@ConversacionesInboxFilters.EstadoSinFinalizar">Sin finalizar</option>
                        @foreach (var state in _states)
                        {
                            <option value="@state.CodigoEstado">@state.Descripcion</option>
                        }
                    </select>
                </div>

                <button type="button" class="btn btn--primary" @onclick="LoadInboxAsync" disabled="@_loadingInbox">
                    <i class="bi bi-funnel"></i> Aplicar
                </button>
                <button type="button"
                        class="btn btn--ghost conversations-filter-clear"
                        title="Limpiar filtros"
                        aria-label="Limpiar filtros"
                        @onclick="ClearConversationFiltersAsync"
                        disabled="@_loadingInbox">
                    <i class="bi bi-eraser"></i>
                </button>
            </div>
        </section>

        @if (_showMobileAdvancedFilters)
        {
            <button type="button" class="conversations-mobile-sheet-backdrop" aria-label="Cerrar filtros" @onclick="CloseMobileAdvancedFilters"></button>
            <section class="conversations-mobile-filter-sheet" aria-label="Filtros avanzados" @onclick:stopPropagation>
                <div class="conversations-mobile-filter-sheet__handle"></div>
                <header>
                    <h3>Filtros</h3>
                    <button type="button" class="conversations-mobile-icon-button" @onclick="CloseMobileAdvancedFilters" aria-label="Cerrar filtros">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </header>

                <div class="conversations-mobile-sheet-group">
                    <span>Estados</span>
                    @foreach (var mode in _modeOptions)
                    {
                        <button type="button"
                                class="conversations-mobile-sheet-option @(mode.Value == _filters.Modo ? "is-active" : string.Empty)"
                                @onclick="() => SetMobileMode(mode.Value)">
                            <i class="bi @(mode.Value == _filters.Modo ? "bi-record-circle-fill" : "bi-circle")"></i>
                            <span>@mode.Label</span>
                        </button>
                    }
                </div>

                <div class="field">
                    <label for="conv-mobile-state-filter">Estado puntual</label>
                    <select id="conv-mobile-state-filter" @bind="_filters.CodigoEstado">
                        <option value="">Todos</option>
                        <option value="@ConversacionesInboxFilters.EstadoSinFinalizar">Sin finalizar</option>
                        @foreach (var state in _states)
                        {
                            <option value="@state.CodigoEstado">@state.Descripcion</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="conv-mobile-tech-filter">Mi tecnico</label>
                    <select id="conv-mobile-tech-filter" @bind="_filters.IdTecnicoActual">
                        <option value="">Todos</option>
                        @foreach (var tech in _technicians)
                        {
                            <option value="@tech.IdTecnico">@tech.Nombre (@tech.IdTecnico)</option>
                        }
                    </select>
                </div>

                <div class="conversations-mobile-sheet-group">
                    <span>Canal</span>
                    <div class="conversations-mobile-sheet-channel">
                        <button type="button"
                                class="conversations-mobile-chip @(_canalActivo == "SOCIAL" ? "is-active" : string.Empty)"
                                @onclick='() => ChangeCanalAsync("SOCIAL")'>
                            Todos
                        </button>
                        <button type="button"
                                class="conversations-mobile-chip @(_canalActivo == "WHATSAPP" ? "is-active" : string.Empty)"
                                @onclick='() => ChangeCanalAsync("WHATSAPP")'>
                            WhatsApp
                        </button>
                        <button type="button"
                                class="conversations-mobile-chip @(_canalActivo == "INSTAGRAM" ? "is-active" : string.Empty)"
                                @onclick='() => ChangeCanalAsync("INSTAGRAM")'>
                            Instagram
                        </button>
                        <button type="button"
                                class="conversations-mobile-chip @(_canalActivo == "FACEBOOK" ? "is-active" : string.Empty)"
                                @onclick='() => ChangeCanalAsync("FACEBOOK")'>
                            Facebook
                        </button>
                        <button type="button"
                                class="conversations-mobile-chip conversations-mobile-chip--mercadolibre @(_canalActivo == "MERCADOLIBRE" ? "is-active" : string.Empty)"
                                @onclick='() => ChangeCanalAsync("MERCADOLIBRE")'>
                            Mercado Libre
                        </button>
                        <button type="button"
                                class="conversations-mobile-chip @(_canalActivo == "INTERNO" ? "is-active" : string.Empty)"
                                @onclick='() => ChangeCanalAsync("INTERNO")'>
                            Chat interno
                        </button>
                    </div>
                </div>

                <button type="button" class="btn btn--primary" @onclick="ApplyMobileAdvancedFiltersAsync" disabled="@_loadingInbox">
                    Aplicar filtros
                </button>
                <button type="button" class="btn btn--ghost" @onclick="ClearMobileAdvancedFiltersAsync">
                    Limpiar filtros
                </button>
            </section>
        }

        @if (_showContextPanel)
        {
            <button type="button" class="conversations-panel-backdrop" aria-label="Cerrar paneles" @onclick="CloseFloatingPanels"></button>
        }

        <div class="conversations-layout">
            <aside class="panel-card conversations-list">
                @if (_loadingInbox && _inbox.Count > 0)
                {
                    <div class="conversations-loading-overlay" role="status" aria-live="polite">
                        <i class="bi bi-hourglass-split"></i>
                        <span>Actualizando conversaciones...</span>
                    </div>
                }
                <div class="conversations-list__header">
                    <div>
                        <h3 class="panel-card__title">
                            <span class="desktop-only">Inbox</span>
                            <span class="mobile-only">Conversaciones</span>
                            <span class="conversations-mobile-inbox-count mobile-only">@_inbox.Count</span>
                        </h3>
                        <p class="panel-card__subtitle">@_inbox.Count conversación(es)</p>
                    </div>
                </div>

                <div class="conversations-inbox-tools" @onclick:stopPropagation>
                    <div class="conversations-inbox-search">
                        <div class="conversations-inbox-searchbox">
                            <i class="bi bi-search"></i>
                            <input id="conv-inbox-search"
                                   type="text"
                                   placeholder="Buscar conversación o mensaje..."
                                   value="@_filters.Search"
                                   @oninput="HandleSearchInputAsync"
                                   @onkeydown="HandleSearchEnter"
                                   @onfocus="HandleSearchFocusAsync" />
                        </div>

                        @if (_showContactSuggestions)
                        {
                            <button type="button"
                                    class="conversations-contact-suggest-backdrop"
                                    aria-label="Cerrar sugerencias"
                                    @onclick="CloseContactSuggestions"></button>
                            <div class="conversations-contact-suggest">
                                @if (_loadingContactSuggestions)
                                {
                                    <div class="conversations-contact-suggest__state">
                                        <i class="bi bi-hourglass-split"></i>
                                        <span>Buscando contactos...</span>
                                    </div>
                                }
                                else if (_conversationSuggestions.Count > 0 || _contactSuggestions.Count > 0)
                                {
                                    @if (_conversationSuggestions.Count > 0)
                                    {
                                        <div class="conversations-contact-suggest__header">
                                            <span>Coincidencias encontradas</span>
                                        </div>
                                        @foreach (var conversation in _conversationSuggestions)
                                        {
                                            <div class="conversations-contact-suggest__item">
                                                <div class="conversations-contact-suggest__main">
                                                    <strong>@GetDisplayName(conversation)</strong>
                                                    <small>@DisplayOrFallback(conversation.TelefonoWhatsApp)</small>
                                                </div>
                                                <div class="conversations-contact-suggest__actions">
                                                    <button type="button" class="btn btn--primary btn--sm" @onclick="() => SelectConversationFromSuggestionAsync(conversation.IdConversacion)">
                                                        <i class="bi bi-chat-dots"></i> Conversar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    @if (_contactSuggestions.Count > 0)
                                    {
                                        <div class="conversations-contact-suggest__header">
                                            <span>Contactos encontrados</span>
                                        </div>
                                        @foreach (var contact in _contactSuggestions)
                                        {
                                            var phone = GetContactPhone(contact);
                                            <div class="conversations-contact-suggest__item">
                                                <div class="conversations-contact-suggest__main">
                                                    <strong>@contact.NombreApellido</strong>
                                                    <span>@DisplayOrFallback(contact.Cargo)</span>
                                                    <small>@DisplayOrFallback(phone, contact.Email)</small>
                                                </div>
                                                <div class="conversations-contact-suggest__actions">
                                                    <button type="button" class="btn btn--primary btn--sm" disabled="@string.IsNullOrWhiteSpace(phone)" @onclick="() => OpenWhatsAppForContactAsync(contact)">
                                                        <i class="bi bi-chat-dots"></i> Conversar
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <div class="conversations-contact-suggest__state">
                                        <i class="bi bi-search"></i>
                                        <span>No encontramos coincidencias para esa búsqueda.</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (_loadingInbox && _inbox.Count == 0)
                {
                    <div class="loading">Cargando conversaciones…</div>
                }
                else if (_inbox.Count == 0)
                {
                    <div class="conversations-empty">
                        No hay conversaciones para los filtros seleccionados.
                    </div>
                }
                else
                {
                    <div class="conversations-list__items">
                        @foreach (var item in InboxDisplayItems)
                        {
                            <div role="button"
                                 tabindex="0"
                                 class="@ConversationRowClass(item)"
                                 style="@GetInboxTechnicianStyle(item)"
                                 @onclick="() => SelectInboxItemAsync(item, showMobileChat: true)"
                                 @onkeydown="args => HandleInboxRowKeyDownAsync(args, item)">
                                <span class="conversation-row__avatar @(item.Canal == "MERCADOLIBRE" ? "conversation-row__avatar--mercadolibre" : string.Empty)" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.FotoPerfilUrl))
                                    {
                                        <img src="@item.FotoPerfilUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                    }
                                    else
                                    {
                                        @GetConversationInitials(item)
                                    }
                                    <span class="conversation-row__channel-badge conversation-row__channel-badge--@item.Canal.ToLowerInvariant()" title="@GetCanalLabel(item.Canal)">
                                        <i class="bi @GetCanalIcon(item.Canal)"></i>
                                    </span>
                                </span>
                                <div class="conversation-row__content">
                                <div class="conversation-row__top">
                                    <span class="conversation-row__name">@GetDisplayName(item)</span>
                                    <span class="conversation-row__side">
                                        @if (item.Canal == "MERCADOLIBRE" && GetMercadoLibreGroupCount(item) > 1)
                                        {
                                            <span class="mercadolibre-group-chevron" aria-hidden="true">
                                                <i class="bi @(IsMercadoLibreGroupExpanded(item) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                            </span>
                                        }
                                        <button type="button"
                                                class="conversation-pin @(item.FijadaPorUsuario ? "is-pinned" : string.Empty)"
                                                title="@(item.FijadaPorUsuario ? "Desfijar para mi usuario" : "Fijar para mi usuario")"
                                                aria-label="@(item.FijadaPorUsuario ? "Desfijar conversación" : "Fijar conversación")"
                                                @onclick:stopPropagation
                                                @onclick="() => ToggleConversationPinAsync(item)">
                                            <i class="bi @(item.FijadaPorUsuario ? "bi-pin-angle-fill" : "bi-pin-angle")"></i>
                                        </button>
                                        <span class="conversation-row__date">@FormatShortDate(item.FechaHoraUltimoMensaje)</span>
                                        @if (GetInboxDisplayNewCount(item) > 0)
                                        {
                                            <span class="conversation-row__new-count">@GetInboxDisplayNewCount(item)</span>
                                        }
                                    </span>
                                </div>
                                <div class="conversation-row__badges">
                                    <span class="conversation-badge conversation-badge--state conversation-badge--icon-only" title="@item.EstadoDescripcion">
                                        <i class="bi @GetEstadoIcon(item.CodigoEstado)"></i>
                                    </span>
                                    @if (string.Equals(item.DireccionUltimoMensaje, "ENTRANTE", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="conversation-badge conversation-badge--esperando" title="Esperando respuesta">
                                            <i class="bi bi-hourglass-split"></i> @GetEsperandoDesdeLabel(item)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.IdTecnico))
                                    {
                                        <span class="conversation-badge conversation-badge--technician"
                                              style="@GetInboxTechnicianStyle(item)">
                                            <i class="bi bi-person-fill"></i>
                                            @FirstNonEmpty(item.TecnicoNombre, item.IdTecnico)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.ClienteNombre))
                                    {
                                        <span class="conversation-badge">@item.ClienteNombre</span>
                                    }
                                    @if (item.Canal == "MERCADOLIBRE")
                                    {
                                        var groupCount = GetMercadoLibreGroupCount(item);
                                        if (groupCount > 1)
                                        {
                                            <span class="conversation-badge conversation-badge--mercadolibre-count">@groupCount preguntas</span>
                                        }
                                        else
                                        {
                                            <span class="conversation-badge conversation-badge--mercadolibre-buyer">@GetMercadoLibreBuyerLabel(item)</span>
                                        }
                                    }
                                </div>
                                <p class="conversation-row__summary">
                                    @if (IsLastInboxMessageOutgoing(item))
                                    {
                                        <span class="conversation-row__delivery @GetDeliveryClass(item.EstadoUltimoMensaje)"
                                              title="Último mensaje enviado por nosotros: @GetDeliveryLabel(item.EstadoUltimoMensaje)">
                                            <i class="bi @GetDeliveryIcon(item.EstadoUltimoMensaje)"></i>
                                        </span>
                                    }
                                    @FormatInboxSummary(item.ResumenUltimoMensaje)
                                </p>
                                </div>
                            </div>
                            @if (ShouldShowMercadoLibreInboxChildren(item))
                            {
                                <div class="mercadolibre-inbox-children">
                                    @foreach (var question in GetMercadoLibreGroupItems(item))
                                    {
                                        <button type="button"
                                                class="mercadolibre-inbox-child @(question.IdConversacion == _selectedConversationId ? "is-active" : string.Empty)"
                                                @onclick="() => SelectMercadoLibreGroupQuestionAsync(question.IdConversacion)"
                                                disabled="@(_loadingConversation && question.IdConversacion == _selectedConversationId)">
                                            <span class="mercadolibre-inbox-child__buyer">@GetMercadoLibreBuyerLabel(question)</span>
                                            <strong>@FormatInboxSummary(question.ResumenUltimoMensaje)</strong>
                                            <span class="mercadolibre-inbox-child__side">
                                                <small>@FormatShortDate(question.FechaHoraUltimoMensaje)</small>
                                                @if (GetConversationNewCount(question.IdConversacion) > 0)
                                                {
                                                    <span class="mercadolibre-inbox-child__new">@GetConversationNewCount(question.IdConversacion)</span>
                                                }
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </aside>

            <div class="conversations-column-resizer conversations-column-resizer--inbox"
                 data-conversations-resizer="inbox"
                 role="separator"
                 aria-label="Cambiar ancho del inbox"
                 aria-orientation="vertical"
                 tabindex="0"></div>

            <div class="conversations-chat-workspace">
            <section class="panel-card conversations-chat">
                @if (_loadingConversation || _loadingAuditMessages)
                {
                    <div class="conversations-loading-overlay conversations-loading-overlay--chat" role="status" aria-live="polite">
                        <i class="bi bi-hourglass-split"></i>
                        <span>@(_loadingConversation ? "Cargando conversacion..." : "Buscando mensajes...")</span>
                    </div>
                }
                @if (_loadingConversation)
                {
                    <div class="loading">Cargando conversación…</div>
                }
                else if (_selectedConversation is null && IsAuditResultsMode)
                {
                    <div class="conversation-audit-results">
                        <div class="conversation-audit-results__head">
                            <div>
                                <h3 class="panel-card__title">Mensajes encontrados</h3>
                                <p class="panel-card__subtitle">@_auditMessages.Count coincidencia(s) para los filtros actuales.</p>
                            </div>
                        </div>
                        @if (_loadingAuditMessages)
                        {
                            <div class="loading">Buscando mensajes...</div>
                        }
                        else if (_auditMessages.Count == 0)
                        {
                            <div class="conversations-empty conversations-empty--center">
                                No encontramos mensajes para esos filtros.
                            </div>
                        }
                        else
                        {
                            <div class="conversation-audit-results__list">
                                @foreach (var item in _auditMessages)
                                {
                                    <button type="button" class="conversation-audit-result" @onclick="() => SelectConversationAsync(item.IdConversacion, showMobileChat: true)">
                                        <div class="conversation-audit-result__top">
                                            <strong>@DisplayOrFallback(item.NombreConversacion)</strong>
                                            <span>@FormatShortDate(item.FechaHora)</span>
                                        </div>
                                        <div class="conversation-audit-result__meta">
                                            <span>@DisplayOrFallback(item.TelefonoWhatsApp)</span>
                                            <span>@DisplayOrFallback(item.EstadoDescripcion)</span>
                                            @if (!string.IsNullOrWhiteSpace(item.TecnicoNombre))
                                            {
                                                <span>@item.TecnicoNombre</span>
                                            }
                                            <span>@GetAuditMessageTypeLabel(item)</span>
                                        </div>
                                        <p>@GetAuditMessageText(item)</p>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                else if (_selectedConversation is null)
                {
                    @if (_conversationError is not null)
                    {
                        <div class="conversations-empty conversations-empty--center">
                            <div class="conversations-error conversations-notice">No se pudo cargar la conversación: @_conversationError</div>
                        </div>
                    }
                    else
                    {
                        <div class="conversations-empty conversations-empty--center">
                            Seleccioná una conversación del panel izquierdo para verla y responder.
                        </div>
                    }
                }
                else
                {
                    <header class="conversations-chat__header">
                        <div class="conversations-chat__identity">
                            <button type="button"
                                    class="btn btn--ghost btn--sm conversations-mobile-back"
                                    @onclick="BackToConversationListAsync"
                                    title="Volver al listado">
                                <i class="bi bi-arrow-left"></i>
                                <span>Volver</span>
                            </button>
                            @if (_selectedConversation.Canal == "INSTAGRAM" || _selectedConversation.Canal == "FACEBOOK" || _selectedConversation.Canal == "MERCADOLIBRE")
                            {
                                <div class="conversation-profile-avatar @(_selectedConversation.Canal == "MERCADOLIBRE" ? "conversation-profile-avatar--mercadolibre" : string.Empty)" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(_selectedConversation.FotoPerfilUrl))
                                    {
                                        <img src="@_selectedConversation.FotoPerfilUrl" alt="" referrerpolicy="no-referrer" />
                                    }
                                    else
                                    {
                                        <span>@GetConversationInitials(_selectedConversation)</span>
                                    }
                                </div>
                            }
                            <div>
                                <div class="conversation-title-editor">
                                    @if (_editingConversationName)
                                    {
                                        <input class="conversation-title-editor__input"
                                               @ref="_conversationNameInput"
                                               value="@_conversationNameDraft"
                                               maxlength="120"
                                               @oninput="OnConversationNameInput"
                                               @onkeydown="OnConversationNameKeyDownAsync"
                                               @onblur="SaveConversationNameAsync"
                                               disabled="@_savingConversationName"
                                               autofocus />
                                    }
                                    else
                                    {
                                        <h3 class="panel-card__title">@GetConversationHeader(_selectedConversation)</h3>
                                        @if (HasContextNotes)
                                        {
                                            <button type="button"
                                                    class="conversation-badge"
                                                    style="border-color:rgba(45,212,191,.9);color:#67e8f9;background:linear-gradient(90deg,rgba(14,116,144,.34),rgba(15,23,42,.72));box-shadow:0 0 0 3px rgba(34,211,238,.10);cursor:pointer;"
                                                    title="Hay observaciones del cliente o contacto. Abrir contexto."
                                                    @onclick="OpenContextPanel">
                                                <i class="bi bi-info-circle"></i> Observaciones
                                            </button>
                                        }
                                        @if (_contextTicketMatches.Count > 0)
                                        {
                                            <button type="button"
                                                    class="conversation-badge"
                                                    style="border-color:rgba(251,146,60,.9);color:#fdba74;background:linear-gradient(90deg,rgba(154,52,18,.34),rgba(15,23,42,.72));box-shadow:0 0 0 3px rgba(251,146,60,.10);cursor:pointer;"
                                                    title="Este cliente tiene tickets pendientes. Click para abrir."
                                                    @onclick="OpenPendingTicketsFromHeader">
                                                <i class="bi bi-life-preserver"></i>
                                                @(_contextTicketMatches.Count == 1 ? "1 ticket pendiente" : $"{_contextTicketMatches.Count} tickets pendientes")
                                            </button>
                                        }
                                        <button type="button"
                                                class="btn btn--ghost btn--sm conversation-title-editor__button"
                                                title="Editar nombre"
                                                @onclick="StartConversationNameEdit"
                                                disabled="@_busyAction">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    }
                                </div>
                                @if (_selectedConversation.Canal == "INSTAGRAM" && !string.IsNullOrWhiteSpace(_selectedConversation.UsuarioExterno))
                                {
                                    <div class="conversation-social-profile">
                                        <a href="@GetInstagramProfileUrl(_selectedConversation.UsuarioExterno)"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           title="Abrir perfil en Instagram">
                                            @($"@{_selectedConversation.UsuarioExterno}")
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                        @if (_selectedConversation.PerfilExternoVerificado)
                                        {
                                            <span title="Perfil verificado"><i class="bi bi-patch-check-fill"></i></span>
                                        }
                                        @if (_selectedConversation.SeguidoresExterno.HasValue)
                                        {
                                            <span>@FormatCompactNumber(_selectedConversation.SeguidoresExterno.Value) seguidores</span>
                                        }
                                    </div>
                                }
                                else if (_selectedConversation.Canal == "FACEBOOK")
                                {
                                    <div class="conversation-social-profile conversation-social-profile--facebook">
                                        <a href="@GetFacebookProfileUrl(_selectedConversation)"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           title="Abrir referencia en Facebook">
                                            <i class="bi bi-facebook"></i>
                                            Ver en Facebook
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                }
                                else if (_selectedConversation.Canal == "MERCADOLIBRE")
                                {
                                    <div class="conversation-social-profile conversation-social-profile--mercadolibre">
                                        <a href="@GetMercadoLibreQuestionUrl(_selectedConversation)"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           title="Abrir referencia en Mercado Libre">
                                            <i class="bi bi-bag-fill"></i>
                                            Ver publicación
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                        <span>@GetMercadoLibreBuyerLabel(_selectedConversation)</span>
                                    </div>
                                }
                                else if (_selectedConversation.Canal != "INTERNO" && !string.IsNullOrWhiteSpace(_selectedConversation.TelefonoWhatsApp))
                                {
                                    <p class="panel-card__subtitle">@_selectedConversation.TelefonoWhatsApp</p>
                                }
                            </div>
                            <div class="conversations-chat__chips">
                            @if (_selectedConversation.Canal == "WHATSAPP")
                            {
                                <span class="conversation-badge">@GetWhatsAppWindowLabel(_selectedConversation)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedConversation.TecnicoNombre))
                            {
                                <span class="conversation-badge conversation-badge--technician conversation-badge--technician-prominent"
                                      style="@GetSelectedConversationTechnicianStyle(_selectedConversation)">
                                    <i class="bi bi-person-fill"></i>
                                    @_selectedConversation.TecnicoNombre
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedConversation.ClienteCodigo))
                            {
                                @if (!string.IsNullOrWhiteSpace(_selectedConversation.ClasificacionDescripcion))
                                {
                                    <span class="conversation-badge conversation-badge--state" title="Clasificación del cliente">
                                        <i class="bi bi-tag-fill"></i> @_selectedConversation.ClasificacionDescripcion
                                    </span>
                                }
                                <span class="conversation-badge @GetAbonoBadgeClass(_selectedConversation.EstadoAbono)" title="Estado de abono al mantenimiento">
                                    <i class="bi @GetAbonoBadgeIcon(_selectedConversation.EstadoAbono)"></i> @GetAbonoBadgeLabel(_selectedConversation.EstadoAbono)
                                </span>
                            }
                            else if (_selectedConversation.IdContacto.HasValue)
                            {
                                <span class="conversation-badge conversation-badge--sin-cuenta" title="Contacto guardado, sin cuenta de cliente asociada">
                                    <i class="bi bi-person-vcard"></i> Contacto conocido, sin cuenta
                                </span>
                            }
                            else
                            {
                                <span class="conversation-badge conversation-badge--sin-identificar" title="No está en Clientes ni en Contactos">
                                    <i class="bi bi-person-fill-exclamation"></i> Sin identificar
                                </span>
                            }
                            </div>
                        </div>
                        <div class="conversations-mobile-chat-actions mobile-only" @onclick:stopPropagation>
                            <button type="button"
                                    class="conversations-mobile-chat-actions__toggle"
                                    title="Acciones"
                                    aria-label="Acciones de conversación"
                                    aria-haspopup="menu"
                                    aria-expanded="@_showMobileChatActions"
                                    @onclick="ToggleMobileChatActions">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            @if (_showMobileChatActions)
                            {
                                <div class="conversations-mobile-chat-actions__menu" role="menu">
                                    <button type="button" role="menuitem" @onclick="OpenMobileContextPanel" disabled="@(_selectedConversation is null)">
                                        <i class="bi bi-layout-sidebar-inset-reverse"></i>
                                        <span>Contexto</span>
                                        @if (HasContextNotes)
                                        {
                                            <strong>Notas</strong>
                                        }
                                    </button>
                                    @if (_ticketsModuloActivo)
                                    {
                                        <button type="button" role="menuitem" @onclick="StartMobileTicketSelection" disabled="@(_selectedConversation is null || _messages.Count == 0)">
                                            <i class="bi bi-life-preserver"></i>
                                            <span>Crear ticket</span>
                                        </button>
                                    }
                                    <button type="button" role="menuitem" @onclick="ToggleAnyDeskToolbarPrompt">
                                        <i class="bi bi-display"></i>
                                        <span>Conectar por AnyDesk</span>
                                    </button>
                                    @if (_showAnyDeskToolbarPrompt)
                                    {
                                        <div class="conversations-mobile-chat-actions__anydesk" @onclick:stopPropagation>
                                            <input type="text"
                                                   class="anydesk-prompt__input"
                                                   placeholder="ID de AnyDesk (ej: 248 321 383)"
                                                   value="@_anyDeskIdDraft"
                                                   @oninput="args => _anyDeskIdDraft = args.Value?.ToString() ?? string.Empty" />
                                            <a class="btn btn--primary btn--sm anydesk-prompt__connect"
                                               href="@BuildAnyDeskUri(_anyDeskIdDraft)"
                                               title="Conectar por AnyDesk"
                                               @onclick="CloseAnyDeskPrompt">
                                                <i class="bi bi-display"></i> Conectar
                                            </a>
                                        </div>
                                    }
                                    @if (CanAssignSelectedConversationToMe)
                                    {
                                        <button type="button" role="menuitem" @onclick="AssignSelectedConversationToMeAsync" disabled="@_busyAction">
                                            <i class="bi bi-person-check-fill"></i>
                                            <span>Asignarme la conversación</span>
                                        </button>
                                    }
                                    <button type="button" role="menuitem" @onclick="ToggleStatusMenu" disabled="@_busyAction">
                                        <i class="bi bi-circle-half"></i>
                                        <span>Estado: @GetCurrentStatusDescription()</span>
                                    </button>
                                    @if (_showStatusMenu)
                                    {
                                        <div class="conversations-mobile-chat-actions__states" role="listbox">
                                            @foreach (var state in HeaderStatusOptions)
                                            {
                                                var isCurrent = string.Equals(state.CodigoEstado, _statusCode, StringComparison.OrdinalIgnoreCase);
                                                <button type="button"
                                                        class="@(isCurrent ? "is-active" : string.Empty)"
                                                        @onclick="() => SelectMobileStatusAsync(state.CodigoEstado)"
                                                        role="option"
                                                        aria-selected="@isCurrent">
                                                    @state.Descripcion
                                                </button>
                                            }
                                        </div>
                                    }
                                    @if (!IsSelectedConversationClosed)
                                    {
                                        <button type="button" role="menuitem" @onclick="CloseMobileConversationAsync" disabled="@_busyAction">
                                            <i class="bi bi-lock-fill"></i>
                                            <span>Cerrar conversación</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="conversation-header-state @(CanAssignSelectedConversationToMe ? "has-assign-to-me" : string.Empty)">
                            @if (CanAssignSelectedConversationToMe)
                            {
                                <button type="button"
                                        class="btn btn--primary btn--sm conversation-assign-to-me"
                                        @onclick="AssignSelectedConversationToMeAsync"
                                        disabled="@_busyAction"
                                        title="Tomar esta conversación">
                                    <i class="bi bi-person-check-fill"></i>
                                    Asignarme
                                </button>
                            }
                            <div class="conversation-header-state__row @(_showStatusMenu ? "is-open" : string.Empty)" @onclick:stopPropagation="true">
                                <span class="conversation-header-state__caption">Estado:</span>
                                <button type="button"
                                        class="conversation-header-state__trigger"
                                        @onclick="ToggleStatusMenu"
                                        disabled="@_busyAction"
                                        aria-haspopup="listbox"
                                        aria-expanded="@_showStatusMenu"
                                        aria-label="Cambiar estado">
                                    <span>@GetCurrentStatusDescription()</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                @if (_showStatusMenu)
                                {
                                    <div class="conversation-header-state__menu" role="listbox">
                                        @foreach (var state in HeaderStatusOptions)
                                        {
                                            var isCurrent = string.Equals(state.CodigoEstado, _statusCode, StringComparison.OrdinalIgnoreCase);
                                            <button type="button"
                                                    class="conversation-header-state__option @(isCurrent ? "is-active" : string.Empty)"
                                                    @onclick="() => SelectStatusAsync(state.CodigoEstado)"
                                                    role="option"
                                                    aria-selected="@isCurrent">
                                                @state.Descripcion
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            @if (!IsSelectedConversationClosed)
                            {
                                <button type="button" class="btn btn--ghost btn--sm conversation-header-state__close" @onclick="CloseConversationAsync" disabled="@_busyAction">
                                    <i class="bi bi-lock-fill"></i> Cerrar conversación
                                </button>
                            }
                            else
                            {
                                <span class="conversation-header-state__closed">
                                    <i class="bi bi-lock-fill"></i> Conversación cerrada
                                </span>
                            }
                        </div>
                    </header>

                    @if (_showMessageSearch)
                    {
                        <div class="conversations-message-search">
                            <i class="bi bi-search"></i>
                            <input @ref="_messageSearchInput"
                                   type="search"
                                   placeholder="Buscar en esta conversación..."
                                   value="@_messageSearchText"
                                   @oninput="OnMessageSearchInputAsync"
                                   @onkeydown="OnMessageSearchKeyDownAsync" />
                            @if (!string.IsNullOrWhiteSpace(_messageSearchText))
                            {
                                <span class="conversations-message-search__count">
                                    @(_messageSearchMatchIds.Count == 0 ? "Sin resultados" : $"{_messageSearchActiveIndex + 1} de {_messageSearchMatchIds.Count}")
                                </span>
                            }
                            <button type="button" class="btn btn--ghost btn--sm" title="Anterior" @onclick="GoToPreviousMessageMatchAsync" disabled="@(_messageSearchMatchIds.Count == 0)">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                            <button type="button" class="btn btn--ghost btn--sm" title="Siguiente" @onclick="GoToNextMessageMatchAsync" disabled="@(_messageSearchMatchIds.Count == 0)">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <button type="button" class="btn btn--ghost btn--sm" title="Cerrar búsqueda" @onclick="CloseMessageSearch">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }

                    @if (_conversationError is not null)
                    {
                        <div class="conversations-error conversations-notice @GetConversationNoticeLeavingClass()">@_conversationError</div>
                    }

                    @if (IsWhatsAppWindowExpired && !_showStatusMenu)
                    {
                        <div class="conversations-window-banner">
                            <span>Esta conversación superó la ventana de 24 horas de WhatsApp.</span>
                            <button type="button" class="btn btn--primary btn--sm" @onclick="OpenTemplatePanel" disabled="@(!CanOpenTemplatePanel)">
                                <i class="bi bi-send-fill"></i> Enviar plantilla
                            </button>
                        </div>
                    }
                    @if (IsProviderPendingConversation && !_showStatusMenu)
                    {
                        <div class="conversations-window-banner conversations-window-banner--provider">
                            <span>@GetProviderPendingMessage()</span>
                        </div>
                    }

                    @if (_ticketSelectionMode)
                    {
                        <div class="conversations-window-banner conversations-ticket-selection">
                            <span>Seleccioná los mensajes que querés guardar dentro del ticket. Elegidos: @_selectedTicketMessageIds.Count</span>
                            <div class="actions">
                                <button type="button" class="btn btn--primary btn--sm" @onclick="OpenTicketDialog" disabled="@(_selectedTicketMessageIds.Count == 0)">
                                    <i class="bi bi-check2-circle"></i> Continuar
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="CancelTicketSelection">
                                    <i class="bi bi-x-circle"></i> Cancelar
                                </button>
                            </div>
                        </div>
                    }

                    @if (ShouldShowMercadoLibreThreadPicker)
                    {
                        <div class="mercadolibre-thread-picker" aria-label="Preguntas de la publicación">
                            @foreach (var question in _selectedMercadoLibreGroupItems)
                            {
                                <button type="button"
                                        class="mercadolibre-thread-picker__item @(question.IdConversacion == _selectedConversationId ? "is-active" : string.Empty)"
                                        @onclick="() => SelectMercadoLibreGroupQuestionAsync(question.IdConversacion)"
                                        disabled="@(_loadingConversation || question.IdConversacion == _selectedConversationId)">
                                    <span class="mercadolibre-thread-picker__buyer">@GetMercadoLibreBuyerLabel(question)</span>
                                    <strong>@FormatInboxSummary(question.ResumenUltimoMensaje)</strong>
                                    <small>@FormatShortDate(question.FechaHoraUltimoMensaje)</small>
                                </button>
                            }
                        </div>
                    }

                    <div class="conversations-thread-shell">
                    <div class="conversations-thread @GetThreadCssClass()" @ref="_threadElement">
                        @if (_messages.Count == 0)
                        {
                            <div class="conversations-empty conversations-empty--center">
                                La conversación todavía no tiene mensajes registrados.
                            </div>
                        }
                        else
                        {
                            @if (_hasMoreOlderMessages)
                            {
                                <div class="conversation-history-loader">
                                    <button type="button"
                                            class="conversation-history-loader__button"
                                            @onclick="LoadOlderMessagesAsync"
                                            disabled="@_loadingOlderMessages">
                                        @if (_loadingOlderMessages)
                                        {
                                            <span>Cargando...</span>
                                        }
                                        else
                                        {
                                            <span>Leer más</span>
                                        }
                                    </button>
                                    @if (_conversationTotalMessageCount > _messages.Count)
                                    {
                                        <span class="conversation-history-loader__hint">
                                            Mostrando @_messages.Count de @_conversationTotalMessageCount mensajes
                                        </span>
                                    }
                                </div>
                            }

                            DateTime? lastMessageDate = null;
                            @foreach (var message in VisibleMessages)
                            {
                                var messageDate = message.FechaHora.Date;
                                if (lastMessageDate != messageDate)
                                {
                                    lastMessageDate = messageDate;
                                    <div class="conversation-date-divider">
                                        <span>@FormatConversationDateDivider(message.FechaHora)</span>
                                    </div>
                                }

                                @if (_firstNewMessageId == message.IdMensaje)
                                {
                                    <div class="message-new-divider">
                                        <span>Nuevo</span>
                                    </div>
                                }

                                @if (IsInternalEventMessage(message))
                                {
                                    <div class="conversation-event-divider">
                                        @if (TryGetTicketIdFromEvent(message, out var eventTicketId))
                                        {
                                            <button type="button" class="conversation-event-divider__text conversation-event-divider__link" @onclick="() => OpenTicket(eventTicketId)">
                                                @message.Texto
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="conversation-event-divider__text">@message.Texto</span>
                                        }
                                        <time class="conversation-event-divider__time">@FormatShortDate(message.FechaHora)</time>
                                    </div>
                                    continue;
                                }

                                <div id="@GetMessageDomId(message.IdMensaje)"
                                     class="message-row @GetMessageRowClass(message) @(IsQuotedSource(message) ? "message-row--quoted-source" : string.Empty)"
                                     @ondblclick="() => QuoteMessageAsync(message)">
                                    @if (_ticketSelectionMode)
                                    {
                                        <label class="message-ticket-selector" title="Incluir mensaje en el ticket">
                                            <input type="checkbox"
                                                   checked="@_selectedTicketMessageIds.Contains(message.IdMensaje)"
                                                   @onchange="args => ToggleTicketMessageSelection(message.IdMensaje, args)" />
                                            <span></span>
                                        </label>
                                    }
                                    <div class="message-bubble-shell">
                                        @if (_openReactionMessageId == message.IdMensaje)
                                        {
                                            <div class="message-reaction-picker" @onclick:stopPropagation>
                                                @foreach (var emoji in QuickReactionEmojis)
                                                {
                                                    var reactionMessageId = message.IdMensaje;
                                                    var reactionEmoji = emoji;
                                                    <button type="button"
                                                            class="btn btn--ghost btn--sm message-reaction-picker__emoji"
                                                            title="Reaccionar @emoji"
                                                            @onclick="async () => await SendReactionAsync(reactionMessageId, reactionEmoji)"
                                                            disabled="@(_reactionSendingMessageId.HasValue)">
                                                        @emoji
                                                    </button>
                                                }
                                                <button type="button"
                                                        class="btn btn--ghost btn--sm message-reaction-picker__emoji"
                                                        title="Mas emojis"
                                                        @onclick="() => OpenReactionEmojiPanel(message.IdMensaje)"
                                                        @onclick:stopPropagation>
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        }
                                        @if (_reactionEmojiMessageId == message.IdMensaje && _showComposerTools)
                                        {
                                            <div class="panel-card conversations-tools-panel conversations-tools-panel--reaction" @onclick:stopPropagation>
                                                <input class="conversations-tools-panel__search" type="search" placeholder="Buscar emoji" value="@_emojiSearch" @oninput="HandleEmojiSearchInput" />
                                                @foreach (var group in FilteredEmojiGroups)
                                                {
                                                    <div class="conversations-tools-panel__group">
                                                        <strong class="context-card__label">@group.Nombre</strong>
                                                        <div class="conversations-tools-panel__grid">
                                                            @foreach (var emoji in group.Emojis)
                                                            {
                                                                <button type="button" class="btn btn--ghost btn--sm conversations-tools-panel__emoji" title="@GetEmojiButtonTitle(emoji)" @onclick="() => SelectEmojiFromPanelAsync(emoji)">@emoji</button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (string.Equals(message.MarcaInterna, "PENDIENTE", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="message-card__marca message-card__marca--pendiente" title="Marcado pendiente (interno)">
                                                <i class="bi bi-flag-fill"></i>
                                            </span>
                                        }
                                        else if (string.Equals(message.MarcaInterna, "COMPLETADA", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="message-card__marca message-card__marca--completada" title="Marcado completada (interno)">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </span>
                                        }
                                        <article class="message-card @GetMessageClass(message) @(_selectedTicketMessageIds.Contains(message.IdMensaje) ? "message-card--ticket-selected" : string.Empty) @(_aiFocusedMessageId == message.IdMensaje ? "message-card--ai-selected" : string.Empty)">
                                    <div class="message-card__meta">
                                        <span>@GetMessageAuthor(message)</span>
                                        <span>@FormatShortDate(message.FechaHora)</span>
                                    </div>
                                    @if (TryGetQuotedMessage(message, out var quotedMessage))
                                    {
                                        <button type="button"
                                                class="message-card__quote"
                                                title="Ir al mensaje citado"
                                                @onclick="() => ScrollToQuotedMessageAsync(quotedMessage.IdMensaje)"
                                                @onclick:stopPropagation>
                                            <span>@GetMessageAuthor(quotedMessage)</span>
                                            <strong>@GetQuotePreview(quotedMessage)</strong>
                                        </button>
                                    }
                                    @if (ShouldShowMessageText(message))
                                    {
                                        <p class="message-card__text">@RenderMessageText(message)</p>
                                        @if (IsUnsupportedMessage(message))
                                        {
                                            <div class="message-card__footer">
                                                <span>@GetUnsupportedMessageTrace(message)</span>
                                            </div>
                                        }
                                    }
                                    @if (IsContactMessage(message))
                                    {
                                        var sharedContacts = GetSharedContacts(message);
                                        if (sharedContacts.Count > 0)
                                        {
                                            <div class="message-contact-list">
                                                @foreach (var sharedContact in sharedContacts)
                                                {
                                                    <div class="message-contact-card">
                                                        <div class="message-contact-card__icon">
                                                            <i class="bi bi-person-lines-fill"></i>
                                                        </div>
                                                        <div class="message-contact-card__body">
                                                            <strong>@DisplayOrFallback(sharedContact.Nombre, "Contacto compartido")</strong>
                                                            <span>@DisplayOrFallback(sharedContact.Telefono, sharedContact.Email)</span>
                                                        </div>
                                                        <button type="button"
                                                                class="btn btn--ghost btn--sm"
                                                                title="Agendar contacto"
                                                                disabled="@(!sharedContact.CanBeScheduled)"
                                                                @onclick="() => OpenNewContactFromSharedContact(sharedContact)">
                                                            <i class="bi bi-person-plus-fill"></i>
                                                            <span>Agendar</span>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    @if (message.TieneAdjuntos && _adjuntosPorMensaje.TryGetValue(message.IdMensaje, out var adjuntos))
                                    {
                                        <div class="message-attachments">
                                            @foreach (var adj in adjuntos)
                                            {
                                                @if (IsImageAttachment(adj))
                                                {
                                                    <div class="message-attachment message-attachment--image">
                                                        @if (IsAttachmentAvailable(adj))
                                                        {
                                                            <button type="button"
                                                                    class="attachment-preview-button"
                                                                    title="Ver imagen"
                                                                    @onclick="() => OpenAttachmentPreview(adj)">
                                                                <img src="@GetAttachmentPreviewUrl(adj)" alt="@GetAttachmentLabel(adj)" loading="lazy" decoding="async" />
                                                            </button>
                                                            @if (IsStickerAttachment(adj))
                                                            {
                                                                <button type="button"
                                                                        class="btn btn--ghost btn--sm"
                                                                        title="Guardar sticker en favoritos"
                                                                        @onclick="() => SaveStickerFavoriteAsync(adj.IdAdjunto)">
                                                                    <i class="bi bi-star"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <a class="btn btn--ghost btn--sm"
                                                                   href="@GetAttachmentDownloadUrl(adj)"
                                                                   download="@GetAttachmentDownloadName(adj)"
                                                                   title="Descargar imagen">
                                                                    <i class="bi bi-download"></i>
                                                                </a>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="attachment-unavailable @GetAttachmentRecoveryClass(adj)" title="@GetAttachmentUnavailableTitle(adj)">
                                                                <i class="bi @GetAttachmentUnavailableIcon(adj, "bi-image-alt")"></i>
                                                                <span>@GetAttachmentUnavailableText(adj, "Imagen no disponible")</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else if (IsAudioAttachment(adj))
                                                {
                                                    <div class="message-attachment message-attachment--audio">
                                                        @if (IsAttachmentAvailable(adj))
                                                        {
                                                            <audio class="wa-audio-player__media" preload="metadata">
                                                                <source src="@GetAttachmentUrl(adj)" type="@GetAttachmentMime(adj)" />
                                                                Tu navegador no puede reproducir este audio.
                                                            </audio>
                                                            <div class="wa-audio-player" data-audio-player>
                                                                <button type="button" class="wa-audio-player__play" data-audio-play title="Reproducir audio" aria-label="Reproducir audio">
                                                                    <i class="bi bi-play-fill" data-audio-play-icon></i>
                                                                </button>
                                                                <div class="wa-audio-player__body">
                                                                    <input class="wa-audio-player__seek"
                                                                           data-audio-seek
                                                                           type="range"
                                                                           min="0"
                                                                           max="1000"
                                                                           value="0"
                                                                           step="1"
                                                                           aria-label="Progreso del audio" />
                                                                    <div class="wa-audio-player__meta">
                                                                        <span data-audio-current>0:00</span>
                                                                        <span data-audio-duration>0:00</span>
                                                                    </div>
                                                                </div>
                                                                <button type="button" class="wa-audio-player__speed" data-audio-speed title="Cambiar velocidad">1</button>
                                                                <a class="btn btn--ghost btn--sm wa-audio-player__download"
                                                                   href="@GetAttachmentDownloadUrl(adj)"
                                                                   download="@GetAttachmentDownloadName(adj)"
                                                                   title="Descargar audio">
                                                                    <i class="bi bi-download"></i>
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="attachment-unavailable @GetAttachmentRecoveryClass(adj)" title="@GetAttachmentUnavailableTitle(adj)">
                                                                <i class="bi @GetAttachmentUnavailableIcon(adj, "bi-file-earmark-music")"></i>
                                                                <span>@GetAttachmentUnavailableText(adj, "Audio no disponible")</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else if (IsVideoAttachment(adj))
                                                {
                                                    <div class="message-attachment message-attachment--video">
                                                        @if (IsAttachmentAvailable(adj))
                                                        {
                                                            <div class="message-video-preview">
                                                                <video controls preload="metadata">
                                                                    <source src="@GetAttachmentUrl(adj)" type="@GetAttachmentMime(adj)" />
                                                                    Tu navegador no puede reproducir este video.
                                                                </video>
                                                                <button type="button"
                                                                        class="message-video-preview__open"
                                                                        title="Ver video en grande"
                                                                        aria-label="Ver video en grande"
                                                                        @onclick="() => OpenAttachmentPreview(adj)">
                                                                    <i class="bi bi-arrows-fullscreen"></i>
                                                                </button>
                                                            </div>
                                                            @if (adj.TamanoBytes > 0)
                                                            {
                                                                <div class="attachment-video-meta">
                                                                    <span>@FormatFileSize(adj.TamanoBytes)</span>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="attachment-unavailable @GetAttachmentRecoveryClass(adj)" title="@GetAttachmentUnavailableTitle(adj)">
                                                                <i class="bi @GetAttachmentUnavailableIcon(adj, "bi-camera-video-off")"></i>
                                                                <span>@GetAttachmentUnavailableText(adj, "Video no disponible")</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="message-attachment message-attachment--file">
                                                        @if (IsAttachmentAvailable(adj))
                                                        {
                                                            <a class="attachment-link" href="@GetAttachmentDownloadUrl(adj)" download="@GetAttachmentDownloadName(adj)">
                                                                <i class="bi bi-file-earmark-arrow-down"></i>
                                                                <span>@adj.NombreArchivo</span>
                                                                @if (adj.TamanoBytes > 0)
                                                                {
                                                                    <span class="attachment-link__size">@FormatFileSize(adj.TamanoBytes)</span>
                                                                }
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <div class="attachment-unavailable @GetAttachmentRecoveryClass(adj)" title="@GetAttachmentUnavailableTitle(adj)">
                                                                <i class="bi @GetAttachmentUnavailableIcon(adj, "bi-file-earmark-x")"></i>
                                                                <span>@GetAttachmentUnavailableText(adj, "Archivo no disponible")</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                    @if (ShouldShowMessageFooter(message))
                                    {
                                    <div class="message-card__footer">
                                        <span>@GetMessageTypeLabel(message)</span>
                                        @if (!string.IsNullOrWhiteSpace(message.EstadoEnvio))
                                        {
                                            <span>• @message.EstadoEnvio</span>
                                        }
                                    </div>
                                    }
                                    @if (IsOutgoingMessage(message))
                                    {
                                        <div class="message-card__delivery">
                                            <span class="message-delivery @GetDeliveryClass(message.EstadoEnvio)" title="@GetDeliveryLabel(message.EstadoEnvio)">
                                                <i class="bi @GetDeliveryIcon(message.EstadoEnvio)"></i>
                                                <span>@GetDeliveryLabel(message.EstadoEnvio)</span>
                                            </span>
                                        </div>
                                    }
                                </article>
                                        @if (GetInlineReactions(message).Count > 0)
                                        {
                                            <div class="message-reactions">
                                                @foreach (var reaction in GetInlineReactions(message))
                                                {
                                                    <span title="@reaction">@reaction</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <details class="message-actions">
                                        <summary class="message-actions__trigger"
                                                 title="Más acciones"
                                                 aria-label="Más acciones">
                                            <i class="bi bi-three-dots"></i>
                                        </summary>
                                        <div class="message-actions__popout">
                                            <div class="message-actions__menu">
                                                @if (CanUseMessageAsAiFocus(message))
                                                {
                                                    <button type="button"
                                                            class="btn btn--ghost btn--sm message-action-button @(_aiFocusedMessageId == message.IdMensaje ? "is-active" : string.Empty)"
                                                            title="Consultar este mensaje con la IA"
                                                            @onclick="() => SelectAiFocusMessageAsync(message)">
                                                        <i class="bi bi-stars"></i>
                                                    </button>
                                                }
                                                @if (CanReactToMessage(message))
                                                {
                                                    <button type="button"
                                                            class="btn btn--ghost btn--sm message-action-button"
                                                            title="Reaccionar"
                                                            @onclick="() => ToggleReactionPicker(message.IdMensaje)">
                                                        <i class="bi bi-emoji-smile"></i>
                                                    </button>
                                                }
                                                @if (CanQuoteMessage(message))
                                                {
                                                    <button type="button"
                                                            class="btn btn--ghost btn--sm message-action-button"
                                                            title="Responder citando"
                                                            @onclick="() => QuoteMessageAsync(message)">
                                                        <i class="bi bi-reply-fill"></i>
                                                    </button>
                                                }
                                                <button type="button"
                                                        class="btn btn--ghost btn--sm message-action-button @(_anyDeskPromptMessageId == message.IdMensaje ? "is-active" : string.Empty)"
                                                        title="Conectar por AnyDesk"
                                                        @onclick="() => ToggleAnyDeskPromptAsync(message)">
                                                    <i class="bi bi-display"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn--ghost btn--sm message-action-button message-action-button--marca-pendiente @(string.Equals(message.MarcaInterna, "PENDIENTE", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                                                        title="Marcar pendiente (interno, no lo ve el cliente)"
                                                        @onclick="() => MarcarMensajePendienteAsync(message)">
                                                    <i class="bi bi-flag-fill"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn--ghost btn--sm message-action-button message-action-button--marca-completada @(string.Equals(message.MarcaInterna, "COMPLETADA", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                                                        title="Marcar completada (interno, no lo ve el cliente)"
                                                        @onclick="() => MarcarMensajeCompletadaAsync(message)">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </button>
                                            </div>
                                            @if (_anyDeskPromptMessageId == message.IdMensaje)
                                            {
                                                var isReadingImage = _anyDeskReadingImageMessageId == message.IdMensaje;
                                                <div class="anydesk-prompt" @onclick:stopPropagation>
                                                    <input type="text"
                                                           class="anydesk-prompt__input"
                                                           placeholder="@(isReadingImage ? "Leyendo imagen..." : "ID de AnyDesk (ej: 248 321 383)")"
                                                           value="@_anyDeskIdDraft"
                                                           disabled="@isReadingImage"
                                                           @oninput="args => _anyDeskIdDraft = args.Value?.ToString() ?? string.Empty"
                                                           autofocus />
                                                    <a class="btn btn--primary btn--sm anydesk-prompt__connect @(isReadingImage ? "is-disabled" : string.Empty)"
                                                       href="@(isReadingImage ? null : BuildAnyDeskUri(_anyDeskIdDraft))"
                                                       title="Conectar por AnyDesk"
                                                       @onclick="() => { if (!isReadingImage) CloseAnyDeskPrompt(); }">
                                                        <i class="bi @(isReadingImage ? "bi-hourglass-split" : "bi-display")"></i> Conectar
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </details>
                                </div>
                            }
                        }
                    </div>

                    @if (ShouldShowLatestButton)
                    {
                        <button type="button" class="conversations-latest-button" @onclick="ScrollToLatestAsync">
                            @if (_newMessagesCount > 0)
                            {
                                <span>Nuevo</span>
                                <strong>@_newMessagesCount</strong>
                            }
                            else
                            {
                                <span>Ir al final</span>
                            }
                            <i class="bi bi-arrow-down"></i>
                        </button>
                    }
                    </div>

                    @if (_selectedConversation?.Canal == "INTERNO")
                    {
                        var mencionables = _technicians.Where(t => !string.IsNullOrWhiteSpace(t.UsuarioAsociado)).ToList();
                        if (mencionables.Count > 0)
                        {
                            <div class="conversations-mencion" style="display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .6rem;padding:0 .2rem .5rem;">
                                <span class="conversations-mencion__label" style="font-size:.74rem;color:var(--color-muted);">Notificar a (opcional):</span>
                                <div class="conversations-mencion__list" style="display:flex;flex-wrap:wrap;gap:.4rem;">
                                    @foreach (var tech in mencionables)
                                    {
                                        var userName = tech.UsuarioAsociado;
                                        var isSelected = _mencionSeleccionados.Contains(userName);
                                        var chipStyle = isSelected
                                            ? "display:inline-flex;align-items:center;gap:.32rem;padding:.3rem .7rem;border-radius:999px;border:1px solid rgba(34,211,238,.55);font-size:.76rem;font-weight:600;line-height:1;cursor:pointer;background:rgba(34,211,238,.16);color:#22d3ee;transition:background .12s ease,border-color .12s ease;"
                                            : "display:inline-flex;align-items:center;gap:.32rem;padding:.3rem .7rem;border-radius:999px;border:1px solid transparent;font-size:.76rem;font-weight:600;line-height:1;cursor:pointer;background:rgba(148,163,184,.14);color:var(--color-muted);transition:background .12s ease,border-color .12s ease;";
                                        <label class="conversations-mencion__chip @(isSelected ? "is-active" : string.Empty)" style="@chipStyle">
                                            <input type="checkbox" checked="@isSelected" @onchange="args => ToggleMencion(userName, args)" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" />
                                            @if (isSelected)
                                            {
                                                <i class="bi bi-check-lg" style="font-size:.72rem;"></i>
                                            }
                                            <span>@tech.Nombre</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="conversations-composer conversations-composer--support" @ref="_composerDropZone">
                        @if (!IsWhatsAppWindowExpired)
                        {
                            <InputFile id="conv-file-drop-input" OnChange="HandleFileSelectedAsync" class="conversations-drop-input" multiple accept="image/*,audio/*,video/*,application/pdf,.doc,.docx,.xls,.xlsx,.zip,.rar" />
                            <div class="field conversations-composer__reply">
                                <label for="conv-message">
                                    @GetReplyLabel()
                                </label>
                                @if (!string.IsNullOrWhiteSpace(TypingIndicatorText))
                                {
                                    <div class="conversation-typing-indicator" aria-live="polite">
                                        <span class="conversation-typing-indicator__dots"><i></i><i></i><i></i></span>
                                        <span>@TypingIndicatorText</span>
                                    </div>
                                }
                                @if (_quotedMessage is not null)
                                {
                                    <div class="quoted-reply">
                                        <span>Respondiendo a <strong>@GetMessageAuthor(_quotedMessage)</strong>:</span>
                                        <span class="quoted-reply__preview">@GetQuotePreview(_quotedMessage)</span>
                                        <button type="button"
                                                class="btn btn--ghost btn--sm quoted-reply__clear"
                                                title="Quitar cita"
                                                @onclick="ClearQuotedMessage">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                                <textarea id="conv-message"
                                          @ref="_replyTextArea"
                                          @key="_selectedConversationId"
                                          rows="2"
                                          placeholder="@GetReplyPlaceholder()"
                                          @onfocus="MarkSelectedConversationAsRead"
                                          @onfocusin="OnReplyFocusAsync"
                                          @oninput="HandleReplyInputAsync"></textarea>
                            </div>
                            @if (_preparingAttachments.Count > 0 || _pendingAttachments.Count > 0)
                            {
                                <div class="conversations-pending-list conversations-pending-list--reply">
                                    @foreach (var preparing in _preparingAttachments)
                                    {
                                        <div class="conversations-pending-attachment is-loading">
                                            <i class="bi @GetPendingAttachmentIcon(preparing.TipoArchivo)"></i>
                                            <span title="@preparing.NombreArchivo">@preparing.NombreArchivo</span>
                                            <span class="conversations-pending-attachment__loading" aria-label="Preparando adjunto">
                                                <i></i><i></i><i></i>
                                            </span>
                                        </div>
                                    }
                                    @foreach (var pending in _pendingAttachments)
                                    {
                                        <div class="conversations-pending-attachment @(pending.IsUploading ? "is-loading" : pending.HasError ? "has-error" : string.Empty)">
                                            <i class="bi @GetPendingAttachmentIcon(pending.TipoArchivo)"></i>
                                            <span title="@pending.NombreArchivo">@pending.NombreArchivo</span>
                                            @if (CanPreviewPendingAttachment(pending))
                                            {
                                                <button type="button"
                                                        class="conversations-pending-attachment__preview-button"
                                                        style="grid-column:1 / -1;display:block;width:54px;height:42px;min-width:54px;max-width:54px;margin-top:.2rem;padding:0;border:1px solid rgba(56,189,248,.28);border-radius:6px;background:rgba(2,6,23,.34);overflow:hidden;cursor:zoom-in;"
                                                        title="Previsualizar imagen"
                                                        @onclick="() => OpenPendingAttachmentPreview(pending)">
                                                    <img class="conversations-pending-attachment__preview"
                                                         src="@pending.PreviewDataUrl"
                                                         alt="@pending.NombreArchivo"
                                                         style="display:block;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;"
                                                         loading="lazy" />
                                                </button>
                                            }
                                            @if (pending.IsUploading)
                                            {
                                                <span class="conversations-pending-attachment__loading" aria-label="Enviando adjunto">
                                                    <i></i><i></i><i></i>
                                                </span>
                                            }
                                            @if (pending.HasError)
                                            {
                                                <i class="bi bi-exclamation-circle-fill" title="@pending.Error"></i>
                                                <span class="conversations-pending-attachment__error" title="@pending.Error">@pending.Error</span>
                                            }
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => RemovePendingAttachment(pending.Id)" title="Quitar adjunto" disabled="@pending.IsUploading">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            <div class="conversations-composer__actions conversations-composer__actions--reply">
                                <button type="button"
                                        class="btn btn--ghost conversations-improve-ai"
                                        title="Mejorar con IA"
                                        aria-label="Mejorar con IA"
                                        @onclick="ImproveReplyWithAiAsync"
                                        disabled="@(_improvingReplyWithAi || !HasReplyText || !AlfaKnowledgeSvc.IsConfigured)">
                                    <i class="bi @(_improvingReplyWithAi ? "bi-hourglass-split" : "bi-stars")"></i>
                                </button>
                                <button type="button" class="btn btn--primary" @onclick="SendReplyAsync" disabled="@(!_canSendReply)" title="@GetReplyButtonTitle()">
                                    <i class="bi @(HasPendingAttachmentError ? "bi-arrow-clockwise" : "bi-send-fill")"></i>
                                </button>
                                <button type="button"
                                        class="btn btn--ghost"
                                        title="Más opciones"
                                        @onclick="ToggleComposerTools"
                                        @onclick:stopPropagation>
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            @if (_showComposerTools && !_reactionEmojiMessageId.HasValue)
                            {
                                <div class="panel-card conversations-tools-panel conversations-tools-panel--composer" @onclick:stopPropagation>
                                    <div class="conversations-composer__actions conversations-tools-panel__tabs">
                                        <button type="button" class="conversations-filter-pill @(_composerToolTab == ComposerToolTabs.Emojis ? "is-active" : string.Empty)" @onclick='() => _composerToolTab = ComposerToolTabs.Emojis'><i class="bi bi-emoji-smile"></i> Emojis</button>
                                        <button type="button" class="conversations-filter-pill @(_composerToolTab == ComposerToolTabs.Stickers ? "is-active" : string.Empty)" @onclick='() => _composerToolTab = ComposerToolTabs.Stickers'><i class="bi bi-star-fill"></i> Stickers</button>
                                        <button type="button" class="conversations-filter-pill @(_composerToolTab == ComposerToolTabs.Adjuntos ? "is-active" : string.Empty)" @onclick='() => _composerToolTab = ComposerToolTabs.Adjuntos'><i class="bi bi-paperclip"></i> Adjuntos</button>
                                        <button type="button" class="conversations-filter-pill mobile-only @(_composerToolTab == ComposerToolTabs.Notas ? "is-active" : string.Empty)" @onclick='() => _composerToolTab = ComposerToolTabs.Notas'><i class="bi bi-journal-text"></i> Nota</button>
                                    </div>
                                    @if (_composerToolTab == ComposerToolTabs.Emojis)
                                    {
                                        <input @key="ComposerToolTabs.Emojis" class="conversations-tools-panel__search" type="search" placeholder="Buscar emoji" value="@_emojiSearch" @oninput="HandleEmojiSearchInput" />
                                        @foreach (var group in FilteredEmojiGroups)
                                        {
                                            <div class="conversations-tools-panel__group">
                                                <strong class="context-card__label">@group.Nombre</strong>
                                                <div class="conversations-tools-panel__grid">
                                                    @foreach (var emoji in group.Emojis)
                                                    {
                                                        <button type="button" class="btn btn--ghost btn--sm conversations-tools-panel__emoji" title="@GetEmojiButtonTitle(emoji)" @onclick="() => SelectEmojiFromPanelAsync(emoji)">@emoji</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else if (_composerToolTab == ComposerToolTabs.Stickers)
                                    {
                                        <div @key="ComposerToolTabs.Stickers" class="conversations-tools-panel__actions">
                                            <label class="btn btn--ghost conversations-tools-panel__tool" title="Cargar sticker WebP">
                                                <i class="bi bi-plus-lg"></i> Crear
                                                <InputFile OnChange="HandleStickerSelectedAsync" style="display:none" multiple accept="image/webp,.webp" />
                                            </label>
                                    @if (_favoriteStickers.Count == 0)
                                    {
                                        <span class="context-card__muted">Todavía no hay stickers favoritos.</span>
                                    }
                                    @foreach (var sticker in _favoriteStickers)
                                    {
                                        <button type="button"
                                                class="btn btn--ghost conversations-tools-panel__sticker"
                                                title="@sticker.Nombre"
                                                @onclick="() => SendFavoriteStickerAsync(sticker.IdFavorito)"
                                                disabled="@_busyAction">
                                            <img src="@GetFavoriteStickerUrl(sticker)" alt="@sticker.Nombre" />
                                        </button>
                                    }
                                        </div>
                                    }
                                    else if (_composerToolTab == ComposerToolTabs.Adjuntos)
                                    {
                                        <div @key="ComposerToolTabs.Adjuntos" class="conversations-tools-panel__actions">
                                            <label class="btn btn--ghost conversations-tools-panel__tool" title="Adjuntar archivo">
                                                <i class="bi @(_uploadingFile ? "bi-hourglass-split" : "bi-paperclip")"></i>
                                                <span>Archivo</span>
                                                <InputFile OnChange="HandleFileSelectedAsync" style="display:none" multiple accept="image/*,audio/*,video/*,application/pdf,.doc,.docx,.xls,.xlsx,.zip,.rar" />
                                            </label>
                                            <button type="button" class="btn btn--ghost conversations-tools-panel__tool @(_recording ? "is-recording" : string.Empty)" @onclick="ToggleRecordingAsync" title="@(_recording ? "Detener grabación" : "Grabar mensaje de voz")" disabled="@_uploadingAudio">
                                                <i class="bi @(_recording ? "bi-stop-circle-fill" : "bi-mic-fill")"></i>
                                                <span>Audio</span>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div @key="ComposerToolTabs.Notas" class="field conversations-composer__note conversations-composer__note--mobile">
                                            <label for="conv-note-mobile">Nota interna</label>
                                            <textarea id="conv-note-mobile"
                                                      @ref="_internalNoteMobileTextArea"
                                                      @key="_selectedConversationId"
                                                      rows="1"
                                                      placeholder="Escribí una nota interna visible solo para el equipo…"
                                                      ></textarea>
                                        </div>
                                        <div class="conversations-composer__actions conversations-composer__actions--note conversations-composer__actions--note-mobile">
                                            <button type="button" class="btn btn--ghost" @onclick="() => AddInternalNoteAsync()" disabled="@(_busyAction || _selectedConversation is null)" title="Guardar nota interna">
                                                <i class="bi bi-journal-text"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        }

                        <div class="field conversations-composer__note">
                            <label for="conv-note">Nota interna</label>
                            <textarea id="conv-note"
                                      @ref="_internalNoteTextArea"
                                      @key="_selectedConversationId"
                                      rows="1"
                                      placeholder="Escribí una nota interna visible solo para el equipo…"
                                      ></textarea>
                        </div>
                        <div class="conversations-composer__actions conversations-composer__actions--note">
                            <button type="button" class="btn btn--ghost" @onclick="() => AddInternalNoteAsync()" disabled="@(_busyAction || _selectedConversation is null)" title="Guardar nota interna">
                                <i class="bi bi-journal-text"></i>
                            </button>
                        </div>
                    </div>
                }
            </section>

            <aside class="panel-card conversations-context conversations-context-drawer @(_showContextPanel ? "is-open" : string.Empty)">
                <button type="button" class="conversations-drawer-close" title="Cerrar contexto" @onclick="ToggleContextPanel">
                    <i class="bi bi-x-lg"></i>
                </button>
                <div class="conversations-context__section">
                    <h3 class="panel-card__title">Contexto</h3>
                    <p class="panel-card__subtitle">Cliente, contacto y gestión</p>
                </div>

                @if (_selectedConversation is null)
                {
                    <div class="conversations-empty">
                        Seleccioná una conversación para ver sus datos.
                    </div>
                }
                else
                {
                    @if (_selectedConversation.Canal != "INTERNO")
                    {
                        <div class="context-card">
                            <span class="context-card__label">Cliente</span>
                            <strong>@DisplayOrFallback(_selectedConversation.ClienteNombre)</strong>
                            <span class="context-card__muted">@DisplayOrFallback(_selectedConversation.ClienteCodigo)</span>
                            @if (!string.IsNullOrWhiteSpace(_selectedConversation.ClienteCodigo))
                            {
                                <button type="button" class="btn btn--ghost btn--sm context-card__action" @onclick="OpenSelectedClient">
                                    <i class="bi bi-building"></i> Ver cliente
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn--primary btn--sm context-card__action" @onclick="OpenRelacionarClienteModal">
                                    <i class="bi bi-building-add"></i> Relacionar cliente
                                </button>
                            }
                        </div>

                        <div class="context-card">
                            <span class="context-card__label">Contacto</span>
                            <strong>@DisplayOrFallback(_selectedConversation.ContactoNombre)</strong>
                            <span class="context-card__muted">@DisplayOrFallback(_selectedConversation.ContactoCargo)</span>
                            <span class="context-card__muted">@DisplayOrFallback(_selectedConversation.ContactoCelular, _selectedConversation.ContactoTelefono)</span>
                            <span class="context-card__muted">@DisplayOrFallback(_selectedConversation.ContactoEmail)</span>
                            @if (_selectedConversation.IdContacto.HasValue)
                            {
                                <button type="button" class="btn btn--ghost btn--sm context-card__action" @onclick="OpenSelectedContact">
                                    <i class="bi bi-person-lines-fill"></i> Ver contacto
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn--primary btn--sm context-card__action" @onclick="OpenNewContactFromSelectedConversation">
                                    <i class="bi bi-person-plus-fill"></i> Crear contacto
                                </button>
                            }
                        </div>

                        @if (_loadingContextNotes)
                        {
                            <div class="context-card">
                                <span class="context-card__label">Observaciones</span>
                                <span class="context-card__muted">Cargando notas...</span>
                            </div>
                        }
                        else if (HasContextNotes)
                        {
                            <button type="button"
                                    class="context-card"
                                    style="width:100%;text-align:left;cursor:pointer;border-color:rgba(34,211,238,.78);background:#071524;color:#e5f4ff;box-shadow:inset 3px 0 0 #22d3ee,0 0 0 1px rgba(34,211,238,.14);"
                                    @onclick="OpenContextNotesModal">
                                <span class="context-card__label">Observaciones</span>
                                <strong style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;">@ContextNotesPreview</strong>
                                <span class="context-card__muted">Ver notas de cliente/contacto</span>
                            </button>
                        }

                        <div class="conversations-context__section">
                            <h4 class="panel-card__title">Tickets</h4>
                            <p class="panel-card__subtitle">@GetContextTicketsSubtitle()</p>
                            @if (_contextTicketMatches.Count > 0)
                            {
                                <div class="conversations-context-tickets">
                                    @foreach (var match in _contextTicketMatches.Take(6))
                                    {
                                        <article class="conversations-context-ticket">
                                            <div>
                                                <strong>@match.Ticket.CodigoVisible @match.Ticket.Titulo</strong>
                                                <span>@match.Ticket.EstadoNombre · @RenderTicketPriority(match.Ticket.Prioridad) · @DisplayOrFallback(match.Ticket.TecnicoNombre, "Sin asignar")</span>
                                                <small>@BuildContextTicketPreview(match)</small>
                                            </div>
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenTicket(match.Ticket.IdTicket)">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </button>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                        <div class="conversations-context__section">
                            <h4 class="panel-card__title">Plantillas</h4>
                            <p class="panel-card__subtitle">Mensajes aprobados por Meta</p>
                            <button type="button" class="btn btn--primary" @onclick="OpenTemplatePanel" disabled="@(!CanOpenTemplatePanel)">
                                <i class="bi bi-send-fill"></i> Enviar plantilla
                            </button>
                        </div>
                    }

                    <div class="conversations-context__section">
                        <h4 class="panel-card__title">Asignación</h4>
                        <div class="field">
                            <label for="conv-tech">Técnico</label>
                            <select id="conv-tech" value="@_assignmentTechnicianId" @onchange="OnAssignmentChangedAsync" disabled="@_busyAction">
                                <option value="">Sin asignar</option>
                                @foreach (var tech in GetAssignableTechnicians())
                                {
                                    <option value="@tech.IdTecnico">@tech.Nombre (@tech.IdTecnico)</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (_actionMessage is not null)
                    {
                        <div class="conversations-inline conversations-inline--ok conversations-notice @GetConversationNoticeLeavingClass()">@_actionMessage</div>
                    }
                    @if (_actionError is not null)
                    {
                        <div class="conversations-inline conversations-inline--error conversations-notice @GetConversationNoticeLeavingClass()">@_actionError</div>
                    }
                }
            </aside>
            </div>
        </div>
        </div>

        <div class="conversations-column-resizer conversations-column-resizer--ai @(_showAiSuggestionPanel ? "is-visible" : string.Empty)"
             data-conversations-resizer="ai"
             role="separator"
             aria-label="Cambiar ancho de AlfaKnowledge"
             aria-orientation="vertical"
             tabindex="@(_showAiSuggestionPanel ? "0" : "-1")"></div>

        <aside class="panel-card conversations-context conversations-context-drawer conversations-ai-suggestion-drawer @(_showAiSuggestionPanel ? "is-open" : string.Empty)">
                <div class="conversations-context__section conversations-ai-header">
                    <div class="conversations-ai-header__identity">
                        <span class="conversations-ai-header__avatar"><i class="bi bi-stars"></i></span>
                        <div>
                            <h3 class="panel-card__title">Base de conocimiento</h3>
                            <p class="panel-card__subtitle"><span></span> Asistente para esta conversación</p>
                        </div>
                    </div>
                    @if (AlfaKnowledgeSvc.IsConfigured)
                    {
                        <a class="btn btn--ghost btn--sm conversations-ai-full-link"
                           href="@AlfaKnowledgeSvc.FullChatUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            <i class="bi bi-box-arrow-up-right"></i> Abrir base completa
                        </a>
                    }
                    <button type="button" class="conversations-drawer-close" title="Cerrar sugerencia IA" aria-label="Cerrar asistente" @onclick="ToggleAiSuggestionPanel">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="conversations-ai-body">
                @if (_selectedConversation is null)
                {
                    <div class="conversations-empty">Seleccioná una conversación para usar el asistente.</div>
                }
                else
                {
                    <div class="conversations-ai-context">
                        <label for="ai-context-scope">Contexto que leerá la IA</label>
                        <select id="ai-context-scope" value="@_aiContextScope" @onchange="OnAiContextScopeChangedAsync" disabled="@_loadingAiSuggestion">
                            <option value="@AiContextScopes.CurrentCycle">Tramo actual</option>
                            <option value="@AiContextScopes.EntireConversation">Toda la conversación</option>
                            <option value="@AiContextScopes.FocusedMessage" disabled="@(!_aiFocusedMessageId.HasValue)">Mensaje marcado</option>
                        </select>
                        <small>@GetAiContextDescription()</small>
                        @if (HasAiContextImage())
                        {
                            <small class="conversations-ai-image-context">
                                <i class="bi bi-image"></i> También analizará la última imagen enviada por el cliente.
                            </small>
                        }
                    </div>

                    @if (_aiFocusedMessageId.HasValue && GetAiFocusedMessage() is { } focusedMessage)
                    {
                        <div class="conversations-ai-focus">
                            <span>Mensaje marcado</span>
                            <strong>@GetAiMessagePreview(focusedMessage)</strong>
                            <button type="button" class="btn btn--ghost btn--sm" title="Quitar selección" @onclick="ClearAiFocusMessage">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }

                    @if (_aiChatHistory.Count > 0)
                    {
                        <div class="conversations-ai-chat" aria-live="polite">
                            @foreach (var turn in _aiChatHistory)
                            {
                                <div class="conversations-ai-chat__message conversations-ai-chat__message--@turn.Role">
                                    <span>@(turn.Role == "assistant" ? "IA" : "Vos")</span>
                                    <p>@turn.Content</p>
                                </div>
                            }
                        </div>
                    }

                    @if (_loadingAiSuggestion)
                    {
                        <div class="conversations-empty conversations-ai-typing">
                            <i class="bi bi-stars"></i> Analizando el contexto seleccionado
                            <span class="conversations-ai-typing__dots"><span></span><span></span><span></span></span>
                        </div>
                    }
                    else if (_aiSuggestion is null)
                    {
                        @if (!string.IsNullOrWhiteSpace(_aiSuggestionError))
                        {
                            <div class="conversations-empty">@_aiSuggestionError</div>
                        }
                    }
                    else
                    {
                        @if (_aiChatHistory.Count == 0)
                        {
                            @if (_aiSuggestion.NeedsClarification)
                            {
                                <div class="context-card" style="border-color:rgba(250,204,21,.6);background:#1a1506;">
                                    <span class="context-card__label">La IA pide una aclaración</span>
                                    <strong>@_aiSuggestion.ClarificationQuestion</strong>
                                </div>
                            }
                            else
                            {
                                <div class="context-card">
                                    <span class="context-card__label">Respuesta sugerida</span>
                                    <strong style="white-space:pre-wrap;">@_aiSuggestion.SuggestedReply</strong>
                                </div>
                            }
                        }

                        <div class="conversations-ai-suggestion-actions">
                            <button type="button"
                                    class="btn btn--primary btn--sm"
                                    @onclick="UseAiSuggestionAsync"
                                    disabled="@string.IsNullOrWhiteSpace(GetAiTransferText())">
                                <i class="bi bi-check2"></i> Llevar a respuesta
                            </button>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="RegenerateAiSuggestionAsync">
                                <i class="bi bi-arrow-repeat"></i> Regenerar
                            </button>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="OpenAiCorrectionModal">
                                <i class="bi bi-pencil-square"></i> Corregir respuesta
                            </button>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="DiscardAiSuggestionAsync">
                                <i class="bi bi-x-lg"></i> Descartar
                            </button>
                        </div>

                        @if (_aiSuggestion.Citations.Count > 0)
                        {
                            <div class="conversations-context__section conversations-ai-sources @(_aiSourcesExpanded ? "is-expanded" : "is-collapsed")">
                                <button type="button"
                                        class="conversations-ai-sources__toggle"
                                        aria-expanded="@_aiSourcesExpanded"
                                        @onclick="ToggleAiSources">
                                    <span>Fuentes <span class="conversations-ai-source-count">· @_aiSuggestion.Citations.Count</span></span>
                                    <i class="bi @(_aiSourcesExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </button>
                                @if (_aiSourcesExpanded)
                                {
                                    <div class="conversations-ai-sources__list">
                                        @foreach (var citation in _aiSuggestion.Citations)
                                        {
                                            <a class="conversations-ai-source-link"
                                               href="@AlfaKnowledgeSvc.GetCitationUrl(citation)"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               title="Abrir fuente en una pestaña nueva">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                                <span title="@citation.SourceLabel — @citation.Title">@citation.SourceLabel — @citation.Title</span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                    <div class="conversations-ai-composer">
                        <label for="ai-technician-message">Hablá con la IA sobre este caso</label>
                        <textarea id="ai-technician-message"
                                  @ref="_aiInstructionTextArea"
                                  rows="3"
                                  placeholder="Ej.: resumime el problema, ¿qué debería preguntarle?, redactá una respuesta más breve..."
                                  value="@_aiInstruction"
                                  @oninput="OnAiInstructionInput"
                                  disabled="@_loadingAiSuggestion"></textarea>
                        <button type="button"
                                class="btn btn--primary btn--sm"
                                @onclick="SendAiInstructionAsync"
                                disabled="@(_loadingAiSuggestion || string.IsNullOrWhiteSpace(_aiInstruction))">
                            <i class="bi bi-send-fill"></i> Enviar a IA
                        </button>
                    </div>
                }
                </div>
            </aside>
    }
</section>

@if (_showAiCorrectionModal)
{
    <div class="modal-overlay conversations-ai-correction-overlay" @onclick="CloseAiCorrectionModal">
        <div class="modal-card conversations-ai-correction-modal" role="dialog" aria-modal="true" aria-labelledby="ai-correction-title" @onclick:stopPropagation>
            <div class="conversations-ai-correction-modal__header">
                <div>
                    <h3 id="ai-correction-title" class="modal-card__title">Corregir respuesta</h3>
                    @if (_aiSuggestion?.InteractionId != Guid.Empty)
                    {
                        <small>Basado en la interacción @_aiSuggestion?.InteractionId</small>
                    }
                </div>
                <button type="button" class="conversations-drawer-close" title="Cerrar" aria-label="Cerrar corrección" @onclick="CloseAiCorrectionModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <label class="field">
                <span>Título</span>
                <input type="text" @bind="_aiCorrectionTitle" disabled="@_savingAiCorrection" />
            </label>
            <label class="field">
                <span>Pregunta original</span>
                <textarea rows="3" @bind="_aiCorrectionQuestion" disabled="@_savingAiCorrection"></textarea>
            </label>
            <label class="field">
                <span>Respuesta curada</span>
                <textarea class="conversations-ai-correction-modal__answer" rows="7" @bind="_aiCorrectionAnswer" disabled="@_savingAiCorrection"></textarea>
            </label>
            <label class="field">
                <span>Notas de corrección</span>
                <textarea rows="3" placeholder="Qué estaba mal o qué faltaba" @bind="_aiCorrectionNotes" disabled="@_savingAiCorrection"></textarea>
            </label>

            @if (!string.IsNullOrWhiteSpace(_aiCorrectionError))
            {
                <div class="conversations-ai-correction-modal__error" role="alert">@_aiCorrectionError</div>
            }

            <p class="conversations-ai-correction-modal__hint">Reemplazá la respuesta por la versión correcta y guardala en AlfaKnowledge.</p>
            <div class="modal-card__actions">
                <button type="button" class="btn btn--ghost" @onclick="CloseAiCorrectionModal" disabled="@_savingAiCorrection">Cancelar</button>
                <button type="button"
                        class="btn btn--primary"
                        @onclick="SaveAiCorrectionAsync"
                        disabled="@(_savingAiCorrection || !CanSaveAiCorrection)">
                    @if (_savingAiCorrection)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    Guardar respuesta curada
                </button>
            </div>
        </div>
    </div>
}

@if (_showContextNotesModal && HasContextNotes)
{
    <div class="modal-overlay" style="background:rgba(3,7,18,.78);backdrop-filter:blur(2px);" @onclick="CloseContextNotesModal">
        <div class="modal-card" style="width:min(1180px,calc(100vw - 2rem));max-height:min(88vh,820px);overflow-y:auto;overflow-x:hidden;background:#071524;color:#e5f4ff;border:1px solid rgba(34,211,238,.45);box-shadow:0 22px 70px rgba(0,0,0,.65);" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Observaciones</h3>
                    <p class="panel-card__subtitle">@GetConversationHeader(_selectedConversation!)</p>
                </div>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseContextNotesModal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem;">
                <button type="button"
                        class="btn btn--sm @(_contextNotesTab == ContextNotesTabs.Observaciones ? "btn--primary" : "btn--ghost")"
                        @onclick="() => _contextNotesTab = ContextNotesTabs.Observaciones">
                    Observaciones (@_contextNotes.ObservationSections.Count)
                </button>
                <button type="button"
                        class="btn btn--sm @(_contextNotesTab == ContextNotesTabs.OtrasNotas ? "btn--primary" : "btn--ghost")"
                        @onclick="() => _contextNotesTab = ContextNotesTabs.OtrasNotas">
                    Otras notas (@_contextNotes.OtherSections.Count)
                </button>
            </div>
            <div style="display:grid;gap:.85rem;">
                @foreach (var note in ActiveContextNoteSections)
                {
                    <div class="context-card" style="background:#0b1828;color:#e5f4ff;border-color:rgba(148,163,184,.28);min-width:0;max-width:100%;overflow:hidden;">
                        <span class="context-card__label">@note.Label</span>
                        <div style="white-space:pre-wrap;line-height:1.5;font-size:.95rem;color:#f8fafc;max-width:100%;overflow-wrap:anywhere;word-break:break-word;">@note.Text</div>
                    </div>
                }
                @if (ActiveContextNoteSections.Count == 0)
                {
                    <div class="context-card" style="background:#0b1828;color:#cbd5e1;border-color:rgba(148,163,184,.28);">
                        No hay información cargada en esta solapa.
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_showTemplatePanel)
{
    <div class="modal-overlay conversations-template-modal">
        <div class="modal-card conversations-template-modal__card" @onclick:stopPropagation>
            <header class="conversations-template-modal__header">
                <div>
                    <h3 class="modal-card__title">Enviar plantilla de WhatsApp</h3>
                    <p>La conversación queda visible detrás para revisar el contexto antes de enviar.</p>
                </div>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseTemplatePanel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="conversations-template-modal__body">
                <div class="conversations-template-modal__form">
                    <div class="field">
                        <label for="conv-template-modal">Plantilla</label>
                        <select id="conv-template-modal" @bind="_selectedTemplateId" @bind:after="OnTemplateChangedAsync" disabled="@(_loadingTemplates || _availableTemplates.Count == 0)">
                            @if (_loadingTemplates)
                            {
                                <option value="0">Cargando plantillas...</option>
                            }
                            else if (_availableTemplates.Count == 0)
                            {
                                <option value="0">No hay plantillas aprobadas</option>
                            }
                            else
                            {
                                <option value="0">Seleccioná una plantilla</option>
                                @foreach (var template in _availableTemplates)
                                {
                                    <option value="@template.IdPlantilla">@template.NombreVisible (@GetTemplateStatusLabel(template.EstadoMeta))</option>
                                }
                            }
                        </select>
                    </div>

                    @if (SelectedTemplate is not null && CountTemplateVariables(SelectedTemplate.CuerpoTexto) > 0)
                    {
                        <div class="field">
                            <label for="conv-template-values-modal">Variables editables</label>
                            <textarea id="conv-template-values-modal"
                                      rows="4"
                                      placeholder="Un valor por línea"
                                      @bind="_templateValuesText"></textarea>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_templateAutoNotice))
                    {
                        <div class="conversations-context__hint">
                            <i class="bi bi-info-circle"></i>
                            <span>@_templateAutoNotice</span>
                        </div>
                    }

                    <div class="field">
                        <label>Adjuntos</label>
                        <label class="btn btn--ghost" title="Adjuntar archivo" style="cursor:pointer; width: fit-content;">
                            <i class="bi @(_uploadingTemplateFile ? "bi-hourglass-split" : "bi-paperclip")"></i>
                            Adjuntar PDF / imagen / archivo
                            <InputFile OnChange="HandleTemplateFileSelectedAsync" style="display:none" multiple
                                       accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx,.txt" />
                        </label>
                    </div>

                    @if (_templatePreparingAttachments.Count > 0 || _templatePendingAttachments.Count > 0)
                    {
                        <div class="conversations-pending-list">
                            @foreach (var preparing in _templatePreparingAttachments)
                            {
                                <div class="conversations-pending-attachment is-loading">
                                    <i class="bi @GetPendingAttachmentIcon(preparing.TipoArchivo)"></i>
                                    <span title="@preparing.NombreArchivo">@preparing.NombreArchivo</span>
                                    <span class="conversations-pending-attachment__loading" aria-label="Preparando adjunto">
                                        <i></i><i></i><i></i>
                                    </span>
                                </div>
                            }
                            @foreach (var pending in _templatePendingAttachments)
                            {
                                <div class="conversations-pending-attachment @(pending.IsUploading ? "is-loading" : pending.HasError ? "has-error" : string.Empty)">
                                    <i class="bi @GetPendingAttachmentIcon(pending.TipoArchivo)"></i>
                                    <span title="@pending.NombreArchivo">@pending.NombreArchivo</span>
                                    @if (pending.IsUploading)
                                    {
                                        <span class="conversations-pending-attachment__loading" aria-label="Enviando adjunto">
                                            <i></i><i></i><i></i>
                                        </span>
                                    }
                                    @if (pending.HasError)
                                    {
                                        <i class="bi bi-exclamation-circle-fill" title="@pending.Error"></i>
                                    }
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => RemoveTemplatePendingAttachment(pending.Id)" title="Quitar adjunto" disabled="@pending.IsUploading">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div class="context-card">
                        <span class="context-card__label">Destino</span>
                        <strong>@DisplayOrFallback(_selectedConversation?.NombreVisible, _selectedConversation?.ContactoNombre)</strong>
                        <span class="context-card__muted">@DisplayOrFallback(_selectedConversation?.TelefonoWhatsApp)</span>
                    </div>
                </div>

                <div class="conversations-template-phone-preview">
                    <span class="context-card__label">Vista previa</span>
                    <article class="message-card message-card--outgoing">
                        @if (SelectedTemplate is null)
                        {
                            <p class="message-card__text">Seleccioná una plantilla para ver el mensaje.</p>
                        }
                        else
                        {
                            <strong>@SelectedTemplate.NombreVisible</strong>
                            <p class="message-card__text">@RenderTemplatePreview(SelectedTemplate, TemplateValues)</p>
                        }
                    </article>
                </div>
            </div>

            <div class="modal-card__actions">
                <button type="button" class="btn btn--primary" @onclick="SendTemplateAsync" disabled="@(!CanSendTemplate)">
                    <i class="bi bi-send-fill"></i> Enviar mensaje
                </button>
                <button type="button" class="btn btn--ghost" @onclick="CloseTemplatePanel">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
}

@if (_showNuevoHilo)
{
    <div class="modal-overlay conversations-new-thread-modal" @onclick="CerrarNuevoHilo">
        <div class="modal-card conversations-new-thread-modal__card" @onclick:stopPropagation>
            <h3 class="modal-card__title">Nuevo hilo interno</h3>
            <div class="field">
                <label for="hilo-nombre">Nombre del hilo</label>
                <input id="hilo-nombre" type="text" @bind="_nuevoHiloNombre"
                       placeholder="Ej: Revisión instalación cliente X…" />
            </div>
            <div class="field">
                <label for="hilo-tecnico">Asignar a técnico (opcional)</label>
                <select id="hilo-tecnico" @bind="_nuevoHiloTecnico">
                    <option value="">Sin asignar</option>
                    @foreach (var tech in _technicians)
                    {
                        <option value="@tech.IdTecnico">@tech.Nombre (@tech.IdTecnico)</option>
                    }
                </select>
            </div>
            @if (_nuevoHiloError is not null)
            {
                <div class="conversations-error conversations-notice @GetConversationNoticeLeavingClass()">@_nuevoHiloError</div>
            }
            <div class="modal-card__actions">
                <button type="button" class="btn btn--primary" @onclick="CrearHiloInternoAsync" disabled="@_busyAction">
                    <i class="bi bi-plus-circle-fill"></i> Crear hilo
                </button>
                <button type="button" class="btn btn--ghost" @onclick="CerrarNuevoHilo">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

@if (_previewAttachment is not null)
{
    <div class="attachment-preview-overlay" @onclick="CloseAttachmentPreview">
        <div class="attachment-preview-modal" @onclick:stopPropagation>
            <header class="attachment-preview-header">
                <span>@GetAttachmentLabel(_previewAttachment)</span>
                <div class="attachment-preview-actions">
                    <a class="attachment-preview-action"
                       href="@GetAttachmentDownloadUrl(_previewAttachment)"
                       download="@GetAttachmentDownloadName(_previewAttachment)"
                       title="Descargar"
                       aria-label="Descargar">
                        <i class="bi bi-download"></i>
                    </a>
                    @if (IsPreviewZoomableAttachment(_previewAttachment))
                    {
                        <button type="button" class="attachment-preview-action" @onclick="ZoomPreviewOut" title="Alejar" aria-label="Alejar">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                        <button type="button" class="attachment-preview-action attachment-preview-zoom-button" @onclick="ResetPreviewView" title="Restablecer vista" aria-label="Restablecer vista">
                            @PreviewZoomPercent
                        </button>
                        <button type="button" class="attachment-preview-action" @onclick="ZoomPreviewIn" title="Acercar" aria-label="Acercar">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                        @if (IsImageAttachment(_previewAttachment))
                        {
                            <button type="button" class="attachment-preview-action" @onclick="RotatePreviewLeft" title="Rotar a la izquierda" aria-label="Rotar a la izquierda">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button type="button" class="attachment-preview-action" @onclick="RotatePreviewRight" title="Rotar a la derecha" aria-label="Rotar a la derecha">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        }
                    }
                    <button type="button" class="attachment-preview-action" @onclick="CloseAttachmentPreview" title="Cerrar" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </header>
            <div class="attachment-preview-body">
                <button type="button" class="attachment-preview-nav attachment-preview-nav--prev" @onclick="ShowPreviousPreviewAttachment" disabled="@(!CanNavigatePreviewGallery)" title="Anterior">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <div class="@PreviewCanvasClass"
                     @ref="_previewCanvas"
                     @onwheel="HandlePreviewWheel"
                    @onwheel:preventDefault>
                    <div class="attachment-preview-media-frame" style="@PreviewFrameStyle">
                        @if (IsVideoAttachment(_previewAttachment))
                        {
                            <video @key="_previewAttachment.IdAdjunto" controls autoplay src="@GetAttachmentUrl(_previewAttachment)" style="@PreviewVideoStyle">
                                Tu navegador no puede reproducir este video.
                            </video>
                        }
                        else
                        {
                            <img @key="_previewAttachment.IdAdjunto"
                                 src="@GetAttachmentUrl(_previewAttachment)"
                                 alt="@GetAttachmentLabel(_previewAttachment)"
                                 draggable="false"
                                 style="@PreviewImageStyle" />
                        }
                    </div>
                    @if (CanPanPreview)
                    {
                        <div class="attachment-preview-drag-surface"
                             title="Mover"></div>
                    }
                </div>
                <button type="button" class="attachment-preview-nav attachment-preview-nav--next" @onclick="ShowNextPreviewAttachment" disabled="@(!CanNavigatePreviewGallery)" title="Siguiente">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            @if (PreviewGallery.Count > 1)
            {
                <div class="attachment-preview-strip" aria-label="Adjuntos multimedia de la conversacion">
                    @foreach (var item in PreviewGallery)
                    {
                        <button type="button"
                                class="@GetPreviewThumbClass(item)"
                                data-preview-attachment-id="@item.IdAdjunto"
                                title="@GetAttachmentLabel(item)"
                                @onclick="() => OpenAttachmentPreview(item)">
                            @if (IsVideoAttachment(item))
                            {
                                <video preload="metadata" muted src="@GetAttachmentUrl(item)"></video>
                                <span><i class="bi bi-play-fill"></i></span>
                            }
                            else
                            {
                                <img src="@GetAttachmentPreviewUrl(item)" alt="@GetAttachmentLabel(item)" loading="lazy" decoding="async" />
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@if (_previewPendingAttachment is not null)
{
    <div class="attachment-preview-overlay" @onclick="ClosePendingAttachmentPreview">
        <div class="attachment-preview-modal attachment-preview-modal--pending" @onclick:stopPropagation>
            <header class="attachment-preview-header">
                <span>@_previewPendingAttachment.NombreArchivo</span>
                <div class="attachment-preview-actions">
                    <button type="button" class="attachment-preview-action" @onclick="ClosePendingAttachmentPreview" title="Cerrar" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </header>
            <div class="attachment-preview-body attachment-preview-body--pending" style="display:block;min-height:0;">
                <div class="attachment-preview-canvas" style="display:flex;align-items:center;justify-content:center;height:min(72vh,680px);min-height:min(72vh,680px);max-height:calc(92vh - 5.5rem);overflow:hidden;cursor:default;">
                    <img src="@_previewPendingAttachment.PreviewDataUrl"
                         alt="@_previewPendingAttachment.NombreArchivo"
                         style="display:block;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;transform:none;"
                         draggable="false" />
                </div>
            </div>
        </div>
    </div>
}

@if (_showTicketDialog)
{
    <div class="conversations-modal-backdrop" @onclick="CloseTicketDialog"></div>
    <section class="panel-card conversations-modal conversations-ticket-dialog">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Crear ticket</h3>
                <p class="panel-card__subtitle">@_selectedTicketMessageIds.Count mensaje(s) quedarán vinculados al ticket.</p>
            </div>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseTicketDialog" disabled="@_creatingTicket">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_ticketError))
        {
            <div class="conversations-error conversations-notice @GetConversationNoticeLeavingClass()">@_ticketError</div>
        }
        @if (_checkingRelatedTickets)
        {
            <div class="conversations-ticket-duplicates conversations-ticket-duplicates--loading">
                <i class="bi bi-search"></i>
                <span>Revisando tickets abiertos relacionados...</span>
            </div>
        }
        else if (_relatedTicketMatches.Count > 0 && !_allowCreateDespiteRelated)
        {
            <div class="conversations-ticket-duplicates">
                <div class="conversations-ticket-duplicates__head">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <strong>Posible ticket existente</strong>
                        <span>Encontramos @_relatedTicketMatches.Count ticket(s) abierto(s) que podrían ser la misma consulta.</span>
                    </div>
                </div>
                @if (GetRelatedTerms().Count > 0)
                {
                    <div class="conversations-ticket-duplicates__terms">
                    @foreach (var term in GetRelatedTerms())
                    {
                        <span>@term</span>
                    }
                    </div>
                }
                <div class="conversations-ticket-duplicates__list">
                    @foreach (var match in _relatedTicketMatches.Take(4))
                    {
                        <article class="conversations-ticket-duplicate">
                            <div>
                                <strong>@match.Ticket.CodigoVisible @match.Ticket.Titulo</strong>
                                <span>@match.Ticket.EstadoNombre · @RenderTicketPriority(match.Ticket.Prioridad) · @DisplayOrFallback(match.Ticket.TecnicoNombre, "Sin asignar")</span>
                                <small>@BuildRelatedReason(match)</small>
                            </div>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenTicket(match.Ticket.IdTicket)">
                                <i class="bi bi-box-arrow-up-right"></i> Abrir
                            </button>
                        </article>
                    }
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary btn--sm" @onclick="() => _allowCreateDespiteRelated = true">
                        Crear igual
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseTicketDialog">
                        Revisar antes
                    </button>
                </div>
            </div>
        }
        <div class="tickets-from-conversation-form">
            <div class="field">
                <label>Nombre del ticket</label>
                <input type="text" maxlength="180" @bind="_ticketTitle" disabled="@_creatingTicket" placeholder="Ej.: Problema con VPN" />
            </div>
            <div class="field">
                <label>Prioridad</label>
                <select @bind="_ticketPriority" disabled="@_creatingTicket">
                    <option value="0">Sin prioridad</option>
                    <option value="1">Baja</option>
                    <option value="2">Media</option>
                    <option value="3">Alta</option>
                </select>
            </div>
            <div class="field">
                <label>Comentario / observación</label>
                <textarea rows="4" maxlength="4000" @bind="_ticketDescription" disabled="@_creatingTicket" placeholder="Detalle adicional para el ticket..."></textarea>
            </div>
            <div class="field">
                <label>Asignado a</label>
                <div class="ticket-creator-assignment">
                    <span>@CurrentMessageTechnicianName</span>
                    <small>Se asignará automáticamente al usuario que crea el ticket.</small>
                </div>
            </div>
        </div>
        <div class="actions usuarios-editor__actions">
            <button type="button" class="btn btn--primary" @onclick="CreateTicketFromSelectionAsync" disabled="@(_creatingTicket || _checkingRelatedTickets)">
                <i class="bi bi-floppy"></i> @(_creatingTicket ? "Creando..." : "Guardar ticket")
            </button>
            <button type="button" class="btn btn--ghost" @onclick="CloseTicketDialog" disabled="@_creatingTicket">
                Cancelar
            </button>
        </div>
    </section>
}

@if (_showParteHorasDialog)
{
    <div class="conversations-modal-backdrop conversations-hours-backdrop" @onclick="CloseParteHorasDialog"></div>
    <section class="panel-card conversations-modal conversations-hours-dialog"
             aria-labelledby="conversations-hours-title"
             tabindex="-1"
             @ref="_parteHorasDialogElement"
             @onkeydown="HandleParteHorasDialogKeyDownAsync">
        <div class="conversations-hours-dialog__head">
            <div class="conversations-hours-dialog__title">
                <span class="conversations-hours-dialog__icon"><i class="bi bi-stopwatch"></i></span>
                <div>
                    <h3 id="conversations-hours-title" class="panel-card__title">Parte de horas</h3>
                    <p class="panel-card__subtitle">Tiempo detectado hasta este cierre manual pendiente.</p>
                </div>
            </div>
            <button type="button" class="btn btn--ghost btn--sm conversations-hours-dialog__close" @onclick="CloseParteHorasDialog" disabled="@_savingParteHora" aria-label="Cerrar parte de horas">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="conversations-hours-summary">
            <div>
                <span>Tiempo sugerido</span>
                <strong>@FormatParteHorasDuration(_parteHoraSuggestedMinutes)</strong>
            </div>
            <div>
                <span>Tramo</span>
                <strong>@FormatParteHorasRange()</strong>
            </div>
            <div>
                <span>Cliente</span>
                <strong>@DisplayOrFallback(_parteHoraClienteNombre, _parteHoraClienteCodigo)</strong>
            </div>
        </div>

        @if (_parteHoraTickets.Count > 1)
        {
            <div class="conversations-hours-hint">
                <i class="bi bi-info-circle"></i>
                <span>Hay varios tickets del cliente. Elegí el correcto antes de guardar.</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_parteHoraError))
        {
            <div class="conversations-error conversations-notice">@_parteHoraError</div>
        }

        <div class="conversations-hours-form">
            <label class="field conversations-hours-ticket-field">
                <span>Ticket</span>
                <select value="@(_parteHoraTicketId?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                        @onchange="OnParteHoraTicketChangedAsync"
                        disabled="@(_savingParteHora || _parteHoraTickets.Count == 0)">
                    <option value="">Seleccionar ticket</option>
                    @foreach (var ticket in _parteHoraTickets)
                    {
                        <option value="@ticket.IdTicket">@FormatParteHoraTicket(ticket)</option>
                    }
                </select>
            </label>

            <label class="conversations-hours-check">
                <input type="checkbox" @bind="_parteHoraFacturable" disabled="@_savingParteHora" />
                <span>Facturable</span>
            </label>

            <div class="conversations-hours-lines">
                <div class="conversations-hours-lines__header">
                    <span>Técnico</span>
                    <span>Tipo</span>
                    <span>Tarea</span>
                    <span>Horas</span>
                    <span>Minutos</span>
                    <span></span>
                </div>
                @for (var i = 0; i < _parteHoraLineas.Count; i++)
                {
                    var index = i;
                    var linea = _parteHoraLineas[index];
                    <div class="conversations-hours-lines__row" @key="linea">
                        <select @bind="linea.IdTecnico" disabled="@_savingParteHora">
                            <option value="">Sin técnico</option>
                            @foreach (var tecnico in _technicians)
                            {
                                <option value="@tecnico.IdTecnico">@tecnico.Nombre</option>
                            }
                        </select>
                        <select @bind="linea.TipoTrabajo" disabled="@_savingParteHora">
                            @foreach (var tipo in ParteHoraTiposConversacion)
                            {
                                <option value="@tipo">@FormatParteHoraTipo(tipo)</option>
                            }
                        </select>
                        <input type="text"
                               id="@GetParteHoraLineaDescripcionId(index)"
                               value="@linea.Descripcion"
                               maxlength="1000"
                               placeholder="Descripción de la tarea"
                               disabled="@_savingParteHora"
                               @oninput="args => linea.Descripcion = Convert.ToString(args.Value) ?? string.Empty"
                               @onkeydown="args => HandleParteHoraLineaKeyDownAsync(args, index)" />
                        <input type="number" min="0" max="24" step="1" @bind="linea.Horas" disabled="@_savingParteHora" />
                        <input type="number" min="0" max="59" step="1" @bind="linea.Minutos" disabled="@_savingParteHora" />
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => RemoveParteHoraLinea(index)" disabled="@(_savingParteHora || _parteHoraLineas.Count <= 1)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
                <div class="actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="AddParteHoraLinea" disabled="@_savingParteHora">
                        <i class="bi bi-plus-circle"></i> Agregar línea
                    </button>
                </div>
            </div>
        </div>

        <div class="conversations-hours-ticket-tools">
            <div class="conversations-hours-ticket-tools__actions">
                <button type="button" class="btn btn--ghost btn--sm" @onclick="PreviewParteHoraTicketAsync" disabled="@(!_parteHoraTicketId.HasValue || _loadingParteHoraTicket || _savingParteHora)">
                    <i class="bi bi-eye"></i> Previsualizar
                </button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="EditParteHoraTicketAsync" disabled="@(!_parteHoraTicketId.HasValue || _loadingParteHoraTicket || _savingParteHora)">
                    <i class="bi bi-pencil-square"></i> Editar
                </button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="StartCreateParteHoraTicket" disabled="@_savingParteHora">
                    <i class="bi bi-plus-lg"></i> Crear
                </button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseParteHoraTicketAsync" disabled="@(!_parteHoraTicketId.HasValue || _loadingParteHoraTicket || _savingParteHora)">
                    <i class="bi bi-trash3"></i> Eliminar
                </button>
            </div>

            @if (_loadingParteHoraTicket)
            {
                <div class="conversations-hours-ticket-card">
                    <span class="context-card__muted">Cargando ticket...</span>
                </div>
            }
            else if (_parteHoraTicketMode == ParteHoraTicketPanelMode.Preview && _parteHoraTicketDetail is not null)
            {
                <article class="conversations-hours-ticket-card">
                    <div>
                        <strong>@FormatParteHoraTicket(_parteHoraTicketDetail)</strong>
                        <span>@_parteHoraTicketDetail.EstadoNombre · @RenderTicketPriority(_parteHoraTicketDetail.Prioridad) · @DisplayOrFallback(_parteHoraTicketDetail.TecnicoNombre, "Sin asignar")</span>
                    </div>
                    <p>@DisplayOrFallback(_parteHoraTicketDetail.Descripcion, "Sin descripción")</p>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenTicket(_parteHoraTicketDetail.IdTicket)">
                        <i class="bi bi-box-arrow-up-right"></i> Abrir
                    </button>
                </article>
            }
            else if (_parteHoraTicketMode is ParteHoraTicketPanelMode.Edit or ParteHoraTicketPanelMode.Create)
            {
                <div class="conversations-hours-ticket-editor">
                    <label class="field">
                        <span>Título</span>
                        <input maxlength="180" @bind="_parteHoraTicketTitle" disabled="@_savingParteHoraTicket" />
                    </label>
                    <label class="field">
                        <span>Estado</span>
                        <select @bind="_parteHoraTicketState" disabled="@_savingParteHoraTicket">
                            @foreach (var estado in ParteHoraTicketOpenStates)
                            {
                                <option value="@estado.CodigoEstado">@estado.Nombre</option>
                            }
                        </select>
                    </label>
                    <label class="field">
                        <span>Prioridad</span>
                        <select @bind="_parteHoraTicketPriority" disabled="@_savingParteHoraTicket">
                            <option value="0">Sin prioridad</option>
                            <option value="1">Baja</option>
                            <option value="2">Media</option>
                            <option value="3">Alta</option>
                        </select>
                    </label>
                    <label class="field conversations-hours-ticket-editor__description">
                        <span>Descripción</span>
                        <textarea rows="3" maxlength="4000" @bind="_parteHoraTicketDescription" disabled="@_savingParteHoraTicket"></textarea>
                    </label>
                    <div class="actions conversations-hours-ticket-editor__actions">
                        <button type="button" class="btn btn--primary btn--sm" @onclick="SaveParteHoraTicketAsync" disabled="@_savingParteHoraTicket">
                            <i class="bi bi-floppy"></i> @(_savingParteHoraTicket ? "Guardando..." : "Guardar ticket")
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="CancelParteHoraTicketPanel" disabled="@_savingParteHoraTicket">
                            Cancelar
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="actions conversations-hours-actions">
            <button type="button" class="btn btn--primary" @onclick="SaveParteHorasAsync" disabled="@_savingParteHora">
                <i class="bi bi-stopwatch"></i> @(_savingParteHora ? "Guardando..." : "Guardar parte")
            </button>
            <button type="button" class="btn btn--ghost" @onclick="ConfirmCloseWithoutParteHorasAsync" disabled="@_savingParteHora">
                No cargar parte
            </button>
        </div>
    </section>
}

@if (_showRelacionarClienteModal)
{
    <div class="conversations-modal-backdrop" @onclick="CloseRelacionarClienteModal"></div>
    <section class="panel-card conversations-modal conversations-link-client-dialog">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Relacionar cliente</h3>
                <p class="panel-card__subtitle">Buscá la empresa y vinculala con esta conversación.</p>
            </div>
            <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseRelacionarClienteModal" disabled="@(_loadingClientCandidates || _linkingClient)">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_linkClientError))
        {
            <div class="conversations-error conversations-notice">@_linkClientError</div>
        }

        <div class="conversations-link-client-search">
            <div class="field">
                <label>Cliente / empresa</label>
                <input type="search"
                       placeholder="Código, razón social, teléfono o email..."
                       @bind="_clientSearchText"
                       @bind:event="oninput"
                       @onkeydown="OnClientSearchKeyDownAsync"
                       disabled="@(_loadingClientCandidates || _linkingClient)" />
            </div>
            <button type="button" class="btn btn--primary" @onclick="SearchClientesParaRelacionarAsync" disabled="@(_loadingClientCandidates || _linkingClient)">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>

        @if (_loadingClientCandidates)
        {
            <div class="conversations-ticket-duplicates conversations-ticket-duplicates--loading">
                <i class="bi bi-search"></i>
                <span>Buscando clientes...</span>
            </div>
        }
        else if (_clientSearchExecuted && _clientCandidates.Count == 0)
        {
            <div class="conversations-empty">No encontramos clientes para ese texto.</div>
        }
        else if (_clientCandidates.Count > 0)
        {
            <div class="conversations-link-client-results">
                @foreach (var client in _clientCandidates)
                {
                    <button type="button" class="conversations-link-client-result" @onclick="() => RelacionarClienteAsync(client)" disabled="@_linkingClient">
                        <span class="conversations-link-client-result__avatar">@GetClientInitial(client)</span>
                        <span class="conversations-link-client-result__body">
                            <strong>@client.RazonSocial</strong>
                            <small>@client.Codigo</small>
                            <span>@FormatClientCandidateSummary(client)</span>
                        </span>
                        <i class="bi bi-link-45deg"></i>
                    </button>
                }
            </div>
        }

        <div class="actions">
            <button type="button" class="btn btn--ghost" @onclick="CloseRelacionarClienteModal" disabled="@(_loadingClientCandidates || _linkingClient)">
                Cerrar
            </button>
        </div>
    </section>
}

