    private async Task<int> RefreshInboxAsync(bool showLoading, bool allowSelectionChange, bool trackNewMessages = false)
    {
        if (showLoading)
        {
            _loadingInbox = true;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
        }

        _loadError = null;
        var newMessagesDetected = 0;

        try
        {
            var previousInbox = _inbox.ToDictionary(x => x.IdConversacion);
            ApplyCurrentUserToFilters(_filters);
            var refreshedInbox = (await ConversacionesSvc.GetInboxAsync(_filters)).ToList();
            if (trackNewMessages)
                newMessagesDetected = TrackInboxNewMessages(previousInbox, refreshedInbox);
            _inbox = refreshedInbox;
            StoreChannelCache(_canalActivo);

            if (_selectedConversationId.HasValue && _inbox.Any(x => x.IdConversacion == _selectedConversationId.Value))
            {
                RefreshSelectedMercadoLibreGroup();
                return newMessagesDetected;
            }

            if (showLoading)
            {
                _loadingInbox = false;
                await InvokeAsync(StateHasChanged);
                await Task.Yield();
            }

            if (allowSelectionChange && InboxDisplayItems.Count > 0 && !ShouldKeepAuditResultsOpen)
                await SelectInboxItemAsync(InboxDisplayItems[0], updateUrl: false, toggleMercadoLibreGroup: false);
            else if (allowSelectionChange)
                ClearSelection();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            if (showLoading)
                _loadingInbox = false;
        }

        return newMessagesDetected;
    }

    private async Task LoadAuditMessagesIfNeededAsync()
