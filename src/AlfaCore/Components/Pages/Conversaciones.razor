    private int TrackInboxNewMessages(
        IReadOnlyDictionary<long, ConversacionInboxItemDto> previousInbox,
        IReadOnlyList<ConversacionInboxItemDto> refreshedInbox)
    {
        if (previousInbox.Count == 0)
            return 0;

        var newMessagesDetected = 0;
        foreach (var item in refreshedInbox)
        {
            if (item.IdConversacion == _selectedConversationId)
                continue;

            if (!previousInbox.TryGetValue(item.IdConversacion, out var previous))
            {
                if (item.IdUltimoMensajeCliente is not null
                    && item.CantidadMensajesCliente > 0
                    && IsFreshInboxClientMessage(item))
                {
                    _newMessagesByConversation[item.IdConversacion] =
                        _newMessagesByConversation.TryGetValue(item.IdConversacion, out var existingCount) ? existingCount + 1 : 1;
                    newMessagesDetected++;
                }

                continue;
            }

            if (item.IdUltimoMensajeCliente is not long currentClientMessageId
                || previous.IdUltimoMensajeCliente is not long previousClientMessageId
                || currentClientMessageId <= previousClientMessageId
                || item.FechaHoraUltimoMensajeCliente is not DateTime currentClientDate
                || previous.FechaHoraUltimoMensajeCliente is not DateTime previousClientDate
                || currentClientDate <= previousClientDate
                || !IsFreshInboxClientMessage(item))
                continue;

            var difference = item.CantidadMensajesCliente > previous.CantidadMensajesCliente
                ? item.CantidadMensajesCliente - previous.CantidadMensajesCliente
                : 1;

            _newMessagesByConversation[item.IdConversacion] =
                _newMessagesByConversation.TryGetValue(item.IdConversacion, out var count) ? count + difference : difference;
            newMessagesDetected += difference;
        }

        return newMessagesDetected;
    }

    private static bool IsFreshInboxClientMessage(ConversacionInboxItemDto item)
        => item.FechaHoraUltimoMensajeCliente is DateTime value
           && DateTime.Now - value <= LateIncomingNotificationWindow
           && value <= DateTime.Now.AddMinutes(2);

    private async Task SelectConversationAsync(long idConversacion, bool showMobileChat = false)
    {
        if (showMobileChat)
            _mobileChatActive = true;

        await ClearTypingAsync();
        _showTemplatePanel = false;
        _showStatusMenu = false;
        CancelTicketSelection();
        await LoadConversationAsync(idConversacion, showLoading: true, clearActionState: true);
    }

    private async Task LoadConversationAsync(long idConversacion, bool showLoading, bool clearActionState)
    {
        var conversationChanged = _selectedConversationId != idConversacion;
        _selectedConversationId = idConversacion;
        var hasWarmCache = _conversationCache.TryGetValue(idConversacion, out var cachedConversation);

        if (hasWarmCache && cachedConversation is not null)
        {
            ApplyConversationCache(idConversacion, cachedConversation, showLoading || clearActionState || conversationChanged);
            showLoading = false;
        }

        if (showLoading)
            _loadingConversation = true;

        _conversationError = null;
        if (clearActionState)
        {
            _actionMessage = null;
            _actionError = null;
        }

        try
        {
            var conversationTask = ConversacionesSvc.GetConversationAsync(idConversacion);
            var messagesTask = ConversacionesSvc.GetMessagesAsync(idConversacion);
            var attachmentsTask = ConversacionesSvc.GetConversationAttachmentsAsync(idConversacion);
            var typingTask = ConversacionesSvc.GetTypingAsync(idConversacion, _typingClientId);

            await Task.WhenAll(conversationTask, messagesTask, attachmentsTask, typingTask);

            _selectedConversation = await conversationTask;
            _messages = (await messagesTask).ToList();
            _typingUsers = (await typingTask).ToList();
            var adjuntos = await attachmentsTask;
            _adjuntosPorMensaje = adjuntos
                .GroupBy(a => a.IdMensaje)
                .ToDictionary(g => g.Key, g => g.ToList());
            StoreConversationCache(idConversacion);
            _assignmentTechnicianId = _selectedConversation?.IdTecnico ?? string.Empty;
            _statusCode = _selectedConversation?.CodigoEstado ?? (_states.FirstOrDefault()?.CodigoEstado ?? "ABIERTA");

            if (showLoading || clearActionState || conversationChanged)
            {
                ClearNewMessageState();
                _showReturnToLatest = false;
                _scrollThreadToBottomAfterRender = true;
                _focusReplyAfterRender = true;
                _scrollHandlerConversationId = null;
                RestoreSelectedNewMessageMarker(idConversacion);
                MarkSelectedConversationAsRead();
            }

            if (IsWhatsAppConversation)
            {
                if (conversationChanged)
                    _templateValuesText = string.Empty;
            }
            else
            {
                ClearTemplateSelection();
            }

            await LoadContextTicketsAsync();
        }
        catch (Exception ex)
        {
            _conversationError = ex.Message;
            _selectedConversation = null;
            _messages = [];
            _typingUsers = [];
        }
        finally
        {
            if (showLoading)
                _loadingConversation = false;
        }
    }

    private void StartTicketSelection()
    {
        if (_selectedConversation is null || _messages.Count == 0)
            return;

        _ticketSelectionMode = true;
        _showTicketDialog = false;
        _ticketError = null;
        _selectedTicketMessageIds.Clear();
        _ticketTitle = BuildDefaultTicketTitle();
        _ticketDescription = string.Empty;
        _ticketPriority = 2;
        _allowCreateDespiteRelated = false;
        _relatedTicketMatches.Clear();
    }

    private void ToggleTicketMessageSelection(long idMensaje, ChangeEventArgs args)
    {
        var selected = args.Value is bool flag && flag;
        if (selected)
            _selectedTicketMessageIds.Add(idMensaje);
        else
            _selectedTicketMessageIds.Remove(idMensaje);

        _allowCreateDespiteRelated = false;
        _relatedTicketMatches.Clear();
    }

