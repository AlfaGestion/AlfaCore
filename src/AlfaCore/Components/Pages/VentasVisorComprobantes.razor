@page "/ventas/carga-comprobantes/visor"
@page "/{idweb}/{idbase:int}/ventas/carga-comprobantes/visor"
@using AlfaCore.Services
@inject IDocumentPdfService Pdf
@inject ICargaComprobantesService Service
@inject ISessionService Sessions
@inject IAppUserSessionService Users
@inject IPageHeaderService PageHeader
@inject IAppUiOperationService UiOps
@inject IJSRuntime Js
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Ver comprobantes | Alfa Gestión</PageTitle>

@* Visor de comprobantes de ventas: buscar, ver el detalle (aplicaciones, historial, asientos) y reimprimir. *@
<div class="gd-page gd vc-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />


    @if (_resultado is { } r)
    {
        <div class="kpi-grid vc-kpis">
            <KpiCard Titulo="Comprobantes" Valor="@r.Total.ToString("N0")" Icono="@Icono("bi-files")"
                     Descripcion="@($"{(_filtroAplicado.FechaDesde ?? DateTime.Today.AddDays(-30)):dd/MM/yyyy} al {(_filtroAplicado.FechaHasta ?? DateTime.Today):dd/MM/yyyy}")" />
            <KpiCard Titulo="Importe (sin anulados)" Valor="@Moneda(r.ImporteTotal)" Icono="@Icono("bi-cash-stack")"
                     Descripcion="@(string.IsNullOrEmpty(_filtroAplicado.Tc) ? "Todos los tipos: incluye pedidos y remitos" : $"Solo {_filtroAplicado.Tc}")" />
            <KpiCard Titulo="En esta página" Valor="@r.Items.Count.ToString("N0")" Icono="@Icono("bi-list-ul")"
                     Descripcion="@($"Página {r.PageNumber} de {r.TotalPages}")" />
        </div>

        @if (r.Items.Count == 0)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin comprobantes" Message="No hay comprobantes para esos filtros. Probá con otro período o tipo." />
        }
        else
        {
            <section class="vc-tabla" aria-label="Comprobantes">
                <div class="vc-tabla__scroll">
                    <table class="vc-table">
                        <thead><tr>
                            <th class="vc-sel"><input type="checkbox" aria-label="Seleccionar los de esta página" title="Seleccionar los de esta página"
                                checked="@(r.Items.Any(x => !x.Anulada) && r.Items.Where(x => !x.Anulada).All(x => _seleccion.ContainsKey(x.Id)))"
                                @onchange="e => SeleccionarPagina(e.Value is true)" /></th>
                            @Th("fecha", "Fecha") @Th("tipo", "Tipo") @Th("numero", "Número") @Th("cliente", "Cliente") @Th("importe", "Importe", true)
                            <th>CAE</th> @Th("unidad", "U. negocio") @Th("usuario", "Usuario") <th>Mail</th><th>Acciones</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var c in r.Items)
                        {
                            <tr @key="c.Id" class="@(c.Anulada ? "is-anulada" : _seleccion.ContainsKey(c.Id) ? "is-seleccionada" : null)" @ondblclick="() => Ver(c)">
                                <td class="vc-sel" @ondblclick:stopPropagation>
                                    <input type="checkbox" aria-label="@($"Seleccionar {c.Tc} {c.Numero}")" disabled="@c.Anulada"
                                           checked="@_seleccion.ContainsKey(c.Id)" @onchange="e => Seleccionar(c, e.Value is true)" />
                                </td>
                                <td>@c.Fecha?.ToString("dd/MM/yyyy")</td>
                                <td><strong>@c.Tc</strong><small>@c.TcDescripcion</small></td>
                                <td>@c.Numero @if (c.Anulada) { <span class="vc-anulada">ANULADA</span> }</td>
                                <td>@c.Cliente<small>@c.Cuenta</small></td>
                                <td class="vc-num">@Moneda(c.Importe)</td>
                                <td>@c.Cae</td>
                                <td>@c.UnidadNegocio</td>
                                <td>@c.Usuario</td>
                                <td class="vc-mail">
                                    @if (_mailsEnCurso.Contains(ClaveMail(c.Tc, c.IdComprobante)))
                                    {
                                        <small class="vc-mail__enviando"><span class="vc-spinner" aria-hidden="true"></span> Enviando…</small>
                                    }
                                    else if (_mailsEnCola.Contains(ClaveMail(c.Tc, c.IdComprobante)))
                                    {
                                        <small class="vc-mail__cola"><i class="bi bi-hourglass-split" aria-hidden="true"></i> En cola</small>
                                    }
                                    else if (_mailsError.TryGetValue(ClaveMail(c.Tc, c.IdComprobante), out var errMail))
                                    {
                                        <small class="vc-mail__error" title="@errMail"><i class="bi bi-envelope-exclamation" aria-hidden="true"></i> @errMail</small>
                                    }
                                    else if (c.UltimoMail is { Length: > 0 } um) { <small title="Último envío">@um</small> }
                                </td>
                                <td class="vc-acciones">
                                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-eye" OnClick="_ => Ver(c)">Ver</AlfaButton>
                                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-printer" Disabled="@(_pdfId is not null)"
                                                Loading="@(_pdfId == c.Id)" OnClick="_ => ReimprimirAsync(c)">Reimprimir</AlfaButton>
                                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-envelope" Disabled="@(c.Anulada || _mailCargandoId is not null || _mailsEnCurso.Contains(ClaveMail(c.Tc, c.IdComprobante)) || _mailsEnCola.Contains(ClaveMail(c.Tc, c.IdComprobante)))"
                                                Loading="@(_mailCargandoId == c.Id)" OnClick="_ => AbrirMailAsync(c)">Mail</AlfaButton>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <footer class="vc-tabla__pie">Doble clic o «Ver» abre el detalle: artículos, otros conceptos, comprobantes aplicados, asientos e historial.</footer>
            </section>
        }
    }
    else if (_busy)
    {
        <AlfaEmptyState Title="Buscando comprobantes" Message="Consultando la base activa." />
    }
</div>

<AlfaDialog Open="@(_mail is not null)" Title="Enviar comprobante por mail" Size="AlfaDialogSize.Lg"
            Description="@(_mail is null ? null : $"{_mail.Tc} {_mail.IdComprobante} · {_mail.Cliente} · va adjunto en PDF")"
            ErrorMessage="@_mailError" CloseOnBackdrop="false" OnClose="CerrarMail">
    <ChildContent>
    @if (_mail is not null)
    {
        <div class="vc-mail-form">
            @if (!string.IsNullOrWhiteSpace(_mail.MailPrueba))
            {
                <p class="vc-mail-form__prueba">Modo prueba: el mail va a @_mail.MailPrueba, no al cliente (Configuración General → Ventas → Mail de facturación).</p>
            }
            <AlfaInput Label="Para" Value="@_mail.Para" ValueChanged="v => _mail.Para = v ?? string.Empty"
                       HelpText="Separá varios mails con «;». Se completa con los mails del cliente." />
            <AlfaInput Label="Asunto" MaxLength="250" Value="@_mail.Asunto" ValueChanged="v => _mail.Asunto = v ?? string.Empty" />
            <label class="vc-mail-form__label" for="vc-mail-mensaje">Mensaje</label>
            <textarea id="vc-mail-mensaje" class="vc-mail-form__mensaje" rows="9" @bind="_mail.Mensaje" @bind:event="oninput"></textarea>
            @if (_mail.UltimoEnvio is { Length: > 0 } ultimo)
            {
                <small class="vc-mail-form__ultimo">Último envío: @ultimo</small>
            }
        </div>
    }
    </ChildContent>
    <Footer>
        <small class="vc-mail-form__nota">Se envía en segundo plano: podés seguir trabajando.</small>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => CerrarMail()">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-send" OnClick="_ => EnviarMail()">Enviar</AlfaButton>
    </Footer>
</AlfaDialog>

@if (_confirmarLote)
{
    <AlfaConfirmDialog Open="true" Title="Enviar por mail"
        Message="@($"Se envían {_seleccion.Count} comprobante(s), cada uno a los mails de su cliente, con el asunto y el mensaje de Configuración General → Ventas → Mail de facturación.")"
        SecondaryMessage="Salen de a uno en segundo plano: podés seguir trabajando. Los clientes sin mail válido quedan marcados en la columna Mail."
        ConfirmLabel="Enviar" OnConfirm="EnviarLote" OnCancel="() => _confirmarLote = false" />
}

<ComprobanteViewerModal Visible="@(_viendo is not null)" Tc="@(_viendo?.Tc ?? string.Empty)" IdComprobante="@(_viendo?.IdComprobante ?? string.Empty)"
                        IdComplemento="@(_viendo?.IdComplemento ?? 0)" Cliente="@_viendo?.Cliente" Cerrado="() => _viendo = null" />

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly ComprobantesVisorFiltro _filtro = new();
    private ComprobantesVisorFiltro _filtroAplicado = new();
    private ComprobantesVisorResultado? _resultado;
    private ComprobantesVisorFila? _viendo;
    private int? _pdfId;
    private AppUiMessage? _feedback;
    private PageHeaderConfig? _header;
    private bool _busy;
    private bool _exportando;
    private CancellationTokenSource? _exportacionCts;
    private bool _disposed;
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private IReadOnlyList<AlfaSelectOption> TipoOptions => [new("", "Todos"),
        .. (_resultado?.Tipos ?? []).Select(x => new AlfaSelectOption(x.Codigo, x.Descripcion.Length == 0 ? x.Codigo : $"{x.Codigo} · {x.Descripcion}"))];

    protected override void OnInitialized()
    {
        // Por defecto los últimos 7 días: sirve para ver o reimprimir lo que se acaba de emitir.
        _filtro.FechaHasta = DateTime.Today;
        _filtro.FechaDesde = DateTime.Today.AddDays(-6);
        Sessions.SessionChanged += ContextChanged;
        Users.StateChanged += ContextChanged;
        UpdateHeader();
    }

    // Los últimos filtros se leen del navegador después del primer render (sin JS en el prerender).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        UpdateHeader();
        if (await FiltrosRecordados.LeerAsync<FiltrosGuardados>(Js, Sessions, Pantalla) is { } g)
        {
            _filtro.Tc = g.Tc ?? string.Empty; _filtro.IncluirAnulados = g.IncluirAnulados;
            _filtro.Orden = g.Orden ?? string.Empty; _filtro.Descendente = g.Descendente;
            if (g.Guardado.Date == DateTime.Today)
            {
                // Mismo día: se retoma exactamente donde quedó.
                _filtro.FechaDesde = g.Desde; _filtro.FechaHasta = g.Hasta; _filtro.Busqueda = g.Busqueda ?? string.Empty;
            }
            else if (g.Desde is { } d && g.Hasta is { } h && h >= d)
            {
                // Otro día: mismo largo de período, terminando hoy.
                _filtro.FechaHasta = DateTime.Today; _filtro.FechaDesde = DateTime.Today.AddDays(-(h - d).Days);
            }
        }
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("tc", out var tc)) _filtro.Tc = tc.ToString();
        if (query.TryGetValue("buscar", out var buscar)) _filtro.Busqueda = buscar.ToString();
        await BuscarAsync(true);
    }

    private const string Pantalla = "ventas-ver-comprobantes";
    private sealed class FiltrosGuardados
    {
        public string? Tc { get; set; }
        public string? Busqueda { get; set; }
        public DateTime? Desde { get; set; }
        public DateTime? Hasta { get; set; }
        public bool IncluirAnulados { get; set; }
        public string? Orden { get; set; }
        public bool Descendente { get; set; } = true;
        public DateTime Guardado { get; set; }
    }

    private async Task BuscarAsync(bool reset)
    {
        if (_busy || _disposed) return;
        var consulta = reset ? new ComprobantesVisorFiltro
        {
            Tc = _filtro.Tc, Busqueda = _filtro.Busqueda, FechaDesde = _filtro.FechaDesde, FechaHasta = _filtro.FechaHasta,
            UnidadNegocio = _filtro.UnidadNegocio, IncluirAnulados = _filtro.IncluirAnulados, PageSize = _filtro.PageSize, PageNumber = 1,
            Orden = _filtro.Orden, Descendente = _filtro.Descendente
        } : _filtroAplicado;
        _busy = true; _feedback = null; UpdateHeader();
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await UiOps.RunAsync(() => Service.BuscarComprobantesAsync(consulta, _lifetime.Token), "Ver comprobantes", _lifetime.Token);
            if (_disposed) return;
            if (result.Success)
            {
                _resultado = result.Value; _filtroAplicado = consulta; _filtrosAbiertos = false;
                await FiltrosRecordados.GuardarAsync(Js, Sessions, Pantalla, new FiltrosGuardados
                {
                    Tc = consulta.Tc, Busqueda = consulta.Busqueda, Desde = consulta.FechaDesde, Hasta = consulta.FechaHasta,
                    IncluirAnulados = consulta.IncluirAnulados, Orden = consulta.Orden, Descendente = consulta.Descendente, Guardado = DateTime.Now
                });
            }
            else _feedback = result.Feedback;
        }
        finally
        {
            _busy = false;
            if (!_disposed) { UpdateHeader(); await InvokeAsync(StateHasChanged); }
        }
    }

    private async Task ExportarListadoAsync(bool pdf)
    {
        if (_busy || _exportando || _resultado is null) return;
        _exportando = true;
        using var exportacion = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _exportacionCts = exportacion;
        var exportToken = exportacion.Token;
        UpdateHeader();
        var filtro = new ComprobantesVisorFiltro
        {
            Tc = _filtroAplicado.Tc, Busqueda = _filtroAplicado.Busqueda,
            FechaDesde = _filtroAplicado.FechaDesde, FechaHasta = _filtroAplicado.FechaHasta,
            UnidadNegocio = _filtroAplicado.UnidadNegocio, IncluirAnulados = _filtroAplicado.IncluirAnulados,
            Orden = _filtroAplicado.Orden, Descendente = _filtroAplicado.Descendente, PageSize = 200, PageNumber = 1
        };
        try
        {
            var resultado = await UiOps.RunAsync(async () =>
            {
                var filas = new List<ComprobantesVisorFila>();
                while (true)
                {
                    var pagina = await Service.BuscarComprobantesAsync(filtro, exportToken);
                    exportToken.ThrowIfCancellationRequested();
                    filas.AddRange(pagina.Items);
                    if (pagina.PageNumber >= pagina.TotalPages || pagina.Items.Count == 0) break;
                    filtro.PageNumber++;
                }
                var bytes = pdf
                    ? await Pdf.GenerateAsync(ComprobantesVisorExportador.Html(filas, filtro), ct: exportToken)
                    : ComprobantesVisorExportador.Excel(filas);
                exportToken.ThrowIfCancellationRequested();
                await Js.InvokeVoidAsync(pdf ? "alfaCoreInterfacesUpload.openBlob" : "alfaCoreInterfacesUpload.downloadBlob",
                    Convert.ToBase64String(bytes), pdf ? "application/pdf" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", pdf ? "Comprobantes.pdf" : "Comprobantes.xlsx");
            }, "Exportar listado de comprobantes", exportToken);
            if (!resultado.Success) _feedback = resultado.Feedback;
        }
        finally { _exportacionCts = null; _exportando = false; if (!_disposed) { UpdateHeader(); await InvokeAsync(StateHasChanged); } }
    }

    // Filtra mientras se escribe (cliente, cuenta o número), sin esperar Enter.
    private readonly BusquedaDiferida _busquedaDiferida = new();
    private Task EscribirBusquedaAsync(string texto)
    {
        _filtro.Busqueda = texto;
        return _busquedaDiferida.ProgramarAsync(() => InvokeAsync(() => BuscarAsync(true)), () => _busy);
    }

    private Task PaginarAsync(int delta)
    {
        _filtroAplicado.PageNumber = Math.Max(1, (_resultado?.PageNumber ?? 1) + delta);
        return BuscarAsync(false);
    }

    private void Ver(ComprobantesVisorFila c) => _viendo = c;

    // ── Enviar por mail: asunto y mensaje de la configuración, editables antes de enviar ──
    private ComprobanteMailBorrador? _mail;
    private int? _mailCargandoId;
    private string? _mailError;

    private async Task AbrirMailAsync(ComprobantesVisorFila c)
    {
        if (_mailCargandoId is not null) return;
        _mailCargandoId = c.Id; _feedback = null; _mailError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await UiOps.RunAsync(() => Service.PrepararMailComprobanteAsync(c.Tc, c.IdComprobante, _lifetime.Token), "Enviar por mail", _lifetime.Token);
            if (result.Success) _mail = result.Value; else _feedback = result.Feedback;
        }
        finally
        {
            _mailCargandoId = null;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private void CerrarMail() { _mail = null; _mailError = null; }

    // El servidor de correo tarda varios segundos (sobre todo en validar la cuenta): el diálogo se cierra
    // enseguida y el mail sale en segundo plano; la fila muestra «Enviando…». Si falla, se reabre con el motivo.
    private readonly HashSet<string> _mailsEnCurso = new(StringComparer.OrdinalIgnoreCase);
    private static string ClaveMail(string tc, string id) => $"{tc.Trim()}|{id.Trim()}";

    private void EnviarMail()
    {
        if (_mail is not { } mail) return;
        _mail = null; _mailError = null;
        _mailsEnCurso.Add(ClaveMail(mail.Tc, mail.IdComprobante));
        _ = EnviarEnSegundoPlanoAsync(mail);
    }

    private async Task EnviarEnSegundoPlanoAsync(ComprobanteMailBorrador mail)
    {
        string? error = null; string? ok = null;
        try
        {
            var result = await UiOps.RunAsync(() => Service.EnviarMailComprobanteAsync(mail.Tc, mail.IdComprobante, mail.Para, mail.Asunto, mail.Mensaje, _lifetime.Token),
                "Enviar por mail", _lifetime.Token);
            if (!result.Success) error = result.Feedback?.Message ?? "No se pudo enviar el mail.";
            else if (result.Value is { Enviado: false } fallo) error = fallo.Mensaje;
            else ok = result.Value?.Mensaje ?? $"Se envió {mail.Tc} {mail.IdComprobante}.";
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { error = ex.Message; }
        finally { _mailsEnCurso.Remove(ClaveMail(mail.Tc, mail.IdComprobante)); }
        if (_disposed) return;
        await InvokeAsync(async () =>
        {
            if (error is not null)
            {
                _feedback = AppUiMessage.Error("No se envió el mail", $"{mail.Tc} {mail.IdComprobante}: {error}");
                if (_mail is null) { _mail = mail; _mailError = error; }
                StateHasChanged();
                return;
            }
            _feedback = AppUiMessage.Success("Mail enviado", $"{mail.Tc} {mail.IdComprobante} · {ok}");
            await BuscarAsync(false);
        });
    }

    private async Task ReimprimirAsync(ComprobantesVisorFila c)
    {
        if (_pdfId is not null) return;
        _pdfId = c.Id; _feedback = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await UiOps.RunAsync(() => Service.GetPdfComprobanteAsync(c.Tc, c.IdComprobante, _lifetime.Token), "Reimprimir", _lifetime.Token);
            if (result.Success && result.Value is { Length: > 0 } bytes)
                await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.openBlob", Convert.ToBase64String(bytes), "application/pdf", $"{c.Tc}-{c.IdComprobante}.pdf");
            else
                _feedback = result.Feedback;
        }
        finally
        {
            _pdfId = null;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    // ── Búsqueda en una línea con filtros desplegables (mismo estilo que Carga de comprobantes) ──
    private bool _filtrosAbiertos;
    private void AlternarFiltros() { _filtrosAbiertos = !_filtrosAbiertos; UpdateHeader(); }
    private void CerrarFiltros() { _filtrosAbiertos = false; UpdateHeader(); }
    private void Cambiar(Action cambio) { cambio(); UpdateHeader(); }
    private Task TeclaAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter") return BuscarAsync(true);
        if (args.Key == "Escape") CerrarFiltros();
        return Task.CompletedTask;
    }

    private List<(string Key, string Label)> FiltrosActivos()
    {
        var f = _filtroAplicado;
        var chips = new List<(string, string)>
        {
            ("fechas", $"{f.FechaDesde?.ToString("dd/MM/yyyy") ?? "Inicio"} – {f.FechaHasta?.ToString("dd/MM/yyyy") ?? "Hoy"}")
        };
        if (f.Tc.Length > 0) chips.Insert(0, ("tipo", TipoOptions.FirstOrDefault(o => o.Value == f.Tc)?.Label ?? f.Tc));
        if (f.IncluirAnulados) chips.Add(("anulados", "Con anulados"));
        return chips;
    }

    private Task QuitarFiltroAsync(string key)
    {
        if (key == "fechas") { if (!_filtrosAbiertos) AlternarFiltros(); return Task.CompletedTask; }
        _filtro.Tc = _filtroAplicado.Tc; _filtro.Busqueda = _filtroAplicado.Busqueda; _filtro.IncluirAnulados = _filtroAplicado.IncluirAnulados;
        _filtro.FechaDesde = _filtroAplicado.FechaDesde; _filtro.FechaHasta = _filtroAplicado.FechaHasta;
        if (key == "tipo") _filtro.Tc = string.Empty;
        if (key == "anulados") _filtro.IncluirAnulados = false;
        return BuscarAsync(true);
    }

    // ── Orden por columna (en la base: ordena todos los resultados, no solo la página) ──
    private RenderFragment Th(string columna, string titulo, bool derecha = false) => @<th class="@(derecha ? "vc-num" : null)"
        aria-sort="@(OrdenActual == columna ? (_filtroAplicado.Descendente ? "descending" : "ascending") : "none")">
        <button type="button" class="vc-sort @(OrdenActual == columna ? "is-sorted" : null)" title="@($"Ordenar por {titulo}")" disabled="@_busy" @onclick="() => OrdenarAsync(columna)">
            @titulo
            @if (OrdenActual == columna) { <i class="bi @(_filtroAplicado.Descendente ? "bi-caret-down-fill" : "bi-caret-up-fill")" aria-hidden="true"></i> }
        </button>
    </th>;
    private string OrdenActual => _filtroAplicado.Orden.Length == 0 ? "fecha" : _filtroAplicado.Orden;
    private Task OrdenarAsync(string columna)
    {
        // Mismo criterio que en otras listas: primer clic ascendente (fecha e importe arrancan de mayor a menor).
        var desc = OrdenActual == columna ? !_filtroAplicado.Descendente : columna is "fecha" or "importe";
        _filtro.Orden = _filtroAplicado.Orden = columna; _filtro.Descendente = _filtroAplicado.Descendente = desc;
        _filtroAplicado.PageNumber = 1;
        return BuscarAsync(false);
    }

    // ── Selección y envío por mail de varios comprobantes ──
    private readonly Dictionary<int, ComprobantesVisorFila> _seleccion = [];
    private bool _confirmarLote;
    private readonly HashSet<string> _mailsEnCola = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _mailsError = new(StringComparer.OrdinalIgnoreCase);
    private bool _loteEnCurso;

    private void Seleccionar(ComprobantesVisorFila c, bool valor)
    {
        if (valor && !c.Anulada) _seleccion[c.Id] = c; else _seleccion.Remove(c.Id);
        UpdateHeader();
    }

    private void SeleccionarPagina(bool valor)
    {
        foreach (var c in (_resultado?.Items ?? []).Where(x => !x.Anulada))
            if (valor) _seleccion[c.Id] = c; else _seleccion.Remove(c.Id);
        UpdateHeader();
    }

    private void EnviarLote()
    {
        _confirmarLote = false;
        var lista = _seleccion.Values.OrderBy(x => x.Fecha).ThenBy(x => x.Id).ToList();
        _seleccion.Clear();
        foreach (var c in lista) { var k = ClaveMail(c.Tc, c.IdComprobante); _mailsEnCola.Add(k); _mailsError.Remove(k); }
        UpdateHeader();
        _ = EnviarLoteAsync(lista);
    }

    private async Task EnviarLoteAsync(IReadOnlyList<ComprobantesVisorFila> lista)
    {
        _loteEnCurso = true;
        int ok = 0, fallidos = 0;
        foreach (var c in lista)
        {
            if (_disposed) return;
            var k = ClaveMail(c.Tc, c.IdComprobante);
            _mailsEnCola.Remove(k); _mailsEnCurso.Add(k);
            await InvokeAsync(StateHasChanged);
            try
            {
                // Sin «Para»/asunto/mensaje: los mails del cliente y los textos de la configuración.
                var r = await Service.EnviarMailComprobanteAsync(c.Tc, c.IdComprobante, ct: _lifetime.Token);
                if (r.Enviado) ok++; else { fallidos++; _mailsError[k] = r.Mensaje; }
            }
            catch (OperationCanceledException) { return; }
            catch (Exception ex) { fallidos++; _mailsError[k] = ex is AppUserFacingException u ? u.UserMessage : ex.Message; }
            finally { _mailsEnCurso.Remove(k); }
        }
        _loteEnCurso = false;
        if (_disposed) return;
        await InvokeAsync(async () =>
        {
            _feedback = fallidos == 0
                ? AppUiMessage.Success("Mails enviados", $"Se enviaron {ok} comprobante(s) por mail.")
                : AppUiMessage.Warning("Mails con problemas", $"{ok} enviado(s) y {fallidos} sin enviar: el motivo figura en la columna Mail. Podés corregir el mail del cliente y reenviar con el botón Mail.");
            await BuscarAsync(false);
        });
    }

    private RenderFragment RenderBusqueda() => @<div class="smart-search" @onclick:stopPropagation>
        @{ var chips = FiltrosActivos(); var hoy = DateTime.Today; var mes = new DateTime(hoy.Year, hoy.Month, 1); }
        <div class="smart-search__bar @(_filtrosAbiertos ? "is-open" : string.Empty)">
            <span class="smart-search__search-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
            <button type="button" class="smart-search__filter-button @(_filtrosAbiertos || chips.Count > 1 ? "is-active" : string.Empty)"
                aria-label="Abrir filtros" title="Abrir filtros" aria-expanded="@_filtrosAbiertos" disabled="@_busy" @onclick="AlternarFiltros">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
            </button>
            <div class="smart-search__active-filters" aria-label="Filtros activos">
                @foreach (var chip in chips.Take(2))
                {
                    <button type="button" class="smart-search__active-filter" disabled="@_busy" title="@chip.Label"
                        aria-label="@(chip.Key == "fechas" ? "Cambiar período" : $"Quitar filtro {chip.Label}")" @onclick="() => QuitarFiltroAsync(chip.Key)">
                        <span>@chip.Label</span>
                        @if (chip.Key != "fechas") { <span class="smart-search__active-filter-remove" aria-hidden="true"><i class="bi bi-x"></i></span> }
                    </button>
                }
                @if (chips.Count > 2) { <span class="smart-search__more-filters" title="@string.Join(", ", chips.Skip(2).Select(x => x.Label))">+@(chips.Count - 2)</span> }
            </div>
            <input type="search" aria-label="Buscar cliente, cuenta o número" placeholder="Cliente, cuenta o número (ej. 0010-00000519)..."
                maxlength="100" value="@_filtro.Busqueda" @oninput="e => EscribirBusquedaAsync(e.Value?.ToString() ?? string.Empty)"
                @onkeydown="TeclaAsync" />
            <button type="button" class="smart-search__toggle" aria-label="Mostrar filtros" aria-expanded="@_filtrosAbiertos"
                disabled="@_busy" @onclick="AlternarFiltros"><i class="bi @(_filtrosAbiertos ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i></button>
        </div>
        @if (_filtrosAbiertos)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CerrarFiltros"></button>
            <div class="smart-search__panel smart-search__panel--dos" @onclick:stopPropagation @onkeydown="TeclaAsync" @onkeydown:stopPropagation>
                <FiltroPeriodo Desde="@_filtro.FechaDesde" Hasta="@_filtro.FechaHasta" Disabled="@_busy"
                               PeriodoChanged="p => Cambiar(() => (_filtro.FechaDesde, _filtro.FechaHasta) = p)" RangoElegido="_ => BuscarAsync(true)" />
                <div class="smart-search__column">
                    <h4><i class="bi bi-file-earmark-text"></i> Comprobante</h4>
                    <AlfaSelect Label="Tipo" Value="@_filtro.Tc" ValueChanged="v => Cambiar(() => _filtro.Tc = v ?? string.Empty)" Options="@TipoOptions" Disabled="@_busy" />
                    <AlfaCheckbox Value="@_filtro.IncluirAnulados" ValueChanged="v => Cambiar(() => _filtro.IncluirAnulados = v == true)" Disabled="@_busy">Incluir anulados</AlfaCheckbox>
                    <span class="smart-search__hint">En la barra buscás por cliente (nombre o cuenta) o por número de comprobante.</span>
                </div>
                <div class="smart-search__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-search" Disabled="@_busy" OnClick="_ => BuscarAsync(true)">Aplicar</AlfaButton>
                </div>
            </div>
        }
    </div>;

    private string RutaCarga() => Navigation.Uri.Split('?')[0].TrimEnd('/') is var actual && actual.EndsWith("/visor", StringComparison.OrdinalIgnoreCase)
        ? actual[..^"/visor".Length] : actual;

    private void UpdateHeader() => PageHeader.Set(_header = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot, ModuleKey = "ventas", Title = "Ver comprobantes",
        ShowHistoryNavigation = false,
        Breadcrumb = ["Ventas", "Carga de Comprobantes", "Ver comprobantes"],
        TopNavigationItems =
        [
            new() { Key = "carga", Label = "Carga de Comprobantes", OnClick = () => { Navigation.NavigateTo(RutaCarga() + new Uri(Navigation.Uri).Query); return Task.CompletedTask; } },
            new() { Key = "visor", Label = "Ver comprobantes", Active = true }
        ],
        State = _busy ? PageHeaderState.Loading : PageHeaderState.List,
        Search = new(),
        SearchContent = RenderBusqueda(),
        Actions =
        [
            .. (_seleccion.Count > 0
                ? new PageHeaderAction[]
                {
                    new() { Key = "mail-lote", Label = $"Enviar por mail ({_seleccion.Count})", Icon = "bi-envelope", Style = PageHeaderActionStyle.Primary,
                        Priority = PageHeaderActionPriority.Essential, Disabled = _loteEnCurso, Title = _loteEnCurso ? "Esperá a que termine el envío en curso" : string.Empty,
                        OnClick = () => { _confirmarLote = true; return InvokeAsync(StateHasChanged); } },
                    new() { Key = "limpiar-seleccion", Label = "Quitar selección", Icon = "bi-x-lg", Style = PageHeaderActionStyle.Ghost,
                        OnClick = () => { _seleccion.Clear(); UpdateHeader(); return InvokeAsync(StateHasChanged); } }
                }
                : []),
            new() { Key = "excel", Label = "Excel", Icon = "bi-file-earmark-excel", Style = PageHeaderActionStyle.Ghost, Disabled = _busy || _exportando || _resultado is null, OnClick = () => ExportarListadoAsync(false) },
            new() { Key = "pdf-listado", Label = "PDF", Icon = "bi-printer", Style = PageHeaderActionStyle.Ghost, Disabled = _busy || _exportando || _resultado is null, OnClick = () => ExportarListadoAsync(true) },
            new() { Key = "buscar", Label = "Actualizar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Disabled = _busy, OnClick = () => BuscarAsync(false) }
        ],
        Pagination = _resultado is { Total: > 0 } r ? new()
        {
            PageLabel = $"{r.PageNumber} / {r.TotalPages}", Label = $"{r.Total} comprobantes",
            HasPrevious = r.PageNumber > 1, HasNext = r.PageNumber < r.TotalPages, Disabled = _busy,
            OnPrevious = () => PaginarAsync(-1), OnNext = () => PaginarAsync(1)
        } : null
    });

    private void ContextChanged()
    {
        _exportacionCts?.Cancel();
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            _resultado = null; _viendo = null;
            await BuscarAsync(true);
        });
    }

    private static string Icono(string bi) => $"<i class=\"bi {bi}\" aria-hidden=\"true\"></i>";
    private static string Moneda(decimal value) => value.ToString("C2", Culture);
    private static string? FechaHtml(DateTime? fecha) => fecha?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    private static DateTime? LeerFecha(string? value) => DateTime.TryParseExact(value, "yyyy-MM-dd",
        System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var fecha) ? fecha : null;

    public void Dispose()
    {
        _disposed = true; _busquedaDiferida.Dispose(); Sessions.SessionChanged -= ContextChanged; Users.StateChanged -= ContextChanged;
        _lifetime.Cancel(); _lifetime.Dispose();
        if (ReferenceEquals(PageHeader.Current, _header)) PageHeader.Clear();
    }
}
