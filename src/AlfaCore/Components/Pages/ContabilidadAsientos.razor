@page "/contabilidad/asientos"
@page "/{idweb}/{idbase:int}/contabilidad/asientos"
@using AlfaCore.Services
@inject IAsientosService Service
@inject IAppUiOperationService UiOps
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Asientos | Alfa Gestión</PageTitle>

@* Registraciones directas al diario (D9550 del legacy, solo asientos). Los asientos de comprobantes se ven pero no se modifican acá. *@
<div class="gd-page gd as-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    @if (_edit is null)
    {
        @if (_lista.Count == 0 && _buscado)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin asientos"
                            Message="@(_f.Origen == "MANUALES" ? "No hay asientos manuales con esos filtros. Cargá uno con «Nuevo asiento» o, en el embudo de filtros, elegí «Todos» para ver también los de comprobantes." : "No hay asientos con esos filtros. Probá con otro período.")" />
        }
        else if (_lista.Count > 0)
        {
            <section class="as-tabla__marco"><div class="as-tabla__scroll">
                <table class="as-tabla">
                    <thead><tr><th>Fecha</th><th>Asiento</th><th>Comprobante</th><th>Detalle</th><th class="n">Importe</th><th>Usuario</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var x in _lista)
                    {
                        <tr class="as-fila" @onclick="() => AbrirAsync(x.Clave)">
                            <td>@x.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="mono">@x.Clave.Texto@(x.TipoReg.Trim().Length > 0 ? $" · {x.TipoReg.Trim()}" : "")</td>
                            <td>@x.Tc @x.Comprobante
                                @if (!x.Manual)
                                {
                                    <ComprobanteVerAccion Tc="@x.Tc" Comprobante="@x.Comprobante" />
                                }
                            </td>
                            <td>@x.Detalle</td>
                            <td class="n">@x.Total.ToString("N2", Culture)</td>
                            <td>@x.Usuario</td>
                            <td><span class="as-chip @(x.Manual ? "is-manual" : "is-cpte")">@Origen(x)</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></section>
            @if (_f.FechaDesde is null)
            {
                <small class="as-nota">@(_lista.Count >= AlfaCore.Services.AsientosService.UltimosAsientos ? $"Últimos {_lista.Count} asientos, del más reciente al más antiguo. Para ver otros, elegí un período o buscá por número." : $"{_lista.Count} asiento(s) encontrados.")</small>
            }
            else if (_lista.Count >= 500) { <small class="as-nota">Se muestran los 500 más recientes: acotá el período o buscá por número.</small> }
        }
    }
    else
    {
        var a = _edit;
        <section class="as-cab">
            <div class="as-cab__titulo">
                <strong>@(a.Clave is { } k ? $"Asiento {k.Texto}" : "Nuevo asiento")</strong>
                @if (a.Clave is not null) { <span class="mono">@a.Comprobante</span> }
                @if (a.Clave is not null && a.Usuario.Length > 0) { <small>Cargado por @a.Usuario@(a.Grabado is { } g ? $" el {g:dd/MM/yyyy HH:mm}" : "")@(a.Modificado is { } m ? $" · modificado el {m:dd/MM/yyyy HH:mm}" : "")</small> }
            </div>
            @if (!Editable)
            {
                <div class="as-solo-lectura"><i class="bi bi-lock" aria-hidden="true"></i>
                    @(a.MotivoSoloLectura.Length > 0 ? a.MotivoSoloLectura : "Tu usuario no tiene permiso para modificar asientos.")</div>
            }
            <div class="as-cab__campos">
                <label>Fecha <input type="date" class="as-input" value="@a.Fecha.ToString("yyyy-MM-dd")" disabled="@(!Editable)" @onchange="CambiarFechaAsiento" /></label>
                @if (a.Clave is null)
                {
                    @if (_cat is { Modelos.Count: > 0 })
                    {
                        <label>Modelo
                            <select class="as-input" value="@(_modelo?.Nombre ?? "")" @onchange="UsarModeloAsync" disabled="@_busy">
                                <option value="">Sin modelo</option>
                                @foreach (var m in _cat.Modelos) { <option value="@m">@m</option> }
                            </select>
                        </label>
                    }
                    <label>Comprobante
                        <select class="as-input" value="@a.Tc" disabled="@(_modelo is { ModificaTc: false })" @onchange="e => a.Tc = e.Value?.ToString() ?? a.Tc">
                            @foreach (var t in _cat?.Talonarios ?? []) { <option value="@t.Codigo">@t.Codigo · @t.Descripcion</option> }
                        </select>
                    </label>
                    @if (_cat is { Unidades.Count: > 1 })
                    {
                        <label>Unidad
                            <select class="as-input" value="@a.Unidad" @onchange="e => a.Unidad = e.Value?.ToString() ?? a.Unidad">
                                @foreach (var u in _cat.Unidades) { <option value="@u.Codigo">@u.Codigo · @u.Descripcion</option> }
                            </select>
                        </label>
                    }
                }
                @if (_cat is { Monedas.Count: > 1 } || a.EnOtraMoneda)
                {
                    <label>Moneda
                        <select class="as-input" value="@(a.EnOtraMoneda ? a.MonedaAsiento.Trim() : "1")" disabled="@(!Editable)" @onchange="CambiarMonedaAsiento">
                            @foreach (var m in _cat?.Monedas ?? []) { <option value="@m.Codigo">@m.Descripcion</option> }
                        </select>
                    </label>
                    @if (a.EnOtraMoneda)
                    {
                        <label>Cotización
                            <input class="as-input as-input--imp" type="number" step="0.0001" min="0" value="@Dec(a.CotizacionAsiento, "0.####")" disabled="@(!Editable)"
                                   @onchange="e => { a.CotizacionAsiento = LeerDec(e); _sucio = true; }" />
                        </label>
                    }
                }
                @if (PideVencimiento || a.Vencimiento is not null)
                {
                    <label>Vencimiento <input type="date" class="as-input" value="@a.Vencimiento?.ToString("yyyy-MM-dd")" disabled="@(!Editable)" @onchange="CambiarVencimiento" /></label>
                }
                <label class="as-cab__detalle">Detalle
                    <input class="as-input" maxlength="199" value="@a.Detalle" disabled="@(!Editable)" @onchange="e => a.Detalle = e.Value?.ToString() ?? string.Empty"
                           placeholder="Concepto del asiento (ej. Amortizaciones octubre 2026)" />
                </label>
            </div>
        </section>

        @if (a.LivaTipo.Length > 0)
        {
            <section class="as-cpte">
                <div>
                    <strong>@(a.LivaTipo.Equals("COMPRAS", StringComparison.OrdinalIgnoreCase) ? "Comprobante de compra" : "Comprobante de venta")</strong>
                    <span>@a.NombreComprobante · CUIT @a.CuitComprobante · total @a.TotalComprobante.ToString("N2", Culture)@(a.Cae.Length > 0 ? $" · CAE {a.Cae}" : "")</span>
                </div>
                @if (_arca is { } c)
                {
                    <div class="as-arca as-arca--@c.Estado.ToLowerInvariant()">
                        <i class="bi @(c.Estado switch { "COINCIDE" => "bi-check-circle", "DIFIERE" => "bi-exclamation-triangle", "NO_INFORMADO" => "bi-x-circle", _ => "bi-info-circle" })" aria-hidden="true"></i>
                        <div>
                            <b>@c.Mensaje</b>
                            @foreach (var o in c.Observaciones) { <small>@o</small> }
                            @if (c.Archivo.Length > 0) { <small>Archivo: @c.Archivo@(c.TotalArca is { } t ? $" · total ARCA {t:N2}" : "")</small> }
                        </div>
                    </div>
                }
            </section>
        }

        <section class="as-tabla__marco"><div class="as-tabla__scroll">
            <table class="as-tabla as-renglones">
                <thead><tr><th class="as-col-n">#</th><th class="as-col-cuenta">Cuenta</th><th>Concepto del renglón</th><th class="n as-col-imp">Debe</th><th class="n as-col-imp">Haber</th><th>Centros de costo</th><th></th></tr></thead>
                <tbody>
                @for (var i = 0; i < a.Renglones.Count; i++)
                {
                    var r = a.Renglones[i]; var n = i + 1;
                    <tr @key="r">
                        <td class="as-col-n">@n</td>
                        @if (Editable && _cat is not null)
                        {
                            <td class="as-col-cuenta">
                                @if (r.CuentaFija) { <span class="mono">@r.Cuenta</span> @r.CuentaNombre }
                                else { <AsientoCuentaLookup Cuenta="@r.Cuenta" CuentaChanged="v => CambiarCuenta(r, v)" Cuentas="_cat.Cuentas" /> }
                            </td>
                            <td><input class="as-input as-input--fila" maxlength="199" value="@r.Detalle" placeholder="(el del asiento)" @onchange="e => r.Detalle = e.Value?.ToString() ?? string.Empty" /></td>
                            <td class="n"><input class="as-input as-input--imp" type="number" step="0.01" min="0" value="@Monto(r.Debe)" disabled="@ImporteCalculado(r)" @onchange="e => Importe(r, e, debe: true)" /></td>
                            <td class="n"><input class="as-input as-input--imp" type="number" step="0.01" min="0" value="@Monto(r.Haber)" disabled="@ImporteCalculado(r)" @onchange="e => Importe(r, e, debe: false)" /></td>
                            <td class="as-col-cc">@Centros(r, editable: true)</td>
                            <td class="as-col-acc">
                                @if (!r.CuentaFija) { <button type="button" class="as-icon" title="Quitar renglón" @onclick="() => Quitar(r)"><i class="bi bi-x-lg" aria-hidden="true"></i></button> }
                            </td>
                        }
                        else
                        {
                            <td class="as-col-cuenta"><span class="mono">@r.Cuenta</span> @r.CuentaNombre</td>
                            <td>@r.Detalle</td>
                            <td class="n">@(r.Debe != 0 ? r.Debe.ToString("N2", Culture) : "")</td>
                            <td class="n">@(r.Haber != 0 ? r.Haber.ToString("N2", Culture) : "")</td>
                            <td class="as-col-cc">@Centros(r, editable: false)</td>
                            <td></td>
                        }
                    </tr>
                    @if (Cuenta(r) is { } cu && ((cu.EnMonedaExtranjera && !a.EnOtraMoneda) || cu.EsCheque || r.Cheque is not null))
                    {
                        <tr class="as-sub" @key="(r, 1)">
                            <td></td>
                            <td colspan="6">@Extras(r, cu, Editable)</td>
                        </tr>
                    }
                }
                </tbody>
                <tfoot>
                    <tr>
                        <td></td>
                        <td colspan="2">
                            @if (Editable && _modelo is not { AgregaCuentas: false })
                            {
                                <button type="button" class="as-link" @onclick="Agregar"><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar renglón</button>
                                @if (Diferencia != 0) { <button type="button" class="as-link" @onclick="Balancear"><i class="bi bi-distribute-vertical" aria-hidden="true"></i> Completar la diferencia en el último renglón</button> }
                            }
                        </td>
                        <td class="n"><b>@a.TotalDebe.ToString("N2", Culture)</b></td>
                        <td class="n"><b>@a.TotalHaber.ToString("N2", Culture)</b></td>
                        <td></td><td></td>
                    </tr>
                    @if (a.EnOtraMoneda)
                    {
                        <tr class="as-sub"><td></td><td colspan="2">Importes en @Moneda(a.MonedaAsiento) · en pesos (× @a.CotizacionAsiento.ToString("0.####", Culture))</td>
                            <td class="n">$ @((a.TotalDebe * a.CotizacionAsiento).ToString("N2", Culture))</td><td class="n">$ @((a.TotalHaber * a.CotizacionAsiento).ToString("N2", Culture))</td><td></td><td></td></tr>
                    }
                    @if (Diferencia != 0)
                    {
                        <tr class="as-dif"><td></td><td colspan="2">No balancea: diferencia</td><td colspan="2" class="n">@Math.Abs(Diferencia).ToString("N2", Culture) @(Diferencia > 0 ? "de más en el debe" : "de más en el haber")</td><td></td><td></td></tr>
                    }
                </tfoot>
            </table>
        </div></section>
    }
</div>

<AlfaDialog Open="@(_centrosDe is not null)" Title="Centros de costo" Size="AlfaDialogSize.Md" ErrorMessage="@_errorCentros" OnClose="() => _centrosDe = null">
    <ChildContent>
    @if (_centrosDe is { } rc)
    {
        <p class="as-dlg-sub"><span class="mono">@rc.Cuenta</span> @rc.CuentaNombre · importe @((rc.Debe + rc.Haber).ToString("N2", Culture))</p>
        <table class="as-tabla as-cc-tabla">
            <thead><tr><th>Centro</th><th class="n">%</th><th class="n">Importe</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in _centrosEdit)
            {
                <tr @key="c">
                    <td>
                        <select class="as-input" value="@c.CCosto" @onchange="e => CambiarCentro(c, e)">
                            <option value="">Elegí…</option>
                            @foreach (var x in _cat?.Centros ?? []) { <option value="@x.Codigo">@x.Codigo · @x.Descripcion</option> }
                        </select>
                    </td>
                    <td class="n"><input class="as-input as-input--pct" type="number" step="0.01" min="0" max="100" value="@c.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                         @onchange="e => CambiarPorcentaje(c, e)" /></td>
                    <td class="n">@c.Importe.ToString("N2", Culture)</td>
                    <td><button type="button" class="as-icon" title="Quitar" @onclick="() => QuitarCentro(c)"><i class="bi bi-x-lg" aria-hidden="true"></i></button></td>
                </tr>
            }
            </tbody>
            <tfoot><tr><td><button type="button" class="as-link" @onclick="AgregarCentro"><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar centro</button></td>
                <td class="n"><b class="@(_centrosEdit.Count > 0 && _centrosEdit.Sum(x => x.Porcentaje) != 100 ? "as-mal" : null)">@_centrosEdit.Sum(x => x.Porcentaje).ToString("0.##") %</b></td><td></td><td></td></tr></tfoot>
        </table>
        @if (Sugeridos(rc.Cuenta).Count > 0)
        {
            <button type="button" class="as-link" @onclick="() => DistribucionDeLaCuenta(rc)">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Usar la distribución de la cuenta</button>
        }
        <small class="as-nota">Sin centros, el renglón queda sin distribuir (como en el Alfa Gestión).</small>
    }
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => _centrosDe = null">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check2" OnClick="_ => AceptarCentros()">Aceptar</AlfaButton>
    </Footer>
</AlfaDialog>

<AlfaDialog Open="@(_guardarModelo is not null)" Title="Guardar como modelo" Size="AlfaDialogSize.Sm" Loading="@_busy" ErrorMessage="@_errorModelo" OnClose="() => _guardarModelo = null">
    <ChildContent>
    @if (_guardarModelo is { } gm)
    {
        <div class="as-form">
            <AlfaInput Label="Nombre del modelo" Value="@gm.Nombre" ValueChanged="v => gm.Nombre = (v ?? string.Empty).ToUpperInvariant()" MaxLength="50"
                       HelpText="@(_cat?.Modelos.Contains(gm.Nombre.Trim()) == true ? "Ya existe: se reemplaza." : "Aparece en «Modelo» al cargar un asiento nuevo.")" />
            <AlfaCheckbox Value="@_modeloConImportes" ValueChanged="v => _modeloConImportes = v ?? true">Guardar también los importes</AlfaCheckbox>
            <AlfaCheckbox Value="@gm.ModificaTc" ValueChanged="v => gm.ModificaTc = v ?? true">Se puede cambiar el comprobante</AlfaCheckbox>
            <AlfaCheckbox Value="@gm.ModificaCuentas" ValueChanged="v => gm.ModificaCuentas = v ?? true">Se pueden cambiar las cuentas</AlfaCheckbox>
            <AlfaCheckbox Value="@gm.AgregaCuentas" ValueChanged="v => gm.AgregaCuentas = v ?? true">Se pueden agregar renglones</AlfaCheckbox>
        </div>
    }
    </ChildContent>
    <Footer>
        @if (_guardarModelo is { } gm2 && _cat?.Modelos.Contains(gm2.Nombre.Trim()) == true)
        {
            <AlfaButton Variant="AlfaButtonVariant.Danger" Icon="bi bi-trash" Disabled="_busy" OnClick="_ => EliminarModeloAsync()">Borrar modelo</AlfaButton>
        }
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="_busy" OnClick="_ => _guardarModelo = null">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check2" Disabled="_busy" OnClick="_ => GuardarModeloAsync()">Guardar modelo</AlfaButton>
    </Footer>
</AlfaDialog>

<AlfaConfirmDialog Open="@_confirmarAnular" Title="Anular asiento" ConfirmLabel="Anular" Loading="_busy" OnConfirm="AnularAsync" OnCancel="() => _confirmarAnular = false"
                   Message="@($"Se borra el asiento {_edit?.Clave?.Texto} ({_edit?.Comprobante}). Queda registrado en la auditoría. ¿Seguro?")" />

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private readonly AsientosBusqueda _f = new();
    private AsientosCatalogo? _cat;
    private IReadOnlyList<AsientoResumen> _lista = [];
    private AsientoDetalle? _edit;
    private AsientoControlArca? _arca;
    private AppUiMessage? _feedback;
    private bool _busy, _buscado, _confirmarAnular, _sucio;
    private string _texto = string.Empty;
    private PageHeaderConfig? _header;
    private AsientoModelo? _modelo, _guardarModelo;
    private bool _modeloConImportes = true;
    private string? _errorModelo, _errorCentros;
    private AsientoRenglon? _centrosDe;
    private List<AsientoCentro> _centrosEdit = [];

    private IReadOnlyList<AsientoCentroDefault> Sugeridos(string cuenta)
        => _cat?.CentrosPorCuenta.Where(d => d.Cuenta.Equals(cuenta, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];

    private Dictionary<string, decimal> _cotizaciones = new() { ["1"] = 1m };
    private readonly Dictionary<string, IReadOnlyList<ChequeCartera>> _cartera = new(StringComparer.OrdinalIgnoreCase);

    private AsientoCuenta? Cuenta(AsientoRenglon r) => r.Cuenta.Length == 0 ? null : _cat?.Cuentas.FirstOrDefault(c => c.Codigo == r.Cuenta);
    private bool ImporteCalculado(AsientoRenglon r) => Cuenta(r) is { } c && ((c.EnMonedaExtranjera && _edit is not { EnOtraMoneda: true }) || (c.EsCheque && !c.Bancaria && r.Haber > 0 && r.Cheque is not null));
    private string Moneda(string codigo) => _cat?.Monedas.FirstOrDefault(m => m.Codigo == codigo.Trim())?.Descripcion ?? codigo;
    private static string Dec(decimal v, string f = "0.00") => v == 0 ? "" : v.ToString(f, System.Globalization.CultureInfo.InvariantCulture);
    private static decimal LeerDec(ChangeEventArgs e)
        => decimal.TryParse((e.Value?.ToString() ?? "").Trim().Replace(',', '.'), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) ? Math.Abs(v) : 0;

    private async Task CargarCotizacionesAsync(DateTime fecha)
    {
        var r = await UiOps.RunAsync(() => Service.CotizacionesAsync(fecha), "Cotizaciones");
        if (r.Success) _cotizaciones = new Dictionary<string, decimal>(r.Value!);
    }

    private void Convertir(AsientoRenglon r, bool? alHaber = null)
    {
        var pesos = Math.Round(r.ImporteMoneda * r.Cotizacion, 2, MidpointRounding.AwayFromZero);
        var haber = alHaber ?? (r.Haber > 0);
        if (haber) { r.Haber = pesos; r.Debe = 0; } else { r.Debe = pesos; r.Haber = 0; }
        AlfaCore.Services.AsientosService.DistribuirImportes(r);
        _sucio = true;
    }

    private async Task<IReadOnlyList<ChequeCartera>> CarteraAsync(string cuenta)
    {
        if (_cartera.TryGetValue(cuenta, out var l)) return l;
        var r = await UiOps.RunAsync(() => Service.ChequesEnCarteraAsync(cuenta), "Cartera de cheques");
        l = r.Success ? r.Value! : [];
        _cartera[cuenta] = l;
        return l;
    }

    private async Task SentidoCheque(AsientoRenglon r, AsientoCuenta c, bool sale)
    {
        var importe = r.Debe + r.Haber;
        r.Cheque ??= new AsientoCheque();
        if (sale && !c.Bancaria)
        {
            r.Cheque = null; r.Debe = 0; r.Haber = 0; // se elige de la cartera
            _ = await CarteraAsync(c.Codigo);
            _saleDeCartera.Add(r);
        }
        else
        {
            _saleDeCartera.Remove(r);
            if (sale) { r.Haber = importe; r.Debe = 0; } else { r.Debe = importe; r.Haber = 0; }
        }
        _sucio = true;
        StateHasChanged();
    }
    private readonly HashSet<AsientoRenglon> _saleDeCartera = [];

    private void ElegirDeCartera(AsientoRenglon r, ChangeEventArgs e, IReadOnlyList<ChequeCartera> lista)
    {
        var sel = lista.FirstOrDefault(x => $"{x.IdBanco}|{x.NroComprobante}" == (e.Value?.ToString() ?? ""));
        if (sel is null) { r.Cheque = null; r.Haber = 0; return; }
        var guion = sel.NroComprobante.IndexOf('-');
        r.Cheque = new AsientoCheque
        {
            Serie = guion > 0 ? sel.NroComprobante[..guion] : "", Numero = guion >= 0 ? sel.NroComprobante[(guion + 1)..] : sel.NroComprobante,
            IdBanco = sel.IdBanco, Banco = sel.Banco, Vencimiento = sel.Vencimiento, Clearing = sel.Clearing, Cuit = sel.Cuit
        };
        r.Haber = sel.Importe; r.Debe = 0;
        AlfaCore.Services.AsientosService.DistribuirImportes(r);
        _sucio = true;
    }

    private RenderFragment Extras(AsientoRenglon r, AsientoCuenta c, bool editable) => __builder =>
    {
        <div class="as-extra">
        @if (c.EnMonedaExtranjera && _edit is not { EnOtraMoneda: true })
        {
            if (editable)
            {
                <span class="as-extra__grupo"><i class="bi bi-currency-exchange" aria-hidden="true"></i> @Moneda(c.Moneda)
                    <input class="as-input as-input--imp" type="number" step="0.01" min="0" placeholder="cantidad" value="@Dec(r.ImporteMoneda)"
                           @onchange="e => SetCantidad(r, e)" />
                    × cotización
                    <input class="as-input as-input--imp" type="number" step="0.0001" min="0" value="@Dec(r.Cotizacion, "0.####")"
                           @onchange="e => SetCotizacion(r, e)" />
                    <select class="as-input" value="@(r.Haber > 0 ? "H" : "D")" @onchange="e => SetLado(r, e)">
                        <option value="D">al debe</option><option value="H">al haber</option>
                    </select>
                    = $ @((r.Debe + r.Haber).ToString("N2", Culture))
                </span>
            }
            else
            {
                <span class="as-extra__grupo"><i class="bi bi-currency-exchange" aria-hidden="true"></i> @Moneda(r.Moneda) @r.ImporteMoneda.ToString("N2", Culture) × @r.Cotizacion.ToString("0.####", Culture)</span>
            }
        }
        @if (c.EsCheque || r.Cheque is not null)
        {
            var sale = r.Haber > 0 || _saleDeCartera.Contains(r);
            if (!editable)
            {
                if (r.Cheque is { } ch)
                {
                    <span class="as-extra__grupo"><i class="bi bi-credit-card-2-front" aria-hidden="true"></i>
                        Cheque @ch.NroComprobante · @(ch.Banco.Length > 0 ? ch.Banco : ch.IdBanco) · paga el @ch.Vencimiento?.ToString("dd/MM/yyyy")@(ch.Clearing > 0 ? $" · clearing {ch.Clearing} h" : "")@(ch.Cuit.Length > 0 ? $" · librador {ch.Cuit}" : "")</span>
                }
            }
            else
            {
                <span class="as-extra__grupo">
                    <i class="bi bi-credit-card-2-front" aria-hidden="true"></i>
                    <select class="as-input" value="@(sale ? "S" : "E")" @onchange="e => SetSentido(r, c, e)">
                        <option value="E">@(c.Bancaria ? "Cheque propio que vuelve (debe)" : "Entra un cheque (debe)")</option>
                        <option value="S">@(c.Bancaria ? "Emito un cheque propio (haber)" : "Sale un cheque de la cartera (haber)")</option>
                    </select>
                </span>
                @if (sale && !c.Bancaria)
                {
                    var lista = _cartera.TryGetValue(c.Codigo, out var l) ? l : [];
                    <span class="as-extra__grupo">
                        <select class="as-input as-input--cartera" value="@(r.Cheque is { } sel ? $"{CodigoBanco(sel.IdBanco)}|{sel.NroComprobante}" : "")" @onchange="e => ElegirDeCartera(r, e, lista)">
                            <option value="">@(lista.Count == 0 ? "No hay cheques en cartera en esta cuenta" : $"Elegí el cheque ({lista.Count} en cartera)…")</option>
                            @foreach (var x in lista)
                            {
                                <option value="@($"{x.IdBanco}|{x.NroComprobante}")">@x.NroComprobante · @x.Banco · $ @x.Importe.ToString("N2", Culture) · paga @x.Vencimiento?.ToString("dd/MM/yyyy") · @x.Origen</option>
                            }
                        </select>
                    </span>
                }
                else
                {
                    var ch = r.Cheque ??= new AsientoCheque();
                    <span class="as-extra__grupo">
                        Serie <input class="as-input as-input--serie" maxlength="1" value="@ch.Serie" @onchange="e => SetSerie(ch, e)" />
                        Número <input class="as-input as-input--nro" maxlength="20" inputmode="numeric" value="@ch.Numero" @onchange="e => SetNumero(ch, e)" />
                        <select class="as-input" value="@ch.IdBanco" @onchange="e => SetBanco(ch, e)">
                            <option value="">Banco…</option>
                            @foreach (var b in _cat?.Bancos ?? []) { <option value="@b.IdBanco">@b.Descripcion</option> }
                        </select>
                        Paga <input type="date" class="as-input" value="@ch.Vencimiento?.ToString("yyyy-MM-dd")" @onchange="e => SetPaga(ch, e)" />
                        Clearing <select class="as-input" value="@ch.Clearing" @onchange="e => SetClearing(ch, e)">
                            @foreach (var h in AlfaCore.Services.AsientosService.Clearings) { <option value="@h">@h h</option> }
                        </select>
                        @if (!c.Bancaria)
                        {
                            <span>CUIT librador <input class="as-input as-input--cuit" maxlength="13" value="@ch.Cuit" @onchange="e => SetCuit(ch, e)" /></span>
                        }
                        @if (ch.Vencimiento is { } v && (v.Date < DateTime.Today || (v - DateTime.Today).TotalDays > 600))
                        {
                            <small class="as-aviso">@(v.Date < DateTime.Today ? "La fecha de pago ya pasó." : "La fecha de pago es muy lejana: revisala.")</small>
                        }
                    </span>
                }
            }
        }
        </div>
    };

    private static string CodigoBanco(string id) => id.Trim();
    private void SetCantidad(AsientoRenglon r, ChangeEventArgs e) { r.ImporteMoneda = Math.Round(LeerDec(e), 2); Convertir(r); }
    private void SetCotizacion(AsientoRenglon r, ChangeEventArgs e) { r.Cotizacion = Math.Round(LeerDec(e), 6); Convertir(r); }
    private void SetLado(AsientoRenglon r, ChangeEventArgs e) => Convertir(r, e.Value?.ToString() == "H");
    private Task SetSentido(AsientoRenglon r, AsientoCuenta c, ChangeEventArgs e) => SentidoCheque(r, c, e.Value?.ToString() == "S");
    private void SetSerie(AsientoCheque ch, ChangeEventArgs e) { ch.Serie = (e.Value?.ToString() ?? string.Empty).Trim().ToUpperInvariant(); _sucio = true; }
    private void SetNumero(AsientoCheque ch, ChangeEventArgs e) { ch.Numero = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray()); _sucio = true; }
    private void SetBanco(AsientoCheque ch, ChangeEventArgs e) { ch.IdBanco = e.Value?.ToString() ?? string.Empty; _sucio = true; }
    private void SetPaga(AsientoCheque ch, ChangeEventArgs e)
    {
        ch.Vencimiento = DateTime.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;
        _sucio = true;
    }
    private void SetClearing(AsientoCheque ch, ChangeEventArgs e) { ch.Clearing = int.TryParse(e.Value?.ToString(), out var h) ? h : 48; _sucio = true; }
    private void SetCuit(AsientoCheque ch, ChangeEventArgs e) { ch.Cuit = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray()); _sucio = true; }

    private string NombreCentro(string codigo) => _cat?.Centros.FirstOrDefault(c => c.Codigo == codigo)?.Descripcion ?? "";

    private RenderFragment Centros(AsientoRenglon r, bool editable) => __builder =>
    {
        var sugeridos = Sugeridos(r.Cuenta);
        if (r.Centros.Count == 0 && (!editable || sugeridos.Count == 0 && (_cat?.Centros.Count ?? 0) == 0 || r.Cuenta.Length == 0)) return;
        var revisar = editable && sugeridos.Any(x => x.PideConfirmacion);
        if (editable)
        {
            <button type="button" class="as-cc @(r.Centros.Count == 0 ? "is-vacio" : null) @(revisar ? "is-revisar" : null)" title="Distribuir en centros de costo" @onclick="() => AbrirCentros(r)">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                @(r.Centros.Count == 0 ? (sugeridos.Count > 0 ? "Distribuir" : "—") : ResumenCentros(r))
                @if (revisar) { <i class="bi bi-exclamation-circle" aria-hidden="true" title="La cuenta pide confirmar la distribución"></i> }
            </button>
        }
        else
        {
            <span class="as-cc-txt">@ResumenCentros(r)</span>
        }
    };

    private string ResumenCentros(AsientoRenglon r)
        => string.Join(" · ", r.Centros.Select(c => $"{c.CCosto} {(c.Descripcion.Length > 0 ? c.Descripcion : NombreCentro(c.CCosto))} {c.Porcentaje:0.##}%"));

    private void AbrirCentros(AsientoRenglon r)
    {
        _errorCentros = null;
        _centrosEdit = r.Centros.Select(c => new AsientoCentro { CCosto = c.CCosto, Descripcion = c.Descripcion, Porcentaje = c.Porcentaje, Importe = c.Importe }).ToList();
        if (_centrosEdit.Count == 0)
            _centrosEdit = Sugeridos(r.Cuenta).Where(x => x.Porcentaje > 0).Select(x => new AsientoCentro { CCosto = x.CCosto, Porcentaje = x.Porcentaje }).ToList();
        if (_centrosEdit.Count == 0) _centrosEdit.Add(new AsientoCentro { Porcentaje = 100 });
        _centrosDe = r;
        RecalcularCentros();
    }

    private void CambiarCentro(AsientoCentro c, ChangeEventArgs e) { c.CCosto = e.Value?.ToString() ?? string.Empty; RecalcularCentros(); }
    private void CambiarPorcentaje(AsientoCentro c, ChangeEventArgs e)
    {
        var txt = (e.Value?.ToString() ?? string.Empty).Replace(',', '.');
        c.Porcentaje = decimal.TryParse(txt, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) ? Math.Round(Math.Abs(v), 2) : 0;
        RecalcularCentros();
    }
    private void QuitarCentro(AsientoCentro c) { _centrosEdit.Remove(c); RecalcularCentros(); }
    private void AgregarCentro() { _centrosEdit.Add(new AsientoCentro { Porcentaje = Math.Max(0, 100 - _centrosEdit.Sum(x => x.Porcentaje)) }); RecalcularCentros(); }
    private void DistribucionDeLaCuenta(AsientoRenglon r)
    {
        _centrosEdit = Sugeridos(r.Cuenta).Where(x => x.Porcentaje > 0).Select(x => new AsientoCentro { CCosto = x.CCosto, Porcentaje = x.Porcentaje }).ToList();
        RecalcularCentros();
    }

    private void RecalcularCentros()
    {
        if (_centrosDe is null) return;
        var tmp = new AsientoRenglon { Debe = _centrosDe.Debe, Haber = _centrosDe.Haber, Centros = _centrosEdit };
        AlfaCore.Services.AsientosService.DistribuirImportes(tmp);
    }

    private void AceptarCentros()
    {
        if (_centrosDe is null) return;
        var lista = _centrosEdit.Where(c => c.CCosto.Length > 0 || c.Porcentaje != 0).ToList();
        if (lista.Count > 0)
        {
            if (lista.Any(c => c.CCosto.Length == 0)) { _errorCentros = "Elegí el centro de cada fila."; return; }
            if (lista.GroupBy(c => c.CCosto).Any(g => g.Count() > 1)) { _errorCentros = "Hay un centro repetido."; return; }
            if (lista.Sum(c => c.Porcentaje) != 100) { _errorCentros = $"Los porcentajes tienen que sumar 100 % (suman {lista.Sum(c => c.Porcentaje):0.##} %)."; return; }
        }
        foreach (var c in lista) c.Descripcion = NombreCentro(c.CCosto);
        _centrosDe.Centros = lista;
        AlfaCore.Services.AsientosService.DistribuirImportes(_centrosDe);
        _centrosDe = null; _sucio = true;
    }

    /// <summary>Al elegir la cuenta: la distribución de la cuenta si suma 100 % (como el legacy, que la proponía).</summary>
    private void SugerirCentros(AsientoRenglon r)
    {
        var sug = Sugeridos(r.Cuenta).Where(x => x.Porcentaje > 0).ToList();
        r.Centros = sug.Sum(x => x.Porcentaje) == 100
            ? sug.Select(x => new AsientoCentro { CCosto = x.CCosto, Porcentaje = x.Porcentaje, Descripcion = NombreCentro(x.CCosto) }).ToList() : [];
        AlfaCore.Services.AsientosService.DistribuirImportes(r);
    }

    private async Task UsarModeloAsync(ChangeEventArgs e)
    {
        var nombre = e.Value?.ToString() ?? "";
        if (_edit is null || _edit.Clave is not null) return;
        if (nombre.Length == 0) { _modelo = null; _edit.Renglones = [new AsientoRenglon(), new AsientoRenglon()]; UpdateHeader(); return; }
        var r = await UiOps.RunAsync(() => Service.ModeloAsync(nombre), "Modelo");
        if (!r.Success) { _feedback = r.Feedback; return; }
        _modelo = r.Value!;
        if (_modelo.Tc.Length > 0 && _cat?.Talonarios.Any(t => t.Codigo == _modelo.Tc) == true) _edit.Tc = _modelo.Tc;
        _edit.Renglones = _modelo.Renglones;
        foreach (var x in _edit.Renglones) SugerirCentros(x);
        if (_modelo.AgregaCuentas) _edit.Renglones.Add(new AsientoRenglon());
        if (_edit.Detalle.Trim().Length == 0) _edit.Detalle = _modelo.Nombre;
        _sucio = true;
        UpdateHeader();
    }

    private Task AbrirGuardarModelo()
    {
        if (_edit is null) return Task.CompletedTask;
        _errorModelo = null; _modeloConImportes = true;
        _guardarModelo = new AsientoModelo
        {
            Nombre = _modelo?.Nombre ?? "", Tc = _edit.Tc, ModificaTc = _modelo?.ModificaTc ?? true, ModificaCuentas = _modelo?.ModificaCuentas ?? true,
            AgregaCuentas = _modelo?.AgregaCuentas ?? true
        };
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task GuardarModeloAsync()
    {
        if (_guardarModelo is null || _edit is null) return;
        _busy = true; _errorModelo = null;
        try
        {
            // Sin importes, cada cuenta conserva de qué lado va (AlHaber).
            _guardarModelo.Renglones = _edit.Renglones.Where(x => x.Cuenta.Length > 0)
                .Select(x => new AsientoRenglon { Cuenta = x.Cuenta, Detalle = x.Detalle, Debe = _modeloConImportes ? x.Debe : 0,
                    Haber = _modeloConImportes ? x.Haber : 0, AlHaber = x.Haber > 0 || (x.Debe == 0 && x.AlHaber) })
                .ToList();
            await Service.GuardarModeloAsync(_guardarModelo);
            var nombre = _guardarModelo.Nombre.Trim().ToUpperInvariant();
            if (_cat is not null && !_cat.Modelos.Contains(nombre)) _cat.Modelos = _cat.Modelos.Append(nombre).OrderBy(x => x).ToList();
            _feedback = AppUiMessage.Success("Modelo guardado", $"El modelo {nombre} quedó disponible al cargar un asiento nuevo.");
            _guardarModelo = null;
        }
        catch (Exception ex) { _errorModelo = ex is AppUserFacingException or InvalidOperationException ? ex.Message : "No se pudo guardar el modelo."; }
        finally { _busy = false; UpdateHeader(); }
    }

    private async Task EliminarModeloAsync()
    {
        if (_guardarModelo is null) return;
        _busy = true; _errorModelo = null;
        try
        {
            var nombre = _guardarModelo.Nombre.Trim();
            await Service.EliminarModeloAsync(nombre);
            if (_cat is not null) _cat.Modelos = _cat.Modelos.Where(x => x != nombre).ToList();
            if (_modelo?.Nombre == nombre) _modelo = null;
            _feedback = AppUiMessage.Success("Modelo borrado", $"Se borró el modelo {nombre}.");
            _guardarModelo = null;
        }
        catch (Exception ex) { _errorModelo = ex is AppUserFacingException or InvalidOperationException ? ex.Message : "No se pudo borrar el modelo."; }
        finally { _busy = false; UpdateHeader(); }
    }

    private bool Editable => _edit is not null && _edit.Editable && _cat is not null && (_edit.Clave is null ? _cat.PuedeCargar : _cat.PuedeModificar);
    private decimal Diferencia => _edit is null ? 0 : _edit.TotalDebe - _edit.TotalHaber;
    private bool PideVencimiento => _edit is not null && _cat is not null && _edit.Renglones.Any(r => _cat.Cuentas.FirstOrDefault(c => c.Codigo == r.Cuenta)?.PideVencimiento == true);

    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarComprobante { get; set; }
    [SupplyParameterFromQuery(Name = "periodo")] public string? PeriodoRevision { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(BuscarComprobante))
        {
            // Se llega desde un comprobante (puede ser una proforma): el servicio la oculta si el usuario no puede verlas.
            _texto = BuscarComprobante.Trim(); _f.Origen = "TODOS"; _f.IncluirProformas = true;
            if (DateTime.TryParseExact(PeriodoRevision, "yyyy-MM", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var mes))
            { _f.FechaDesde = mes; _f.FechaHasta = mes.AddMonths(1).AddDays(-1); }
        }
        UpdateHeader();
        var c = await UiOps.RunAsync(() => Service.CatalogoAsync(), "Asientos");
        if (c.Success) _cat = c.Value; else _feedback = c.Feedback;
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        if (_busy) return;
        _busy = true; UpdateHeader();
        try
        {
            var filtro = Filtro();
            var r = await UiOps.RunAsync(() => Service.BuscarAsync(filtro), "Asientos");
            if (r.Success) { _lista = r.Value!; _buscado = true; } else _feedback = r.Feedback;
        }
        finally { _busy = false; UpdateHeader(); StateHasChanged(); }
    }

    private AsientosFiltro Filtro() => new()
    {
        Desde = _f.FechaDesde?.Date, Hasta = _f.FechaHasta?.Date, Texto = _texto, Origen = _f.Origen, Cuenta = _f.Cuenta, Unidad = _f.Unidad,
        IncluirProformas = _f.IncluirProformas
    };

    // Buscador estándar (como Clientes y los tableros): período, origen, unidad y cuenta en el embudo, con chips.
    private static readonly (string Key, string Label)[] Origenes =
        [("TODOS", "Todos"), ("MANUALES", "Solo asientos manuales"), ("COMPROBANTES", "Solo de comprobantes")];

    private RenderFragment RenderSmartSearch() => @<GestionSmartSearch Model="_f" Placeholder="Buscar: número (10-25), comprobante, detalle, cuenta o usuario"
                                                                    Texto="@_texto" TextoChanged="CambiarTexto" PermitirTodo="true"
                                                                    Chips="SmartChips" OnRemoveChip="QuitarChip" OnClear="LimpiarFiltros" OnApply="BuscarAsync">
        <Columnas>
            <div class="smart-search__column">
                <h4><i class="bi bi-journal-text"></i> Mostrar</h4>
                @foreach (var o in Origenes)
                {
                    <button type="button" class="@(_f.Origen == o.Key ? "smart-option is-active" : "smart-option")" @onclick="() => Filtrar(() => _f.Origen = o.Key)">@o.Label</button>
                }
            </div>
            @if (_cat is { Unidades.Count: > 1 } || _cat is { Cuentas.Count: > 0 } || _cat is { PuedeVerProformas: true })
            {
                <div class="smart-search__column">
                    <h4><i class="bi bi-funnel"></i> Otros filtros</h4>
                    @if (_cat is { Unidades.Count: > 1 })
                    {
                        <div class="smart-search__inline">
                            <label>Unidad</label>
                            <select value="@_f.Unidad" @onchange="e => Filtrar(() => _f.Unidad = e.Value?.ToString() ?? string.Empty)">
                                <option value="">Todas</option>
                                @foreach (var u in _cat.Unidades) { <option value="@u.Codigo">@u.Codigo · @u.Descripcion</option> }
                            </select>
                        </div>
                    }
                    @if (_cat is { Cuentas.Count: > 0 })
                    {
                        <div class="as-filtros__cuenta"><AsientoCuentaLookup Label="Con la cuenta" Cuenta="@_f.Cuenta" CuentaChanged="v => Filtrar(() => _f.Cuenta = v)" Cuentas="_cat.Cuentas" /></div>
                    }
                    @if (_cat is { PuedeVerProformas: true })
                    {
                        <AlfaCheckbox Value="@_f.IncluirProformas" ValueChanged="v => Filtrar(() => _f.IncluirProformas = v == true)">Incluir proformas</AlfaCheckbox>
                    }
                </div>
            }
        </Columnas>
    </GestionSmartSearch>;

    private IReadOnlyList<GestionSmartChip> SmartChips
    {
        get
        {
            var chips = new List<GestionSmartChip>();
            if (_f.Origen != "TODOS") chips.Add(new("origen", Origenes.First(o => o.Key == _f.Origen).Label));
            if (_f.Unidad.Length > 0) chips.Add(new("unidad", $"Unidad: {_f.Unidad}"));
            if (_f.Cuenta.Length > 0) chips.Add(new("cuenta", $"Cuenta: {_f.Cuenta}"));
            if (_f.IncluirProformas) chips.Add(new("proformas", "Incluye proformas"));
            return chips;
        }
    }

    // El panel se dibuja dentro del layout: hay que volver a publicar el header para que se vea la opción elegida.
    private void Filtrar(Action cambio) { cambio(); UpdateHeader(); }

    private void QuitarChip(string key)
    {
        if (key == "origen") _f.Origen = "TODOS";
        else if (key == "unidad") _f.Unidad = string.Empty;
        else if (key == "cuenta") _f.Cuenta = string.Empty;
        else if (key == "proformas") _f.IncluirProformas = false;
    }

    // «Limpiar» vuelve a lo de entrada: los últimos asientos, sin período.
    private void LimpiarFiltros()
    {
        _f.FechaDesde = null; _f.FechaHasta = null;
        _f.Origen = "TODOS"; _f.Unidad = string.Empty; _f.Cuenta = string.Empty; _f.IncluirProformas = false; _texto = string.Empty;
    }

    private static string Origen(AsientoResumen x) => x.Manual ? "Manual" : x.LivaTipo.ToUpperInvariant() switch
    {
        "COMPRAS" => "Compra", "VENTAS" => "Venta",
        _ => x.TipoReg.Trim() switch { "CB" => "Cobranza", "PG" => "Pago", "" => x.Tc, var t => t }
    };

    private async Task AbrirAsync(AsientoClave clave)
    {
        if (_busy) return;
        _busy = true; _arca = null; UpdateHeader();
        try
        {
            var r = await UiOps.RunAsync(() => Service.GetAsync(clave), "Asiento");
            if (r.Success)
            {
                _edit = r.Value; _sucio = false; _cartera.Clear(); _saleDeCartera.Clear();
                await CargarCotizacionesAsync(_edit!.Fecha);
                foreach (var x in _edit.Renglones.Where(x => x.Cheque is not null && x.Haber > 0 && Cuenta(x) is { Bancaria: false } c))
                {
                    _saleDeCartera.Add(x);
                    // El cheque que este asiento entrega figura en la lista para poder dejarlo elegido.
                    var lista = (await CarteraAsync(x.Cuenta)).ToList();
                    if (!lista.Any(c => c.IdBanco == x.Cheque!.IdBanco && c.NroComprobante == x.Cheque.NroComprobante))
                        lista.Add(new ChequeCartera { Cuenta = x.Cuenta, NroComprobante = x.Cheque!.NroComprobante, IdBanco = x.Cheque.IdBanco, Banco = x.Cheque.Banco,
                            Importe = x.Haber, Vencimiento = x.Cheque.Vencimiento, Cuit = x.Cheque.Cuit, Clearing = x.Cheque.Clearing, Origen = "este asiento" });
                    _cartera[x.Cuenta] = lista;
                }
            }
            else _feedback = r.Feedback;
        }
        finally { _busy = false; UpdateHeader(); StateHasChanged(); }
        if (_edit is { LivaTipo.Length: > 0, Clave: { } k }) await ControlArcaAsync(k);
    }

    private async Task ControlArcaAsync(AsientoClave k)
    {
        var r = await UiOps.RunAsync(() => Service.ControlArcaAsync(k), "Control ARCA");
        if (r.Success) _arca = r.Value;
        else _arca = new AsientoControlArca { Estado = "SIN_ARCHIVO", Mensaje = r.Feedback?.Message ?? "No se pudo controlar con ARCA." };
        StateHasChanged();
    }

    private async Task Nuevo()
    {
        if (_cat is null) return;
        await CargarCotizacionesAsync(DateTime.Today);
        _edit = new AsientoDetalle
        {
            Fecha = DateTime.Today, Tc = _cat.Talonarios.FirstOrDefault()?.Codigo ?? "CC", Unidad = _cat.UnidadUsuario,
            Renglones = [new AsientoRenglon(), new AsientoRenglon()]
        };
        _arca = null; _sucio = false; _modelo = null; _cartera.Clear(); _saleDeCartera.Clear();
        UpdateHeader(); StateHasChanged();
    }

    private Task Volver()
    {
        _edit = null; _arca = null; _sucio = false; _modelo = null;
        UpdateHeader(); StateHasChanged();
        return Task.CompletedTask;
    }

    private void CambiarFechaAsiento(ChangeEventArgs e)
    {
        if (_edit is not null && DateTime.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d))
        {
            _edit.Fecha = d; _sucio = true;
            _ = InvokeAsync(async () =>
            {
                await CargarCotizacionesAsync(d);
                if (_edit is { EnOtraMoneda: true } e2) e2.CotizacionAsiento = _cotizaciones.GetValueOrDefault(e2.MonedaAsiento.Trim(), e2.CotizacionAsiento);
                StateHasChanged();
            });
        }
    }
    /// <summary>Moneda de todo el asiento (como el legacy): los importes se cargan en esa moneda y al grabar se pasan a pesos.</summary>
    private void CambiarMonedaAsiento(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var m = (e.Value?.ToString() ?? "1").Trim();
        _edit.MonedaAsiento = m.Length == 0 ? "1" : m;
        _edit.CotizacionAsiento = _edit.EnOtraMoneda ? _cotizaciones.GetValueOrDefault(m, 1m) : 1m;
        _sucio = true;
    }
    private void CambiarVencimiento(ChangeEventArgs e)
    {
        if (_edit is null) return;
        _edit.Vencimiento = DateTime.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;
    }

    private void CambiarCuenta(AsientoRenglon r, string cuenta)
    {
        r.Cuenta = cuenta;
        r.CuentaNombre = _cat?.Cuentas.FirstOrDefault(c => c.Codigo == cuenta)?.Descripcion ?? "";
        var cu = Cuenta(r);
        r.Moneda = cu?.Moneda ?? "1";
        r.Cotizacion = cu is { EnMonedaExtranjera: true } ? _cotizaciones.GetValueOrDefault(cu.Moneda.Trim(), 1m) : 1m;
        if (cu is { EnMonedaExtranjera: false }) r.ImporteMoneda = 0;
        r.Cheque = cu is { EsCheque: true } ? r.Cheque ?? new AsientoCheque() : null;
        _saleDeCartera.Remove(r);
        SugerirCentros(r);
        _sucio = true;
        // Siempre queda un renglón vacío al final para seguir cargando (salvo que el modelo no deje agregar).
        if (_edit is not null && _modelo is not { AgregaCuentas: false } && _edit.Renglones.Count > 0 && _edit.Renglones[^1] == r && cuenta.Length > 0)
            _edit.Renglones.Add(new AsientoRenglon());
    }

    private static string Monto(decimal v) => v == 0 ? "" : v.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private void Importe(AsientoRenglon r, ChangeEventArgs e, bool debe)
    {
        var txt = (e.Value?.ToString() ?? "").Trim().Replace(',', '.');
        var v = decimal.TryParse(txt, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var x) ? Math.Round(Math.Abs(x), 2) : 0;
        if (debe) { r.Debe = v; if (v != 0) r.Haber = 0; } else { r.Haber = v; if (v != 0) r.Debe = 0; }
        AlfaCore.Services.AsientosService.DistribuirImportes(r);
        _sucio = true;
    }

    private void Agregar() => _edit?.Renglones.Add(new AsientoRenglon());

    private void Quitar(AsientoRenglon r)
    {
        if (_edit is null) return;
        _edit.Renglones.Remove(r);
        if (_edit.Renglones.Count == 0) _edit.Renglones.Add(new AsientoRenglon());
        _sucio = true;
    }

    private void Balancear()
    {
        if (_edit is null) return;
        var dif = Diferencia;
        var r = _edit.Renglones.LastOrDefault(x => x.Cuenta.Length > 0 && x.Debe == 0 && x.Haber == 0)
                ?? _edit.Renglones.LastOrDefault(x => x.Cuenta.Length == 0) ?? new AsientoRenglon();
        if (!_edit.Renglones.Contains(r)) _edit.Renglones.Add(r);
        if (dif > 0) { r.Haber = dif; r.Debe = 0; } else { r.Debe = -dif; r.Haber = 0; }
        _sucio = true;
    }

    private async Task GrabarAsync()
    {
        if (_edit is null || _busy) return;
        _busy = true; _feedback = null; UpdateHeader();
        try
        {
            var nuevo = _edit.Clave is null;
            var r = await UiOps.RunAsync(() => Service.GuardarAsync(_edit), "Grabar asiento");
            if (r.Success)
            {
                _edit = r.Value; _sucio = false;
                _feedback = AppUiMessage.Success(nuevo ? "Asiento registrado" : "Asiento modificado", $"Asiento {_edit!.Clave?.Texto} ({_edit.Comprobante}).");
                await BuscarSinRefrescarAsync();
            }
            else _feedback = r.Feedback;
        }
        finally { _busy = false; UpdateHeader(); StateHasChanged(); }
    }

    private async Task BuscarSinRefrescarAsync()
    {
        var filtro = Filtro();
        var r = await UiOps.RunAsync(() => Service.BuscarAsync(filtro), "Asientos");
        if (r.Success) _lista = r.Value!;
    }

    private async Task AnularAsync()
    {
        _confirmarAnular = false;
        if (_edit?.Clave is not { } k || _busy) return;
        _busy = true; UpdateHeader();
        try
        {
            var r = await UiOps.RunAsync(() => Service.EliminarAsync(k, _edit.Huella), "Anular asiento");
            if (r.Success)
            {
                _feedback = AppUiMessage.Success("Asiento anulado", $"Se anuló el asiento {k.Texto}.");
                _edit = null; await BuscarSinRefrescarAsync();
            }
            else _feedback = r.Feedback;
        }
        finally { _busy = false; UpdateHeader(); StateHasChanged(); }
    }

    private Task CambiarTexto(string? t) { _texto = t ?? string.Empty; return Task.CompletedTask; }

    private void UpdateHeader()
    {
        var acciones = new List<PageHeaderAction>();
        if (_edit is null)
        {
            acciones.Add(new() { Key = "nuevo", Label = "Nuevo asiento", Icon = "bi-plus-lg", Style = PageHeaderActionStyle.Primary, Disabled = _busy || _cat?.PuedeCargar != true, OnClick = Nuevo });
        }
        else
        {
            if (Editable)
                acciones.Add(new() { Key = "grabar", Label = "Grabar", Icon = "bi-check2", Style = PageHeaderActionStyle.Primary, Disabled = _busy, OnClick = GrabarAsync });
            if (_edit.Clave is not null && _edit.Editable && _cat?.PuedeAnular == true)
                acciones.Add(new() { Key = "anular", Label = "Anular", Icon = "bi-trash", Style = PageHeaderActionStyle.Danger, Disabled = _busy, OnClick = () => { _confirmarAnular = true; StateHasChanged(); return Task.CompletedTask; } });
            if ((Editable || _edit.Editable) && _cat?.PuedeGuardarModelos == true && _edit.Renglones.Count(x => x.Cuenta.Length > 0) >= 2)
                acciones.Add(new() { Key = "modelo", Label = "Guardar como modelo", Icon = "bi-bookmark-plus", Style = PageHeaderActionStyle.Ghost, Disabled = _busy, OnClick = AbrirGuardarModelo });
            if (_edit is { LivaTipo.Length: > 0, Clave: { } k })
                acciones.Add(new() { Key = "arca", Label = "Controlar con ARCA", Icon = "bi-shield-check", Style = PageHeaderActionStyle.Secondary, Disabled = _busy, OnClick = () => ControlArcaAsync(k) });
            acciones.Add(new() { Key = "volver", Label = _sucio ? "Cancelar" : "Volver", Icon = "bi-arrow-left", Style = PageHeaderActionStyle.Secondary, Disabled = _busy, OnClick = Volver });
        }
        PageHeader.Set(_header = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot, ModuleKey = "contabilidad", Title = "Asientos",
            Breadcrumb = _edit is null ? ["Contabilidad", "Asientos"] : ["Contabilidad", "Asientos", _edit.Clave?.Texto ?? "Nuevo"],
            TopNavigationItems = ModuleTopNavPresets.BuildContabilidad(RouteContext, Nav, "asientos"),
            State = _busy ? PageHeaderState.Loading : _edit is null ? PageHeaderState.List : PageHeaderState.Editing,
            Search = _edit is null ? new PageHeaderSearchConfig() : null,
            SearchContent = _edit is null ? RenderSmartSearch() : null,
            Actions = acciones
        });
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _header)) PageHeader.Clear();
    }
}
