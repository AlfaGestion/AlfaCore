@page "/ventas/clientes"
@page "/{idweb}/{idbase:int}/ventas/clientes"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.GestionFilterStateService FilterState
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Clientes | Ventas</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Clientes</h2>
            <p>Tablero comercial por cliente para analizar facturación, concentración y recurrencia.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudieron cargar los datos" Message="@_error" />
    }
    else if (_loading)
    {
        <AlfaEmptyState Title="Cargando" Message="Buscando datos del período." />
    }
    else
    {
        <section class="kpi-grid">
            <article class="kpi-card"><div class="kpi-card__label">Total facturado</div><div class="kpi-card__value">@FmtMoney(_page.TotalFacturado)</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Clientes activos</div><div class="kpi-card__value">@_page.ClientesActivos.ToString("N0")</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Ticket promedio</div><div class="kpi-card__value">@FmtMoney(_page.TicketPromedio)</div></article>
        </section>

        <section class="panel-card">
            <HorizontalBarChart Data="_page.TopClientes" Titulo="Top clientes" Subtitulo="Concentración de facturación del período" />
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Clientes del período</h3>
                    <p class="panel-card__subtitle">@_page.Clientes.Count registro(s) consolidados.</p>
                </div>
            </div>

            <div class="usuarios-table-wrap">
                <table class="data-table usuarios-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th>Cuenta</th>
                            <th>Cliente</th>
                            <th>Total facturado</th>
                            <th>Participación</th>
                            <th>Comprobantes</th>
                            <th>Ticket promedio</th>
                            <th>Última venta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _page.Clientes)
                        {
                            <tr>
                                <td>@item.Cuenta</td>
                                <td>@item.Cliente</td>
                                <td>@FmtMoney(item.TotalFacturado)</td>
                                <td>@item.Participacion.ToString("P1", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td>
                                <td>@item.CantidadComprobantes.ToString("N0")</td>
                                <td>@FmtMoney(item.TicketPromedio)</td>
                                <td>@FmtDate(item.UltimaVenta)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private bool _loading = true;
    private string _error = string.Empty;
    private VentasDashboardFilters _filters = null!;
    private VentasFilterOptionsDto _options = new();
    private VentasClientesPageDto _page = new();

    protected override void OnInitialized()
    {
        _filters = FilterState.Ventas;
        UpdatePageHeader();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    // Filtros en el Context Toolbar (Smart Search). El fragmento lee _filters/_options al dibujarse:
    // después de cargar las opciones se vuelve a publicar el header.
    private RenderFragment RenderSmartSearch() => @<VentasSmartSearch Model="_filters" Options="_options" OnApply="LoadAsync" />;

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "ventas",
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildVentas(RouteContext, Nav, "clientes")
    });

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Ventas;
        try
        {
            _options = await GestionSvc.GetVentasFilterOptionsAsync();
            UpdatePageHeader();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        try
        {
            _page = await GestionSvc.GetVentasClientesAsync(_filters);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FmtMoney(decimal value)
        => value.ToString("$ #,##0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static string FmtDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "—";
}
