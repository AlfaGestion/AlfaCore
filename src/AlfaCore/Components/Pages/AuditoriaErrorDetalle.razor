@page "/auditoria/error/{Id:int}"
@page "/{idweb}/{idbase:int}/auditoria/error/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@inject AlfaCore.Services.IAuditoriaService AuditoriaSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps

<PageTitle>Detalle de Error | Alfa GestiÃ³n</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando errorâ€¦
    </div>
}
else if (_item is null)
{
    <div class="consultas-error">
        <i class="bi bi-exclamation-triangle"></i> No se encontrÃ³ el error solicitado.
    </div>
}
else
{
    <div class="page-grid">
        @if (_feedback is not null)
        {
            <div class="conversations-inline @GetFeedbackClass(_feedback)">
                <strong>@_feedback.Title</strong>
                <div>@_feedback.Message</div>
                @if (_feedback.HasCode)
                {
                    <div>CÃ³digo: @_feedback.Code</div>
                }
                @if (_feedback.HasSuggestion)
                {
                    <div>@_feedback.Suggestion</div>
                }
            </div>
        }

        <section class="page-intro">
            <div>
                <h2 class="page-intro__title">Error #@_item.Id</h2>
                <p class="page-intro__text">@_item.Proceso Â· @_item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</p>
            </div>
            <div class="actions">
                <a class="btn btn--ghost" href="/auditoria/errores">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver a errores</span>
                </a>
            </div>
        </section>

        <section class="two-grid">
            <article class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Datos principales</h3>
                    </div>
                </div>
                <div class="detail-grid">
                    <div><strong>Fecha</strong><br />@_item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    <div><strong>Proceso</strong><br />@_item.Proceso</div>
                    <div><strong>Usuario</strong><br />@_item.Usuario</div>
                    <div><strong>PC</strong><br />@_item.Pc</div>
                    <div><strong>CÃ³digo</strong><br />@_item.ErrorCodigo</div>
                </div>
            </article>

            <article class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">DescripciÃ³n</h3>
                    </div>
                </div>
                <div class="auditoria__block">
                    @_item.Descripcion
                </div>
            </article>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">InstrucciÃ³n SQL / detalle tÃ©cnico</h3>
                    <p class="panel-card__subtitle">Campo `Sql` de `AUX_ERR`, preparado para copiar y pegar.</p>
                </div>
            </div>
            <textarea class="auditoria__textarea" readonly rows="18">@_item.Sql</textarea>
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private AlfaCore.Models.AppUiMessage? _feedback;
    private AuditoriaErrorRowDto? _item;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _feedback = null;
        var result = await UiOps.RunAsync(
            () => AuditoriaSvc.GetErrorByIdAsync(Id),
            "No se pudo cargar el detalle del error.");
        _item = result.Value;
        _feedback = result.Feedback;
        _loading = false;
    }

    private static string GetFeedbackClass(AlfaCore.Models.AppUiMessage message)
        => message.Severity switch
        {
            AlfaCore.Models.AppUiFeedbackSeverity.Success => "conversations-inline--ok",
            AlfaCore.Models.AppUiFeedbackSeverity.Warning => "conversations-inline--error",
            AlfaCore.Models.AppUiFeedbackSeverity.Error => "conversations-inline--error",
            _ => "conversations-inline--ok"
        };
}
