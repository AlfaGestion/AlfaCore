@page "/auditoria/error/{Id:int}"
@page "/{idweb}/{idbase:int}/auditoria/error/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@inject AlfaCore.Services.IAuditoriaService AuditoriaSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Detalle de Error | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando error…
    </div>
}
else if (_item is null)
{
    <div class="consultas-error">
        <i class="bi bi-exclamation-triangle"></i> No se encontró el error solicitado.
    </div>
}
else
{
    <div class="gd-page gd gd-legacy">
        <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

        <header class="gd-header">
            <h2>Error #@_item.Id</h2>
            <p>@_item.Proceso · @_item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</p>
        </header>

        <section class="two-grid">
            <article class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Datos principales</h3>
                    </div>
                </div>
                <div class="detail-grid">
                    <div><strong>Fecha</strong><br />@_item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    <div><strong>Proceso</strong><br />@_item.Proceso</div>
                    <div><strong>Usuario</strong><br />@_item.Usuario</div>
                    <div><strong>PC</strong><br />@_item.Pc</div>
                    <div><strong>Código</strong><br />@_item.ErrorCodigo</div>
                </div>
            </article>

            <article class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Descripción</h3>
                    </div>
                </div>
                <div class="auditoria__block">
                    @_item.Descripcion
                </div>
            </article>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Instrucción SQL / detalle técnico</h3>
                    <p class="panel-card__subtitle">Campo `Sql` de `AUX_ERR`, preparado para copiar y pegar.</p>
                </div>
            </div>
            <textarea class="auditoria__textarea" readonly rows="18">@_item.Sql</textarea>
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private AlfaCore.Models.AppUiMessage? _feedback;
    private AuditoriaErrorRowDto? _item;

    private PageHeaderConfig? _pageHeaderPublicado;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "auditoria",
        Title = $"Error #{Id}",
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildAuditoria(RouteContext, Nav, "errores"),
        Actions =
        [
            new PageHeaderAction
            {
                Key = "volver",
                Label = "Volver a errores",
                Icon = "bi-arrow-left",
                Style = PageHeaderActionStyle.Ghost,
                OnClick = () => InvokeAsync(() => Nav.NavigateTo(RouteContext.BuildRoute("/auditoria/errores")))
            }
        ]
    });

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _feedback = null;
        var result = await UiOps.RunAsync(
            () => AuditoriaSvc.GetErrorByIdAsync(Id),
            "No se pudo cargar el detalle del error.");
        _item = result.Value;
        _feedback = result.Feedback;
        _loading = false;
    }

    private static string GetFeedbackClass(AlfaCore.Models.AppUiMessage message)
        => message.Severity switch
        {
            AlfaCore.Models.AppUiFeedbackSeverity.Success => "conversations-inline--ok",
            AlfaCore.Models.AppUiFeedbackSeverity.Warning => "conversations-inline--error",
            AlfaCore.Models.AppUiFeedbackSeverity.Error => "conversations-inline--error",
            _ => "conversations-inline--ok"
        };
}
