@page "/usuarios"
@page "/{idweb}/{idbase:int}/usuarios"
@using AlfaCore.Models
@using AlfaCore.Services
@using Microsoft.AspNetCore.Components.Forms
@inject AlfaCore.Services.IUsuariosService UsuariosSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject IPageHeaderService PageHeader
@implements IDisposable

<PageTitle>Usuarios | Alfa Gestión</PageTitle>

<div class="page-grid usuarios-page" @onclick="CloseUsuariosSearchPanel">

    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </section>
    }

    @if (_showViewSettings && !_showEditor)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Elegí columnas visibles, orden y agrupación para tu grilla de usuarios.</p>
                </div>
            </div>

            <div class="usuarios-view-settings">
                <div class="field">
                    <label>Agrupar por</label>
                    <select @bind="_draftAgruparPor">
                        <option value="@UsuariosViewGroupKeys.None">Sin agrupar</option>
                        <option value="@UsuariosViewGroupKeys.Tipo">Tipo</option>
                        <option value="@UsuariosViewGroupKeys.Activo">Activo</option>
                        <option value="@UsuariosViewGroupKeys.CambiarClave">Clave próximo inicio</option>
                    </select>
                </div>

                <div class="usuarios-view-settings__list">
                    @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="checkbox">
                                <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                <span>@column.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">
                        <i class="bi bi-floppy"></i> Guardar vista
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </div>
        </section>
    }

    @if (_showEditor)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Datos del usuario</h3>
                    <p class="panel-card__subtitle">@(_isNewMode ? "Completá los datos básicos del usuario o grupo." : $"Sistema fijo: CN000PR · Estado: {(_selectedActivo ? "Activo" : "Inactivo")}")</p>
                </div>
            </div>

            <div class="usuarios-editor">
                <div class="usuarios-photo-card">
                    <InputFile id="usuarios-photo-picker"
                               @key="@($"usuarios-photo-{_photoPickerVersion}")"
                               style="display:none"
                               OnChange="HandlePhotoSelectedAsync"
                               accept=".jpg,.jpeg,image/jpeg"
                               disabled="@_saving" />

                    <div class="usuarios-photo-preview">
                        @if (!string.IsNullOrWhiteSpace(CurrentPhotoUrl))
                        {
                            <img src="@CurrentPhotoUrl" alt="Foto del usuario" class="usuarios-photo-preview__img" />
                        }
                        else
                        {
                            <div class="usuarios-photo-preview__empty">
                                <i class="bi bi-person-bounding-box"></i>
                            </div>
                        }
                    </div>

                    <div class="usuarios-photo-actions">
                        <label class="btn btn--secondary interfaces-file-trigger @(_saving ? "is-disabled" : string.Empty)"
                               for="usuarios-photo-picker"
                               aria-disabled="@_saving">
                            <i class="bi bi-image"></i>
                            <span>@(HasExistingOrPendingPhoto ? "Cambiar foto" : "Agregar foto")</span>
                        </label>
                        <button type="button"
                                class="btn btn--ghost"
                                @onclick="QuitarFoto"
                                disabled="@(_saving || !HasExistingOrPendingPhoto)">
                            <i class="bi bi-trash"></i>
                            <span>Quitar</span>
                        </button>
                    </div>
                    @if (HasFieldError("foto"))
                    {
                        <small class="usuarios-field-error">@GetFieldError("foto")</small>
                    }
                    <p class="usuarios-photo-hint">La imagen se guarda como JPG en `RutaImagenes\USUARIOS\&lt;Nombre&gt;.jpg`.</p>
                </div>

                <div class="usuarios-editor__form">
                    <div class="usuarios-editor__grid">
                        <div class="field">
                            <label>Nombre de usuario</label>
                            <input type="text"
                                   class="@GetFieldInputClass("nombre")"
                                   maxlength="50"
                                   @bind="_form.Nombre"
                                   disabled="@_saving" />
                            @if (HasFieldError("nombre"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("nombre")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Email</label>
                            <input type="email"
                                   class="@GetFieldInputClass("email")"
                                   maxlength="150"
                                   @bind="_form.Email"
                                   disabled="@_saving" />
                            @if (HasFieldError("email"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("email")</small>
                            }
                        </div>
                    </div>

                    <div class="usuarios-toggle-row">
                        <label class="checkbox">
                            <input type="checkbox" @bind="_form.EsGrupo" disabled="@_saving" />
                            <span>Usuario de referencia para grupo</span>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" @bind="_form.CambiarProximoInicio" disabled="@(_saving || _form.EsGrupo)" />
                            <span>Cambiar contraseña en el próximo inicio</span>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" @bind="_form.EsTecnico" disabled="@(_saving || _form.EsGrupo)" />
                            <span>Es técnico / agente de soporte</span>
                        </label>
                    </div>
                    <p class="usuarios-photo-hint">Da de alta (o reactiva) automáticamente al usuario en Técnicos, para poder asignarle conversaciones y usar el chat interno.</p>
                    @if (HasFieldError("cambiar-proximo-inicio"))
                    {
                        <small class="usuarios-field-error">@GetFieldError("cambiar-proximo-inicio")</small>
                    }

                    @if (_form.EsGrupo)
                    {
                        <div class="usuarios-empty">
                            Los grupos no usan contraseña en esta primera versión.
                        </div>
                    }
                    else
                    {
                        <div class="usuarios-password-card">
                            <div class="usuarios-password-card__head">
                                <div>
                                    <span class="interfaces-detail__label">Contraseña</span>
                                    <p class="panel-card__subtitle">Compatible con la codificación actual del sistema de escritorio.</p>
                                </div>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="TogglePasswordVisibility">
                                    <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    <span>@(_showPassword ? "Ocultar" : "Mostrar")</span>
                                </button>
                            </div>
                            <div class="usuarios-editor__grid">
                                <div class="field">
                                    <label>Contraseña</label>
                                    <input type="@(_showPassword ? "text" : "password")"
                                           class="@GetFieldInputClass("contrasena")"
                                           maxlength="13"
                                           @bind="_form.Contrasena"
                                           disabled="@_saving" />
                                    @if (HasFieldError("contrasena"))
                                    {
                                        <small class="usuarios-field-error">@GetFieldError("contrasena")</small>
                                    }
                                </div>
                                <div class="field">
                                    <label>Confirmación</label>
                                    <input type="@(_showPassword ? "text" : "password")"
                                           class="@GetFieldInputClass("confirmacion")"
                                           maxlength="13"
                                           @bind="_confirmacionContrasena"
                                           disabled="@_saving" />
                                    @if (HasFieldError("confirmacion"))
                                    {
                                        <small class="usuarios-field-error">@GetFieldError("confirmacion")</small>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (!_isNewMode)
                    {
                        <div class="usuarios-editor__meta">
                            <span>Alta: @FormatDate(_selectedAlta)</span>
                            <span>Modificación: @FormatDate(_selectedModificacion)</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else
    {
        var visibleColumns = GetVisibleColumns();
        var groups = BuildGridGroups();

        <section class="panel-card">
            <div class="panel-card__header panel-card__header--compact"><p class="panel-card__subtitle">@_pagedTotal registro(s) · Página @_pageNumber de @_totalPages · podés abrir la ficha con el botón editar o con doble clic.</p></div>

            @if (_loadingList)
            {
                <div class="usuarios-empty">Cargando usuarios...</div>
            }
            else if (_items.Count == 0)
            {
                <div class="usuarios-empty">No hay usuarios para los filtros seleccionados.</div>
            }
            else
            {
                <div class="usuarios-table-wrap">
                    <table class="data-table usuarios-table" data-sticky-list-header>
                        <thead>
                            <tr>
                                <th class="interfaces-table__selector">
                                    <input type="checkbox"
                                           class="interfaces-table__checkbox"
                                           checked="@AreAllCurrentPageSelected"
                                           @onchange="ToggleSelectAll"
                                           title="Seleccionar todos los usuarios visibles" />
                                </th>
                                @foreach (var column in visibleColumns)
                                {
                                    <th>@column.Label</th>
                                }
                                <th class="interfaces-table__actions">Acciones</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@(visibleColumns.Count + 2)">@group.Label</td>
                                    </tr>
                                }

                                @foreach (var item in group.Items)
                                {
                                    <tr class="@(IsSelected(item) ? "usuarios-table__row is-selected" : "usuarios-table__row")"
                                        @onclick="() => SeleccionarFila(item.Nombre)"
                                        @ondblclick="() => AbrirEditorAsync(item.Nombre)">
                                        <td class="interfaces-table__selector" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   class="interfaces-table__checkbox"
                                                   checked="@_selectedNames.Contains(item.Nombre)"
                                                   @onchange="args => ToggleRowSelection(item.Nombre, args)"
                                                   title="Seleccionar usuario" />
                                        </td>
                                        @foreach (var column in visibleColumns)
                                        {
                                            <td>
                                                @switch (column.Key)
                                                {
                                                    case UsuariosViewColumnKeys.Nombre:
                                                        <div class="usuarios-table__name">
                                                            @if (item.TieneFoto)
                                                            {
                                                                <span class="usuarios-table__avatar usuarios-table__avatar--filled">
                                                                    <i class="bi bi-person-badge"></i>
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="usuarios-table__avatar">
                                                                    <i class="bi bi-person"></i>
                                                                </span>
                                                            }
                                                            <strong>@item.Nombre</strong>
                                                        </div>
                                                        break;
                                                    case UsuariosViewColumnKeys.Email:
                                                        @(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)
                                                        break;
                                                    case UsuariosViewColumnKeys.Tipo:
                                                        @(item.EsGrupo ? "Grupo" : "Usuario")
                                                        break;
                                                    case UsuariosViewColumnKeys.CambiarClave:
                                                        @(item.EsGrupo ? "No aplica" : item.CambiarProximoInicio ? "Sí" : "No")
                                                        break;
                                                    case UsuariosViewColumnKeys.Activo:
                                                        @(item.Activo ? "Sí" : "No")
                                                        break;
                                                    case UsuariosViewColumnKeys.Alta:
                                                        @FormatDate(item.FechaHoraGrabacion)
                                                        break;
                                                    case UsuariosViewColumnKeys.Modificacion:
                                                        @FormatDate(item.FechaHoraModificacion ?? item.FechaHoraGrabacion)
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td class="interfaces-table__actions" @onclick:stopPropagation="true">
                                            <button type="button" class="btn btn--ghost btn--sm interfaces-table__edit" @onclick="() => AbrirEditorAsync(item.Nombre)">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Editar</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>

                <div class="result-pagination">
                    <span class="result-pagination__info">@_pagedTotal registro(s)</span>
                    <div class="result-pagination__controls">
                        <button class="result-pagination__btn" title="Página anterior"
                                @onclick="() => CambiarPaginaAsync(_pageNumber - 1)"
                                disabled="@(!_hasPrev || _loadingList)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="result-pagination__btn result-pagination__btn--active">@_pageNumber / @_totalPages</span>
                        <button class="result-pagination__btn" title="Página siguiente"
                                @onclick="() => CambiarPaginaAsync(_pageNumber + 1)"
                                disabled="@(!_hasNext || _loadingList)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <select class="result-pagination__size" title="Registros por página"
                            value="@_filters.PageSize"
                            @onchange="OnPageSizeChangedAsync"
                            disabled="@_loadingList">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            }
        </section>
    }

    @if (_showBulkDeactivateConfirm)
    {
        <div class="modal-overlay" @onclick="CloseBulkDeactivateConfirm">
            <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="usuarios-bulk-deactivate-title" @onclick:stopPropagation="true">
                <div class="panel-card__header">
                    <div>
                        <h3 id="usuarios-bulk-deactivate-title" class="panel-card__title">Dar de baja usuarios</h3>
                        <p class="panel-card__subtitle">Se darán de baja @_bulkDeactivateConfirmCount usuario(s) o grupo(s) seleccionados.</p>
                    </div>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseBulkDeactivateConfirm" disabled="@_saving" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--danger" @onclick="ConfirmBulkDeactivateAsync" disabled="@_saving">
                        <i class="bi bi-person-dash"></i> @(_saving ? "Procesando..." : "Confirmar baja")
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CloseBulkDeactivateConfirm" disabled="@_saving">
                        Cancelar
                    </button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private readonly UsuariosFilters _filters = new();
    private readonly UsuarioSaveRequest _form = new();
    private readonly List<UsuarioGridItemDto> _items = [];
    private readonly List<UsuarioViewColumnDto> _viewSettingsDraft = [];
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedNames = new(StringComparer.OrdinalIgnoreCase);
    private AppUiMessage? _feedback;
    private PendingUserPhoto? _pendingPhoto;
    private UsuariosViewSettingsDto _viewSettings = BuildDefaultViewSettings();
    private bool _loadingList;
    private bool _saving;
    private bool _isNewMode = true;
    private bool _showEditor;
    private bool _showPassword;
    private bool _selectedActivo = true;
    private bool _showViewSettings;
    private bool _showBulkDeactivateConfirm;
    private bool _showUsuariosSearchPanel;
    private bool _viewSettingsLoaded;
    private int _photoPickerVersion;
    private int _pagedTotal;
    private int _pageNumber = 1;
    private int _totalPages = 1;
    private bool _hasPrev;
    private bool _hasNext;
    private string _selectedNombre = string.Empty;
    private string _confirmacionContrasena = string.Empty;
    private string _activoFiltro = "1";
    private string _grupoFiltro = string.Empty;
    private string _existingPhotoCacheToken = string.Empty;
    private string _draftAgruparPor = UsuariosViewGroupKeys.None;
    private string _viewSettingsUserName = string.Empty;
    private string _bulkAction = BulkActionDeactivate;
    private int _bulkDeactivateConfirmCount;
    private DateTime? _selectedAlta;
    private DateTime? _selectedModificacion;

    private string CurrentPhotoUrl
        => _pendingPhoto?.PreviewUrl
           ?? (HasExistingPhoto
               ? $"/api/usuarios/{Uri.EscapeDataString(_selectedNombre)}/foto?v={Uri.EscapeDataString(_existingPhotoCacheToken)}"
               : string.Empty);

    private bool HasExistingPhoto => !_form.QuitarFoto && !_isNewMode && !string.IsNullOrWhiteSpace(_selectedNombre) && !string.IsNullOrWhiteSpace(_existingPhotoCacheToken);
    private bool HasExistingOrPendingPhoto => _pendingPhoto is not null || HasExistingPhoto;
    private bool AreAllCurrentPageSelected => _items.Count > 0 && _items.All(item => _selectedNames.Contains(item.Nombre));

    private RenderFragment RenderUsuariosSmartSearch() => @<div class="smart-search" @onclick:stopPropagation @onkeydown="HandleApplyKeyDownAsync">
        <div class="smart-search__bar">
            <i class="bi bi-search"></i>
            <input type="search"
                   placeholder="Buscar por nombre o email..."
                   value="@_filters.Texto"
                   @onfocus="OpenUsuariosSearchPanel"
                   @oninput="OnUsuariosSearchInput"
                   @onkeydown="HandleApplyKeyDownAsync" />
            <button type="button" class="smart-search__toggle" @onclick="ToggleUsuariosSearchPanel" aria-label="Mostrar filtros">
                <i class="bi @(_showUsuariosSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        <div class="smart-search__chips" aria-live="polite">
            @foreach (var chip in BuildUsuariosFilterChips())
            {
                <button type="button" class="smart-chip" @onclick="() => RemoveUsuariosChipAsync(chip.Key)">
                    @chip.Label <i class="bi bi-x"></i>
                </button>
            }
        </div>

        @if (_showUsuariosSearchPanel)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CloseUsuariosSearchPanel"></button>
            <div class="smart-search__panel" @onclick:stopPropagation @onkeydown="HandleApplyKeyDownAsync">
                <div class="smart-search__column">
                    <h4><i class="bi bi-funnel-fill"></i> Estado</h4>
                    <button type="button" class="@GetUsuariosSmartOptionClass(_activoFiltro == "1")" @onclick='() => SetUsuariosStatusFilterAsync("1")'>Activos</button>
                    <button type="button" class="@GetUsuariosSmartOptionClass(_activoFiltro == "0")" @onclick='() => SetUsuariosStatusFilterAsync("0")'>Inactivos</button>
                    <button type="button" class="@GetUsuariosSmartOptionClass(string.IsNullOrWhiteSpace(_activoFiltro))" @onclick='() => SetUsuariosStatusFilterAsync("")'>Todos</button>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-people-fill"></i> Tipo</h4>
                    <button type="button" class="@GetUsuariosSmartOptionClass(string.IsNullOrWhiteSpace(_grupoFiltro))" @onclick='() => SetUsuariosTypeFilterAsync("")'>Todos</button>
                    <button type="button" class="@GetUsuariosSmartOptionClass(_grupoFiltro == "0")" @onclick='() => SetUsuariosTypeFilterAsync("0")'>Usuarios</button>
                    <button type="button" class="@GetUsuariosSmartOptionClass(_grupoFiltro == "1")" @onclick='() => SetUsuariosTypeFilterAsync("1")'>Grupos</button>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-lightning-charge-fill"></i> Acciones</h4>
                    <button type="button" class="btn btn--primary btn--sm" @onclick="AplicarFiltrosAsync" disabled="@_loadingList">
                        <i class="bi bi-search"></i> Aplicar
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltros" disabled="@_loadingList">
                        <i class="bi bi-eraser"></i> Limpiar
                    </button>
                </div>
            </div>
        }
    </div>;

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();

        if (_showEditor)
        {
            actions.Add(new PageHeaderAction { Key = "guardar", Label = _saving ? "Guardando..." : "Guardar", Icon = "bi-floppy", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _saving, Busy = _saving, OnClick = GuardarAsync });
            actions.Add(new PageHeaderAction { Key = "cancelar", Label = "Cancelar", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = _saving, OnClick = () => { CerrarEditor(); return Task.CompletedTask; } });
            if (!_isNewMode && _selectedActivo)
                actions.Add(new PageHeaderAction { Key = "baja", Label = "Dar de baja", Icon = "bi-person-dash", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow, Disabled = _saving, OnClick = DarDeBajaAsync });
        }
        else
        {
            if (_selectedNames.Count > 0)
            {
                actions.Add(new PageHeaderAction { Key = "seleccion", Label = $"{_selectedNames.Count} seleccionados", Icon = "bi-check2-square", Style = PageHeaderActionStyle.Ghost, Disabled = true });
                actions.Add(new PageHeaderAction { Key = "accion-masiva", Label = "Dar de baja", Icon = "bi-person-dash", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Essential, Disabled = _loadingList, OnClick = EjecutarAccionSeleccionadaHeaderAsync });
                actions.Add(new PageHeaderAction { Key = "cancelar-seleccion", Label = "Cancelar selección", Icon = "bi-x-lg", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = ClearUsuariosSelectionAsync });
            }
            actions.Add(new PageHeaderAction { Key = "nuevo", Label = "Nuevo usuario", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = () => { BeginNew(); return Task.CompletedTask; } });
            actions.Add(new PageHeaderAction { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Disabled = _loadingList, OnClick = RecargarAsync });
            actions.Add(new PageHeaderAction { Key = "vista", Label = "Configurar vista", Icon = "bi-sliders", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = () => { AbrirConfiguracionVista(); UpdatePageHeader(); return Task.CompletedTask; } });
            actions.Add(new PageHeaderAction { Key = "agrupar", Label = GetGroupingLabel(_viewSettings.AgruparPor), Icon = "bi-collection", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = ToggleUsuariosSearchPanelAsync });
        }

        PageHeader.Set(new PageHeaderConfig
        {
            Title = _showEditor ? (_isNewMode ? "Nuevo usuario" : $"Editar {_form.Nombre}") : "Usuarios",
            Breadcrumb = ["Seguridad", "Usuarios"],
            State = _saving ? PageHeaderState.Loading : _showEditor ? (_isNewMode ? PageHeaderState.Creating : PageHeaderState.Editing) : PageHeaderState.Idle,
            OnBack = _showEditor ? new Func<Task>(() => { CerrarEditor(); return Task.CompletedTask; }) : null,
            Search = _showEditor
                ? null
                : new PageHeaderSearchConfig(),
            SearchContent = _showEditor ? null : RenderUsuariosSmartSearch(),
            Actions = actions
        });
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        AppUserSession.StateChanged += OnAppUserSessionChanged;
        UpdatePageHeader();
