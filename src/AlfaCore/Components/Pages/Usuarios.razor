    private void CloseBulkDeactivateConfirm()
    {
        if (_saving)
            return;

        _showBulkDeactivateConfirm = false;
        _rowDeactivateName = string.Empty;
        _bulkDeactivateConfirmCount = 0;
    }

    private async Task ConfirmBulkDeactivateAsync()
    {
        var isRowAction = !string.IsNullOrWhiteSpace(_rowDeactivateName);
        var nombres = isRowAction
            ? [_rowDeactivateName]
            : _selectedNames.OrderBy(nombre => nombre, StringComparer.OrdinalIgnoreCase).ToArray();
        if (nombres.Length == 0 || _saving)
        {
            _showBulkDeactivateConfirm = false;
            _rowDeactivateName = string.Empty;
            return;
        }

        _saving = true;
        var succeeded = new List<string>();
        var failed = new List<string>();
        try
        {
            foreach (var nombre in nombres)
            {
                try
                {
                    await UsuariosSvc.DeactivateAsync(nombre);
                    succeeded.Add(nombre);
                }
                catch
                {
                    failed.Add(nombre);
                }
            }

            foreach (var nombre in succeeded)
                _selectedNames.Remove(nombre);

            if (succeeded.Contains(_selectedNombre, StringComparer.OrdinalIgnoreCase))
                _selectedNombre = string.Empty;

            if (succeeded.Count > 0 && isRowAction)
            {
                _showEditor = false;
                ClearEditorDirtyState();
            }

            await BuscarAsync();
            SetFeedback(BuildDeactivateFeedback(nombres.Length, succeeded.Count, failed.Count));
        }
        finally
        {
            _saving = false;
            _showBulkDeactivateConfirm = false;
            _rowDeactivateName = string.Empty;
            _bulkDeactivateConfirmCount = 0;
            UpdatePageHeader();
        }
    }

    private async Task HandlePhotoSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
            return;

        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        await using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        var bytes = ms.ToArray();
        _pendingPhoto = new PendingUserPhoto
        {
            NombreArchivo = file.Name,
            MimeType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType,
            Contenido = bytes,
            PreviewUrl = $"data:{(string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType)};base64,{Convert.ToBase64String(bytes)}"
        };

        _form.QuitarFoto = false;
        ClearFieldError("foto");
        _photoPickerVersion++;
        StateHasChanged();
    }

