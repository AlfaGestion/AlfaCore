    private sealed class UsuarioEditorSnapshot
    {
        private readonly string _nombre;
        private readonly string _email;
        private readonly bool _esGrupo;
        private readonly bool _esTecnico;
        private readonly bool _cambiarProximoInicio;
        private readonly string _contrasena;
        private readonly string _confirmacionContrasena;
        private readonly bool _tieneFotoPendiente;
        private readonly bool _quitarFoto;

        public UsuarioEditorSnapshot(
            string nombre,
            string email,
            bool esGrupo,
            bool esTecnico,
            bool cambiarProximoInicio,
            string contrasena,
            string confirmacionContrasena,
            bool tieneFotoPendiente,
            bool quitarFoto)
        {
            _nombre = nombre;
            _email = email;
            _esGrupo = esGrupo;
            _esTecnico = esTecnico;
            _cambiarProximoInicio = cambiarProximoInicio;
            _contrasena = contrasena;
            _confirmacionContrasena = confirmacionContrasena;
            _tieneFotoPendiente = tieneFotoPendiente;
            _quitarFoto = quitarFoto;
        }

        public bool Matches(UsuarioEditorSnapshot other)
            => string.Equals(_nombre, other._nombre, StringComparison.Ordinal)
               && string.Equals(_email, other._email, StringComparison.Ordinal)
               && _esGrupo == other._esGrupo
               && _esTecnico == other._esTecnico
               && _cambiarProximoInicio == other._cambiarProximoInicio
               && string.Equals(_contrasena, other._contrasena, StringComparison.Ordinal)
               && string.Equals(_confirmacionContrasena, other._confirmacionContrasena, StringComparison.Ordinal)
               && _tieneFotoPendiente == other._tieneFotoPendiente
               && _quitarFoto == other._quitarFoto;
    }

