    private string GetDeactivateConfirmationMessage()
        => _bulkDeactivateConfirmCount == 1
            ? "El usuario seleccionado quedará inactivo y no podrá iniciar sesión."
            : $"Se darán de baja {_bulkDeactivateConfirmCount} usuarios o grupos seleccionados.";

    private static string GetUsuarioColumnCssClass(string key)
        => $"usuarios-list-table__col usuarios-list-table__col--{(key ?? string.Empty).Trim().ToLowerInvariant()}";

    private string GetUsuarioRowClass(UsuarioGridItemDto item)
        => string.Join(" ", new[]
        {
            "usuarios-list-table__row",
            IsSelected(item) || _selectedNames.Contains(item.Nombre) ? "is-selected" : null
        }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    private IReadOnlyList<AlfaActionMenuItem> BuildUsuarioActionMenu(UsuarioGridItemDto item)
    {
        var actions = new List<AlfaActionMenuItem>
        {
            new()
            {
                Key = "editar",
                Label = "Editar",
                Icon = "bi bi-pencil-square",
                OnClick = () => AbrirEditorAsync(item.Nombre)
            }
        };

        if (item.Activo)
        {
            actions.Add(new AlfaActionMenuItem
            {
                Key = "dar-de-baja",
                Label = "Dar de baja",
                Icon = "bi bi-person-dash",
                Danger = true,
                SeparatorBefore = true,
                OnClick = () => OpenRowDeactivateConfirmAsync(item.Nombre)
            });
        }

        return actions;
    }

    private Task OpenRowDeactivateConfirmAsync(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre) || _loadingList)
            return Task.CompletedTask;

        _rowDeactivateName = nombre.Trim();
        _bulkDeactivateConfirmCount = 1;
        _showBulkDeactivateConfirm = true;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "—";

