    private Task OpenRowDeactivateConfirmAsync(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre) || _loadingList)
            return Task.CompletedTask;

        _rowDeactivateName = nombre.Trim();
        _bulkDeactivateConfirmCount = 1;
        _showBulkDeactivateConfirm = true;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "—";

    private string GetSelectionSummary()
        => _selectedNames.Count == 0
            ? "Seleccioná uno o más usuarios para ejecutar acciones."
            : $"{_selectedNames.Count} usuario(s) o grupo(s) seleccionado(s).";

    private void ClearFieldErrors()
        => _fieldErrors.Clear();

    private void SetFieldError(string key, string message)
    {
        if (string.IsNullOrWhiteSpace(key) || string.IsNullOrWhiteSpace(message))
            return;

        _fieldErrors[key.Trim()] = message.Trim();
    }

    private void ApplyFieldErrors(ValidationResult validation)
    {
        ClearFieldErrors();
        foreach (var issue in validation.Issues)
        {
            if (!string.IsNullOrWhiteSpace(issue.FieldKey))
                _fieldErrors[issue.FieldKey.Trim()] = issue.Message;
        }

        _editorTab = _fieldErrors.Keys.Any(key => key is "contrasena" or "confirmacion" or "cambiar-proximo-inicio")
            ? "access"
            : "information";
    }

    private bool HasFieldError(string key)
        => !string.IsNullOrWhiteSpace(key) && _fieldErrors.ContainsKey(key.Trim());

    private string GetFieldError(string key)
        => HasFieldError(key) ? _fieldErrors[key.Trim()] : string.Empty;

    private bool IsSelected(UsuarioGridItemDto item)
        => !_isNewMode && string.Equals(_selectedNombre, item.Nombre, StringComparison.OrdinalIgnoreCase);

    private void SetFeedback(AppUiMessage? message)
    {
        _feedback = message;
    }

    private void ClearFeedback()
        => SetFeedback(null);

    private void ClearFieldError(string key)
    {
        if (!string.IsNullOrWhiteSpace(key))
            _fieldErrors.Remove(key.Trim());
    }

    private Task SetConfirmationPassword(string? value)
    {
        _confirmacionContrasena = value ?? string.Empty;
        ClearFieldError("confirmacion");
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SetEditorTab(string? value)
    {
        _editorTab = value is "access" ? "access" : "information";
        return Task.CompletedTask;
    }

    private Task HandleEditorFieldChanged(string property)
    {
        switch (property)
        {
            case nameof(UsuarioSaveRequest.Nombre):
                ClearFieldError("nombre");
                break;
            case nameof(UsuarioSaveRequest.Email):
                ClearFieldError("email");
                break;
            case nameof(UsuarioSaveRequest.Contrasena):
                ClearFieldError("contrasena");
                break;
            case nameof(UsuarioSaveRequest.CambiarProximoInicio):
                ClearFieldError("cambiar-proximo-inicio");
                break;
            case nameof(UsuarioSaveRequest.EsGrupo):
                ClearFieldError("cambiar-proximo-inicio");
                if (_form.EsGrupo)
                {
                    _form.Contrasena = string.Empty;
                    _confirmacionContrasena = string.Empty;
                    _form.CambiarProximoInicio = false;
                    ClearFieldError("contrasena");
                    ClearFieldError("confirmacion");
                }
                break;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool IsEditorDirty
        => _showEditor && _editorInitialState is not null && !_editorInitialState.Matches(CaptureEditorState());

    private UsuarioEditorSnapshot CaptureEditorState()
        => new(
            NormalizeEditorText(_form.Nombre),
            NormalizeEditorText(_form.Email),
            _form.EsGrupo,
            _form.EsTecnico,
            _form.CambiarProximoInicio,
            _form.Contrasena ?? string.Empty,
            _confirmacionContrasena ?? string.Empty,
            _pendingPhoto is not null,
            _form.QuitarFoto);

    private static string NormalizeEditorText(string? value)
        => (value ?? string.Empty).Trim();

    private void ResetEditorDirtyState()
    {
        _editorInitialState = CaptureEditorState();
        _showDiscardEditorConfirm = false;
        _pendingEditorNavigationUri = string.Empty;
        _allowEditorNavigation = false;
    }

    private void ClearEditorDirtyState()
    {
        _editorInitialState = null;
        _showDiscardEditorConfirm = false;
        _pendingEditorNavigationUri = string.Empty;
        _allowEditorNavigation = false;
    }

    private Task RequestCancelEditorAsync()
    {
        if (IsEditorDirty)
        {
            _showDiscardEditorConfirm = true;
            return InvokeAsync(StateHasChanged);
        }

        CloseEditor();
        return Task.CompletedTask;
    }

    private void ContinueEditing()
    {
        _showDiscardEditorConfirm = false;
        _pendingEditorNavigationUri = string.Empty;
        StateHasChanged();
    }

    private Task DiscardEditorChangesAsync()
    {
        _showDiscardEditorConfirm = false;
        if (!string.IsNullOrWhiteSpace(_pendingEditorNavigationUri))
        {
            var target = _pendingEditorNavigationUri;
            ClearEditorDirtyState();
            _allowEditorNavigation = true;
            Nav.NavigateTo(target);
            return Task.CompletedTask;
        }

        CloseEditor();
        return Task.CompletedTask;
    }

    private void ProtectDirtyEditorNavigation(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (_saving)
        {
            context.PreventNavigation();
            return;
        }

        if (_allowEditorNavigation)
        {
            _allowEditorNavigation = false;
            return;
        }

        if (!IsEditorDirty)
            return;

        context.PreventNavigation();
        _pendingEditorNavigationUri = context.TargetLocation;
        _showDiscardEditorConfirm = true;
    }

    private static AppUiMessage BuildDeactivateFeedback(int requested, int succeeded, int failed)
    {
        if (failed == 0)
        {
            return AppUiMessage.Success(
                requested == 1 ? "Usuario dado de baja" : "Usuarios dados de baja",
                requested == 1
                    ? "El usuario quedó inactivo."
                    : $"Se dieron de baja {succeeded} usuarios seleccionados.");
        }

        if (succeeded == 0)
        {
            return new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Error,
                Title = requested == 1 ? "No se pudo dar de baja el usuario" : "No se pudieron dar de baja los usuarios",
                Message = requested == 1
                    ? "La operación no se completó. Podés volver a intentarlo."
                    : $"No se pudo procesar ninguno de los {failed} usuarios seleccionados."
            };
        }

        return new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Warning,
            Title = "Baja parcialmente completada",
            Message = $"Se dieron de baja {succeeded} de {requested} usuarios. {failed} no pudieron procesarse.",
            Suggestion = "Los usuarios que fallaron permanecen seleccionados para que puedas reintentar."
        };
    }

