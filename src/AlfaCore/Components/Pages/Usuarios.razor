            return;

        if (!string.Equals(_bulkAction, BulkActionDeactivate, StringComparison.OrdinalIgnoreCase))
            return;

        _rowDeactivateName = string.Empty;
        _bulkDeactivateConfirmCount = _selectedNames.Count;
        _showBulkDeactivateConfirm = true;
    }

