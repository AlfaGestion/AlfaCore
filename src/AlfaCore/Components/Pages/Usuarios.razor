    private void CloseBulkDeactivateConfirm()
    {
        if (_saving)
            return;

        _showBulkDeactivateConfirm = false;
    }

    private async Task ConfirmBulkDeactivateAsync()
    {
        var nombres = _selectedNames.OrderBy(nombre => nombre, StringComparer.OrdinalIgnoreCase).ToArray();
        if (nombres.Length == 0 || _saving)
        {
            _showBulkDeactivateConfirm = false;
            return;
        }

        _showBulkDeactivateConfirm = false;
        _saving = true;
        try
        {
            foreach (var nombre in nombres)
                await UsuariosSvc.DeactivateAsync(nombre);

            _selectedNames.Clear();
            if (nombres.Contains(_selectedNombre, StringComparer.OrdinalIgnoreCase))
                _selectedNombre = string.Empty;

            _showEditor = false;
            SetFeedback(AppUiMessage.Success("Usuarios actualizados", $"Se dieron de baja {nombres.Length} registro(s) seleccionados."));
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            SetFeedback(UiOps.BuildMessage(ex, "No se pudieron actualizar los usuarios seleccionados."));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandlePhotoSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
            return;

        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        await using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        var bytes = ms.ToArray();
        _pendingPhoto = new PendingUserPhoto
        {
            NombreArchivo = file.Name,
            MimeType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType,
            Contenido = bytes,
            PreviewUrl = $"data:{(string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType)};base64,{Convert.ToBase64String(bytes)}"
        };

        _form.QuitarFoto = false;
        _photoPickerVersion++;
    }

