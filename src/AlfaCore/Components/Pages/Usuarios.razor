    private async Task BuscarAsync()
    {
        _loadingList = true;
        SyncFilters();

        try
        {
            var result = await UiOps.RunAsync(() => UsuariosSvc.SearchAsync(_filters), "No se pudieron cargar los usuarios.");
            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _items.Clear();
            _items.AddRange(result.Value.Items);
            _selectedNames.IntersectWith(_items.Select(item => item.Nombre));
            if (!string.IsNullOrWhiteSpace(_selectedNombre) && !_items.Any(item => string.Equals(item.Nombre, _selectedNombre, StringComparison.OrdinalIgnoreCase)))
                _selectedNombre = string.Empty;
            _pagedTotal  = result.Value.Total;
            _pageNumber  = result.Value.PageNumber;
            _totalPages  = result.Value.TotalPages;
            _hasPrev     = result.Value.HasPrev;
            _hasNext     = result.Value.HasNext;
        }
        finally
        {
            _loadingList = false;
            UpdatePageHeader();
        }
    }

