@page "/conversaciones/estadisticas"
@page "/{idweb}/{idbase:int}/conversaciones/estadisticas"
@inject AlfaCore.Services.IConversacionesService ConversacionesSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.ISessionService SessionSvc
@inject NavigationManager Nav
@implements IDisposable
@using AlfaCore.Models

<PageTitle>Estadísticas de conversaciones | Alfa Gestión</PageTitle>

<div class="est-page">
    <ConversacionesConfigPagina Titulo="Estadísticas" Amplia="true"
                                Descripcion="Volumen, respuestas, cierres, tickets y actividad del equipo en el rango elegido.">
        <Estado>
            @if (_stats is not null)
            {
                <AlfaTag Tone="AlfaTagTone.Neutral">@RangeLabel</AlfaTag>
            }
        </Estado>
        <ChildContent>
            <ConversacionesConfigTarjeta>
                <div class="est-filtros">
                    <AlfaInput Id="stats-desde" Label="Desde" Type="date" Value="@_desdeText" ValueChanged="HandleDesdeChanged" />
                    <AlfaInput Id="stats-hasta" Label="Hasta" Type="date" Value="@_hastaText" ValueChanged="HandleHastaChanged" />
                    <AlfaSelect Id="stats-tecnico" Label="Técnico" Options="TecnicoOptions"
                                Value="@_idTecnico" ValueChanged="@((string? v) => _idTecnico = v ?? string.Empty)" />
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi-funnel" Disabled="@_loading" Loading="@_loading"
                                OnClick="LoadStatsAsync">Aplicar</AlfaButton>
                </div>
                <AlfaTabs Items="RangeItems" ActiveKey="@_activeRange" ActiveKeyChanged="OnRangeChangedAsync" AriaLabel="Rangos rápidos" />
            </ConversacionesConfigTarjeta>

            @if (_error is not null)
            {
                <ConversacionesConfigTarjeta>
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No fue posible cargar las estadísticas" Message="@_error" />
                </ConversacionesConfigTarjeta>
            }
            else if (_loading || _stats is null)
            {
                <ConversacionesConfigTarjeta>
                    <p class="cfg-hint">Cargando estadísticas…</p>
                </ConversacionesConfigTarjeta>
            }
            else
            {
                <section class="est-kpis" aria-label="Indicadores del rango">
                    <a class="est-kpi est-kpi--accent" href="@GetAuditUrl("entrantes")">
                        <span class="est-kpi__label">Mensajes entrantes</span>
                        <strong class="est-kpi__value">@FormatNumber(_stats.MensajesEntrantes)</strong>
                        <span class="est-kpi__detail">@FormatNumber(_stats.ConversacionesConRespuesta) con respuesta</span>
                    </a>
                    <a class="est-kpi" href="@GetAuditUrl("activas")">
                        <span class="est-kpi__label">Conversaciones activas</span>
                        <strong class="est-kpi__value">@FormatNumber(_stats.ConversacionesActivasEnRango)</strong>
                        <span class="est-kpi__detail">@FormatNumber(_stats.ClientesUnicos) clientes/contactos</span>
                    </a>
                    <a class="est-kpi" href="@GetAuditUrl("salientes")">
                        <span class="est-kpi__label">Mensajes enviados</span>
                        <strong class="est-kpi__value">@FormatNumber(_stats.MensajesSalientes)</strong>
                        <span class="est-kpi__detail">@ResponseRateText</span>
                    </a>
                    <a class="est-kpi" href="@GetAuditUrl("cerradas_rango", "cerradas")">
                        <span class="est-kpi__label">Cerradas</span>
                        <strong class="est-kpi__value">@FormatNumber(_stats.ConversacionesCerradasEnRango)</strong>
                        <span class="est-kpi__detail">@FormatDuration(_stats.PromedioCierre) promedio de cierre</span>
                    </a>
                    <a class="est-kpi" href="@GetAuditUrl("tickets")">
                        <span class="est-kpi__label">Tickets creados</span>
                        <strong class="est-kpi__value">@FormatNumber(_stats.TicketsCreados)</strong>
                        <span class="est-kpi__detail">@FormatNumber(_stats.Asignaciones) asignaciones</span>
                    </a>
                    <a class="est-kpi" href="@GetAuditUrl("entrantes")">
                        <span class="est-kpi__label">Primera respuesta</span>
                        <strong class="est-kpi__value">@FormatDuration(_stats.PromedioPrimeraRespuesta)</strong>
                        <span class="est-kpi__detail">@FormatNumber(_stats.ConversacionesSinRespuesta) sin respuesta</span>
                    </a>
                    <a class="est-kpi" href="@GetAuditUrl("adjuntos")">
                        <span class="est-kpi__label">Adjuntos</span>
                        <strong class="est-kpi__value">@FormatNumber(_stats.MensajesConAdjuntos)</strong>
                        <span class="est-kpi__detail">@TotalMessagesText</span>
                    </a>
                    <a class="est-kpi" href="@GetAuditUrl("reabiertas")">
                        <span class="est-kpi__label">Reabiertas</span>
                        <strong class="est-kpi__value">@FormatNumber(_stats.ConversacionesReabiertas)</strong>
                        <span class="est-kpi__detail">@FormatNumber(_stats.CambiosEstado) cambios de estado</span>
                    </a>
                </section>

                <ConversacionesConfigTarjeta Titulo="Clientes que requieren más atención"
                                             Descripcion="Ranking por demanda: pendientes, entrantes, tickets y movimiento real del rango.">
                    @if (_stats.PorCliente.Count == 0)
                    {
                        <AlfaEmptyState Title="Sin movimiento" Message="No hay clientes con movimiento en este rango." />
                    }
                    else
                    {
                        <div class="est-clientes">
                            @foreach (var item in _stats.PorCliente)
                            {
                                <a class="est-cliente @(ReferenceEquals(item, TopCliente) ? "is-top" : null)" href="@GetClientUrl(item)">
                                    <div class="est-cliente__main">
                                        @if (ReferenceEquals(item, TopCliente))
                                        {
                                            <span class="est-eyebrow">Mayor demanda</span>
                                        }
                                        <strong>@DisplayOrFallback(item.ClienteNombre)</strong>
                                        <span class="est-muted">@ClientDemandText(item)</span>
                                        <div class="est-bar"><span style="width:@GetPercent(GetClientDemandScore(item), MaxClientDemandScore)%"></span></div>
                                    </div>
                                    <div class="est-cliente__metrics">
                                        <span><strong>@FormatNumber(item.TotalMensajes)</strong> mensajes</span>
                                        <span><strong>@FormatNumber(item.Conversaciones)</strong> conversaciones</span>
                                        <span><strong>@FormatNumber(item.Entrantes)</strong> entrantes</span>
                                        <span><strong>@FormatNumber(item.Tickets)</strong> tickets</span>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </ConversacionesConfigTarjeta>

                <section class="est-columns">
                    <div class="est-column">
                        <ConversacionesConfigTarjeta Titulo="Estado actual" Descripcion="@($"{FormatNumber(_stats.ConversacionesTotales)} conversaciones en total")">
                            <Extra>
                                <a class="est-pill" href="@RouteContext.BuildRoute("/conversaciones?modo=sin_asignar")">@FormatNumber(_stats.ConversacionesSinAsignar) sin asignar</a>
                            </Extra>
                            <ChildContent>
                                <div class="est-rows">
                                    @foreach (var item in _stats.PorEstado)
                                    {
                                        <a class="est-bar-row" href="@GetStateUrl(item)">
                                            <span class="est-bar-row__label">@DisplayOrFallback(item.Descripcion)</span>
                                            <strong>@FormatNumber(item.Cantidad)</strong>
                                            <div class="est-bar"><span style="width:@GetPercent(item.Cantidad, MaxStateCount)%"></span></div>
                                        </a>
                                    }
                                </div>
                            </ChildContent>
                        </ConversacionesConfigTarjeta>

                        <ConversacionesConfigTarjeta Titulo="Tipos de mensaje" Descripcion="Formato de lo que se movió en el rango.">
                            @if (_stats.PorTipoMensaje.Count == 0)
                            {
                                <p class="cfg-hint">No hay mensajes para clasificar.</p>
                            }
                            else
                            {
                                <div class="est-chips">
                                    @foreach (var item in _stats.PorTipoMensaje)
                                    {
                                        <a class="est-chip" href="@GetMessageTypeUrl(item.Tipo)">
                                            <span>@item.Tipo</span>
                                            <strong>@FormatNumber(item.Cantidad)</strong>
                                        </a>
                                    }
                                </div>
                            }
                        </ConversacionesConfigTarjeta>

                        <ConversacionesConfigTarjeta Titulo="Equipo" Descripcion="Actividad por técnico en el rango.">
                            @if (_stats.PorTecnico.Count == 0)
                            {
                                <p class="cfg-hint">No hay actividad de técnicos en este rango.</p>
                            }
                            else
                            {
                                <div class="est-table-wrap">
                                    <table class="est-table">
                                        <thead>
                                            <tr>
                                                <th>Técnico</th>
                                                <th class="num">Asignadas</th>
                                                <th class="num">Enviados</th>
                                                <th class="num">Cierres</th>
                                                <th class="num">Tickets</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in _stats.PorTecnico)
                                            {
                                                <tr @onclick="() => Nav.NavigateTo(GetTechnicianUrl(item))">
                                                    <td><a href="@GetTechnicianUrl(item)" @onclick:stopPropagation="true">@DisplayOrFallback(item.Nombre)</a></td>
                                                    <td class="num">@FormatNumber(item.ConversacionesAsignadas)</td>
                                                    <td class="num">@FormatNumber(item.MensajesEnviados)</td>
                                                    <td class="num">@FormatNumber(item.Cierres)</td>
                                                    <td class="num">@FormatNumber(item.TicketsCreados)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </ConversacionesConfigTarjeta>

                        <ConversacionesConfigTarjeta Titulo="Palabras frecuentes" Descripcion="Términos que más se repiten en los mensajes entrantes.">
                            @if (_stats.TemasFrecuentes.Count == 0)
                            {
                                <p class="cfg-hint">No hay términos frecuentes para mostrar.</p>
                            }
                            else
                            {
                                <div class="est-chips">
                                    @foreach (var item in _stats.TemasFrecuentes)
                                    {
                                        <a class="est-chip" href="@GetSearchUrl(item.Texto)">
                                            <span>@item.Texto</span>
                                            <strong>@FormatNumber(item.Cantidad)</strong>
                                        </a>
                                    }
                                </div>
                            }
                        </ConversacionesConfigTarjeta>
                    </div>

                    <div class="est-column">
                        <ConversacionesConfigTarjeta Titulo="Flujo del rango" Descripcion="@RangeLabel">
                            <div class="est-flow">
                                <a href="@GetAuditUrl("nuevas")"><span>Nuevas</span><strong>@FormatNumber(_stats.ConversacionesNuevas)</strong></a>
                                <a href="@GetAuditUrl("salientes")"><span>Respondidas</span><strong>@FormatNumber(_stats.ConversacionesConRespuesta)</strong></a>
                                <a href="@GetAuditUrl("entrantes")"><span>Pendientes de respuesta</span><strong>@FormatNumber(_stats.ConversacionesSinRespuesta)</strong></a>
                                <a href="@GetAuditUrl("internos")"><span>Internos</span><strong>@FormatNumber(_stats.MensajesInternos)</strong></a>
                            </div>
                            @if (_stats.Actividad.Count > 0)
                            {
                                <div class="est-rows">
                                    @foreach (var item in _stats.Actividad)
                                    {
                                        <a class="est-line" href="@GetActivityUrl(item.Tipo)">
                                            <span>@item.Tipo</span>
                                            <strong>@FormatNumber(item.Cantidad)</strong>
                                        </a>
                                    }
                                </div>
                            }
                        </ConversacionesConfigTarjeta>

                        <ConversacionesConfigTarjeta Titulo="Conversaciones con más movimiento" Descripcion="Las 8 con más mensajes.">
                            @if (_stats.TopConversaciones.Count == 0)
                            {
                                <p class="cfg-hint">No hay conversaciones con movimiento en este rango.</p>
                            }
                            else
                            {
                                <div class="est-rows">
                                    @foreach (var item in _stats.TopConversaciones)
                                    {
                                        <div class="est-top" role="link" tabindex="0"
                                             @onclick="() => OpenConversation(item.IdConversacion)"
                                             @onkeydown="args => OpenConversationOnKey(args, item.IdConversacion)">
                                            <div class="est-top__main">
                                                <strong>@DisplayOrFallback(item.Nombre)</strong>
                                                <span class="est-muted">
                                                    @DisplayOrFallback(item.Telefono)
                                                    @if (item.IdContacto.HasValue)
                                                    {
                                                        <span> · </span>
                                                        <a href="@GetContactUrl(item.IdContacto.Value)" @onclick:stopPropagation="true">Ver contacto</a>
                                                    }
                                                    <span> · @DisplayOrFallback(item.Tecnico)</span>
                                                </span>
                                            </div>
                                            <div class="est-top__numbers">
                                                <strong>@FormatNumber(item.Total)</strong>
                                                <span class="est-muted">@item.Entrantes entrantes · @item.Salientes enviados</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </ConversacionesConfigTarjeta>

                        <ConversacionesConfigTarjeta Titulo="Frases repetidas" Descripcion="Mensajes entrantes que los clientes repiten.">
                            @if (_stats.FrasesFrecuentes.Count == 0)
                            {
                                <p class="cfg-hint">No hay frases repetidas en este rango.</p>
                            }
                            else
                            {
                                <div class="est-rows">
                                    @foreach (var item in _stats.FrasesFrecuentes)
                                    {
                                        <a class="est-line" href="@GetSearchUrl(item.Texto)">
                                            <span>@item.Texto</span>
                                            <strong>@FormatNumber(item.Cantidad)</strong>
                                        </a>
                                    }
                                </div>
                            }
                        </ConversacionesConfigTarjeta>

                        <ConversacionesConfigTarjeta Titulo="Actividad diaria">
                            <Extra>
                                <span class="est-legend"><i class="is-in"></i>Entrantes</span>
                                <span class="est-legend"><i class="is-out"></i>Enviados</span>
                                <span class="est-legend"><i class="is-close"></i>Cierres y tickets</span>
                            </Extra>
                            <ChildContent>
                                @if (_stats.PorDia.Count == 0)
                                {
                                    <p class="cfg-hint">No hay movimiento diario para mostrar.</p>
                                }
                                else
                                {
                                    <div class="est-rows">
                                        @foreach (var item in _stats.PorDia)
                                        {
                                            <div class="est-day">
                                                <div class="est-day__date">
                                                    <strong>@item.Fecha.ToString("dd/MM")</strong>
                                                    <span class="est-muted">@item.Fecha.ToString("ddd", Es)</span>
                                                </div>
                                                <div class="est-day__bars">
                                                    <span class="is-in" style="width:@GetPercent(item.Entrantes, MaxDailyCount)%"></span>
                                                    <span class="is-out" style="width:@GetPercent(item.Salientes, MaxDailyCount)%"></span>
                                                    <span class="is-close" style="width:@GetPercent(item.Cerradas + item.Tickets, MaxDailyCount)%"></span>
                                                </div>
                                                <div class="est-day__values">
                                                    <span>@item.Entrantes</span>
                                                    <span>@item.Salientes</span>
                                                    <span>@(item.Cerradas + item.Tickets)</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </ChildContent>
                        </ConversacionesConfigTarjeta>
                    </div>
                </section>
            }
        </ChildContent>
    </ConversacionesConfigPagina>
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse, solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header de la página nueva (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private List<ConversacionTecnicoOptionDto> _technicians = [];
    private ConversacionesEstadisticasDto? _stats;
    private bool _loading;
    private string? _error;
    private string _desdeText = DateTime.Today.ToString("yyyy-MM-dd");
    private string _hastaText = DateTime.Today.ToString("yyyy-MM-dd");
    private string _idTecnico = string.Empty;
    private string _activeRange = StatsRange.Today;
    private readonly AlfaCore.Services.ConversationTenantLoadGuard _tenantLoadGuard = new();
    private AlfaCore.Services.ConversationTenantLoadLease _tenantLoadLease;
    private long _statsLoadGeneration;

    private string RangeLabel
        => _stats is null ? string.Empty : $"{_stats.Desde:dd/MM/yyyy} - {_stats.Hasta:dd/MM/yyyy}";

    private string ResponseRateText
    {
        get
        {
            if (_stats is null || _stats.ConversacionesConRespuesta + _stats.ConversacionesSinRespuesta == 0)
                return "Sin entrantes en el rango";

            var total = _stats.ConversacionesConRespuesta + _stats.ConversacionesSinRespuesta;
            var rate = (double)_stats.ConversacionesConRespuesta / total;
            return $"{rate:P0} de conversaciones respondidas";
        }
    }

    private string TotalMessagesText
    {
        get
        {
            var total = (_stats?.MensajesEntrantes ?? 0) + (_stats?.MensajesSalientes ?? 0) + (_stats?.MensajesInternos ?? 0);
            return $"{FormatNumber(total)} mensajes totales";
        }
    }

    private ConversacionesEstadisticaClienteDto? TopCliente => _stats?.PorCliente.FirstOrDefault();
    private int MaxStateCount => Math.Max(1, _stats?.PorEstado.Select(x => x.Cantidad).DefaultIfEmpty(0).Max() ?? 1);
    private int MaxDailyCount => Math.Max(1, _stats?.PorDia.Select(x => Math.Max(Math.Max(x.Entrantes, x.Salientes), x.Cerradas + x.Tickets)).DefaultIfEmpty(0).Max() ?? 1);
    private int MaxClientDemandScore => Math.Max(1, _stats?.PorCliente.Select(GetClientDemandScore).DefaultIfEmpty(0).Max() ?? 1);

    protected override void OnInitialized()
    {
        UpdatePageHeader();
        SessionSvc.SessionChanged += OnTenantContextChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadTenantAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Se reafirma acá (no solo en OnInitializedAsync): si se navega desde otra pantalla
        // AlfaDesign, el Dispose() de esa página anterior -- que hace PageHeader.Clear() -- puede
        // correr DESPUÉS del OnInitializedAsync de esta, pisando el header recién seteado.
        // OnAfterRender corre estrictamente después de ese commit de render, así que volver a
        // setearlo acá gana esa carrera de forma confiable (mismo patrón que Conversaciones.razor).
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        SessionSvc.SessionChanged -= OnTenantContextChanged;
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private async Task LoadTenantAsync()
    {
        var generation = ++_statsLoadGeneration;
        _tenantLoadLease = AlfaCore.Services.ConversationTenantLoadLease.Invalid;
        _technicians = [];
        _stats = null;
        _error = null;
        _loading = true;

        if (!TryCaptureTenantLoad(out var lease))
        {
            _error = "No se pudo abrir la información de esta base.";
            _loading = false;
            return;
        }

        _tenantLoadLease = lease;

        try
        {
            var technicians = await ConversacionesSvc.GetTechniciansAsync(lease.BaseId);
            if (!IsTenantLoadCurrent(lease) || generation != _statsLoadGeneration)
                return;

            _technicians = technicians.ToList();
            await LoadStatsAsync(lease, generation);
        }
        catch (Exception ex)
        {
            if (IsTenantLoadCurrent(lease) && generation == _statsLoadGeneration)
                _error = ex.Message;
        }
        finally
        {
            if (IsTenantLoadCurrent(lease) && generation == _statsLoadGeneration)
                _loading = false;
        }
    }

    private bool TryCaptureTenantLoad(out AlfaCore.Services.ConversationTenantLoadLease lease)
    {
        var routeBaseId = idbase is > 0 ? idbase : null;
        var sessionBaseId = SessionSvc.GetActiveSession()?.BaseId;
        lease = _tenantLoadGuard.Capture(routeBaseId, sessionBaseId);
        return lease.IsValid;
    }

    private bool IsTenantLoadCurrent(AlfaCore.Services.ConversationTenantLoadLease lease)
        => _tenantLoadGuard.IsCurrent(lease, idbase is > 0 ? idbase : null, SessionSvc.GetActiveSession()?.BaseId);

    private void OnTenantContextChanged()
    {
        _tenantLoadGuard.Invalidate();
        _ = InvokeAsync(LoadTenantAsync);
    }

    private void UpdatePageHeader()
    {
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems()
        });
    }

    private IReadOnlyList<PageHeaderTopNavItem> BuildTopNavigationItems()
    {
        // Contactos/Clientes se sacaron a propósito: son páginas con su propio menú superior
        // (Contactos, y Clientes vía CuentasComercialesPage -- compartido con Proveedores), y entrar
        // ahí desde acá pisaba este menú con el suyo, dejando la navegación inconsistente.
        var items = new List<PageHeaderTopNavItem>
        {
            BuildTopNavItem("conversaciones", "Conversaciones", "/conversaciones")
        };

        items.Add(BuildTopNavItem("plantillas", "Plantillas", "/conversaciones/plantillas"));
        items.Add(BuildTopNavItem("configuracion", "Configuración", "/conversaciones/configuracion"));
        items.Add(new() { Key = "estadisticas", Label = "Estadísticas", Url = RouteContext.BuildRoute("/conversaciones/estadisticas"), Active = true });
        items.Add(BuildTopNavItem("informes", "Informes", "/conversaciones/informes"));

        return items;
    }

    private PageHeaderTopNavItem BuildTopNavItem(string key, string label, string route)
    {
        var url = RouteContext.BuildRoute(route);
        return new PageHeaderTopNavItem
        {
            Key = key,
            Label = label,
            Url = url,
            OnClick = () =>
            {
                Nav.NavigateTo(url);
                return Task.CompletedTask;
            }
        };
    }

    private async Task SetRangeAsync(string range)
    {
        var today = DateTime.Today;
        _activeRange = range;
        _hastaText = today.ToString("yyyy-MM-dd");
        _desdeText = range switch
        {
            StatsRange.TwoDays => today.AddDays(-1).ToString("yyyy-MM-dd"),
            StatsRange.Week => today.AddDays(-6).ToString("yyyy-MM-dd"),
            StatsRange.Month => today.AddMonths(-1).AddDays(1).ToString("yyyy-MM-dd"),
            StatsRange.ThreeMonths => today.AddMonths(-3).AddDays(1).ToString("yyyy-MM-dd"),
            StatsRange.Year => today.AddYears(-1).AddDays(1).ToString("yyyy-MM-dd"),
            _ => today.ToString("yyyy-MM-dd")
        };
        await LoadStatsAsync();
    }

    private void HandleDesdeChanged(string? value)
    {
        _activeRange = string.Empty;
        if (!string.IsNullOrWhiteSpace(value))
            _desdeText = value;
    }

    private void HandleHastaChanged(string? value)
    {
        _activeRange = string.Empty;
        if (!string.IsNullOrWhiteSpace(value))
            _hastaText = value;
    }

    private static readonly System.Globalization.CultureInfo Es = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    private static readonly IReadOnlyList<AlfaTabItem> RangeItems =
    [
        new(StatsRange.Today, "Hoy"),
        new(StatsRange.TwoDays, "2 días"),
        new(StatsRange.Week, "7 días"),
        new(StatsRange.Month, "1 mes"),
        new(StatsRange.ThreeMonths, "3 meses"),
        new(StatsRange.Year, "1 año")
    ];

    private IReadOnlyList<AlfaSelectOption> TecnicoOptions
        => [new AlfaSelectOption(string.Empty, "Todos"), .. _technicians.Select(t => new AlfaSelectOption(t.IdTecnico, t.Nombre))];

    private Task OnRangeChangedAsync(string? range)
        => string.IsNullOrWhiteSpace(range) || _loading ? Task.CompletedTask : SetRangeAsync(range);

    private void OpenConversationOnKey(KeyboardEventArgs args, long idConversacion)
    {
        if (args.Key is "Enter" or " ")
            OpenConversation(idConversacion);
    }

    private async Task LoadStatsAsync()
    {
        if (!_tenantLoadLease.IsValid)
        {
            await LoadTenantAsync();
            return;
        }

        await LoadStatsAsync(_tenantLoadLease, ++_statsLoadGeneration);
    }

    private async Task LoadStatsAsync(AlfaCore.Services.ConversationTenantLoadLease lease, long generation)
    {
        _loading = true;
        _error = null;

        try
        {
            var desde = ParseDate(_desdeText, DateTime.Today);
            var hasta = ParseDate(_hastaText, DateTime.Today);
            _stats = await ConversacionesSvc.GetEstadisticasAsync(new ConversacionesEstadisticasFilters
            {
                Desde = desde,
                Hasta = hasta,
                IdTecnico = _idTecnico,
                ExpectedBaseId = lease.BaseId
            });
            if (!IsTenantLoadCurrent(lease) || generation != _statsLoadGeneration)
            {
                _stats = null;
                return;
            }
        }
        catch (Exception ex)
        {
            if (IsTenantLoadCurrent(lease) && generation == _statsLoadGeneration)
                _error = ex.Message;
        }
        finally
        {
            if (IsTenantLoadCurrent(lease) && generation == _statsLoadGeneration)
                _loading = false;
        }
    }

    private static DateTime ParseDate(string? value, DateTime fallback)
        => DateTime.TryParse(value, out var result) ? result.Date : fallback.Date;

    private static double GetPercent(int value, int max)
        => max <= 0 || value <= 0 ? 0 : Math.Clamp((double)value / max * 100, 4, 100);

    private static string GetConversationUrl(long idConversacion)
        => $"/conversaciones?id={idConversacion.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private void OpenConversation(long idConversacion)
        => Nav.NavigateTo(GetConversationUrl(idConversacion));

    private static string GetContactUrl(int idContacto)
        => $"/contactos?editar={idContacto.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private static string GetTechnicianUrl(ConversacionesEstadisticaTecnicoDto tecnico)
        => string.IsNullOrWhiteSpace(tecnico.IdTecnico)
            ? "/conversaciones?modo=sin_asignar"
            : $"/conversaciones?modo=todas&tecnico={Uri.EscapeDataString(tecnico.IdTecnico)}";

    private string GetClientUrl(ConversacionesEstadisticaClienteDto cliente)
    {
        var query = new List<string>
        {
            "modo=todas",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}"
        };

        if (!string.IsNullOrWhiteSpace(cliente.ClienteCodigo))
            query.Add($"cliente={Uri.EscapeDataString(cliente.ClienteCodigo)}");
        else
            query.Add($"buscar={Uri.EscapeDataString(cliente.ClienteNombre)}");

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private static string GetStateUrl(ConversacionesEstadisticaEstadoDto estado)
        => $"/conversaciones?modo=todas&estado={Uri.EscapeDataString(estado.CodigoEstado)}";

    private string GetAuditUrl(string auditoria, string? modo = "todas")
    {
        var query = new List<string>
        {
            $"modo={Uri.EscapeDataString(modo ?? "todas")}",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}",
            $"auditoria={Uri.EscapeDataString(auditoria)}"
        };

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private string GetMessageTypeUrl(string label)
    {
        var query = new List<string>
        {
            "modo=todas",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}",
            "auditoria=tipo_mensaje",
            $"tipoMensaje={Uri.EscapeDataString(GetMessageTypeCode(label))}"
        };

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private string GetActivityUrl(string tipo)
        => tipo.Trim().ToLowerInvariant() switch
        {
            "asignaciones" => GetAuditUrl("asignaciones"),
            "cierres" => GetAuditUrl("cerradas_rango", "cerradas"),
            "cambios de estado" => GetAuditUrl("cambios_estado"),
            "tickets" => GetAuditUrl("tickets"),
            _ => GetAuditUrl("internos")
        };

    private string GetSearchUrl(string text)
    {
        var query = new List<string>
        {
            "modo=todas",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}",
            "auditoria=entrantes",
            $"buscar={Uri.EscapeDataString(text)}"
        };

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private static string GetMessageTypeCode(string label)
        => label.Trim().ToLowerInvariant() switch
        {
            "texto" => "TEXT",
            "imagenes" => "IMAGE",
            "imágenes" => "IMAGE",
            "documentos" => "DOCUMENT",
            "audio" => "AUDIO",
            "videos" => "VIDEO",
            "stickers" => "STICKER",
            "sistema" => "SYSTEM",
            _ => "TEXT"
        };

    private static string FormatNumber(int value)
        => value.ToString("N0");

    private static string FormatDuration(TimeSpan? value)
    {
        if (value is null)
            return "Sin datos";

        if (value.Value.TotalDays >= 1)
            return $"{value.Value.TotalDays:0.0} dias";

        if (value.Value.TotalHours >= 1)
            return $"{value.Value.TotalHours:0.0} h";

        if (value.Value.TotalMinutes >= 1)
            return $"{value.Value.TotalMinutes:0} min";

        return $"{Math.Max(1, value.Value.TotalSeconds):0} seg";
    }

    private static string DisplayOrFallback(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Sin dato" : value.Trim();

    private static int GetClientDemandScore(ConversacionesEstadisticaClienteDto cliente)
        => (cliente.TotalMensajes * 2)
           + (cliente.Conversaciones * 50)
           + (cliente.Entrantes * 2)
           + (cliente.Contactos * 15)
           + (cliente.Tickets * 20)
           + (cliente.PendientesRespuesta * 10)
           + (cliente.Reabiertas * 10);

    private static string ClientDemandText(ConversacionesEstadisticaClienteDto cliente)
        => $"{FormatNumber(cliente.Conversaciones)} conversaciones, {FormatNumber(cliente.Contactos)} contactos, {FormatNumber(cliente.Entrantes)} entrantes, {FormatNumber(cliente.PendientesRespuesta)} pendientes, ultimo {cliente.UltimoMovimiento:dd/MM HH:mm}";

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? string.Empty;

