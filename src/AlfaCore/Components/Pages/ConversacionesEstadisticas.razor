@page "/conversaciones/estadisticas"
@page "/{idweb}/{idbase:int}/conversaciones/estadisticas"
@inject AlfaCore.Services.IConversacionesService ConversacionesSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable
@using AlfaCore.Models

<PageTitle>Estadisticas de conversaciones | Alfa Gestion</PageTitle>

<style>
    .conv-stats-page {
        min-height: 100vh !important;
        height: 100vh !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }

    .conv-stats-page .conv-stats-board {
        display: grid !important;
        grid-template-columns: 1fr !important;
        gap: 1.5rem !important;
        overflow: visible !important;
    }

    .conv-stats-page .conv-stats-summary-panel {
        display: grid !important;
        gap: .9rem !important;
    }

    .conv-stats-page .conv-stats-summary {
        display: grid !important;
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        grid-auto-rows: minmax(148px, auto) !important;
        align-items: stretch !important;
        gap: 1rem !important;
        margin-bottom: .15rem !important;
        width: 100% !important;
    }

    .conv-stats-page .conv-stats-columns {
        display: grid !important;
        grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr) !important;
        gap: .85rem !important;
        align-items: start !important;
        width: 100% !important;
    }

    .conv-stats-page .conv-stats-column {
        display: grid !important;
        gap: .85rem !important;
        align-content: start !important;
        min-width: 0 !important;
    }

    .conv-stats-page .conv-stat-card {
        display: grid !important;
        align-content: start !important;
        gap: .35rem !important;
        min-height: 148px !important;
        height: 100% !important;
        background: #091220 !important;
        border-color: rgba(148, 163, 184, .18) !important;
        box-shadow: 0 14px 32px rgba(2, 6, 23, .32) !important;
    }

    .conv-stats-page .conv-stat-card strong {
        margin: 0 !important;
        line-height: 1.05 !important;
        font-size: clamp(1.35rem, 2.4vw, 2rem) !important;
    }

    .conv-stats-page .conv-stats-client-panel {
        display: grid !important;
        gap: .9rem !important;
        margin-top: .1rem !important;
        background: #08101d !important;
        border-color: rgba(45, 212, 191, .22) !important;
        box-shadow: 0 16px 38px rgba(2, 6, 23, .28) !important;
    }

    .conv-stats-page .conv-stats-client-focus {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) auto !important;
        align-items: center !important;
        gap: 1rem !important;
        padding: 1rem 1rem !important;
        border: 1px solid rgba(45, 212, 191, .22) !important;
        border-radius: 8px !important;
        background: #0d2030 !important;
    }

    .conv-stats-page .conv-stats-client-focus span,
    .conv-stats-page .conv-stats-client-focus small,
    .conv-stats-page .conv-stats-client-row span {
        color: var(--color-muted) !important;
    }

    .conv-stats-page .conv-stats-client-focus strong {
        display: block !important;
        margin-top: .18rem !important;
        color: var(--color-text) !important;
        font-size: 1.08rem !important;
    }

    .conv-stats-page .conv-stats-client-focus__numbers {
        min-width: 96px !important;
        text-align: right !important;
    }

    .conv-stats-page .conv-stats-client-focus__numbers strong {
        font-size: 1.65rem !important;
    }

    .conv-stats-page .conv-stats-client-list {
        display: grid !important;
        gap: .55rem !important;
    }

    .conv-stats-page .conv-stats-client-row {
        display: grid !important;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr) !important;
        align-items: center !important;
        gap: .9rem !important;
        padding: .72rem .8rem !important;
        border: 1px solid rgba(148, 163, 184, .13) !important;
        border-radius: 8px !important;
        background: #0b1320 !important;
    }

    .conv-stats-page .conv-stats-client-row__main {
        display: grid !important;
        min-width: 0 !important;
        gap: .3rem !important;
    }

    .conv-stats-page .conv-stats-client-row__main strong,
    .conv-stats-page .conv-stats-client-row__main > span {
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }

    .conv-stats-page .conv-stats-client-row__main strong {
        color: var(--color-text) !important;
    }

    .conv-stats-page .conv-stats-client-row__main > span {
        font-size: .78rem !important;
    }

    .conv-stats-page .conv-stats-client-row__metrics {
        display: grid !important;
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        gap: .45rem !important;
    }

    .conv-stats-page .conv-stats-client-row__metrics span {
        min-width: 0 !important;
        padding: .45rem .5rem !important;
        border: 1px solid rgba(148, 163, 184, .12) !important;
        border-radius: 8px !important;
        background: #07101c !important;
        font-size: .75rem !important;
    }

    .conv-stats-page .conv-stats-client-row__metrics strong {
        display: block !important;
        color: var(--color-text) !important;
        font-size: .94rem !important;
    }

    @@media (max-width: 1180px) {
        .conv-stats-page .conv-stats-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .conv-stats-page .conv-stats-columns {
            grid-template-columns: 1fr !important;
        }

        .conv-stats-page .conv-stats-client-row {
            grid-template-columns: 1fr !important;
        }
    }

    @@media (max-width: 760px) {
        .conv-stats-page .conv-stats-client-row__metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

    @@media (max-width: 520px) {
        .conv-stats-page .conv-stats-summary {
            grid-template-columns: 1fr !important;
        }

        .conv-stats-page .conv-stats-client-focus,
        .conv-stats-page .conv-stats-client-row__metrics {
            grid-template-columns: 1fr !important;
        }

        .conv-stats-page .conv-stats-client-focus__numbers {
            min-width: 0 !important;
            text-align: left !important;
        }
    }
</style>

<section class="page-grid conv-stats-page templates-page--odoo">
    <div class="page-intro conversations-topbar conv-stats-hero">
        <div>
            <h2 class="page-intro__title">Estadisticas</h2>
            <p class="page-intro__text">Panel rapido para ver volumen, respuestas, cierres, tickets y actividad del equipo.</p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="/conversaciones">
                <i class="bi bi-inbox-fill"></i> Inbox
            </a>
        </div>
    </div>

    <section class="panel-card conv-stats-filters">
        <div class="conv-stats-filter-grid">
            <div class="field">
                <label for="stats-desde">Desde</label>
                <input id="stats-desde" type="date" value="@_desdeText" @onchange="HandleDesdeChanged" />
            </div>
            <div class="field">
                <label for="stats-hasta">Hasta</label>
                <input id="stats-hasta" type="date" value="@_hastaText" @onchange="HandleHastaChanged" />
            </div>
            <div class="field">
                <label for="stats-tecnico">Tecnico</label>
                <select id="stats-tecnico" @bind="_idTecnico">
                    <option value="">Todos</option>
                    @foreach (var tecnico in _technicians)
                    {
                        <option value="@tecnico.IdTecnico">@tecnico.Nombre</option>
                    }
                </select>
            </div>
            <button type="button" class="btn btn--primary" @onclick="LoadStatsAsync" disabled="@_loading">
                <i class="bi bi-funnel"></i> Aplicar
            </button>
        </div>
        <div class="conv-stats-range-tabs" aria-label="Rangos rapidos">
            <button type="button" class="@GetRangeButtonClass(StatsRange.Today)" @onclick="() => SetRangeAsync(StatsRange.Today)" disabled="@_loading">Hoy</button>
            <button type="button" class="@GetRangeButtonClass(StatsRange.TwoDays)" @onclick="() => SetRangeAsync(StatsRange.TwoDays)" disabled="@_loading">2 dias</button>
            <button type="button" class="@GetRangeButtonClass(StatsRange.Week)" @onclick="() => SetRangeAsync(StatsRange.Week)" disabled="@_loading">7 dias</button>
            <button type="button" class="@GetRangeButtonClass(StatsRange.Month)" @onclick="() => SetRangeAsync(StatsRange.Month)" disabled="@_loading">1 mes</button>
            <button type="button" class="@GetRangeButtonClass(StatsRange.ThreeMonths)" @onclick="() => SetRangeAsync(StatsRange.ThreeMonths)" disabled="@_loading">3 meses</button>
            <button type="button" class="@GetRangeButtonClass(StatsRange.Year)" @onclick="() => SetRangeAsync(StatsRange.Year)" disabled="@_loading">1 año</button>
        </div>
    </section>

    @if (_error is not null)
    {
        <div class="panel-card empty-state">
            <span class="empty-state__eyebrow">Estadisticas</span>
            <h3>No fue posible cargar el panel</h3>
            <p>@_error</p>
        </div>
    }
    else if (_loading || _stats is null)
    {
        <div class="panel-card loading">Cargando estadisticas...</div>
    }
    else
    {
        <div class="conv-stats-board">
            <section class="panel-card conv-stats-summary-panel">
                <section class="conv-stats-summary">
                    <a class="conv-stat-card conv-stat-card--primary conv-stats-row-link" href="@GetAuditUrl("entrantes")">
                        <span>Mensajes entrantes</span>
                        <strong>@FormatNumber(_stats.MensajesEntrantes)</strong>
                        <small>@_stats.ConversacionesConRespuesta con respuesta</small>
                    </a>
                    <a class="conv-stat-card conv-stats-row-link" href="@GetAuditUrl("activas")">
                        <span>Conversaciones activas</span>
                        <strong>@FormatNumber(_stats.ConversacionesActivasEnRango)</strong>
                        <small>@FormatNumber(_stats.ClientesUnicos) clientes/contactos</small>
                    </a>
                    <a class="conv-stat-card conv-stats-row-link" href="@GetAuditUrl("salientes")">
                        <span>Mensajes enviados</span>
                        <strong>@FormatNumber(_stats.MensajesSalientes)</strong>
                        <small>@ResponseRateText</small>
                    </a>
                    <a class="conv-stat-card conv-stats-row-link" href="@GetAuditUrl("cerradas_rango", "cerradas")">
                        <span>Cerradas</span>
                        <strong>@FormatNumber(_stats.ConversacionesCerradasEnRango)</strong>
                        <small>@FormatDuration(_stats.PromedioCierre) promedio de cierre</small>
                    </a>
                    <a class="conv-stat-card conv-stats-row-link" href="@GetAuditUrl("tickets")">
                        <span>Tickets creados</span>
                        <strong>@FormatNumber(_stats.TicketsCreados)</strong>
                        <small>@FormatNumber(_stats.Asignaciones) asignaciones</small>
                    </a>
                    <a class="conv-stat-card conv-stats-row-link" href="@GetAuditUrl("entrantes")">
                        <span>Primera respuesta</span>
                        <strong>@FormatDuration(_stats.PromedioPrimeraRespuesta)</strong>
                        <small>@FormatNumber(_stats.ConversacionesSinRespuesta) sin respuesta</small>
                    </a>
                    <a class="conv-stat-card conv-stats-row-link" href="@GetAuditUrl("adjuntos")">
                        <span>Adjuntos</span>
                        <strong>@FormatNumber(_stats.MensajesConAdjuntos)</strong>
                        <small>@TotalMessagesText</small>
                    </a>
                    <a class="conv-stat-card conv-stats-row-link" href="@GetAuditUrl("reabiertas")">
                        <span>Reabiertas</span>
                        <strong>@FormatNumber(_stats.ConversacionesReabiertas)</strong>
                        <small>@FormatNumber(_stats.CambiosEstado) cambios de estado</small>
                    </a>
                </section>
            </section>

            <article class="panel-card conv-stats-panel conv-stats-client-panel">
                <div class="conv-stats-panel__head">
                    <div>
                        <h3 class="panel-card__title">Clientes que requieren mas atencion</h3>
                        <p class="panel-card__subtitle">Ranking por demanda operativa: pendientes, entrantes, tickets y movimiento real del rango.</p>
                    </div>
                </div>

                @if (TopCliente is not null)
                {
                    <a class="conv-stats-client-focus conv-stats-row-link" href="@GetClientUrl(TopCliente)">
                        <div>
                            <span>Mayor demanda actual</span>
                            <strong>@DisplayOrFallback(TopCliente.ClienteNombre)</strong>
                            <small>@ClientDemandText(TopCliente)</small>
                        </div>
                        <div class="conv-stats-client-focus__numbers">
                            <strong>@FormatNumber(TopCliente.TotalMensajes)</strong>
                            <span>mensajes</span>
                        </div>
                    </a>
                }

                <div class="conv-stats-client-list">
                    @foreach (var item in _stats.PorCliente)
                    {
                        <a class="conv-stats-client-row conv-stats-row-link" href="@GetClientUrl(item)">
                            <div class="conv-stats-client-row__main">
                                <strong>@DisplayOrFallback(item.ClienteNombre)</strong>
                                <span>@ClientDemandText(item)</span>
                                <div class="conv-stats-bar">
                                    <span style="width:@GetPercent(GetClientDemandScore(item), MaxClientDemandScore)%"></span>
                                </div>
                            </div>
                            <div class="conv-stats-client-row__metrics">
                                <span><strong>@FormatNumber(item.TotalMensajes)</strong> mensajes</span>
                                <span><strong>@FormatNumber(item.Conversaciones)</strong> conversaciones</span>
                                <span><strong>@FormatNumber(item.Entrantes)</strong> entrantes</span>
                                <span><strong>@FormatNumber(item.Tickets)</strong> tickets</span>
                            </div>
                        </a>
                    }
                    @if (_stats.PorCliente.Count == 0)
                    {
                        <div class="conversations-empty">No hay clientes con movimiento en este rango.</div>
                    }
                </div>
            </article>

            <section class="conv-stats-columns">
                <div class="conv-stats-column">
                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Estado actual</h3>
                                <p class="panel-card__subtitle">@FormatNumber(_stats.ConversacionesTotales) conversaciones totales</p>
                            </div>
                            <a class="conversation-badge conversation-badge--state conv-stats-link" href="/conversaciones?modo=sin_asignar">@FormatNumber(_stats.ConversacionesSinAsignar) sin asignar</a>
                        </div>
                        <div class="conv-stats-state-list">
                            @foreach (var item in _stats.PorEstado)
                            {
                                <a class="conv-stats-bar-row conv-stats-row-link" href="@GetStateUrl(item)">
                                    <div class="conv-stats-bar-row__label">
                                        <span>@DisplayOrFallback(item.Descripcion)</span>
                                        <strong>@FormatNumber(item.Cantidad)</strong>
                                    </div>
                                    <div class="conv-stats-bar">
                                        <span style="width:@GetPercent(item.Cantidad, MaxStateCount)%"></span>
                                    </div>
                                </a>
                            }
                        </div>
                    </article>

                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Tipos de mensaje</h3>
                                <p class="panel-card__subtitle">Formato de lo que se movio en el rango.</p>
                            </div>
                        </div>
                        <div class="conv-stats-chip-grid">
                            @foreach (var item in _stats.PorTipoMensaje)
                            {
                                <a class="conv-stats-metric-chip conv-stats-row-link" href="@GetMessageTypeUrl(item.Tipo)">
                                    <span>@item.Tipo</span>
                                    <strong>@FormatNumber(item.Cantidad)</strong>
                                </a>
                            }
                            @if (_stats.PorTipoMensaje.Count == 0)
                            {
                                <div class="conversations-empty">No hay mensajes para clasificar.</div>
                            }
                        </div>
                    </article>

                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Equipo</h3>
                                <p class="panel-card__subtitle">Actividad por tecnico en el rango seleccionado.</p>
                            </div>
                        </div>
                        <div class="conv-stats-table">
                            <div class="conv-stats-table__head">
                                <span>Tecnico</span>
                                <span>Asignadas</span>
                                <span>Enviados</span>
                                <span>Cierres</span>
                                <span>Tickets</span>
                            </div>
                            @foreach (var item in _stats.PorTecnico)
                            {
                                <a class="conv-stats-table__row conv-stats-row-link" href="@GetTechnicianUrl(item)">
                                    <span>@DisplayOrFallback(item.Nombre)</span>
                                    <strong>@FormatNumber(item.ConversacionesAsignadas)</strong>
                                    <strong>@FormatNumber(item.MensajesEnviados)</strong>
                                    <strong>@FormatNumber(item.Cierres)</strong>
                                    <strong>@FormatNumber(item.TicketsCreados)</strong>
                                </a>
                            }
                            @if (_stats.PorTecnico.Count == 0)
                            {
                                <div class="conversations-empty">No hay actividad de tecnicos para este rango.</div>
                            }
                        </div>
                    </article>

                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Palabras y problemas frecuentes</h3>
                                <p class="panel-card__subtitle">Terminos repetidos en mensajes entrantes.</p>
                            </div>
                        </div>
                        <div class="conv-stats-topic-list">
                            @foreach (var item in _stats.TemasFrecuentes)
                            {
                                <a class="conv-stats-topic conv-stats-row-link" href="@GetSearchUrl(item.Texto)">
                                    <span>@item.Texto</span>
                                    <strong>@FormatNumber(item.Cantidad)</strong>
                                </a>
                            }
                            @if (_stats.TemasFrecuentes.Count == 0)
                            {
                                <div class="conversations-empty">No hay terminos frecuentes para mostrar.</div>
                            }
                        </div>
                    </article>
                </div>

                <div class="conv-stats-column">
                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Flujo del rango</h3>
                                <p class="panel-card__subtitle">@RangeLabel</p>
                            </div>
                        </div>
                        <div class="conv-stats-flow">
                            <a href="@GetAuditUrl("nuevas")">
                                <span>Nuevas</span>
                                <strong>@FormatNumber(_stats.ConversacionesNuevas)</strong>
                            </a>
                            <a href="@GetAuditUrl("salientes")">
                                <span>Respondidas</span>
                                <strong>@FormatNumber(_stats.ConversacionesConRespuesta)</strong>
                            </a>
                            <a href="@GetAuditUrl("entrantes")">
                                <span>Pendientes de respuesta</span>
                                <strong>@FormatNumber(_stats.ConversacionesSinRespuesta)</strong>
                            </a>
                            <a href="@GetAuditUrl("internos")">
                                <span>Internos</span>
                                <strong>@FormatNumber(_stats.MensajesInternos)</strong>
                            </a>
                        </div>
                        <div class="conv-stats-activity-list">
                            @foreach (var item in _stats.Actividad)
                            {
                                <a class="conv-stats-activity-item conv-stats-row-link" href="@GetActivityUrl(item.Tipo)">
                                    <span>@item.Tipo</span>
                                    <strong>@FormatNumber(item.Cantidad)</strong>
                                </a>
                            }
                        </div>
                    </article>

                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Conversaciones con mas movimiento</h3>
                                <p class="panel-card__subtitle">Top 8 por cantidad de mensajes.</p>
                            </div>
                        </div>
                        <div class="conv-stats-top-list">
                            @foreach (var item in _stats.TopConversaciones)
                            {
                                <div class="conv-stats-top-item conv-stats-row-link" role="link" tabindex="0" @onclick="() => OpenConversation(item.IdConversacion)">
                                    <div>
                                        <strong>@DisplayOrFallback(item.Nombre)</strong>
                                        <span>
                                            @DisplayOrFallback(item.Telefono)
                                            @if (item.IdContacto.HasValue)
                                            {
                                                <span> · </span>
                                                <span class="conv-stats-inline-link">
                                                    <a href="@GetContactUrl(item.IdContacto.Value)" @onclick:stopPropagation="true">Ver contacto</a>
                                                </span>
                                            }
                                            <span> · @DisplayOrFallback(item.Tecnico)</span>
                                        </span>
                                    </div>
                                    <div class="conv-stats-top-item__numbers">
                                        <strong>@FormatNumber(item.Total)</strong>
                                        <span>@item.Entrantes in / @item.Salientes out</span>
                                    </div>
                                </div>
                            }
                            @if (_stats.TopConversaciones.Count == 0)
                            {
                                <div class="conversations-empty">No hay conversaciones con movimiento en este rango.</div>
                            }
                        </div>
                    </article>

                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Frases repetidas</h3>
                                <p class="panel-card__subtitle">Mensajes entrantes repetidos por clientes/contactos.</p>
                            </div>
                        </div>
                        <div class="conv-stats-phrase-list">
                            @foreach (var item in _stats.FrasesFrecuentes)
                            {
                                <a class="conv-stats-phrase conv-stats-row-link" href="@GetSearchUrl(item.Texto)">
                                    <span>@item.Texto</span>
                                    <strong>@FormatNumber(item.Cantidad)</strong>
                                </a>
                            }
                            @if (_stats.FrasesFrecuentes.Count == 0)
                            {
                                <div class="conversations-empty">No hay frases repetidas en este rango.</div>
                            }
                        </div>
                    </article>

                    <article class="panel-card conv-stats-panel">
                        <div class="conv-stats-panel__head">
                            <div>
                                <h3 class="panel-card__title">Actividad diaria</h3>
                                <p class="panel-card__subtitle">Entrantes, salientes, cierres y tickets.</p>
                            </div>
                        </div>
                        <div class="conv-stats-days">
                            @foreach (var item in _stats.PorDia)
                            {
                                <div class="conv-stats-day">
                                    <div class="conv-stats-day__date">
                                        <strong>@item.Fecha.ToString("dd/MM")</strong>
                                        <span>@item.Fecha.ToString("ddd")</span>
                                    </div>
                                    <div class="conv-stats-day__bars">
                                        <span class="is-in" style="width:@GetPercent(item.Entrantes, MaxDailyCount)%"></span>
                                        <span class="is-out" style="width:@GetPercent(item.Salientes, MaxDailyCount)%"></span>
                                        <span class="is-close" style="width:@GetPercent(item.Cerradas + item.Tickets, MaxDailyCount)%"></span>
                                    </div>
                                    <div class="conv-stats-day__values">
                                        <span>@item.Entrantes</span>
                                        <span>@item.Salientes</span>
                                        <span>@(item.Cerradas + item.Tickets)</span>
                                    </div>
                                </div>
                            }
                            @if (_stats.PorDia.Count == 0)
                            {
                                <div class="conversations-empty">No hay movimiento diario para mostrar.</div>
                            }
                        </div>
                    </article>
                </div>
            </section>
        </div>
    }
</section>

@code {
    private List<ConversacionTecnicoOptionDto> _technicians = [];
    private ConversacionesEstadisticasDto? _stats;
    private bool _loading;
    private string? _error;
    private string _desdeText = DateTime.Today.ToString("yyyy-MM-dd");
    private string _hastaText = DateTime.Today.ToString("yyyy-MM-dd");
    private string _idTecnico = string.Empty;
    private string _activeRange = StatsRange.Today;

    private string RangeLabel
        => _stats is null ? string.Empty : $"{_stats.Desde:dd/MM/yyyy} - {_stats.Hasta:dd/MM/yyyy}";

    private string ResponseRateText
    {
        get
        {
            if (_stats is null || _stats.ConversacionesConRespuesta + _stats.ConversacionesSinRespuesta == 0)
                return "Sin entrantes en el rango";

            var total = _stats.ConversacionesConRespuesta + _stats.ConversacionesSinRespuesta;
            var rate = (double)_stats.ConversacionesConRespuesta / total;
            return $"{rate:P0} de conversaciones respondidas";
        }
    }

    private string TotalMessagesText
    {
        get
        {
            var total = (_stats?.MensajesEntrantes ?? 0) + (_stats?.MensajesSalientes ?? 0) + (_stats?.MensajesInternos ?? 0);
            return $"{FormatNumber(total)} mensajes totales";
        }
    }

    private ConversacionesEstadisticaClienteDto? TopCliente => _stats?.PorCliente.FirstOrDefault();
    private int MaxStateCount => Math.Max(1, _stats?.PorEstado.Select(x => x.Cantidad).DefaultIfEmpty(0).Max() ?? 1);
    private int MaxDailyCount => Math.Max(1, _stats?.PorDia.Select(x => Math.Max(Math.Max(x.Entrantes, x.Salientes), x.Cerradas + x.Tickets)).DefaultIfEmpty(0).Max() ?? 1);
    private int MaxClientDemandScore => Math.Max(1, _stats?.PorCliente.Select(GetClientDemandScore).DefaultIfEmpty(0).Max() ?? 1);

    protected override async Task OnInitializedAsync()
    {
        UpdatePageHeader();
        _technicians = (await ConversacionesSvc.GetTechniciansAsync()).ToList();
        await LoadStatsAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Se reafirma acá (no solo en OnInitializedAsync): si se navega desde otra pantalla
        // AlfaDesign, el Dispose() de esa página anterior -- que hace PageHeader.Clear() -- puede
        // correr DESPUÉS del OnInitializedAsync de esta, pisando el header recién seteado.
        // OnAfterRender corre estrictamente después de ese commit de render, así que volver a
        // setearlo acá gana esa carrera de forma confiable (mismo patrón que Conversaciones.razor).
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose() => PageHeader.Clear();

    private bool IsDirectMode
        => Uri.TryCreate(Nav.Uri, UriKind.Absolute, out var uri)
           && System.Web.HttpUtility.ParseQueryString(uri.Query)["directo"] == "1";

    private void UpdatePageHeader()
    {
        PageHeader.Set(new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems()
        });
    }

    private IReadOnlyList<PageHeaderTopNavItem> BuildTopNavigationItems()
    {
        var items = new List<PageHeaderTopNavItem>
        {
            BuildTopNavItem("conversaciones", "Conversaciones", "/conversaciones")
        };

        if (!IsDirectMode)
        {
            items.Add(BuildTopNavItem("contactos", "Contactos", "/contactos"));
            items.Add(BuildTopNavItem("clientes", "Clientes", "/clientes"));
        }

        items.Add(BuildTopNavItem("plantillas", "Plantillas", "/conversaciones/plantillas"));
        items.Add(BuildTopNavItem("configuracion", "Configuración", "/conversaciones/configuracion"));
        items.Add(new() { Key = "estadisticas", Label = "Estadísticas", Url = RouteContext.BuildRoute("/conversaciones/estadisticas"), Active = true });
        items.Add(BuildTopNavItem("informes", "Informes", "/conversaciones/informes"));

        return items;
    }

    private PageHeaderTopNavItem BuildTopNavItem(string key, string label, string route)
    {
        var url = RouteContext.BuildRoute(route);
        return new PageHeaderTopNavItem
        {
            Key = key,
            Label = label,
            Url = url,
            OnClick = () =>
            {
                Nav.NavigateTo(url);
                return Task.CompletedTask;
            }
        };
    }

    private async Task SetRangeAsync(string range)
    {
        var today = DateTime.Today;
        _activeRange = range;
        _hastaText = today.ToString("yyyy-MM-dd");
        _desdeText = range switch
        {
            StatsRange.TwoDays => today.AddDays(-1).ToString("yyyy-MM-dd"),
            StatsRange.Week => today.AddDays(-6).ToString("yyyy-MM-dd"),
            StatsRange.Month => today.AddMonths(-1).AddDays(1).ToString("yyyy-MM-dd"),
            StatsRange.ThreeMonths => today.AddMonths(-3).AddDays(1).ToString("yyyy-MM-dd"),
            StatsRange.Year => today.AddYears(-1).AddDays(1).ToString("yyyy-MM-dd"),
            _ => today.ToString("yyyy-MM-dd")
        };
        await LoadStatsAsync();
    }

    private void HandleDesdeChanged(ChangeEventArgs args)
    {
        _activeRange = string.Empty;
        _desdeText = Convert.ToString(args.Value) ?? _desdeText;
    }

    private void HandleHastaChanged(ChangeEventArgs args)
    {
        _activeRange = string.Empty;
        _hastaText = Convert.ToString(args.Value) ?? _hastaText;
    }

    private string GetRangeButtonClass(string range)
        => $"conv-stats-range-tab {(string.Equals(_activeRange, range, StringComparison.Ordinal) ? "is-active" : string.Empty)}";

    private async Task LoadStatsAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var desde = ParseDate(_desdeText, DateTime.Today);
            var hasta = ParseDate(_hastaText, DateTime.Today);
            _stats = await ConversacionesSvc.GetEstadisticasAsync(new ConversacionesEstadisticasFilters
            {
                Desde = desde,
                Hasta = hasta,
                IdTecnico = _idTecnico
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static DateTime ParseDate(string? value, DateTime fallback)
        => DateTime.TryParse(value, out var result) ? result.Date : fallback.Date;

    private static double GetPercent(int value, int max)
        => max <= 0 || value <= 0 ? 0 : Math.Clamp((double)value / max * 100, 4, 100);

    private static string GetConversationUrl(long idConversacion)
        => $"/conversaciones?id={idConversacion.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private void OpenConversation(long idConversacion)
        => Nav.NavigateTo(GetConversationUrl(idConversacion));

    private static string GetContactUrl(int idContacto)
        => $"/contactos?editar={idContacto.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private static string GetTechnicianUrl(ConversacionesEstadisticaTecnicoDto tecnico)
        => string.IsNullOrWhiteSpace(tecnico.IdTecnico)
            ? "/conversaciones?modo=sin_asignar"
            : $"/conversaciones?modo=todas&tecnico={Uri.EscapeDataString(tecnico.IdTecnico)}";

    private string GetClientUrl(ConversacionesEstadisticaClienteDto cliente)
    {
        var query = new List<string>
        {
            "modo=todas",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}"
        };

        if (!string.IsNullOrWhiteSpace(cliente.ClienteCodigo))
            query.Add($"cliente={Uri.EscapeDataString(cliente.ClienteCodigo)}");
        else
            query.Add($"buscar={Uri.EscapeDataString(cliente.ClienteNombre)}");

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private static string GetStateUrl(ConversacionesEstadisticaEstadoDto estado)
        => $"/conversaciones?modo=todas&estado={Uri.EscapeDataString(estado.CodigoEstado)}";

    private string GetAuditUrl(string auditoria, string? modo = "todas")
    {
        var query = new List<string>
        {
            $"modo={Uri.EscapeDataString(modo ?? "todas")}",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}",
            $"auditoria={Uri.EscapeDataString(auditoria)}"
        };

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private string GetMessageTypeUrl(string label)
    {
        var query = new List<string>
        {
            "modo=todas",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}",
            "auditoria=tipo_mensaje",
            $"tipoMensaje={Uri.EscapeDataString(GetMessageTypeCode(label))}"
        };

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private string GetActivityUrl(string tipo)
        => tipo.Trim().ToLowerInvariant() switch
        {
            "asignaciones" => GetAuditUrl("asignaciones"),
            "cierres" => GetAuditUrl("cerradas_rango", "cerradas"),
            "cambios de estado" => GetAuditUrl("cambios_estado"),
            "tickets" => GetAuditUrl("tickets"),
            _ => GetAuditUrl("internos")
        };

    private string GetSearchUrl(string text)
    {
        var query = new List<string>
        {
            "modo=todas",
            $"desde={Uri.EscapeDataString(_desdeText)}",
            $"hasta={Uri.EscapeDataString(_hastaText)}",
            "auditoria=entrantes",
            $"buscar={Uri.EscapeDataString(text)}"
        };

        if (!string.IsNullOrWhiteSpace(_idTecnico))
            query.Add($"tecnico={Uri.EscapeDataString(_idTecnico)}");

        return $"/conversaciones?{string.Join("&", query)}";
    }

    private static string GetMessageTypeCode(string label)
        => label.Trim().ToLowerInvariant() switch
        {
            "texto" => "TEXT",
            "imagenes" => "IMAGE",
            "imágenes" => "IMAGE",
            "documentos" => "DOCUMENT",
            "audio" => "AUDIO",
            "videos" => "VIDEO",
            "stickers" => "STICKER",
            "sistema" => "SYSTEM",
            _ => "TEXT"
        };

    private static string FormatNumber(int value)
        => value.ToString("N0");

    private static string FormatDuration(TimeSpan? value)
    {
        if (value is null)
            return "Sin datos";

        if (value.Value.TotalDays >= 1)
            return $"{value.Value.TotalDays:0.0} dias";

        if (value.Value.TotalHours >= 1)
            return $"{value.Value.TotalHours:0.0} h";

        if (value.Value.TotalMinutes >= 1)
            return $"{value.Value.TotalMinutes:0} min";

        return $"{Math.Max(1, value.Value.TotalSeconds):0} seg";
    }

    private static string DisplayOrFallback(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Sin dato" : value.Trim();

    private static int GetClientDemandScore(ConversacionesEstadisticaClienteDto cliente)
        => (cliente.TotalMensajes * 2)
           + (cliente.Conversaciones * 50)
           + (cliente.Entrantes * 2)
           + (cliente.Contactos * 15)
           + (cliente.Tickets * 20)
           + (cliente.PendientesRespuesta * 10)
           + (cliente.Reabiertas * 10);

    private static string ClientDemandText(ConversacionesEstadisticaClienteDto cliente)
        => $"{FormatNumber(cliente.Conversaciones)} conversaciones, {FormatNumber(cliente.Contactos)} contactos, {FormatNumber(cliente.Entrantes)} entrantes, {FormatNumber(cliente.PendientesRespuesta)} pendientes, ultimo {cliente.UltimoMovimiento:dd/MM HH:mm}";

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? string.Empty;

    private static class StatsRange
    {
        public const string Today = "today";
        public const string TwoDays = "two-days";
        public const string Week = "week";
        public const string Month = "month";
        public const string ThreeMonths = "three-months";
        public const string Year = "year";
    }
}
