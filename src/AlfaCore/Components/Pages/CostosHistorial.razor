@page "/costos/historial"
@page "/{idweb}/{idbase:int}/costos/historial"
@inject AlfaCore.Services.ICostosService CostosSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Historial de Costos | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando historial…
    </div>
}
else
{
    <div class="gd-page gd gd-legacy">
        <header class="gd-header">
            <h2>Historial de Actualizaciones</h2>
            <p>Registros tomados desde `IA_Costos_Actualizacion_Hist`.</p>
        </header>

        <section class="panel-card">
            <div class="table-wrap">
                <table class="data-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Proveedor</th>
                            <th>Fila</th>
                            <th>Artículo</th>
                            <th>Descripción</th>
                            <th>Anterior</th>
                            <th>Nuevo</th>
                            <th>Match</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td>@item.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.UserName</td>
                                <td>@item.ProviderName</td>
                                <td>@item.RowNumber</td>
                                <td>@item.ArticleId</td>
                                <td>@item.ImportedDescription</td>
                                <td>@(item.PreviousCost?.ToString("N2") ?? "—")</td>
                                <td>@(item.NewCost?.ToString("N2") ?? "—")</td>
                                <td>@item.MatchType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private IReadOnlyList<AlfaCore.Models.CostosHistoryDto> _items = [];

    private PageHeaderConfig? _pageHeaderPublicado;
    private string _headerSnapshot = string.Empty;

    // Estado que muestra la barra superior (acciones habilitadas, buscador): si cambia, se
    // republica el header después del render de la página.
    private string HeaderSnapshot() => string.Empty;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || HeaderSnapshot() != _headerSnapshot)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader()
    {
        _headerSnapshot = HeaderSnapshot();
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "costos",
            Title = "Historial de actualizaciones",
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCostos(RouteContext, Nav, "historial"),
        });
    }

    protected override async Task OnInitializedAsync()
    {
        _items = await CostosSvc.GetRecentHistoryAsync(200);
        _loading = false;
    }
}
