@page "/shell/{ModuleKey}"
@page "/{idweb}/{idbase:int}/shell/{ModuleKey}"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@inject AlfaCore.Services.IWorkspaceService WorkspaceSvc
@inject AlfaCore.Services.IRecentService RecentSvc
@inject AlfaCore.Services.IFavoritesService FavoritesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Workspace | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando aplicaciones del módulo...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="panel-card empty-state">
        <span class="empty-state__eyebrow">Shell</span>
        <h1>No se pudo cargar el módulo</h1>
        <p>@_error</p>
    </div>
}
else
{
    <div class="page-grid">
        <section class="page-intro">
            <div>
                <h2 class="page-intro__title">@(_workspace.Module?.Nombre ?? "Módulo")</h2>
            </div>
        </section>

        @if (_workspace.Sections.Count == 0)
        {
            <section class="panel-card">
                <p class="page-intro__text">Todavía no hay aplicaciones web mapeadas para este módulo en `ALFACORE_MENU_WEB`.</p>
            </section>
        }
        else
        {
            @foreach (var workspaceSection in _workspace.Sections)
            {
                <section class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">@workspaceSection.Nombre</h3>
                        </div>
                    </div>
                    <div class="launcher__grid">
                        @foreach (var item in workspaceSection.Items)
                        {
                        <article class="app-card app-card--button" role="button" tabindex="0" @onclick="() => OpenNodeAsync(item)" @onkeydown="args => HandleNodeCardKeyDownAsync(args, item)">
                            <button type="button"
                                    class="@GetFavoriteButtonClass(item.Clave)"
                                    style="@GetFavoriteButtonStyle(item.Clave)"
                                    title="@(IsFavorite(item.Clave) ? "Quitar de favoritos" : "Agregar a favoritos")"
                                    aria-label="@(IsFavorite(item.Clave) ? $"Quitar {item.Nombre} de favoritos" : $"Agregar {item.Nombre} a favoritos")"
                                    @onclick="() => ToggleFavoriteAsync(item.Menu, item.Clave)"
                                    @onclick:stopPropagation>
                                <i class="bi @(IsFavorite(item.Clave) ? "bi-star-fill" : "bi-star")"></i>
                                </button>
                                <div class="app-card__icon @ShellNavigationUiHelper.GetNodeIconClass(item)">
                                    <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-box-arrow-up-right" : item.Icono)"></i>
                                </div>
                                <span class="app-card__name">@item.Nombre</span>
                            </article>
                        }
                    </div>
                </section>
            }
        }
    </div>
}

@code {
    [Parameter] public string ModuleKey { get; set; } = string.Empty;

    private bool _loading = true;
    private ShellWorkspaceDto _workspace = new();
    private string _error = string.Empty;
    private bool _interactiveReady;
    private bool _disposed;
    private int _loadVersion;

    protected override void OnInitialized()
    {
        SessionSvc.SessionChanged += OnContextChanged;
        AppUserSession.StateChanged += OnContextChanged;

        if (WorkspaceSvc.TryGetCachedModuleWorkspace(ModuleKey, out var cachedWorkspace))
        {
            _workspace = cachedWorkspace;
            _loading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_interactiveReady)
            return;

        await LoadWorkspaceAsync(showLoader: !TryUseCachedWorkspace());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _interactiveReady = true;
        await Task.Yield();
        var hasCachedWorkspace = TryUseCachedWorkspace();
        await LoadWorkspaceAsync(showLoader: !hasCachedWorkspace);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenNodeAsync(ShellMenuNodeDto item)
    {
        await RecentSvc.RegisterRecentAsync(item.Menu, item.Clave);
        Nav.NavigateTo(RouteContext.BuildRoute(item.RutaWeb));
    }

    private async Task HandleNodeCardKeyDownAsync(KeyboardEventArgs args, ShellMenuNodeDto item)
    {
        if (IsActivationKey(args.Key))
            await OpenNodeAsync(item);
    }

    private bool IsFavorite(string clave)
    {
        return _workspace.Favorites.Any(item => string.Equals(item.Clave, clave, StringComparison.OrdinalIgnoreCase));
    }

    private string GetFavoriteButtonClass(string clave)
    {
        return IsFavorite(clave) ? "app-card__favorite is-active" : "app-card__favorite";
    }

    private string GetFavoriteButtonStyle(string clave)
        => IsFavorite(clave)
            ? "appearance:none;-webkit-appearance:none;width:2.1rem;height:2.1rem;padding:0;border-radius:999px;background:rgba(251,191,36,.14);border:1px solid rgba(251,191,36,.48);color:#fbbf24;box-shadow:none;"
            : "appearance:none;-webkit-appearance:none;width:2.1rem;height:2.1rem;padding:0;border-radius:999px;background:rgba(15,23,42,.45);border:1px solid rgba(148,163,184,.18);color:rgba(226,232,240,.72);box-shadow:none;";

    private async Task ToggleFavoriteAsync(string menu, string clave)
    {
        await FavoritesSvc.ToggleFavoriteAsync(menu, clave);
        WorkspaceSvc.InvalidateWorkspaceCache();
        _workspace = await WorkspaceSvc.RefreshModuleWorkspaceAsync(ModuleKey);
    }

    private static bool IsActivationKey(string? key)
    {
        return string.Equals(key, "Enter", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, " ", StringComparison.Ordinal)
            || string.Equals(key, "Space", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, "Spacebar", StringComparison.OrdinalIgnoreCase);
    }

    private async void OnContextChanged()
    {
        if (_disposed || !_interactiveReady)
            return;

        await InvokeAsync(async () =>
        {
            await LoadWorkspaceAsync(showLoader: !TryUseCachedWorkspace());
            StateHasChanged();
        });
    }

    private bool TryUseCachedWorkspace()
    {
        if (!WorkspaceSvc.TryGetCachedModuleWorkspace(ModuleKey, out var cachedWorkspace))
            return false;

        _workspace = cachedWorkspace;
        _loading = false;
        _error = string.Empty;
        return true;
    }

    private async Task LoadWorkspaceAsync(bool showLoader = true)
    {
        var version = Interlocked.Increment(ref _loadVersion);
        var hadVisibleWorkspace = HasVisibleWorkspace();
        if (showLoader || !hadVisibleWorkspace)
        {
            _loading = true;
            _error = string.Empty;
            StateHasChanged();
        }

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var workspace = showLoader || !hadVisibleWorkspace
                ? await WorkspaceSvc.GetModuleWorkspaceAsync(ModuleKey, cts.Token)
                : await WorkspaceSvc.RefreshModuleWorkspaceAsync(ModuleKey, cts.Token);
            if (version != _loadVersion)
                return;

            _workspace = workspace;
            _error = string.Empty;
        }
        catch (OperationCanceledException)
        {
            if (!showLoader && hadVisibleWorkspace)
                return;

            if (version == _loadVersion)
                _error = "La carga del módulo demoró demasiado. Revisá la base activa o intentá nuevamente.";
        }
        catch
        {
            if (!showLoader && hadVisibleWorkspace)
                return;

            if (version == _loadVersion)
                _error = "No se pudo cargar el módulo seleccionado.";
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    private bool HasVisibleWorkspace()
        => _workspace.Module is not null || _workspace.Sections.Count > 0 || _workspace.Favorites.Count > 0 || _workspace.Recents.Count > 0;

    public void Dispose()
    {
        _disposed = true;
        SessionSvc.SessionChanged -= OnContextChanged;
        AppUserSession.StateChanged -= OnContextChanged;
    }
}
