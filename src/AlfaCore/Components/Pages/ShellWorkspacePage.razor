@page "/shell/{ModuleKey}"
@page "/{idweb}/{idbase:int}/shell/{ModuleKey}"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@inject AlfaCore.Services.IWorkspaceService WorkspaceSvc
@inject AlfaCore.Services.IRecentService RecentSvc
@inject AlfaCore.Services.IFavoritesService FavoritesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Workspace | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando aplicaciones del módulo...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="panel-card empty-state">
        <span class="empty-state__eyebrow">Shell</span>
        <h1>No se pudo cargar el módulo</h1>
        <p>@_error</p>
    </div>
}
else
{
    <div class="alfa-home alfa-home--workspace">
        <header class="alfa-home__ws-head">
            <a class="alfa-home__ws-back" href="@RouteContext.BuildRoute("/")"><i class="bi bi-arrow-left" aria-hidden="true"></i> Inicio</a>
            <h1 class="alfa-home__ws-title">
                @if (!string.IsNullOrWhiteSpace(_workspace.Module?.Icono))
                {
                    <span class="alfa-home__module-icon"><i class="bi @_workspace.Module!.Icono" aria-hidden="true"></i></span>
                }
                @(_workspace.Module?.Nombre ?? "Módulo")
            </h1>
        </header>

        @if (_workspace.Sections.Count == 0)
        {
            <AlfaEmptyState Title="Sin aplicaciones web" Message="Todavía no hay aplicaciones web habilitadas para este módulo." />
        }
        else
        {
            <div class="alfa-home__ws-sections">
            @foreach (var workspaceSection in _workspace.Sections.Where(x => x.Items.Count > 0))
            {
                <section class="alfa-home__section">
                    <h2 class="alfa-home__section-title">@workspaceSection.Nombre</h2>
                    <div class="alfa-home__modules">
                        @foreach (var item in workspaceSection.Items)
                        {
                            var favorito = IsFavorite(item.Clave);
                            <div class="alfa-home__module-wrap">
                                <button type="button" class="alfa-home__module" title="@ShellNavigationUiHelper.GetNodeDescription(item)" @onclick="() => OpenNodeAsync(item)">
                                    <span class="alfa-home__module-icon"><i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-box-arrow-up-right" : item.Icono)" aria-hidden="true"></i></span>
                                    <span class="alfa-home__module-name">@item.Nombre</span>
                                </button>
                                <button type="button"
                                        class="alfa-home__star alfa-home__tile-star @(favorito ? "is-active" : null)"
                                        title="@(favorito ? "Quitar de favoritos" : "Agregar a favoritos")"
                                        aria-label="@(favorito ? $"Quitar {item.Nombre} de favoritos" : $"Agregar {item.Nombre} a favoritos")"
                                        @onclick="() => ToggleFavoriteAsync(item.Menu, item.Clave)">
                                    <i class="bi @(favorito ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                    </div>
                </section>
            }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string ModuleKey { get; set; } = string.Empty;

    private bool _loading = true;
    private ShellWorkspaceDto _workspace = new();
    private string _error = string.Empty;
    private bool _interactiveReady;
    private bool _disposed;
    private int _loadVersion;

    protected override void OnInitialized()
    {
        SessionSvc.SessionChanged += OnContextChanged;
        AppUserSession.StateChanged += OnContextChanged;

        if (CanUseActiveSessionForRoute() && WorkspaceSvc.TryGetCachedModuleWorkspace(ModuleKey, out var cachedWorkspace))
        {
            _workspace = cachedWorkspace;
            _loading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_interactiveReady)
            return;

        await LoadWorkspaceAsync(showLoader: !TryUseCachedWorkspace());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _interactiveReady = true;
        await Task.Yield();
        var hasCachedWorkspace = TryUseCachedWorkspace();
        await LoadWorkspaceAsync(showLoader: !hasCachedWorkspace);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenNodeAsync(ShellMenuNodeDto item)
    {
        await RecentSvc.RegisterRecentAsync(item.Menu, item.Clave);
        Nav.NavigateTo(RouteContext.BuildRoute(item.RutaWeb));
    }

    private bool IsFavorite(string clave)
    {
        return _workspace.Favorites.Any(item => string.Equals(item.Clave, clave, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ToggleFavoriteAsync(string menu, string clave)
    {
        await FavoritesSvc.ToggleFavoriteAsync(menu, clave);
        WorkspaceSvc.InvalidateWorkspaceCache();
        _workspace = await WorkspaceSvc.RefreshModuleWorkspaceAsync(ModuleKey);
    }

    private async void OnContextChanged()
    {
        if (_disposed || !_interactiveReady)
            return;

        await InvokeAsync(async () =>
        {
            await LoadWorkspaceAsync(showLoader: !TryUseCachedWorkspace());
            StateHasChanged();
        });
    }

    private bool TryUseCachedWorkspace()
    {
        if (!CanUseActiveSessionForRoute() || !WorkspaceSvc.TryGetCachedModuleWorkspace(ModuleKey, out var cachedWorkspace))
            return false;

        _workspace = cachedWorkspace;
        _loading = false;
        _error = string.Empty;
        return true;
    }

    private async Task LoadWorkspaceAsync(bool showLoader = true)
    {
        var version = Interlocked.Increment(ref _loadVersion);
        var hadVisibleWorkspace = HasVisibleWorkspace();
        if (showLoader || !hadVisibleWorkspace)
        {
            _loading = true;
            _error = string.Empty;
            StateHasChanged();
        }

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var workspace = showLoader || !hadVisibleWorkspace
                ? await WorkspaceSvc.GetModuleWorkspaceAsync(ModuleKey, cts.Token)
                : await WorkspaceSvc.RefreshModuleWorkspaceAsync(ModuleKey, cts.Token);
            if (version != _loadVersion)
                return;
            if (!CanUseActiveSessionForRoute())
                return;

            _workspace = workspace;
            _error = string.Empty;
        }
        catch (OperationCanceledException)
        {
            if (!showLoader && hadVisibleWorkspace)
                return;

            if (version == _loadVersion)
                _error = "La carga del módulo demoró demasiado. Revisá la base activa o intentá nuevamente.";
        }
        catch
        {
            if (!showLoader && hadVisibleWorkspace)
                return;

            if (version == _loadVersion)
                _error = "No se pudo cargar el módulo seleccionado.";
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    private bool HasVisibleWorkspace()
        => _workspace.Module is not null || _workspace.Sections.Count > 0 || _workspace.Favorites.Count > 0 || _workspace.Recents.Count > 0;

    private bool CanUseActiveSessionForRoute()
        => idbase is not > 0 || SessionSvc.GetActiveSession()?.BaseId == idbase.Value;

    public void Dispose()
    {
        _disposed = true;
        SessionSvc.SessionChanged -= OnContextChanged;
        AppUserSession.StateChanged -= OnContextChanged;
    }
}
