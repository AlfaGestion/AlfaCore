@page "/login"
@layout AlfaCore.Components.Layout.PublicLayout
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.ILegacyBaseUserSessionService LegacyBaseUserSession
@inject AlfaCore.Services.IAppModeService AppMode
@inject ILogger<Login> Logger
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using AlfaCore.Components.Shared
@implements IAsyncDisposable

<PageTitle>Login | AlfaCore</PageTitle>

<div class="auth-page">
    <LoginShell RootClass="@LoginShellClass">
        <HeroContent>
            <div class="auth-hero__brand">
                <img class="central-brand-logo central-login-logo"
                     src="@LogoPrincipal"
                     alt="AlfaCore"
                     loading="eager"
                     decoding="async" />
            </div>

            @if (AppMode.IsSaaSMode)
            {
                <div class="auth-hero__copy">
                    <h2 class="auth-hero__title">Bienvenido a Alfa Net</h2>
                    <p class="auth-hero__text">Ingresá a tu cuenta para acceder a tus empresas y bases disponibles.</p>
                </div>

                <div class="auth-hero__summary">
                    <article class="auth-hero__summary-card auth-hero__summary-card--accent">
                        <span class="auth-hero__summary-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                        <span class="auth-hero__summary-label">Cuenta segura</span>
                        <strong>Protegemos tus datos</strong>
                        <small>Tu ingreso se valida contra la cuenta AlfaCore.</small>
                    </article>
                    <article class="auth-hero__summary-card">
                        <span class="auth-hero__summary-icon" aria-hidden="true"><i class="bi bi-display"></i></span>
                        <span class="auth-hero__summary-label">Acceso web</span>
                        <strong>Desde cualquier dispositivo</strong>
                        <small>Entrá desde escritorio, tablet o móvil con la misma experiencia.</small>
                    </article>
                    <article class="auth-hero__summary-card auth-hero__summary-card--status">
                        <span class="auth-hero__summary-icon" aria-hidden="true"><i class="bi bi-building"></i></span>
                        <span class="auth-hero__summary-label">Empresas disponibles</span>
                        <strong class="auth-hero__status">
                            <span class="auth-hero__status-dot" aria-hidden="true"></span>
                            <span>Se muestran después del ingreso</span>
                        </strong>
                        <small>Al autenticarte vas a ver las bases habilitadas para tu cuenta.</small>
                    </article>
                </div>

                <div class="auth-hero__note">Ingresá con tus credenciales de Alfa Net para continuar.</div>
            }
            else
            {
                <div class="auth-hero__copy">
                    <h2 class="auth-hero__title">Bienvenido a Alfa Gestión</h2>
                    <p class="auth-hero__text">Ingresá con tu usuario y contraseña para acceder a la empresa seleccionada.</p>
                </div>

                <div class="auth-hero__summary">
                    <article class="auth-hero__summary-card auth-hero__summary-card--accent">
                        <span class="auth-hero__summary-label">Entorno</span>
                        <strong>Acceso local</strong>
                        <small>La base activa define el sistema disponible.</small>
                    </article>
                    <article class="auth-hero__summary-card">
                        <span class="auth-hero__summary-label">Empresa/Base activa</span>
                        <strong>@GetSelectedBaseName()</strong>
                        <small>Validación con credenciales de la base elegida.</small>
                    </article>
                    <article class="auth-hero__summary-card auth-hero__summary-card--status">
                        <span class="auth-hero__summary-label">Estado</span>
                        <strong class="auth-hero__status">
                            <span class="auth-hero__status-dot" aria-hidden="true"></span>
                            <span>@GetLoginStatusLabel()</span>
                        </strong>
                        <small>Listo para ingresar.</small>
                    </article>
                </div>

                <div class="auth-hero__system">
                    <div class="auth-hero__system-head">
                        <span class="auth-hero__summary-label">Sistema</span>
                        <strong>Información disponible</strong>
                    </div>
                    <div class="auth-hero__system-grid">
                        <article class="auth-hero__system-card">
                            <span>Base seleccionada</span>
                            <strong>@GetSelectedBaseLabel()</strong>
                        </article>
                        <article class="auth-hero__system-card">
                            <span>Modo</span>
                            <strong>Local</strong>
                        </article>
                        <article class="auth-hero__system-card">
                            <span>Versión</span>
                            <strong>@GetAppVersionLabel()</strong>
                        </article>
                        <article class="auth-hero__system-card">
                            <span>Conexión</span>
                            <strong>@GetConnectionContextLabel()</strong>
                        </article>
                    </div>
                </div>

                <div class="auth-hero__note">El acceso queda vinculado a la base activa.</div>
            }
        </HeroContent>

        <FormContent>
            <div class="auth-form-panel__glow auth-form-panel__glow--one" aria-hidden="true"></div>
            <div class="auth-form-panel__glow auth-form-panel__glow--two" aria-hidden="true"></div>

            <div class="auth-form-panel__surface auth-form-panel__surface--legacy-bases">
                @if (AppMode.IsSaaSMode)
                {
                    <div class="auth-saas-login">
                        <div class="auth-mobile-brand auth-mobile-brand--saas" aria-hidden="true">
                            <img class="central-brand-logo central-login-logo"
                                 src="@LogoPrincipal"
                                 alt="AlfaCore"
                                 loading="eager"
                                 decoding="async" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <div class="editor-msg editor-msg--error auth-card__error">
                                <strong>Ingreso rechazado</strong>
                                <p>@_error</p>
                            </div>
                        }

                        <div class="auth-saas-login__header">
                            <span class="auth-saas-login__header-icon" aria-hidden="true">
                                <i class="bi bi-lock"></i>
                            </span>
                            <div class="auth-saas-login__header-copy">
                                <h1 class="auth-card__title">Ingresar a tu cuenta</h1>
                                <p class="auth-card__subtitle">Usá tus credenciales de AlfaCore para continuar.</p>
                            </div>
                        </div>

                        <div class="auth-saas-login__lead">Ingresá tus credenciales</div>

                        <form class="auth-form" @onsubmit="LoginAsync" @onsubmit:preventDefault="true">
                            <div class="auth-field">
                                <label for="login-user">Usuario o email</label>
                                <AuthInputField @ref="_userNameField"
                                                Id="login-user"
                                                Value="@_userName"
                                                ValueChanged="OnUserNameChangedAsync"
                                                Placeholder="usuario@empresa.com"
                                                Disabled="@_busy"
                                                Autocomplete="username"
                                                InputMode="text"
                                                InputClass="central-login-input auth-input-shell__input"
                                                WrapperClass="auth-input-shell auth-input-shell--user"
                                                IconClass="bi bi-person"
                                                OnKeyDown="OnKeyDownAsync" />
                            </div>

                            <div class="auth-field">
                                <label for="login-password">Contraseña</label>
                                <AuthInputField Id="login-password"
                                                Value="@_password"
                                                ValueChanged="OnPasswordChangedAsync"
                                                Placeholder="Contraseña"
                                                Disabled="@_busy"
                                                Autocomplete="current-password"
                                                InputClass="central-login-input central-login-password__input auth-input-shell__input"
                                                WrapperClass="auth-password central-login-password auth-input-shell auth-input-shell--password"
                                                IconClass="bi bi-lock"
                                                ShowPasswordToggle="true"
                                                ShowPassword="@_showPassword"
                                                ShowPasswordChanged="OnShowPasswordChangedAsync"
                                                PasswordToggleClass="auth-password__toggle central-login-password__toggle"
                                                PasswordToggleIconClass="@(_showPassword ? "bi bi-eye-slash" : "bi bi-eye")"
                                                PasswordToggleTitle="@(_showPassword ? "Ocultar contraseña" : "Mostrar contraseña")"
                                                OnKeyDown="OnKeyDownAsync" />
                            </div>

                            <AuthActionButton Type="submit"
                                              CssClass="btn btn--primary auth-card__submit"
                                              Text="Ingresar"
                                              BusyText="Ingresando..."
                                              IconClass="bi bi-box-arrow-in-right"
                                              BusyIconClass="spinner-border spinner-border-sm"
                                              IsBusy="@_busy"
                                              Disabled="@_busy" />

                            <div class="auth-saas-login__info">
                                <i class="bi bi-info-circle"></i>
                                <span>Luego del ingreso podrás seleccionar la empresa y la base con la que deseas trabajar.</span>
                            </div>

                            <div class="auth-saas-login__footer">
                                <span class="auth-saas-login__forgot">
                                    <i class="bi bi-lock"></i>
                                    <span>¿Olvidaste tu contraseña?</span>
                                </span>

                                <button type="button"
                                        class="auth-saas-login__cancel"
                                        @onclick="ClearSaasCredentialsAsync"
                                        disabled="@_busy">
                                    <i class="bi bi-x-lg"></i>
                                    <span>Cancelar</span>
                                </button>
                            </div>

                            <div class="auth-saas-login__info">
                                <i class="bi bi-stars"></i>
                                <span>¿Todavía no tenés cuenta? <a href="/registrarme">Registrarme gratis</a></span>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="auth-legacy-login @(_showLegacyBasePicker ? "is-bases-open" : string.Empty)">
                        <div class="auth-legacy-login__login">
                            <div class="auth-mobile-brand" aria-hidden="true">
                                <img class="central-brand-logo central-login-logo"
                                     src="@LogoPrincipal"
                                     alt="Alfa Gestión"
                                     loading="eager"
                                     decoding="async" />
                            </div>
                            <header class="auth-form-panel__header">
                                <h1 class="auth-card__title">Ingresar al sistema</h1>
                                <p class="auth-card__subtitle">Escribí tu usuario y contraseña para ingresar.</p>
                            </header>

                            <div class="usuarios-empty auth-legacy-login__selected">
                                <div class="auth-legacy-login__selected-icon" aria-hidden="true">
                                    <i class="bi bi-database-fill"></i>
                                </div>
                                <div class="auth-legacy-login__selected-body">
                                    <strong>Base seleccionada</strong>
                                    <p>@GetSelectedBaseLabel()</p>
                                    <small>Ese contexto se usa para validar usuario y contraseña.</small>
                                </div>
                            </div>

                            <div class="actions auth-legacy-login__actions">
                                <button type="button"
                                        class="btn btn--ghost"
                                        @onclick="ToggleLegacyBasePickerAsync"
                                        disabled="@_busy">
                                    <i class="bi bi-database"></i>
                                    <span>@(_showLegacyBasePicker ? "Ocultar bases" : "Cambiar base")</span>
                                </button>
                            </div>

                            <details class="auth-mobile-system">
                                <summary>Información del sistema</summary>
                                <div class="auth-mobile-system__grid">
                                    <article class="auth-mobile-system__card">
                                        <span>Modo</span>
                                        <strong>Local</strong>
                                    </article>
                                    <article class="auth-mobile-system__card">
                                        <span>Estado</span>
                                        <strong>@GetLoginStatusLabel()</strong>
                                    </article>
                                    <article class="auth-mobile-system__card">
                                        <span>Versión</span>
                                        <strong>@GetAppVersionLabel()</strong>
                                    </article>
                                    <article class="auth-mobile-system__card">
                                        <span>Conexión</span>
                                        <strong>@GetConnectionContextLabel()</strong>
                                    </article>
                                </div>
                            </details>

                        @if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <div class="editor-msg editor-msg--error auth-card__error">
                                <strong>Ingreso rechazado</strong>
                                <p>@_error</p>
                            </div>
                        }

                        <div class="auth-saas-login__lead">Ingresá tus credenciales</div>

                        <form class="auth-form" @onsubmit="LoginAsync" @onsubmit:preventDefault="true">
                            <div class="auth-field">
                                <label for="login-user">Usuario</label>
                                <AuthInputField @ref="_userNameField"
                                                Id="login-user"
                                                Value="@_userName"
                                                ValueChanged="OnUserNameChangedAsync"
                                                Placeholder="usuario"
                                                Disabled="@_busy"
                                                Autocomplete="username"
                                                InputMode="text"
                                                InputClass="central-login-input auth-input-shell__input"
                                                WrapperClass="auth-input-shell auth-input-shell--user"
                                                IconClass="bi bi-person"
                                                OnKeyDown="OnKeyDownAsync" />
                            </div>

                            <div class="auth-field">
                                <label for="login-password">Contraseña</label>
                                <AuthInputField Id="login-password"
                                                Value="@_password"
                                                ValueChanged="OnPasswordChangedAsync"
                                                Placeholder="Contraseña"
                                                Disabled="@_busy"
                                                Autocomplete="current-password"
                                                InputClass="central-login-input central-login-password__input auth-input-shell__input"
                                                WrapperClass="auth-password central-login-password auth-input-shell auth-input-shell--password"
                                                IconClass="bi bi-lock"
                                                ShowPasswordToggle="true"
                                                ShowPassword="@_showPassword"
                                                ShowPasswordChanged="OnShowPasswordChangedAsync"
                                                PasswordToggleClass="auth-password__toggle central-login-password__toggle"
                                                PasswordToggleIconClass="@(_showPassword ? "bi bi-eye-slash" : "bi bi-eye")"
                                                PasswordToggleTitle="@(_showPassword ? "Ocultar contraseña" : "Mostrar contraseña")"
                                                OnKeyDown="OnKeyDownAsync" />
                            </div>

                                <AuthActionButton Type="submit"
                                                  CssClass="btn btn--primary auth-card__submit"
                                                  Text="Ingresar"
                                                  BusyText="Ingresando..."
                                                  IconClass="bi bi-box-arrow-in-right"
                                                  BusyIconClass="spinner-border spinner-border-sm"
                                                  IsBusy="@_busy"
                                                  Disabled="@_busy" />
                            </form>
                        </div>

                        <aside class="auth-legacy-login__sidebar">
                            <div class="auth-legacy-login__sidebar-header">
                                <div class="auth-legacy-login__sidebar-title">
                                    <p class="auth-card__eyebrow">Seleccionar base</p>
                                    <h2 class="auth-card__title">Bases disponibles</h2>
                                </div>
                                <div class="auth-legacy-login__sidebar-actions">
                                    <button type="button"
                                            class="btn btn--ghost auth-legacy-login__add-toggle"
                                            @onclick="OpenLegacySessionAddFormAsync"
                                            disabled="@_busy"
                                            title="Agregar base">
                                        <i class="bi bi-plus-lg"></i>
                                        <span>Agregar base</span>
                                    </button>
                                    <button type="button"
                                            class="auth-legacy-login__sidebar-close"
                                            @onclick="CloseLegacyBasePickerAsync"
                                            disabled="@_busy"
                                            aria-label="Cerrar selector de bases"
                                            title="Cerrar">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>

                            @if (_showLegacySessionForm)
                            {
                                <div class="auth-legacy-login__editor-frame">
                                    <form class="auth-legacy-login__add-form" @onsubmit="SaveLegacySessionAsync" @onsubmit:preventDefault="true" @onkeydown="HandleLegacySessionFormKeyDownAsync">
                                        <div class="auth-legacy-login__add-form-head">
                                        <div>
                                            <strong>@(_editingLegacySession ? "Editar base" : "Agregar base")</strong>
                                            <span>@(_editingLegacySession ? "Actualizá los datos guardados en sessions.json" : "Creá una nueva base para el login local")</span>
                                        </div>
                                        <button type="button"
                                                class="auth-legacy-login__editor-close"
                                                @onclick="CancelLegacySessionFormAsync"
                                                disabled="@_savingLegacySession"
                                                aria-label="Cerrar editor de base"
                                                title="Cerrar">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(_legacySessionFormError))
                                    {
                                        <div class="auth-legacy-login__add-error">@_legacySessionFormError</div>
                                    }

                                    <div class="auth-legacy-login__add-grid">
                                        <div class="auth-legacy-login__add-field">
                                            <label>Nombre</label>
                                            <input class="drawer-search__input" @bind="_legacySessionNombre" placeholder="Nombre visible" />
                                        </div>
                                        <div class="auth-legacy-login__add-field">
                                            <label>Servidor</label>
                                            <input class="drawer-search__input" @bind="_legacySessionServidor" placeholder="SERVER\\INSTANCIA" />
                                        </div>
                                        <div class="auth-legacy-login__add-field">
                                            <label>Base de datos</label>
                                            <input class="drawer-search__input" @bind="_legacySessionBaseDatos" placeholder="BASE" />
                                        </div>
                                        <div class="auth-legacy-login__add-field">
                                            <label>Usuario SQL</label>
                                            <input class="drawer-search__input" @bind="_legacySessionUsuario" placeholder="usuario" />
                                        </div>
                                        <div class="auth-legacy-login__add-field auth-legacy-login__add-field--full">
                                            <label>Contraseña SQL</label>
                                            <input class="drawer-search__input" type="password" @bind="_legacySessionPassword" placeholder="••••••••" />
                                        </div>
                                    </div>

                                    <div class="auth-legacy-login__add-actions">
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="CancelLegacySessionFormAsync">Cancelar</button>
                                        <button type="submit" class="btn btn--primary btn--sm" disabled="@_savingLegacySession">
                                            @(_savingLegacySession ? "Guardando..." : (_editingLegacySession ? "Guardar cambios" : "Guardar base"))
                                        </button>
                                    </div>
                                </form>
                                </div>
                            }

                            <div class="auth-base-search">
                                <input type="text"
                                       class="base-search-input auth-base-search__input"
                                       placeholder="Buscar base..."
                                       @bind="_baseSearch"
                                       @bind:event="oninput"
                                       disabled="@_busy" />
                            </div>

                            @if (FilteredLegacyBases.Count == 0)
                            {
                                <div class="auth-base-empty">No se encontraron bases.</div>
                            }
                            else
                            {
                                <div class="auth-base-grid auth-legacy-login__base-grid">
                                    @foreach (var item in FilteredLegacyBases)
                                    {
                                        <article class="auth-base-card @(item.Activa ? "auth-base-card--active" : string.Empty)">
                                            <div class="auth-base-card__content">
                                                <p class="auth-base-card__name">@item.Nombre</p>
                                                <p class="auth-base-card__meta">@item.Servidor · @item.BaseDatos</p>
                                                <small class="auth-base-card__id">Base #@item.BaseId</small>
                                            </div>
                                            <div class="auth-base-card__actions">
                                                <button type="button"
                                                        class="auth-base-card__edit"
                                                        @onclick="() => OpenLegacySessionEditFormAsync(item)"
                                                        disabled="@_busy">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Editar</span>
                                                </button>
                                                <button type="button"
                                                        class="auth-base-card__action @(item.Activa ? "auth-base-card__action--active" : string.Empty)"
                                                        @onclick="() => SelectLegacyBaseAsync(item)"
                                                        disabled="@_busy">
                                                    @(item.Activa ? "? Activa" : "Seleccionar")
                                                </button>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </aside>
                    </div>
                }
            </div>
        </FormContent>
    </LoginShell>
</div>

@code {
    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string _error = string.Empty;
    private string _baseSearch = string.Empty;
    private bool _showLegacyBasePicker;
    private bool _showLegacySessionForm;
    private bool _editingLegacySession;
    private bool _busy;
    private bool _savingLegacySession;
    private bool _showPassword;
    private bool _isDarkTheme;
    private IReadOnlyList<SessionDto> _legacyBases = [];
    private AuthInputField? _userNameField;
    private DotNetObjectReference<Login>? _themeRef;
    private Guid? _editingLegacySessionId;
    private string _legacySessionFormError = string.Empty;
    private string _legacySessionNombre = string.Empty;
    private string _legacySessionServidor = string.Empty;
    private string _legacySessionBaseDatos = string.Empty;
    private string _legacySessionUsuario = string.Empty;
    private string _legacySessionPassword = string.Empty;
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Logger.LogInformation(
            "Login: initialized. Uri={Uri}, SaaS={SaaS}, Auth={Auth}, ReturnUrl={ReturnUrl}",
            Nav.Uri,
            AppMode.IsSaaSMode,
            AppUserSession.IsAuthenticated,
            ReturnUrl ?? "(sin returnUrl)");

        if (!AppMode.IsSaaSMode)
            _legacyBases = SessionSvc.GetAllSessions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var theme = await JS.InvokeAsync<string>("dashboardTheme.get");
            ApplyTheme(theme);
            _themeRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("dashboardTheme.watch", _themeRef);
            if (_userNameField is not null)
                await _userNameField.FocusAsync(preventScroll: true);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Login: no se pudo sincronizar el tema visual inicial.");
        }
    }

    private async Task ToggleLegacyBasePickerAsync()
    {
        _showLegacyBasePicker = !_showLegacyBasePicker;
        if (_showLegacyBasePicker)
            _legacyBases = SessionSvc.GetAllSessions();

        await InvokeAsync(StateHasChanged);
    }

    private Task CloseLegacyBasePickerAsync()
    {
        _showLegacyBasePicker = false;
        _showLegacySessionForm = false;
        _editingLegacySession = false;
        _editingLegacySessionId = null;
        _legacySessionFormError = string.Empty;
        _legacySessionNombre = string.Empty;
        _legacySessionServidor = string.Empty;
        _legacySessionBaseDatos = string.Empty;
        _legacySessionUsuario = string.Empty;
        _legacySessionPassword = string.Empty;
        return InvokeAsync(StateHasChanged);
    }

    private Task OpenLegacySessionAddFormAsync()
    {
        _editingLegacySession = false;
        _editingLegacySessionId = null;
        _showLegacySessionForm = true;
        _legacySessionFormError = string.Empty;
        _legacySessionNombre = string.Empty;
        _legacySessionServidor = string.Empty;
        _legacySessionBaseDatos = string.Empty;
        _legacySessionUsuario = string.Empty;
        _legacySessionPassword = string.Empty;
        return InvokeAsync(StateHasChanged);
    }

    private Task OpenLegacySessionEditFormAsync()
    {
        var active = SessionSvc.GetActiveSession();
        if (active is null)
        {
            _legacySessionFormError = "No hay base activa para editar.";
            _showLegacySessionForm = true;
            _editingLegacySession = false;
            _editingLegacySessionId = null;
            return InvokeAsync(StateHasChanged);
        }

        return OpenLegacySessionEditFormAsync(active);
    }

    private Task OpenLegacySessionEditFormAsync(SessionDto session)
    {
        _editingLegacySession = true;
        _editingLegacySessionId = session.Id;
        _showLegacySessionForm = true;
        _legacySessionFormError = string.Empty;
        _legacySessionNombre = session.Nombre;
        _legacySessionServidor = session.Servidor;
        _legacySessionBaseDatos = session.BaseDatos;
        _legacySessionUsuario = session.Usuario;
        _legacySessionPassword = session.Password;
        return InvokeAsync(StateHasChanged);
    }

    private Task CancelLegacySessionFormAsync()
    {
        _showLegacySessionForm = false;
        _editingLegacySession = false;
        _editingLegacySessionId = null;
        _legacySessionFormError = string.Empty;
        _legacySessionNombre = string.Empty;
        _legacySessionServidor = string.Empty;
        _legacySessionBaseDatos = string.Empty;
        _legacySessionUsuario = string.Empty;
        _legacySessionPassword = string.Empty;
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleLegacySessionFormKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            await CancelLegacySessionFormAsync();
    }

    private async Task SaveLegacySessionAsync()
    {
        if (string.IsNullOrWhiteSpace(_legacySessionServidor) ||
            string.IsNullOrWhiteSpace(_legacySessionBaseDatos) ||
            string.IsNullOrWhiteSpace(_legacySessionUsuario) ||
            string.IsNullOrWhiteSpace(_legacySessionPassword))
        {
            _legacySessionFormError = "Completá servidor, base, usuario y contraseña.";
            return;
        }

        _savingLegacySession = true;
        _legacySessionFormError = string.Empty;

        try
        {
            if (_editingLegacySession && _editingLegacySessionId is Guid editId)
            {
                SessionSvc.UpdateSession(
                    editId,
                    _legacySessionNombre,
                    _legacySessionServidor,
                    _legacySessionBaseDatos,
                    _legacySessionUsuario,
                    _legacySessionPassword);
            }
            else
            {
                SessionSvc.AddSession(
                    _legacySessionNombre,
                    _legacySessionServidor,
                    _legacySessionBaseDatos,
                    _legacySessionUsuario,
                    _legacySessionPassword);
            }

            _legacyBases = SessionSvc.GetAllSessions();
            await CancelLegacySessionFormAsync();
        }
        catch (Exception ex)
        {
            _legacySessionFormError = "No se pudo guardar la base.";
            Logger.LogWarning(ex, "Login: no se pudo guardar la base local.");
        }
        finally
        {
            _savingLegacySession = false;
        }
    }

    private IReadOnlyList<SessionDto> FilteredLegacyBases => string.IsNullOrWhiteSpace(_baseSearch)
        ? _legacyBases.OrderByDescending(item => item.Activa).ThenBy(item => item.Nombre, StringComparer.OrdinalIgnoreCase).ThenBy(item => item.BaseId).ToArray()
        : _legacyBases.Where(item =>
                Contains(item.Nombre, _baseSearch) ||
                Contains(item.BaseDatos, _baseSearch) ||
                Contains(item.Servidor, _baseSearch) ||
                Contains(item.BaseId.ToString(), _baseSearch))
            .OrderByDescending(item => item.Activa)
            .ThenBy(item => item.Nombre, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.BaseId)
            .ToArray();

    private async Task LoginAsync()
    {
        _busy = true;
        _error = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (AppMode.IsSaaSMode)
            {
                await AppUserSession.LoginAsync(_userName, _password);
            }
            else
            {
                var session = await LegacyBaseUserSession.LoginAsync(_userName, _password);
                AppUserSession.AdoptInternalUser(session);
            }

            await PersistUserTokenAsync();
            await GoToNextStepAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectLegacyBaseAsync(SessionDto item)
    {
        _busy = true;
        _error = string.Empty;

        try
        {
            SessionSvc.SwitchSession(item.Id);
            await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", item.Id.ToString());
            _legacyBases = SessionSvc.GetAllSessions();
            _showLegacyBasePicker = false;
        }
        catch (Exception ex)
        {
            _error = "No se pudo activar la base seleccionada.";
            Logger.LogWarning(ex, "Login: no se pudo seleccionar la base legacy. BaseId={BaseId}", item.BaseId);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PersistUserTokenAsync()
    {
        var token = AppUserSession.CurrentToken;
        if (string.IsNullOrWhiteSpace(token))
            return;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "alfacore_user_token", token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Login: no se pudo persistir el token de usuario en localStorage.");
        }
    }

    private async Task GoToNextStepAsync()
    {
        if (!AppMode.IsSaaSMode)
        {
            if (TryGetSafeReturnUrl(out var legacyReturnUrl))
            {
                Logger.LogInformation("Login: legacy mode, navigating to returnUrl {ReturnUrl}", legacyReturnUrl);
                Nav.NavigateTo(legacyReturnUrl, replace: true);
                return;
            }

            Logger.LogInformation("Login: legacy mode, navigating to root");
            Nav.NavigateTo("/", replace: true);
            return;
        }

        if (TryGetSafeReturnUrl(out var returnUrl))
        {
            Logger.LogInformation("Login: navigating to returnUrl {ReturnUrl}", returnUrl);
            Nav.NavigateTo(returnUrl, replace: true);
            return;
        }

        var bases = SessionSvc.GetAllSessions();
        if (bases.Count == 0)
        {
            // Login central válido pero sin ninguna base asociada — hoy esto pasa casi siempre
            // porque el registro público (/registrarme) todavía no confirmó el email: recién ahí
            // se aprovisiona la base. Sin este mensaje, el usuario terminaba en el overlay de
            // "Usuario del sistema" pidiendo un login interno que no existe todavía, sin ninguna
            // pista de qué falta.
            _error = "Tu cuenta todavía no fue confirmada. Revisá tu email y hacé clic en el enlace de confirmación — recién ahí se prepara tu base y vas a poder ingresar.";
            return;
        }

        if (bases.Count == 1)
        {
            SessionSvc.SwitchSession(bases[0].Id);
            await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", bases[0].Id.ToString());
            AppUserSession.HandleSqlSessionChanged();
            var internalSession = await LegacyBaseUserSession.ResolveByCentralLoginAsync(AppUserSession.CurrentUser?.CentralLogin ?? _userName);
            if (internalSession is not null)
                AppUserSession.AdoptInternalUser(internalSession);
            var routeIdWeb = NormalizeRouteIdWeb(AppUserSession.CurrentUser?.IdWeb);
            var destination = !string.IsNullOrWhiteSpace(routeIdWeb)
                ? $"/{Uri.EscapeDataString(routeIdWeb)}/{bases[0].BaseId}"
                : "/";
            Logger.LogInformation("Login: single-base destination resolved to {Destination}", destination);
            Nav.NavigateTo(destination, replace: true);
            return;
        }

        var currentIdWeb = AppUserSession.CurrentUser?.IdWeb;
        if (!string.IsNullOrWhiteSpace(currentIdWeb))
        {
            Logger.LogInformation("Login: redirecting to client landing {IdWeb}", currentIdWeb);
            Nav.NavigateTo($"/{Uri.EscapeDataString(currentIdWeb)}", replace: true);
            return;
        }

        Logger.LogInformation("Login: redirecting to selector base");
        Nav.NavigateTo("/seleccionar-base", replace: true);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
            await LoginAsync();
    }

    private Task OnUserNameChangedAsync(string value)
    {
        _userName = value;
        return Task.CompletedTask;
    }

    private Task OnPasswordChangedAsync(string value)
    {
        _password = value;
        return Task.CompletedTask;
    }

    private Task OnShowPasswordChangedAsync(bool value)
    {
        _showPassword = value;
        return Task.CompletedTask;
    }

    private Task ClearSaasCredentialsAsync()
    {
        _userName = string.Empty;
        _password = string.Empty;
        _showPassword = false;
        _error = string.Empty;
        return InvokeAsync(StateHasChanged);
    }

