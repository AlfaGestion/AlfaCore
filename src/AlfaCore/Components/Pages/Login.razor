        => AppMode.IsSaaSMode
            ? "auth-shell auth-shell--saas"
            : "auth-shell auth-shell--local";

    private string LogoPrincipal => AuthThemeAssets.GetLoginLogo(_isDarkTheme);

    private string GetSelectedBaseName()
    {
        var current = SessionSvc.GetActiveSession();
        if (current is null)
            return "Sin base seleccionada";

        return current.Nombre;
    }

    private string GetLoginStatusLabel()
        => SessionSvc.GetActiveSession() is null ? "Listo para ingresar" : "Operativo";

    private string GetAppVersionLabel()
    {
        var version = typeof(Login).Assembly.GetName().Version;
        if (version is null)
            return "N/D";

        return $"v{version.Major}.{version.Minor}.{version.Build}";
    }

    private string GetConnectionContextLabel()
    {
        var current = SessionSvc.GetActiveSession();
        if (current is null)
            return "Sin conexión activa";

        return string.IsNullOrWhiteSpace(current.Servidor)
            ? "Contexto local"
            : current.Servidor;
    }

    private string GetSelectedBaseLabel()
    {
        var current = SessionSvc.GetActiveSession();
        if (current is null)
            return "Sin base activa";

        return current.BaseId > 0
            ? $"Base #{current.BaseId} - {current.Nombre}"
            : current.Nombre;
    }
    private static bool Contains(string? value, string search)
        => !string.IsNullOrWhiteSpace(value)
           && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string? NormalizeRouteIdWeb(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var trimmed = value.Trim();
        return trimmed.Length == 0 ? null : trimmed;
    }

    private bool TryGetSafeReturnUrl(out string safeReturnUrl)
    {
        safeReturnUrl = string.Empty;

        var candidate = ReturnUrl?.Trim();
        if (string.IsNullOrWhiteSpace(candidate))
            return false;

        if (!candidate.StartsWith("/", StringComparison.Ordinal) || candidate.StartsWith("//", StringComparison.Ordinal))
            return false;

        if (string.Equals(candidate, "/", StringComparison.Ordinal))
            return false;

        if (candidate.Contains('\r') || candidate.Contains('\n'))
            return false;

        safeReturnUrl = candidate;
        return true;
    }

    [JSInvokable]
    public Task OnDashboardThemeChanged(string theme)
    {
        ApplyTheme(theme);
        return InvokeAsync(StateHasChanged);
    }

    private void ApplyTheme(string? theme)
        => _isDarkTheme = !string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase);

