@page "/"
@page "/{idweb}/{idbase:int}"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@inject AlfaCore.Services.IWorkspaceService WorkspaceSvc
@inject AlfaCore.Services.IMenuService MenuSvc
@inject AlfaCore.Services.IRecentService RecentSvc
@inject AlfaCore.Services.IFavoritesService FavoritesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject ILogger<Launcher> Logger
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Inicio | Alfa Gestión</PageTitle>

@if (_loading)
{
    <AppLoadingFrame Title="Cargando sistema..."
                     Subtitle="Preparando el shell principal y las aplicaciones disponibles." />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="panel-card empty-state">
        <span class="empty-state__eyebrow">Inicio</span>
        <h1>No se pudo cargar el shell principal</h1>
        <p>@_error</p>
    </div>
}
else
{
    <div class="alfa-home">
        <section class="alfa-home__hero">
            <h1 class="alfa-home__title">Hola, @SaludoNombre</h1>
            <p class="alfa-home__subtitle">¿Qué querés hacer hoy?</p>

            <div class="alfa-home__search @(_searchOpen ? "is-open" : null)">
                @if (_searchOpen)
                {
                    <div class="alfa-home__backdrop" @onclick="CloseSearch"></div>
                }
                <div class="alfa-home__search-box">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="home-search"
                           type="search"
                           autocomplete="off"
                           placeholder="Buscar una aplicación: clientes, cierre de caja, compras…"
                           aria-label="Buscar una aplicación"
                           aria-controls="home-search-results"
                           value="@_searchText"
                           @oninput="OnSearchInput"
                           @onfocus="OpenSearchAsync"
                           @onkeydown="OnSearchKeyDownAsync" />
                    <kbd class="alfa-home__kbd" aria-hidden="true">Ctrl K</kbd>
                </div>

                @if (_searchOpen)
                {
                    <div id="home-search-results" class="alfa-home__results" role="listbox">
                        @if (string.IsNullOrWhiteSpace(_searchText))
                        {
                            <span class="alfa-home__results-label">Recientes</span>
                            @if (_home.Recents.Count == 0)
                            {
                                <p class="alfa-home__results-hint">Todavía no abriste ninguna aplicación desde este usuario.</p>
                            }
                            @for (var i = 0; i < _home.Recents.Count; i++)
                            {
                                var item = _home.Recents[i];
                                var index = i;
                                <div class="alfa-home__result @(index == _activeIndex ? "is-active" : null)" role="option" aria-selected="@(index == _activeIndex ? "true" : "false")"
                                     @onclick="() => OpenNodeAsync(item)" @onmouseenter="() => _activeIndex = index">
                                    <span class="alfa-home__result-icon"><i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-clock-history" : item.Icono)" aria-hidden="true"></i></span>
                                    <span class="alfa-home__result-name">@item.Nombre</span>
                                    <span class="alfa-home__result-meta">@FormatRelativeTime(item.UltimoAcceso)</span>
                                    @FavoriteStar(item.Menu, item.Clave, item.Nombre)
                                </div>
                            }
                        }
                        else if (_searchLoading)
                        {
                            <p class="alfa-home__results-hint" role="status">Preparando opciones del menú…</p>
                        }
                        else
                        {
                            var resultados = SearchResults;
                            <span class="alfa-home__results-label">Resultados</span>
                            @if (resultados.Count == 0)
                            {
                                <p class="alfa-home__results-hint">No hay aplicaciones que coincidan con «@_searchText».</p>
                            }
                            @for (var i = 0; i < resultados.Count; i++)
                            {
                                var item = resultados[i];
                                var index = i;
                                <div class="alfa-home__result @(index == _activeIndex ? "is-active" : null)" role="option" aria-selected="@(index == _activeIndex ? "true" : "false")"
                                     @onclick="() => OpenSearchItemAsync(item)" @onmouseenter="() => _activeIndex = index">
                                    <span class="alfa-home__result-icon"><i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-grid" : item.Icono)" aria-hidden="true"></i></span>
                                    <span class="alfa-home__result-name">@item.Nombre</span>
                                    <span class="alfa-home__result-meta">@(item.EsModulo ? "Módulo" : item.ModuloNombre)</span>
                                    @if (!item.EsModulo)
                                    {
                                        @FavoriteStar(item.Menu, item.Clave, item.Nombre)
                                    }
                                </div>
                            }
                            @if (resultados.Count > 0)
                            {
                                <p class="alfa-home__results-foot"><kbd>↑</kbd><kbd>↓</kbd> para elegir · <kbd>Enter</kbd> para abrir</p>
                            }
                        }
                    </div>
                }
            </div>
        </section>

        <section class="alfa-home__section" aria-labelledby="home-favoritos">
            <h2 id="home-favoritos" class="alfa-home__section-title">Favoritos</h2>
            @if (_home.Favorites.Count == 0)
            {
                <p class="alfa-home__hint">Marcá con <i class="bi bi-star" aria-hidden="true"></i> las aplicaciones que más usás (desde el buscador o desde cada módulo) y van a aparecer acá.</p>
            }
            else
            {
                <div class="alfa-home__chips">
                    @foreach (var item in _home.Favorites)
                    {
                        <div class="alfa-home__chip">
                            <button type="button" class="alfa-home__chip-open" @onclick="() => OpenNodeAsync(item)">
                                <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-star-fill" : item.Icono)" aria-hidden="true"></i>
                                <span>@item.Nombre</span>
                            </button>
                            <button type="button" class="alfa-home__chip-remove" title="Quitar de favoritos" aria-label="Quitar @item.Nombre de favoritos"
                                    @onclick="() => ToggleFavoriteAsync(item.Menu, item.Clave)">
                                <i class="bi bi-x" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="alfa-home__section" aria-labelledby="home-aplicaciones">
            <h2 id="home-aplicaciones" class="alfa-home__section-title">Aplicaciones</h2>
            @if (_home.Modules.Count == 0)
            {
                <AlfaEmptyState Title="Sin módulos visibles" Message="Este usuario todavía no tiene módulos habilitados en esta base." />
            }
            else
            {
                <div class="alfa-home__modules">
                    @foreach (var module in _home.Modules)
                    {
                        var abierto = string.Equals(_openModuleKey, module.Clave, StringComparison.OrdinalIgnoreCase);
                        <div class="alfa-home__module-wrap">
                            <button type="button" class="alfa-home__module @(abierto ? "is-open" : null)"
                                    aria-expanded="@(IsWorkspaceModule(module) ? (abierto ? "true" : "false") : null)"
                                    @onclick="() => OnModuleClickAsync(module)">
                                <span class="alfa-home__module-icon"><i class="bi @(string.IsNullOrWhiteSpace(module.Icono) ? "bi-grid" : module.Icono)" aria-hidden="true"></i></span>
                                <span class="alfa-home__module-name">@module.Nombre</span>
                            </button>

                            @if (abierto)
                            {
                                <div class="alfa-home__backdrop" @onclick="CloseModulePanel"></div>
                                <section class="alfa-home__panel" aria-label="Aplicaciones de @module.Nombre" @onkeydown="OnPanelKeyDown">
                                    <header class="alfa-home__panel-head">
                                        <strong>@module.Nombre</strong>
                                        <button type="button" class="alfa-home__panel-close" title="Cerrar" aria-label="Cerrar" @onclick="CloseModulePanel">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </header>
                                    <div class="alfa-home__panel-body">
                                        @if (_moduleLoading)
                                        {
                                            <p class="alfa-home__results-hint" role="status">Cargando aplicaciones…</p>
                                        }
                                        else if (_moduleSections.Sum(x => x.Items.Count) == 0)
                                        {
                                            <p class="alfa-home__results-hint">Este módulo todavía no tiene aplicaciones web.</p>
                                        }
                                        else
                                        {
                                            @foreach (var seccion in _moduleSections.Where(x => x.Items.Count > 0))
                                            {
                                                @if (_moduleSections.Count(x => x.Items.Count > 0) > 1)
                                                {
                                                    <span class="alfa-home__results-label">@seccion.Nombre</span>
                                                }
                                                @foreach (var item in seccion.Items)
                                                {
                                                    <div class="alfa-home__result" role="button" tabindex="0"
                                                         @onclick="() => OpenNodeAsync(item)" @onkeydown="args => HandleNodeCardKeyDownAsync(args, item)">
                                                        <span class="alfa-home__result-icon"><i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-box-arrow-up-right" : item.Icono)" aria-hidden="true"></i></span>
                                                        <span class="alfa-home__result-name">@item.Nombre</span>
                                                        @FavoriteStar(item.Menu, item.Clave, item.Nombre)
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                    <footer class="alfa-home__panel-foot">
                                        <a href="@RouteContext.BuildRoute(module.RutaWeb)">Ver el módulo completo <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                                    </footer>
                                </section>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private ShellHomeDto _home = new();
    private string _error = string.Empty;
    private string _searchText = string.Empty;
    private bool _searchOpen;
    private bool _searchLoading;
    private bool _searchLoaded;
    private int _activeIndex = -1;
    private IReadOnlyList<ShellMenuSearchItemDto> _searchCatalog = [];
    private string _openModuleKey = string.Empty;
    private bool _moduleLoading;
    private IReadOnlyList<ShellWorkspaceSectionDto> _moduleSections = [];
    private bool _disposed;
    private int _loadVersion;

    /// <summary>
    /// Igual que en MainLayout: no alcanza con "ya hizo login interno alguna vez"
    /// (AppUserSession.RequiresInternalLogin=false) — tiene que haberlo hecho contra la base que
    /// está activa ahora mismo, para que un cambio de idbase no herede una autorización ajena.
    /// </summary>
    private bool IsActiveSessionAuthorized
        => AppUserSession.IsAuthorizedForSession(SessionSvc.GetActiveSession()?.Id);

    protected override void OnInitialized()
    {
        SessionSvc.SessionChanged += OnContextChanged;
        AppUserSession.StateChanged += OnContextChanged;

        if (CanUseActiveSessionForRoute() && WorkspaceSvc.TryGetCachedHome(out var cachedHome))
        {
            _home = cachedHome;
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var normalizedPath = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');
            Logger.LogInformation(
                "Launcher: first render. Uri={Uri}, RouteIdWeb={IdWeb}, RouteIdBase={IdBase}, SaaS={SaaS}, Auth={Auth}, ActiveSession={ActiveSession}",
                Nav.Uri,
                idweb ?? "(sin ruta)",
                idbase?.ToString() ?? "(sin base)",
                AppMode.IsSaaSMode,
                AppUserSession.IsAuthenticated,
                SessionSvc.GetActiveSession()?.BaseId.ToString() ?? "(sin base)");

            if (string.IsNullOrWhiteSpace(normalizedPath)
                && (!AppUserSession.IsAuthenticated || !IsActiveSessionAuthorized))
            {
                var returnUrl = "/";
                Logger.LogInformation("Launcher: root without usable session, redirecting to login. ReturnUrl={ReturnUrl}", returnUrl);
                var loginTarget = string.Equals(returnUrl, "/", StringComparison.Ordinal)
                    ? "/login"
                    : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
                Nav.NavigateTo(loginTarget, replace: true);
                return;
            }

            if (!AppMode.IsSaaSMode)
            {
                if (!AppUserSession.IsAuthenticated || !IsActiveSessionAuthorized)
                {
                    _loading = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            else if (!AppUserSession.IsAuthenticated || !IsActiveSessionAuthorized)
            {
                _loading = false;
                Logger.LogInformation(
                    "Launcher: SaaS sin sesion lista para cargar home. Se mantiene la ruta actual. Uri={Uri}, IdWeb={IdWeb}, IdBase={IdBase}, RequiresInternalLogin={RequiresInternalLogin}",
                    Nav.Uri,
                    idweb ?? "(sin ruta)",
                    idbase?.ToString() ?? "(sin base)",
                    AppUserSession.RequiresInternalLogin);
                await InvokeAsync(StateHasChanged);
                return;
            }

            var activeSession = SessionSvc.GetActiveSession();
            var availableSessions = SessionSvc.GetAllSessions();

            if (AppMode.IsSaaSMode && activeSession is null && idbase is int routeBaseId)
            {
                var routeSession = availableSessions.FirstOrDefault(x => x.BaseId == routeBaseId);
                if (routeSession is not null)
                {
                    SessionSvc.SwitchSession(routeSession.Id);

                    try
                    {
                        await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", routeSession.Id.ToString());
                    }
                    catch
                    {
                        // Si JS no responde, la sesion en memoria ya quedo seleccionada.
                    }

                    activeSession = routeSession;
                }
                else
                {
                    _loading = false;
                    Logger.LogInformation(
                        "Launcher: no se resolvió la base para la ruta. RouteIdWeb={IdWeb}, RouteBaseId={IdBase}, Available={Available}",
                        idweb ?? "(sin ruta)",
                        routeBaseId,
                        availableSessions.Count);
                    Nav.NavigateTo(!string.IsNullOrWhiteSpace(idweb) ? $"/{Uri.EscapeDataString(idweb)}" : "/seleccionar-base", replace: true);
                    return;
                }
            }

            if (activeSession is null && availableSessions.Count == 1)
            {
                SessionSvc.SwitchSession(availableSessions[0].Id);

                try
                {
                    await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", availableSessions[0].Id.ToString());
                }
                catch
                {
                    // Si JS no responde, la sesión en memoria ya quedó seleccionada.
                }

                activeSession = availableSessions[0];
            }

            if (activeSession is null)
            {
                _loading = false;
                if (AppMode.IsSaaSMode)
                {
                    Logger.LogInformation(
                        "Launcher: active session null, redirecting. RouteIdWeb={IdWeb}, RouteIdBase={IdBase}, ReturnUrl={ReturnUrl}",
                        idweb ?? "(sin ruta)",
                        idbase?.ToString() ?? "(sin base)",
                        Nav.Uri);
                    Nav.NavigateTo(!string.IsNullOrWhiteSpace(idweb) ? $"/{Uri.EscapeDataString(idweb)}" : "/seleccionar-base", replace: true);
                }
                else
                    await InvokeAsync(StateHasChanged);
                return;
            }

            if (AppMode.IsSaaSMode)
            {
                var canonicalIdWeb = NormalizeRouteIdWeb(AppUserSession.CurrentUser?.IdWeb) ?? NormalizeRouteIdWeb(idweb);
                if (!string.IsNullOrWhiteSpace(canonicalIdWeb)
                    && (!string.Equals(idweb, canonicalIdWeb, StringComparison.OrdinalIgnoreCase)
                        || !idbase.HasValue
                        || idbase.Value != activeSession.BaseId))
                {
                    _loading = false;
                    Logger.LogInformation(
                        "Launcher: canonical home redirect. CurrentIdWeb={CurrentIdWeb}, CanonicalIdWeb={CanonicalIdWeb}, CurrentBase={CurrentBase}, ActiveBase={ActiveBase}",
                        idweb ?? "(sin ruta)",
                        canonicalIdWeb,
                        idbase?.ToString() ?? "(sin base)",
                        activeSession.BaseId);
                    Nav.NavigateTo(RouteContext.BuildRoute("/"), replace: true);
                    return;
                }
            }

            var showInitialLoader = _loading;
            var loadTask = LoadHomeAsync(showInitialLoader);
            var completedTask = await Task.WhenAny(loadTask, Task.Delay(TimeSpan.FromSeconds(15)));
            if (completedTask != loadTask)
            {
                if (!showInitialLoader)
                    return;
                _error = "No se pudo cargar el shell principal a tiempo. Revisá la base activa o intentá nuevamente.";
                _loading = false;
                return;
            }

            await loadTask;
            if (AppMode.IsSaaSMode
                && _error.Length == 0
                && _home.Modules.Count == 0
                && SessionSvc.GetActiveSession() is not null)
            {
                Logger.LogInformation(
                    "Launcher: home inicial vacío, reintentando una vez. Uri={Uri}, IdWeb={IdWeb}, IdBase={IdBase}",
                    Nav.Uri,
                    idweb ?? "(sin ruta)",
                    idbase?.ToString() ?? "(sin base)");
                await Task.Delay(300);
                await LoadHomeAsync(showLoader: false);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (NavigationException)
        {
            return;
        }
        catch
        {
            _error = "No se pudo cargar el shell principal. Revisá la base activa o intentá nuevamente.";
            _loading = false;
        }
    }

    private async Task OpenNodeAsync(ShellMenuNodeDto item)
    {
        await RecentSvc.RegisterRecentAsync(item.Menu, item.Clave);
        Nav.NavigateTo(RouteContext.BuildRoute(item.RutaWeb));
    }

    private string SaludoNombre
    {
        get
        {
            var nombre = AppUserSession.CurrentUser?.UserName?.Trim();
            if (string.IsNullOrWhiteSpace(nombre))
                return "de nuevo";
            return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(nombre.ToLowerInvariant());
        }
    }

    private IReadOnlyList<ShellMenuSearchItemDto> SearchResults
        => ShellMenuSearch.Filter(_searchCatalog, _searchText);

    // Cantidad de filas navegables con flechas: recientes (búsqueda vacía) o resultados.
    private int ActiveListCount
        => string.IsNullOrWhiteSpace(_searchText) ? _home.Recents.Count : SearchResults.Count;

    private RenderFragment FavoriteStar(string menu, string clave, string nombre) => __builder =>
    {
        var activo = IsFavorite(clave);
        <button type="button"
                class="alfa-home__star @(activo ? "is-active" : null)"
                title="@(activo ? "Quitar de favoritos" : "Agregar a favoritos")"
                aria-label="@(activo ? $"Quitar {nombre} de favoritos" : $"Agregar {nombre} a favoritos")"
                @onclick="() => ToggleFavoriteAsync(menu, clave)"
                @onclick:stopPropagation="true">
            <i class="bi @(activo ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
        </button>
    };

    private async Task OpenSearchAsync()
    {
        _searchOpen = true;
        _openModuleKey = string.Empty;
        await EnsureSearchCatalogAsync();
    }

    private void CloseSearch()
    {
        _searchOpen = false;
        _activeIndex = -1;
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        _searchOpen = true;
        _activeIndex = string.IsNullOrWhiteSpace(_searchText) ? -1 : 0;
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowDown":
                _searchOpen = true;
                if (ActiveListCount > 0)
                    _activeIndex = (_activeIndex + 1) % ActiveListCount;
                break;
            case "ArrowUp":
                if (ActiveListCount > 0)
                    _activeIndex = _activeIndex <= 0 ? ActiveListCount - 1 : _activeIndex - 1;
                break;
            case "Enter":
                await OpenActiveAsync();
                break;
            case "Escape":
                if (!string.IsNullOrEmpty(_searchText))
                {
                    _searchText = string.Empty;
                    _activeIndex = -1;
                }
                else
                    CloseSearch();
                break;
        }
    }

    private async Task OpenActiveAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            if (_activeIndex >= 0 && _activeIndex < _home.Recents.Count)
                await OpenNodeAsync(_home.Recents[_activeIndex]);
            return;
        }

        var resultados = SearchResults;
        if (resultados.Count == 0)
            return;
        var index = _activeIndex >= 0 && _activeIndex < resultados.Count ? _activeIndex : 0;
        await OpenSearchItemAsync(resultados[index]);
    }

    private async Task EnsureSearchCatalogAsync()
    {
        if (_searchLoaded || _searchLoading)
            return;

        _searchLoading = true;
        try
        {
            _searchCatalog = await MenuSvc.GetSearchItemsAsync();
            _searchLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Launcher: no se pudo cargar el catálogo de búsqueda del menú.");
            _searchCatalog = [];
        }
        finally
        {
            _searchLoading = false;
        }
    }

    private async Task OpenSearchItemAsync(ShellMenuSearchItemDto item)
    {
        if (string.IsNullOrWhiteSpace(item.RutaWeb))
            return;

        try
        {
            await RecentSvc.RegisterRecentAsync(item.Menu, item.Clave);
        }
        catch
        {
            // El reciente es accesorio: si falla, se abre igual.
        }

        Nav.NavigateTo(RouteContext.BuildRoute(item.RutaWeb));
    }

    // Los módulos del árbol (ruta /shell/{clave}) abren el panel con sus aplicaciones; los que
    // tienen ruta propia (ej. Administrar) navegan directo, como en el menú lateral.
    private static bool IsWorkspaceModule(ShellModuleDto module)
        => module.RutaWeb.StartsWith("/shell/", StringComparison.OrdinalIgnoreCase);

    private async Task OnModuleClickAsync(ShellModuleDto module)
    {
        if (!IsWorkspaceModule(module))
        {
            Nav.NavigateTo(RouteContext.BuildRoute(module.RutaWeb));
            return;
        }

        if (string.Equals(_openModuleKey, module.Clave, StringComparison.OrdinalIgnoreCase))
        {
            CloseModulePanel();
            return;
        }

        CloseSearch();
        _openModuleKey = module.Clave;
        if (WorkspaceSvc.TryGetCachedModuleWorkspace(module.Clave, out var cached))
        {
            _moduleSections = cached.Sections;
            _moduleLoading = false;
            return;
        }

        _moduleSections = [];
        _moduleLoading = true;
        StateHasChanged();
        try
        {
            var workspace = await WorkspaceSvc.GetModuleWorkspaceAsync(module.Clave);
            if (string.Equals(_openModuleKey, module.Clave, StringComparison.OrdinalIgnoreCase))
                _moduleSections = workspace.Sections;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Launcher: no se pudieron cargar las aplicaciones del módulo {Modulo}.", module.Clave);
            _moduleSections = [];
        }
        finally
        {
            _moduleLoading = false;
        }
    }

    private void CloseModulePanel()
    {
        _openModuleKey = string.Empty;
        _moduleSections = [];
    }

    private void OnPanelKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            CloseModulePanel();
    }

    private async Task HandleNodeCardKeyDownAsync(KeyboardEventArgs args, ShellMenuNodeDto item)
    {
        if (IsActivationKey(args.Key))
            await OpenNodeAsync(item);
    }

    private bool IsFavorite(string clave)
    {
        return _home.Favorites.Any(item => string.Equals(item.Clave, clave, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ToggleFavoriteAsync(string menu, string clave)
    {
        await FavoritesSvc.ToggleFavoriteAsync(menu, clave);
        WorkspaceSvc.InvalidateWorkspaceCache();
        _home = await WorkspaceSvc.RefreshHomeAsync();
    }

    private static bool IsActivationKey(string? key)
    {
        return string.Equals(key, "Enter", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, " ", StringComparison.Ordinal)
            || string.Equals(key, "Space", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, "Spacebar", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatRelativeTime(DateTime? value)
    {
        if (value is null)
            return "reciente";

        var elapsed = DateTime.Now - value.Value;
        if (elapsed < TimeSpan.Zero)
            elapsed = TimeSpan.Zero;

        if (elapsed.TotalMinutes < 1)
            return "recién";

        if (elapsed.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)Math.Round(elapsed.TotalMinutes));
            return $"hace {minutes} min";
        }

        if (elapsed.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)Math.Round(elapsed.TotalHours));
            return $"hace {hours} h";
        }

        if (elapsed.TotalDays < 30)
        {
            var days = Math.Max(1, (int)Math.Round(elapsed.TotalDays));
            return days == 1 ? "ayer" : $"hace {days} días";
        }

        return value.Value.ToString("dd/MM/yyyy");
    }

    private async void OnContextChanged()
    {
        if (_disposed)
            return;

        await InvokeAsync(async () =>
        {
            if (!AppUserSession.IsAuthenticated
                || !IsActiveSessionAuthorized
                || SessionSvc.GetActiveSession() is null)
            {
                _loading = false;
                StateHasChanged();
                return;
            }

            var hasCachedHome = false;
            ShellHomeDto cachedHome = new();
            if (CanUseActiveSessionForRoute())
                hasCachedHome = WorkspaceSvc.TryGetCachedHome(out cachedHome);
            if (hasCachedHome)
            {
                _home = cachedHome;
                _loading = false;
                StateHasChanged();
            }

            await LoadHomeAsync(showLoader: !hasCachedHome);
            StateHasChanged();
        });
    }

    private async Task LoadHomeAsync(bool showLoader = true)
    {
        var version = Interlocked.Increment(ref _loadVersion);
        var hadVisibleHome = HasVisibleHome();
        if (showLoader || !hadVisibleHome)
        {
            _loading = true;
            _error = string.Empty;
            StateHasChanged();
        }

        try
        {
            var activeSession = SessionSvc.GetActiveSession();
            Logger.LogInformation(
                "Launcher: loading home. User={User}, BaseId={BaseId}, BaseName={BaseName}, ViewMode={ViewMode}",
                AppUserSession.CurrentUser?.UserName ?? "(sin usuario)",
                activeSession?.Id.ToString() ?? "(sin base)",
                activeSession?.Nombre ?? "(sin base)",
                AppMode.IsSaaSMode ? "saas" : "legacy");

            var home = showLoader || !hadVisibleHome
                ? await WorkspaceSvc.GetHomeAsync()
                : await WorkspaceSvc.RefreshHomeAsync();
            if (version != _loadVersion)
                return;
            if (!CanUseActiveSessionForRoute())
                return;

            _home = home;
            _error = string.Empty;
            Logger.LogInformation(
                "Launcher: home loaded. ModuleGroups={ModuleGroups}, Favorites={Favorites}, Recents={Recents}",
                _home.Modules.Count,
                _home.Favorites.Count,
                _home.Recents.Count);
        }
        catch (Exception ex)
        {
            if (version == _loadVersion)
            {
                if (!showLoader && hadVisibleHome)
                {
                    Logger.LogWarning(
                        ex,
                        "Launcher: background RefreshHomeAsync failed. User={User}, BaseId={BaseId}, BaseName={BaseName}",
                        AppUserSession.CurrentUser?.UserName ?? "(sin usuario)",
                        SessionSvc.GetActiveSession()?.Id.ToString() ?? "(sin base)",
                        SessionSvc.GetActiveSession()?.Nombre ?? "(sin base)");
                    return;
                }
                _error = "No se pudieron cargar los módulos del usuario. Revisá la base activa o intentá nuevamente.";
                Logger.LogWarning(
                    ex,
                    "Launcher: GetHomeAsync failed. User={User}, BaseId={BaseId}, BaseName={BaseName}",
                    AppUserSession.CurrentUser?.UserName ?? "(sin usuario)",
                    SessionSvc.GetActiveSession()?.Id.ToString() ?? "(sin base)",
                    SessionSvc.GetActiveSession()?.Nombre ?? "(sin base)");
                _home = new ShellHomeDto();
            }
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    private bool HasVisibleHome()
        => _home.Modules.Count > 0 || _home.Favorites.Count > 0 || _home.Recents.Count > 0;

    private bool CanUseActiveSessionForRoute()
    {
        if (!AppMode.IsSaaSMode || idbase is not > 0)
            return true;

        return SessionSvc.GetActiveSession()?.BaseId == idbase.Value;
    }

    private static string? NormalizeRouteIdWeb(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var trimmed = value.Trim();
        return trimmed.Length == 0 ? null : trimmed;
    }

    public void Dispose()
    {
        _disposed = true;
        SessionSvc.SessionChanged -= OnContextChanged;
        AppUserSession.StateChanged -= OnContextChanged;
    }
}
