@page "/"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@inject AlfaCore.Services.IWorkspaceService WorkspaceSvc
@inject AlfaCore.Services.IRecentService RecentSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Aplicaciones | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando shell principal...
    </div>
}
else
{
    <div class="page-grid">
        <section class="page-intro">
            <div>
                <h2 class="page-intro__title">Aplicaciones</h2>
                <p class="page-intro__text">Seleccioná un módulo del ERP para entrar al nuevo shell web y abrir las aplicaciones disponibles para tu usuario.</p>
            </div>
        </section>

        @if (_home.Favorites.Count > 0)
        {
            <section id="favoritos" class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Favoritos</h3>
                        <p class="panel-card__subtitle">Accesos frecuentes preparados para el usuario actual.</p>
                    </div>
                </div>
                <div class="launcher__grid">
                    @foreach (var item in _home.Favorites)
                    {
                        <button type="button" class="app-card app-card--button" @onclick="() => OpenNodeAsync(item)">
                            <div class="app-card__icon @ShellNavigationUiHelper.GetNodeIconClass(item)">
                                <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-star-fill" : item.Icono)"></i>
                            </div>
                            <span class="app-card__name">@item.Nombre</span>
                            <span class="app-card__desc">@ShellNavigationUiHelper.GetNodeDescription(item)</span>
                        </button>
                    }
                </div>
            </section>
        }

        @if (_home.Recents.Count > 0)
        {
            <section id="recientes" class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Recientes</h3>
                        <p class="panel-card__subtitle">Últimas aplicaciones abiertas dentro del shell.</p>
                    </div>
                </div>
                <div class="launcher__grid launcher__grid--compact">
                    @foreach (var item in _home.Recents)
                    {
                        <button type="button" class="app-card app-card--button" @onclick="() => OpenNodeAsync(item)">
                            <div class="app-card__icon @ShellNavigationUiHelper.GetNodeIconClass(item)">
                                <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-clock-history" : item.Icono)"></i>
                            </div>
                            <span class="app-card__name">@item.Nombre</span>
                            <span class="app-card__desc">@ShellNavigationUiHelper.GetNodeDescription(item)</span>
                        </button>
                    }
                </div>
            </section>
        }

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Módulos</h3>
                    <p class="panel-card__subtitle">Árbol funcional histórico de Alfa Gestión filtrado por permisos y opciones web habilitadas.</p>
                </div>
            </div>
            @if (_home.Modules.Count == 0)
            {
                <div class="shell-empty-state">
                    <strong>No hay módulos web disponibles para esta base.</strong>
                    <span>Revisá que `ALFACORE_MENU_WEB` exista, tenga datos para el `Menu` real de `TA_MENU` y que estén aplicados los updates de shell web.</span>
                </div>
            }
            else
            {
                <div class="launcher__grid">
                    @foreach (var module in _home.Modules)
                    {
                        <a class="app-card" href="@module.RutaWeb">
                            <div class="app-card__icon @ShellNavigationUiHelper.GetModuleIconClass(module)">
                                <i class="bi @(string.IsNullOrWhiteSpace(module.Icono) ? "bi-grid-3x3-gap-fill" : module.Icono)"></i>
                            </div>
                            <span class="app-card__name">@module.Nombre</span>
                            <span class="app-card__desc">Abrí el workspace del módulo y accedé a las aplicaciones web disponibles.</span>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private ShellHomeDto _home = new();
    private bool _disposed;

    protected override void OnInitialized()
    {
        SessionSvc.SessionChanged += OnContextChanged;
        AppUserSession.StateChanged += OnContextChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Task.Yield();
        await LoadHomeAsync();
    }

    private async Task OpenNodeAsync(ShellMenuNodeDto item)
    {
        await RecentSvc.RegisterRecentAsync(item.Menu, item.Clave);
        Nav.NavigateTo(item.RutaWeb);
    }

    private async void OnContextChanged()
    {
        if (_disposed)
            return;

        await InvokeAsync(async () =>
        {
            await LoadHomeAsync();
            StateHasChanged();
        });
    }

    private async Task LoadHomeAsync()
    {
        _loading = true;
        StateHasChanged();
        _home = await WorkspaceSvc.GetHomeAsync();
        _loading = false;
    }

    public void Dispose()
    {
        _disposed = true;
        SessionSvc.SessionChanged -= OnContextChanged;
        AppUserSession.StateChanged -= OnContextChanged;
    }
}
