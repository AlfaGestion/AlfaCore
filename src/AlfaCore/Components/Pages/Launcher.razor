@page "/"
@page "/{idweb}/{idbase:int}"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@inject AlfaCore.Services.IWorkspaceService WorkspaceSvc
@inject AlfaCore.Services.IRecentService RecentSvc
@inject AlfaCore.Services.IFavoritesService FavoritesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject ILogger<Launcher> Logger
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Inicio | Alfa Gestión</PageTitle>

@if (_loading)
{
    <AppLoadingFrame Title="Cargando sistema..."
                     Subtitle="Preparando el shell principal y las aplicaciones disponibles." />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="panel-card empty-state">
        <span class="empty-state__eyebrow">Inicio</span>
        <h1>No se pudo cargar el shell principal</h1>
        <p>@_error</p>
    </div>
}
else
{
    <div class="page-grid launcher-home">
        @if (_home.Favorites.Count > 0)
        {
            <section id="favoritos" class="panel-card launcher-section launcher-section--favorites">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Favoritos</h3>
                    </div>
                </div>
                <div class="launcher-favorites-grid">
                    @foreach (var item in _home.Favorites)
                    {
                        <article class="app-card app-card--button launcher-favorite-card" role="button" tabindex="0" @onclick="() => OpenNodeAsync(item)" @onkeydown="args => HandleNodeCardKeyDownAsync(args, item)">
                            <button type="button"
                                    class="@GetFavoriteButtonClass(item.Clave, "launcher-favorite-card__star")"
                                    title="Quitar de favoritos"
                                    aria-label="Quitar @item.Nombre de favoritos"
                                    @onclick="() => ToggleFavoriteAsync(item.Menu, item.Clave)"
                                    @onclick:stopPropagation>
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <div class="app-card__icon launcher-module-badge launcher-module-badge--lg @ShellNavigationUiHelper.GetNodeIconClass(item)">
                                <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-star-fill" : item.Icono)"></i>
                            </div>
                            <span class="app-card__name launcher-favorite-card__name">@item.Nombre</span>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_home.Recents.Count > 0)
        {
            <section id="recientes" class="panel-card launcher-section launcher-section--recents">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Recientes</h3>
                    </div>
                </div>
                <div class="launcher-recents-list">
                    @foreach (var item in _home.Recents)
                    {
                        <article class="launcher-recent-row" role="button" tabindex="0" @onclick="() => OpenNodeAsync(item)" @onkeydown="args => HandleNodeCardKeyDownAsync(args, item)">
                            <div class="app-card__icon launcher-module-badge launcher-module-badge--sm @ShellNavigationUiHelper.GetNodeIconClass(item)">
                                <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-clock-history" : item.Icono)"></i>
                            </div>
                            <div class="launcher-recent-row__body">
                                <span class="launcher-recent-row__name">@item.Nombre</span>
                                <span class="launcher-recent-row__time launcher-recent-row__time--mobile">@FormatRelativeTime(item.UltimoAcceso)</span>
                            </div>
                            <span class="launcher-recent-row__time">@FormatRelativeTime(item.UltimoAcceso)</span>
                            <button type="button"
                                    class="@GetFavoriteButtonClass(item.Clave, "launcher-recent-row__star")"
                                    title="@(IsFavorite(item.Clave) ? "Quitar de favoritos" : "Agregar a favoritos")"
                                    aria-label="@(IsFavorite(item.Clave) ? $"Quitar {item.Nombre} de favoritos" : $"Agregar {item.Nombre} a favoritos")"
                                    @onclick="() => ToggleFavoriteAsync(item.Menu, item.Clave)"
                                    @onclick:stopPropagation>
                                <i class="bi @(IsFavorite(item.Clave) ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_home.Favorites.Count == 0 && _home.Recents.Count == 0)
        {
            <section class="panel-card">
                <div class="shell-empty-state">
                    <strong>Sin accesos rápidos todavía.</strong>
                    <span>Usá el buscador del menú lateral para abrir una opción y marcarla como favorita.</span>
                </div>
            </section>
        }
    </div>
}

@code {
    private bool _loading = true;
    private ShellHomeDto _home = new();
    private string _error = string.Empty;
    private bool _disposed;
    private int _loadVersion;

    protected override void OnInitialized()
    {
        SessionSvc.SessionChanged += OnContextChanged;
        AppUserSession.StateChanged += OnContextChanged;

        if (WorkspaceSvc.TryGetCachedHome(out var cachedHome))
        {
            _home = cachedHome;
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var normalizedPath = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');
            Logger.LogInformation(
                "Launcher: first render. Uri={Uri}, RouteIdWeb={IdWeb}, RouteIdBase={IdBase}, SaaS={SaaS}, Auth={Auth}, ActiveSession={ActiveSession}",
                Nav.Uri,
                idweb ?? "(sin ruta)",
                idbase?.ToString() ?? "(sin base)",
                AppMode.IsSaaSMode,
                AppUserSession.IsAuthenticated,
                SessionSvc.GetActiveSession()?.BaseId.ToString() ?? "(sin base)");

            if (string.IsNullOrWhiteSpace(normalizedPath)
                && (!AppUserSession.IsAuthenticated || AppUserSession.RequiresInternalLogin))
            {
                var returnUrl = "/";
                Logger.LogInformation("Launcher: root without usable session, redirecting to login. ReturnUrl={ReturnUrl}", returnUrl);
                var loginTarget = string.Equals(returnUrl, "/", StringComparison.Ordinal)
                    ? "/login"
                    : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
                Nav.NavigateTo(loginTarget, replace: true);
                return;
            }

            if (!AppMode.IsSaaSMode)
            {
                if (!AppUserSession.IsAuthenticated || AppUserSession.RequiresInternalLogin)
                {
                    _loading = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            else if (!AppUserSession.IsAuthenticated || AppUserSession.RequiresInternalLogin)
            {
                _loading = false;
                Logger.LogInformation(
                    "Launcher: SaaS sin sesion lista para cargar home. Se mantiene la ruta actual. Uri={Uri}, IdWeb={IdWeb}, IdBase={IdBase}, RequiresInternalLogin={RequiresInternalLogin}",
                    Nav.Uri,
                    idweb ?? "(sin ruta)",
                    idbase?.ToString() ?? "(sin base)",
                    AppUserSession.RequiresInternalLogin);
                await InvokeAsync(StateHasChanged);
                return;
            }

            var activeSession = SessionSvc.GetActiveSession();
            var availableSessions = SessionSvc.GetAllSessions();

            if (AppMode.IsSaaSMode && activeSession is null && idbase is int routeBaseId)
            {
                var routeSession = availableSessions.FirstOrDefault(x => x.BaseId == routeBaseId);
                if (routeSession is not null)
                {
                    SessionSvc.SwitchSession(routeSession.Id);

                    try
                    {
                        await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", routeSession.Id.ToString());
                    }
                    catch
                    {
                        // Si JS no responde, la sesion en memoria ya quedo seleccionada.
                    }

                    activeSession = routeSession;
                }
                else
                {
                    _loading = false;
                    Logger.LogInformation(
                        "Launcher: no se resolvió la base para la ruta. RouteIdWeb={IdWeb}, RouteBaseId={IdBase}, Available={Available}",
                        idweb ?? "(sin ruta)",
                        routeBaseId,
                        availableSessions.Count);
                    Nav.NavigateTo(!string.IsNullOrWhiteSpace(idweb) ? $"/{Uri.EscapeDataString(idweb)}" : "/seleccionar-base", replace: true);
                    return;
                }
            }

            if (activeSession is null && availableSessions.Count == 1)
            {
                SessionSvc.SwitchSession(availableSessions[0].Id);

                try
                {
                    await JS.InvokeVoidAsync("alfaCoreSqlSession.setActive", availableSessions[0].Id.ToString());
                }
                catch
                {
                    // Si JS no responde, la sesión en memoria ya quedó seleccionada.
                }

                activeSession = availableSessions[0];
            }

            if (activeSession is null)
            {
                _loading = false;
                if (AppMode.IsSaaSMode)
                {
                    Logger.LogInformation(
                        "Launcher: active session null, redirecting. RouteIdWeb={IdWeb}, RouteIdBase={IdBase}, ReturnUrl={ReturnUrl}",
                        idweb ?? "(sin ruta)",
                        idbase?.ToString() ?? "(sin base)",
                        Nav.Uri);
                    Nav.NavigateTo(!string.IsNullOrWhiteSpace(idweb) ? $"/{Uri.EscapeDataString(idweb)}" : "/seleccionar-base", replace: true);
                }
                else
                    await InvokeAsync(StateHasChanged);
                return;
            }

            if (AppMode.IsSaaSMode)
            {
                var canonicalIdWeb = NormalizeRouteIdWeb(AppUserSession.CurrentUser?.IdWeb) ?? NormalizeRouteIdWeb(idweb);
                if (!string.IsNullOrWhiteSpace(canonicalIdWeb)
                    && (!string.Equals(idweb, canonicalIdWeb, StringComparison.OrdinalIgnoreCase)
                        || !idbase.HasValue
                        || idbase.Value != activeSession.BaseId))
                {
                    _loading = false;
                    Logger.LogInformation(
                        "Launcher: canonical home redirect. CurrentIdWeb={CurrentIdWeb}, CanonicalIdWeb={CanonicalIdWeb}, CurrentBase={CurrentBase}, ActiveBase={ActiveBase}",
                        idweb ?? "(sin ruta)",
                        canonicalIdWeb,
                        idbase?.ToString() ?? "(sin base)",
                        activeSession.BaseId);
                    Nav.NavigateTo(RouteContext.BuildRoute("/"), replace: true);
                    return;
                }
            }

            var showInitialLoader = _loading;
            var loadTask = LoadHomeAsync(showInitialLoader);
            var completedTask = await Task.WhenAny(loadTask, Task.Delay(TimeSpan.FromSeconds(15)));
            if (completedTask != loadTask)
            {
                if (!showInitialLoader)
                    return;
                _error = "No se pudo cargar el shell principal a tiempo. Revisá la base activa o intentá nuevamente.";
                _loading = false;
                return;
            }

            await loadTask;
            if (AppMode.IsSaaSMode
                && _error.Length == 0
                && _home.Modules.Count == 0
                && SessionSvc.GetActiveSession() is not null)
            {
                Logger.LogInformation(
                    "Launcher: home inicial vacío, reintentando una vez. Uri={Uri}, IdWeb={IdWeb}, IdBase={IdBase}",
                    Nav.Uri,
                    idweb ?? "(sin ruta)",
                    idbase?.ToString() ?? "(sin base)");
                await Task.Delay(300);
                await LoadHomeAsync(showLoader: false);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (NavigationException)
        {
            return;
        }
        catch
        {
            _error = "No se pudo cargar el shell principal. Revisá la base activa o intentá nuevamente.";
            _loading = false;
        }
    }

    private async Task OpenNodeAsync(ShellMenuNodeDto item)
    {
        await RecentSvc.RegisterRecentAsync(item.Menu, item.Clave);
        Nav.NavigateTo(RouteContext.BuildRoute(item.RutaWeb));
    }

    private async Task HandleNodeCardKeyDownAsync(KeyboardEventArgs args, ShellMenuNodeDto item)
    {
        if (IsActivationKey(args.Key))
            await OpenNodeAsync(item);
    }

    private bool IsFavorite(string clave)
    {
        return _home.Favorites.Any(item => string.Equals(item.Clave, clave, StringComparison.OrdinalIgnoreCase));
    }

    private string GetFavoriteButtonClass(string clave, string extraClass)
    {
        var css = $"app-card__favorite {extraClass}";
        return IsFavorite(clave) ? css + " is-active" : css;
    }

    private async Task ToggleFavoriteAsync(string menu, string clave)
    {
        await FavoritesSvc.ToggleFavoriteAsync(menu, clave);
        WorkspaceSvc.InvalidateWorkspaceCache();
        _home = await WorkspaceSvc.RefreshHomeAsync();
    }

    private static bool IsActivationKey(string? key)
    {
        return string.Equals(key, "Enter", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, " ", StringComparison.Ordinal)
            || string.Equals(key, "Space", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, "Spacebar", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatRelativeTime(DateTime? value)
    {
        if (value is null)
            return "reciente";

        var elapsed = DateTime.Now - value.Value;
        if (elapsed < TimeSpan.Zero)
            elapsed = TimeSpan.Zero;

        if (elapsed.TotalMinutes < 1)
            return "recién";

        if (elapsed.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)Math.Round(elapsed.TotalMinutes));
            return $"hace {minutes} min";
        }

        if (elapsed.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)Math.Round(elapsed.TotalHours));
            return $"hace {hours} h";
        }

        if (elapsed.TotalDays < 30)
        {
            var days = Math.Max(1, (int)Math.Round(elapsed.TotalDays));
            return days == 1 ? "ayer" : $"hace {days} días";
        }

        return value.Value.ToString("dd/MM/yyyy");
    }

    private async void OnContextChanged()
    {
        if (_disposed)
            return;

        await InvokeAsync(async () =>
        {
            if (!AppUserSession.IsAuthenticated
                || AppUserSession.RequiresInternalLogin
                || (!AppMode.IsSaaSMode && AppUserSession.RequiresInternalLogin)
                || SessionSvc.GetActiveSession() is null)
            {
                _loading = false;
                StateHasChanged();
                return;
            }

            var hasCachedHome = WorkspaceSvc.TryGetCachedHome(out var cachedHome);
            if (hasCachedHome)
            {
                _home = cachedHome;
                _loading = false;
                StateHasChanged();
            }

            await LoadHomeAsync(showLoader: !hasCachedHome);
            StateHasChanged();
        });
    }

    private async Task LoadHomeAsync(bool showLoader = true)
    {
        var version = Interlocked.Increment(ref _loadVersion);
        var hadVisibleHome = HasVisibleHome();
        if (showLoader || !hadVisibleHome)
        {
            _loading = true;
            _error = string.Empty;
            StateHasChanged();
        }

        try
        {
            var activeSession = SessionSvc.GetActiveSession();
            Logger.LogInformation(
                "Launcher: loading home. User={User}, BaseId={BaseId}, BaseName={BaseName}, ViewMode={ViewMode}",
                AppUserSession.CurrentUser?.UserName ?? "(sin usuario)",
                activeSession?.Id.ToString() ?? "(sin base)",
                activeSession?.Nombre ?? "(sin base)",
                AppMode.IsSaaSMode ? "saas" : "legacy");

            var home = showLoader || !hadVisibleHome
                ? await WorkspaceSvc.GetHomeAsync()
                : await WorkspaceSvc.RefreshHomeAsync();
            if (version != _loadVersion)
                return;

            _home = home;
            _error = string.Empty;
            Logger.LogInformation(
                "Launcher: home loaded. ModuleGroups={ModuleGroups}, Favorites={Favorites}, Recents={Recents}",
                _home.Modules.Count,
                _home.Favorites.Count,
                _home.Recents.Count);
        }
        catch (Exception ex)
        {
            if (version == _loadVersion)
            {
                if (!showLoader && hadVisibleHome)
                {
                    Logger.LogWarning(
                        ex,
                        "Launcher: background RefreshHomeAsync failed. User={User}, BaseId={BaseId}, BaseName={BaseName}",
                        AppUserSession.CurrentUser?.UserName ?? "(sin usuario)",
                        SessionSvc.GetActiveSession()?.Id.ToString() ?? "(sin base)",
                        SessionSvc.GetActiveSession()?.Nombre ?? "(sin base)");
                    return;
                }
                _error = "No se pudieron cargar los módulos del usuario. Revisá la base activa o intentá nuevamente.";
                Logger.LogWarning(
                    ex,
                    "Launcher: GetHomeAsync failed. User={User}, BaseId={BaseId}, BaseName={BaseName}",
                    AppUserSession.CurrentUser?.UserName ?? "(sin usuario)",
                    SessionSvc.GetActiveSession()?.Id.ToString() ?? "(sin base)",
                    SessionSvc.GetActiveSession()?.Nombre ?? "(sin base)");
                _home = new ShellHomeDto();
            }
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    private bool HasVisibleHome()
        => _home.Modules.Count > 0 || _home.Favorites.Count > 0 || _home.Recents.Count > 0;

    private static string? NormalizeRouteIdWeb(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var trimmed = value.Trim();
        return trimmed.Length == 0 ? null : trimmed;
    }

    public void Dispose()
    {
        _disposed = true;
        SessionSvc.SessionChanged -= OnContextChanged;
        AppUserSession.StateChanged -= OnContextChanged;
    }
}
