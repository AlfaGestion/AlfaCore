@page "/"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@inject AlfaCore.Services.IWorkspaceService WorkspaceSvc
@inject AlfaCore.Services.IRecentService RecentSvc
@inject AlfaCore.Services.IFavoritesService FavoritesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Aplicaciones | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando shell principal...
    </div>
}
else
{
    <div class="page-grid">
        <section class="page-intro">
            <div>
                <h2 class="page-intro__title">Aplicaciones</h2>
                <p class="page-intro__text">Seleccioná un módulo del ERP para entrar al nuevo shell web y abrir las aplicaciones disponibles para tu usuario.</p>
            </div>
        </section>

        @if (_home.Favorites.Count > 0)
        {
            <section id="favoritos" class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Favoritos</h3>
                        <p class="panel-card__subtitle">Accesos frecuentes preparados para el usuario actual.</p>
                    </div>
                </div>
                <div class="launcher__grid">
                    @foreach (var item in _home.Favorites)
                    {
                        <article class="app-card app-card--button" role="button" tabindex="0" @onclick="() => OpenNodeAsync(item)" @onkeydown="args => HandleNodeCardKeyDownAsync(args, item)">
                            <button type="button"
                                    class="@GetFavoriteButtonClass(item.Clave)"
                                    title="Quitar de favoritos"
                                    aria-label="Quitar @item.Nombre de favoritos"
                                    @onclick="() => ToggleFavoriteAsync(item.Menu, item.Clave)"
                                    @onclick:stopPropagation>
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <div class="app-card__icon @ShellNavigationUiHelper.GetNodeIconClass(item)">
                                <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-star-fill" : item.Icono)"></i>
                            </div>
                            <span class="app-card__name">@item.Nombre</span>
                            <span class="app-card__desc">@ShellNavigationUiHelper.GetNodeDescription(item)</span>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_home.Recents.Count > 0)
        {
            <section id="recientes" class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Recientes</h3>
                        <p class="panel-card__subtitle">Últimas aplicaciones abiertas dentro del shell.</p>
                    </div>
                </div>
                <div class="launcher__grid launcher__grid--compact">
                    @foreach (var item in _home.Recents)
                    {
                        <article class="app-card app-card--button" role="button" tabindex="0" @onclick="() => OpenNodeAsync(item)" @onkeydown="args => HandleNodeCardKeyDownAsync(args, item)">
                            <button type="button"
                                    class="@GetFavoriteButtonClass(item.Clave)"
                                    title="@(IsFavorite(item.Clave) ? "Quitar de favoritos" : "Agregar a favoritos")"
                                    aria-label="@(IsFavorite(item.Clave) ? $"Quitar {item.Nombre} de favoritos" : $"Agregar {item.Nombre} a favoritos")"
                                    @onclick="() => ToggleFavoriteAsync(item.Menu, item.Clave)"
                                    @onclick:stopPropagation>
                                <i class="bi @(IsFavorite(item.Clave) ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                            <div class="app-card__icon @ShellNavigationUiHelper.GetNodeIconClass(item)">
                                <i class="bi @(string.IsNullOrWhiteSpace(item.Icono) ? "bi-clock-history" : item.Icono)"></i>
                            </div>
                            <span class="app-card__name">@item.Nombre</span>
                            <span class="app-card__desc">@ShellNavigationUiHelper.GetNodeDescription(item)</span>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Módulos</h3>
                    <p class="panel-card__subtitle">Árbol funcional histórico de Alfa Gestión filtrado por permisos y opciones web habilitadas.</p>
                </div>
            </div>
            @if (_home.Modules.Count == 0)
            {
                <div class="shell-empty-state">
                    <strong>No hay módulos web disponibles para esta base.</strong>
                    <span>Revisá que `ALFACORE_MENU_WEB` exista, tenga datos para el `Menu` real de `TA_MENU` y que estén aplicados los updates de shell web.</span>
                </div>
            }
            else
            {
                <div class="launcher__grid">
                    @foreach (var module in _home.Modules)
                    {
                        <article class="app-card app-card--button" role="button" tabindex="0" @onclick="() => OpenModule(module)" @onkeydown="args => HandleModuleCardKeyDown(args, module)">
                            <button type="button"
                                    class="@GetFavoriteButtonClass(module.Clave)"
                                    title="@(IsFavorite(module.Clave) ? "Quitar de favoritos" : "Agregar a favoritos")"
                                    aria-label="@(IsFavorite(module.Clave) ? $"Quitar {module.Nombre} de favoritos" : $"Agregar {module.Nombre} a favoritos")"
                                    @onclick="() => ToggleFavoriteAsync(module.Menu, module.Clave)"
                                    @onclick:stopPropagation>
                                <i class="bi @(IsFavorite(module.Clave) ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                            <div class="app-card__icon @ShellNavigationUiHelper.GetModuleIconClass(module)">
                                <i class="bi @(string.IsNullOrWhiteSpace(module.Icono) ? "bi-grid-3x3-gap-fill" : module.Icono)"></i>
                            </div>
                            <span class="app-card__name">@module.Nombre</span>
                            <span class="app-card__desc">Abrí el workspace del módulo y accedé a las aplicaciones web disponibles.</span>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private ShellHomeDto _home = new();
    private bool _disposed;
    private int _loadVersion;

    protected override void OnInitialized()
    {
        SessionSvc.SessionChanged += OnContextChanged;
        AppUserSession.StateChanged += OnContextChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Task.Yield();
        await LoadHomeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenNodeAsync(ShellMenuNodeDto item)
    {
        await RecentSvc.RegisterRecentAsync(item.Menu, item.Clave);
        Nav.NavigateTo(item.RutaWeb);
    }

    private void OpenModule(ShellModuleDto module)
    {
        Nav.NavigateTo(module.RutaWeb);
    }

    private async Task HandleNodeCardKeyDownAsync(KeyboardEventArgs args, ShellMenuNodeDto item)
    {
        if (IsActivationKey(args.Key))
            await OpenNodeAsync(item);
    }

    private void HandleModuleCardKeyDown(KeyboardEventArgs args, ShellModuleDto module)
    {
        if (IsActivationKey(args.Key))
            OpenModule(module);
    }

    private bool IsFavorite(string clave)
    {
        return _home.Favorites.Any(item => string.Equals(item.Clave, clave, StringComparison.OrdinalIgnoreCase));
    }

    private string GetFavoriteButtonClass(string clave)
    {
        return IsFavorite(clave) ? "app-card__favorite is-active" : "app-card__favorite";
    }

    private async Task ToggleFavoriteAsync(string menu, string clave)
    {
        await FavoritesSvc.ToggleFavoriteAsync(menu, clave);
        _home = await WorkspaceSvc.GetHomeAsync();
    }

    private static bool IsActivationKey(string? key)
    {
        return string.Equals(key, "Enter", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, " ", StringComparison.Ordinal)
            || string.Equals(key, "Space", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, "Spacebar", StringComparison.OrdinalIgnoreCase);
    }

    private async void OnContextChanged()
    {
        if (_disposed)
            return;

        await InvokeAsync(async () =>
        {
            await LoadHomeAsync();
            StateHasChanged();
        });
    }

    private async Task LoadHomeAsync()
    {
        var version = Interlocked.Increment(ref _loadVersion);
        _loading = true;
        StateHasChanged();
        try
        {
            var home = await WorkspaceSvc.GetHomeAsync();
            if (version != _loadVersion)
                return;

            _home = home;
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        SessionSvc.SessionChanged -= OnContextChanged;
        AppUserSession.StateChanged -= OnContextChanged;
    }
}
