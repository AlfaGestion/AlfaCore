@page "/portal-cliente/cuenta-corriente/{IdComprobante:int}"
@page "/{idweb}/{idbase:int}/portal-cliente/cuenta-corriente/{IdComprobante:int}"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@inject AlfaCore.Services.IPortalClienteService PortalClienteSvc

<PageTitle>Comprobante | Portal Cliente</PageTitle>

@if (NotFound)
{
    <section class="page-grid">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver" />
}
else
{
    <section class="page-grid">
        <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                              BrandName="@GetBrandingName()"
                              LogoFrameClass="@GetBrandingLogoFrameClass()"
                              ClientLabel="@GetCurrentClientLabel()"
                              Busy="@SessionBusy"
                              OnLogout="LogoutClienteAsync"
                              ActiveTab="cuenta-corriente"
                              RouteInicio="@BuildPortalRoute("")"
                              RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                              RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                              RouteCatalogos="@BuildPortalRoute("catalogos")"
                              RouteCarrito="@BuildPortalRoute("carrito")"
                              RoutePedidos="@BuildPortalRoute("pedidos")"
                              RouteMiCuenta="@BuildPortalRoute("mi-cuenta")" />

        @if (_loading)
        {
            <section class="panel-card">
                <p class="text-muted">Cargando comprobante...</p>
            </section>
        }
        else if (_comprobante is null)
        {
            <section class="panel-card empty-state">
                <h3 class="panel-card__title">Comprobante no encontrado</h3>
                <p class="panel-card__subtitle">No existe o no pertenece a tu cuenta.</p>
                <a class="btn btn--ghost btn--sm" href="@BuildPortalRoute("cuenta-corriente")">
                    <i class="bi bi-arrow-left"></i> Volver a cuenta corriente
                </a>
            </section>
        }
        else
        {
            <section class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">@(string.IsNullOrWhiteSpace(_comprobante.TcDescripcion) ? _comprobante.Tc : _comprobante.TcDescripcion) @_comprobante.IdComprobanteTexto</h3>
                        <p class="panel-card__subtitle">@_comprobante.Fecha.ToString("dd/MM/yyyy")</p>
                    </div>
                    <a class="btn btn--ghost btn--sm" href="@BuildPortalRoute("cuenta-corriente")">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                </div>

                <div class="portal-cliente__detalle-meta">
                    <div><span>Cliente</span><strong>@_comprobante.RazonSocial</strong></div>
                    <div><span>Importe original</span><strong>@Money(_comprobante.ImporteOriginal)</strong></div>
                    @if (_comprobante.SaldoPendiente is { } saldo)
                    {
                        <div><span>Saldo pendiente</span><strong>@Money(saldo)</strong></div>
                    }
                    @if (_comprobante.Vencimiento is { } vencimiento)
                    {
                        <div><span>Vencimiento</span><strong>@vencimiento.ToString("dd/MM/yyyy")</strong></div>
                    }
                </div>
            </section>

            @if (_comprobante.Lineas.Count > 0)
            {
                <section class="panel-card">
                    <h3 class="panel-card__title">Artículos</h3>
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var linea in _comprobante.Lineas)
                                {
                                    <tr>
                                        <td>@linea.IdArticulo</td>
                                        <td>@linea.Descripcion</td>
                                        <td class="text-end">@linea.Cantidad.ToString("N2", CultureEsAr)</td>
                                        <td class="text-end">@Money(linea.PrecioUnitario)</td>
                                        <td class="text-end">@Money(linea.Subtotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
    </section>
}

@code {
    private static readonly System.Globalization.CultureInfo CultureEsAr = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    [Parameter] public int IdComprobante { get; set; }

    private CatalogoClienteLoginPanel? _loginPanel;
    private bool _loading;
    private PortalClienteComprobantePendienteDetalleDto? _comprobante;

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            await CargarAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
        => await CargarAsync();

    private async Task CargarAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // El servicio valida CodigoCliente contra la sesión autenticada — un comprobante de
            // otra cuenta devuelve null, no un error que confirme su existencia.
            var result = await UiOps.RunAsync(() => PortalClienteSvc.GetComprobanteClienteDetalleAsync(GetCurrentCodigoCliente(), IdComprobante),
                "No pudimos consultar el comprobante en este momento.");

            _comprobante = result.Success ? result.Value : null;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string Money(decimal value)
        => value.ToString("C2", CultureEsAr);
}
