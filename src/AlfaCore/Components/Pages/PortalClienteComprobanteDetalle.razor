@page "/portal-cliente/cuenta-corriente/{IdComprobante:int}"
@page "/{idweb}/{idbase:int}/portal-cliente/cuenta-corriente/{IdComprobante:int}"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@inject AlfaCore.Services.IPortalClienteService PortalClienteSvc
@inject AlfaCore.Services.IConfiguracionGeneralService ConfiguracionSvc
@inject AlfaCore.Services.IFacturaDocumentService FacturaDocumentSvc
@inject AlfaCore.Services.IDocumentTemplateService TemplateSvc
@inject AlfaCore.Services.IDocumentRenderer DocumentRenderer

<PageTitle>Comprobante | Portal Cliente</PageTitle>

@if (NotFound)
{
    <section class="page-grid portal-cliente">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver" />
}
else
{
    <section class="page-grid portal-cliente portal-cliente--detail">
        <div class="no-print">
            <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                                  BrandName="@GetBrandingName()"
                                  LogoFrameClass="@GetBrandingLogoFrameClass()"
                                  ClientLabel="@GetCurrentClientLabel()"
                                  Busy="@SessionBusy"
                                  OnLogout="LogoutClienteAsync"
                                  ActiveTab="cuenta-corriente"
                                  RouteInicio="@BuildPortalRoute("")"
                                  RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                                  RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                                  RouteCatalogos="@BuildPortalRoute("catalogos")"
                                  RouteCarrito="@BuildPortalRoute("carrito")"
                                  RoutePedidos="@BuildPortalRoute("pedidos")"
                                  RouteMiCuenta="@BuildPortalRoute("mi-cuenta")"
                                  SeccionesHabilitadas="@PortalSecciones" />
        </div>

        <div class="portal-comprobante-actions no-print">
            <a class="btn btn--ghost btn--sm" href="@BuildPortalRoute("cuenta-corriente")">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            @if (_comprobante is not null)
            {
                <button type="button" class="btn btn--primary btn--sm" @onclick="VerPdfFacturaAsync" disabled="@_generandoPdf">
                    <i class="bi bi-file-earmark-pdf"></i> Ver factura en PDF
                </button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="ImprimirAsync">
                    <i class="bi bi-printer"></i> Imprimir
                </button>
            }
        </div>

        @if (_pdfError is not null)
        {
            <div class="editor-msg editor-msg--warning no-print portal-cliente__feedback">
                <div><p>@_pdfError</p></div>
            </div>
        }

        @if (_loading)
        {
            <section class="panel-card">
                <p class="text-muted">Cargando comprobante...</p>
            </section>
        }
        else if (_comprobante is null)
        {
            <section class="panel-card empty-state">
                <h3 class="panel-card__title">Comprobante no encontrado</h3>
                <p class="panel-card__subtitle">No existe o no pertenece a tu cuenta.</p>
            </section>
        }
        else
        {
            <div class="portal-comprobante-wrap">
                @if (!string.IsNullOrWhiteSpace(_documentoHtml))
                {
                    <iframe class="portal-comprobante-document-frame" style="display:block;width:100%;max-width:820px;height:1120px;margin:0 auto;border:1px solid #d5dde5;border-radius:14px;background:#fff;" srcdoc="@_documentoHtml" title="Comprobante"></iframe>
                }
                else
                {
                    <PortalClienteComprobanteView Item="_comprobante" Empresa="_empresa" LogoUrl="@GetBrandingLogoUrl()" LogoAlt="@GetBrandingName()" />
                }
            </div>
        }
    </section>
}

@code {
    protected override string? RequiredSectionKey => "cuenta-corriente";

    [Parameter] public int IdComprobante { get; set; }

    private CatalogoClienteLoginPanel? _loginPanel;
    private bool _loading;
    private bool _generandoPdf;
    private string? _pdfError;
    private PortalClienteComprobantePendienteDetalleDto? _comprobante;
    private ConfiguracionEmpresaDto _empresa = new();
    private string? _documentoHtml;

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            await CargarAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
        => await CargarAsync();

    private async Task CargarAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // El servicio valida CodigoCliente contra la sesión autenticada — un comprobante de
            // otra cuenta devuelve null, no un error que confirme su existencia.
            var result = await UiOps.RunAsync(() => PortalClienteSvc.GetComprobanteClienteDetalleAsync(GetCurrentCodigoCliente(), IdComprobante),
                "No pudimos consultar el comprobante en este momento.");

            _comprobante = result.Success ? result.Value : null;

            if (_comprobante is not null)
            {
                try { _empresa = await ConfiguracionSvc.GetEmpresaAsync(); }
                catch { _empresa = new ConfiguracionEmpresaDto(); }
                try
                {
                    var tipo = TiposDocumentoCore.TipoParaComprobante(_comprobante.Tc, _comprobante.Letra);
                    var template = await TemplateSvc.ResolveAsync(tipo, null);
                    var definition = TemplateSvc.DeserializeAndValidate(template.TemplateJson, tipo);
                    var empresaLogo = await ConfigGeneralSvc.GetLogoBytesAsync();
                    var data = new FacturaDocumentData
                    {
                        Empresa = new EmpresaDocumentData
                        {
                            Nombre = _empresa.Nombre, Cuit = _empresa.Cuit,
                            Domicilio = string.Join(" ", new[] { _empresa.Calle, _empresa.Numero, _empresa.Piso, _empresa.Departamento }.Where(x => !string.IsNullOrWhiteSpace(x))),
                            Telefono = _empresa.Telefono, Email = _empresa.EmailWeb, Logo = empresaLogo
                        },
                        Comprobante = new FacturaComprobanteDocumentData
                        {
                            Tc = _comprobante.Tc, Letra = _comprobante.Letra, PuntoVenta = _comprobante.Sucursal,
                            Numero = _comprobante.Numero, Fecha = _comprobante.Fecha,
                            CondicionVenta = _comprobante.CondicionVentaDescripcion
                        },
                        Cliente = new FacturaClienteDocumentData
                        {
                            Codigo = _comprobante.CodigoCliente, RazonSocial = _comprobante.RazonSocial,
                            DocumentoTipoDescripcion = _comprobante.DocumentoTipo, DocumentoNumero = _comprobante.DocumentoNumero,
                            CondicionIvaDescripcion = _comprobante.CondicionIvaDescripcion, Domicilio = _comprobante.Domicilio,
                            Localidad = _comprobante.Localidad, Telefono = _comprobante.Telefono
                        },
                        Items = _comprobante.Lineas.Select(x => new FacturaDocumentItemData
                        {
                            Codigo = x.IdArticulo, Descripcion = x.Descripcion, Unidad = x.Unidad,
                            Cantidad = x.Cantidad, PrecioUnitario = x.PrecioUnitario, Bonificacion = x.Bonificacion,
                            AlicuotaIva = x.Iva, Subtotal = x.Subtotal
                        }).ToList(),
                        Totales = new FacturaTotalesDocumentData
                        {
                            NetoGravado = _comprobante.NetoGravado, NetoNoGravado = _comprobante.NetoNoGravado,
                            Total = _comprobante.ImporteOriginal
                        }
                    };
                    _documentoHtml = DocumentRenderer.RenderFactura(data: data, template: definition, cssCustom: template.CssCustom, themeKey: await TemplateSvc.GetGeneralThemeAsync(), tituloDocumento: template.Nombre);
                }
                catch
                {
                    _documentoHtml = null;
                }
            }
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ImprimirAsync()
        => Js.InvokeVoidAsync("print").AsTask();

    private async Task VerPdfFacturaAsync()
    {
        _pdfError = null;
        _generandoPdf = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(
                () => FacturaDocumentSvc.GeneratePdfParaClienteAsync(GetCurrentCodigoCliente(), IdComprobante),
                "No pudimos generar el PDF de este comprobante en este momento.");

            if (!result.Success || result.Value is not { Length: > 0 } pdf)
            {
                _pdfError = result.Success
                    ? "Este comprobante no tiene una Factura en PDF disponible. Usá \"Imprimir\" para verlo en pantalla."
                    : result.Feedback?.Message ?? "No pudimos generar el PDF de este comprobante en este momento.";
                return;
            }

            await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob", Convert.ToBase64String(pdf), "application/pdf", $"factura-{IdComprobante}.pdf");
        }
        finally
        {
            _generandoPdf = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
