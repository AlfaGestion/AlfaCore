        UpdatePageHeader();
    }

    private async Task SetStatusFilterAsync(string? value)
    {
        _filters.EstadoMeta = string.IsNullOrWhiteSpace(value) ? null : value;
        await ApplyTemplateFiltersAsync();
    }

    private async Task SetCategoryFilterAsync(string? value)
    {
        _filters.Categoria = string.IsNullOrWhiteSpace(value) ? null : value;
        await ApplyTemplateFiltersAsync();
    }

    private async Task SetIncludeInactiveFilter(bool? value)
    {
        _filters.IncluirInactivas = value is true;
        await ApplyTemplateFiltersAsync();
    }

    private async Task RemoveTemplateChipAsync(string key)
    {
        switch (key)
        {
            case "texto":
                _filters.Search = string.Empty;
                break;
            case "estado":
                _filters.EstadoMeta = null;
                break;
            case "categoria":
                _filters.Categoria = null;
                break;
            case "inactivas":
                _filters.IncluirInactivas = false;
                break;
        }

        await ApplyTemplateFiltersAsync();
    }

    private IReadOnlyList<(string Key, string Label)> BuildTemplateFilterChips()
    {
        var chips = new List<(string Key, string Label)>();
        if (!string.IsNullOrWhiteSpace(_filters.Search))
            chips.Add(("texto", _filters.Search.Trim()));
        if (!string.IsNullOrWhiteSpace(_filters.EstadoMeta))
            chips.Add(("estado", GetMetaStatusLabel(_filters.EstadoMeta)));
        if (!string.IsNullOrWhiteSpace(_filters.Categoria))
            chips.Add(("categoria", GetCategoryLabel(_filters.Categoria)));
        if (_filters.IncluirInactivas)
            chips.Add(("inactivas", "Inactivas"));
        return chips;
    }

    private async Task SyncCatalogAsync()
    {
        if (_filters.IdNumeroWhatsApp is not > 0)
        {
            SetError("Seleccioná un WhatsApp para sincronizar plantillas.");
            return;
        }

        _syncingMeta = true;
        _feedback = null;
        UpdatePageHeader();
        try
        {
            var result = await ConversacionesSvc.SyncTemplatesCatalogFromMetaAsync(_filters.IdNumeroWhatsApp, CurrentExpectedBaseIdOrNull(), _lifetimeCts.Token);
            SetFeedback("Sincronización con Meta", BuildSyncFeedback(result));
            var keepSelection = _selectedId;
            await LoadTemplatesAsync();
            if (keepSelection > 0 && _templates.Any(x => x.IdPlantilla == keepSelection))
                await SelectTemplateAsync(keepSelection);
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            _syncingMeta = false;
            UpdatePageHeader();
        }
    }

    private async Task SelectTemplateAsync(long idPlantilla)
    {
        if (!TryResolveExpectedBaseId(out var expectedBaseId) || !EnsureRouteTenantReady(expectedBaseId))
        {
            SetError("No se pudo abrir la información de esta base.");
            return;
        }

        var generation = ++_loadGeneration;
        var selectedNumeroId = _filters.IdNumeroWhatsApp;
        _busy = true;
        _feedback = null;
        _mode = PageMode.Browse;
        try
        {
            var item = await ConversacionesSvc.GetTemplateAsync(idPlantilla, expectedBaseId);
            if (!IsCurrentRequest(generation, expectedBaseId, selectedNumeroId))
                return;

            if (item is null)
            {
                SetError("La plantilla seleccionada ya no existe.");
                return;
            }

            _selectedId = item.IdPlantilla;
            _selected = item;
        }
        catch (Exception)
        {
            if (IsCurrentRequest(generation, expectedBaseId, selectedNumeroId))
                SetError("No se pudo abrir la información de esta base.");
        }
        finally
        {
            if (IsCurrentRequest(generation, expectedBaseId, selectedNumeroId))
                _busy = false;
            UpdatePageHeader();
        }
    }

    private void NuevaPlantilla()
    {
        _selectedId = 0;
        _mode = PageMode.Create;
        _form = NewForm();
        _examplesText = string.Empty;
        _formEstadoMeta = "DRAFT";
        _feedback = null;
        _attemptedSave = false;
    }

    /// <summary>
    /// Posiciones {{N}} presentes hoy en el cuerpo (no en el catálogo, en el texto real) -- de ahí
    /// sale N para la próxima variable a insertar y de ahí sale qué mostrar debajo del cuerpo.
    /// </summary>
    private static SortedSet<int> ParseBodyPlaceholderPositions(string? text)
    {
        var positions = new SortedSet<int>();
        if (string.IsNullOrWhiteSpace(text))
            return positions;

        foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(text, @"\{\{\s*(\d+)\s*\}\}"))
        {
            if (int.TryParse(match.Groups[1].Value, out var position) && position >= 1)
                positions.Add(position);
        }

        return positions;
    }

    /// <summary>Siguiente posición consecutiva válida: el primer número no usado todavía (sin gaps, sin duplicar).</summary>
    private int NextBodyVariablePosition()
    {
        var used = ParseBodyPlaceholderPositions(_form.CuerpoTexto);
        var candidate = 1;
        while (used.Contains(candidate))
            candidate++;

        return candidate;
    }

    /// <summary>
    /// Variables efectivamente presentes en el cuerpo actual (no todo el catálogo): para cada {{N}} que
    /// aparece en el texto, su Label si tiene mapping o "Valor manual" si no lo tiene (placeholder
    /// tipeado a mano o huérfano de una edición anterior). HasMapping habilita la acción "Asignar
    /// variable" en el markup para las posiciones manuales.
    /// </summary>
    private IReadOnlyList<(int Posicion, string Label, bool HasMapping)> UsedBodyVariables
        => ParseBodyPlaceholderPositions(_form.CuerpoTexto)
            .Select(position => _form.VariableMappings.TryGetValue(position, out var key)
                ? (Posicion: position, Label: WhatsAppTemplateVariableCatalog.Find(key)?.Label ?? key, HasMapping: true)
                : (Posicion: position, Label: "Valor manual", HasMapping: false))
            .ToList();

    /// <summary>
    /// Solo BODY: el selector de variables no existe para el campo Encabezado (Meta/el runtime de envío
    /// no soportan parámetros de header hoy).
    /// </summary>
    private string VariablePickerDescription
        => _variablePickerTargetPosition is int position
            ? $"Elegí la variable que corresponde a {{{{{position}}}}}. El texto del cuerpo no se modifica."
            : "Elegí una variable para agregar al cuerpo de la plantilla.";

    /// <summary>
    /// Abre el selector de variables. Sin posición (null): "Insertar variable" agrega un {{N}} nuevo al
    /// final del cuerpo. Con posición: "Asignar variable" sobre un placeholder manual existente -- solo
    /// escribe el mapping en memoria para esa posición, nunca toca el texto del BODY.
    /// </summary>
    private Task OpenVariablePickerAsync(int? targetPosition)
    {
        _variablePickerTargetPosition = targetPosition;
        _variablePickerFilter = string.Empty;
        _showVariablePicker = true;
        return Task.CompletedTask;
    }

    private Task CloseVariablePicker()
    {
        _showVariablePicker = false;
        return Task.CompletedTask;
    }

    private Task OnVariablePickerFilterChangedAsync(string? value)
    {
        _variablePickerFilter = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private void SelectVariableFromPicker(string variableKey)
    {
        if (_variablePickerTargetPosition is int position)
            _form.VariableMappings[position] = variableKey;
        else
            InsertCatalogVariable(variableKey);

        _showVariablePicker = false;
    }

    /// <summary>
    /// Grupos del catálogo que aparecen en el selector como seleccionables (solo
    /// CanResolveAutomaticallyInManualSend == true), filtrados por el texto de búsqueda contra Label y
    /// Description. Nunca incluye variables de Tareas/Guardia: esas quedan en
    /// <see cref="FilteredContextualVariables"/>, no seleccionables desde este flujo manual.
    /// </summary>
    private List<IGrouping<string, WhatsAppTemplateVariableDefinition>> FilteredSelectableVariableGroups()
        => WhatsAppTemplateVariableCatalog.All
            .Where(x => x.CanResolveAutomaticallyInManualSend && MatchesVariablePickerFilter(x))
            .GroupBy(x => x.Group)
            .ToList();

    /// <summary>
    /// Variables con CanResolveAutomaticallyInManualSend == false (Tareas/Guardia): se muestran en una
    /// sección aparte, no clickeable, con su RequiredContext explicando cuándo se resuelven -- nunca
    /// insertables desde Plantillas para que el usuario no crea que son automáticas acá.
    /// </summary>
    private List<WhatsAppTemplateVariableDefinition> FilteredContextualVariables()
        => WhatsAppTemplateVariableCatalog.All
            .Where(x => !x.CanResolveAutomaticallyInManualSend && MatchesVariablePickerFilter(x))
            .ToList();

    private bool MatchesVariablePickerFilter(WhatsAppTemplateVariableDefinition definition)
    {
        var filter = _variablePickerFilter.Trim();
        if (filter.Length == 0)
            return true;

        return definition.Label.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || definition.Description.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || definition.Group.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    private void InsertCatalogVariable(string variableKey)
    {
        var position = NextBodyVariablePosition();
        var placeholder = $"{{{{{position}}}}}";
        _form.CuerpoTexto = string.IsNullOrWhiteSpace(_form.CuerpoTexto)
            ? placeholder
            : $"{_form.CuerpoTexto}{Environment.NewLine}{placeholder}";
        _form.VariableMappings[position] = variableKey;
    }

    /// <summary>
    /// Se ejecuta después de cada edición manual del cuerpo (blur del textarea, ver @bind:after). Si el
    /// usuario borró un placeholder {{N}}, descarta su mapping en memoria -- así, si más tarde
    /// reaparece el mismo número (tipeado a mano, sin pasar por "Insertar variable"), no hereda por
    /// accidente la VariableKey vieja de una variable distinta que ocupó esa posición antes.
    /// </summary>
    private void PruneOrphanVariableMappings()
    {
        var positions = ParseBodyPlaceholderPositions(_form.CuerpoTexto);
        foreach (var orphanPosition in _form.VariableMappings.Keys.Where(p => !positions.Contains(p)).ToList())
            _form.VariableMappings.Remove(orphanPosition);
    }

    private async Task SaveAsync()
    {
        _attemptedSave = true;
        if (!CanSaveDraft)
        {
            SetError("Completá nombre, nombre Meta y cuerpo antes de guardar.");
            return;
        }

        _busy = true;
        _feedback = null;
        try
        {
            var id = await ConversacionesSvc.SaveTemplateDraftAsync(BuildSaveRequest());

            SetFeedback("Plantilla guardada", "La plantilla se guardó correctamente.");
            await LoadTemplatesAsync();
            _mode = PageMode.Browse;
            await SelectTemplateAsync(id);
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            _busy = false;
            UpdatePageHeader();
        }
    }

    private async Task SubmitAsync()
    {
        _attemptedSave = true;

        _busy = true;
        _feedback = null;
        try
        {
            if (IsBodyTooLong)
            {
                SetError($"Meta permite hasta {MetaBodyMaxLength} caracteres en el cuerpo. Acortá el texto antes de enviarlo a aprobación.");
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.NombreVisible) ||
                string.IsNullOrWhiteSpace(_form.NombreMeta) ||
                string.IsNullOrWhiteSpace(_form.CuerpoTexto))
            {
                SetError("Completá nombre, nombre Meta y cuerpo antes de enviar a aprobación.");
                return;
            }

            var savedId = await ConversacionesSvc.SaveTemplateDraftAsync(BuildSaveRequest());
            _selectedId = savedId;

            await ConversacionesSvc.SubmitTemplateForApprovalAsync(new ConversacionPlantillaSubmitRequest
            {
                IdPlantilla = savedId,
                IdNumeroWhatsApp = _filters.IdNumeroWhatsApp
            });

            SetFeedback("Plantilla enviada a aprobación", "Meta revisará la plantilla antes de habilitarla para el envío.");
            await LoadTemplatesAsync();
            _mode = PageMode.Browse;
            await SelectTemplateAsync(_selectedId);
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            _busy = false;
            UpdatePageHeader();
        }
    }

    // Enviar a aprobación desde READ (sin pasar por Editar primero): SubmitAsync guarda y envía
    // usando _form, así que lo poblamos desde la plantilla seleccionada antes de reutilizarlo,
    // para no enviar datos desactualizados ni duplicar la validación/guardado que ya hace SubmitAsync.
    private async Task SubmitSelectedAsync()
    {
        if (_selected is null || !CanSubmitSelectedForApproval)
            return;

        _form = CloneTemplate(_selected);
        _examplesText = ExamplesToText(_selected.EjemplosVariablesJson);
        await SubmitAsync();
    }

    private ConversacionPlantillaSaveRequest BuildSaveRequest()
    {
        PruneOrphanVariableMappings();
        return new()
        {
            IdPlantilla = _selectedId,
            IdNumeroWhatsApp = _filters.IdNumeroWhatsApp,
            NombreVisible = _form.NombreVisible,
            NombreMeta = _form.NombreMeta,
            Categoria = _form.Categoria,
            Idioma = _form.Idioma,
            EncabezadoTexto = _form.EncabezadoTexto,
            CuerpoTexto = _form.CuerpoTexto,
            PieTexto = _form.PieTexto,
            EjemplosVariablesJson = _examplesText,
            Activa = _form.Activa,
            VariableMappings = new Dictionary<int, string>(_form.VariableMappings)
        };
    }

    private async Task SyncAsync()
    {
        if (_selectedId <= 0)
            return;

        _busy = true;
        _feedback = null;
        try
        {
            await ConversacionesSvc.SyncTemplateStatusAsync(_selectedId, _filters.IdNumeroWhatsApp);
            SetFeedback("Estado sincronizado", "El estado de la plantilla se actualizó con la información de Meta.");
            await LoadTemplatesAsync();
            await SelectTemplateAsync(_selectedId);
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            _busy = false;
            UpdatePageHeader();
        }
    }

    private void OpenArchiveConfirm()
    {
        if (_selected is null || !_selected.Activa)
            return;

        _showArchiveConfirm = true;
        _feedback = null;
    }

    private void CloseArchiveConfirm()
    {
        if (_busy)
            return;

        _showArchiveConfirm = false;
    }

    private async Task ArchiveAsync()
    {
        if (_selectedId <= 0 || _selected is null || !_selected.Activa)
            return;

        _busy = true;
        _feedback = null;
        try
        {
            await ConversacionesSvc.ArchiveTemplateAsync(_selectedId, _filters.IdNumeroWhatsApp);
            SetFeedback("Plantilla archivada", "La plantilla quedó archivada y no se ofrecerá para enviar en conversaciones.");
            _showArchiveConfirm = false;
            var archivedId = _selectedId;
            await LoadTemplatesAsync();
            if (_filters.IncluirInactivas && _templates.Any(x => x.IdPlantilla == archivedId))
                await SelectTemplateAsync(archivedId);
            else
            {
                _selectedId = 0;
                _selected = null;
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            _busy = false;
            UpdatePageHeader();
        }
    }

    private void ClearFeedback()
        => _feedback = null;

    private void SetFeedback(string title, string message, AppUiFeedbackSeverity severity = AppUiFeedbackSeverity.Success)
    {
        var suggestion = HasBeenSubmittedToMeta
            ? "Esta plantilla ya fue enviada a Meta. Sincronizá para consultar su estado actual."
            : string.Empty;

        _feedback = new AppUiMessage
        {
            Severity = severity,
            Title = title,
            Message = message,
            Suggestion = suggestion
        };
    }

    private void SetError(string message)
    {
        _feedback = new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Error,
            Title = "No se pudo completar la acción",
            Message = message
        };
    }

    private void SetError(Exception ex)
    {
        var internalCode = ex is AlfaCore.Services.AppUserFacingException appError
            ? appError.ErrorCode
            : ExtractInternalCode(ex.Message);

        if (TryGetMetaError(ex, out var metaError))
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Error,
                Title = "Meta rechazó la solicitud",
                Message = BuildMetaErrorSummary(metaError, internalCode),
                Suggestion = BuildMetaErrorDetail(metaError, internalCode)
            };
            return;
        }

        _feedback = new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Error,
            Title = "No se pudo completar la acción",
            Message = ex.Message
        };
    }

    private static string BuildMetaErrorSummary(MetaApiError error, string? internalCode)
    {
        var title = FirstText(error.UserTitle, error.Message, "Meta rechazo la solicitud.");
        var parts = new List<string> { $"Meta rechazo la solicitud: {title}" };

        if (error.Code is not null)
        {
            var code = error.Subcode is null
                ? $"Codigo Meta {error.Code}"
                : $"Codigo Meta {error.Code}, subcodigo {error.Subcode}";
            parts.Add(code);
        }

        if (!string.IsNullOrWhiteSpace(internalCode))
            parts.Add($"Codigo interno AlfaCore {internalCode}");

        return string.Join(". ", parts) + ".";
    }

    private static string BuildMetaErrorDetail(MetaApiError error, string? internalCode)
    {
        var lines = new List<string>();
        var meaning = GetMetaErrorMeaning(error);
        if (!string.IsNullOrWhiteSpace(meaning))
        {
            lines.Add("Que significa");
            lines.Add(meaning);
            lines.Add(string.Empty);
        }

        var fix = GetMetaErrorFix(error);
        if (!string.IsNullOrWhiteSpace(fix))
        {
            lines.Add("Como resolverlo");
            lines.Add(fix);
            lines.Add(string.Empty);
        }

        lines.Add("Detalle tecnico");
        if (error.Code is not null)
            lines.Add($"Codigo Meta: {error.Code}");
        if (error.Subcode is not null)
            lines.Add($"Subcodigo Meta: {error.Subcode}");
        if (!string.IsNullOrWhiteSpace(error.Type))
            lines.Add($"Tipo: {error.Type}");
        if (!string.IsNullOrWhiteSpace(error.FbTraceId))
            lines.Add($"fbtrace_id: {error.FbTraceId}");
        if (!string.IsNullOrWhiteSpace(internalCode))
            lines.Add($"Codigo interno AlfaCore: {internalCode}");
        if (error.IsTransient is not null)
            lines.Add($"Transitorio: {(error.IsTransient.Value ? "si" : "no")}");

        return string.Join(Environment.NewLine, lines);
    }

    private static string GetMetaErrorMeaning(MetaApiError error)
    {
        if (error.Code == 100 && error.Subcode == 2388024)
            return "Esta plantilla ya existe en Meta para este idioma.";

        if (!string.IsNullOrWhiteSpace(error.UserMessage))
            return error.UserMessage;

        if (error.Subcode == 2388299)
            return "Meta no permite que una plantilla empiece o termine con variables como {{1}}.";

        if (error.Code == 100)
            return "Meta marco algun parametro de la plantilla como invalido.";

        return FirstText(error.Message, "Meta rechazo la solicitud y devolvio un error sin descripcion de usuario.");
    }

    private static string GetMetaErrorFix(MetaApiError error)
    {
        if (error.Code == 100 && error.Subcode == 2388024)
            return "Sincronizá las plantillas para actualizar su estado.";

        if (error.Subcode == 2388299)
            return "Agrega texto fijo antes y despues de cada variable que quede al principio o al final del cuerpo. Ejemplo valido: \"La tarea {{1}} fue asignada a {{2}}.\"";

        if (error.Code == 100)
            return "Revisa nombre Meta, idioma, categoria, cuerpo, variables y ejemplos. Si Meta envio un subcodigo, usalo para identificar el campo exacto.";

        return "Revisa los datos de la plantilla y reintenta. Si el problema sigue, usa el fbtrace_id para buscar el incidente en Meta.";
    }

    private static bool TryGetMetaError(Exception ex, out MetaApiError error)
    {
        for (var current = ex; current is not null; current = current.InnerException)
        {
            if (TryExtractMetaJson(current.Message, out var json) && TryParseMetaError(json, out error))
                return true;
        }

        error = default!;
        return false;
    }

    private static bool TryExtractMetaJson(string message, out string json)
    {
        var start = message.IndexOf("{\"error\"", StringComparison.OrdinalIgnoreCase);
        if (start < 0)
        {
            json = string.Empty;
            return false;
        }

        var end = message.LastIndexOf('}');
        if (end <= start)
        {
            json = string.Empty;
            return false;
        }

        json = message[start..(end + 1)];
        return true;
    }

    private static bool TryParseMetaError(string json, out MetaApiError error)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (!doc.RootElement.TryGetProperty("error", out var errorElement))
            {
                error = default!;
                return false;
            }

            error = new MetaApiError(
                GetJsonString(errorElement, "message"),
                GetJsonString(errorElement, "type"),
                GetJsonInt(errorElement, "code"),
                GetJsonInt(errorElement, "error_subcode"),
                GetJsonString(errorElement, "error_user_title"),
                GetJsonString(errorElement, "error_user_msg"),
                GetJsonString(errorElement, "fbtrace_id"),
                GetJsonBool(errorElement, "is_transient"));
            return true;
        }
        catch
        {
            error = default!;
            return false;
        }
    }

    private static string? GetJsonString(System.Text.Json.JsonElement element, string property)
        => element.TryGetProperty(property, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.GetString()
            : null;

    private static int? GetJsonInt(System.Text.Json.JsonElement element, string property)
        => element.TryGetProperty(property, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.Number && value.TryGetInt32(out var number)
            ? number
            : null;

    private static bool? GetJsonBool(System.Text.Json.JsonElement element, string property)
        => element.TryGetProperty(property, out var value) && (value.ValueKind == System.Text.Json.JsonValueKind.True || value.ValueKind == System.Text.Json.JsonValueKind.False)
            ? value.GetBoolean()
            : null;

    private static string? ExtractInternalCode(string message)
    {
        var markers = new[] { "Codigo:", "Código:", "Código:" };
        var marker = markers.FirstOrDefault(value => message.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0);
        if (marker is null)
            return null;

        var index = message.IndexOf(marker, StringComparison.OrdinalIgnoreCase);

        var code = message[(index + marker.Length)..].Trim();
        return string.IsNullOrWhiteSpace(code) ? null : code;
    }

    private static string FirstText(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private sealed record MetaApiError(
        string? Message,
        string? Type,
        int? Code,
        int? Subcode,
        string? UserTitle,
        string? UserMessage,
        string? FbTraceId,
        bool? IsTransient);

