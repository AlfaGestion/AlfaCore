        => (value ?? string.Empty).ToUpperInvariant() switch
        {
            "APPROVED" => AlfaTagTone.Success,
            "PENDING" => AlfaTagTone.Warning,
            "REJECTED" or "DISABLED" => AlfaTagTone.Danger,
            "PAUSED" => AlfaTagTone.Warning,
            _ => AlfaTagTone.Neutral
        };

