    private void UpdatePageHeader()
    {
        var actions = _mode switch
        {
            PageMode.Create => BuildCreateActions(),
            PageMode.Edit => BuildEditActions(),
            _ => BuildBrowseActions()
        };

        PageHeader.Set(new PageHeaderConfig
        {
            Title = "Plantillas",
            Breadcrumb = ["Conversaciones", "Plantillas"],
            State = _mode switch
            {
                PageMode.Create => PageHeaderState.Creating,
                PageMode.Edit => PageHeaderState.Editing,
                _ => _loading || _syncingMeta ? PageHeaderState.Loading : PageHeaderState.List
            },
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems(),
            Search = _mode == PageMode.Browse ? new PageHeaderSearchConfig() : null,
            SearchContent = _mode == PageMode.Browse ? RenderTemplatesSmartSearch() : null,
            Actions = actions
        });
        _ = InvokeAsync(StateHasChanged);
    }

    private List<PageHeaderAction> BuildBrowseActions()
    {
        var actions = new List<PageHeaderAction>
        {
            new() { Key = "nuevo", Label = "Nueva plantilla", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy || _loading, OnClick = () => EnterCreateModeAsync() },
            new() { Key = "sincronizar-meta", Label = _syncingMeta ? "Sincronizando..." : "Sincronizar con Meta", Icon = "bi-arrow-repeat", Style = PageHeaderActionStyle.Secondary, Priority = PageHeaderActionPriority.Essential, Disabled = _loading || _busy || _syncingMeta || _filters.IdNumeroWhatsApp is not > 0, Busy = _syncingMeta, OnClick = SyncCatalogAsync }
        };

        if (_selected is not null)
        {
            // Con una plantilla seleccionada, "Editar" y (para drafts locales pendientes de envío)
            // "Enviar a aprobación" son las acciones principales del registro y quedan visibles.
            // "Sincronizar estado" y "Archivar" son secundarias/menos frecuentes (Archivar además
            // es destructiva) y bajan al menú "..." junto con los accesos rápidos, para no acumular
            // demasiados botones simultáneos en la toolbar (ver auditoría visual).
            if (CanSubmitSelectedForApproval)
                actions.Add(new() { Key = "enviar-aprobacion", Label = "Enviar a aprobación", Icon = "bi-cloud-arrow-up-fill", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = SubmitSelectedAsync });
            if (CanEditSelected)
                actions.Add(new() { Key = "editar", Label = "Editar", Icon = "bi-pencil", Style = PageHeaderActionStyle.Secondary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = () => EnterEditModeAsync() });
            if (CanSyncSelected)
                actions.Add(new() { Key = "sincronizar-item", Label = "Sincronizar estado", Icon = "bi-arrow-repeat", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, Disabled = _busy, OnClick = SyncAsync });
            if (_selected.Activa)
                actions.Add(new() { Key = "archivar", Label = "Archivar", Icon = "bi-archive", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow, Disabled = _busy, OnClick = () => { OpenArchiveConfirm(); return Task.CompletedTask; } });
        }

        actions.Add(new() { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, Disabled = _loading, OnClick = () => LoadTemplatesAsync() });

        return actions;
    }

    private List<PageHeaderAction> BuildCreateActions()
        =>
        [
            new() { Key = "guardar-borrador", Label = "Guardar borrador", Icon = "bi-save-fill", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = SaveAsync },
            new() { Key = "enviar-aprobacion", Label = "Enviar a aprobación", Icon = "bi-cloud-arrow-up-fill", Style = PageHeaderActionStyle.Secondary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = SubmitAsync },
            new() { Key = "cancelar", Label = "Cancelar", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = () => { CancelForm(); return Task.CompletedTask; } }
        ];

    private List<PageHeaderAction> BuildEditActions()
    {
        var actions = new List<PageHeaderAction>
        {
            new() { Key = "guardar", Label = "Guardar", Icon = "bi-save-fill", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = SaveAsync }
        };

        // Edit sólo se alcanza para drafts locales aún no enviados (CanEditSelected lo garantiza
        // al entrar), así que si sigue sin enviarse mientras se edita, ofrecemos guardar+enviar
        // en un solo paso -- igual que ya existía para Create.
        if (!HasBeenSubmittedToMeta)
            actions.Add(new() { Key = "enviar-aprobacion", Label = "Enviar a aprobación", Icon = "bi-cloud-arrow-up-fill", Style = PageHeaderActionStyle.Secondary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = SubmitAsync });

        actions.Add(new() { Key = "cancelar", Label = "Cancelar", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = () => { CancelForm(); return Task.CompletedTask; } });

        return actions;
    }

    private IReadOnlyList<PageHeaderTopNavItem> BuildTopNavigationItems()
    {
        // Contactos/Clientes se sacaron a propósito: son páginas con su propio menú superior
        // (Contactos, y Clientes vía CuentasComercialesPage -- compartido con Proveedores), y entrar
        // ahí desde acá pisaba este menú con el suyo, dejando la navegación inconsistente.
        var items = new List<PageHeaderTopNavItem>
        {
            BuildTopNavItem("conversaciones", "Conversaciones", "/conversaciones")
        };

        items.Add(new() { Key = "plantillas", Label = "Plantillas", Url = RouteContext.BuildRoute("/conversaciones/plantillas"), Active = true });
        items.Add(BuildTopNavItem("configuracion", "Configuración", "/conversaciones/configuracion"));
        items.Add(BuildTopNavItem("estadisticas", "Estadísticas", "/conversaciones/estadisticas"));
        items.Add(BuildTopNavItem("informes", "Informes", "/conversaciones/informes"));

        return items;
    }

    private PageHeaderTopNavItem BuildTopNavItem(string key, string label, string route)
    {
        var url = RouteContext.BuildRoute(route);
        return new PageHeaderTopNavItem
        {
            Key = key,
            Label = label,
            Url = url,
            OnClick = () =>
            {
                Nav.NavigateTo(url);
                return Task.CompletedTask;
            }
        };
    }

    private async Task LoadTemplatesAsync(int? existingGeneration = null)
    {
        if (!TryResolveExpectedBaseId(out var expectedBaseId))
        {
            ResetTenantData();
            _loadError = "No se pudo abrir la información de esta base.";
            return;
        }

        if (!EnsureRouteTenantReady(expectedBaseId))
        {
            ResetTenantData();
            _loadError = "No se pudo abrir la información de esta base.";
            return;
        }

        var generation = existingGeneration ?? ++_loadGeneration;
        var selectedNumeroId = _filters.IdNumeroWhatsApp;
        _filters.ExpectedBaseId = expectedBaseId;
        _loading = true;
        _loadError = null;
        _allTemplates = [];
        _templates = [];
        try
        {
            var filters = BuildCurrentFilters();
            var loaded = (await ConversacionesSvc.GetTemplatesAsync(filters)).ToList();
            if (!IsCurrentRequest(generation, expectedBaseId, selectedNumeroId))
                return;

            _allTemplates = loaded;
            _templates = _allTemplates.ToList();
            if (_selectedId > 0 && _templates.All(x => x.IdPlantilla != _selectedId))
            {
                _selectedId = 0;
                _selected = null;
            }
        }
        catch (Exception)
        {
            if (IsCurrentRequest(generation, expectedBaseId, selectedNumeroId))
                _loadError = "No se pudo abrir la información de esta base.";
        }
        finally
        {
            if (IsCurrentRequest(generation, expectedBaseId, selectedNumeroId))
                _loading = false;
        }
    }

    private async Task EnterCreateModeAsync()
    {
        _filters = new ConversacionPlantillaFilters { ExpectedBaseId = CurrentExpectedBaseIdOrNull(), IdNumeroWhatsApp = _filters.IdNumeroWhatsApp };
        await LoadTemplatesAsync();
        NuevaPlantilla();
        UpdatePageHeader();
    }

    private async Task EnterEditModeAsync()
    {
        if (_selected is null || !CanEditSelected)
            return;

        _form = CloneTemplate(_selected);
        _examplesText = ExamplesToText(_selected.EjemplosVariablesJson);
        _formEstadoMeta = string.IsNullOrWhiteSpace(_selected.EstadoMeta) ? "DRAFT" : _selected.EstadoMeta;
        _attemptedSave = false;
        _feedback = null;
        _mode = PageMode.Edit;
        UpdatePageHeader();
        await Task.CompletedTask;
    }

    private void CancelForm()
    {
        _mode = PageMode.Browse;
        _form = NewForm();
        _examplesText = string.Empty;
        _attemptedSave = false;
        UpdatePageHeader();
    }

    private async Task HandleSearchEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await LoadTemplatesAsync();
    }

    private async Task ClearTemplateFiltersAsync()
    {
        _filters = new ConversacionPlantillaFilters { ExpectedBaseId = CurrentExpectedBaseIdOrNull(), IdNumeroWhatsApp = _filters.IdNumeroWhatsApp };
        _showTemplatesSearchPanel = false;
        UpdatePageHeader();
        await LoadTemplatesAsync();
    }

    private async Task ApplyTemplateFiltersAsync()
    {
        _showTemplatesSearchPanel = false;
        UpdatePageHeader();
        await LoadTemplatesAsync();
    }

