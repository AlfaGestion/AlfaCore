    private string VariableLabel(int index)
    {
        if (EsFormularioTareas)
            return index switch
            {
                1 => "Titulo de tarea",
                2 => "Tecnico asignado",
                3 => EsPlantillaTareaFinalizada(_form) ? "Finalizada por" : "Asignada por",
                4 => "Fecha y hora",
                _ => $"Dato {index}"
            };

        return index switch
        {
            1 => "Nombre",
            2 => EsFormularioFacturaMantenimiento ? "Periodo" : "Detalle de deuda",
            3 => EsFormularioFacturaMantenimiento ? "Detalle factura" : "Forma de pago",
            _ => $"Dato {index}"
        };
    }

    private static string RenderPreview(string text, IReadOnlyList<string> values)
    {
        var result = string.IsNullOrWhiteSpace(text) ? "Escribí el cuerpo de la plantilla." : text;
        for (var i = 0; i < values.Count; i++)
            result = result.Replace("{{" + (i + 1) + "}}", values[i], StringComparison.Ordinal);

        return result;
    }

    private static List<string> ParseExamples(string value)
        => ParseMultilineValues(value);

    private static string ExamplesToText(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return string.Empty;

        try
        {
            var values = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? [];
            return JoinMultilineValues(values);
        }
        catch
        {
            return json;
        }
    }

    private static List<string> ParseMultilineValues(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return [];

        var normalized = value.Replace("\r\n", "\n").Replace('\r', '\n');
        if (normalized.Split('\n').Any(x => string.Equals(x.Trim(), MultiValueSeparator, StringComparison.Ordinal)))
        {
            var result = new List<string>();
            var current = new List<string>();

            foreach (var line in normalized.Split('\n'))
            {
                if (string.Equals(line.Trim(), MultiValueSeparator, StringComparison.Ordinal))
                {
                    AddBlock(result, current);
                    current.Clear();
                    continue;
                }

                current.Add(line);
            }

            AddBlock(result, current);
            return result;
        }

        return normalized
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .ToList();
    }

    private static string JoinMultilineValues(IEnumerable<string> values)
        => string.Join($"{Environment.NewLine}{MultiValueSeparator}{Environment.NewLine}",
            values.Select(x => (x ?? string.Empty).Trim()).Where(x => x.Length > 0));

    private static void AddBlock(List<string> result, List<string> lines)
    {
        var block = string.Join(Environment.NewLine, lines).Trim();
        if (block.Length > 0)
            result.Add(block);
    }

    private static string GetMetaStatusLabel(string value)
        => (value ?? string.Empty).ToUpperInvariant() switch
        {
            "DRAFT" => "Borrador",
            "PENDING" => "Pendiente",
            "APPROVED" => "Aprobada",
            "REJECTED" => "Rechazada",
            "PAUSED" => "Pausada",
            "DISABLED" => "Deshabilitada",
            _ => DisplayOrFallback(value)
        };

    private static string GetCategoryLabel(string value)
        => string.Equals(value, ConversacionPlantillaCategorias.Utility, StringComparison.OrdinalIgnoreCase)
            ? "Utilidad"
            : "Marketing";

    private void AplicarFiltroModeloSeleccionado()
    {
        _templates = _crearSeleccion switch
        {
            CrearOpciones.Factura => _allTemplates.Where(EsPlantillaFacturaMantenimiento).ToList(),
            CrearOpciones.Cobranza => _allTemplates.Where(EsPlantillaCobranza).ToList(),
            CrearOpciones.TareaAsignada => _allTemplates.Where(EsPlantillaTareaAsignada).ToList(),
            CrearOpciones.TareaFinalizada => _allTemplates.Where(EsPlantillaTareaFinalizada).ToList(),
            CrearOpciones.Plantilla => _allTemplates
                .Where(x => !EsPlantillaFacturaMantenimiento(x) && !EsPlantillaCobranza(x) && !EsPlantillaTareas(x))
                .ToList(),
            _ => _allTemplates.ToList()
        };
    }

    private static bool EsPlantillaFacturaMantenimiento(ConversacionPlantillaDto item)
    {
        var text = $"{item.NombreVisible} {item.NombreMeta} {item.CuerpoTexto}".ToUpperInvariant();
        return text.Contains("FACTURA", StringComparison.Ordinal)
               && (text.Contains("MANTENIMIENTO", StringComparison.Ordinal)
                   || text.Contains("SOPORTE", StringComparison.Ordinal));
    }

    private static bool EsPlantillaCobranza(ConversacionPlantillaDto item)
    {
        var text = $"{item.NombreVisible} {item.NombreMeta} {item.CuerpoTexto}".ToUpperInvariant();
        return !EsPlantillaFacturaMantenimiento(item)
               && !EsPlantillaTareas(item)
               && (text.Contains("DEUDA", StringComparison.Ordinal)
                   || text.Contains("COBRANZA", StringComparison.Ordinal)
                   || text.Contains("TRANSFERENCIA", StringComparison.Ordinal));
    }

    private static bool EsPlantillaTareas(ConversacionPlantillaDto item)
        => EsPlantillaTareaAsignada(item) || EsPlantillaTareaFinalizada(item);

    private static bool EsPlantillaTareaAsignada(ConversacionPlantillaDto item)
    {
        var text = $"{item.NombreVisible} {item.NombreMeta} {item.CuerpoTexto}".ToUpperInvariant();
        return text.Contains("TAREA_ASIGNADA", StringComparison.Ordinal)
               || (text.Contains("TAREA", StringComparison.Ordinal) && text.Contains("ASIGNADA", StringComparison.Ordinal));
    }

    private static bool EsPlantillaTareaFinalizada(ConversacionPlantillaDto item)
    {
        var text = $"{item.NombreVisible} {item.NombreMeta} {item.CuerpoTexto}".ToUpperInvariant();
        return text.Contains("TAREA_FINALIZADA", StringComparison.Ordinal)
               || (text.Contains("TAREA", StringComparison.Ordinal) && text.Contains("FINALIZADA", StringComparison.Ordinal));
    }

    private static string FormatDate(DateTime value)
        => value == DateTime.MinValue ? "--" : value.ToString("dd/MM HH:mm");

    private static string DisplayOrFallback(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Sin dato" : value.Trim();

    private static bool IsInitializationPending(string message)
        => message.Contains("CONV_PLANTILLAS", StringComparison.OrdinalIgnoreCase)
           || message.Contains("CONV_*", StringComparison.OrdinalIgnoreCase)
           || message.Contains("inicializado", StringComparison.OrdinalIgnoreCase);

