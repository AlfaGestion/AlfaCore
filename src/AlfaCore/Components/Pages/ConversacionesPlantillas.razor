@page "/conversaciones/plantillas"
@page "/{idweb}/{idbase:int}/conversaciones/plantillas"
@inject AlfaCore.Services.IConversacionesService ConversacionesSvc
@inject AlfaCore.Services.IConversacionesConfigService ConfigSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IAppSessionInitialization SessionInitialization
@inject AlfaCore.Services.ITenantIdentityReadiness TenantIdentityReadiness
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable
@using AlfaCore.Models

<PageTitle>Plantillas de WhatsApp | Alfa Gestión</PageTitle>

<section class="templates-v1" @onclick="CloseTemplatesSearchPanel">
    <AlfaNotification Message="@_feedback" OnDismiss="ClearFeedback" />
    @if (_loadError is not null)
    {
        <div class="panel-card empty-state">
            <span class="empty-state__eyebrow">Plantillas</span>
            <h3>No fue posible cargar las plantillas</h3>
            <p>@_loadError</p>
            @if (IsInitializationPending(_loadError))
            {
                <p>Ejecutá <code>docs/conversaciones_modelo_inicial.sql</code> en la base activa y recargá esta pantalla.</p>
            }
        </div>
    }
    else if (_mode is PageMode.Create or PageMode.Edit)
    {
        <section class="panel-card templates-form-shell" aria-label="@(_mode == PageMode.Create ? "Nueva plantilla" : "Editar plantilla")">
            <header class="templates-form-shell__header">
                <div>
                    <h2 class="panel-card__title">@(_mode == PageMode.Create ? "Nueva plantilla" : "Editar plantilla")</h2>
                    <p class="panel-card__subtitle">Idioma fijo: español de Argentina. El teléfono se toma siempre desde la conversación seleccionada al enviar.</p>
                </div>
                <AlfaTag Tone="@GetMetaStatusTone(_formEstadoMeta)">@GetMetaStatusLabel(_formEstadoMeta)</AlfaTag>
            </header>

            <div class="templates-form-shell__body">
                <div class="conversations-composer templates-form">
                    <AlfaInput Label="Nombre visible"
                               Required="true"
                               Value="@_form.NombreVisible"
                               ValueChanged="@(value => _form.NombreVisible = value ?? string.Empty)"
                               Placeholder="Ej: Retomar conversación"
                               ErrorText="@NombreVisibleError"
                               Disabled="@_busy" />
                    <AlfaInput Label="Nombre Meta"
                               Required="true"
                               Value="@_form.NombreMeta"
                               ValueChanged="@(value => _form.NombreMeta = value ?? string.Empty)"
                               Placeholder="retomar_conversacion"
                               ErrorText="@NombreMetaError"
                               Disabled="@_busy" />
                    <AlfaSelect Label="Categoría"
                                Value="@_form.Categoria"
                                ValueChanged="@(value => _form.Categoria = value ?? ConversacionPlantillaCategorias.Marketing)"
                                Options="@FormCategoryOptions"
                                Disabled="@_busy" />
                    <AlfaInput Label="Encabezado de texto"
                               MaxLength="60"
                               Value="@_form.EncabezadoTexto"
                               ValueChanged="@(value => _form.EncabezadoTexto = value ?? string.Empty)"
                               Placeholder="Opcional"
                               Disabled="@_busy" />
                    <div class="alfa-field @(IsBodyTooLong ? "has-error" : string.Empty)">
                        <div class="templates-body-label-row">
                            <label class="alfa-field__label" for="tpl-body">Cuerpo<span aria-hidden="true">*</span></label>
                            <div class="templates-insert-variable">
                                <AlfaButton Variant="AlfaButtonVariant.Ghost"
                                            Size="AlfaSize.Sm"
                                            Icon="bi bi-plus-lg"
                                            Disabled="@_busy"
                                            OnClick="_ => OpenVariablePickerAsync(null)">Insertar variable</AlfaButton>
                            </div>
                        </div>
                        <textarea id="tpl-body" class="alfa-textarea__control" rows="6" disabled="@_busy" @bind="_form.CuerpoTexto" @bind:after="PruneOrphanVariableMappings"
                                  placeholder="Escribí el contenido de la plantilla..."></textarea>
                        <div class="templates-body-limit @(IsBodyTooLong ? "is-danger" : string.Empty)">
                            <span>@BodyLength / @MetaBodyMaxLength caracteres</span>
                        </div>
                        @if (CuerpoTextoError is not null)
                        {
                            <div class="alfa-field__message alfa-field__message--error">@CuerpoTextoError</div>
                        }
                        @{ var usedVariables = UsedBodyVariables; }
                        @if (usedVariables.Count > 0)
                        {
                            <div class="templates-variable-guide" aria-label="Variables usadas en el cuerpo">
                                <span class="context-card__label">Variables usadas</span>
                                @foreach (var used in usedVariables)
                                {
                                    <span class="templates-variable-chip-group">
                                        <span class="templates-variable-chip templates-variable-chip--readonly">@($"{{{{{used.Posicion}}}}} {used.Label}")</span>
                                        @if (!used.HasMapping)
                                        {
                                            <button type="button"
                                                    class="templates-variable-chip__assign"
                                                    disabled="@_busy"
                                                    @onclick="() => OpenVariablePickerAsync(used.Posicion)">Asignar variable</button>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <AlfaInput Label="Pie de página"
                               MaxLength="60"
                               Value="@_form.PieTexto"
                               ValueChanged="@(value => _form.PieTexto = value ?? string.Empty)"
                               Placeholder="Opcional"
                               Disabled="@_busy" />
                    <div class="alfa-field">
                        <label class="alfa-field__label" for="tpl-examples">Ejemplos para variables</label>
                        <textarea id="tpl-examples" class="alfa-textarea__control" rows="3" disabled="@_busy" @bind="_examplesText"
                                  placeholder="Un valor por línea. Ej: Evelyn"></textarea>
                    </div>
                    <AlfaCheckbox Value="@_form.Activa" ValueChanged="@(value => _form.Activa = value is true)" Disabled="@_busy">Plantilla activa</AlfaCheckbox>
                </div>

                <aside class="panel-card conversations-context templates-preview">
                    <div class="conversations-context__section">
                        <h3 class="panel-card__title">Vista previa</h3>
                        <p class="panel-card__subtitle">Así se verá el cuerpo principal con ejemplos.</p>
                    </div>
                    <article class="message-card message-card--outgoing">
                        @if (!string.IsNullOrWhiteSpace(_form.EncabezadoTexto))
                        {
                            <strong>@_form.EncabezadoTexto</strong>
                        }
                        <p class="message-card__text">@PreviewBody</p>
                        @if (!string.IsNullOrWhiteSpace(_form.PieTexto))
                        {
                            <div class="message-card__footer">@_form.PieTexto</div>
                        }
                    </article>
                    <div class="context-card">
                        <span class="context-card__label">Estado</span>
                        <strong>@GetMetaStatusLabel(_formEstadoMeta)</strong>
                        <span class="context-card__muted">@DisplayOrFallback(_form.MetaTemplateId)</span>
                        @if (!string.IsNullOrWhiteSpace(_form.MetaRechazoMotivo))
                        {
                            <span class="context-card__muted">@_form.MetaRechazoMotivo</span>
                        }
                    </div>
                </aside>
            </div>
            <div class="templates-scroll-spacer" aria-hidden="true"></div>
        </section>
    }
    else
    {
        <div class="templates-layout templates-layout--alfadesign">
            <aside class="panel-card conversations-list templates-list">
                <div class="conversations-list__header">
                    <div>
                        <h3 class="panel-card__title">Plantillas</h3>
                    </div>
                </div>

                @if (_loading)
                {
                    <div class="loading">Cargando plantillas...</div>
                }
                else if (_templates.Count == 0 && _allTemplates.Count > 0)
                {
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults"
                                    Title="Ninguna plantilla coincide con el filtro actual."
                                    Message="Probá con otros criterios o limpiá los filtros para ver el catálogo completo."
                                    ActionLabel="Limpiar filtros"
                                    ActionIcon="bi bi-eraser"
                                    OnAction="_ => ClearTemplateFiltersAsync()" />
                }
                else if (_templates.Count == 0)
                {
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoData"
                                    Title="Todavía no hay plantillas sincronizadas en AlfaCore."
                                    Message="Sincronizá el catálogo desde Meta o creá una plantilla nueva."
                                    ActionLabel="Sincronizar con Meta"
                                    ActionIcon="bi bi-arrow-repeat"
                                    OnAction="_ => SyncCatalogAsync()" />
                    <div class="templates-empty-secondary">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-plus-circle" OnClick="_ => EnterCreateModeAsync()">Nueva plantilla</AlfaButton>
                    </div>
                }
                else
                {
                    <div class="conversations-list__items">
                        @foreach (var item in _templates)
                        {
                            <button type="button"
                                    class="conversation-row @(item.IdPlantilla == _selectedId ? "is-selected" : string.Empty)"
                                    @onclick="() => SelectTemplateAsync(item.IdPlantilla)">
                                <div class="conversation-row__top">
                                    <span class="conversation-row__name">@item.NombreVisible</span>
                                    <span class="conversation-row__date">@FormatDate(item.FechaHoraModificacion ?? item.FechaHoraGrabacion)</span>
                                </div>
                                <div class="conversation-row__meta">
                                    <span>@item.NombreMeta</span>
                                    <span>• @item.Idioma</span>
                                </div>
                                <div class="conversation-row__badges">
                                    <AlfaTag Tone="@GetMetaStatusTone(item.EstadoMeta)">@GetMetaStatusLabel(item.EstadoMeta)</AlfaTag>
                                    <AlfaTag>@GetCategoryLabel(item.Categoria)</AlfaTag>
                                    <AlfaTag Tone="AlfaTagTone.Neutral">@(item.EsMetaRemota ? "Meta" : "Local")</AlfaTag>
                                </div>
                                <p class="conversation-row__summary">@item.CuerpoTexto</p>
                            </button>
                        }
                    </div>

                    <footer class="alfa-data-view-footer">
                        <span class="alfa-data-view-footer__summary">@BuildListSummary()</span>
                    </footer>
                }
            </aside>

            <section class="templates-main">
                @if (_busy && _selected is null)
                {
                    <AlfaEmptyState Title="Cargando plantilla" Message="Estamos consultando la ficha en la base activa." />
                }
                else if (_selected is null)
                {
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoData"
                                    Title="Seleccioná una plantilla"
                                    Message="Elegí una plantilla del listado para ver su ficha, o creá una plantilla nueva."
                                    ActionLabel="Nueva plantilla"
                                    ActionIcon="bi bi-plus-circle"
                                    OnAction="_ => EnterCreateModeAsync()" />
                }
                else
                {
                    var selected = _selected;
                    <article class="panel-card templates-record">
                        <header class="templates-record__header">
                            <div>
                                <h2>@selected.NombreVisible</h2>
                                <p class="panel-card__subtitle">@selected.NombreMeta</p>
                            </div>
                            <div class="templates-record__tags">
                                <AlfaTag Tone="@GetMetaStatusTone(selected.EstadoMeta)">@GetMetaStatusLabel(selected.EstadoMeta)</AlfaTag>
                                <AlfaTag>@GetCategoryLabel(selected.Categoria)</AlfaTag>
                                <AlfaTag Tone="@(selected.Activa ? AlfaTagTone.Success : AlfaTagTone.Neutral)">@(selected.Activa ? "Activa" : "Archivada")</AlfaTag>
                                @* Mismo criterio que la etiqueta de origen en el listado (Meta/Local, sin
                                   prefijo "Origen:"): el contexto (agrupada junto a Estado/Categoría/Activa)
                                   ya es inequívoco, y repetir la palabra sumaba ruido visual sin aportar info. *@
                                <AlfaTag Tone="AlfaTagTone.Neutral">@(selected.EsMetaRemota ? "Meta" : "Local")</AlfaTag>
                            </div>
                        </header>

                        <div class="templates-record__layout">
                            <div class="templates-record__fields">
                                @ReadField("Nombre Meta", selected.NombreMeta)
                                @ReadField("Identificador Meta", DisplayOrFallback(selected.MetaTemplateId))
                                @if (!string.IsNullOrWhiteSpace(selected.MetaRechazoMotivo))
                                {
                                    @ReadLongField("Motivo de rechazo (Meta)", selected.MetaRechazoMotivo, danger: true)
                                }
                                @ReadField("Idioma", selected.Idioma)
                                @ReadField("Categoría", GetCategoryLabel(selected.Categoria))
                                @ReadField("Encabezado (HEADER)", DisplayOrFallback(selected.EncabezadoTexto))
                                @ReadLongField("Cuerpo (BODY)", DisplayOrFallback(selected.CuerpoTexto))
                                @ReadField("Pie (FOOTER)", DisplayOrFallback(selected.PieTexto))
                                @ReadField("Botones (BUTTONS)", FormatButtons(selected.ComponentesMetaJson))
                                @ReadField("Variables / ejemplos", FormatExamplesSummary(selected.EjemplosVariablesJson))
                                @ReadField("Origen", selected.EsMetaRemota ? "Sincronizada desde Meta" : "Creada en AlfaCore")
                                @ReadField("Última sincronización", FormatSync(selected.FechaHoraSincronizacion))
                                @ReadField("Última modificación", FormatDate(selected.FechaHoraModificacion ?? selected.FechaHoraGrabacion))
                            </div>

                            <aside class="panel-card conversations-context templates-preview">
                                <div class="conversations-context__section">
                                    <h3 class="panel-card__title">Vista previa</h3>
                                    <p class="panel-card__subtitle">Cuerpo con los primeros ejemplos disponibles.</p>
                                </div>
                                <article class="message-card message-card--outgoing">
                                    @if (!string.IsNullOrWhiteSpace(selected.EncabezadoTexto))
                                    {
                                        <strong>@selected.EncabezadoTexto</strong>
                                    }
                                    <p class="message-card__text">@RenderPreviewFor(selected)</p>
                                    @if (!string.IsNullOrWhiteSpace(selected.PieTexto))
                                    {
                                        <div class="message-card__footer">@selected.PieTexto</div>
                                    }
                                </article>
                            </aside>
                        </div>
                    </article>
                    <div class="templates-scroll-spacer" aria-hidden="true"></div>
                }
            </section>
        </div>
    }

    <AlfaConfirmDialog Open="@_showArchiveConfirm"
                        Title="Archivar plantilla"
                        Message="@($"“{_selected?.NombreVisible}” dejará de estar activa y no se ofrecerá para enviar en conversaciones.")"
                        ConfirmLabel="Archivar"
                        CancelLabel="Cancelar"
                        LoadingLabel="Archivando..."
                        Loading="@_busy"
                        OnConfirm="ArchiveAsync"
                        OnCancel="CloseArchiveConfirm" />

    <AlfaDialog Open="@_showVariablePicker"
                Title="Insertar variable"
                Description="@VariablePickerDescription"
                Size="AlfaDialogSize.Sm"
                OnClose="CloseVariablePicker">
        <div class="variable-picker">
            <AlfaInput Class="variable-picker__filter"
                       Placeholder="Buscar variable..."
                       Value="@_variablePickerFilter"
                       ValueChanged="OnVariablePickerFilterChangedAsync" />

            @{ var selectableGroups = FilteredSelectableVariableGroups(); }
            @{ var contextualVariables = FilteredContextualVariables(); }

            @if (selectableGroups.Count == 0 && contextualVariables.Count == 0)
            {
                <p class="variable-picker__empty">No se encontraron variables que coincidan con la búsqueda.</p>
            }

            @foreach (var group in selectableGroups)
            {
                <div class="variable-picker__group">
                    <h4 class="variable-picker__group-title">@group.Key</h4>
                    @foreach (var definition in group)
                    {
                        <button type="button"
                                class="variable-picker__option"
                                @onclick="() => SelectVariableFromPicker(definition.Key)">
                            <span class="variable-picker__option-label">@definition.Label</span>
                            <span class="variable-picker__option-description">@definition.Description</span>
                            @if (!string.IsNullOrWhiteSpace(definition.Detail))
                            {
                                <span class="variable-picker__option-detail">@definition.Detail</span>
                            }
                        </button>
                    }
                </div>
            }

            @if (contextualVariables.Count > 0)
            {
                <div class="variable-picker__group variable-picker__group--contextual">
                    <h4 class="variable-picker__group-title">No disponibles desde este envío</h4>
                    @foreach (var definition in contextualVariables)
                    {
                        <div class="variable-picker__option" aria-disabled="true">
                            <span class="variable-picker__option-label">@definition.Label</span>
                            <span class="variable-picker__option-description">@definition.RequiredContext</span>
                        </div>
                    }
                </div>
            }
        </div>
    </AlfaDialog>
</section>

@code {
    private enum PageMode
    {
        Browse,
        Create,
        Edit
    }

    private ConversacionPlantillaFilters _filters = new();
    private IReadOnlyList<ConversacionWhatsAppNumeroDto> _whatsappNumeros = [];
    private List<ConversacionPlantillaDto> _allTemplates = [];
    private List<ConversacionPlantillaDto> _templates = [];
    private ConversacionPlantillaDto _form = NewForm();
    private ConversacionPlantillaDto? _selected;
    private PageMode _mode = PageMode.Browse;
    private long _selectedId;
    private bool _loading;
    private bool _busy;
    private bool _syncingMeta;
    private bool _showTemplatesSearchPanel;
    private bool _attemptedSave;
    private bool _showArchiveConfirm;
    private bool _showVariablePicker;
    private string _variablePickerFilter = string.Empty;
    private int? _variablePickerTargetPosition;
    private string _examplesText = string.Empty;
    private string _formEstadoMeta = "DRAFT";
    private string? _loadError;
    private AppUiMessage? _feedback;
    private int _loadGeneration;
    private bool _syncingRouteTenant;
    private readonly CancellationTokenSource _lifetimeCts = new();

    private const string MultiValueSeparator = "---";
    private const int MetaBodyMaxLength = 550;

    private string PreviewBody => RenderPreview(_form.CuerpoTexto, ParseExamples(_examplesText), _form.VariableMappings);
    private int BodyLength => _form.CuerpoTexto?.Length ?? 0;
    private bool IsBodyTooLong => BodyLength > MetaBodyMaxLength;

    private bool CanSaveDraft
        => !_busy
           && !string.IsNullOrWhiteSpace(_form.NombreVisible)
           && !string.IsNullOrWhiteSpace(_form.NombreMeta)
           && !string.IsNullOrWhiteSpace(_form.CuerpoTexto);

    private bool HasBeenSubmittedToMeta => EntityHasBeenSubmittedToMeta(_form);

    private bool CanSubmitForApproval
        => !_busy
           && _selectedId > 0
           && !IsBodyTooLong
           && CanSubmitDraftForApproval(_form);

    private bool CanEditSelected
        => _selected is not null && !EntityHasBeenSubmittedToMeta(_selected);

    private bool CanSubmitSelectedForApproval
        => !_busy && CanSubmitDraftForApproval(_selected);

    private bool CanSyncSelected
        => CanSyncTemplateStatus(_selected);

    // Draft local, activo y aún no enviado a Meta: es el único caso donde "Enviar a aprobación"
    // tiene sentido desde READ (sin pasar antes por Editar). Las plantillas sincronizadas desde
    // Meta (EsMetaRemota) nunca corresponde reenviarlas. Estática y tomando el DTO para poder
    // testearla sin renderizar el componente (ver AlfaCore.Tests).
    internal static bool CanSubmitDraftForApproval(ConversacionPlantillaDto? dto)
        => dto is not null
           && dto.Activa
           && !dto.EsMetaRemota
           && !EntityHasBeenSubmittedToMeta(dto);

    // Sin MetaTemplateId no hay nada que consultarle a Meta todavía: la plantilla nunca fue enviada.
    internal static bool CanSyncTemplateStatus(ConversacionPlantillaDto? dto)
        => dto is not null && !string.IsNullOrWhiteSpace(dto.MetaTemplateId);

    private string? NombreVisibleError
        => _attemptedSave && string.IsNullOrWhiteSpace(_form.NombreVisible) ? "El nombre visible es obligatorio." : null;

    private string? NombreMetaError
        => _attemptedSave && string.IsNullOrWhiteSpace(_form.NombreMeta) ? "El nombre Meta es obligatorio." : null;

    private string? CuerpoTextoError
    {
        get
        {
            if (!_attemptedSave)
                return null;
            if (string.IsNullOrWhiteSpace(_form.CuerpoTexto))
                return "El cuerpo de la plantilla es obligatorio.";
            if (IsBodyTooLong)
                return $"Meta permite hasta {MetaBodyMaxLength} caracteres en el cuerpo.";
            return null;
        }
    }

    private static readonly IReadOnlyList<AlfaSelectOption> FormCategoryOptions =
    [
        new(ConversacionPlantillaCategorias.Marketing, "Marketing"),
        new(ConversacionPlantillaCategorias.Utility, "Utilidad")
    ];

    protected override void OnInitialized()
    {
        UpdatePageHeader();
        SessionSvc.SessionChanged += OnTenantContextChanged;
        AppUserSession.StateChanged += OnTenantContextChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await CompleteProtectedLoadAsync();
    }

    private async Task CompleteProtectedLoadAsync()
    {
        try
        {
            await SessionInitialization.WaitUntilReadyAsync(_lifetimeCts.Token);
            if (!AppUserSession.IsAuthenticated)
            {
                NavigateToLoginPreservingCurrentUrl();
                return;
            }

            var tenantIdentityState = await TenantIdentityReadiness.WaitForTenantIdentityReadyAsync(_lifetimeCts.Token);
            if (tenantIdentityState == AlfaCore.Services.TenantIdentityState.Unauthenticated)
            {
                NavigateToLoginPreservingCurrentUrl();
                return;
            }

            await LoadRouteTenantAsync();
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
        }
    }

    private void NavigateToLoginPreservingCurrentUrl()
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(relative)}", replace: true);
    }

    private async Task LoadRouteTenantAsync()
    {
        var generation = ++_loadGeneration;
        ResetTenantData();
        _loading = true;
        _loadError = null;

        if (!TryResolveExpectedBaseId(out var expectedBaseId))
        {
            _loadError = "No se pudo abrir la información de esta base.";
            _loading = false;
            return;
        }

        if (!EnsureRouteTenantReady(expectedBaseId))
        {
            if (generation == _loadGeneration)
            {
                _loadError = "No se pudo abrir la información de esta base.";
                _loading = false;
            }
            return;
        }

        try
        {
            var numeros = await ConfigSvc.GetWhatsAppNumerosAsync(expectedBaseId);
            if (!IsCurrentRequest(generation, expectedBaseId, null))
                return;

            _whatsappNumeros = numeros;
            _filters = new ConversacionPlantillaFilters { ExpectedBaseId = expectedBaseId };

            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
            if (query.TryGetValue("idNumero", out var idNumeroRaw)
                && int.TryParse(idNumeroRaw.ToString(), out var idNumero)
                && TemplateWhatsAppNumeros.Any(x => x.IdNumero == idNumero))
                _filters.IdNumeroWhatsApp = idNumero;
            else
                _filters.IdNumeroWhatsApp = TemplateWhatsAppNumeros.FirstOrDefault()?.IdNumero;

            await LoadTemplatesAsync(generation);
        }
        catch (Exception)
        {
            if (generation == _loadGeneration)
                _loadError = "No se pudo abrir la información de esta base.";
        }
        finally
        {
            if (generation == _loadGeneration)
                _loading = false;
        }
    }

    private bool TryResolveExpectedBaseId(out int? expectedBaseId)
    {
        expectedBaseId = null;
        if (idbase > 0)
        {
            expectedBaseId = idbase;
            return true;
        }

        return !AppMode.IsSaaSMode;
    }

    private bool EnsureRouteTenantReady(int? expectedBaseId)
    {
        if (expectedBaseId is not > 0)
            return true;

        var active = SessionSvc.GetActiveSession();
        if (active?.BaseId == expectedBaseId.Value)
            return AppUserSession.IsAuthorizedForSession(active.Id);

        var routeSession = SessionSvc.GetAllSessions().FirstOrDefault(x => x.BaseId == expectedBaseId.Value);
        if (routeSession is null)
            return false;

        try
        {
            _syncingRouteTenant = true;
            SessionSvc.SwitchSession(routeSession.Id);
        }
        finally
        {
            _syncingRouteTenant = false;
        }

        active = SessionSvc.GetActiveSession();
        return active?.BaseId == expectedBaseId.Value
               && AppUserSession.IsAuthorizedForSession(active.Id);
    }

    private bool IsCurrentRequest(int generation, int? expectedBaseId, int? selectedNumeroId)
    {
        if (generation != _loadGeneration)
            return false;

        if (!TryResolveExpectedBaseId(out var currentExpectedBaseId) || currentExpectedBaseId != expectedBaseId)
            return false;

        return selectedNumeroId is null || _filters.IdNumeroWhatsApp == selectedNumeroId;
    }

    private void ResetTenantData()
    {
        _whatsappNumeros = [];
        _allTemplates = [];
        _templates = [];
        _filters = new ConversacionPlantillaFilters();
        _selectedId = 0;
        _selected = null;
        _form = NewForm();
        _mode = PageMode.Browse;
        _examplesText = string.Empty;
        _formEstadoMeta = "DRAFT";
        _feedback = null;
        _showArchiveConfirm = false;
        _showVariablePicker = false;
        _variablePickerFilter = string.Empty;
        _variablePickerTargetPosition = null;
        _attemptedSave = false;
    }

    private void OnTenantContextChanged()
    {
        if (_syncingRouteTenant)
            return;

        _ = InvokeAsync(CompleteProtectedLoadAsync);
    }

    private int? CurrentExpectedBaseIdOrNull()
        => TryResolveExpectedBaseId(out var expectedBaseId) ? expectedBaseId : null;

    private ConversacionPlantillaFilters BuildCurrentFilters()
        => new()
        {
            ExpectedBaseId = CurrentExpectedBaseIdOrNull(),
            IdNumeroWhatsApp = _filters.IdNumeroWhatsApp,
            Search = _filters.Search,
            EstadoMeta = _filters.EstadoMeta,
            Categoria = _filters.Categoria,
            Idioma = _filters.Idioma,
            IncluirInactivas = _filters.IncluirInactivas
        };

    private IReadOnlyList<ConversacionWhatsAppNumeroDto> TemplateWhatsAppNumeros
        => _whatsappNumeros
            .Where(x => x.Activo && !string.IsNullOrWhiteSpace(x.PhoneNumberId))
            .Where(x => AppUserSession.CurrentUser?.SuperAdmin == true
                        || x.Usuarios.Count == 0
                        || x.Usuarios.Contains(AppUserSession.CurrentUser?.UserName ?? string.Empty, StringComparer.OrdinalIgnoreCase))
            .OrderBy(x => x.Nombre, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static string GetWhatsAppNumeroLabel(ConversacionWhatsAppNumeroDto numero)
        => string.Join(" · ", new[] { numero.Nombre, numero.WebDisplayName, numero.WebPhoneNumber }
            .Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase));

    private async Task OnWhatsAppNumeroChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var idNumero)
            || !TemplateWhatsAppNumeros.Any(x => x.IdNumero == idNumero))
            return;

        var generation = ++_loadGeneration;
        _filters.IdNumeroWhatsApp = idNumero;
        _filters.ExpectedBaseId = CurrentExpectedBaseIdOrNull();
        _selectedId = 0;
        _selected = null;
        _mode = PageMode.Browse;
        _allTemplates = [];
        _templates = [];
        await LoadTemplatesAsync(generation);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Se reafirma acá (no solo en OnInitializedAsync): si se navega desde otra pantalla
        // AlfaDesign, el Dispose() de esa página anterior -- que hace PageHeader.Clear() -- puede
        // correr DESPUÉS del OnInitializedAsync de esta, pisando el header recién seteado.
        // OnAfterRender corre estrictamente después de ese commit de render, así que volver a
        // setearlo acá gana esa carrera de forma confiable (mismo patrón que Conversaciones.razor).
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        _lifetimeCts.Cancel();
        SessionSvc.SessionChanged -= OnTenantContextChanged;
        AppUserSession.StateChanged -= OnTenantContextChanged;
        PageHeader.Clear();
        _lifetimeCts.Dispose();
    }

