    {
        _showTemplatesSearchPanel = true;
        UpdatePageHeader();
    }

    private void ToggleTemplatesSearchPanel()
    {
        _showTemplatesSearchPanel = !_showTemplatesSearchPanel;
        UpdatePageHeader();
    }

    private void CloseTemplatesSearchPanel()
    {
        if (!_showTemplatesSearchPanel)
            return;

        _showTemplatesSearchPanel = false;
        UpdatePageHeader();
    }

    private void OnTemplatesSearchInput(ChangeEventArgs e)
    {
        _filters.Search = Convert.ToString(e.Value) ?? string.Empty;
