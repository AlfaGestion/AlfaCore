        => (value ?? string.Empty).ToUpperInvariant() switch
        {
            "DRAFT" => "Borrador",
            "PENDING" => "Pendiente de revisión por Meta",
            "APPROVED" => "Aprobada",
            "REJECTED" => "Rechazada",
            "PAUSED" => "Pausada",
            "DISABLED" => "Deshabilitada",
            _ => DisplayOrFallback(value)
        };

