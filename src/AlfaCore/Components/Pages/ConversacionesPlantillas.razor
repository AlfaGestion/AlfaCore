        => estadoMeta?.Trim().ToUpperInvariant() is "PENDING" or "APPROVED" or "REJECTED" or "PAUSED" or "DISABLED";

    private static bool EntityHasBeenSubmittedToMeta(ConversacionPlantillaDto dto)
        => !string.IsNullOrWhiteSpace(dto.MetaTemplateId) || IsSubmittedMetaState(dto.EstadoMeta);

