    private static string FormatDate(DateTime value)
        => value == DateTime.MinValue ? "--" : value.ToString("dd/MM HH:mm");

    private static string FormatSync(DateTime? value)
        => value is null || value == DateTime.MinValue ? "Nunca sincronizada" : value.Value.ToString("dd/MM/yyyy HH:mm");

