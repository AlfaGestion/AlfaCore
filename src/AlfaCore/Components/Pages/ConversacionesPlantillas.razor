    private static string FormatButtons(string componentesJson)
    {
        var labels = ExtractButtonLabels(componentesJson);
        return labels.Count == 0 ? "Sin botones" : string.Join(" · ", labels);
    }

    private static IReadOnlyList<string> ExtractButtonLabels(string componentesJson)
    {
        if (string.IsNullOrWhiteSpace(componentesJson))
            return [];

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(componentesJson);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
                return [];

            foreach (var component in doc.RootElement.EnumerateArray())
            {
                if (!component.TryGetProperty("type", out var typeElement)
                    || !string.Equals(typeElement.GetString(), "BUTTONS", StringComparison.OrdinalIgnoreCase))
                    continue;

                if (!component.TryGetProperty("buttons", out var buttonsElement)
                    || buttonsElement.ValueKind != System.Text.Json.JsonValueKind.Array)
                    continue;

                var labels = new List<string>();
                foreach (var button in buttonsElement.EnumerateArray())
                {
                    var text = button.TryGetProperty("text", out var textElement) ? textElement.GetString() : null;
                    var type = button.TryGetProperty("type", out var typeButtonElement) ? typeButtonElement.GetString() : null;
                    labels.Add(string.IsNullOrWhiteSpace(text) ? (type ?? "Botón") : text!);
                }

                return labels;
            }
        }
        catch
        {
            // Componentes inválidos o incompletos: se muestra "Sin botones".
        }

        return [];
    }

    private static bool IsInitializationPending(string message)
        => message.Contains("CONV_PLANTILLAS", StringComparison.OrdinalIgnoreCase)
           || message.Contains("CONV_*", StringComparison.OrdinalIgnoreCase)
           || message.Contains("inicializado", StringComparison.OrdinalIgnoreCase);

    private static RenderFragment ReadField(string label, string value) => @<div class="templates-record-field">
        <span>@label</span>
        <strong class="@(string.IsNullOrWhiteSpace(value) || value == "Sin dato" ? "is-empty" : string.Empty)">@value</strong>
    </div>;

    private static RenderFragment ReadLongField(string label, string value, bool danger = false) => @<div class="templates-record-field templates-record-field--long @(danger ? "templates-record-field--danger" : string.Empty)">
        <span>@label</span>
        <p>@value</p>
    </div>;
}
