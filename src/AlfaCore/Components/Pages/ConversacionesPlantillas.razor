    /// <summary>
    /// Vista previa del cuerpo: nunca modifica el BODY real ni lo persistido, solo el texto mostrado en
    /// el bloque "Vista previa". Para cada {{N}} presente en el texto, en orden de prioridad: (1) el
    /// ejemplo cargado si existe (comportamiento histórico, sin cambios), (2) si no hay ejemplo pero la
    /// posición tiene mapping automático, el Label del catálogo entre llaves (ej. "{{Nombre del
    /// contacto}}"), (3) si es manual sin mapping, "{{Valor N}}". El textarea de edición sigue mostrando
    /// siempre la sintaxis Meta real ({{1}}, {{2}}) -- este tratamiento "humanizado" es exclusivo de la
    /// preview.
    /// </summary>
    private static string RenderPreview(string text, IReadOnlyList<string> values, IReadOnlyDictionary<int, string> mappings)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "La vista previa aparecerá cuando escribas el contenido.";

        var result = text;
        foreach (var position in ParseBodyPlaceholderPositions(text))
        {
            var placeholder = $"{{{{{position}}}}}";
            var hasExample = position >= 1 && position <= values.Count && !string.IsNullOrWhiteSpace(values[position - 1]);
            string replacement;
            if (hasExample)
                replacement = values[position - 1];
            else if (mappings.TryGetValue(position, out var key) && WhatsAppTemplateVariableCatalog.Find(key) is { } definition)
                replacement = $"{{{{{definition.Label}}}}}";
            else
                replacement = $"{{{{Valor {position}}}}}";

            result = result.Replace(placeholder, replacement, StringComparison.Ordinal);
        }

        return result;
    }

    private static string RenderPreviewFor(ConversacionPlantillaDto dto)
        => RenderPreview(dto.CuerpoTexto, ParseExamples(ExamplesToText(dto.EjemplosVariablesJson)), dto.VariableMappings);

    private static List<string> ParseExamples(string value)
        => ParseMultilineValues(value);

    private static string ExamplesToText(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return string.Empty;

        try
        {
            var values = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? [];
            return JoinMultilineValues(values);
        }
        catch
        {
            return json;
        }
    }

    private static string FormatExamplesSummary(string json)
    {
        var text = ExamplesToText(json);
        var values = ParseMultilineValues(text);
        return values.Count == 0 ? "Sin ejemplos cargados" : string.Join(" · ", values.Select((v, i) => $"{{{{{i + 1}}}}} {Truncate(v, 40)}"));
    }

    private static string Truncate(string value, int maxLength)
        => value.Length <= maxLength ? value : value[..maxLength].TrimEnd() + "…";

    private static List<string> ParseMultilineValues(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return [];

        var normalized = value.Replace("\r\n", "\n").Replace('\r', '\n');
        if (normalized.Split('\n').Any(x => string.Equals(x.Trim(), MultiValueSeparator, StringComparison.Ordinal)))
        {
            var result = new List<string>();
            var current = new List<string>();

            foreach (var line in normalized.Split('\n'))
            {
                if (string.Equals(line.Trim(), MultiValueSeparator, StringComparison.Ordinal))
                {
                    AddBlock(result, current);
                    current.Clear();
                    continue;
                }

                current.Add(line);
            }

            AddBlock(result, current);
            return result;
        }

        return normalized
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .ToList();
    }

    private static string JoinMultilineValues(IEnumerable<string> values)
        => string.Join($"{Environment.NewLine}{MultiValueSeparator}{Environment.NewLine}",
            values.Select(x => (x ?? string.Empty).Trim()).Where(x => x.Length > 0));

    private static void AddBlock(List<string> result, List<string> lines)
    {
        var block = string.Join(Environment.NewLine, lines).Trim();
        if (block.Length > 0)
            result.Add(block);
    }

