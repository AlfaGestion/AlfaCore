@page "/admin"
@page "/{idweb}/{idbase:int}/admin"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ICentralAdminService AdminSvc
@inject AlfaCore.Services.ICentralCompraIaService CompraIaSvc
@inject AlfaCore.Services.IConversacionesHabilitacionService ConversacionesHabilitacionSvc
@inject AlfaCore.Services.IWorkerAssignmentService WorkerAssignmentSvc
@inject AlfaCore.Services.IPlanesService PlanesSvc
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Administrar | AlfaNet</PageTitle>

@* Administrar → Clientes (AlfaDesign v1, 2026-10-07). Todo lo que se graba acá impacta en
   ALFA_CENTRAL (compartida por staging y producción): las acciones que cortan servicio, borran
   datos o cambian qué servidor/bases procesan los workers piden confirmación (ConfirmAsync). *@

<AlfaNotification Message="@Feedback" OnDismiss="DismissFeedback" />

<div class="adm-page">
    <div class="adm">
        @if (!IsSuperAdmin)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="Acceso restringido" Message="Solo los superadmin pueden acceder a esta sección." />
        }
        else if (_loading)
        {
            <AlfaEmptyState Title="Cargando administración central" Message="Buscando clientes, usuarios y bases." />
        }
        else
        {
            <header class="adm-header">
                <div>
                    <h2>Clientes</h2>
                    <p>Cuentas de ALFA_CENTRAL con sus usuarios, bases y módulos. Buscá arriba en el encabezado y seleccioná un cliente para ver el detalle.</p>
                </div>
            </header>

            <section class="adm-card" aria-label="Infraestructura">
                <div class="adm-card__header">
                    <div>
                        <h3>Infraestructura</h3>
                        <p>Con más de un web service, solo uno debe procesar los workers en segundo plano (Compra IA, Conversaciones, WhatsApp, facturación). Vacío = sin restricción, todos los servidores los ejecutan.</p>
                    </div>
                </div>
                <div class="adm-card__body">
                    <div class="adm-grid adm-grid--3 adm-infra">
                        <div class="adm-readonly">
                            <span class="adm-readonly__label">Este servidor</span>
                            <span class="adm-readonly__value">@NombreServidorLocal</span>
                        </div>
                        <AlfaInput Label="Servidor autorizado a correr los workers"
                                   Value="@_servidorWorkersInput"
                                   ValueChanged="v => _servidorWorkersInput = v ?? string.Empty"
                                   Placeholder="Vacío = todos los servidores"
                                   Disabled="@_guardandoServidorWorkers"
                                   HelpText="@(string.IsNullOrWhiteSpace(_servidorWorkersActivo) ? "Activo hoy: todos los servidores (sin restricción)." : $"Activo hoy: {_servidorWorkersActivo}.")" />
                        <div class="adm-infra__actions">
                            <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check2" Disabled="@_guardandoServidorWorkers" OnClick="_ => GuardarServidorWorkersAsync()">Guardar</AlfaButton>
                            <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@(_guardandoServidorWorkers || string.IsNullOrWhiteSpace(_servidorWorkersActivo))" OnClick="_ => QuitarRestriccionServidorWorkersAsync()">Quitar restricción</AlfaButton>
                        </div>
                    </div>
                </div>
            </section>

            <div class="adm-split">
                <section class="adm-card" aria-label="Clientes">
                    <div class="adm-card__header">
                        <div>
                            <h3>Clientes</h3>
                            <p>Seleccioná un cliente para cargar sus usuarios, bases y módulos.</p>
                        </div>
                    </div>
                    @if (_cargandoFiltroModulo)
                    {
                        <p class="adm-hint adm-card__note">Buscando clientes con el módulo activo...</p>
                    }
                    @if (FilteredClients.Count == 0)
                    {
                        <AlfaEmptyState Title="No se encontraron clientes" Message="Probá con otra búsqueda o usá “Nueva cuenta” para buscar una cuenta en VT_CLIENTES." />
                    }
                    else
                    {
                        <div class="adm-table-wrap adm-clientes-scroll">
                            <table class="adm-table">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Razón social</th>
                                        <th>Host web</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var client in FilteredClients)
                                    {
                                        <tr class="is-clickable @GetClientRowClass(client.IdCliente)"
                                            tabindex="0"
                                            @onclick="() => SelectClientAsync(client)"
                                            @onkeydown="e => OnClientRowKeyDownAsync(e, client)">
                                            <td class="is-nowrap">@client.IdCliente</td>
                                            <td>@client.RazonSocial</td>
                                            <td><code>@client.IdWeb</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <footer class="alfa-data-view-footer">
                            <span class="alfa-data-view-footer__summary">@(FilteredClients.Count == 1 ? "1 cliente" : $"{FilteredClients.Count} clientes")</span>
                        </footer>
                    }
                </section>

                <section class="adm-card" aria-label="Cuenta">
                    <div class="adm-card__header">
                        <div>
                            @if (HasSelectedClient)
                            {
                                <h3>@(string.IsNullOrWhiteSpace(_clientForm.RazonSocial) ? _clientForm.IdCliente : _clientForm.RazonSocial)</h3>
                                <p>
                                    Cuenta @_clientForm.IdCliente
                                    @if (!string.IsNullOrWhiteSpace(_clientForm.IdWeb))
                                    {
                                        <span> · Host web <code>@_clientForm.IdWeb</code></span>
                                    }
                                    else
                                    {
                                        <span> · Sin host web</span>
                                    }
                                </p>
                            }
                            else
                            {
                                <h3>Cuenta</h3>
                                <p>Seleccioná un cliente para ver sus datos.</p>
                            }
                        </div>
                        @if (HasSelectedClient)
                        {
                            <div class="adm-row-actions">
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-x-lg" OnClick="_ => ClearSelection()">Limpiar selección</AlfaButton>
                                <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-pencil" OnClick="_ => OpenSelectedClientEditor()">Editar cuenta</AlfaButton>
                            </div>
                        }
                    </div>
                    @if (!HasSelectedClient)
                    {
                        <AlfaEmptyState Title="No hay cliente seleccionado" Message="Elegí un cliente de la lista o usá “Nueva cuenta” para dar de alta uno." />
                    }
                    else
                    {
                        <div class="adm-card__body">
                            <div class="adm-kpis adm-kpis--4">
                                <div class="adm-kpi">
                                    <span>SuperAdmin</span>
                                    <strong>@(_clientForm.SuperAdmin ? "Sí" : "No")</strong>
                                </div>
                                <div class="adm-kpi">
                                    <span>Usuarios</span>
                                    <strong>@CurrentUsers.Count</strong>
                                </div>
                                <div class="adm-kpi">
                                    <span>Bases</span>
                                    <strong>@CurrentBases.Count</strong>
                                </div>
                                <div class="adm-kpi">
                                    <span>Módulos activos</span>
                                    <strong>@_clienteModulos.Count(m => m.EstaActivo)</strong>
                                </div>
                            </div>
                            <div class="adm-danger-zone">
                                <div>
                                    <strong>Reset completo (solo cuentas de prueba)</strong>
                                    <p>Borra módulos, usuarios, bases y el registro oficial (CUIT) para reusar los mismos datos en un alta de prueba nueva.</p>
                                </div>
                                <AlfaButton Variant="AlfaButtonVariant.Danger" Size="AlfaSize.Sm" Icon="bi bi-trash3" OnClick="_ => OpenResetClienteModal()">Reset completo</AlfaButton>
                            </div>
                        </div>
                    }
                </section>
            </div>

            <section class="adm-card" aria-label="Usuarios">
                <div class="adm-card__header">
                    <div>
                        <h3>Usuarios</h3>
                        <p>Usuarios de ALFA_CENTRAL del cliente seleccionado. La contraseña se muestra por ahora para administración central.</p>
                    </div>
                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-plus-lg" Disabled="@(!HasSelectedClient)" OnClick="_ => StartNewUser()">Nuevo usuario</AlfaButton>
                </div>
                @if (!HasSelectedClient)
                {
                    <AlfaEmptyState Title="Seleccioná un cliente" Message="Los usuarios se cargan desde ALFA_CENTRAL.dbo.users." />
                }
                else if (CurrentUsers.Count == 0)
                {
                    <AlfaEmptyState Title="Sin usuarios para este cliente" Message="Usá “Nuevo usuario” para registrar el primero." />
                }
                else
                {
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Contraseña</th>
                                    <th class="adm-actions-col"><span class="visually-hidden">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CurrentUsers)
                                {
                                    <tr>
                                        <td>@item.UserName</td>
                                        <td><code>@item.Password</code></td>
                                        <td class="adm-actions-col">
                                            <div class="adm-row-actions">
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-pencil" OnClick="_ => EditUserAsync(item)">Editar</AlfaButton>
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-trash3" OnClick="_ => DeleteUserAsync(item)">Eliminar</AlfaButton>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="adm-card" aria-label="Bases registradas">
                <div class="adm-card__header">
                    <div>
                        <h3>Bases registradas</h3>
                        <p>Bases del cliente seleccionado. "Lectura con IA" y "Conversaciones" indican qué bases recorren esos workers.</p>
                    </div>
                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="bi bi-plus-lg" Disabled="@(!HasSelectedClient)" OnClick="_ => StartNewBase()">Registrar base</AlfaButton>
                </div>
                @if (!HasSelectedClient)
                {
                    <AlfaEmptyState Title="Seleccioná un cliente" Message="Las bases se cargan desde ALFA_CENTRAL.dbo.bases." />
                }
                else if (CurrentBases.Count == 0)
                {
                    <AlfaEmptyState Title="Sin bases para este cliente" Message="Usá “Registrar base” para crear la primera." />
                }
                else
                {
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th class="is-number">ID</th>
                                    <th>Nombre</th>
                                    <th>Base / server</th>
                                    <th>Usuario</th>
                                    <th>Contraseña</th>
                                    <th>Lectura con IA</th>
                                    <th>Conversaciones</th>
                                    <th class="adm-actions-col"><span class="visually-hidden">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CurrentBases)
                                {
                                    <tr>
                                        <td class="is-number">@item.IdBase</td>
                                        <td>@item.Nombre</td>
                                        <td class="is-nowrap"><strong>@item.DbName</strong><small>@item.DbServer</small></td>
                                        <td>@item.DbUser</td>
                                        <td><code>@item.DbPassword</code></td>
                                        <td>
                                            <AlfaCheckbox Value="@_basesCompraIa.Contains(item.IdBase)"
                                                          Disabled="@(_guardandoBaseIa || !_seleccionIaDisponible)"
                                                          ValueChanged="v => CambiarBaseIaAsync(item, v == true)">Incluir</AlfaCheckbox>
                                        </td>
                                        <td>
                                            <AlfaCheckbox Value="@_basesConversaciones.Contains(item.IdBase)"
                                                          Disabled="@(_guardandoBaseConversaciones || !_seleccionConversacionesDisponible)"
                                                          ValueChanged="v => CambiarBaseConversacionesAsync(item, v == true)">Incluir</AlfaCheckbox>
                                        </td>
                                        <td class="adm-actions-col">
                                            <div class="adm-row-actions">
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-plug" OnClick="_ => OpenSyncConfigAsync(item)">Config Sync</AlfaButton>
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-pencil" OnClick="_ => EditBaseAsync(item)">Editar</AlfaButton>
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-trash3" OnClick="_ => DeleteBaseAsync(item)">Eliminar</AlfaButton>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="adm-card" aria-label="Módulos del cliente">
                <div class="adm-card__header">
                    <div>
                        <h3>Módulos</h3>
                        <p>Qué módulos tiene habilitados el cliente seleccionado. Sin autoservicio: se activan acá después de confirmar el pago por fuera del sistema.</p>
                    </div>
                    <div class="adm-row-actions">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-inbox" OnClick="_ => GoSolicitudes()">Solicitudes pendientes</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-grid" OnClick="_ => GoModulos()">Armar catálogo</AlfaButton>
                    </div>
                </div>
                @if (!HasSelectedClient)
                {
                    <AlfaEmptyState Title="Seleccioná un cliente" Message="Los módulos se cargan desde ALFA_CENTRAL.dbo.ClienteModulos." />
                }
                else if (_clienteModulos.Count == 0)
                {
                    <AlfaEmptyState Title="No hay módulos definidos todavía" Message="Usá “Armar catálogo” para crear el primero." />
                }
                else
                {
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Módulo</th>
                                    <th class="is-number">Precio</th>
                                    <th>Estado</th>
                                    <th>Plan</th>
                                    <th>Activado</th>
                                    <th class="adm-actions-col"><span class="visually-hidden">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _clienteModulos)
                                {
                                    var esPrueba = string.Equals(item.Estado, AlfaCore.Models.ClienteModuloEstados.Prueba, StringComparison.OrdinalIgnoreCase);
                                    var esSolicitado = string.Equals(item.Estado, AlfaCore.Models.ClienteModuloEstados.Solicitado, StringComparison.OrdinalIgnoreCase);
                                    var bloqueadoLegacy = _esClienteLegacySeleccionado && !CompraIaHabilitacion.RequiereActivacionExplicita(item.Codigo);
                                    <tr class="@(item.EstaActivo ? string.Empty : "is-inactive")">
                                        <td>
                                            <strong>@item.Nombre</strong>
                                            @if (item.EsDependenciaDeOtro)
                                            {
                                                <small>Dependencia de otro módulo</small>
                                            }
                                        </td>
                                        <td class="is-number">@item.Precio.ToString("C2")</td>
                                        <td class="is-nowrap"><AlfaTag Tone="@GetEstadoTone(item)">@GetEstadoLabel(item)</AlfaTag></td>
                                        <td>
                                            @if (item.IdPlan is not null)
                                            {
                                                <span>@item.PlanNombre</span>
                                                @if (item.FechaProximoCobro is not null)
                                                {
                                                    <small>Próx. cobro: @item.FechaProximoCobro.Value.ToString("dd/MM/yyyy")</small>
                                                }
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="is-nowrap">
                                            @if (item.EstaActivo && item.ActivadoUtc is not null)
                                            {
                                                <span>@item.ActivadoUtc.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                @if (!string.IsNullOrWhiteSpace(item.ActivadoPor))
                                                {
                                                    <small>@item.ActivadoPor</small>
                                                }
                                            }
                                            else if (esSolicitado && item.SolicitadoUtc is not null)
                                            {
                                                <span>@item.SolicitadoUtc.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                @if (!string.IsNullOrWhiteSpace(item.SolicitadoPor))
                                                {
                                                    <small>@item.SolicitadoPor</small>
                                                }
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="adm-actions-col">
                                            <div class="adm-row-actions">
                                                @if (esPrueba && item.EstaActivo)
                                                {
                                                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@bloqueadoLegacy" OnClick="_ => SuspenderModuloAsync(item)">Cortar prueba</AlfaButton>
                                                    <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" OnClick="_ => ActivarModuloAsync(item)">Confirmar pago</AlfaButton>
                                                }
                                                else if (item.EstaActivo)
                                                {
                                                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@bloqueadoLegacy" OnClick="_ => SuspenderModuloAsync(item)">Suspender</AlfaButton>
                                                }
                                                else
                                                {
                                                    @if (esSolicitado)
                                                    {
                                                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" OnClick="_ => RechazarModuloAsync(item)">Rechazar</AlfaButton>
                                                    }
                                                    else
                                                    {
                                                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" OnClick="_ => SolicitarModuloAsync(item)">Solicitar</AlfaButton>
                                                    }
                                                    <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" OnClick="_ => ActivarModuloAsync(item)">Activar</AlfaButton>
                                                }
                                                @if (!item.EsDependenciaDeOtro)
                                                {
                                                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" OnClick="_ => AbrirPlanModal(item)">@(item.IdPlan is null ? "Contratar plan" : "Cambiar plan")</AlfaButton>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_esClienteLegacySeleccionado)
                    {
                        <footer class="alfa-data-view-footer">
                            <span class="alfa-data-view-footer__summary">Cliente legacy: sus módulos habituales están activos. Carga de comprobantes con IA requiere activación explícita y selección de bases.</span>
                        </footer>
                    }
                }
            </section>
        }
    </div>
</div>

<AlfaDialog Open="@(_showPlanModal && _planModalItem is not null)"
            Title="@(_planModalItem?.IdPlan is null ? "Contratar plan" : "Cambiar plan")"
            Eyebrow="@_planModalItem?.Nombre"
            Description="Sin prorrateo: un cambio de plan queda efectivo recién en el próximo período."
            ErrorMessage="@NullIfEmpty(_planModalError)"
            Loading="@_planModalBusy"
            OnClose="CancelarPlanModal">
    <ChildContent>
        @if (_planModalLoading)
        {
            <p class="adm-hint">Cargando planes del módulo...</p>
        }
        else if (_planModalOpciones.Count == 0)
        {
            <AlfaEmptyState Title="Este módulo todavía no tiene planes" Message="Cargalos primero desde Administrar → Módulos → Planes." />
        }
        else
        {
            <AlfaSelect Label="Plan"
                        Value="@(_planModalIdPlanSeleccionado > 0 ? _planModalIdPlanSeleccionado.ToString() : null)"
                        ValueChanged="v => _planModalIdPlanSeleccionado = int.TryParse(v, out var id) ? id : 0"
                        Options="@PlanModalOptions"
                        Placeholder="Elegí un plan..." />
        }
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_planModalBusy" OnClick="_ => CancelarPlanModal()">Cancelar</AlfaButton>
        @if (!_planModalLoading && _planModalOpciones.Count > 0)
        {
            <AlfaButton Variant="AlfaButtonVariant.Primary" Disabled="@_planModalBusy" OnClick="_ => ConfirmarPlanAsync()">@(_planModalItem?.IdPlan is null ? "Contratar" : "Cambiar")</AlfaButton>
        }
    </Footer>
</AlfaDialog>

<AlfaDialog Open="@_showClientEditor"
            Title="@(_newClientDraft ? "Nueva cuenta" : "Editar cuenta")"
            Eyebrow="Administrar"
            Description="Buscá un cliente en VT_CLIENTES o completá los datos centrales manualmente."
            ErrorMessage="@NullIfEmpty(_error)"
            Size="AlfaDialogSize.Lg"
            OnClose="CloseClientEditor">
    <ChildContent>
        <div class="adm-section">
            <div class="adm-dialog-toolbar">
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Icon="@(_showLookupPanel ? "bi bi-x-lg" : "bi bi-search")" OnClick="_ => ToggleLookupPanel()">
                    @(_showLookupPanel ? "Cerrar buscador" : "Buscar en VT_CLIENTES")
                </AlfaButton>
            </div>
            @if (_showLookupPanel)
            {
                <div class="adm-lookup" @onkeydown="HandleLookupKeyDownAsync">
                    <AlfaInput Label="Buscar en VT_CLIENTES"
                               Value="@_lookupSearch"
                               ValueChanged="v => _lookupSearch = v ?? string.Empty"
                               Placeholder="Código, razón social o CUIT/documento de la base activa" />
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-search" Loading="@_lookupLoading" OnClick="_ => SearchLookupAsync()">Buscar</AlfaButton>
                </div>
                @if (_lookupLoading)
                {
                    <p class="adm-hint">Buscando clientes...</p>
                }
                else if (_lookupResults.Count == 0)
                {
                    <p class="adm-hint">Sin coincidencias todavía. Probá con otra razón social, código o documento.</p>
                }
                else
                {
                    <div class="adm-search-results">
                        @foreach (var item in _lookupResults)
                        {
                            <button type="button" class="adm-search-result" @onclick="() => SelectLookupAsync(item)">
                                <span>
                                    <strong>@item.RazonSocial</strong>
                                    <small>@item.Codigo · @item.Documento@(string.IsNullOrWhiteSpace(item.Mail) ? string.Empty : $" · {item.Mail}")</small>
                                </span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                }
            }
        </div>
        <div class="adm-section">
            <h4>Datos centrales</h4>
            <div class="adm-grid">
                <AlfaInput Label="Cuenta" Required="true" Value="@_clientForm.IdCliente" ValueChanged="v => _clientForm.IdCliente = v ?? string.Empty" />
                <AlfaInput Label="Nombre" Required="true" Value="@_clientForm.RazonSocial" ValueChanged="v => _clientForm.RazonSocial = v ?? string.Empty" />
                <AlfaInput Label="Host web" Required="true" Value="@_clientForm.IdWeb" ValueChanged="v => _clientForm.IdWeb = v ?? string.Empty" Placeholder="cliente-web" />
                <div class="adm-password-field">
                    <AlfaInput Label="Contraseña inicial"
                               Value="@_clientForm.PasswordInicial"
                               ValueChanged="v => _clientForm.PasswordInicial = v"
                               Placeholder="CUIT/documento o carga manual"
                               HelpText="Si no hay documento en VT_CLIENTES, cargala manualmente antes de grabar." />
                    <AlfaButton Variant="AlfaButtonVariant.Secondary" OnClick="_ => SuggestInitialPasswordAsync()">Sugerir</AlfaButton>
                </div>
                <div class="adm-flags adm-span-all">
                    <AlfaCheckbox Value="@_clientForm.SuperAdmin" ValueChanged="v => _clientForm.SuperAdmin = v == true">SuperAdmin</AlfaCheckbox>
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => ResetClientForm()">Limpiar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => CloseClientEditor()">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check2" OnClick="_ => SaveClientAsync()">Grabar</AlfaButton>
