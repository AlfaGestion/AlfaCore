    private async Task ConfirmarPlanAsync()
    {
        if (_planModalItem is null || !HasSelectedClient)
            return;

        if (_planModalIdPlanSeleccionado <= 0)
        {
            _planModalError = "Elegí un plan.";
            return;
        }

        _planModalBusy = true;
        _planModalError = string.Empty;

        try
        {
            var usuario = AppUserSession.CurrentUser?.UserName ?? string.Empty;
            if (_planModalItem.IdPlan is null)
            {
                await AdminSvc.ContratarPlanAsync(_selectedClientId!, _planModalIdPlanSeleccionado, usuario);
            }
            else
            {
                await AdminSvc.CambiarPlanAsync(_selectedClientId!, _planModalItem.IdModulo, _planModalIdPlanSeleccionado, usuario);
            }

            await LoadClienteModulosAsync(_selectedClientId!);
            _message = $"Plan actualizado para {_planModalItem.Nombre}.";
            CancelarPlanModal();
        }
        catch (Exception ex)
        {
            _planModalError = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
        finally
        {
