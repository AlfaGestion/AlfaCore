<AlfaConfirmDialog Open="@(_confirmTcs is not null)"
                   Title="@_confirmTitle"
                   Message="@_confirmMessage"
                   SecondaryMessage="@_confirmSecondary"
                   ConfirmLabel="@_confirmLabel"
                   OnConfirm="() => ResolveConfirm(true)"
                   OnCancel="() => ResolveConfirm(false)" />

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private readonly List<AlfaCore.Models.AdminClienteDto> _clients = [];
    private readonly List<AlfaCore.Models.AdminBaseDto> _bases = [];
    private HashSet<int> _basesCompraIa = [];
    private bool _guardandoBaseIa, _seleccionIaDisponible;

    private IReadOnlyList<AlfaCore.Models.ModuloDto> _modulosDisponibles = [];
    private string? _filtroModuloId;
    private HashSet<string>? _clientesConModuloActivo;
    private bool _cargandoFiltroModulo;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        Title = "Clientes",
        Breadcrumb = ["Administrar", "Clientes"],
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "admin",
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildAdministrar(RouteContext, Nav, "clientes"),
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderClientSmartSearch(),
        // Las acciones corren desde el Context Toolbar (otro componente): sin InvokeAsync +
        // StateHasChanged esta página no se re-renderiza y el diálogo no se abre.
        Actions =
        [
            new PageHeaderAction { Key = "nueva-cuenta", Label = "Nueva cuenta", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = () => InvokeAsync(() => { StartNewAccount(); StateHasChanged(); }) },
            new PageHeaderAction { Key = "actualizar", Label = "Actualizar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = () => InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); }) }
        ]
    });

    // Smart Search (mismo patrón que Contactos): el texto filtra la lista en vivo y el panel
    // ofrece el filtro por módulo activo. Los handlers corren en esta página, pero el fragmento lo
    // dibuja el Context Toolbar: cada cambio vuelve a publicar el header.
    private bool _showSearchPanel;

    private RenderFragment RenderClientSmartSearch() => @<div class="smart-search" @onclick:stopPropagation>
        @{ var moduloActivo = FiltroModuloNombre; }
        <div class="smart-search__bar @(_showSearchPanel ? "is-open" : string.Empty)">
            <span class="smart-search__search-icon" aria-hidden="true">
                <i class="bi bi-search"></i>
            </span>
            <button type="button"
                    class="smart-search__filter-button @(_showSearchPanel || moduloActivo is not null ? "is-active" : string.Empty)"
                    title="Abrir filtros"
                    aria-label="Abrir filtros"
                    aria-expanded="@_showSearchPanel"
                    @onclick="ToggleSearchPanel">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
            </button>
            <div class="smart-search__active-filters" aria-label="Filtros activos">
                @if (moduloActivo is not null)
                {
                    <button type="button"
                            class="smart-search__active-filter"
                            title="@($"Quitar filtro {moduloActivo}")"
                            aria-label="@($"Quitar filtro {moduloActivo}")"
                            @onclick="() => SetFiltroModuloAsync(null)">
                        <span>@moduloActivo</span>
                        <span class="smart-search__active-filter-remove" aria-hidden="true">
                            <i class="bi bi-x"></i>
                        </span>
                    </button>
                }
            </div>
            <input type="search"
                   placeholder="Buscar cliente por código, razón social o host..."
                   value="@_clientSearch"
                   @oninput="OnClientSearchInput"
                   @onkeydown="HandleSearchKeyDown" />
            <button type="button" class="smart-search__toggle" @onclick="ToggleSearchPanel" aria-label="Mostrar filtros" aria-expanded="@_showSearchPanel">
                <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_showSearchPanel)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CloseSearchPanel"></button>
            <div class="smart-search__panel" @onclick:stopPropagation @onkeydown="HandleSearchKeyDown">
                <div class="smart-search__column">
                    <h4><i class="bi bi-grid"></i> Con módulo activo</h4>
                    <button type="button" class="@GetSmartOptionClass(string.IsNullOrWhiteSpace(_filtroModuloId))" disabled="@_cargandoFiltroModulo" @onclick="() => SetFiltroModuloAsync(null)">Todos los clientes</button>
                    @foreach (var modulo in _modulosDisponibles)
                    {
                        var id = modulo.Id.ToString();
                        <button type="button" class="@GetSmartOptionClass(_filtroModuloId == id)" disabled="@_cargandoFiltroModulo" @onclick="() => SetFiltroModuloAsync(id)">@modulo.Nombre</button>
                    }
                </div>
            </div>
        }
    </div>;

    private string? FiltroModuloNombre
        => string.IsNullOrWhiteSpace(_filtroModuloId)
            ? null
            : _modulosDisponibles.FirstOrDefault(m => m.Id.ToString() == _filtroModuloId)?.Nombre;

    private static string GetSmartOptionClass(bool active)
        => active ? "smart-option is-active" : "smart-option";

    private void OnClientSearchInput(ChangeEventArgs e)
    {
        _clientSearch = e.Value?.ToString() ?? string.Empty;
        UpdatePageHeader();
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseSearchPanel();
    }

    private void ToggleSearchPanel()
    {
        _showSearchPanel = !_showSearchPanel;
        UpdatePageHeader();
    }

    private void CloseSearchPanel()
    {
        _showSearchPanel = false;
        UpdatePageHeader();
    }

    private async Task SetFiltroModuloAsync(string? idModulo)
    {
        _showSearchPanel = false;
        UpdatePageHeader();
        await OnFiltroModuloChangedAsync(idModulo);
        UpdatePageHeader();
    }

    private IReadOnlyList<AlfaSelectOption> PlanModalOptions
        => _planModalOpciones
            .Select(p => new AlfaSelectOption(p.Id.ToString(), $"{p.Nombre} — {p.Precio:N2} {p.Moneda} ({GetTipoFacturacionLabel(p.TipoFacturacion)})"))
            .ToList();

    // Avisos: el éxito siempre va como notificación; el error, si hay un diálogo abierto, se
    // muestra dentro del diálogo (ErrorMessage) para no duplicarlo.
    private bool AnyEditorOpen => _showClientEditor || _showUserEditor || _showBaseEditor || _showResetClienteModal || _showSyncConfigModal;

    private AppUiMessage? Feedback
        => !string.IsNullOrWhiteSpace(_error) && !AnyEditorOpen
            ? AppUiMessage.Error("No se pudo completar la operación", _error)
            : !string.IsNullOrWhiteSpace(_message)
                ? AppUiMessage.Success("Listo", _message)
                : null;

    private void DismissFeedback()
    {
        _message = string.Empty;
        if (!AnyEditorOpen)
            _error = string.Empty;
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private static AlfaTagTone GetEstadoTone(AlfaCore.Models.ClienteModuloDto item)
    {
        if (item.EstaActivo)
            return string.Equals(item.Estado, AlfaCore.Models.ClienteModuloEstados.Prueba, StringComparison.OrdinalIgnoreCase)
                ? AlfaTagTone.Warning
                : AlfaTagTone.Success;

        return item.Estado switch
        {
            AlfaCore.Models.ClienteModuloEstados.Solicitado => AlfaTagTone.Accent,
            AlfaCore.Models.ClienteModuloEstados.Suspendido => AlfaTagTone.Danger,
            AlfaCore.Models.ClienteModuloEstados.Rechazado => AlfaTagTone.Danger,
            _ => AlfaTagTone.Neutral
        };
    }

    private async Task OnClientRowKeyDownAsync(KeyboardEventArgs e, AlfaCore.Models.AdminClienteDto client)
    {
        if (e.Key is "Enter" or " ")
            await SelectClientAsync(client);
    }

    private async Task OnFiltroModuloChangedAsync(string? value)
    {
        _filtroModuloId = value;
        _error = string.Empty;

        if (string.IsNullOrWhiteSpace(_filtroModuloId) || !int.TryParse(_filtroModuloId, out var idModulo))
        {
            _clientesConModuloActivo = null;
            return;
        }

        _cargandoFiltroModulo = true;
        try
        {
            var clientes = await AdminSvc.GetClientesPorModuloAsync(idModulo);
            _clientesConModuloActivo = clientes
                .Where(c => c.EstaActivo)
                .Select(c => c.IdCliente)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }
        finally { _cargandoFiltroModulo = false; }
    }

    private async Task CambiarBaseIaAsync(AdminBaseDto item, bool incluir)
    {
        if (_guardandoBaseIa) return;
        if (!await ConfirmAsync(
                incluir ? "Incluir base en Lectura con IA" : "Excluir base de Lectura con IA",
                $"¿{(incluir ? "Incluir" : "Excluir")} la base {item.Nombre}?",
                incluir ? "Incluir" : "Excluir"))
            return;
        _guardandoBaseIa = true;
        _error = string.Empty;
        try
        {
            await CompraIaSvc.SetBaseSeleccionadaAsync(item.IdBase, item.IdCliente, incluir);
            if (incluir) _basesCompraIa.Add(item.IdBase); else _basesCompraIa.Remove(item.IdBase);
            _message = incluir
                ? "Base incluida. Se procesará cuando el cliente tenga activo Carga de comprobantes con IA y esté habilitado el worker en Compras."
                : "Base excluida. El worker dejará de consultarla a partir del próximo ciclo.";
        }
        catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }
        finally { _guardandoBaseIa = false; }
    }

    private HashSet<int> _basesConversaciones = [];
    private bool _guardandoBaseConversaciones, _seleccionConversacionesDisponible;

    private async Task CambiarBaseConversacionesAsync(AdminBaseDto item, bool incluir)
    {
        if (_guardandoBaseConversaciones) return;
        if (!await ConfirmAsync(
                incluir ? "Incluir base en Conversaciones" : "Excluir base de Conversaciones",
                $"¿{(incluir ? "Incluir" : "Excluir")} la base {item.Nombre}?",
                incluir ? "Incluir" : "Excluir"))
            return;
        _guardandoBaseConversaciones = true;
        _error = string.Empty;
        try
        {
            await ConversacionesHabilitacionSvc.SetBaseSeleccionadaAsync(item.IdBase, item.IdCliente, incluir);
            if (incluir) _basesConversaciones.Add(item.IdBase); else _basesConversaciones.Remove(item.IdBase);
            _message = incluir
                ? "Base incluida. Se procesará cuando el cliente tenga activo Conversaciones y esté habilitado acá."
                : "Base excluida. El job de Conversaciones dejará de consultarla a partir del próximo ciclo.";
        }
        catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }
        finally { _guardandoBaseConversaciones = false; }
    }

    private string NombreServidorLocal => WorkerAssignmentSvc.NombreServidorLocal;
    private string? _servidorWorkersActivo;
    private string _servidorWorkersInput = string.Empty;
    private bool _guardandoServidorWorkers;

    private async Task GuardarServidorWorkersAsync()
    {
        if (_guardandoServidorWorkers) return;
        var destino = _servidorWorkersInput.Trim();
        if (!await ConfirmAsync(
                "Cambiar servidor de workers",
                string.IsNullOrWhiteSpace(destino)
                    ? "¿Dejar que todos los servidores corran los workers en segundo plano?"
                    : $"¿Dejar solo a {destino} corriendo los workers en segundo plano?",
                "Guardar",
                "Afecta a staging y producción: los demás servidores dejan de procesar Compra IA, Conversaciones, WhatsApp y facturación."))
            return;
        _guardandoServidorWorkers = true;
        _error = string.Empty;
        _message = string.Empty;
        try
        {
            await WorkerAssignmentSvc.SetServidorActivoAsync(_servidorWorkersInput);
            _servidorWorkersActivo = await WorkerAssignmentSvc.GetServidorActivoAsync();
            _servidorWorkersInput = _servidorWorkersActivo ?? string.Empty;
            _message = string.IsNullOrWhiteSpace(_servidorWorkersActivo)
                ? "Sin restricción: todos los servidores corren los workers."
                : $"Solo {_servidorWorkersActivo} va a correr los workers en segundo plano.";
        }
        catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }
        finally { _guardandoServidorWorkers = false; }
    }

    private async Task QuitarRestriccionServidorWorkersAsync()
    {
        if (_guardandoServidorWorkers) return;
        if (!await ConfirmAsync(
                "Quitar restricción",
                "¿Dejar que todos los servidores corran los workers en segundo plano?",
                "Quitar restricción",
                "Con más de un web service activo, el trabajo en segundo plano se puede duplicar."))
            return;
        _guardandoServidorWorkers = true;
        _error = string.Empty;
        _message = string.Empty;
        try
        {
            await WorkerAssignmentSvc.SetServidorActivoAsync(null);
            _servidorWorkersActivo = null;
            _servidorWorkersInput = string.Empty;
            _message = "Sin restricción: todos los servidores corren los workers.";
        }
        catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }
        finally { _guardandoServidorWorkers = false; }
    }

    private readonly List<AlfaCore.Models.AdminUserDto> _users = [];
    private readonly List<AlfaCore.Models.ClienteModuloDto> _clienteModulos = [];
    private readonly List<AlfaCore.Models.PlanDto> _planModalOpciones = [];
    private readonly CrearClienteRequest _clientForm = new();
    private readonly CrearBaseRequest _baseForm = new();
    private readonly CrearUserRequest _userForm = new();
    private readonly List<ClienteAlfaLookupDto> _lookupResults = [];

    private bool _loading = true;
    private bool _showClientEditor;
    private bool _showLookupPanel;
    private bool _showUserEditor;
    private bool _showBaseEditor;
    private bool _showSyncConfigModal;
    private bool _editingUser;
    private bool _editingBase;
    private bool _newClientDraft = true;
    private bool IsSuperAdmin => AppUserSession.CurrentUser?.SuperAdmin == true;
    private string _message = string.Empty;
    private string _error = string.Empty;
    private string _clientSearch = string.Empty;
    private string _lookupSearch = string.Empty;
    private string? _selectedClientId;
    private bool _lookupLoading;
    private AdminBaseDto? _syncConfigBase;
    private string _syncConfigRutaWebService = "https://alfanetac.ddns.net/api/v3/";
    private string _syncConfigUser = string.Empty;
    private string _syncConfigPassword = string.Empty;

    private bool _showPlanModal;
    private bool _planModalLoading;
    private bool _planModalBusy;
    private string _planModalError = string.Empty;
    private AlfaCore.Models.ClienteModuloDto? _planModalItem;
    private int _planModalIdPlanSeleccionado;

    private IReadOnlyList<AlfaCore.Models.AdminClienteDto> FilteredClients
    {
        get
        {
            IEnumerable<AlfaCore.Models.AdminClienteDto> query = _clients;

            if (!string.IsNullOrWhiteSpace(_clientSearch))
                query = query.Where(item =>
                    Contains(item.IdCliente, _clientSearch)
                    || Contains(item.RazonSocial, _clientSearch)
                    || Contains(item.IdWeb, _clientSearch));

            if (_clientesConModuloActivo is not null)
                query = query.Where(item => _clientesConModuloActivo.Contains(item.IdCliente));

            return query.OrderBy(item => item.RazonSocial).ThenBy(item => item.IdCliente).ToArray();
        }
    }

    private IReadOnlyList<AlfaCore.Models.AdminBaseDto> CurrentBases => string.IsNullOrWhiteSpace(_selectedClientId)
        ? []
        : _bases.Where(item => string.Equals(item.IdCliente, _selectedClientId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.Nombre)
            .ThenBy(item => item.IdBase)
            .ToArray();

    private IReadOnlyList<AlfaCore.Models.AdminUserDto> CurrentUsers => string.IsNullOrWhiteSpace(_selectedClientId)
        ? []
        : _users.Where(item => string.Equals(item.IdCliente, _selectedClientId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.UserName)
            .ToArray();

    private bool HasSelectedClient => !string.IsNullOrWhiteSpace(_selectedClientId);

    // Un módulo activo sin fila propia en ClienteModulos (ActivadoUtc null) solo puede venir
    // del override de cliente legacy — es la señal que tenemos disponible sin sumar otro campo.
    private bool _esClienteLegacySeleccionado
        => _clienteModulos.Any(m => m.EstaActivo && m.ActivadoUtc is null);

    protected override async Task OnInitializedAsync()
    {
        if (!IsSuperAdmin)
        {
            _loading = false;
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync(string? preferredClientId = null)
    {
        _loading = true;
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            var clientsTask = AdminSvc.GetClientesAsync();
            var basesTask = AdminSvc.GetBasesAsync();
            var usersTask = AdminSvc.GetUsersAsync();
            var modulosTask = AdminSvc.GetModulosAsync();
            await Task.WhenAll(clientsTask, basesTask, usersTask, modulosTask);

            _clients.Clear();
            _bases.Clear();
            _users.Clear();

            _clients.AddRange(await clientsTask);
            _bases.AddRange(await basesTask);
            _users.AddRange(await usersTask);
            _modulosDisponibles = await modulosTask;
            _seleccionIaDisponible = false;
            try
            {
                _basesCompraIa = (await CompraIaSvc.GetBasesSeleccionadasAsync()).ToHashSet();
                _seleccionIaDisponible = true;
            }
            catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }

            _seleccionConversacionesDisponible = false;
            try
            {
                _basesConversaciones = (await ConversacionesHabilitacionSvc.GetBasesSeleccionadasAsync()).ToHashSet();
                _seleccionConversacionesDisponible = true;
            }
            catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }

            try
            {
                _servidorWorkersActivo = await WorkerAssignmentSvc.GetServidorActivoAsync();
                _servidorWorkersInput = _servidorWorkersActivo ?? string.Empty;
            }
            catch (AlfaCore.Services.AppUserFacingException ex) { _error = ex.UserMessage; }

            var targetClientId = !string.IsNullOrWhiteSpace(preferredClientId)
                ? preferredClientId.Trim()
                : _selectedClientId;

            if (!string.IsNullOrWhiteSpace(targetClientId)
                && _clients.Any(c => string.Equals(c.IdCliente, targetClientId, StringComparison.OrdinalIgnoreCase)))
            {
                await SelectClientAsync(_clients.First(c => string.Equals(c.IdCliente, targetClientId, StringComparison.OrdinalIgnoreCase)));
            }
            else if (_selectedClientId is null || !_clients.Any(c => string.Equals(c.IdCliente, _selectedClientId, StringComparison.OrdinalIgnoreCase)))
            {
                var firstClient = _clients.FirstOrDefault();
                if (firstClient is not null)
                    await SelectClientAsync(firstClient);
                else
                    ClearSelection();
            }
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

