    // Confirmación con AlfaConfirmDialog que se puede esperar (await) como el confirm() de JS:
    // el handler que la pide queda suspendido hasta que se elige Confirmar o Cancelar.
    private TaskCompletionSource<bool>? _confirmTcs;
    private string _confirmTitle = string.Empty;
    private string _confirmMessage = string.Empty;
    private string? _confirmSecondary;
    private string _confirmLabel = "Confirmar";

    private Task<bool> ConfirmAsync(string title, string message, string confirmLabel, string? secondaryMessage = null)
    {
        _confirmTcs?.TrySetResult(false);
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmSecondary = secondaryMessage;
        _confirmLabel = confirmLabel;
        _confirmTcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _confirmTcs.Task;
    }

    private void ResolveConfirm(bool confirmed)
    {
        var tcs = _confirmTcs;
        _confirmTcs = null;
        tcs?.TrySetResult(confirmed);
    }

    private string GetClientRowClass(string idCliente)
        => string.Equals(idCliente, _selectedClientId, StringComparison.OrdinalIgnoreCase) ? "is-selected" : string.Empty;

    private static bool Contains(string? value, string term)
        => !string.IsNullOrWhiteSpace(value)
           && value.Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string BuildHostWebSuggestion(string? razonSocial, string? codigo)
    {
        var source = !string.IsNullOrWhiteSpace(razonSocial) ? razonSocial : codigo ?? string.Empty;
        source = source.Trim().ToLowerInvariant();

        var builder = new System.Text.StringBuilder(source.Length);
        var lastDash = false;
        foreach (var ch in source)
        {
            if (char.IsLetterOrDigit(ch))
            {
                builder.Append(ch);
                lastDash = false;
                continue;
            }

            if (!lastDash)
            {
                builder.Append('-');
                lastDash = true;
            }
        }

        return builder.ToString().Trim('-');
    }
}
