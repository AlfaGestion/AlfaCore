@page "/configuracion-general/articulos"
@page "/{idweb}/{idbase:int}/configuracion-general/articulos"
@using AlfaCore.Models
@inject AlfaCore.Services.IConfiguracionGeneralService ConfigSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Artículos | Alfa Gestión</PageTitle>

<div class="page-grid cfgarticulos-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <section class="panel-card">
        <h3 class="panel-card__title">Configuración de Artículos</h3>
        <p class="panel-card__subtitle">
            Catálogo de configuraciones ("Cfg") que usa el maestro de Artículos (Archivos → Maestros →
            Artículos). Son las mismas claves de <code>TA_CONFIGURACION</code> que ya usa el sistema de
            escritorio -- cambiarlas acá afecta a ambos.
        </p>

        <div class="cfgarticulos-grid">
            <div class="field">
                <label>Alícuota de IVA por defecto (%)</label>
                <input class="field-input" type="number" step="0.01" @bind="_articulos.TasaIvaDefaultText" />
                <small>Se usa cuando un artículo no tiene su propia tasa cargada. Clave: <code>PIVA</code>.</small>
            </div>
            <div class="field">
                <label>Clase de precio de venta</label>
                <select class="field-input" @bind="_articulos.ClasePrecioVenta">
                    @for (var i = 1; i <= 8; i++)
                    {
                        <option value="@i.ToString()">Precio @i</option>
                    }
                </select>
                <small>De las 8 clases de precio del maestro legacy, cuál usa AlfaCore como "el" precio de venta. Clave: <code>ClasePrecioVenta</code>.</small>
            </div>
            <div class="field">
                <label>Plantilla de código de barras pesable</label>
                <input class="field-input" placeholder="Ej: 2CCCCCDDDDDV" @bind="_articulos.PlantillaCodigoBarraPesable" />
                <small>Posiciones marcadas "C" = dígitos variables (peso/precio) al generar el código de un producto pesable. Clave: <code>TIPOEAN</code>.</small>
            </div>
            <div class="field">
                <label>Carpeta de imágenes</label>
                <input class="field-input" @bind="_articulos.RutaImagenes" />
                <small>Carpeta base donde se buscan/guardan las imágenes de artículos. Clave: <code>RutaImagenes</code>.</small>
            </div>
        </div>

        <div class="cfgarticulos-checks">
            <AlfaCheckbox Value="@_articulos.PrecioIncluyeIva" ValueChanged="v => _articulos.PrecioIncluyeIva = v == true">
                El precio de venta se carga con IVA incluido
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_articulos.Clase2ConIva" ValueChanged="v => _articulos.Clase2ConIva = v == true">
                La clase de precio 2 se carga con IVA incluido
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_articulos.ModoRetail" ValueChanged="v => _articulos.ModoRetail = v == true">
                Modo retail
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_articulos.CodigoBarraAutomatico" ValueChanged="v => _articulos.CodigoBarraAutomatico = v == true">
                Autogenerar código de barras desde el id interno
            </AlfaCheckbox>
        </div>
    </section>
</div>

@code {
    private sealed class ArticulosFormModel
    {
        public string TasaIvaDefaultText { get; set; } = "0";
        public string ClasePrecioVenta { get; set; } = "1";
        public bool PrecioIncluyeIva { get; set; }
        public bool Clase2ConIva { get; set; }
        public bool ModoRetail { get; set; }
        public string PlantillaCodigoBarraPesable { get; set; } = string.Empty;
        public bool CodigoBarraAutomatico { get; set; }
        public string RutaImagenes { get; set; } = string.Empty;
    }

    private ArticulosFormModel _articulos = new();
    private bool _saving;
    private AppUiMessage? _feedback;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose() => PageHeader.Clear();

    protected override async Task OnInitializedAsync()
    {
        var result = await UiOps.RunAsync(() => ConfigSvc.GetArticulosAsync(), "No se pudo cargar la configuración de artículos.");
        if (result.Success && result.Value is not null)
            ApplyDto(result.Value);
        else if (!result.Success)
            _feedback = result.Feedback;
    }

    private void ApplyDto(ConfiguracionArticulosDto dto) => _articulos = new ArticulosFormModel
    {
        TasaIvaDefaultText = dto.TasaIvaDefault.ToString(System.Globalization.CultureInfo.InvariantCulture),
        ClasePrecioVenta = dto.ClasePrecioVenta,
        PrecioIncluyeIva = dto.PrecioIncluyeIva,
        Clase2ConIva = dto.Clase2ConIva,
        ModoRetail = dto.ModoRetail,
        PlantillaCodigoBarraPesable = dto.PlantillaCodigoBarraPesable,
        CodigoBarraAutomatico = dto.CodigoBarraAutomatico,
        RutaImagenes = dto.RutaImagenes
    };

    private void UpdatePageHeader() => PageHeader.Set(new PageHeaderConfig
    {
        Title = "Artículos",
        Breadcrumb = ["Configuración General", "Artículos"],
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildConfiguracionGeneral(RouteContext, Nav, "articulos"),
        Actions = BuildHeaderActions()
    });

    private IReadOnlyList<PageHeaderAction> BuildHeaderActions() =>
    [
        new PageHeaderAction { Key = "guardar-articulos", Label = "Guardar", Icon = "bi-floppy", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _saving, Busy = _saving, OnClick = GuardarAsync },
        new PageHeaderAction { Key = "cancelar-articulos", Label = "Cancelar", Icon = "bi-x-lg", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = _saving, OnClick = CancelarAsync }
    ];

    private async Task GuardarAsync()
    {
        _saving = true;
        UpdatePageHeader();

        var dto = new ConfiguracionArticulosDto
        {
            TasaIvaDefault = decimal.TryParse(_articulos.TasaIvaDefaultText, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var iva) ? iva : 0m,
            ClasePrecioVenta = _articulos.ClasePrecioVenta,
            PrecioIncluyeIva = _articulos.PrecioIncluyeIva,
            Clase2ConIva = _articulos.Clase2ConIva,
            ModoRetail = _articulos.ModoRetail,
            PlantillaCodigoBarraPesable = _articulos.PlantillaCodigoBarraPesable,
            CodigoBarraAutomatico = _articulos.CodigoBarraAutomatico,
            RutaImagenes = _articulos.RutaImagenes
        };

        var result = await UiOps.RunAsync(async () => { await ConfigSvc.SaveArticulosAsync(dto); return true; }, "No se pudo guardar la configuración de artículos.");
        _saving = false;
        UpdatePageHeader();
        _feedback = result.Success
            ? AppUiMessage.Success("Guardado", "La configuración de artículos se guardó correctamente.")
            : result.Feedback;
    }

    private async Task CancelarAsync()
    {
        if (_saving)
            return;

        var result = await UiOps.RunAsync(() => ConfigSvc.GetArticulosAsync(), "No se pudo restaurar la configuración de artículos.");
        if (result.Success && result.Value is not null)
            ApplyDto(result.Value);

        _feedback = result.Success
            ? AppUiMessage.Info("Cambios cancelados", "Se restauró la última configuración guardada.")
            : result.Feedback;
    }
}
