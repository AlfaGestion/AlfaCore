        try
        {
            var r = await UiOps.RunAsync(() => Service.HistorialAsync(), "Historial de ARCA");
            if (r.Success) _hist = r.Value!; else _histError = r.Feedback?.Message;
        }
        finally { _histBusy = false; if (!_disposed) StateHasChanged(); }
    }

