@page "/contabilidad/control-arca"
@page "/{idweb}/{idbase:int}/contabilidad/control-arca"
@using AlfaCore.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IControlArcaService Service
@inject IControlArcaImportacionService Importacion
@inject IArcaDescargaService Descarga
@inject IAppUiOperationService UiOps
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Control contra ARCA | Alfa Gestión</PageTitle>

@* Control contra «Mis Comprobantes» de ARCA (emitidos contra ventas, recibidos contra el libro de compras). El archivo se sube a mano o
   se baja con el script de pre-proceso del legacy; los recibidos que faltan se pueden importar al libro de IVA compras. *@
<div class="gd-page gd ca-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <div class="ca-origen">
        <section class="ca-subir">
            <div class="ca-subir__texto">
                <strong><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> A mano: archivo de «Mis Comprobantes»</strong>
                <span>En ARCA → Mis Comprobantes, consultá <b>Emitidos</b> o <b>Recibidos</b> del período y descargalo en Excel o CSV.
                    Se compara con las ventas o con el libro de IVA compras; no se graba nada hasta que importes.</span>
            </div>
            <label class="ca-subir__boton @(_busy ? "is-disabled" : null)">
                <InputFile OnChange="ArchivoElegidoAsync" accept=".xlsx,.xls,.csv,.txt" disabled="@_busy" />
                <i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i> @(_busy ? "Controlando…" : _archivo is null ? "Elegir archivo" : "Elegir otro archivo")
            </label>
        </section>

        <section class="ca-descarga">
            <div class="ca-subir__texto">
                <strong><i class="bi bi-robot" aria-hidden="true"></i> Automático: bajar de ARCA y comparar</strong>
                @if (_cfg is null)
                {
                    <span>@(_cfgError ?? "Leyendo la configuración…")</span>
                }
                else if (!_cfg.Configurado)
                {
                    <span>@(_cfg.ScriptExiste && _cfg.PythonExiste ? "Tocá «Configurar descarga» para cargar el acceso a ARCA (CUIT, clave fiscal y CUIT representado)." : "La descarga de ARCA todavía no está instalada en el servidor: avisá a ALFA NET.")</span>
                }
                else
                {
                    <div class="ca-descarga__fila">
                        <input type="month" class="ca-input" value="@_periodo" @onchange="e => _periodo = e.Value?.ToString() ?? _periodo" disabled="@_busy" aria-label="Período" />
                        <select class="ca-input" value="@(_descargaRecibidos ? "R" : "E")" @onchange='e => _descargaRecibidos = e.Value?.ToString() == "R"' disabled="@_busy" aria-label="Tipo">
                            <option value="R">Recibidos (compras)</option>
                            <option value="E">Emitidos (ventas)</option>
                        </select>
                        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-cloud-download" Disabled="_busy" OnClick="_ => DescargarAsync()">
                            @(_descargando ? "Descargando de ARCA…" : "Descargar y comparar")
                        </AlfaButton>
                    </div>
                    @if (_descargando)
                    {
                        <span class="ca-progreso" role="status" aria-live="polite">
                            <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                            @(_segundos < 8 ? "Iniciando el navegador en el servidor…" : "Entrando a ARCA y bajando Mis Comprobantes…")
                            Puede tardar 1 a 3 minutos, no cierres la pantalla. Van @_segundos s.
                        </span>
                    }
                    else
                    {
                        <span>@AutoTexto(_cfg)</span>
                    }
                }
            </div>
            @if (_archivos.Count > 0)
            {
                <div class="ca-archivos" aria-label="Archivos descargados">
                    <small>Descargados:</small>
                    @foreach (var a in _archivos.Take(8))
                    {
                        <button type="button" class="ca-archivo" disabled="@_busy" title="@($"{a.Nombre} · {a.Fecha:dd/MM/yyyy HH:mm}")" @onclick="() => CompararDescargadoAsync(a)">
                            @(a.Recibidos ? "Recibidos" : "Emitidos") @a.Periodo[4..]/@a.Periodo[..4]
                        </button>
                    }
                </div>
            }
        </section>
    </div>

    @if (_r is { } r)
    {
        @if (r.Aviso is { } aviso) { <AlfaNotification Message="@AppUiMessage.Warning("CUIT del archivo", aviso)" /> }
        <div class="kpi-grid ca-kpis">
            <KpiCard Titulo="@(r.Recibidos ? "Recibidos (compras)" : "Emitidos (ventas)")" Valor="@($"{r.ComprobantesArca:N0} en ARCA")" Icono="@Icono("bi-cloud-check")"
                     Descripcion="@($"CUIT {r.CuitArchivo} · {r.Desde:dd/MM/yyyy} al {r.Hasta:dd/MM/yyyy} · {r.ComprobantesSistema:N0} en el sistema")" />
            <KpiCard Titulo="Coinciden" Valor="@r.Cantidad(ControlArcaEstado.Coincide).ToString("N0")" Icono="@Icono("bi-check2-circle")"
                     Descripcion="@($"ARCA {Moneda(r.TotalArca)} · sistema {Moneda(r.TotalSistema)}")" />
            <KpiCard Titulo="Faltan en el sistema" Valor="@r.Cantidad(ControlArcaEstado.FaltaEnSistema).ToString("N0")" Icono="@Icono("bi-exclamation-triangle")"
                     Destacado="@(r.Cantidad(ControlArcaEstado.FaltaEnSistema) > 0)" Descripcion="@(r.Recibidos ? "Facturas de proveedores sin cargar: tildalas e importalas" : "Emitidos que no están en ventas")" />
            <KpiCard Titulo="Con diferencias" Valor="@((r.Cantidad(ControlArcaEstado.DifiereImporte) + r.Cantidad(ControlArcaEstado.OtroPeriodo) + r.Cantidad(ControlArcaEstado.DifiereFecha)).ToString("N0"))"
                     Icono="@Icono("bi-arrow-left-right")" Descripcion="@($"{r.Cantidad(ControlArcaEstado.DifiereImporte)} importe · {r.Cantidad(ControlArcaEstado.OtroPeriodo)} otro período · {r.Cantidad(ControlArcaEstado.FaltaEnArca)} no están en ARCA")" />
        </div>

        <div class="ca-filtros" role="group" aria-label="Filtrar por estado">
            <button type="button" class="@(_estado is null ? "is-activo" : null)" @onclick="() => _estado = null">Con novedades (@r.Filas.Count(f => f.Estado != ControlArcaEstado.Coincide))</button>
            @foreach (var e in Enum.GetValues<ControlArcaEstado>())
            {
                var n = r.Cantidad(e);
                if (n == 0) continue;
                <button type="button" class="ca-estado--@(e.ToString().ToLowerInvariant()) @(_estado == e ? "is-activo" : null)" @onclick="() => _estado = e">@ControlArcaService.EstadoTexto(e) (@n)</button>
            }
        </div>

        var filas = r.Filas.Where(f => _estado is null ? f.Estado != ControlArcaEstado.Coincide : f.Estado == _estado).ToList();
        var seleccionable = PuedeImportar(r);
        @if (filas.Count == 0)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin novedades" Message="Todos los comprobantes del archivo coinciden con el sistema." />
        }
        else
        {
            <section class="ca-tabla__marco"><div class="ca-tabla__scroll">
                <table class="ca-tabla">
                    <thead><tr>
                        @if (seleccionable)
                        {
                            <th class="ca-sel"><input type="checkbox" aria-label="Seleccionar los faltantes" checked="@(Importables(filas).Any() && Importables(filas).All(f => _sel.Contains(f)))"
                                                      @onchange="e => SeleccionarTodos(filas, e.Value is true)" /></th>
                        }
                        <th>Estado</th><th>Tipo</th><th>Comprobante</th><th>@(r.Recibidos ? "Proveedor" : "Cliente")</th><th>Fecha ARCA</th><th>Fecha sistema</th>
                        <th class="n">Total ARCA</th><th class="n">Total sistema</th><th class="n">Diferencia</th><th>Observación</th></tr></thead>
                    <tbody>
                    @foreach (var f in filas)
                    {
                        <tr class="@(_sel.Contains(f) ? "is-sel" : null)">
                            @if (seleccionable)
                            {
                                <td class="ca-sel">
                                    @if (f.Estado == ControlArcaEstado.FaltaEnSistema && f.Arca is not null)
                                    {
                                        <input type="checkbox" aria-label="Seleccionar" checked="@_sel.Contains(f)" @onchange="e => Seleccionar(f, e.Value is true)" />
                                    }
                                </td>
                            }
                            <td><span class="ca-chip ca-estado--@(f.Estado.ToString().ToLowerInvariant())">@ControlArcaService.EstadoTexto(f.Estado)</span></td>
                            <td>@f.Clase @f.Letra</td>
                            <td>@f.Comprobante@if (f.ComprobanteSistema.Length > 0) { <small>@f.ComprobanteSistema</small> }</td>
                            <td>@f.Nombre<small>@f.Cuit</small></td>
                            <td>@f.FechaArca?.ToString("dd/MM/yyyy")</td>
                            <td>@f.FechaSistema?.ToString("dd/MM/yyyy")</td>
                            <td class="n">@(f.TotalArca is { } ta ? ta.ToString("N2", Culture) : "")</td>
                            <td class="n">@(f.TotalSistema is { } ts ? ts.ToString("N2", Culture) : "")</td>
                            <td class="n @(Math.Abs(f.Diferencia) > 1 ? "is-dif" : null)">@(f.TotalArca is not null && f.TotalSistema is not null ? f.Diferencia.ToString("N2", Culture) : "")</td>
                            <td class="ca-obs">@f.Observacion</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></section>
        }
        <p class="ca-nota">Se empareja por tipo, letra, punto de venta y número@(r.Recibidos ? " y CUIT del proveedor (libro de IVA compras)" : " (ventas no anuladas)").
            Diferencias de hasta $ 1 se consideran redondeo. «Otro período»: el comprobante está cargado en un mes distinto al de ARCA (afecta el libro de IVA).</p>
    }
    else if (!_busy)
    {
        <AlfaEmptyState Title="Subí o descargá el archivo de ARCA" Message="Elegí el Excel o CSV de Mis Comprobantes (emitidos o recibidos), o bajalo de ARCA, para controlarlo contra el sistema." />
    }
</div>

@* ── Importar faltantes ── *@
<AlfaDialog Open="@(_imp is not null)" Title="Importar comprobantes recibidos" Size="AlfaDialogSize.Xl" Loading="@_impBusy"
            Description="Se dan de alta en el libro de IVA compras como en Importar Comprobantes del Alfa Gestión: asiento (proveedor al Haber; compras, IVA y otros tributos al Debe; las NC al revés) y comprobante, con usuario IMPORTACION."
            ErrorMessage="@_impError" CloseOnBackdrop="false" OnClose="CerrarImportacionAsync">
    <ChildContent>
    @if (_imp is { } ctx)
    {
        <div class="ca-imp">
            <div class="ca-imp__grid">
                <AlfaSelect Label="Cuenta de compras" Value="@_solicitud.CuentaCompras" ValueChanged="v => _solicitud.CuentaCompras = v ?? string.Empty" Options="@_opcionesCuentas" Disabled="@(_impHecho || _impBusy)" />
                <AlfaSelect Label="IVA crédito fiscal" Value="@_solicitud.CuentaIva" ValueChanged="v => _solicitud.CuentaIva = v ?? string.Empty" Options="@_opcionesCuentas" Disabled="@(_impHecho || _impBusy)" />
                <AlfaSelect Label="Otros tributos (percepciones)" Value="@_solicitud.CuentaOtrosTributos" ValueChanged="v => _solicitud.CuentaOtrosTributos = v ?? string.Empty" Options="@_opcionesCuentas" Disabled="@(_impHecho || _impBusy)" />
                <AlfaSelect Label="Unidad de negocio" Value="@_solicitud.Unidad" ValueChanged="v => _solicitud.Unidad = v ?? string.Empty" Options="@_opcionesUnidades" Disabled="@(_impHecho || _impBusy)" />
                <AlfaSelect Label="Proveedores que no existen" Value="@_solicitud.ProveedoresNuevos.ToString()" ValueChanged="CambiarModoProveedor"
                            Options="@OpcionesProveedor(ctx)" Disabled="@(_impHecho || _impBusy)" />
                @if (_solicitud.ProveedoresNuevos == ControlArcaProveedorModo.Alta)
                {
                    <AlfaSelect Label="Condición de compra (proveedores nuevos)" Value="@_solicitud.CondicionCompra" ValueChanged="v => _solicitud.CondicionCompra = v ?? string.Empty"
                                Options="@_opcionesCondiciones" Disabled="@(_impHecho || _impBusy)" />
                }
            </div>
            <div class="ca-tabla__marco"><div class="ca-tabla__scroll ca-imp__scroll">
                <table class="ca-tabla">
                    <thead><tr><th>Comprobante</th><th>Fecha</th><th>Emisor</th><th>Proveedor</th><th class="n">Total</th><th>@(_impHecho ? "Resultado" : "Estado")</th></tr></thead>
                    <tbody>
                    @foreach (var f in ctx.Filas)
                    {
                        <tr>
                            <td>@f.Comprobante</td>
                            <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@f.Nombre<small>@f.Cuit</small></td>
                            <td>
                                @if (f.Proveedor.Length > 0) { <span>@f.Proveedor · @f.ProveedorNombre</span> }
                                else { <span class="ca-imp__nuevo">@ProveedorNuevoTexto()</span> }
                            </td>
                            <td class="n">@f.Total.ToString("N2", Culture)</td>
                            <td class="ca-obs">
                                @if (_impHecho) { <span class="@(f.Importado ? "ca-ok" : "ca-mal")">@f.Resultado</span> }
                                else if (f.Bloqueo.Length > 0) { <span class="ca-mal">@f.Bloqueo</span> }
                                else { <span class="ca-ok">Se importa</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div>
            @if (ctx.CierreCompras is { } cierre)
            {
                <small class="ca-nota">Cierre de compras: @cierre.ToString("dd/MM/yyyy"). Lo anterior a esa fecha no se graba.</small>
            }
        </div>
    }
    </ChildContent>
    <Footer>
        @if (_impHecho)
        {
            <AlfaButton Variant="AlfaButtonVariant.Primary" OnClick="_ => CerrarImportacionAsync()">Cerrar y volver a comparar</AlfaButton>
        }
        else
        {
            <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="_impBusy" OnClick="_ => CerrarImportacionAsync()">Cancelar</AlfaButton>
            <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-box-arrow-in-down" Disabled="@(_impBusy || CantidadImportable == 0)" OnClick="_ => ImportarAsync()">
                @(_impBusy ? "Importando…" : $"Importar {CantidadImportable}")
            </AlfaButton>
        }
    </Footer>
</AlfaDialog>

@* ── Historial de importaciones y controles (MV_Transmisiones / AUX_MV_CTROL_CPTE, como el legacy) ── *@
<AlfaDialog Open="@_histAbierto" Title="Historial de ARCA" Size="AlfaDialogSize.Lg" Loading="@_histBusy"
            Description="Importaciones y controles de Mis Comprobantes. Es el mismo registro que usaba Importar Comprobantes del Alfa Gestión."
            ErrorMessage="@_histError" OnClose="() => _histAbierto = false">
    <ChildContent>
        <div class="ca-tablawrap"><div class="ca-tablascroll">
            <table class="ca-tabla">
                <thead><tr><th>Nº</th><th>Fecha</th><th>Usuario</th><th>Qué</th><th class="n">ARCA</th><th class="n">Altas</th><th>Resumen</th></tr></thead>
                <tbody>
                @foreach (var t in _hist)
                {
                    <tr class="@(_histSel == t.Numero ? "ca-sel-fila" : null)" @onclick="() => AbrirTransmisionAsync(t.Numero)" style="cursor:pointer">
                        <td>@t.Numero</td>
                        <td>@t.Fecha.ToString("dd/MM/yyyy") @t.Hora</td>
                        <td>@t.Usuario</td>
                        <td>@t.Observaciones<small>@t.Archivo</small></td>
                        <td class="n">@t.Enviados</td>
                        <td class="n">@t.Recibidos</td>
                        <td class="ca-obs">@(t.Log.Length > 90 && !t.Log.Contains('\n') ? t.Log[..90] + "…" : t.Log.Split('\n')[0])</td>
                    </tr>
                }
                </tbody>
            </table>
        </div></div>
        @if (_hist.Count == 0 && !_histBusy) { <small class="ca-nota">Todavía no hay importaciones ni controles registrados.</small> }
        @if (_histSel is { } sel)
        {
            <h4 class="ca-hist__titulo">Transmisión @sel</h4>
            <div class="ca-tablawrap"><div class="ca-tablascroll">
                <table class="ca-tabla">
                    <thead><tr><th>Comprobante</th><th>Fecha</th><th>Nombre</th><th>Cuenta</th><th class="n">Importe</th><th>Resultado</th></tr></thead>
                    <tbody>
                    @foreach (var d in _histDetalle)
                    {
                        <tr>
                            <td>@d.Comprobante</td><td>@d.Fecha?.ToString("dd/MM/yyyy")</td><td>@d.Nombre</td><td>@d.Cuenta</td>
                            <td class="n">@d.Importe.ToString("N2", Culture)</td>
                            <td class="ca-obs"><span class="@(d.Mensaje.StartsWith("CORRECTO") ? "ca-ok" : "ca-mal")">@d.Mensaje</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div>
        }
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => _histAbierto = false">Cerrar</AlfaButton>
    </Footer>
</AlfaDialog>

@* ── Configuración de la descarga ── *@
<AlfaDialog Open="@(_cfgEdit is not null)" Title="Descarga de Mis Comprobantes" Size="AlfaDialogSize.Lg" Loading="@_cfgBusy"
            Description="Mismos datos que Importar Comprobantes del Alfa Gestión: lo que se configura acá vale para los dos."
            ErrorMessage="@_cfgEditError" CloseOnBackdrop="false" OnClose="() => _cfgEdit = null">
    <ChildContent>
    @if (_cfgEdit is { } c)
    {
        <div class="ca-cfg">
            <div class="ca-imp__grid">
                <AlfaInput Label="CUIT de ingreso a ARCA" Value="@c.CuitLogin" ValueChanged="v => c.CuitLogin = v ?? string.Empty" MaxLength="13" />
                <AlfaInput Label="Clave fiscal" Type="password" Value="@c.ClaveNueva" ValueChanged="v => c.ClaveNueva = v" MaxLength="50"
                           Placeholder="@(c.TieneClave ? "Guardada · escribí para cambiarla" : "")" HelpText="Se guarda ofuscada, como en el Alfa Gestión; nunca se muestra." />
                <AlfaInput Label="CUIT representado (empresa)" Value="@c.CuitRepresentado" ValueChanged="v => c.CuitRepresentado = v ?? string.Empty" MaxLength="13" />
            </div>
            <p class="ca-nota">@(c.ScriptExiste && c.PythonExiste ? "La descarga corre en el servidor de AlfaCore (script y carpeta administrados por ALFA NET)." : "La descarga de ARCA todavía no está instalada en el servidor: por ahora solo se puede subir el archivo a mano. Avisá a ALFA NET.")</p>
            <div class="ca-cfg__auto">
                <strong>Todos los días, bajar de ARCA y comparar</strong>
                <AlfaCheckbox Value="@c.AutoRecibidos" ValueChanged="v => c.AutoRecibidos = v == true">Recibidos (contra el libro de IVA compras)</AlfaCheckbox>
                <AlfaCheckbox Value="@c.AutoEmitidos" ValueChanged="v => c.AutoEmitidos = v == true">Emitidos (contra las ventas)</AlfaCheckbox>
                <label class="ca-cfg__hora">A partir de las <input type="time" class="ca-input" value="@c.HoraAuto" @onchange="e => c.HoraAuto = e.Value?.ToString() ?? c.HoraAuto" /></label>
                <small>Baja el mes actual (y el anterior hasta el día 10) y deja el resultado en esta pantalla. No graba comprobantes: los faltantes se importan desde acá.</small>
            </div>
        </div>
    }
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="_cfgBusy" OnClick="_ => _cfgEdit = null">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check2" Disabled="_cfgBusy" OnClick="_ => GuardarConfigAsync()">Guardar</AlfaButton>
    </Footer>
</AlfaDialog>

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private const long MaximoArchivo = 15 * 1024 * 1024;
    private ControlArcaResultado? _r;
    private ControlArcaEstado? _estado;
    private string? _archivo;
    private byte[]? _bytes;
    private AppUiMessage? _feedback;
    private bool _busy, _disposed, _exportando, _descargando;
    private int _segundos;
    // Historial
    private bool _histAbierto, _histBusy;
    private string? _histError;
    private int? _histSel;
    private IReadOnlyList<ControlArcaTransmision> _hist = [];
    private IReadOnlyList<ControlArcaTransmisionDetalle> _histDetalle = [];
    private PageHeaderConfig? _header;
    // Descarga
    private ArcaDescargaConfig? _cfg, _cfgEdit;
    private string? _cfgError, _cfgEditError;
    private bool _cfgBusy, _descargaRecibidos = true;
    private string _periodo = DateTime.Today.ToString("yyyy-MM");
    private IReadOnlyList<ArcaArchivoDescargado> _archivos = [];
    // Importación
    private readonly HashSet<ControlArcaFila> _sel = [];
    private ControlArcaImportacionContexto? _imp;
    private ControlArcaImportacionSolicitud _solicitud = new();
    private IReadOnlyList<AlfaSelectOption> _opcionesCuentas = [], _opcionesUnidades = [], _opcionesCondiciones = [];
    private bool _impBusy, _impHecho;
    private string? _impError;

    protected override async Task OnInitializedAsync()
    {
        UpdateHeader();
        await CargarDescargaAsync();
    }

    private async Task ArchivoElegidoAsync(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        var f = e.File;
        if (f.Size > MaximoArchivo) { _feedback = AppUiMessage.Warning("Archivo muy grande", "El archivo supera los 15 MB: consultá un período más corto."); return; }
        _busy = true; _feedback = null; UpdateHeader(); StateHasChanged();
        try
        {
            await using var s = f.OpenReadStream(MaximoArchivo);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            await ControlarAsync(ms.ToArray(), f.Name);
        }
        finally { _busy = false; if (!_disposed) { UpdateHeader(); StateHasChanged(); } }
    }

    private async Task ControlarAsync(byte[] bytes, string nombre)
    {
        _archivo = nombre; _bytes = bytes;
        var r = await UiOps.RunAsync(() => Service.ControlarAsync(bytes, nombre), "Control contra ARCA");
        if (r.Success) { _r = r.Value; _estado = null; _sel.Clear(); } else _feedback = r.Feedback;
    }

    // ── Descarga ──

    private async Task CargarDescargaAsync()
    {
        try
        {
            _cfg = await Descarga.GetConfigAsync();
            _descargaRecibidos = true;
            _archivos = await Descarga.ArchivosAsync();
            _cfgError = null;
        }
        catch (Exception ex)
        {
            _cfg = null;
            _cfgError = ex is AppUserFacingException or InvalidOperationException ? ex.Message : "No se pudo leer la configuración de la descarga.";
        }
        UpdateHeader();
    }

    private static string AutoTexto(ArcaDescargaConfig c)
    {
        var tipos = new[] { c.AutoRecibidos ? "recibidos" : null, c.AutoEmitidos ? "emitidos" : null }.OfType<string>().ToList();
        if (tipos.Count == 0) return "La descarga automática diaria está apagada (Configurar descarga).";
        var ultima = new[] { c.AutoRecibidos && c.UltimaAutoRecibidos.Length > 0 ? "Recibidos " + c.UltimaAutoRecibidos : null,
                             c.AutoEmitidos && c.UltimaAutoEmitidos.Length > 0 ? "Emitidos " + c.UltimaAutoEmitidos : null }.OfType<string>().ToList();
        return $"Todos los días desde las {c.HoraAuto}: {string.Join(" y ", tipos)}. " + (ultima.Count > 0 ? "Última: " + string.Join(" | ", ultima) : "Todavía no corrió.");
    }

    private async Task AbrirHistorialAsync()
    {
        _histAbierto = true; _histBusy = true; _histError = null; _histSel = null; _histDetalle = [];
