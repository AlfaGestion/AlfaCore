    private Task AbrirConfig()
    {
        if (_cfg is null) return Task.CompletedTask;
        _cfgEditError = null;
        _cfgEdit = new ArcaDescargaConfig
        {
            CuitLogin = _cfg.CuitLogin, TieneClave = _cfg.TieneClave, CuitRepresentado = _cfg.CuitRepresentado,
            AutoRecibidos = _cfg.AutoRecibidos, AutoEmitidos = _cfg.AutoEmitidos, HoraAuto = _cfg.HoraAuto,
            ScriptExiste = _cfg.ScriptExiste, PythonExiste = _cfg.PythonExiste
        };
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task GuardarConfigAsync()
    {
        if (_cfgEdit is null || _cfgBusy) return;
        _cfgBusy = true; _cfgEditError = null;
        try
        {
            await Descarga.GuardarConfigAsync(_cfgEdit);
            _cfgEdit = null;
            await CargarDescargaAsync();
            _feedback = AppUiMessage.Success("Descarga configurada", "Se guardó la configuración de la descarga de ARCA.");
        }
        catch (Exception ex) { _cfgEditError = ex is AppUserFacingException or InvalidOperationException ? ex.Message : "No se pudo guardar la configuración."; }
        finally { _cfgBusy = false; }
    }

    private async Task DescargarAsync()
    {
        if (_busy || _cfg is null) return;
        if (!DateTime.TryParseExact(_periodo + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var p))
        { _feedback = AppUiMessage.Warning("Período", "Elegí el mes a descargar."); return; }
        _busy = true; _descargando = true; _segundos = 0; _feedback = null; UpdateHeader(); StateHasChanged();
        using var reloj = new CancellationTokenSource();
        _ = RelojAsync(reloj.Token);
        try
        {
            var r = await UiOps.RunAsync(() => Descarga.DescargarAsync(_descargaRecibidos, p.Year, p.Month), "Descarga de ARCA");
            reloj.Cancel(); _descargando = false; StateHasChanged();
            if (!r.Success) { _feedback = r.Feedback; return; }
            _archivos = await Descarga.ArchivosAsync();
            await ControlarAsync(await Descarga.LeerArchivoAsync(r.Value!.Nombre), r.Value.Nombre);
        }
        finally { reloj.Cancel(); _busy = false; _descargando = false; if (!_disposed) { UpdateHeader(); StateHasChanged(); } }
    }

    /// <summary>Cuenta los segundos de la descarga para que se vea que no está colgado (el script tarda 1 a 3 minutos).</summary>
    private async Task RelojAsync(CancellationToken ct)
    {
        try
        {
            using var t = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await t.WaitForNextTickAsync(ct)) { _segundos++; if (_disposed) return; await InvokeAsync(StateHasChanged); }
        }
        catch (OperationCanceledException) { }
    }

    private async Task CompararDescargadoAsync(ArcaArchivoDescargado a)
    {
        if (_busy) return;
        _busy = true; _feedback = null; UpdateHeader(); StateHasChanged();
        try
        {
            var r = await UiOps.RunAsync(() => Descarga.LeerArchivoAsync(a.Nombre), "Archivo descargado");
            if (r.Success) await ControlarAsync(r.Value!, a.Nombre); else _feedback = r.Feedback;
        }
        finally { _busy = false; if (!_disposed) { UpdateHeader(); StateHasChanged(); } }
    }

    // ── Importación de faltantes ──

    private static bool PuedeImportar(ControlArcaResultado r) => r.Recibidos && r.Cantidad(ControlArcaEstado.FaltaEnSistema) > 0;
    private static IEnumerable<ControlArcaFila> Importables(IEnumerable<ControlArcaFila> filas) => filas.Where(f => f.Estado == ControlArcaEstado.FaltaEnSistema && f.Arca is not null);
    private void Seleccionar(ControlArcaFila f, bool valor) { if (valor) _sel.Add(f); else _sel.Remove(f); UpdateHeader(); }
    private void SeleccionarTodos(IEnumerable<ControlArcaFila> filas, bool valor)
    {
        foreach (var f in Importables(filas)) { if (valor) _sel.Add(f); else _sel.Remove(f); }
        UpdateHeader();
    }
    private int CantidadImportable => _imp?.Filas.Count(f => f.Bloqueo.Length == 0) ?? 0;
    private string ProveedorNuevoTexto() => _solicitud.ProveedoresNuevos switch
    {
        ControlArcaProveedorModo.Alta => "Nuevo: se da de alta con los datos de ARCA",
        ControlArcaProveedorModo.Varios => "No existe: va a proveedores varios",
        _ => "No existe: no se importa"
    };
    private static IReadOnlyList<AlfaSelectOption> OpcionesProveedor(ControlArcaImportacionContexto c) =>
    [
        new(nameof(ControlArcaProveedorModo.Alta), "Darlos de alta con los datos de ARCA", !c.PuedeCrearProveedores),
        new(nameof(ControlArcaProveedorModo.Varios), "Imputarlos a proveedores varios", c.CuentaProveedoresVarios.Length == 0),
        new(nameof(ControlArcaProveedorModo.Omitir), "No importarlos")
    ];
    private void CambiarModoProveedor(string? v)
        => _solicitud.ProveedoresNuevos = Enum.TryParse<ControlArcaProveedorModo>(v, out var m) ? m : ControlArcaProveedorModo.Omitir;

    private async Task AbrirImportacionAsync()
    {
        if (_r is null || _sel.Count == 0 || _busy) return;
        _busy = true; UpdateHeader(); StateHasChanged();
        try
        {
            var comprobantes = _sel.Select(f => f.Arca!).ToList();
            var cuit = _r.CuitArchivo;
            var r = await UiOps.RunAsync(() => Importacion.ContextoAsync(comprobantes, cuit), "Importar faltantes");
            if (!r.Success) { _feedback = r.Feedback; return; }
            var ctx = r.Value!;
            _opcionesCuentas = ctx.Cuentas.Select(c => new AlfaSelectOption(c.Codigo, $"{c.Codigo} · {c.Descripcion}")).ToList();
            _opcionesUnidades = ctx.Unidades.Select(u => new AlfaSelectOption(u.Codigo, $"{u.Codigo} · {u.Descripcion}")).ToList();
            _opcionesCondiciones = ctx.CondicionesCompra.Select(c => new AlfaSelectOption(c.Codigo, c.Descripcion)).ToList();
            _solicitud = new ControlArcaImportacionSolicitud
            {
                Comprobantes = comprobantes, CuentaCompras = ctx.CuentaCompras, CuentaIva = ctx.CuentaIva, CuentaOtrosTributos = ctx.CuentaOtrosTributos,
                Unidad = ctx.Unidad, CondicionCompra = ctx.CondicionCompra, Archivo = _archivo ?? string.Empty,
                ProveedoresNuevos = ctx.PuedeCrearProveedores ? ControlArcaProveedorModo.Alta
                    : ctx.CuentaProveedoresVarios.Length > 0 ? ControlArcaProveedorModo.Varios : ControlArcaProveedorModo.Omitir
            };
            _impHecho = false; _impError = null; _imp = ctx;
        }
        finally { _busy = false; if (!_disposed) { UpdateHeader(); StateHasChanged(); } }
    }

    private async Task ImportarAsync()
    {
        if (_imp is null || _impBusy) return;
        _impBusy = true; _impError = null; StateHasChanged();
        try
        {
            var bloqueadas = _imp.Filas.Where(f => f.Bloqueo.Length > 0).Select(f => f.Clave).ToHashSet();
            _solicitud.Comprobantes = _solicitud.Comprobantes.Where(c => !bloqueadas.Contains(ControlArcaImportacionService.Clave(c))).ToList();
            var resultado = await Importacion.ImportarAsync(_solicitud);
            var porClave = resultado.GroupBy(x => x.Clave).ToDictionary(g => g.Key, g => g.First());
            foreach (var f in _imp.Filas)
            {
                if (!porClave.TryGetValue(f.Clave, out var x)) { f.Resultado = f.Bloqueo; continue; }
                f.Resultado = x.Resultado; f.Importado = x.Importado;
                if (x.Proveedor.Length > 0) { f.Proveedor = x.Proveedor; f.ProveedorNombre = x.ProveedorNombre; }
            }
            _impHecho = true;
        }
        catch (Exception ex) { _impError = ex is AppUserFacingException or InvalidOperationException ? ex.Message : "No se pudo importar."; }
        finally { _impBusy = false; if (!_disposed) StateHasChanged(); }
    }

    private async Task CerrarImportacionAsync()
    {
        if (_impBusy) return;
        var recontrolar = _impHecho;
        _imp = null; _impHecho = false;
        if (recontrolar && _bytes is not null && _archivo is not null)
        {
            _busy = true; UpdateHeader(); StateHasChanged();
            try { await ControlarAsync(_bytes, _archivo); }
            finally { _busy = false; if (!_disposed) { UpdateHeader(); StateHasChanged(); } }
        }
    }

    private async Task ExportarAsync()
    {
        if (_r is null || _exportando) return;
        _exportando = true; UpdateHeader();
        try
        {
            var a = await Service.ExportarAsync(_r);
            await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob", Convert.ToBase64String(a.Contenido), a.ContentType, a.Nombre);
        }
        finally { _exportando = false; if (!_disposed) UpdateHeader(); }
    }

    private void UpdateHeader()
    {
        var acciones = new List<PageHeaderAction>();
        if (_r is { } r && PuedeImportar(r))
            acciones.Add(new() { Key = "importar", Label = _sel.Count > 0 ? $"Importar faltantes ({_sel.Count})" : "Importar faltantes", Icon = "bi-box-arrow-in-down",
                Style = PageHeaderActionStyle.Primary, Disabled = _busy || _sel.Count == 0, OnClick = AbrirImportacionAsync });
        acciones.Add(new() { Key = "historial", Label = "Historial", Icon = "bi-clock-history", Style = PageHeaderActionStyle.Secondary,
            Disabled = _busy, OnClick = AbrirHistorialAsync });
        acciones.Add(new() { Key = "config", Label = "Configurar descarga", Icon = "bi-gear", Style = PageHeaderActionStyle.Secondary,
            Disabled = _busy || _cfg is null, OnClick = AbrirConfig });
        acciones.Add(new() { Key = "excel", Label = "Excel", Icon = "bi-file-earmark-excel", Style = PageHeaderActionStyle.Secondary,
            Disabled = _busy || _r is null || _exportando, Busy = _exportando, OnClick = ExportarAsync });
        PageHeader.Set(_header = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot, ModuleKey = "contabilidad", Title = "Control contra ARCA",
            Breadcrumb = ["Contabilidad", "Control contra ARCA"],
            TopNavigationItems = ModuleTopNavPresets.BuildContabilidad(RouteContext, Nav, "control-arca"),
            State = _busy ? PageHeaderState.Loading : PageHeaderState.List,
            Actions = acciones
        });
    }

    private static string Icono(string bi) => $"<i class=\"bi {bi}\" aria-hidden=\"true\"></i>";
    private static string Moneda(decimal v) => v.ToString("C2", Culture);

    public void Dispose()
    {
        _disposed = true;
        if (ReferenceEquals(PageHeader.Current, _header)) PageHeader.Clear();
    }
