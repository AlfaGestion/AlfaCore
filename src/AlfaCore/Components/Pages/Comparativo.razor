@page "/ventas/comparativo"
@page "/{idweb}/{idbase:int}/ventas/comparativo"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.GestionFilterStateService FilterState
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Comparativo Ventas / Compras | Alfa Gestión</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Comparativo</h2>
            <p>Ventas vs. compras para el período seleccionado — evolución mensual y balance.</p>
        </div>
    </header>

    @if (_loading)
    {
        <AlfaEmptyState Title="Cargando" Message="Buscando datos del período." />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudieron cargar los datos" Message="@_error" />
    }
    else
    {
        var balanceCss = _comp.Balance >= 0 ? "kpi-card--balance-pos" : "kpi-card--balance-neg";

        <section class="kpi-grid">
            <article class="kpi-card">
                <div class="kpi-card__label">Total ventas período</div>
                <div class="kpi-card__value">@FmtMoney(_comp.TotalVentas)</div>
            </article>
            <article class="kpi-card kpi-card--compras">
                <div class="kpi-card__label">Total compras período</div>
                <div class="kpi-card__value">@FmtMoney(_comp.TotalCompras)</div>
            </article>
            <article class="kpi-card @balanceCss">
                <div class="kpi-card__label">Balance (ventas − compras)</div>
                <div class="kpi-card__value">@FmtMoney(_comp.Balance)</div>
            </article>
        </section>

        <article class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Ventas vs. Compras por mes</h3>
                    <p class="panel-card__subtitle">Barras agrupadas — azul: ventas · naranja: compras</p>
                </div>
            </div>
            <DualBarChart Data="_comp.EvolucionMensual" Ancho="1400" />
        </article>

        <section class="two-grid">
            <article class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Evolución ventas</h3>
                        <p class="panel-card__subtitle">Últimos 12 meses</p>
                    </div>
                </div>
                <LineChart Data="_ventasMensuales" Titulo="Evolución ventas" Subtitulo="Últimos 12 meses" ChartType="line" />
            </article>
            <article class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Evolución compras</h3>
                        <p class="panel-card__subtitle">Últimos 12 meses</p>
                    </div>
                </div>
                <LineChart Data="_comprasMensuales" Titulo="Evolución compras" Subtitulo="Últimos 12 meses" ChartType="line" />
            </article>
        </section>

        <article class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Detalle mensual</h3>
                    <p class="panel-card__subtitle">Ventas vs. compras mes a mes</p>
                </div>
            </div>
            <table class="comparativo-table" data-sticky-list-header>
                <thead>
                    <tr>
                        <th>Período</th>
                        <th>Ventas</th>
                        <th>Compras</th>
                        <th>Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _comp.EvolucionMensual)
                    {
                        var bal = row.Ventas - row.Compras;
                        <tr>
                            <td>@FmtPeriodo(row.Periodo)</td>
                            <td>@FmtMoney(row.Ventas)</td>
                            <td>@FmtMoney(row.Compras)</td>
                            <td class="@(bal >= 0 ? "balance-pos" : "balance-neg")">@FmtMoney(bal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </article>
    }
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private bool _loading = true;
    private string _error = string.Empty;

    private ComparativoVentasComprasDto _comp = new();
    private VentasDashboardFilters _filters = null!;

    private IReadOnlyList<MonthlyPointDto> _ventasMensuales  = [];
    private IReadOnlyList<MonthlyPointDto> _comprasMensuales = [];

    protected override void OnInitialized()
    {
        _filters = FilterState.Ventas;
        UpdatePageHeader();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    // Solo el período (el comparativo no usa los demás filtros comerciales).
    private RenderFragment RenderSmartSearch() => @<VentasSmartSearch Model="_filters" OnApply="LoadAsync" SoloPeriodo="true" />;

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "ventas",
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildVentas(RouteContext, Nav, "comparativo")
    });

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Ventas;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = string.Empty;
        try
        {
            _comp = await GestionSvc.GetComparativoAsync(_filters);
            _ventasMensuales  = _comp.EvolucionMensual
                .Select(m => new MonthlyPointDto { Periodo = m.Periodo, Total = m.Ventas })
                .ToList();
            _comprasMensuales = _comp.EvolucionMensual
                .Select(m => new MonthlyPointDto { Periodo = m.Periodo, Total = m.Compras })
                .ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static string FmtMoney(decimal value)
        => value.ToString("$ #,##0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static string FmtPeriodo(string periodo)
    {
        var inv  = System.Globalization.CultureInfo.InvariantCulture;
        var esAr = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
        if (DateTime.TryParseExact(periodo, "yyyy-MM", inv,
                System.Globalization.DateTimeStyles.None, out var m))
        {
            var mes = m.ToString("MMMM", esAr);
            return $"{char.ToUpper(mes[0])}{mes[1..]} {m.Year}";
        }
        return periodo;
    }
}
