@page "/ventas/articulos"
@page "/{idweb}/{idbase:int}/ventas/articulos"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.GestionFilterStateService FilterState
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Artículos | Ventas</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Artículos más vendidos</h2>
            <p>Artículos líderes por importe y cantidad, con lectura rápida de actividad reciente.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="No se pudieron cargar los datos" Message="@_error" />
    }
    else if (_page is null)
    {
        <AlfaEmptyState Title="Cargando artículos" Message="Buscando datos del período." />
    }
    else
    {
        <div class="kpi-grid">
            <KpiCard Titulo="Total vendido" Valor="@Moneda(_page.TotalVendido)" Icono="$" />
            <KpiCard Titulo="Artículos activos" Valor="@_page.ArticulosActivos.ToString("N0")" Icono="A" />
            <KpiCard Titulo="Cantidad vendida" Valor="@_page.CantidadVendida.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))" Icono="Q" />
        </div>

        <div class="three-grid">
            <section class="panel-card">
                <HorizontalBarChart Data="_page.TopPorTotal" Titulo="Top por total" Subtitulo="Artículos con mayor facturación" />
            </section>
            <section class="panel-card">
                <HorizontalBarChart Data="_page.TopPorCantidad" Titulo="Top por cantidad" Subtitulo="Artículos con mayor volumen" Formato="numero" />
            </section>
        </div>

        <DataTable Titulo="Listado de artículos" Subtitulo="Impacto económico y volumen vendido">
            <Header>
                <tr>
                    <th>Artículo</th>
                    <th style="text-align:right;">Cantidad</th>
                    <th style="text-align:right;">Total</th>
                    <th style="text-align:right;">Comprobantes</th>
                    <th>Última venta</th>
                </tr>
            </Header>
            <Rows>
                @foreach (var item in _page.Articulos)
                {
                    <tr>
                        <td><strong>@item.Descripcion</strong><div class="text-muted">@item.IdArticulo</div></td>
                        <td style="text-align:right;">@item.CantidadVendida.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td>
                        <td style="text-align:right;">@Moneda(item.TotalVendido)</td>
                        <td style="text-align:right;">@item.CantidadComprobantes.ToString("N0")</td>
                        <td>@Fecha(item.UltimaVenta)</td>
                    </tr>
                }
            </Rows>
        </DataTable>
    }
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private VentasDashboardFilters _filters = null!;
    private VentasFilterOptionsDto _options = new();
    private VentasArticulosPageDto? _page;
    private string? _error;

    protected override void OnInitialized()
    {
        _filters = FilterState.Ventas;
        UpdatePageHeader();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    // Filtros en el Context Toolbar (Smart Search). El fragmento lee _filters/_options al dibujarse:
    // después de cargar las opciones se vuelve a publicar el header.
    private RenderFragment RenderSmartSearch() => @<VentasSmartSearch Model="_filters" Options="_options" OnApply="LoadAsync" />;

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "ventas",
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildVentas(RouteContext, Nav, "articulos")
    });

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Ventas;
        _options = await GestionSvc.GetVentasFilterOptionsAsync();
        UpdatePageHeader();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try { _page = await GestionSvc.GetVentasArticulosAsync(_filters); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string Moneda(decimal valor) => valor.ToString("$ #,##0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
    private static string Fecha(DateTime? fecha) => fecha?.ToString("dd/MM/yyyy") ?? "Sin dato";
}
