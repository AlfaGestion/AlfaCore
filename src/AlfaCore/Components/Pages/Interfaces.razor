@code {
    private readonly InterfacesFilters _filters = new();
    private readonly List<InterfacesInboxItemDto> _items = [];
    private readonly List<InterfacesEstadoOptionDto> _states = [];
    private readonly List<InterfacesTipoDocumentoOptionDto> _documentTypes = [];
    private readonly List<InterfacesViewColumnDto> _viewSettingsDraft = [];
    private readonly HashSet<long> _selectedIds = [];
    private AppUiMessage? _feedback;
    private InterfacesViewSettingsDto _viewSettings = BuildDefaultViewSettings();
    private InterfacesCompraIaQueueSnapshotDto _queueSnapshot = new();
    private InterfacesCompraIaResultadoDto? _detalleLectura;
    private bool _loadingList;
    private bool _loadingQueue;
    private bool _loadingDetalleLectura;
    private bool _showDetalleLecturaModal;
    private bool _showViewSettings;
    private bool _viewSettingsLoaded;
    private long _selectedId;
    private long? _detalleLecturaDocumentoId;
    private int _pagedTotal;
    private int _pageNumber = 1;
    private int _totalPages = 1;
    private bool _hasPrev;
    private bool _hasNext;
    private bool _showMobileFilters;
    private bool _showMobileBulkActions;
    private long? _openRowActionsId;
    private string _draftAgruparPor = InterfacesViewGroupKeys.None;
    private string _viewSettingsUserName = string.Empty;
    private string _bulkAction = BulkActionDelete;
    private DateTime? _filtersDesde = DateTime.Today.AddDays(-30);
    private DateTime? _filtersHasta = DateTime.Today;
    private CancellationTokenSource? _filtersDebounceCts;
    private CancellationTokenSource? _queueAutoRefreshCts;
    private Task? _queueAutoRefreshTask;
    private bool AreAllCurrentPageSelected => _items.Count > 0 && _items.All(item => _selectedIds.Contains(item.IdComprobanteRecibido));

    protected override async Task OnInitializedAsync()
    {
        AppUserSession.StateChanged += OnAppUserSessionChanged;
        await EnsureViewSettingsLoadedAsync();
        await CargarCatalogosAsync();
        await BuscarAsync();
        await CargarColaAsync();
        EnsureQueueAutoRefreshLoop();
    }

    public void Dispose()
    {
        AppUserSession.StateChanged -= OnAppUserSessionChanged;
        _filtersDebounceCts?.Cancel();
        _filtersDebounceCts?.Dispose();
        _queueAutoRefreshCts?.Cancel();
        _queueAutoRefreshCts?.Dispose();
    }

    private async Task CargarCatalogosAsync()
    {
        var statesResult = await UiOps.RunAsync(() => InterfacesSvc.GetStatesAsync(), "No se pudieron cargar los estados.");
        if (statesResult.Success && statesResult.Value is not null)
        {
            _states.Clear();
            _states.AddRange(statesResult.Value);
        }

        var typesResult = await UiOps.RunAsync(() => InterfacesSvc.GetDocumentTypesAsync(), "No se pudieron cargar los tipos documentales.");
        if (typesResult.Success && typesResult.Value is not null)
        {
            _documentTypes.Clear();
            _documentTypes.AddRange(typesResult.Value);
        }
    }

    private async Task RecargarAsync()
    {
        await CargarCatalogosAsync();
        await BuscarAsync();
        await CargarColaAsync();
    }

    private async Task AplicarFiltrosAsync()
    {
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task HandleApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase) || _loadingList)
            return;

        await AplicarFiltrosAsync();
    }

    private async Task OnFiltersChangedAsync()
    {
        _filters.PageNumber = 1;
        await BuscarDebouncedAsync();
    }

    private async Task BuscarDebouncedAsync(int delayMs = 240)
    {
        _filtersDebounceCts?.Cancel();
        _filtersDebounceCts?.Dispose();

        var cts = new CancellationTokenSource();
        _filtersDebounceCts = cts;

        try
        {
            await Task.Delay(delayMs, cts.Token);
            if (!cts.IsCancellationRequested)
                await BuscarAsync();
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(_filtersDebounceCts, cts))
            {
                _filtersDebounceCts = null;
                cts.Dispose();
            }
        }
    }

    private async Task BuscarAsync()
    {
        _loadingList = true;
        _filters.Desde = _filtersDesde;
        _filters.Hasta = _filtersHasta;

        try
        {
            var result = await UiOps.RunAsync(() => InterfacesSvc.SearchAsync(_filters), "No se pudieron cargar los documentos.");
            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _items.Clear();
            _items.AddRange(result.Value.Items);
            if (_openRowActionsId.HasValue && !_items.Any(item => item.IdComprobanteRecibido == _openRowActionsId.Value))
                _openRowActionsId = null;
            _selectedIds.IntersectWith(_items.Select(item => item.IdComprobanteRecibido));
            if (_selectedId > 0 && !_items.Any(item => item.IdComprobanteRecibido == _selectedId))
                _selectedId = 0;
            _pagedTotal = result.Value.Total;
            _pageNumber = result.Value.PageNumber;
            _totalPages = result.Value.TotalPages;
            _hasPrev = result.Value.HasPrev;
            _hasNext = result.Value.HasNext;
        }
        finally
        {
            _loadingList = false;
        }
    }

    private async Task CargarColaAsync(bool silent = false)
    {
        _loadingQueue = true;
        try
        {
            var result = await UiOps.RunAsync(() => InterfacesSvc.GetCompraIaQueueSnapshotAsync(), "No se pudo cargar la cola de procesamiento de compras.");
            if (!result.Success || result.Value is null)
            {
                if (!silent)
                    SetFeedback(result.Feedback);
                return;
            }

            _queueSnapshot = result.Value;
            EnsureQueueAutoRefreshLoop();
        }
        finally
        {
            _loadingQueue = false;
        }
    }

    private bool HasQueueWorkInProgress()
        => _queueSnapshot.Pendientes > 0
           || _queueSnapshot.Items.Any(item => item.Estado is "PENDIENTE_LECTURA" or "PROCESANDO_LECTURA");

    private void EnsureQueueAutoRefreshLoop()
    {
        if (!HasQueueWorkInProgress())
        {
            _queueAutoRefreshCts?.Cancel();
            return;
        }

        if (_queueAutoRefreshTask is { IsCompleted: false })
            return;

        _queueAutoRefreshCts?.Cancel();
        _queueAutoRefreshCts?.Dispose();
        _queueAutoRefreshCts = new CancellationTokenSource();
        _queueAutoRefreshTask = RunQueueAutoRefreshLoopAsync(_queueAutoRefreshCts.Token);
    }

    private async Task RunQueueAutoRefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(2500, token);
                if (token.IsCancellationRequested)
                    break;

                await InvokeAsync(async () =>
                {
                    if (_loadingQueue)
                        return;

                    await CargarColaAsync(silent: true);
                    if (!HasQueueWorkInProgress())
                    {
                        await BuscarAsync();
                        _queueAutoRefreshCts?.Cancel();
                    }
                });
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void AbrirFicha(long id)
        => Navigation.NavigateTo($"/interfaces/{id}");

    private async Task VerDetalleLecturaAsync(long idComprobanteRecibido)
    {
        if (_loadingDetalleLectura)
            return;

        _showDetalleLecturaModal = true;

        if (_detalleLecturaDocumentoId == idComprobanteRecibido && _detalleLectura is not null)
        {
            CerrarDetalleLectura();
            return;
        }

        _loadingDetalleLectura = true;
        try
        {
            var result = await UiOps.RunAsync(() => InterfacesSvc.GetByIdAsync(idComprobanteRecibido), "No se pudo cargar el detalle de lectura automática.");
            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                _showDetalleLecturaModal = false;
                return;
            }

            if (result.Value.LecturaCompra is null)
            {
                _detalleLectura = null;
                _detalleLecturaDocumentoId = null;
                _showDetalleLecturaModal = false;
                SetFeedback(new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Sin lectura automática",
                    Message = $"El documento #{idComprobanteRecibido} todavía no tiene una lectura automática guardada.",
                    Suggestion = "Procesalo desde la ficha o esperá a que termine la cola de compras si ya fue encolado."
                });
                return;
            }

            _detalleLectura = result.Value.LecturaCompra;
            _detalleLecturaDocumentoId = idComprobanteRecibido;
        }
        finally
        {
            _loadingDetalleLectura = false;
        }
    }

    private void CerrarDetalleLectura()
    {
        _showDetalleLecturaModal = false;
        _detalleLectura = null;
        _detalleLecturaDocumentoId = null;
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page > _totalPages || _loadingList)
            return;

        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
            _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private void LimpiarFiltros()
    {
        _filters.Texto = string.Empty;
