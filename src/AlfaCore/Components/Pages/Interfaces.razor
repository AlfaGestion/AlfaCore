@page "/interfaces"
@using AlfaCore.Models
@inject AlfaCore.Services.IInterfacesService InterfacesSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Interfaces | Alfa Gestión</PageTitle>

<div class="page-grid interfaces-page interfaces-list-page">
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">Recepción documental</h2>
            <p class="page-intro__text">Listado principal del módulo con formato estándar del sistema: filtros, grilla configurable y acceso a la ficha completa del documento.</p>
        </div>
        <div class="actions">
            <a class="btn btn--primary" href="/interfaces/nuevo">
                <i class="bi bi-plus-circle"></i> Nuevo
            </a>
            <a class="btn btn--ghost" href="/interfaces/configuracion">
                <i class="bi bi-sliders"></i> Configuración
            </a>
            <button type="button" class="btn btn--ghost" @onclick="RecargarAsync" disabled="@_loadingList">
                <i class="bi bi-arrow-clockwise"></i> Recargar
            </button>
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </section>
    }

    <div class="interfaces-mobile-toolbar">
        <button type="button" class="btn btn--ghost" @onclick="ToggleMobileFilters">
            <i class="bi bi-funnel"></i> Filtros
        </button>
        <button type="button" class="btn btn--ghost" @onclick="ToggleMobileBulkActions">
            <i class="bi bi-lightning-charge"></i> Acciones
        </button>
    </div>

    <section class="panel-card smart-search-card interfaces-sticky-filters @GetMobileFiltersSectionClass()" @onclick:stopPropagation>
        <div class="smart-search">
            <div class="smart-search__bar">
                <i class="bi bi-search"></i>
                <input type="search"
                       placeholder="Buscar por observación, proveedor, usuario o número interno..."
                       @bind="_filters.Texto"
                       @bind:event="oninput"
                       @bind:after="OnFiltersChangedAsync"
                       @onkeydown="HandleApplyKeyDownAsync" />
            </div>
            <div class="smart-search__panel interfaces-filters-panel-grid" @onkeydown="HandleApplyKeyDownAsync">
                <div class="smart-search__inline">
                    <label>Desde</label>
                    <input type="date" @bind="_filtersDesde" @bind:after="OnFiltersChangedAsync" />
                </div>
                <div class="smart-search__inline">
                    <label>Hasta</label>
                    <input type="date" @bind="_filtersHasta" @bind:after="OnFiltersChangedAsync" />
                </div>
                <div class="smart-search__inline">
                    <label>Estado</label>
                    <select @bind="_filters.IdEstado" @bind:after="OnFiltersChangedAsync">
                        <option value="">Todos</option>
                        @foreach (var item in _states)
                        {
                            <option value="@item.IdEstado">@item.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="smart-search__inline">
                    <label>Tipo</label>
                    <select @bind="_filters.IdTipoDocumento" @bind:after="OnFiltersChangedAsync">
                        <option value="">Todos</option>
                        @foreach (var item in _documentTypes)
                        {
                            <option value="@item.IdTipoDocumento">@item.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary btn--sm" @onclick="AplicarFiltrosAsync" disabled="@_loadingList">
                        <i class="bi bi-search"></i> Aplicar
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltrosAsync" disabled="@_loadingList">
                        <i class="bi bi-eraser"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </section>

    @if (_showViewSettings)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Elegí columnas visibles, orden y agrupación para la grilla de recepción documental.</p>
                </div>
            </div>

            <div class="usuarios-view-settings">
                <div class="field">
                    <label>Agrupar por</label>
                    <select @bind="_draftAgruparPor">
                        <option value="@InterfacesViewGroupKeys.None">Sin agrupar</option>
                        <option value="@InterfacesViewGroupKeys.Estado">Estado</option>
                        <option value="@InterfacesViewGroupKeys.Tipo">Tipo</option>
                    </select>
                </div>

                <div class="usuarios-view-settings__list">
                    @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="checkbox">
                                <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                <span>@column.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">
                        <i class="bi bi-floppy"></i> Guardar vista
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </div>
        </section>
    }

    @{
        var visibleColumns = GetVisibleColumns();
        var groups = BuildGridGroups();
    }

    <section class="panel-card interfaces-docs-panel">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Documentos recibidos</h3>
                <p class="panel-card__subtitle">@_pagedTotal registro(s) · Página @_pageNumber de @_totalPages · podés abrir la ficha con el botón editar o con doble clic.</p>
            </div>
            <div class="actions">
                <button type="button" class="btn btn--ghost" @onclick="AbrirConfiguracionVista">
                    <i class="bi bi-sliders"></i> Configurar vista
                </button>
                <span class="panel-card__subtitle">Agrupación: @GetGroupingLabel(_viewSettings.AgruparPor)</span>
            </div>
        </div>

        <div class="interfaces-bulkbar @GetMobileBulkbarClass()">
            <div class="field interfaces-bulkbar__field">
                <label>Acciones masivas</label>
                <select @bind="_bulkAction" disabled="@(_loadingList || _selectedIds.Count == 0)">
                    <option value="@BulkActionDelete">Eliminar seleccionados</option>
                </select>
            </div>
            <button type="button"
                    class="btn btn--ghost interfaces-bulkbar__apply"
                    @onclick="EjecutarAccionSeleccionadaAsync"
                    disabled="@(_loadingList || _selectedIds.Count == 0)">
                <i class="bi bi-lightning-charge"></i> Aplicar
            </button>
            <span class="panel-card__subtitle">@GetSelectionSummary()</span>
        </div>

        @if (_loadingList)
        {
            <div class="usuarios-empty">Cargando documentos...</div>
        }
        else if (_items.Count == 0)
        {
            <div class="usuarios-empty">No hay documentos para los filtros seleccionados.</div>
        }
        else
        {
            <div class="interfaces-mobile-list">
                @foreach (var group in groups)
                {
                    @if (group.ShowHeader)
                    {
                        <div class="interfaces-mobile-group">@group.Label</div>
                    }

                    @foreach (var item in group.Items)
                    {
                        <article class="@GetMobileCardClass(item)"
                                 @onclick="() => _selectedId = item.IdComprobanteRecibido">
                            <div class="interfaces-mobile-card__head">
                                <label class="interfaces-mobile-card__check" @onclick:stopPropagation="true">
                                    <input type="checkbox"
                                           class="interfaces-table__checkbox"
                                           checked="@_selectedIds.Contains(item.IdComprobanteRecibido)"
                                           @onchange="args => ToggleRowSelection(item.IdComprobanteRecibido, args)" />
                                    <span></span>
                                </label>
                                <div class="interfaces-mobile-card__identity">
                                    <strong>#@item.IdComprobanteRecibido</strong>
                                    <span>@item.TipoDocumentoDescripcion</span>
                                </div>
                                <span class="interfaces-status-pill @GetStateCssClass(item.EstadoCodigo, item.EstadoDescripcion)">@item.EstadoDescripcion</span>
                            </div>

                            <p class="interfaces-mobile-card__summary">@GetSummary(item.Observacion)</p>

                            <div class="interfaces-mobile-card__meta">
                                <span><i class="bi bi-clock"></i> @item.FechaHoraGrabacion.ToString("dd/MM/yyyy HH:mm")</span>
                                <span><i class="bi bi-person"></i> @(string.IsNullOrWhiteSpace(item.UsuarioAlta) ? "—" : item.UsuarioAlta)</span>
                                <span><i class="bi bi-paperclip"></i> @item.CantidadAdjuntos adj.</span>
                                <span><i class="bi bi-activity"></i> @GetQueueProgressLabelForDocument(item.IdComprobanteRecibido)</span>
                                @if (IsCompraDocument(item))
                                {
                                    <span><i class="bi bi-building"></i> @GetDisplayValue(item.ProveedorNombre)</span>
                                    <span><i class="bi bi-cash-stack"></i> @FormatMoney(item.ImporteTotal)</span>
                                }
                            </div>

                            <div class="interfaces-mobile-card__actions" @onclick:stopPropagation="true">
                                @if (CanProcessNowInboxItem(item))
                                {
                                    <button type="button"
                                            class="btn btn--ghost btn--sm interfaces-table__edit"
                                            @onclick="() => ProcesarDocumentoAhoraAsync(item.IdComprobanteRecibido)">
                                        <i class="bi bi-play-circle"></i> Procesar ahora
                                    </button>
                                }
                                <button type="button"
                                        class="btn btn--ghost btn--sm"
                                        @onclick="() => VerDetalleLecturaAsync(item.IdComprobanteRecibido)">
                                    <i class="bi bi-card-list"></i> Detalle IA
                                </button>
                                @if (GetLatestQueueItemForDocument(item.IdComprobanteRecibido) is { } queueAction)
                                {
                                    @if (CanCancelQueueJob(queueAction))
                                    {
                                        <button type="button"
                                                class="btn btn--ghost btn--sm"
                                                @onclick="() => CancelarColaAsync(queueAction.Id)"
                                                disabled="@_loadingQueue">
                                            <i class="bi bi-stop-circle"></i> Cancelar
                                        </button>
                                    }
                                    @if (CanRetryQueueJob(queueAction))
                                    {
                                        <button type="button"
                                                class="btn btn--ghost btn--sm interfaces-table__edit"
                                                @onclick="() => ReintentarColaAsync(queueAction.Id)"
                                                disabled="@_loadingQueue">
                                            <i class="bi bi-arrow-repeat"></i> Reintentar
                                        </button>
                                    }
                                }
                                <button type="button"
                                        class="btn btn--ghost btn--sm"
                                        @onclick="() => AbrirFicha(item.IdComprobanteRecibido)">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </button>
                            </div>
                        </article>
                    }
                }
            </div>

            <div class="usuarios-table-wrap interfaces-docs-table-wrap">
                <table class="data-table usuarios-table">
                    <thead>
                        <tr>
                            <th class="interfaces-table__selector">
                                <input type="checkbox"
                                       class="interfaces-table__checkbox"
                                       checked="@AreAllCurrentPageSelected"
                                       @onchange="ToggleSelectAll"
                                       title="Seleccionar todos los documentos visibles" />
                            </th>
                            @foreach (var col in visibleColumns)
                            {
                                <th>@col.Label</th>
                            }
                            <th>Progreso</th>
                            <th class="interfaces-table__actions">Acciones</th>
                        </tr>
                    </thead>
                    @foreach (var group in groups)
                    {
                        <tbody>
                            @if (group.ShowHeader)
                            {
                                <tr class="usuarios-group-row">
                                    <td colspan="@GetGridColumnSpan(visibleColumns.Count)">@group.Label</td>
                                </tr>
                            }

                            @foreach (var item in group.Items)
                            {
                                <tr class="@(_selectedId == item.IdComprobanteRecibido ? "usuarios-table__row is-selected" : "usuarios-table__row")"
                                    @onclick="() => _selectedId = item.IdComprobanteRecibido"
                                    @ondblclick="() => AbrirFicha(item.IdComprobanteRecibido)">
                                    <td class="interfaces-table__selector" @onclick:stopPropagation="true">
                                        <input type="checkbox"
                                               class="interfaces-table__checkbox"
                                               checked="@_selectedIds.Contains(item.IdComprobanteRecibido)"
                                               @onchange="args => ToggleRowSelection(item.IdComprobanteRecibido, args)"
                                               title="Seleccionar documento" />
                                    </td>
                                    @foreach (var col in visibleColumns)
                                    {
                                        <td>
                                            @switch (col.Key)
                                            {
                                                case InterfacesViewColumnKeys.Numero:
                                                    <strong>#@item.IdComprobanteRecibido</strong>
                                                    break;
                                                case InterfacesViewColumnKeys.Fecha:
                                                    @item.FechaHoraGrabacion.ToString("dd/MM/yyyy HH:mm")
                                                    break;
                                                case InterfacesViewColumnKeys.Tipo:
                                                    @item.TipoDocumentoDescripcion
                                                    break;
                                                case InterfacesViewColumnKeys.Proveedor:
                                                    @(IsCompraDocument(item) ? GetDisplayValue(item.ProveedorNombre) : "—")
                                                    break;
                                                case InterfacesViewColumnKeys.Importe:
                                                    @(IsCompraDocument(item) ? FormatMoney(item.ImporteTotal) : "—")
                                                    break;
                                                case InterfacesViewColumnKeys.Estado:
                                                    <span class="interfaces-status-pill @GetStateCssClass(item.EstadoCodigo, item.EstadoDescripcion)">@item.EstadoDescripcion</span>
                                                    break;
                                                case InterfacesViewColumnKeys.Usuario:
                                                    @(string.IsNullOrWhiteSpace(item.UsuarioAlta) ? "—" : item.UsuarioAlta)
                                                    break;
                                                case InterfacesViewColumnKeys.Observacion:
                                                    @GetSummary(item.Observacion)
                                                    break;
                                                case InterfacesViewColumnKeys.Adjuntos:
                                                    @item.CantidadAdjuntos
                                                    break;
                                            }
                                        </td>
                                    }
                                    <td>
                                        @{
                                            var queue = GetLatestQueueItemForDocument(item.IdComprobanteRecibido);
                                        }
                                        @if (queue is null)
                                        {
                                            <span class="interfaces-status-pill interfaces-status-pill--info">Sin procesamiento</span>
                                        }
                                        else
                                        {
                                            <div class="interfaces-queue-progress">
                                                <div class="interfaces-queue-progress__track">
                                                    <div class="interfaces-queue-progress__fill @GetQueueProgressCssClass(queue)"
                                                         style="width:@(GetQueueProgressPercent(queue))%">
                                                    </div>
                                                </div>
                                                <span class="interfaces-queue-progress__label">@GetQueueProgressLabel(queue)</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="interfaces-table__actions interfaces-table__actions--menu" @onclick:stopPropagation="true">
                                        <button type="button"
                                                class="btn btn--ghost btn--sm"
                                                title="Acciones del documento"
                                                @onclick="() => ToggleRowActions(item.IdComprobanteRecibido)">
                                            <i class="bi bi-three-dots"></i>
                                            <span>Acciones</span>
                                        </button>
                                        @if (_openRowActionsId == item.IdComprobanteRecibido)
                                        {
                                            <div class="interfaces-row-actions-menu">
                                                @if (CanProcessNowInboxItem(item))
                                                {
                                                    <button type="button"
                                                            class="btn btn--ghost btn--sm interfaces-table__edit"
                                                            title="Ejecutar ahora la lectura automática"
                                                            @onclick="() => ProcesarDocumentoAhoraAsync(item.IdComprobanteRecibido)">
                                                        <i class="bi bi-play-circle"></i>
                                                        <span>Procesar ahora</span>
                                                    </button>
                                                }
                                                <button type="button"
                                                        class="btn btn--ghost btn--sm"
                                                        title="Ver detalle de lectura automática"
                                                        @onclick="() => VerDetalleLecturaAsync(item.IdComprobanteRecibido)">
                                                    <i class="bi bi-card-list"></i>
                                                    <span>Detalle IA</span>
                                                </button>
                                                @if (GetLatestQueueItemForDocument(item.IdComprobanteRecibido) is { } queueAction)
                                                {
                                                    @if (CanCancelQueueJob(queueAction))
                                                    {
                                                        <button type="button"
                                                                class="btn btn--ghost btn--sm"
                                                                @onclick="() => CancelarColaAsync(queueAction.Id)"
                                                                disabled="@_loadingQueue">
                                                            <i class="bi bi-stop-circle"></i>
                                                            <span>@(queueAction.Estado == "PROCESANDO_LECTURA" ? "Cancelar" : "Quitar cola")</span>
                                                        </button>
                                                    }
                                                    @if (CanRetryQueueJob(queueAction))
                                                    {
                                                        <button type="button"
                                                                class="btn btn--ghost btn--sm interfaces-table__edit"
                                                                @onclick="() => ReintentarColaAsync(queueAction.Id)"
                                                                disabled="@_loadingQueue">
                                                            <i class="bi bi-arrow-repeat"></i>
                                                            <span>Reintentar</span>
                                                        </button>
                                                    }
                                                }
                                                <button type="button"
                                                        class="btn btn--ghost btn--sm interfaces-table__edit"
                                                        title="Editar documento"
                                                        @onclick="() => AbrirFicha(item.IdComprobanteRecibido)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Editar</span>
                                                </button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>

            <div class="result-pagination">
                <span class="result-pagination__info">@_pagedTotal registro(s)</span>
                <div class="result-pagination__controls">
                    <button class="result-pagination__btn" title="Página anterior"
                            @onclick="() => CambiarPaginaAsync(_pageNumber - 1)"
                            disabled="@(!_hasPrev || _loadingList)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="result-pagination__btn result-pagination__btn--active">@_pageNumber / @_totalPages</span>
                    <button class="result-pagination__btn" title="Página siguiente"
                            @onclick="() => CambiarPaginaAsync(_pageNumber + 1)"
                            disabled="@(!_hasNext || _loadingList)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <select class="result-pagination__size" title="Registros por página"
                        value="@_filters.PageSize"
                        @onchange="OnPageSizeChangedAsync"
                        disabled="@_loadingList">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        }
    </section>

    @if (_showDetalleLecturaModal)
    {
        <div class="modal-overlay interfaces-detail-modal-overlay" @onclick="CerrarDetalleLectura">
            <section class="modal-card interfaces-detail-modal" @onclick:stopPropagation="true">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Factura detectada por IA</h3>
                        <p class="panel-card__subtitle">
                            @if (_loadingDetalleLectura)
                            {
                                <span>Cargando detalle del documento...</span>
                            }
                            else if (_detalleLecturaDocumentoId.HasValue)
                            {
                                <span>Documento #@_detalleLecturaDocumentoId.Value · vista comercial del comprobante.</span>
                            }
                        </p>
                    </div>
                    <div class="actions">
                        @if (_detalleLecturaDocumentoId.HasValue)
                        {
                            <button type="button" class="btn btn--ghost" @onclick="() => AbrirFicha(_detalleLecturaDocumentoId.Value)">
                                <i class="bi bi-pencil-square"></i> Abrir ficha
                            </button>
                        }
                        <button type="button" class="btn btn--ghost" @onclick="CerrarDetalleLectura">
                            <i class="bi bi-x-circle"></i> Cerrar
                        </button>
                    </div>
                </div>

                @if (_loadingDetalleLectura)
                {
                    <div class="usuarios-empty">Cargando detalle leído...</div>
                }
                else if (_detalleLectura is not null)
                {
                    <article class="interfaces-invoice">
                        <header class="interfaces-invoice__header">
                            <div>
                                <h4>Comprobante @BuildComprobanteLecturaLabel(_detalleLectura)</h4>
                                <p>@GetDisplayValue(_detalleLectura.TipoComprobante) · Estado: @_detalleLectura.Estado</p>
                            </div>
                            <div class="interfaces-invoice__total">
                                <span>Total</span>
                                <strong>@FormatMoney(_detalleLectura.Total)</strong>
                            </div>
                        </header>

                        <section class="interfaces-invoice__grid">
                            <div class="context-card"><span class="context-card__label">Proveedor</span><strong>@GetDisplayValue(_detalleLectura.ProveedorNombre)</strong></div>
                            <div class="context-card"><span class="context-card__label">CUIT</span><strong>@GetDisplayValue(_detalleLectura.ProveedorCuit)</strong></div>
                            <div class="context-card"><span class="context-card__label">Cuenta</span><strong>@GetDisplayValue(_detalleLectura.CuentaContable)</strong></div>
                            <div class="context-card"><span class="context-card__label">Fecha</span><strong>@(_detalleLectura.Fecha?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                            <div class="context-card"><span class="context-card__label">Vencimiento</span><strong>@(_detalleLectura.Vencimiento?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                            <div class="context-card"><span class="context-card__label">Moneda</span><strong>@GetDisplayValue(_detalleLectura.Moneda)</strong></div>
                        </section>

                        <section class="interfaces-invoice__totals">
                            <div><span>Neto gravado</span><strong>@FormatMoney(_detalleLectura.NetoGravado)</strong></div>
                            <div><span>Neto no gravado</span><strong>@FormatMoney(_detalleLectura.NetoNoGravado)</strong></div>
                            <div><span>Exento</span><strong>@FormatMoney(_detalleLectura.Exento)</strong></div>
                            <div><span>IVA 21</span><strong>@FormatMoney(_detalleLectura.Iva21)</strong></div>
                            <div><span>IVA 10.5</span><strong>@FormatMoney(_detalleLectura.Iva105)</strong></div>
                            <div><span>IVA 27</span><strong>@FormatMoney(_detalleLectura.Iva27)</strong></div>
                            <div><span>Perc. IVA</span><strong>@FormatMoney(_detalleLectura.PercepcionIva)</strong></div>
                            <div><span>Perc. IIBB</span><strong>@FormatMoney(_detalleLectura.PercepcionIibb)</strong></div>
                            <div><span>Perc. Ganancias</span><strong>@FormatMoney(_detalleLectura.PercepcionGanancias)</strong></div>
                            <div><span>Imp. internos</span><strong>@FormatMoney(_detalleLectura.ImpuestosInternos)</strong></div>
                            <div><span>Otros</span><strong>@FormatMoney(_detalleLectura.OtrosImpuestos)</strong></div>
                        </section>

                        @if (_detalleLectura.Items.Count > 0)
                        {
                            <div class="usuarios-table-wrap interfaces-docs-table-wrap" data-sticky-x-scroll="off">
                                <table class="data-table usuarios-table">
                                    <thead>
                                        <tr>
                                            <th>Renglón</th>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th>Cantidad</th>
                                            <th>U.D.</th>
                                            <th>Imp. neto</th>
                                            <th>IVA</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _detalleLectura.Items)
