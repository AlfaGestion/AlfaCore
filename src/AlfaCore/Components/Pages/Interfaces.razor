        var result = await UiOps.RunAsync(async () =>
        {
            await InterfacesSvc.ProcessCompraDetectionNowAsync(new InterfacesCompraIaAccionRequest
            {
                Id = id,
                UsuarioAccion = AppUserSession.GetCurrentUserName(Environment.UserName),
                PcAccion = Environment.MachineName
            });
            return true;
        }, "No se pudo ejecutar ahora la lectura automática seleccionada.");

        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }

        SetFeedback(AppUiMessage.Success("Procesamiento ejecutado", "La lectura automática seleccionada se ejecutó de forma inmediata."));
        await CargarColaAsync();
        await BuscarAsync();
    }

    private async Task EnsureViewSettingsLoadedAsync(bool force = false)
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (!force && _viewSettingsLoaded && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            ApplyViewSettings(BuildDefaultViewSettings(), string.Empty);
            return;
        }

        var result = await UiOps.RunAsync(() => InterfacesSvc.GetViewSettingsAsync(currentUser), "No se pudo cargar la configuración de vista.");
        if (!result.Success || result.Value is null)
        {
            ApplyViewSettings(BuildDefaultViewSettings(), currentUser);
            return;
        }

        ApplyViewSettings(result.Value, currentUser);
    }

    private void ApplyViewSettings(InterfacesViewSettingsDto settings, string userName)
    {
        _viewSettings = settings;
        _viewSettingsUserName = userName;
        _viewSettingsLoaded = true;
        _draftAgruparPor = settings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(settings.Columnas));
    }

    private void AbrirConfiguracionVista()
    {
        _showViewSettings = true;
        _draftAgruparPor = _viewSettings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
    }

    private void CancelarConfiguracionVista()
    {
        _showViewSettings = false;
    }

    private void ToggleViewColumn(string key, ChangeEventArgs args)
    {
        var column = _viewSettingsDraft.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null) return;
        column.Visible = args.Value is bool flag && flag;
        if (!_viewSettingsDraft.Any(c => c.Visible))
            column.Visible = true;
    }

    private void MoveViewColumn(string key, int offset)
    {
        var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        var target = index + offset;
        if (target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(ordered);
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Sesión requerida", Message = "Necesitás iniciar sesión para guardar la configuración de vista." });
            return;
        }

        var settings = new InterfacesViewSettingsDto { AgruparPor = _draftAgruparPor, Columnas = CloneColumns(_viewSettingsDraft) };
        var result = await UiOps.RunAsync(async () => { await InterfacesSvc.SaveViewSettingsAsync(currentUser, settings); return true; }, "No se pudo guardar la configuración de vista.");
        if (!result.Success) { SetFeedback(result.Feedback); return; }

        ApplyViewSettings(settings, currentUser);
        _showViewSettings = false;
        SetFeedback(AppUiMessage.Success("Vista guardada", "La configuración de la grilla quedó actualizada para tu usuario."));
    }

    private IReadOnlyList<InterfacesViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private static int GetGridColumnSpan(int visibleColumnsCount) => visibleColumnsCount + 3;

    private IReadOnlyList<InterfacesGridGroup> BuildGridGroups()
    {
        if (_viewSettings.AgruparPor == InterfacesViewGroupKeys.None)
            return [new InterfacesGridGroup { Label = string.Empty, ShowHeader = false, Items = _items.ToList() }];

        return _items
            .GroupBy(item => ResolveGroupValue(item, _viewSettings.AgruparPor))
            .OrderBy(group => group.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(group => new InterfacesGridGroup { Label = group.Key, ShowHeader = true, Items = group.ToList() })
            .ToList();
    }

    private static string ResolveGroupValue(InterfacesInboxItemDto item, string grouping)
        => grouping switch
        {
            InterfacesViewGroupKeys.Estado => item.EstadoDescripcion,
            InterfacesViewGroupKeys.Tipo => item.TipoDocumentoDescripcion,
            _ => string.Empty
        };

    private static string GetGroupingLabel(string grouping)
        => grouping switch
        {
            InterfacesViewGroupKeys.Estado => "Estado",
            InterfacesViewGroupKeys.Tipo => "Tipo",
            _ => "Sin agrupar"
        };

    private static InterfacesViewSettingsDto BuildDefaultViewSettings()
        => new()
        {
            AgruparPor = InterfacesViewGroupKeys.None,
            Columnas =
            [
                new() { Key = InterfacesViewColumnKeys.Numero, Label = "Número", Visible = true, Order = 0 },
                new() { Key = InterfacesViewColumnKeys.Fecha, Label = "Fecha", Visible = true, Order = 1 },
                new() { Key = InterfacesViewColumnKeys.Tipo, Label = "Tipo", Visible = true, Order = 2 },
                new() { Key = InterfacesViewColumnKeys.Proveedor, Label = "Proveedor", Visible = true, Order = 3 },
                new() { Key = InterfacesViewColumnKeys.Importe, Label = "Importe", Visible = true, Order = 4 },
                new() { Key = InterfacesViewColumnKeys.Estado, Label = "Estado", Visible = true, Order = 5 },
                new() { Key = InterfacesViewColumnKeys.Usuario, Label = "Usuario", Visible = true, Order = 6 },
                new() { Key = InterfacesViewColumnKeys.Observacion, Label = "Observación", Visible = true, Order = 7 },
                new() { Key = InterfacesViewColumnKeys.Adjuntos, Label = "Adjuntos", Visible = true, Order = 8 }
            ]
        };

    private static List<InterfacesViewColumnDto> CloneColumns(IEnumerable<InterfacesViewColumnDto> columns)
        => columns.OrderBy(c => c.Order)
                  .Select(c => new InterfacesViewColumnDto { Key = c.Key, Label = c.Label, Visible = c.Visible, Order = c.Order })
                  .ToList();

    private static string GetSummary(string value)
    {
        var normalized = string.IsNullOrWhiteSpace(value) ? "Sin observación." : value.Trim().Replace(Environment.NewLine, " ").Replace('\n', ' ');
        return normalized.Length > 100 ? normalized[..97] + "..." : normalized;
    }

    private static bool IsCompraDocument(InterfacesInboxItemDto item)
        => string.Equals(item.TipoDocumentoCodigo, "COMPROBANTE_COMPRA", StringComparison.OrdinalIgnoreCase);

    private static string GetDisplayValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string BuildComprobanteLecturaLabel(InterfacesCompraIaResultadoDto lectura)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(lectura.TipoComprobante))
            parts.Add(lectura.TipoComprobante.Trim());
        if (!string.IsNullOrWhiteSpace(lectura.Letra))
            parts.Add(lectura.Letra.Trim());

        var puntoNumero = string.Join("-",
            new[] { lectura.PuntoVenta?.Trim(), lectura.Numero?.Trim() }
                .Where(static x => !string.IsNullOrWhiteSpace(x)));
        if (!string.IsNullOrWhiteSpace(puntoNumero))
            parts.Add(puntoNumero);

        return parts.Count == 0 ? "—" : string.Join(" ", parts);
    }

    private static string FormatMoney(decimal? value)
        => value.HasValue
            ? value.Value.ToString("N2")
            : "—";

    private static string FormatPercent(double? value)
        => value.HasValue
            ? value.Value.ToString("N2") + " %"
            : "—";

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--ok",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            _ => "editor-msg--error"
        };

    private string GetWorkerFeedbackClass()
    {
        var workerState = _queueSnapshot.Worker.Estado;
        if (string.Equals(workerState, "SIN_ACTIVIDAD", StringComparison.OrdinalIgnoreCase) && _queueSnapshot.Pendientes > 0)
            return "editor-msg editor-msg--error";

        return workerState switch
        {
            "PROCESANDO" => "editor-msg editor-msg--ok",
            "ESPERANDO" => "editor-msg editor-msg--ok",
            "ERROR_RECIENTE" => "editor-msg editor-msg--error",
            "DESHABILITADO" => "editor-msg editor-msg--warning",
            "SIN_ACTIVIDAD" => "editor-msg editor-msg--warning",
            _ => "editor-msg editor-msg--warning"
        };
    }

    private string GetWorkerTitle()
    {
        if (string.Equals(_queueSnapshot.Worker.Estado, "SIN_ACTIVIDAD", StringComparison.OrdinalIgnoreCase) && _queueSnapshot.Pendientes > 0)
            return "Worker sin actividad con pendientes en cola";

        return string.IsNullOrWhiteSpace(_queueSnapshot.Worker.Descripcion)
            ? "Estado del worker"
            : _queueSnapshot.Worker.Descripcion;
    }

    private string GetWorkerMessage()
    {
        var worker = _queueSnapshot.Worker;
        var parts = new List<string>();

        if (worker.UltimaEjecucion.HasValue)
            parts.Add($"Ultima ejecución: {worker.UltimaEjecucion.Value:dd/MM/yyyy HH:mm:ss}");

        if (worker.ProximoIntento.HasValue)
            parts.Add($"Próximo intento: {worker.ProximoIntento.Value:dd/MM/yyyy HH:mm:ss}");

        if (worker.UltimosProcesados > 0)
            parts.Add($"Procesados en el último ciclo: {worker.UltimosProcesados}");

        if (!string.IsNullOrWhiteSpace(worker.UltimoMensaje))
            parts.Add(worker.UltimoMensaje.Trim());

        if (string.Equals(worker.Estado, "SIN_ACTIVIDAD", StringComparison.OrdinalIgnoreCase) && _queueSnapshot.Pendientes > 0)
            parts.Insert(0, $"Hay {_queueSnapshot.Pendientes} documento(s) pendiente(s) y el worker no está mostrando actividad reciente.");

        return parts.Count == 0
            ? "Todavía no hay señales del worker de lectura automática."
            : string.Join(" · ", parts);
    }

    private static string GetStateCssClass(string estadoCodigo, string estadoDescripcion)
    {
        var key = $"{estadoCodigo} {estadoDescripcion}".ToUpperInvariant();
        if (key.Contains("ANUL"))
            return "interfaces-status-pill--danger";
        if (key.Contains("PEND") || key.Contains("PROCES"))
            return "interfaces-status-pill--warning";
        if (key.Contains("FINAL") || key.Contains("CERR") || key.Contains("APROB"))
            return "interfaces-status-pill--success";
        return "interfaces-status-pill--info";
    }

    private static bool CanCancelQueueJob(InterfacesCompraIaResultadoDto job)
        => job.Estado is "PENDIENTE_LECTURA" or "PROCESANDO_LECTURA";

    private static bool CanProcessNowQueueJob(InterfacesCompraIaResultadoDto job)
        => job.Estado is "PENDIENTE_LECTURA";

    private static bool CanProcessNowInboxItem(InterfacesInboxItemDto item)
        => IsCompraDocument(item);

    private static bool CanRetryQueueJob(InterfacesCompraIaResultadoDto job)
        => job.Estado is "ERROR_LECTURA" or "CANCELADO" or "SIN_PROVEEDOR";

    private static string FormatQueueDate(DateTime value)
        => value.ToString("dd/MM/yyyy HH:mm");

    private static string FormatQueueDuration(InterfacesCompraIaResultadoDto job)
    {
        var start = job.FechaHoraInicio ?? job.FechaHoraProceso;
        var end = job.FechaHoraFin ?? (job.Estado == "PROCESANDO_LECTURA" ? DateTime.Now : (DateTime?)null);
        if (!end.HasValue)
            return "—";

        var span = end.Value - start;
        if (span.TotalSeconds < 60)
            return $"{Math.Max(1, (int)span.TotalSeconds)} s";
        if (span.TotalMinutes < 60)
            return $"{(int)span.TotalMinutes} min";

        return $"{(int)span.TotalHours} h {(span.Minutes)} min";
    }

    private static string GetQueueDetail(InterfacesCompraIaResultadoDto job)
    {
        if (!string.IsNullOrWhiteSpace(job.LectorError))
            return job.LectorError;
        if (!string.IsNullOrWhiteSpace(job.ObservacionesRevision))
            return job.ObservacionesRevision;
        if (!string.IsNullOrWhiteSpace(job.LectorObservaciones))
            return job.LectorObservaciones;
        return "—";
    }

    private static int GetQueueProgressPercent(InterfacesCompraIaResultadoDto job)
    {
        if (job.Estado == "PROCESADO" || job.Estado == "SIN_PROVEEDOR")
            return 100;

        if (job.Estado is "ERROR_LECTURA" or "CANCELADO")
            return 100;

        if (job.Estado == "PENDIENTE_LECTURA")
            return 12;

        if (job.Estado == "PROCESANDO_LECTURA")
        {
            var start = job.FechaHoraInicio ?? job.FechaHoraProceso;
            var elapsed = Math.Max(0, (DateTime.Now - start).TotalSeconds);
            var computed = 25 + (int)Math.Min(65, elapsed / 2d);
            return Math.Clamp(computed, 25, 90);
        }

        return 0;
    }

    private static string GetQueueProgressCssClass(InterfacesCompraIaResultadoDto job)
        => job.Estado switch
        {
            "PROCESADO" => "interfaces-queue-progress__fill--success",
            "SIN_PROVEEDOR" => "interfaces-queue-progress__fill--info",
            "ERROR_LECTURA" => "interfaces-queue-progress__fill--danger",
            "CANCELADO" => "interfaces-queue-progress__fill--muted",
            "PROCESANDO_LECTURA" => "interfaces-queue-progress__fill--active",
            _ => "interfaces-queue-progress__fill--pending"
        };

    private static string GetQueueProgressLabel(InterfacesCompraIaResultadoDto job)
        => job.Estado switch
        {
            "PENDIENTE_LECTURA" => "En cola",
            "PROCESANDO_LECTURA" => "Procesando",
            "PROCESADO" => "Completado",
            "SIN_PROVEEDOR" => "Completado sin proveedor",
            "ERROR_LECTURA" => "Error de lectura",
            "CANCELADO" => "Cancelado",
            _ => "Sin estado"
        };

    private InterfacesCompraIaResultadoDto? GetLatestQueueItemForDocument(long idComprobanteRecibido)
        => _queueSnapshot.Items
            .Where(x => x.IdComprobanteRecibido == idComprobanteRecibido)
            .OrderByDescending(x => x.FechaHoraModificacion ?? x.FechaHoraFin ?? x.FechaHoraInicio ?? x.FechaHoraProceso)
            .FirstOrDefault();

    private string GetQueueProgressLabelForDocument(long idComprobanteRecibido)
    {
        var job = GetLatestQueueItemForDocument(idComprobanteRecibido);
        return job is null ? "Sin procesamiento" : GetQueueProgressLabel(job);
    }

