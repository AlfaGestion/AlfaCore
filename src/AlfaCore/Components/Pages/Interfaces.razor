    private async Task ProcesarDocumentoAhoraAsync(long idComprobanteRecibido)
    {
        var result = await UiOps.RunAsync(async () =>
        {
            var queued = await InterfacesSvc.QueueCompraDetectionAsync(new InterfacesDetectarCompraRequest
            {
