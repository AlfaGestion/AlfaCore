    private async Task MpCobrarAsync()
    {
        if (_mpImportePrueba <= 0)
        {
            _mpMensajeDiagnostico = "El importe debe ser mayor a cero.";
            _mpMensajeEsError = true;
            return;
        }

        _mpCobrando = true;
        _mpMensajeDiagnostico = string.Empty;
        _mpUltimoResultado = null;
        _mpEstadoCobro = "Creando orden...";
        var externalReference = "DIAG-" + Guid.NewGuid().ToString("N")[..12];

        try
        {
            _mpUltimoResultado = await MpPaymentSvc.CobrarAsync(_mpImportePrueba, externalReference, status =>
            {
                _mpEstadoCobro = status;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            _mpMensajeDiagnostico = ex.Message;
            _mpMensajeEsError = true;
        }
        finally
        {
            _mpCobrando = false;
        }
    }

    private void MpCancelar() => MpPaymentSvc.SolicitarCancelacion();
