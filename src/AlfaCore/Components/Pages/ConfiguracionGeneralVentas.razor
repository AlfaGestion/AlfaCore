@page "/configuracion-general/ventas"
@page "/{idweb}/{idbase:int}/configuracion-general/ventas"
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Forms
@using AlfaCore.Services.MercadoPagoPoint.Models
@inject AlfaCore.Services.IConfiguracionGeneralService ConfigSvc
@inject AlfaCore.Services.IArcaConfigService ArcaSvc
@inject AlfaCore.Services.IMercadoPagoPointConfigService MpConfigSvc
@inject AlfaCore.Services.MercadoPagoPoint.ITerminalsService MpTerminalsSvc
@inject AlfaCore.Services.MercadoPagoPoint.IPosService MpPosSvc
@inject AlfaCore.Services.IMercadoPagoPointPosService MpPaymentSvc
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Ventas | Alfa Gestión</PageTitle>

<div class="page-grid cfgventas-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <nav class="cfgventas-tabs" role="tablist" aria-label="Configuración de ventas">
        <button type="button" role="tab" class="cfgventas-tab @(_subtab == SubtabPortal ? "is-active" : string.Empty)" aria-selected="@(_subtab == SubtabPortal)" @onclick="() => SeleccionarSubtab(SubtabPortal)">
            <i class="bi bi-person-vcard"></i>
            <span>Portal del Cliente</span>
        </button>
        <button type="button" role="tab" class="cfgventas-tab @(_subtab == SubtabPuntoVenta ? "is-active" : string.Empty)" aria-selected="@(_subtab == SubtabPuntoVenta)" @onclick="() => SeleccionarSubtab(SubtabPuntoVenta)">
            <i class="bi bi-shop"></i>
            <span>Punto de Venta</span>
        </button>
        <button type="button" role="tab" class="cfgventas-tab @(_subtab == SubtabFactura ? "is-active" : string.Empty)" aria-selected="@(_subtab == SubtabFactura)" @onclick="() => SeleccionarSubtab(SubtabFactura)">
            <i class="bi bi-file-earmark-check"></i>
            <span>Facturación electrónica</span>
        </button>
        <button type="button" role="tab" class="cfgventas-tab @(_subtab == SubtabPadron ? "is-active" : string.Empty)" aria-selected="@(_subtab == SubtabPadron)" @onclick="() => SeleccionarSubtab(SubtabPadron)">
            <i class="bi bi-person-vcard-fill"></i>
            <span>Padrón ARCA</span>
        </button>
        <button type="button" role="tab" class="cfgventas-tab @(_subtab == SubtabMercadoPago ? "is-active" : string.Empty)" aria-selected="@(_subtab == SubtabMercadoPago)" @onclick="() => SeleccionarSubtab(SubtabMercadoPago)">
            <i class="bi bi-credit-card"></i>
            <span>Mercado Pago Point</span>
        </button>
    </nav>

    @if (_subtab == SubtabPortal)
    {
    <section class="panel-card">
        <h3 class="panel-card__title">Portal del Cliente</h3>
        <p class="panel-card__subtitle">
            Elegí qué secciones puede ver el cliente en su Portal. <strong>Inicio</strong> y <strong>Mi cuenta</strong>
            siempre están disponibles; el resto se puede ocultar.
        </p>

        <div class="cfgventas-checks">
            <AlfaCheckbox Value="@_portal.CuentaCorriente" ValueChanged="v => _portal.CuentaCorriente = v == true">
                <i class="bi bi-cash-stack"></i> Cuenta corriente
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.ListaPrecios" ValueChanged="v => _portal.ListaPrecios = v == true">
                <i class="bi bi-tags"></i> Lista de precios
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.Catalogos" ValueChanged="v => _portal.Catalogos = v == true">
                <i class="bi bi-book"></i> Catálogos
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.Carrito" ValueChanged="v => _portal.Carrito = v == true">
                <i class="bi bi-cart3"></i> Carrito de compra
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.Pedidos" ValueChanged="v => _portal.Pedidos = v == true">
                <i class="bi bi-receipt"></i> Pedidos
            </AlfaCheckbox>
        </div>
    </section>
    }

    @if (_subtab == SubtabPuntoVenta)
    {
    <section class="panel-card">
        <h3 class="panel-card__title">Punto de Venta</h3>
        <p class="panel-card__subtitle">
            Toda la configuración operativa que utiliza el Punto de Venta. Los valores se guardan en
            <code>TA_CONFIGURACION</code> de la base activa.
        </p>

        <h4 class="cfgarca-subtitle">Operación y comprobantes</h4>
        <div class="cfgarca-row cfgarca-row--general">
            <label class="cfgarca-field">
                Clase de precio por defecto
                <select class="cfgarca-select" @bind="_posSettings.ClasePrecioDefault">
                    @for (var clase = 1; clase <= 8; clase++)
                    {
                        <option value="@clase.ToString()">@clase</option>
                    }
                </select>
            </label>
            <label class="cfgarca-field">
                Cuenta consumidor final
                <input class="cfgarca-input" @bind="_posSettings.CuentaConsumidorFinal" placeholder="112010001" />
            </label>
        </div>

        <div class="cfgarca-row cfgarca-row--general">
            <label class="cfgarca-field">
                Comprobante habitual
                <select class="cfgarca-select" @bind="_posSettings.ComprobanteHabitual">
                    <option value="FC">FC · Factura</option>
                    <option value="NC">NC · Nota de crédito</option>
                    <option value="FP" disabled="@(!_posSettings.UsaProforma)">FP · Factura proforma</option>
                    <option value="NCFP" disabled="@(!_posSettings.UsaProforma)">NCFP · Nota de crédito proforma</option>
                </select>
            </label>
            <label class="cfgarca-field">
                Sucursal por defecto
                <input class="cfgarca-input" @bind="_posSettings.SucursalDefault" placeholder="0001" maxlength="4" />
            </label>
        </div>

        <div class="cfgarca-row cfgarca-row--general">
            <label class="cfgarca-field">
                Medio de pago contado por defecto
                @if (_mpMediosDePago.Count > 0)
                {
                    <select class="cfgarca-select" @bind="_posSettings.MedioDePagoContado">
                        <option value="">Automático: efectivo / caja</option>
                        @foreach (var medio in _mpMediosDePago)
                        {
                            <option value="@CodigoMedio(medio)">@medio.Descripcion (@CodigoMedio(medio))</option>
                        }
                    </select>
                }
                else
                {
                    <input class="cfgarca-input" @bind="_posSettings.MedioDePagoContado" placeholder="Código opcional del medio" />
                }
            </label>
            <label class="cfgarca-field">
                Cuenta caja por defecto
                <input class="cfgarca-input" @bind="_posSettings.CuentaCaja" placeholder="Código de cuenta" />
            </label>
        </div>

        <div class="cfgarca-row cfgarca-row--general">
            <label class="cfgarca-field">
                Cuenta de ventas por defecto
                @if (_cuentasVentas.Count > 0)
                {
                    <select class="cfgarca-select" @bind="_posSettings.CuentaVentasOtrosConceptos">
                        <option value="">Sin configurar</option>
                        @foreach (var cuenta in _cuentasVentas)
                        {
                            <option value="@cuenta.Codigo">@cuenta.Codigo · @cuenta.Descripcion</option>
                        }
                    </select>
                }
                else
                {
                    <input class="cfgarca-input" @bind="_posSettings.CuentaVentasOtrosConceptos" placeholder="Código de cuenta" />
                }
                <small class="cfgarca-hint">Configuración: <code>CUENTAVENTASDEFAULTINS</code>. La cuenta debe existir en <code>MA_CUENTAS</code>.</small>
            </label>
        </div>

        <div class="cfgarca-row cfgarca-row--general">
            <label class="cfgarca-field">
                Clave para cantidad negativa y cancelación
                <input class="cfgarca-input" type="password" @bind="_posSettings.ClaveCancelar"
                       placeholder="Dejar vacío para no pedir clave" autocomplete="new-password" />
                <small class="cfgarca-hint"><code>TPV_ClaveCancelar</code></small>
            </label>
        </div>

        <label class="mp-auto-payment-option">
            <input type="checkbox" @bind="_posSettings.UsaProforma" />
            <span>
                <strong><i class="bi bi-file-earmark-text"></i> Habilitar comprobantes proforma</strong>
                <small>Permite seleccionar FP y NCFP en el mostrador.</small>
            </span>
        </label>

        <label class="mp-auto-payment-option">
            <input type="checkbox" @bind="_posSettings.CobranzaPFSoloEfectivo" />
            <span>
                <strong><i class="bi bi-cash-stack"></i> Cobranzas de proforma solo en efectivo</strong>
                <small><code>CobranzaPFSoloEfectivo</code>: FP y NCFP no aceptan tarjetas, transferencias ni otros medios.</small>
            </span>
        </label>

        <label class="mp-auto-payment-option">
            <input type="checkbox" @bind="_posSettings.RecargoTarjetaSinIva" />
            <span>
                <strong><i class="bi bi-percent"></i> Recargo por tarjeta sin IVA</strong>
                <small><code>cfgRecargoTJTSinIVA</code>: informa el recargo completo como no gravado. Si está desactivado, el importe cobrado se interpreta con IVA incluido.</small>
            </span>
        </label>

        <h4 class="cfgarca-subtitle">Integraciones del Punto de Venta</h4>
        <div class="cfgarca-row cfgarca-row--general">
            <label class="cfgarca-field">
                Cuenta FTP heredada
                <input class="cfgarca-input" @bind="_posSettings.FtpCodigoCta" placeholder="Código de cuenta" />
            </label>
        </div>

    </section>
    }

    @if (_subtab == SubtabFactura)
    {
    <section class="panel-card">
        <h3 class="panel-card__title">Facturación electrónica (AFIP/ARCA)</h3>
        <p class="panel-card__subtitle">
            Configurá el CAE real para las facturas del Punto de Venta. Se puede facturar con un único
            CUIT general, o dejar que cada unidad de negocio facture con el suyo propio.
        </p>

        <div class="cfgventas-checks">
            <AlfaCheckbox Value="@_arca.UsaFacturacionElectronica" ValueChanged="v => _arca.UsaFacturacionElectronica = v == true">
                <i class="bi bi-file-earmark-check"></i> Habilitar facturación electrónica
            </AlfaCheckbox>
        </div>

        @if (_arca.UsaFacturacionElectronica)
        {
            <div class="cfgarca-row cfgarca-row--general">
                <label class="cfgarca-field">
                    Ambiente
                    <select class="cfgarca-select" @bind="_arca.Ambiente" @bind:after="ActualizarUrlsArcaSegunAmbiente">
                        <option value="HOMOLOGACION">Homologación (pruebas, sin validez fiscal)</option>
                        <option value="PRODUCCION">Producción</option>
                    </select>
                </label>
                <label class="cfgarca-field">
                    Si AFIP rechaza o no responde
                    <select class="cfgarca-select" @bind="_arca.ModoFalloCae">
                        <option value="ESTRICTO">Cortar la venta (recomendado)</option>
                        <option value="DEGRADADO">Completar igual, CAE pendiente</option>
                    </select>
                </label>
            </div>

            <div class="cfgarca-row cfgarca-row--general">
                <label class="cfgarca-field">
                    URL de WSAA (autenticación)
                    <input class="cfgarca-input" @bind="_arca.WsaaUrl" placeholder="Se completa según el ambiente" />
                    <small class="panel-card__subtitle">Usá la URL de configuración del sistema anterior; si queda vacío se usa la oficial del ambiente.</small>
                </label>
                <label class="cfgarca-field">
                    URL de WSFE (facturación)
                    <input class="cfgarca-input" @bind="_arca.WsfeUrl" placeholder="Se completa según el ambiente" />
                    <small class="panel-card__subtitle">Se admite la URL con o sin <code>?WSDL</code>.</small>
                </label>
            </div>

            <h4 class="cfgarca-subtitle">CUIT general (fallback)</h4>
            <p class="panel-card__subtitle">Se usa para las unidades de negocio que no tengan factura electrónica propia activada abajo.</p>
            <div class="cfgarca-row cfgarca-row--fallback">
                <label class="cfgarca-field">
                    CUIT
                    <input class="cfgarca-input" @bind="_arca.Cuit" maxlength="15" placeholder="Sin guiones" />
                </label>
                <label class="cfgarca-field">
                    Punto de venta
                    <input class="cfgarca-input" @bind="_arca.PuntoVenta" maxlength="4" />
                </label>
                <div class="cfgarca-field cfgarca-field--certificate">
                    Certificado (.crt)
                    <div class="cfgarca-cert">
                        <div class="cfgarca-cert-picker">
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertGlobal">
                                @(string.IsNullOrEmpty(_arca.NombreArchivoCrt) ? "Subir .crt" : "Reemplazar")
                            </AlfaButton>
                            <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClaveGlobal, esClave: false)" accept=".crt,.pem" disabled="@_subiendoCertGlobal" />
                        </div>
                        <span class="cfgarca-cert-estado">
                            @if (!string.IsNullOrEmpty(_arca.NombreArchivoCrt))
                            {
                                <span><i class="bi bi-shield-check"></i> @_arca.NombreArchivoCrt</span>
                            }
                            else
                            {
                                <span class="cfgarca-cert-vacio">Sin subir</span>
                            }
                        </span>
                    </div>
                </div>
                <div class="cfgarca-field cfgarca-field--certificate">
                    Clave privada (.key)
                    <div class="cfgarca-cert">
                        <div class="cfgarca-cert-picker">
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertGlobal">
                                @(string.IsNullOrEmpty(_arca.NombreArchivoKey) ? "Subir .key" : "Reemplazar")
                            </AlfaButton>
                            <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClaveGlobal, esClave: true)" accept=".key,.pem" disabled="@_subiendoCertGlobal" />
                        </div>
                        <span class="cfgarca-cert-estado">
                            @if (!string.IsNullOrEmpty(_arca.NombreArchivoKey))
                            {
                                <span><i class="bi bi-shield-check"></i> @_arca.NombreArchivoKey</span>
                            }
                            else
                            {
                                <span class="cfgarca-cert-vacio">Sin subir</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <h4 class="cfgarca-subtitle">Unidades de negocio con factura electrónica propia</h4>
            <p class="panel-card__subtitle">
                Detectadas en <code>V_TA_UnidadNegocio</code>. Activá la que corresponda y subí su
                certificado -- si no la activás, esa unidad factura con el CUIT general de arriba.
            </p>

            @if (_arca.Unidades.Count == 0)
            {
                <p class="cfgarca-sin-unidades">No hay unidades de negocio cargadas.</p>
            }
            else
            {
                <div class="cfgarca-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Razón social</th>
                                <th>Usa eFC</th>
                                <th>CUIT</th>
                                <th>PV</th>
                                <th>Certificado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unidad in _arca.Unidades)
                            {
                                <tr>
                                    <td>@unidad.Codigo</td>
                                    <td>@unidad.RazonSocialUnidad</td>
                                    <td>
                                        <AlfaCheckbox Value="@unidad.UsaFacturacionElectronica" ValueChanged="v => unidad.UsaFacturacionElectronica = v == true" />
                                    </td>
                                    <td><input class="cfgarca-input cfgarca-input--sm" @bind="unidad.Cuit" maxlength="15" /></td>
                                    <td><input class="cfgarca-input cfgarca-input--xs" @bind="unidad.PuntoVenta" maxlength="4" /></td>
                                    <td>
                                        <div class="cfgarca-cert">
                                            <div class="cfgarca-cert-picker" title="Certificado .crt">
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-filetype-key" Disabled="@(_subiendoCertUnidad == unidad.Codigo)">
                                                    .crt
                                                </AlfaButton>
                                                <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, unidad.Codigo, esClave: false)" accept=".crt,.pem" disabled="@(_subiendoCertUnidad == unidad.Codigo)" />
                                            </div>
                                            <div class="cfgarca-cert-picker" title="Clave privada .key">
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-filetype-key" Disabled="@(_subiendoCertUnidad == unidad.Codigo)">
                                                    .key
                                                </AlfaButton>
                                                <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, unidad.Codigo, esClave: true)" accept=".key,.pem" disabled="@(_subiendoCertUnidad == unidad.Codigo)" />
                                            </div>
                                            <span class="cfgarca-cert-estado">
                                                @if (unidad.TieneCertificado)
                                                {
                                                    <i class="bi bi-shield-check"></i>
                                                }
                                                else
                                                {
                                                    <span class="cfgarca-cert-vacio">Sin subir</span>
                                                }
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

    </section>
    }

    @if (_subtab == SubtabPadron)
    {
    <section class="panel-card">
        <h3 class="panel-card__title">Consulta de padrón ARCA (certificado independiente)</h3>
        <p class="panel-card__subtitle">
            Este certificado se usa solamente para consultar clientes/proveedores en ARCA y no reemplaza
            el certificado de facturación electrónica.
        </p>
        <div class="cfgarca-row cfgarca-row--fallback">
            <div class="cfgarca-field cfgarca-field--certificate">
                Certificado padrón (.crt)
                <div class="cfgarca-cert">
                    <div class="cfgarca-cert-picker">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertPadron">
                            @(string.IsNullOrEmpty(_arca.NombreArchivoCrtPadron) ? "Subir .crt" : "Reemplazar")
                        </AlfaButton>
                        <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClavePadron, esClave: false)" accept=".crt,.pem" disabled="@_subiendoCertPadron" />
                    </div>
                    <span class="cfgarca-cert-estado">
                        @(string.IsNullOrEmpty(_arca.NombreArchivoCrtPadron) ? "Sin subir" : _arca.NombreArchivoCrtPadron)
                    </span>
                </div>
            </div>
            <div class="cfgarca-field cfgarca-field--certificate">
                Clave padrón (.key)
                <div class="cfgarca-cert">
                    <div class="cfgarca-cert-picker">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertPadron">
                            @(string.IsNullOrEmpty(_arca.NombreArchivoKeyPadron) ? "Subir .key" : "Reemplazar")
                        </AlfaButton>
                        <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClavePadron, esClave: true)" accept=".key,.pem" disabled="@_subiendoCertPadron" />
                    </div>
                    <span class="cfgarca-cert-estado">
                        @(string.IsNullOrEmpty(_arca.NombreArchivoKeyPadron) ? "Sin subir" : _arca.NombreArchivoKeyPadron)
                    </span>
                </div>
            </div>
        </div>
    </section>
    }

    @if (_subtab == SubtabMercadoPago)
    {
    <section class="panel-card">
        <h3 class="panel-card__title">Mercado Pago Point (terminal física)</h3>
        <p class="panel-card__subtitle">
            Configurá el acceso a Mercado Pago, los medios que pueden iniciar un cobro Point y la
            asignación de lectores a cada punto de venta.
        </p>

        <nav class="mp-point-tabs" role="tablist" aria-label="Configuración de Mercado Pago Point">
            <button type="button" role="tab" class="mp-point-tab @(_mpPointTab == MpPointTabToken ? "is-active" : string.Empty)" aria-selected="@(_mpPointTab == MpPointTabToken)" @onclick="() => SeleccionarMpPointTab(MpPointTabToken)">
                <i class="bi bi-key"></i><span>Token</span>
            </button>
            <button type="button" role="tab" class="mp-point-tab @(_mpPointTab == MpPointTabMedios ? "is-active" : string.Empty)" aria-selected="@(_mpPointTab == MpPointTabMedios)" @onclick="() => SeleccionarMpPointTab(MpPointTabMedios)">
                <i class="bi bi-credit-card-2-front"></i><span>Medios de pago</span>
            </button>
            <button type="button" role="tab" class="mp-point-tab @(_mpPointTab == MpPointTabTerminales ? "is-active" : string.Empty)" aria-selected="@(_mpPointTab == MpPointTabTerminales)" @onclick="() => SeleccionarMpPointTab(MpPointTabTerminales)">
                <i class="bi bi-phone"></i><span>Terminales Point</span>
            </button>
        </nav>

    @if (_mpPointTab == MpPointTabToken)
        {
        <div class="mp-token-only">
            <label class="cfgarca-field">
                Access Token
                <input class="cfgarca-input" type="password" @bind="_mpAccessToken" placeholder="APP_USR-..." />
            </label>
        </div>

        <div class="mp-instruction-card">
            <div>
                <strong>¿Necesitás configurar Mercado Pago Point?</strong>
                <span>Consultá el instructivo completo de configuración y puesta en marcha.</span>
            </div>
            <a class="btn btn--ghost" href="https://www.alfagestion.com.ar/ag/configuracion-de-mercado-pago-point-smart/" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-book"></i> Ver instructivo
            </a>
        </div>
        }

        @if (_mpPointTab == MpPointTabMedios)
        {
        <h4 class="cfgarca-subtitle">Medios de pago habilitados para Point</h4>
        <p class="panel-card__subtitle">
            Marcá los medios que pueden iniciar un cobro en la terminal. Se usa el código opcional de
            cada medio, igual que en el sistema de escritorio.
        </p>

        @if (_mpMediosDePago.Count == 0)
        {
            <p class="cfgarca-sin-unidades">No se encontraron medios de pago habilitados en la base activa.</p>
        }
        else
        {
            <div class="mp-payment-methods">
                @foreach (var medio in _mpMediosDePago)
                {
                    var codigoMedio = CodigoMedio(medio);
                    <label class="mp-payment-method">
                        <input type="checkbox" checked="@_mpMediosHabilitados.Contains(codigoMedio)" @onchange="e => CambiarMedioHabilitado(codigoMedio, e)" />
                        <span>
                            <strong>@medio.Descripcion</strong>
                            <small>@codigoMedio · @medio.MedioDePago</small>
                        </span>
                    </label>
                }
            </div>
        }

        <label class="mp-auto-payment-option">
            <input type="checkbox" @bind="_mpObtenerMedioAutomatico" />
            <span>
                <strong><i class="bi bi-magic"></i> Obtener medio de pago automáticamente</strong>
                <small>Si está activo, Point informa el medio utilizado y se usa el medio configurado que coincida; si no existe, se conserva el seleccionado.</small>
            </span>
        </label>

        <label class="mp-auto-payment-option">
            <input type="checkbox" @bind="_mpModoPrueba" disabled="@string.Equals(_arca.Ambiente, "PRODUCCION", StringComparison.OrdinalIgnoreCase)" />
            <span>
                <strong><i class="bi bi-wrench-adjustable-circle"></i> Usar modo de prueba Point</strong>
                <small>Solo funciona con certificados ARCA en Homologación. Permite simular QR, débito y crédito con recargo por cuotas sin llamar a Mercado Pago.</small>
            </span>
        </label>
        @if (string.Equals(_arca.Ambiente, "PRODUCCION", StringComparison.OrdinalIgnoreCase))
        {
            <p class="cfgarca-hint">El modo de prueba está bloqueado porque el ambiente de ARCA es Producción.</p>
        }
        }

        @if (_mpPointTab == MpPointTabTerminales)
        {
        <h4 class="cfgarca-subtitle">Terminales Point por punto de venta</h4>
        <p class="panel-card__subtitle">Seleccioná un punto de venta y asociá uno o más lectores. La configuración se guarda por punto de venta.</p>
        <div class="mp-terminals-toolbar">
            <button type="button" class="btn btn--ghost" disabled="@_mpBusy" @onclick="MpListarTerminalesAsync">
                <i class="bi bi-arrow-clockwise"></i> Actualizar terminales
            </button>
        </div>

        @if (_mpPuntosVenta.Count == 0)
        {
            <p class="cfgarca-sin-unidades">No se encontraron puntos de venta activos en POS_PUNTOVENTA.</p>
        }
        else
        {
            <div class="mp-terminal-assignment">
                <div class="mp-terminal-pane">
                    <div class="mp-terminal-pane__title">Puntos de venta</div>
                    <div class="mp-terminal-list">
                        @foreach (var puntoVenta in _mpPuntosVenta)
                        {
                            <button type="button" class="mp-terminal-list__item @(_mpPuntoVentaSeleccionado == puntoVenta.Id ? "is-selected" : string.Empty)" @onclick="() => SeleccionarPuntoVentaTerminal(puntoVenta.Id)">
                                <span class="mp-terminal-list__code">@puntoVenta.Codigo</span>
                                <span>@puntoVenta.Descripcion</span>
                                <small>@puntoVenta.TerminalesAsignadas.Count lector(es)</small>
                            </button>
                        }
                    </div>
                    <div class="mp-terminal-selected-label">
                        @if (_mpPuntoVentaSeleccionado > 0)
                        {
                            var puntoSeleccionado = _mpPuntosVenta.FirstOrDefault(x => x.Id == _mpPuntoVentaSeleccionado);
                            <strong>Punto seleccionado: @puntoSeleccionado?.NombreVisible</strong>
                        }
                        else
                        {
                            <span>Seleccioná un punto de venta.</span>
                        }
                    </div>
                </div>

                <div class="mp-terminal-pane">
                    <div class="mp-terminal-pane__title">Terminales Point disponibles</div>
                    <div class="cfgarca-table-wrap">
                        @if (_mpTerminales.Count == 0)
                        {
                            <p class="cfgarca-sin-unidades">No hay terminales cargadas. Seleccioná un punto de venta y presioná “Actualizar terminales”.</p>
                        }
                        else
                        {
                            <table class="data-table mp-terminals-table">
                                <thead><tr><th>Asignada</th><th>ID</th><th>Modo</th><th>POS</th></tr></thead>
                                <tbody>
                                    @foreach (var t in _mpTerminales)
                                    {
                                        <tr class="@(string.Equals(_mpTerminalSeleccionada, t.Id, StringComparison.OrdinalIgnoreCase) ? "row--selected" : string.Empty)" @onclick="() => SeleccionarTerminal(t.Id)">
                                            <td>@(IsTerminalAsignada(t.Id) ? "Sí" : "")</td>
                                            <td><strong>@t.Id</strong></td>
                                            <td>@t.OperatingMode</td>
                                            <td>@t.Store</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="mp-terminal-actions">
                        <button type="button" class="btn btn--ghost" disabled="@(!PuedeModificarAsignacionTerminal())" @onclick="AsignarTerminalAlPuntoVenta">
                            Asignar al punto de venta
                        </button>
                        <button type="button" class="btn btn--ghost" disabled="@(!PuedeModificarAsignacionTerminal() || !IsTerminalAsignada(_mpTerminalSeleccionada))" @onclick="QuitarTerminalDelPuntoVenta">
                            Quitar del punto de venta
                        </button>
                    </div>
                </div>
            </div>
        }

        <h4 class="cfgarca-subtitle">Diagnóstico</h4>
        <p class="panel-card__subtitle">Probá la configuración ya guardada antes de usarla en una venta real.</p>
        <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn btn-outline-light" disabled="@_mpBusy" @onclick="MpListarPosAsync">Listar puntos de venta</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mpMensajeDiagnostico))
        {
            <div class="editor-msg @(_mpMensajeEsError ? "editor-msg--error" : "editor-msg--ok")">@_mpMensajeDiagnostico</div>
        }

        @if (_mpPos.Count > 0)
        {
            <div class="cfgarca-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Id</th><th>Nombre</th><th>Sucursal</th><th>Terminal</th></tr></thead>
                    <tbody>
                        @foreach (var p in _mpPos)
                        {
                            <tr><td>@p.Id</td><td>@p.Name</td><td>@p.Store</td><td>@p.TerminalId</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h4 class="cfgarca-subtitle">Cobro de prueba</h4>
        <div class="cfgarca-row cfgarca-row--fallback">
            <label class="cfgarca-field">
                Importe
                <input class="cfgarca-input" type="number" step="0.01" min="0.01" @bind="_mpImportePrueba" disabled="@_mpCobrando" />
            </label>
            <div class="cfgarca-field d-flex gap-2 align-items-end">
                <button type="button" class="btn btn-primary" disabled="@(_mpBusy || _mpCobrando)" @onclick="MpCobrarAsync">Cobrar</button>
                <button type="button" class="btn btn-outline-danger" disabled="@(!_mpCobrando)" @onclick="MpCancelar">Cancelar</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mpEstadoCobro))
        {
            <div class="shell-empty-state">
                <strong>Estado</strong>
                <span>@_mpEstadoCobro</span>
            </div>
        }

        @if (_mpUltimoResultado is not null)
        {
            <div class="shell-empty-state">
                <strong>@(_mpUltimoResultado.Approved ? "Aprobado" : "No aprobado")</strong>
                <span>Order: @_mpUltimoResultado.OrderId · Status: @_mpUltimoResultado.Status · Payment: @_mpUltimoResultado.PaymentId</span>
            </div>
        }
        }

        <div class="mp-point-navigation">
            <button type="button" class="btn btn--ghost" disabled="@(_mpPointTab == MpPointTabToken)" @onclick="MpPointAnterior">
                <i class="bi bi-chevron-left"></i> Anterior
            </button>
            <button type="button" class="btn btn--primary" disabled="@(_mpPointTab == MpPointTabTerminales)" @onclick="MpPointSiguiente">
                Siguiente <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </section>
    }

</div>

@code {
    private const string SubtabPortal = "portal";
    private const string SubtabPuntoVenta = "puntoventa";
    private const string SubtabFactura = "factura";
    private const string SubtabPadron = "padron";
    private const string SubtabMercadoPago = "mercadopago";
    private const string MpPointTabToken = "token";
    private const string MpPointTabMedios = "medios";
    private const string MpPointTabTerminales = "terminales";

    private string _subtab = SubtabPortal;
    private string _mpPointTab = MpPointTabToken;
    private const string ClaveGlobal = "GLOBAL";
    private const string ClavePadron = "PADRON";
    private const long TamanoMaximoCertificadoBytes = 512 * 1024;

    private ConfiguracionVentasPortalClienteDto _portal = new();
    private ArcaConfiguracionGeneralDto _arca = new();
    private PuntoVentaSettingsDto _posSettings = new();
    private IReadOnlyList<PuntoVentaCuentaImputacionDto> _cuentasVentas = [];
    private bool _saving;
    private bool _subiendoCertGlobal;
    private bool _subiendoCertPadron;
    private string? _subiendoCertUnidad;
    private AppUiMessage? _feedback;

    private string _mpAccessToken = string.Empty;
    private string _mpTerminalId = string.Empty;
    private string _mpPosExternalId = string.Empty;
    private string _mpWebhookSecret = string.Empty;
    private bool _mpObtenerMedioAutomatico;
    private bool _mpModoPrueba;
    private bool _mpMismoMedio = true;
    private string _mpMedioQr = string.Empty;
    private string _mpMedioTarjeta = string.Empty;
    private readonly HashSet<string> _mpMediosHabilitados = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<PuntoVentaPaymentMethodDto> _mpMediosDePago = [];
    private readonly List<MercadoPagoPointPuntoVentaDto> _mpPuntosVenta = [];
    private int _mpPuntoVentaSeleccionado;
    private string _mpTerminalSeleccionada = string.Empty;
    private bool _mpBusy;
    private bool _mpCobrando;
    private string _mpMensajeDiagnostico = string.Empty;
    private bool _mpMensajeEsError;
    private decimal _mpImportePrueba = 1m;
    private string _mpEstadoCobro = string.Empty;
    private string? _mpWebhookUrl;
    private PaymentResult? _mpUltimoResultado;
    private readonly List<TerminalInfo> _mpTerminales = [];
    private readonly List<PosInfo> _mpPos = [];

    private void SeleccionarSubtab(string subtab) => _subtab = subtab;
    private void SeleccionarMpPointTab(string tab)
    {
        if (!string.Equals(tab, MpPointTabToken, StringComparison.OrdinalIgnoreCase)
            && string.IsNullOrWhiteSpace(_mpAccessToken))
        {
            _mpPointTab = MpPointTabToken;
            _feedback = AppUiMessage.Info("Falta el Access Token", "Completá el Access Token de Mercado Pago antes de continuar.");
            return;
        }

        _mpPointTab = tab;
    }

    private void MpPointAnterior()
    {
        _mpPointTab = _mpPointTab switch
        {
            MpPointTabTerminales => MpPointTabMedios,
            MpPointTabMedios => MpPointTabToken,
            _ => MpPointTabToken
        };
    }

    private void MpPointSiguiente()
    {
        if (string.IsNullOrWhiteSpace(_mpAccessToken))
        {
            _mpPointTab = MpPointTabToken;
            _feedback = AppUiMessage.Info("Falta el Access Token", "Completá el Access Token de Mercado Pago antes de continuar.");
            return;
        }

        _mpPointTab = _mpPointTab switch
        {
            MpPointTabToken => MpPointTabMedios,
            MpPointTabMedios => MpPointTabTerminales,
            _ => MpPointTabTerminales
        };
    }

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose() => PageHeader.Clear();

    protected override async Task OnInitializedAsync()
    {
        var result = await UiOps.RunAsync(() => ConfigSvc.GetVentasPortalClienteAsync(), "No se pudo cargar la configuración del Portal Cliente.");
        if (result.Success && result.Value is not null)
            _portal = result.Value;
        else if (!result.Success)
            _feedback = result.Feedback;

        var arcaResult = await UiOps.RunAsync(() => ArcaSvc.GetConfiguracionGeneralAsync(), "No se pudo cargar la configuración de facturación electrónica.");
        if (arcaResult.Success && arcaResult.Value is not null)
            _arca = arcaResult.Value;
        else if (!arcaResult.Success)
            _feedback = arcaResult.Feedback;

        await CargarMercadoPagoAsync();
    }

    private async Task CargarMercadoPagoAsync()
    {
        try
        {
            _posSettings = await PuntoVentaSvc.GetSettingsAsync();
            _cuentasVentas = await PuntoVentaSvc.GetCuentasVentasAsync();
        }
        catch (Exception ex)
        {
            _feedback = AppUiMessage.Error("Configuración del POS", ex.Message);
        }

        var config = await MpConfigSvc.GetConfiguracionAsync();
        _mpAccessToken = config.AccessToken;
        _mpTerminalId = config.TerminalId;
        _mpWebhookSecret = config.WebhookSecret;
        _mpPosExternalId = config.PosExternalId;
        _mpObtenerMedioAutomatico = config.ObtenerMedioPagoAutomatico;
        _mpModoPrueba = config.ModoPrueba;
        _mpMismoMedio = config.MismoMedioParaQrYTarjeta;
        _mpMedioQr = config.MedioPagoQr;
        _mpMedioTarjeta = config.MedioPagoTarjeta;
        _mpMediosHabilitados.Clear();
        foreach (var codigo in config.MediosPagoHabilitados)
            _mpMediosHabilitados.Add(codigo.Trim());
        _mpPuntosVenta.Clear();
        _mpPuntosVenta.AddRange(config.PuntosVenta);
        // Al entrar a Terminales Point debe quedar un punto de venta listo para
        // consultar/asignar lectores, igual que en el formulario VB6.
        if (_mpPuntosVenta.Count > 0)
            _mpPuntoVentaSeleccionado = _mpPuntosVenta[0].Id;

        _mpMediosDePago.Clear();
        try { _mpMediosDePago.AddRange(await PuntoVentaSvc.GetPaymentMethodsAsync()); }
        catch { /* Si el POS todavía no está configurado, se deja vacío -- no bloquea el resto de la pantalla. */ }

        // Las bases antiguas pueden tener guardado el Codigo interno, mientras que el formulario VB6
        // guardaba CodigoOpcional. La pantalla trabaja con un único código visible y acepta ambos.
        _mpMedioQr = CodigoVisibleConfigurado(_mpMedioQr);
        _mpMedioTarjeta = CodigoVisibleConfigurado(_mpMedioTarjeta);
        var mediosGuardados = _mpMediosHabilitados.ToList();
        _mpMediosHabilitados.Clear();
        foreach (var codigo in mediosGuardados)
            _mpMediosHabilitados.Add(CodigoVisibleConfigurado(codigo));

        var idBase = SessionSvc.GetActiveSession()?.BaseId;
        if (idBase is int id and not 0)
        {
            var token = await CentralBasesSvc.EnsureWebhookTokenAsync(id);
            var urlBase = Configuration["ServidorWeb:UrlBasePublica"]?.TrimEnd('/') ?? string.Empty;
            _mpWebhookUrl = $"{urlBase}/api/mercadopago/point/webhook/{token}";
        }
    }

    private static string CodigoMedio(PuntoVentaPaymentMethodDto medio)
        => string.IsNullOrWhiteSpace(medio.CodigoOpcional) ? medio.Codigo.Trim() : medio.CodigoOpcional.Trim();

    private string CodigoVisibleConfigurado(string codigo)
    {
        var medio = _mpMediosDePago.FirstOrDefault(x =>
            string.Equals(x.Codigo, codigo, StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.CodigoOpcional, codigo, StringComparison.OrdinalIgnoreCase));
        return medio is null ? codigo.Trim() : CodigoMedio(medio);
    }

    private void CambiarMedioHabilitado(string codigo, ChangeEventArgs args)
    {
        if (Convert.ToBoolean(args.Value))
            _mpMediosHabilitados.Add(codigo);
        else
            _mpMediosHabilitados.Remove(codigo);
    }

    private void CambiarMismoMedio(bool value)
    {
        _mpMismoMedio = value;
        if (value)
            _mpMedioTarjeta = _mpMedioQr;
    }

    private bool IsTerminalAsignada(string terminalId)
        => _mpPuntosVenta.FirstOrDefault(x => x.Id == _mpPuntoVentaSeleccionado)?
            .TerminalesAsignadas.Contains(terminalId, StringComparer.OrdinalIgnoreCase) == true;

    private void SeleccionarPuntoVentaTerminal(int id)
    {
        _mpPuntoVentaSeleccionado = id;
        _mpTerminalSeleccionada = string.Empty;
    }

    private void SeleccionarTerminal(string terminalId) => _mpTerminalSeleccionada = terminalId;

    private bool PuedeModificarAsignacionTerminal()
        => _mpPuntoVentaSeleccionado > 0 && !string.IsNullOrWhiteSpace(_mpTerminalSeleccionada);

    private void AsignarTerminalAlPuntoVenta()
    {
        var puntoVenta = _mpPuntosVenta.FirstOrDefault(x => x.Id == _mpPuntoVentaSeleccionado);
        if (puntoVenta is null || !PuedeModificarAsignacionTerminal()) return;
        if (!puntoVenta.TerminalesAsignadas.Contains(_mpTerminalSeleccionada, StringComparer.OrdinalIgnoreCase))
            puntoVenta.TerminalesAsignadas.Add(_mpTerminalSeleccionada);
    }

    private void QuitarTerminalDelPuntoVenta()
    {
        var puntoVenta = _mpPuntosVenta.FirstOrDefault(x => x.Id == _mpPuntoVentaSeleccionado);
        if (puntoVenta is null || !PuedeModificarAsignacionTerminal()) return;
        puntoVenta.TerminalesAsignadas.RemoveAll(x => string.Equals(x, _mpTerminalSeleccionada, StringComparison.OrdinalIgnoreCase));
    }

    private void CambiarTerminalAsignada(string terminalId, ChangeEventArgs args)
    {
        var puntoVenta = _mpPuntosVenta.FirstOrDefault(x => x.Id == _mpPuntoVentaSeleccionado);
        if (puntoVenta is null) return;

        var asignada = Convert.ToBoolean(args.Value);
        if (asignada && !puntoVenta.TerminalesAsignadas.Contains(terminalId, StringComparer.OrdinalIgnoreCase))
            puntoVenta.TerminalesAsignadas.Add(terminalId);
        else if (!asignada)
            puntoVenta.TerminalesAsignadas.RemoveAll(x => string.Equals(x, terminalId, StringComparison.OrdinalIgnoreCase));
    }

    private async Task MpCopiarWebhookUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_mpWebhookUrl))
            return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _mpWebhookUrl);
        _feedback = AppUiMessage.Success("Copiado", "La URL de webhook se copió al portapapeles.");
    }

    private void UpdatePageHeader() => PageHeader.Set(new PageHeaderConfig
    {
        Title = "Ventas",
        Breadcrumb = ["Configuración General", "Ventas"],
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildConfiguracionGeneral(RouteContext, Nav, "ventas"),
        Actions =
        [
            new PageHeaderAction
            {
                Key = "guardar-ventas",
                Label = "Guardar",
                Icon = "bi-floppy",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                Busy = _saving,
                OnClick = GuardarAsync
            },
            new PageHeaderAction
            {
                Key = "cancelar-ventas",
                Label = "Cancelar",
                Icon = "bi-x-lg",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                OnClick = CancelarAsync
            }
        ]
    });

    private async Task GuardarAsync()
    {
        _saving = true;
        UpdatePageHeader();
        var result = await UiOps.RunAsync(async () => { await ConfigSvc.SaveVentasPortalClienteAsync(_portal); return true; }, "No se pudo guardar la configuración del Portal Cliente.");
        if (!result.Success)
        {
            _saving = false;
            UpdatePageHeader();
            _feedback = result.Feedback;
            return;
        }

        var arcaResult = await UiOps.RunAsync(async () =>
        {
            await ArcaSvc.GuardarConfiguracionGeneralAsync(_arca);
            foreach (var unidad in _arca.Unidades)
                await ArcaSvc.GuardarUnidadAsync(unidad);
            return true;
        }, "No se pudo guardar la configuración de facturación electrónica.");
        if (!arcaResult.Success)
        {
            _saving = false;
            UpdatePageHeader();
            _feedback = arcaResult.Feedback;
            return;
        }

        var posResult = await UiOps.RunAsync(
            async () => { await PuntoVentaSvc.SaveSettingsAsync(_posSettings); return true; },
            "No se pudo guardar la configuración del Punto de Venta.");
        if (!posResult.Success)
        {
            _saving = false;
            UpdatePageHeader();
            _feedback = posResult.Feedback;
            return;
        }

        var mpResult = await UiOps.RunAsync(async () =>
        {
            await MpConfigSvc.GuardarConfiguracionAsync(new MercadoPagoPointConfigDto
            {
                AccessToken = _mpAccessToken,
                TerminalId = _mpTerminalId,
                PosExternalId = _mpPosExternalId,
                WebhookSecret = _mpWebhookSecret,
                ObtenerMedioPagoAutomatico = _mpObtenerMedioAutomatico,
                ModoPrueba = _mpModoPrueba,
                MismoMedioParaQrYTarjeta = _mpMismoMedio,
                MedioPagoQr = _mpMediosHabilitados.FirstOrDefault() ?? _mpMedioQr,
                MedioPagoTarjeta = _mpMediosHabilitados.FirstOrDefault() ?? _mpMedioTarjeta,
                MediosPagoHabilitados = _mpMediosHabilitados.ToList(),
                PuntosVenta = _mpPuntosVenta
            });
            return true;
        }, "No se pudo guardar la configuración de Mercado Pago Point.");
        _saving = false;
        UpdatePageHeader();

        _feedback = mpResult.Success
            ? AppUiMessage.Success("Guardado", "La configuración se guardó correctamente.")
            : mpResult.Feedback;
    }

    private void ActualizarUrlsArcaSegunAmbiente()
    {
        if (string.Equals(_arca.Ambiente, "PRODUCCION", StringComparison.OrdinalIgnoreCase))
        {
            _arca.WsaaUrl = "https://wsaa.afip.gov.ar/ws/services/LoginCms?wsdl";
            _arca.WsfeUrl = "https://servicios1.afip.gov.ar/wsfev1/service.asmx?WSDL";
            return;
        }

        _arca.WsaaUrl = "https://wsaahomo.afip.gov.ar/ws/services/LoginCms?wsdl";
        _arca.WsfeUrl = "https://wswhomo.afip.gov.ar/wsfev1/service.asmx?WSDL";
    }

    private async Task CancelarAsync()
    {
        if (_saving)
            return;

        var portalResult = await UiOps.RunAsync(() => ConfigSvc.GetVentasPortalClienteAsync(), "No se pudo restaurar la configuración del Portal Cliente.");
        if (portalResult.Success && portalResult.Value is not null)
            _portal = portalResult.Value;

        var arcaResult = await UiOps.RunAsync(() => ArcaSvc.GetConfiguracionGeneralAsync(), "No se pudo restaurar la configuración de facturación electrónica.");
        if (arcaResult.Success && arcaResult.Value is not null)
            _arca = arcaResult.Value;

        await CargarMercadoPagoAsync();

        _feedback = !portalResult.Success
            ? portalResult.Feedback
            : !arcaResult.Success
                ? arcaResult.Feedback
                : AppUiMessage.Info("Cambios cancelados", "Se restauró la última configuración guardada.");
    }

    private async Task HandleCertificadoSeleccionadoAsync(InputFileChangeEventArgs args, string uNegocioOGlobal, bool esClave)
    {
        var file = args.File;
        if (file is null) return;

        var esGlobal = uNegocioOGlobal == ClaveGlobal;
        var esPadron = uNegocioOGlobal == ClavePadron;
        if (esGlobal) _subiendoCertGlobal = true;
        else if (esPadron) _subiendoCertPadron = true;
        else _subiendoCertUnidad = uNegocioOGlobal;

        try
        {
            byte[] contenido;
            await using (var stream = file.OpenReadStream(TamanoMaximoCertificadoBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                contenido = ms.ToArray();
            }

            var crtBytes = esClave ? null : contenido;
            var crtNombre = esClave ? null : file.Name;
            var keyBytes = esClave ? contenido : null;
            var keyNombre = esClave ? file.Name : null;

            var result = await UiOps.RunAsync(async () =>
            {
                await ArcaSvc.SubirCertificadoAsync(uNegocioOGlobal, crtBytes, crtNombre, keyBytes, keyNombre);
                return true;
            }, "No se pudo subir el certificado.");

            if (result.Success)
            {
                if (esGlobal)
                {
                    if (crtNombre is not null) _arca.NombreArchivoCrt = crtNombre;
                    if (keyNombre is not null) _arca.NombreArchivoKey = keyNombre;
                    _arca.TieneCertificado = !string.IsNullOrEmpty(_arca.NombreArchivoCrt) && !string.IsNullOrEmpty(_arca.NombreArchivoKey);
                }
                else if (esPadron)
                {
                    if (crtNombre is not null) _arca.NombreArchivoCrtPadron = crtNombre;
                    if (keyNombre is not null) _arca.NombreArchivoKeyPadron = keyNombre;
                    _arca.TieneCertificadoPadron = !string.IsNullOrEmpty(_arca.NombreArchivoCrtPadron) && !string.IsNullOrEmpty(_arca.NombreArchivoKeyPadron);
                }
                else
                {
                    var unidad = _arca.Unidades.FirstOrDefault(u => u.Codigo == uNegocioOGlobal);
                    if (unidad is not null)
                    {
                        if (crtNombre is not null) unidad.NombreArchivoCrt = crtNombre;
                        if (keyNombre is not null) unidad.NombreArchivoKey = keyNombre;
                        unidad.TieneCertificado = !string.IsNullOrEmpty(unidad.NombreArchivoCrt) && !string.IsNullOrEmpty(unidad.NombreArchivoKey);
                    }
                }
                _feedback = AppUiMessage.Success("Certificado subido", "El certificado se guardó correctamente.");
            }
            else
            {
                _feedback = result.Feedback;
            }
        }
        finally
        {
            if (esGlobal) _subiendoCertGlobal = false;
            else if (esPadron) _subiendoCertPadron = false;
            else _subiendoCertUnidad = null;
        }
    }

    private async Task MpListarTerminalesAsync()
    {
        _mpBusy = true;
        _mpMensajeDiagnostico = string.Empty;
        _mpTerminales.Clear();
        try
        {
            var options = await MpConfigSvc.ResolveOptionsAsync() ?? throw new InvalidOperationException("Guardá la configuración primero.");
            _mpTerminales.AddRange(await MpTerminalsSvc.ListTerminalInfosAsync(options, CancellationToken.None));
            if (_mpTerminales.Count == 0)
                _mpMensajeDiagnostico = "La cuenta no devolvió terminales.";
            _mpMensajeEsError = false;
        }
        catch (Exception ex)
        {
            _mpMensajeDiagnostico = ex.Message;
            _mpMensajeEsError = true;
        }
        finally
        {
            _mpBusy = false;
        }
    }

