@page "/configuracion-general/ventas"
@page "/{idweb}/{idbase:int}/configuracion-general/ventas"
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Forms
@using AlfaCore.Services.MercadoPagoPoint.Models
@inject AlfaCore.Services.IConfiguracionGeneralService ConfigSvc
@inject AlfaCore.Services.IArcaConfigService ArcaSvc
@inject AlfaCore.Services.IMercadoPagoPointConfigService MpConfigSvc
@inject AlfaCore.Services.MercadoPagoPoint.ITerminalsService MpTerminalsSvc
@inject AlfaCore.Services.MercadoPagoPoint.IPosService MpPosSvc
@inject AlfaCore.Services.IMercadoPagoPointPosService MpPaymentSvc
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Ventas | Alfa Gestión</PageTitle>

<div class="page-grid cfgventas-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <section class="panel-card">
        <h3 class="panel-card__title">Portal del Cliente</h3>
        <p class="panel-card__subtitle">
            Elegí qué secciones puede ver el cliente en su Portal. <strong>Inicio</strong> y <strong>Mi cuenta</strong>
            siempre están disponibles; el resto se puede ocultar.
        </p>

        <div class="cfgventas-checks">
            <AlfaCheckbox Value="@_portal.CuentaCorriente" ValueChanged="v => _portal.CuentaCorriente = v == true">
                <i class="bi bi-cash-stack"></i> Cuenta corriente
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.ListaPrecios" ValueChanged="v => _portal.ListaPrecios = v == true">
                <i class="bi bi-tags"></i> Lista de precios
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.Catalogos" ValueChanged="v => _portal.Catalogos = v == true">
                <i class="bi bi-book"></i> Catálogos
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.Carrito" ValueChanged="v => _portal.Carrito = v == true">
                <i class="bi bi-cart3"></i> Carrito de compra
            </AlfaCheckbox>
            <AlfaCheckbox Value="@_portal.Pedidos" ValueChanged="v => _portal.Pedidos = v == true">
                <i class="bi bi-receipt"></i> Pedidos
            </AlfaCheckbox>
        </div>
    </section>

    <section class="panel-card">
        <h3 class="panel-card__title">Facturación electrónica (AFIP/ARCA)</h3>
        <p class="panel-card__subtitle">
            Configurá el CAE real para las facturas del Punto de Venta. Se puede facturar con un único
            CUIT general, o dejar que cada unidad de negocio facture con el suyo propio.
        </p>

        <div class="cfgventas-checks">
            <AlfaCheckbox Value="@_arca.UsaFacturacionElectronica" ValueChanged="v => _arca.UsaFacturacionElectronica = v == true">
                <i class="bi bi-file-earmark-check"></i> Habilitar facturación electrónica
            </AlfaCheckbox>
        </div>

        @if (_arca.UsaFacturacionElectronica)
        {
            <div class="cfgarca-row cfgarca-row--general">
                <label class="cfgarca-field">
                    Ambiente
                    <select class="cfgarca-select" @bind="_arca.Ambiente">
                        <option value="HOMOLOGACION">Homologación (pruebas, sin validez fiscal)</option>
                        <option value="PRODUCCION">Producción</option>
                    </select>
                </label>
                <label class="cfgarca-field">
                    Si AFIP rechaza o no responde
                    <select class="cfgarca-select" @bind="_arca.ModoFalloCae">
                        <option value="ESTRICTO">Cortar la venta (recomendado)</option>
                        <option value="DEGRADADO">Completar igual, CAE pendiente</option>
                    </select>
                </label>
            </div>

            <h4 class="cfgarca-subtitle">CUIT general (fallback)</h4>
            <p class="panel-card__subtitle">Se usa para las unidades de negocio que no tengan factura electrónica propia activada abajo.</p>
            <div class="cfgarca-row cfgarca-row--fallback">
                <label class="cfgarca-field">
                    CUIT
                    <input class="cfgarca-input" @bind="_arca.Cuit" maxlength="15" placeholder="Sin guiones" />
                </label>
                <label class="cfgarca-field">
                    Punto de venta
                    <input class="cfgarca-input" @bind="_arca.PuntoVenta" maxlength="4" />
                </label>
                <div class="cfgarca-field cfgarca-field--certificate">
                    Certificado (.crt)
                    <div class="cfgarca-cert">
                        <div class="cfgarca-cert-picker">
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertGlobal">
                                @(string.IsNullOrEmpty(_arca.NombreArchivoCrt) ? "Subir .crt" : "Reemplazar")
                            </AlfaButton>
                            <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClaveGlobal, esClave: false)" accept=".crt,.pem" disabled="@_subiendoCertGlobal" />
                        </div>
                        <span class="cfgarca-cert-estado">
                            @if (!string.IsNullOrEmpty(_arca.NombreArchivoCrt))
                            {
                                <span><i class="bi bi-shield-check"></i> @_arca.NombreArchivoCrt</span>
                            }
                            else
                            {
                                <span class="cfgarca-cert-vacio">Sin subir</span>
                            }
                        </span>
                    </div>
                </div>
                <div class="cfgarca-field cfgarca-field--certificate">
                    Clave privada (.key)
                    <div class="cfgarca-cert">
                        <div class="cfgarca-cert-picker">
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertGlobal">
                                @(string.IsNullOrEmpty(_arca.NombreArchivoKey) ? "Subir .key" : "Reemplazar")
                            </AlfaButton>
                            <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClaveGlobal, esClave: true)" accept=".key,.pem" disabled="@_subiendoCertGlobal" />
                        </div>
                        <span class="cfgarca-cert-estado">
                            @if (!string.IsNullOrEmpty(_arca.NombreArchivoKey))
                            {
                                <span><i class="bi bi-shield-check"></i> @_arca.NombreArchivoKey</span>
                            }
                            else
                            {
                                <span class="cfgarca-cert-vacio">Sin subir</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <h4 class="cfgarca-subtitle">Unidades de negocio con factura electrónica propia</h4>
            <p class="panel-card__subtitle">
                Detectadas en <code>V_TA_UnidadNegocio</code>. Activá la que corresponda y subí su
                certificado -- si no la activás, esa unidad factura con el CUIT general de arriba.
            </p>

            @if (_arca.Unidades.Count == 0)
            {
                <p class="cfgarca-sin-unidades">No hay unidades de negocio cargadas.</p>
            }
            else
            {
                <div class="cfgarca-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Razón social</th>
                                <th>Usa eFC</th>
                                <th>CUIT</th>
                                <th>PV</th>
                                <th>Certificado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unidad in _arca.Unidades)
                            {
                                <tr>
                                    <td>@unidad.Codigo</td>
                                    <td>@unidad.RazonSocialUnidad</td>
                                    <td>
                                        <AlfaCheckbox Value="@unidad.UsaFacturacionElectronica" ValueChanged="v => unidad.UsaFacturacionElectronica = v == true" />
                                    </td>
                                    <td><input class="cfgarca-input cfgarca-input--sm" @bind="unidad.Cuit" maxlength="15" /></td>
                                    <td><input class="cfgarca-input cfgarca-input--xs" @bind="unidad.PuntoVenta" maxlength="4" /></td>
                                    <td>
                                        <div class="cfgarca-cert">
                                            <div class="cfgarca-cert-picker" title="Certificado .crt">
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-filetype-key" Disabled="@(_subiendoCertUnidad == unidad.Codigo)">
                                                    .crt
                                                </AlfaButton>
                                                <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, unidad.Codigo, esClave: false)" accept=".crt,.pem" disabled="@(_subiendoCertUnidad == unidad.Codigo)" />
                                            </div>
                                            <div class="cfgarca-cert-picker" title="Clave privada .key">
                                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-filetype-key" Disabled="@(_subiendoCertUnidad == unidad.Codigo)">
                                                    .key
                                                </AlfaButton>
                                                <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, unidad.Codigo, esClave: true)" accept=".key,.pem" disabled="@(_subiendoCertUnidad == unidad.Codigo)" />
                                            </div>
                                            <span class="cfgarca-cert-estado">
                                                @if (unidad.TieneCertificado)
                                                {
                                                    <i class="bi bi-shield-check"></i>
                                                }
                                                else
                                                {
                                                    <span class="cfgarca-cert-vacio">Sin subir</span>
                                                }
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        <h4 class="cfgarca-subtitle">Consulta de padrón ARCA (certificado independiente)</h4>
        <p class="panel-card__subtitle">
            Este certificado se usa solamente para consultar clientes/proveedores en ARCA y no reemplaza
            el certificado de facturación electrónica.
        </p>
        <div class="cfgarca-row cfgarca-row--fallback">
            <div class="cfgarca-field cfgarca-field--certificate">
                Certificado padrón (.crt)
                <div class="cfgarca-cert">
                    <div class="cfgarca-cert-picker">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertPadron">
                            @(string.IsNullOrEmpty(_arca.NombreArchivoCrtPadron) ? "Subir .crt" : "Reemplazar")
                        </AlfaButton>
                        <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClavePadron, esClave: false)" accept=".crt,.pem" disabled="@_subiendoCertPadron" />
                    </div>
                    <span class="cfgarca-cert-estado">
                        @(string.IsNullOrEmpty(_arca.NombreArchivoCrtPadron) ? "Sin subir" : _arca.NombreArchivoCrtPadron)
                    </span>
                </div>
            </div>
            <div class="cfgarca-field cfgarca-field--certificate">
                Clave padrón (.key)
                <div class="cfgarca-cert">
                    <div class="cfgarca-cert-picker">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@_subiendoCertPadron">
                            @(string.IsNullOrEmpty(_arca.NombreArchivoKeyPadron) ? "Subir .key" : "Reemplazar")
                        </AlfaButton>
                        <InputFile class="cfgarca-input-file" OnChange="e => HandleCertificadoSeleccionadoAsync(e, ClavePadron, esClave: true)" accept=".key,.pem" disabled="@_subiendoCertPadron" />
                    </div>
                    <span class="cfgarca-cert-estado">
                        @(string.IsNullOrEmpty(_arca.NombreArchivoKeyPadron) ? "Sin subir" : _arca.NombreArchivoKeyPadron)
                    </span>
                </div>
            </div>
        </div>
    </section>

    <section class="panel-card">
        <h3 class="panel-card__title">Mercado Pago Point (terminal física)</h3>
        <p class="panel-card__subtitle">
            Cobro con tarjeta/QR desde el Punto de Venta usando una terminal Mercado Pago Point. Un solo
            terminal fijo por base en esta etapa.
        </p>

        <div class="cfgarca-row cfgarca-row--fallback">
            <label class="cfgarca-field">
                Access Token
                <input class="cfgarca-input" type="password" @bind="_mpAccessToken" placeholder="APP_USR-..." />
            </label>
            <label class="cfgarca-field">
                Terminal ID
                <input class="cfgarca-input" @bind="_mpTerminalId" />
            </label>
            <label class="cfgarca-field">
                POS External ID (informativo)
                <input class="cfgarca-input" @bind="_mpPosExternalId" />
            </label>
            <label class="cfgarca-field">
                Webhook Secret
                <input class="cfgarca-input" type="password" @bind="_mpWebhookSecret" />
            </label>
        </div>

        <h4 class="cfgarca-subtitle">Medio de pago vinculado</h4>
        <p class="panel-card__subtitle">
            Elegí cuál de los medios de pago ya cargados en el POS dispara el cobro real con la
            terminal. No asumimos ningún código fijo -- cada base tiene los suyos propios (por ejemplo
            "QR" o "MP"), normalmente clasificados como efectivo a nivel contable.
        </p>
        <div class="cfgarca-row cfgarca-row--fallback">
            <label class="cfgarca-field">
                Medio de pago
                <select class="cfgarca-input" @bind="_mpCodigoMedioPago">
                    <option value="">Sin vincular</option>
                    @foreach (var medio in _mpMediosDePago)
                    {
                        <option value="@medio.Codigo">@medio.Descripcion (@medio.Codigo · @medio.MedioDePago)</option>
                    }
                </select>
            </label>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mpWebhookUrl))
        {
            <div class="shell-empty-state">
                <strong>URL de webhook para registrar en Mercado Pago</strong>
                <span>@_mpWebhookUrl</span>
                <button type="button" class="btn btn-sm btn-outline-light mt-2" @onclick="MpCopiarWebhookUrlAsync">Copiar</button>
            </div>
        }

        <h4 class="cfgarca-subtitle">Diagnóstico</h4>
        <p class="panel-card__subtitle">Probá la configuración ya guardada antes de usarla en una venta real.</p>
        <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn btn-outline-light" disabled="@_mpBusy" @onclick="MpListarTerminalesAsync">Listar terminales</button>
            <button type="button" class="btn btn-outline-light" disabled="@_mpBusy" @onclick="MpListarPosAsync">Listar puntos de venta</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mpMensajeDiagnostico))
        {
            <div class="editor-msg @(_mpMensajeEsError ? "editor-msg--error" : "editor-msg--ok")">@_mpMensajeDiagnostico</div>
        }

        @if (_mpTerminales.Count > 0)
        {
            <div class="cfgarca-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Id</th><th>Modo</th><th>Sucursal</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var t in _mpTerminales)
                        {
                            <tr><td>@t.Id</td><td>@t.OperatingMode</td><td>@t.Store</td><td>@t.Status</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_mpPos.Count > 0)
        {
            <div class="cfgarca-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Id</th><th>Nombre</th><th>Sucursal</th><th>Terminal</th></tr></thead>
                    <tbody>
                        @foreach (var p in _mpPos)
                        {
                            <tr><td>@p.Id</td><td>@p.Name</td><td>@p.Store</td><td>@p.TerminalId</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h4 class="cfgarca-subtitle">Cobro de prueba</h4>
        <div class="cfgarca-row cfgarca-row--fallback">
            <label class="cfgarca-field">
                Importe
                <input class="cfgarca-input" type="number" step="0.01" min="0.01" @bind="_mpImportePrueba" disabled="@_mpCobrando" />
            </label>
            <div class="cfgarca-field d-flex gap-2 align-items-end">
                <button type="button" class="btn btn-primary" disabled="@(_mpBusy || _mpCobrando)" @onclick="MpCobrarAsync">Cobrar</button>
                <button type="button" class="btn btn-outline-danger" disabled="@(!_mpCobrando)" @onclick="MpCancelar">Cancelar</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mpEstadoCobro))
        {
            <div class="shell-empty-state">
                <strong>Estado</strong>
                <span>@_mpEstadoCobro</span>
            </div>
        }

        @if (_mpUltimoResultado is not null)
        {
            <div class="shell-empty-state">
                <strong>@(_mpUltimoResultado.Approved ? "Aprobado" : "No aprobado")</strong>
                <span>Order: @_mpUltimoResultado.OrderId · Status: @_mpUltimoResultado.Status · Payment: @_mpUltimoResultado.PaymentId</span>
            </div>
        }
    </section>

</div>

@code {
    private const string ClaveGlobal = "GLOBAL";
    private const string ClavePadron = "PADRON";
    private const long TamanoMaximoCertificadoBytes = 512 * 1024;

    private ConfiguracionVentasPortalClienteDto _portal = new();
    private ArcaConfiguracionGeneralDto _arca = new();
    private bool _saving;
    private bool _subiendoCertGlobal;
    private bool _subiendoCertPadron;
    private string? _subiendoCertUnidad;
    private AppUiMessage? _feedback;

    private string _mpAccessToken = string.Empty;
    private string _mpTerminalId = string.Empty;
    private string _mpPosExternalId = string.Empty;
    private string _mpWebhookSecret = string.Empty;
    private string _mpCodigoMedioPago = string.Empty;
    private readonly List<PuntoVentaPaymentMethodDto> _mpMediosDePago = [];
    private bool _mpBusy;
    private bool _mpCobrando;
    private string _mpMensajeDiagnostico = string.Empty;
    private bool _mpMensajeEsError;
    private decimal _mpImportePrueba = 1m;
    private string _mpEstadoCobro = string.Empty;
    private string? _mpWebhookUrl;
    private PaymentResult? _mpUltimoResultado;
    private readonly List<TerminalInfo> _mpTerminales = [];
    private readonly List<PosInfo> _mpPos = [];

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose() => PageHeader.Clear();

    protected override async Task OnInitializedAsync()
    {
        var result = await UiOps.RunAsync(() => ConfigSvc.GetVentasPortalClienteAsync(), "No se pudo cargar la configuración del Portal Cliente.");
        if (result.Success && result.Value is not null)
            _portal = result.Value;
        else if (!result.Success)
            _feedback = result.Feedback;

        var arcaResult = await UiOps.RunAsync(() => ArcaSvc.GetConfiguracionGeneralAsync(), "No se pudo cargar la configuración de facturación electrónica.");
        if (arcaResult.Success && arcaResult.Value is not null)
            _arca = arcaResult.Value;
        else if (!arcaResult.Success)
            _feedback = arcaResult.Feedback;

        await CargarMercadoPagoAsync();
    }

    private async Task CargarMercadoPagoAsync()
    {
        var options = await MpConfigSvc.ResolveOptionsAsync();
        _mpAccessToken = options?.AccessToken ?? string.Empty;
        _mpTerminalId = options?.TerminalId ?? string.Empty;
        _mpWebhookSecret = await MpConfigSvc.ResolveWebhookSecretAsync();
        _mpPosExternalId = await MpConfigSvc.ResolvePosExternalIdAsync();
        _mpCodigoMedioPago = await MpConfigSvc.ResolveCodigoMedioPagoAsync();

        _mpMediosDePago.Clear();
        try { _mpMediosDePago.AddRange(await PuntoVentaSvc.GetPaymentMethodsAsync()); }
        catch { /* Si el POS todavía no está configurado, se deja vacío -- no bloquea el resto de la pantalla. */ }

        var idBase = SessionSvc.GetActiveSession()?.BaseId;
        if (idBase is int id and not 0)
        {
            var token = await CentralBasesSvc.EnsureWebhookTokenAsync(id);
            var urlBase = Configuration["ServidorWeb:UrlBasePublica"]?.TrimEnd('/') ?? string.Empty;
            _mpWebhookUrl = $"{urlBase}/api/mercadopago/point/webhook/{token}";
        }
    }

    private async Task MpCopiarWebhookUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_mpWebhookUrl))
            return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _mpWebhookUrl);
        _feedback = AppUiMessage.Success("Copiado", "La URL de webhook se copió al portapapeles.");
    }

    private void UpdatePageHeader() => PageHeader.Set(new PageHeaderConfig
    {
        Title = "Ventas",
        Breadcrumb = ["Configuración General", "Ventas"],
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildConfiguracionGeneral(RouteContext, Nav, "ventas"),
        Actions =
        [
            new PageHeaderAction
            {
                Key = "guardar-ventas",
                Label = "Guardar",
                Icon = "bi-floppy",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                Busy = _saving,
                OnClick = GuardarAsync
            },
            new PageHeaderAction
            {
                Key = "cancelar-ventas",
                Label = "Cancelar",
                Icon = "bi-x-lg",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                OnClick = CancelarAsync
            }
        ]
    });

    private async Task GuardarAsync()
    {
        _saving = true;
        UpdatePageHeader();
        var result = await UiOps.RunAsync(async () => { await ConfigSvc.SaveVentasPortalClienteAsync(_portal); return true; }, "No se pudo guardar la configuración del Portal Cliente.");
        if (!result.Success)
        {
            _saving = false;
            UpdatePageHeader();
            _feedback = result.Feedback;
            return;
        }

        var arcaResult = await UiOps.RunAsync(async () =>
        {
            await ArcaSvc.GuardarConfiguracionGeneralAsync(_arca);
            foreach (var unidad in _arca.Unidades)
                await ArcaSvc.GuardarUnidadAsync(unidad);
            return true;
        }, "No se pudo guardar la configuración de facturación electrónica.");
        if (!arcaResult.Success)
        {
            _saving = false;
            UpdatePageHeader();
            _feedback = arcaResult.Feedback;
            return;
        }

        var mpResult = await UiOps.RunAsync(async () =>
        {
            await MpConfigSvc.GuardarConfiguracionAsync(_mpAccessToken, _mpTerminalId, _mpPosExternalId, _mpWebhookSecret, _mpCodigoMedioPago);
            return true;
        }, "No se pudo guardar la configuración de Mercado Pago Point.");
        _saving = false;
        UpdatePageHeader();

        _feedback = mpResult.Success
            ? AppUiMessage.Success("Guardado", "La configuración se guardó correctamente.")
            : mpResult.Feedback;
    }

    private async Task CancelarAsync()
    {
        if (_saving)
            return;

        var portalResult = await UiOps.RunAsync(() => ConfigSvc.GetVentasPortalClienteAsync(), "No se pudo restaurar la configuración del Portal Cliente.");
        if (portalResult.Success && portalResult.Value is not null)
            _portal = portalResult.Value;

        var arcaResult = await UiOps.RunAsync(() => ArcaSvc.GetConfiguracionGeneralAsync(), "No se pudo restaurar la configuración de facturación electrónica.");
        if (arcaResult.Success && arcaResult.Value is not null)
            _arca = arcaResult.Value;

        await CargarMercadoPagoAsync();

        _feedback = !portalResult.Success
            ? portalResult.Feedback
            : !arcaResult.Success
                ? arcaResult.Feedback
                : AppUiMessage.Info("Cambios cancelados", "Se restauró la última configuración guardada.");
    }

    private async Task HandleCertificadoSeleccionadoAsync(InputFileChangeEventArgs args, string uNegocioOGlobal, bool esClave)
    {
        var file = args.File;
        if (file is null) return;

        var esGlobal = uNegocioOGlobal == ClaveGlobal;
        var esPadron = uNegocioOGlobal == ClavePadron;
        if (esGlobal) _subiendoCertGlobal = true;
        else if (esPadron) _subiendoCertPadron = true;
        else _subiendoCertUnidad = uNegocioOGlobal;

        try
        {
            byte[] contenido;
            await using (var stream = file.OpenReadStream(TamanoMaximoCertificadoBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                contenido = ms.ToArray();
            }

            var crtBytes = esClave ? null : contenido;
            var crtNombre = esClave ? null : file.Name;
            var keyBytes = esClave ? contenido : null;
            var keyNombre = esClave ? file.Name : null;

            var result = await UiOps.RunAsync(async () =>
            {
                await ArcaSvc.SubirCertificadoAsync(uNegocioOGlobal, crtBytes, crtNombre, keyBytes, keyNombre);
                return true;
            }, "No se pudo subir el certificado.");

            if (result.Success)
            {
                if (esGlobal)
                {
                    if (crtNombre is not null) _arca.NombreArchivoCrt = crtNombre;
                    if (keyNombre is not null) _arca.NombreArchivoKey = keyNombre;
                    _arca.TieneCertificado = !string.IsNullOrEmpty(_arca.NombreArchivoCrt) && !string.IsNullOrEmpty(_arca.NombreArchivoKey);
                }
                else if (esPadron)
                {
                    if (crtNombre is not null) _arca.NombreArchivoCrtPadron = crtNombre;
                    if (keyNombre is not null) _arca.NombreArchivoKeyPadron = keyNombre;
                    _arca.TieneCertificadoPadron = !string.IsNullOrEmpty(_arca.NombreArchivoCrtPadron) && !string.IsNullOrEmpty(_arca.NombreArchivoKeyPadron);
                }
                else
                {
                    var unidad = _arca.Unidades.FirstOrDefault(u => u.Codigo == uNegocioOGlobal);
                    if (unidad is not null)
                    {
                        if (crtNombre is not null) unidad.NombreArchivoCrt = crtNombre;
                        if (keyNombre is not null) unidad.NombreArchivoKey = keyNombre;
                        unidad.TieneCertificado = !string.IsNullOrEmpty(unidad.NombreArchivoCrt) && !string.IsNullOrEmpty(unidad.NombreArchivoKey);
                    }
                }
                _feedback = AppUiMessage.Success("Certificado subido", "El certificado se guardó correctamente.");
            }
            else
            {
                _feedback = result.Feedback;
            }
        }
        finally
        {
            if (esGlobal) _subiendoCertGlobal = false;
            else if (esPadron) _subiendoCertPadron = false;
            else _subiendoCertUnidad = null;
        }
    }

    private async Task MpListarTerminalesAsync()
    {
        _mpBusy = true;
        _mpMensajeDiagnostico = string.Empty;
        _mpTerminales.Clear();
        try
        {
            var options = await MpConfigSvc.ResolveOptionsAsync() ?? throw new InvalidOperationException("Guardá la configuración primero.");
            _mpTerminales.AddRange(await MpTerminalsSvc.ListTerminalInfosAsync(options, CancellationToken.None));
            if (_mpTerminales.Count == 0)
                _mpMensajeDiagnostico = "La cuenta no devolvió terminales.";
            _mpMensajeEsError = false;
        }
        catch (Exception ex)
        {
            _mpMensajeDiagnostico = ex.Message;
            _mpMensajeEsError = true;
        }
        finally
        {
            _mpBusy = false;
        }
    }

