@page "/informes"
@inject AlfaCore.Services.IInformesService InformesSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Net
@using System.Text
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.WebUtilities
@implements IAsyncDisposable

<PageTitle>Informes | Alfa Gestion</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="/css/informes.css?v=20260608-editorfix" />
</HeadContent>

<section class="informes-shell">
    <aside class="informes-sidebar">
        <div class="informes-sidebar__top">
            <button type="button" class="informes-new" @onclick="() => CreateArticleAsync(null, InformesCategorias.EspacioTrabajo)">
                <i class="bi bi-plus-lg"></i>
                <span>Nuevo articulo</span>
            </button>
            <button type="button" class="informes-icon-btn" title="Buscar" @onclick="FocusSearch">
                <i class="bi bi-search"></i>
            </button>
        </div>

        <label class="informes-search">
            <i class="bi bi-search"></i>
            <input @bind="_search" @bind:event="oninput" @onkeyup="SearchKeyUpAsync" placeholder="Buscar articulos" />
        </label>

        <div class="informes-tree">
            <div class="informes-tree__section">
                <span>Favoritos</span>
            </div>
            @foreach (var row in FavoriteRows)
            {
                @ArticleButton(row)
            }

            <div class="informes-tree__section informes-tree__section--with-action">
                <span>Espacio de trabajo</span>
                <button type="button" title="Crear articulo" @onclick="() => CreateArticleAsync(null, InformesCategorias.EspacioTrabajo)">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
            @foreach (var row in WorkspaceRows)
            {
                @ArticleButton(row)
            }

            <div class="informes-tree__section informes-tree__section--with-action">
                <span>Privado</span>
                <button type="button" title="Crear articulo privado" @onclick="() => CreateArticleAsync(null, InformesCategorias.Privado)">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
            @foreach (var row in PrivateRows)
            {
                @ArticleButton(row)
            }

            @if (_showTrash)
            {
                <div class="informes-tree__section">
                    <span>Papelera</span>
                </div>
                @foreach (var row in TrashRows)
                {
                    @ArticleButton(row)
                }
            }
        </div>

        <div class="informes-sidebar__bottom">
            <button type="button" @onclick="OpenTemplatePicker">
                <i class="bi bi-brush"></i>
                <span>Explorar plantillas</span>
            </button>
            <button type="button" @onclick="ToggleTrashAsync">
                <i class="bi bi-trash3"></i>
                <span>@(_showTrash ? "Ocultar papelera" : "Abrir papelera")</span>
            </button>
        </div>
    </aside>

    <main class="informes-main">
        @if (_loading)
        {
            <div class="informes-empty">
                <i class="bi bi-hourglass-split"></i>
                <h2>Cargando informes</h2>
            </div>
        }
        else if (_selected is null)
        {
            <div class="informes-empty">
                <i class="bi bi-journal-richtext"></i>
                <h2>Titulo 1</h2>
                <p>Seleccione una opcion para empezar.</p>
                <button type="button" @onclick="OpenTemplatePicker"><i class="bi bi-brush"></i> Cargar una plantilla</button>
                <button type="button" @onclick="() => CreateArticleAsync(null, InformesCategorias.EspacioTrabajo)"><i class="bi bi-file-earmark-plus"></i> Crear articulo en blanco</button>
            </div>
        }
        else
        {
            <header class="informes-toolbar">
                <div class="informes-breadcrumb">
                    <i class="bi @IconClass(_selected.Emoji)"></i>
                    <span>@_selected.Titulo</span>
                    @if (_selected.EsCompartido)
                    {
                        <i class="bi bi-cloud-check-fill" title="Compartido"></i>
                    }
                </div>
                <div class="informes-actions">
                    <button type="button" @onclick="ToggleShareAsync" title="Compartir">
                        <i class="bi bi-share"></i>
                        <span>Compartir</span>
                    </button>
                    <button type="button" class="@(_selected.EsFavorito ? "is-active" : "")" @onclick="ToggleFavoriteAsync" title="Favorito">
                        <i class="bi bi-star-fill"></i>
                    </button>
                    <button type="button" @onclick="DuplicateAsync" title="Duplicar">
                        <i class="bi bi-copy"></i>
                    </button>
                    @if (_selected.Archivado)
                    {
                        <button type="button" @onclick="RestoreAsync" title="Restaurar">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="DeleteAsync" title="Enviar a papelera">
                            <i class="bi bi-trash3"></i>
                        </button>
                    }
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <div class="informes-feedback">@_feedback</div>
            }

            <section class="@CoverClass">
                @if (_draft.PortadaTipo == InformesPortadas.Url && !string.IsNullOrWhiteSpace(_draft.PortadaValor))
                {
                    <img src="@_draft.PortadaValor" alt="" />
                }
                <div class="informes-cover__actions">
                    <button type="button" @onclick='() => SetCover(InformesPortadas.Gradiente, "alfa")'><i class="bi bi-image"></i> Portada Alfa</button>
                    <button type="button" @onclick="() => SetCover(InformesPortadas.Ninguna, string.Empty)"><i class="bi bi-x-lg"></i> Quitar</button>
                </div>
            </section>

            <section class="informes-document">
                <div class="informes-title-row">
                    <button type="button" class="informes-emoji" @onclick="CycleIcon" title="Cambiar icono">
                        <i class="bi @IconClass(_draft.Emoji)"></i>
                    </button>
                    <input class="informes-title" @bind="_draft.Titulo" placeholder="Titulo 1" disabled="@_saving" />
                </div>

                <div class="informes-meta">
                    <select @bind="_draft.Categoria" disabled="@_saving">
                        <option value="@InformesCategorias.EspacioTrabajo">Espacio de trabajo</option>
                        <option value="@InformesCategorias.Privado">Privado</option>
                    </select>
                    <select @bind="_draft.IdPadre" disabled="@_saving">
                        <option value="">Sin articulo padre</option>
                        @foreach (var article in ParentOptions)
                        {
                            <option value="@article.IdArticulo">@article.Titulo</option>
                        }
                    </select>
                    <label>
                        <input type="checkbox" @bind="_draft.Bloqueado" disabled="@_saving" />
                        Bloquear edicion
                    </label>
                </div>

                <div class="informes-rich-editor" @ref="_editorRoot">
                    <div class="informes-editor-surface"
                         @ref="_contentEditor"
                         contenteditable="@(!_saving && !_draft.Bloqueado)"
                         data-placeholder="Escribi / para comandos"
                         @oninput="OnContentChangedAsync"
                         @onkeyup="OnContentChangedAsync"
                         @onfocus="OnContentFocusAsync"></div>
                    <div class="informes-blockbar">
                        @foreach (var option in ToolbarCommands)
                        {
                            <button type="button"
                                    title="@option.Title"
                                    disabled="@(_saving || _draft.Bloqueado)"
                                    @onclick="() => RunEditorCommandAsync(option)">
                                <i class="bi @option.Icon"></i>
                            </button>
                        }
                        <button type="button"
                                title="Comandos"
                                disabled="@(_saving || _draft.Bloqueado)"
                                @onclick="ToggleCommandMenu">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                    </div>
                    @if (_showCommandMenu)
                    {
                        <div class="informes-command-menu">
                            @foreach (var group in EditorCommands.GroupBy(x => x.Group))
                            {
                                <div class="informes-command-menu__group">
                                    <span>@group.Key</span>
                                    @foreach (var option in group)
                                    {
                                        <button type="button" @onclick="() => RunEditorCommandAsync(option)">
                                            <i class="bi @option.Icon"></i>
                                            <strong>@option.Title</strong>
                                            <small>@option.Description</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <footer class="informes-savebar">
                    <button type="button" class="btn btn--primary" disabled="@_saving" @onclick="SaveAsync">
                        <i class="bi bi-save"></i>
                        <span>Guardar</span>
                    </button>
                    <button type="button" class="btn btn--ghost" disabled="@_saving" @onclick="OpenTemplatePicker">
                        <i class="bi bi-brush"></i>
                        <span>Plantillas</span>
                    </button>
                    @if (_selected.EsCompartido && _selected.TokenPublico is not null)
                    {
                        <span class="informes-share-link">@BuildShareUrl(_selected.TokenPublico.Value)</span>
                    }
                </footer>
            </section>

            <aside class="informes-panel">
                <section>
                    <h3>Comentarios</h3>
                    <div class="informes-comment-form">
                        <input @bind="_newComment" placeholder="Agregar comentario" />
                        <button type="button" @onclick="AddCommentAsync"><i class="bi bi-send"></i></button>
                    </div>
                    @foreach (var comment in _comments)
                    {
                        <div class="@("informes-comment" + (comment.Resuelto ? " is-resolved" : ""))">
                            <p>@comment.Texto</p>
                            <small>@comment.UsuarioAlta - @comment.FechaHoraAlta.ToString("dd/MM HH:mm")</small>
                            <button type="button" @onclick="() => ToggleCommentAsync(comment)">@((comment.Resuelto ? "Reabrir" : "Resolver"))</button>
                        </div>
                    }
                </section>

                <section>
                    <h3>Versiones</h3>
                    @foreach (var version in _versions)
                    {
                        <button type="button" class="informes-version" @onclick="() => RestoreVersionAsync(version.IdVersion)">
                            <span>@version.Titulo</span>
                            <small>@version.Usuario - @version.FechaHora.ToString("dd/MM HH:mm")</small>
                        </button>
                    }
                </section>
            </aside>
        }
    </main>
</section>

@if (_showTemplatePicker)
{
    <div class="informes-modal" role="dialog" aria-modal="true">
        <section class="informes-template-picker">
            <header>
                <h2>Seleccione una plantilla</h2>
                <button type="button" @onclick="CloseTemplatePicker" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </header>
            <div class="informes-template-picker__body">
                <nav>
                    @foreach (var group in TemplateGroups)
                    {
                        <p>@group</p>
                        @foreach (var template in _templates.Where(x => x.Grupo == group))
                        {
                            <button type="button" class="@(template.Key == _selectedTemplateKey ? "is-selected" : "")" @onclick="() => SelectTemplate(template.Key)">
                                <i class="bi @template.Icono"></i>
                                <span>@template.Nombre</span>
                            </button>
                        }
                    }
                </nav>
                <article>
                    @if (SelectedTemplate is not null)
                    {
                        <i class="bi @SelectedTemplate.Icono informes-template-icon"></i>
                        <h1>@SelectedTemplate.Titulo</h1>
                        <p>@SelectedTemplate.Descripcion</p>
                        <div class="informes-template-preview">@((MarkupString)SelectedTemplate.Contenido)</div>
                    }
                </article>
            </div>
            <footer>
                <button type="button" class="btn btn--primary" @onclick="CreateFromTemplateAsync">Cargar plantilla</button>
                <button type="button" class="btn btn--ghost" @onclick="CloseTemplatePicker">Descartar</button>
            </footer>
        </section>
    </div>
}

@code {
    private InformesPageDto _page = new();
    private InformesArticuloDetalleDto? _selected;
    private InformesArticuloSaveRequest _draft = new();
    private List<InformesPlantillaDto> _templates = [];
    private List<InformesComentarioDto> _comments = [];
    private List<InformesVersionDto> _versions = [];
    private ElementReference _editorRoot;
    private ElementReference _contentEditor;
    private IJSObjectReference? _editorJs;
    private IJSObjectReference? _informesEditorJs;
    private bool _loading;
    private bool _saving;
    private bool _showTrash;
    private bool _showTemplatePicker;
    private bool _showCommandMenu;
    private bool _editorReady;
    private bool _editorRootWired;
    private string _search = string.Empty;
    private string _feedback = string.Empty;
    private string _newComment = string.Empty;
    private string _selectedTemplateKey = "agenda";

    private static readonly IReadOnlyList<EditorCommandOption> EditorCommands =
    [
        new("FORMATO", "Titulo 1", "Titulo principal del bloque", "bi-type-h1", "h1"),
        new("FORMATO", "Titulo 2", "Titulo de seccion", "bi-type-h2", "h2"),
        new("FORMATO", "Titulo 3", "Subtitulo", "bi-type-h3", "h3"),
        new("FORMATO", "Texto", "Parrafo normal", "bi-paragraph", "paragraph"),
        new("ESTRUCTURA", "Lista", "Lista con vinetas", "bi-list-ul", "bulletList"),
        new("ESTRUCTURA", "Lista numerada", "Lista ordenada", "bi-list-ol", "numberedList"),
        new("ESTRUCTURA", "Casillas", "Lista de comprobacion", "bi-check2-square", "checkList"),
        new("ESTRUCTURA", "Separador", "Linea divisoria", "bi-dash-lg", "separator"),
        new("BLOQUES", "Informacion", "Banner informativo", "bi-info-circle", "infoBanner"),
        new("BLOQUES", "Advertencia", "Banner de advertencia", "bi-exclamation-triangle", "warningBanner"),
        new("BLOQUES", "Codigo", "Bloque tecnico", "bi-code-slash", "codeBlock"),
        new("BLOQUES", "Emoji", "Insertar emoji", "bi-emoji-smile", "emoji")
    ];

    private static readonly IReadOnlyList<EditorCommandOption> ToolbarCommands =
    [
        EditorCommands[0],
        EditorCommands[1],
        EditorCommands[4],
        EditorCommands[5],
        EditorCommands[6],
        EditorCommands[7],
        EditorCommands[10],
        EditorCommands[8],
        EditorCommands[9],
        EditorCommands[11]
    ];

    private string CurrentUser => AppUserSession.GetCurrentUserName(Environment.UserName).Trim();
    private IEnumerable<ArticleTreeRow> WorkspaceRows => BuildRows(InformesCategorias.EspacioTrabajo, false);
    private IEnumerable<ArticleTreeRow> PrivateRows => BuildRows(InformesCategorias.Privado, false);
    private IEnumerable<ArticleTreeRow> TrashRows => BuildRows(null, true);
    private IEnumerable<ArticleTreeRow> FavoriteRows => BuildFlatRows(_page.Articulos.Where(x => x.EsFavorito && !x.Archivado));
    private IEnumerable<InformesArticuloResumenDto> ParentOptions => _page.Articulos.Where(x => _selected is null || x.IdArticulo != _selected.IdArticulo).Where(x => !x.Archivado);
    private IEnumerable<string> TemplateGroups => _templates.Select(x => x.Grupo).Distinct();
    private InformesPlantillaDto? SelectedTemplate => _templates.FirstOrDefault(x => x.Key == _selectedTemplateKey) ?? _templates.FirstOrDefault();
    private string CoverClass => $"informes-cover informes-cover--{_draft.PortadaTipo.ToLowerInvariant()}";

    protected override async Task OnInitializedAsync()
        => await LoadAsync(GetInitialArticleId());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _editorJs = await JS.InvokeAsync<IJSObjectReference>("import", "/js/tickets-rich-editor.js?v=20260519i");
            _informesEditorJs = await JS.InvokeAsync<IJSObjectReference>("import", "/js/informes-editor.js?v=20260608-editorfix");
        }

        if (_selected is not null && !_editorReady && _editorJs is not null)
        {
            await _editorJs.InvokeVoidAsync("setHtml", _contentEditor, NormalizeEditorHtml(_draft.Contenido));
            if (_informesEditorJs is not null)
            {
                if (!_editorRootWired)
                {
                    await _informesEditorJs.InvokeVoidAsync("wireInformesEditor", _editorRoot);
                    _editorRootWired = true;
                }
                await _informesEditorJs.InvokeVoidAsync("normalizeInformesBlocks", _contentEditor);
            }
            _editorReady = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_informesEditorJs is not null)
        {
            if (_editorRootWired)
                await _informesEditorJs.InvokeVoidAsync("disposeInformesEditor", _editorRoot);
            await _informesEditorJs.DisposeAsync();
        }

        if (_editorJs is not null)
            await _editorJs.DisposeAsync();
    }

    private async Task LoadAsync(long? selectedId = null)
    {
        _loading = true;
        var result = await UiOps.RunAsync(() => InformesSvc.GetPageAsync(CurrentUser, selectedId ?? _selected?.IdArticulo, _search, _showTrash), "No se pudo cargar informes.");
        if (result.Success)
        {
            _page = result.Value ?? new();
            _templates = _page.Plantillas;
            SetSelected(_page.Seleccionado);
            _comments = _page.Comentarios;
            _versions = _page.Versiones;
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }

        _loading = false;
    }

    private void SetSelected(InformesArticuloDetalleDto? article)
    {
        _selected = article;
        if (article is null)
        {
            _draft = new();
            _editorReady = false;
            return;
        }

        _draft = new InformesArticuloSaveRequest
        {
            IdArticulo = article.IdArticulo,
            IdPadre = article.IdPadre,
            Categoria = article.Categoria,
            Titulo = article.Titulo,
            Emoji = article.Emoji,
            Contenido = article.Contenido,
            PortadaTipo = article.PortadaTipo,
            PortadaValor = article.PortadaValor,
            Bloqueado = article.Bloqueado,
            UsuarioAccion = CurrentUser
        };
        _editorReady = false;
    }

    private async Task SelectArticleAsync(long id)
    {
        _feedback = string.Empty;
        await LoadAsync(id);
    }

    private async Task CreateArticleAsync(long? parentId, string category)
    {
        var result = await UiOps.RunAsync(() => InformesSvc.CreateArticleAsync(new InformesArticuloCreateRequest
        {
            IdPadre = parentId,
            Categoria = category,
            UsuarioAccion = CurrentUser
        }), "No se pudo crear el articulo.");

        if (result.Success)
        {
            await LoadAsync(result.Value);
            _feedback = "Articulo creado.";
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }
    }

    private async Task CreateFromTemplateAsync()
    {
        var category = _draft.Categoria;
        var result = await UiOps.RunAsync(() => InformesSvc.CreateArticleAsync(new InformesArticuloCreateRequest
        {
            IdPadre = _selected?.IdPadre,
            Categoria = string.IsNullOrWhiteSpace(category) ? InformesCategorias.EspacioTrabajo : category,
            PlantillaKey = _selectedTemplateKey,
            UsuarioAccion = CurrentUser
        }), "No se pudo crear desde plantilla.");

        _showTemplatePicker = false;
        if (result.Success)
        {
            await LoadAsync(result.Value);
            _feedback = "Plantilla cargada.";
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        await CloseEditorPopupsAsync();
        await SyncContentFromEditorAsync();
        _draft.UsuarioAccion = CurrentUser;
        var result = await UiOps.RunAsync(() => InformesSvc.SaveArticleAsync(_draft), "No se pudo guardar el articulo.");
        if (result.Success)
        {
            await LoadAsync(result.Value);
            _feedback = "Cambios guardados.";
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }

        _saving = false;
    }

    private async Task DeleteAsync()
    {
        if (_selected is null)
            return;

        var result = await UiOps.RunAsync(async () => { await InformesSvc.DeleteArticleAsync(_selected.IdArticulo, CurrentUser); return true; }, "No se pudo enviar a papelera.");
        _feedback = result.Success ? "Articulo enviado a la papelera." : FeedbackText(result.Feedback);
        await LoadAsync();
    }

    private async Task RestoreAsync()
    {
        if (_selected is null)
            return;

        var id = _selected.IdArticulo;
        var result = await UiOps.RunAsync(async () => { await InformesSvc.RestoreArticleAsync(id, CurrentUser); return true; }, "No se pudo restaurar.");
        _feedback = result.Success ? "Articulo restaurado." : FeedbackText(result.Feedback);
        await LoadAsync(id);
    }

    private async Task DuplicateAsync()
    {
        if (_selected is null)
            return;

        var result = await UiOps.RunAsync(() => InformesSvc.DuplicateArticleAsync(_selected.IdArticulo, CurrentUser), "No se pudo duplicar.");
        if (result.Success)
        {
            await LoadAsync(result.Value);
            _feedback = "Articulo duplicado.";
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        if (_selected is null)
            return;

        var value = !_selected.EsFavorito;
        var result = await UiOps.RunAsync(async () => { await InformesSvc.ToggleFavoriteAsync(_selected.IdArticulo, CurrentUser, value); return true; }, "No se pudo actualizar favorito.");
        if (result.Success)
            await LoadAsync(_selected.IdArticulo);
        else
            _feedback = FeedbackText(result.Feedback);
    }

    private async Task ToggleShareAsync()
    {
        if (_selected is null)
            return;

        var value = !_selected.EsCompartido;
        var result = await UiOps.RunAsync(async () => { await InformesSvc.ToggleShareAsync(_selected.IdArticulo, CurrentUser, value); return true; }, "No se pudo compartir.");
        if (result.Success)
        {
            await LoadAsync(_selected.IdArticulo);
            _feedback = value ? "Articulo compartido." : "Articulo privado nuevamente.";
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }
    }

    private async Task AddCommentAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_newComment))
            return;

        var result = await UiOps.RunAsync(async () =>
        {
            await InformesSvc.AddCommentAsync(new InformesComentarioRequest { IdArticulo = _selected.IdArticulo, Texto = _newComment, UsuarioAccion = CurrentUser });
            return true;
        }, "No se pudo comentar.");

        if (result.Success)
        {
            _newComment = string.Empty;
            await LoadAsync(_selected.IdArticulo);
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }
    }

    private async Task ToggleCommentAsync(InformesComentarioDto comment)
    {
        var result = await UiOps.RunAsync(async () => { await InformesSvc.ToggleCommentResolvedAsync(comment.IdComentario, CurrentUser, !comment.Resuelto); return true; }, "No se pudo actualizar comentario.");
        if (result.Success && _selected is not null)
            await LoadAsync(_selected.IdArticulo);
        else if (!result.Success)
            _feedback = FeedbackText(result.Feedback);
    }

    private async Task RestoreVersionAsync(long idVersion)
    {
        if (_selected is null)
            return;

        var result = await UiOps.RunAsync(async () => { await InformesSvc.RestoreVersionAsync(idVersion, CurrentUser); return true; }, "No se pudo restaurar version.");
        if (result.Success)
        {
            await LoadAsync(_selected.IdArticulo);
            _feedback = "Version restaurada.";
        }
        else
        {
            _feedback = FeedbackText(result.Feedback);
        }
    }

    private async Task ToggleTrashAsync()
    {
        _showTrash = !_showTrash;
        await LoadAsync();
    }

    private async Task SearchKeyUpAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await LoadAsync();
    }

    private void FocusSearch()
    {
    }

    private void OpenTemplatePicker()
    {
        _selectedTemplateKey = SelectedTemplate?.Key ?? "agenda";
        _showTemplatePicker = true;
    }

    private void CloseTemplatePicker()
        => _showTemplatePicker = false;

    private void SelectTemplate(string key)
        => _selectedTemplateKey = key;

    private async Task InsertBlockAsync(string command)
        => await RunEditorCommandAsync(EditorCommands.First(x => x.Command == command));

    private void ToggleCommandMenu()
        => _showCommandMenu = !_showCommandMenu;

    private async Task RunEditorCommandAsync(EditorCommandOption option)
    {
        if (_editorJs is null || _selected is null)
            return;

        if (_informesEditorJs is not null && option.Command is not "emoji" and not "link" and not "button")
            await _informesEditorJs.InvokeVoidAsync("closeInformesPopups", _editorRoot);

        await _editorJs.InvokeVoidAsync("runCommand", _contentEditor, option.Command);
        if (_informesEditorJs is not null)
            await _informesEditorJs.InvokeVoidAsync("normalizeInformesBlocks", _contentEditor);
        await SyncContentFromEditorAsync();
        _showCommandMenu = false;
    }

    private async Task SyncContentFromEditorAsync()
    {
        if (_editorJs is null || !_editorReady)
            return;

        _draft.Contenido = await _editorJs.InvokeAsync<string>("getHtml", _contentEditor);
    }

    private async Task OnContentChangedAsync()
    {
        if (_informesEditorJs is not null)
            await _informesEditorJs.InvokeVoidAsync("normalizeInformesBlocks", _contentEditor);
        await SyncContentFromEditorAsync();
        if (_editorJs is not null)
            _showCommandMenu = await _editorJs.InvokeAsync<bool>("shouldShowCommands", _contentEditor);
    }

    private async Task CloseEditorPopupsAsync()
    {
        if (_informesEditorJs is not null)
            await _informesEditorJs.InvokeVoidAsync("closeInformesPopups", _editorRoot);
        _showCommandMenu = false;
    }

    private async Task OnContentFocusAsync()
    {
        if (_editorJs is not null)
            _showCommandMenu = await _editorJs.InvokeAsync<bool>("shouldShowCommands", _contentEditor);
    }

    private void SetCover(string type, string value)
    {
        _draft.PortadaTipo = type;
        _draft.PortadaValor = value;
    }

    private void CycleIcon()
    {
        string[] icons = ["bi-file-earmark-text", "bi-chat-square-text", "bi-heart-fill", "bi-lightbulb", "bi-tools", "bi-rocket-takeoff", "bi-question-circle", "bi-graph-up-arrow"];
        var current = Array.IndexOf(icons, _draft.Emoji);
        _draft.Emoji = icons[(current + 1 + icons.Length) % icons.Length];
    }

    private static string FeedbackText(AppUiMessage? feedback)
    {
        if (feedback is null)
            return "No se pudo completar la operacion.";

        var parts = new[] { feedback.Message, feedback.Suggestion, feedback.HasCode ? $"Codigo: {feedback.Code}" : string.Empty }
            .Where(x => !string.IsNullOrWhiteSpace(x));
        return string.Join(" ", parts);
    }

    private IEnumerable<ArticleTreeRow> BuildRows(string? category, bool archived)
    {
        var source = _page.Articulos
            .Where(x => x.Archivado == archived)
            .Where(x => category is null || x.Categoria == category)
            .ToList();

        return Flatten(source, null, 0);
    }

    private static IEnumerable<ArticleTreeRow> BuildFlatRows(IEnumerable<InformesArticuloResumenDto> articles)
        => articles.OrderBy(x => x.Titulo).Select(x => new ArticleTreeRow(x, 0));

    private static IEnumerable<ArticleTreeRow> Flatten(List<InformesArticuloResumenDto> source, long? parentId, int level)
    {
        foreach (var item in source.Where(x => x.IdPadre == parentId).OrderBy(x => x.Orden).ThenBy(x => x.Titulo))
        {
            yield return new ArticleTreeRow(item, level);
            foreach (var child in Flatten(source, item.IdArticulo, level + 1))
                yield return child;
        }

        if (parentId is null)
        {
            foreach (var orphan in source.Where(x => x.IdPadre is not null && source.All(p => p.IdArticulo != x.IdPadre)).OrderBy(x => x.Titulo))
                yield return new ArticleTreeRow(orphan, 0);
        }
    }

    private RenderFragment ArticleButton(ArticleTreeRow row) => @<div class="informes-tree-row" style="@($"--level:{row.Level}")">
        <button type="button" class="@(row.Item.IdArticulo == _selected?.IdArticulo ? "is-selected" : "")" @onclick="() => SelectArticleAsync(row.Item.IdArticulo)">
            <i class="bi @IconClass(row.Item.Emoji)"></i>
            <span>@row.Item.Titulo</span>
            @if (row.Item.Bloqueado)
            {
                <i class="bi bi-lock-fill"></i>
            }
        </button>
        @if (!row.Item.Archivado)
        {
            <button type="button" class="informes-tree-row__add" title="Crear subarticulo" @onclick="() => CreateArticleAsync(row.Item.IdArticulo, row.Item.Categoria)">
                <i class="bi bi-plus-lg"></i>
            </button>
        }
    </div>;

    private static string IconClass(string? value)
        => string.IsNullOrWhiteSpace(value) ? "bi-file-earmark-text" : value.Trim();

    private string BuildShareUrl(Guid token)
        => Nav.ToAbsoluteUri($"/informes?articulo={_selected?.IdArticulo}&share={token}").ToString();

    private long? GetInitialArticleId()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("articulo", out var value)
            && long.TryParse(value.ToString(), out var id)
            && id > 0)
        {
            return id;
        }

        return null;
    }

    private static string NormalizeEditorHtml(string? content)
    {
        var value = content?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(value))
            return "<p><br></p>";

        return value.Contains('<', StringComparison.Ordinal) ? value : RenderArticleHtml(value);
    }

    private static string RenderArticleHtml(string? content)
    {
        var lines = (content ?? string.Empty).Replace("\r\n", "\n").Split('\n');
        var html = new StringBuilder();
        var inList = false;
        var inQuote = false;

        void CloseBlocks()
        {
            if (inList)
            {
                html.Append("</ul>");
                inList = false;
            }
            if (inQuote)
            {
                html.Append("</blockquote>");
                inQuote = false;
            }
        }

        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd();
            var trimmed = line.Trim();
            if (string.IsNullOrWhiteSpace(trimmed))
            {
                CloseBlocks();
                continue;
            }

            if (trimmed.StartsWith("## ", StringComparison.Ordinal))
            {
                CloseBlocks();
                html.Append("<h2>").Append(WebUtility.HtmlEncode(trimmed[3..])).Append("</h2>");
            }
            else if (trimmed.StartsWith("# ", StringComparison.Ordinal))
            {
                CloseBlocks();
                html.Append("<h1>").Append(WebUtility.HtmlEncode(trimmed[2..])).Append("</h1>");
            }
            else if (trimmed.StartsWith("> ", StringComparison.Ordinal))
            {
                if (!inQuote)
                {
                    CloseBlocks();
                    html.Append("<blockquote>");
                    inQuote = true;
                }
                html.Append("<p>").Append(WebUtility.HtmlEncode(trimmed[2..])).Append("</p>");
            }
            else if (trimmed.StartsWith("- [ ] ", StringComparison.Ordinal) || trimmed.StartsWith("- [x] ", StringComparison.OrdinalIgnoreCase))
            {
                if (!inList)
                {
                    CloseBlocks();
                    html.Append("<ul class=\"ticket-editor-todo\">");
                    inList = true;
                }
                var checkedAttr = trimmed.StartsWith("- [x] ", StringComparison.OrdinalIgnoreCase) ? " checked" : string.Empty;
                html.Append("<li><input type=\"checkbox\"").Append(checkedAttr).Append("> ")
                    .Append(WebUtility.HtmlEncode(trimmed[6..])).Append("</li>");
            }
            else if (trimmed.StartsWith("- ", StringComparison.Ordinal))
            {
                if (!inList)
                {
                    CloseBlocks();
                    html.Append("<ul>");
                    inList = true;
                }
                html.Append("<li>").Append(WebUtility.HtmlEncode(trimmed[2..])).Append("</li>");
            }
            else if (trimmed.StartsWith("|", StringComparison.Ordinal) && trimmed.EndsWith("|", StringComparison.Ordinal))
            {
                CloseBlocks();
                var cells = trimmed.Trim('|').Split('|').Select(x => WebUtility.HtmlEncode(x.Trim())).ToArray();
                if (cells.All(x => Regex.IsMatch(WebUtility.HtmlDecode(x) ?? string.Empty, @"^-+$")))
                    continue;

                html.Append("<div class=\"table-row\">");
                foreach (var cell in cells)
                    html.Append("<span>").Append(cell).Append("</span>");
                html.Append("</div>");
            }
            else
            {
                CloseBlocks();
                html.Append("<p>").Append(WebUtility.HtmlEncode(trimmed)).Append("</p>");
            }
        }

        CloseBlocks();
        return html.ToString();
    }

    private sealed record ArticleTreeRow(InformesArticuloResumenDto Item, int Level);
    private sealed record EditorCommandOption(string Group, string Title, string Description, string Icon, string Command);
}
