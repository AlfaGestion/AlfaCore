@page "/compras/reportes"
@page "/{idweb}/{idbase:int}/compras/reportes"
@inject AlfaCore.Services.IReporteComprasService ReporteService
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Reportes de Compras | Alfa Gestión</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Reportes de Compras</h2>
            <p>Generador de informes y estadísticas del módulo de compras.</p>
        </div>
    </header>

    <AlfaTabs Items="TiposReporte" ActiveKey="@_tipoReporte.ToString()" ActiveKeyChanged="OnTipoReporteChanged" AriaLabel="Tipo de reporte" />

    @if (_tipoReporte == TipoReporteCompras.CuentaCorriente)
    {
        <p class="gd-hint">Para Cuenta Corriente conviene filtrar por proveedor (buscador de arriba). Sin filtro se devuelven todos los asientos contables del período.</p>
    }

    @* ── Estado inicial / carga / error ─────────────────────────────── *@
    @if (_isLoading)
    {
        <AlfaEmptyState Title="Generando reporte" Message="Buscando datos del período." />
    }
    else if (_error is not null)
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="@_error.Message" Message="@ErrorDetalle(_error)" />
    }
    else if (!_mostrarResultados)
    {
        <AlfaEmptyState Title="@($"{TipoReporteLabel(_tipoReporte)} — {GestionRangosFecha.Etiqueta(_filtros.FechaDesde, _filtros.FechaHasta)}")"
                        Message="Ajustá período, proveedor o tipo de comprobante en el buscador de arriba y generá el reporte."
                        ActionLabel="Generar reporte"
                        ActionIcon="bi bi-play-fill"
                        OnAction="_ => GenerarAsync()" />
    }

    @* ── Resultados: Resumen de Compras ─────────────────────────────── *@
    @if (_mostrarResultados && _tipoReporte == TipoReporteCompras.ResumenDeCompras && _resumen is not null)
    {
        <div class="kpi-grid">
            <KpiCard Titulo="Total comprado"  Valor="@Moneda(_resumen.TotalComprado)"               Icono="$" />
            <KpiCard Titulo="Neto"            Valor="@Moneda(_resumen.NetoTotal)"                   Icono="N" />
            <KpiCard Titulo="IVA"             Valor="@Moneda(_resumen.IvaTotal)"                    Icono="%" />
            <KpiCard Titulo="Comprobantes"    Valor="@_resumen.CantidadComprobantes.ToString("N0")" Icono="C" />
            <KpiCard Titulo="Proveedores"     Valor="@_resumen.CantidadProveedores.ToString("N0")"  Icono="P" />
        </div>

        <DataTable Titulo="Resumen por proveedor"
                   Subtitulo="@($"{_resumen.Filas.Count} proveedores en el período")">
            <Header>
                <tr>
                    <th>Cuenta</th>
                    <th>Proveedor</th>
                    <th style="text-align:right;">Comprobantes</th>
                    <th style="text-align:right;">Neto</th>
                    <th style="text-align:right;">IVA</th>
                    <th style="text-align:right;">Total</th>
                    <th style="text-align:right;">% Part.</th>
                </tr>
            </Header>
            <Rows>
                @if (_resumen.Filas.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin comprobantes en el período" Message="Ampliá el rango de fechas o revisá los filtros aplicados." />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var fila in _resumen.Filas)
                    {
                        <tr>
                            <td>@fila.Cuenta</td>
                            <td><strong>@fila.RazonSocial</strong></td>
                            <td style="text-align:right;">@fila.CantidadComprobantes.ToString("N0")</td>
                            <td style="text-align:right;">@Moneda(fila.Neto)</td>
                            <td style="text-align:right;">@Moneda(fila.Iva)</td>
                            <td style="text-align:right;"><strong>@Moneda(fila.Total)</strong></td>
                            <td style="text-align:right;">@fila.Participacion.ToString("P1", Cultura)</td>
                        </tr>
                    }
                    <tr class="data-table__totals">
                        <td colspan="3" class="gd-totals-label">Total página</td>
                        <td style="text-align:right;">@Moneda(_resumen.NetoTotal)</td>
                        <td style="text-align:right;">@Moneda(_resumen.IvaTotal)</td>
                        <td style="text-align:right;">@Moneda(_resumen.TotalComprado)</td>
                        <td></td>
                    </tr>
                }
            </Rows>
        </DataTable>
    }

    @* ── Resultados: Detalle de Compras ─────────────────────────────── *@
    @if (_mostrarResultados && _tipoReporte == TipoReporteCompras.DetalleDeCompras && _detalleCompras is not null)
    {
        <DataTable Titulo="Detalle de comprobantes"
                   Subtitulo="@GetSubtituloDetalle()">
            <Header>
                <tr>
                    <th>Fecha</th>
                    <th>TC</th>
                    <th>Comprobante</th>
                    <th>Cuenta</th>
                    <th>Proveedor</th>
                    <th>Motivo</th>
                    <th style="text-align:right;">Neto</th>
                    <th style="text-align:right;">IVA</th>
                    <th style="text-align:right;">Total</th>
                    <th>Usuario</th>
                    <th></th>
                </tr>
            </Header>
            <Rows>
                @if (_detalleCompras.Items.Count == 0)
                {
                    <tr>
                        <td colspan="11">
                            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin comprobantes en el período" Message="Ampliá el rango de fechas o revisá los filtros aplicados." />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in _detalleCompras.Items)
                    {
                        <tr>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.Tc</td>
                            <td>@item.IdComprobante</td>
                            <td>@item.Cuenta</td>
                            <td><strong>@item.RazonSocial</strong></td>
                            <td>@item.DescMotivo</td>
                            <td style="text-align:right;">@Moneda(item.Neto)</td>
                            <td style="text-align:right;">@Moneda(item.Iva)</td>
                            <td style="text-align:right;"><strong>@Moneda(item.Total)</strong></td>
                            <td>@item.Usuario</td>
                            <td>
                                <a class="adm-link-button" href="@BuildViewerUrl(item.Tc, item.IdComprobante)" title="Ver detalle del comprobante" aria-label="Ver detalle del comprobante">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    <tr class="data-table__totals">
                        <td colspan="6" class="gd-totals-label">
                            Total página (@_detalleCompras.Items.Count comprobantes)
                        </td>
                        <td style="text-align:right;">@Moneda(TotalNetoDetalle)</td>
                        <td style="text-align:right;">@Moneda(TotalIvaDetalle)</td>
                        <td style="text-align:right;">@Moneda(TotalTotalDetalle)</td>
                        <td colspan="2"></td>
                    </tr>
                }
            </Rows>
        </DataTable>
    }

    @* ── Resultados: Cuenta Corriente ──────────────────────────────── *@
    @if (_mostrarResultados && _tipoReporte == TipoReporteCompras.CuentaCorriente && _cuentaCorriente is not null)
    {
        <div class="kpi-grid">
            <KpiCard Titulo="Saldo total"
                     Valor="@Moneda(_cuentaCorriente.SaldoTotal)"
                     Descripcion="@(_cuentaCorriente.SaldoTotal >= 0 ? "A pagar al proveedor" : "A favor del cliente")"
                     Icono="=" />
            <KpiCard Titulo="Movimientos"
                     Valor="@_cuentaCorriente.TotalRegistros.ToString("N0")"
                     Icono="M" />
        </div>

        <DataTable Titulo="Cuenta corriente de proveedores"
                   Subtitulo="@GetSubtituloCC()">
            <Header>
                <tr>
                    <th>Cuenta</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>TC</th>
                    <th>Comprobante</th>
                    <th style="text-align:center;">D/H</th>
                    <th style="text-align:right;">Importe</th>
                    <th style="text-align:right;">Signado</th>
                </tr>
            </Header>
            <Rows>
                @if (_cuentaCorriente.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8">
                            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin movimientos en el período" Message="Para Cuenta Corriente filtrá por proveedor para ver sus movimientos en MV_ASIENTOS." />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in _cuentaCorriente.Items)
                    {
                        <tr>
                            <td>@item.Cuenta</td>
                            <td><strong>@item.RazonSocial</strong></td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.Tc</td>
                            <td>@item.IdComprobante</td>
                            <td style="text-align:center;">
                                <span class="badge-state @(item.DebeHaber == "H" ? "badge-state--danger" : "badge-state--ok")">
                                    @item.DebeHaber
                                </span>
                            </td>
                            <td style="text-align:right;">@Moneda(item.Importe)</td>
                            <td style="text-align:right;" class="@(item.ImporteSignado < 0 ? "balance-pos" : string.Empty)">
                                <strong>@Moneda(item.ImporteSignado)</strong>
                            </td>
                        </tr>
                    }
                }
            </Rows>
        </DataTable>
    }

</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private readonly FiltrosReporteCompras _filtros = new();
    private ReporteComprasOptionsDto _options = new();
    private TipoReporteCompras _tipoReporte = TipoReporteCompras.ResumenDeCompras;
    private bool _panelAbierto;

    private ResumenComprasDto?        _resumen;
    private DetalleComprasResultDto?  _detalleCompras;
    private CuentaCorrienteResultDto? _cuentaCorriente;

    private AppUiMessage? _error;
    private bool _isLoading;
    private bool _mostrarResultados;

    private static readonly System.Globalization.CultureInfo Cultura =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    // Totales de la página actual del detalle
    private decimal TotalNetoDetalle  => _detalleCompras?.Items.Sum(x => x.Neto)  ?? 0;
    private decimal TotalIvaDetalle   => _detalleCompras?.Items.Sum(x => x.Iva)   ?? 0;
    private decimal TotalTotalDetalle => _detalleCompras?.Items.Sum(x => x.Total) ?? 0;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private static readonly IReadOnlyList<AlfaTabItem> TiposReporte =
    [
        new(nameof(TipoReporteCompras.ResumenDeCompras), "Resumen de compras"),
        new(nameof(TipoReporteCompras.DetalleDeCompras), "Detalle de compras"),
        new(nameof(TipoReporteCompras.CuentaCorriente), "Cuenta corriente")
    ];

    private static string TipoReporteLabel(TipoReporteCompras tipo) => tipo switch
    {
        TipoReporteCompras.DetalleDeCompras => "Detalle de compras",
        TipoReporteCompras.CuentaCorriente => "Cuenta corriente",
        _ => "Resumen de compras"
    };

    private void OnTipoReporteChanged(string? key)
    {
        if (!Enum.TryParse<TipoReporteCompras>(key, out var tipo) || tipo == _tipoReporte)
            return;

        // Cada tipo tiene su propio resultado: al cambiar de pestaña se vuelve al estado inicial.
        _tipoReporte = tipo;
        _mostrarResultados = false;
        _error = null;
        UpdatePageHeader();
    }

    private int TotalPaginasActual => _tipoReporte switch
    {
        TipoReporteCompras.DetalleDeCompras => _detalleCompras?.TotalPaginas ?? 0,
        TipoReporteCompras.CuentaCorriente => _cuentaCorriente?.TotalPaginas ?? 0,
        _ => 0
    };

    // Excel existe para Resumen y Detalle (Cuenta corriente no tiene exportación).
    private bool PuedeExportarExcel => _mostrarResultados && _tipoReporte != TipoReporteCompras.CuentaCorriente;

    // Las acciones y la paginación corren desde el Context Toolbar (otro componente):
    // InvokeAsync + StateHasChanged para que esta página se vuelva a dibujar.
    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "compras",
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCompras(RouteContext, Nav, "reportes"),
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        Actions =
        [
            new PageHeaderAction { Key = "generar", Label = _isLoading ? "Generando..." : "Generar reporte", Icon = "bi-play-fill", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _isLoading, OnClick = () => InvokeAsync(async () => { await GenerarAsync(); StateHasChanged(); }) },
            new PageHeaderAction { Key = "excel", Label = "Excel", Icon = "bi-file-earmark-excel", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = !PuedeExportarExcel, OnClick = () => InvokeAsync(() => Nav.NavigateTo(GetExcelUrl(_tipoReporte == TipoReporteCompras.DetalleDeCompras ? "detalle" : "resumen"), forceLoad: true)) },
            new PageHeaderAction { Key = "pdf", Label = "PDF", Icon = "bi-printer", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = !_mostrarResultados, OnClick = () => InvokeAsync(ImprimirPdfAsync) }
        ],
        Pagination = !_mostrarResultados || TotalPaginasActual <= 1 ? null : new PageHeaderPaginationConfig
        {
            PageLabel = $"{_filtros.Pagina} / {TotalPaginasActual}",
            HasPrevious = _filtros.Pagina > 1,
            HasNext = _filtros.Pagina < TotalPaginasActual,
            Disabled = _isLoading,
            OnPrevious = () => InvokeAsync(async () => { await PaginaAnteriorAsync(); StateHasChanged(); }),
            OnNext = () => InvokeAsync(async () => { await PaginaSiguienteAsync(); StateHasChanged(); })
        }
    });

    // ── Smart Search (Context Toolbar) ────────────────────────────────────────────
    // El fragmento se dibuja en el toolbar pero su estado vive acá: cada cambio vuelve a
    // publicar el header (mismo patrón que Contactos y Administrar → Clientes).
    private RenderFragment RenderSmartSearch() => @<div class="smart-search" @onclick:stopPropagation>
        @{ var chips = BuildFilterChips(); }
        <div class="smart-search__bar @(_panelAbierto ? "is-open" : string.Empty)">
            <span class="smart-search__search-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
            <button type="button" class="smart-search__filter-button @(_panelAbierto || chips.Count > 1 ? "is-active" : string.Empty)" title="Abrir filtros" aria-label="Abrir filtros" aria-expanded="@_panelAbierto" @onclick="TogglePanel">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
            </button>
            <div class="smart-search__active-filters" aria-label="Filtros activos">
                @foreach (var chip in chips.Take(2))
                {
                    <button type="button" class="smart-search__active-filter" title="@chip.Label" aria-label="@chip.Label" @onclick="() => RemoveChip(chip.Key)">
                        <span>@chip.Label</span>
                        @if (chip.Key != "periodo")
                        {
                            <span class="smart-search__active-filter-remove" aria-hidden="true"><i class="bi bi-x"></i></span>
                        }
                    </button>
                }
                @if (chips.Count > 2)
                {
                    <span class="smart-search__more-filters" title="@string.Join(", ", chips.Skip(2).Select(c => c.Label))">+@(chips.Count - 2)</span>
                }
            </div>
            <input type="search" placeholder="Buscar por proveedor o cuenta..." value="@_filtros.Proveedor" @oninput="OnProveedorInput" @onkeydown="HandleSearchKeyDownAsync" />
            <button type="button" class="smart-search__toggle" @onclick="TogglePanel" aria-label="Mostrar filtros" aria-expanded="@_panelAbierto">
                <i class="bi @(_panelAbierto ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_panelAbierto)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="ClosePanel"></button>
            <div class="smart-search__panel smart-search__panel--compact" @onclick:stopPropagation @onkeydown="HandleSearchKeyDownAsync">
                <div class="smart-search__column">
                    <h4><i class="bi bi-calendar-range"></i> Período</h4>
                    @{ var rangoActivo = GestionRangosFecha.Detectar(_filtros.FechaDesde, _filtros.FechaHasta); }
                    @foreach (var rango in GestionRangosFecha.Todos.Where(r => r.Key != "todo"))
                    {
                        <button type="button" class="@(rangoActivo == rango.Key ? "smart-option is-active" : "smart-option")" @onclick="() => SetRango(rango.Key)">@rango.Label</button>
                    }
                    <div class="smart-search__inline">
                        <label>Desde</label>
                        <input type="date" value="@(_filtros.FechaDesde?.ToString("yyyy-MM-dd"))" @onchange="e => SetFecha(e, desde: true)" />
                    </div>
                    <div class="smart-search__inline">
                        <label>Hasta</label>
                        <input type="date" value="@(_filtros.FechaHasta?.ToString("yyyy-MM-dd"))" @onchange="e => SetFecha(e, desde: false)" />
                    </div>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-receipt"></i> Comprobante</h4>
                    <div class="smart-search__inline">
                        <label>Tipo (TC)</label>
                        <select value="@(_filtros.TipoComprobante ?? string.Empty)" @onchange="OnTcChanged">
                            <option value="">Todos</option>
                            @foreach (var tc in _options.TiposComprobante)
                            {
                                <option value="@tc">@tc</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="smart-search__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-eraser" OnClick="_ => LimpiarAsync()">Limpiar</AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-play-fill" OnClick="_ => GenerarDesdePanelAsync()">Generar reporte</AlfaButton>
                </div>
            </div>
        }
    </div>;

    private void OnProveedorInput(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString();
        _filtros.Proveedor = string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
        UpdatePageHeader();
    }

    private void OnTcChanged(ChangeEventArgs e)
    {
        var tc = e.Value?.ToString();
        _filtros.TipoComprobante = string.IsNullOrWhiteSpace(tc) ? null : tc;
        UpdatePageHeader();
    }

    private void SetFecha(ChangeEventArgs e, bool desde)
    {
        DateTime? valor = DateTime.TryParse(e.Value?.ToString(), out var fecha) ? fecha : null;
        if (desde) _filtros.FechaDesde = valor; else _filtros.FechaHasta = valor;
        UpdatePageHeader();
    }

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await GenerarDesdePanelAsync();
        else if (e.Key == "Escape")
            ClosePanel();
    }

    private async Task GenerarDesdePanelAsync()
    {
        _panelAbierto = false;
        await GenerarAsync();
    }

    private void TogglePanel()
    {
        _panelAbierto = !_panelAbierto;
        UpdatePageHeader();
    }

    private void ClosePanel()
    {
        _panelAbierto = false;
        UpdatePageHeader();
    }

    private static string ErrorDetalle(AppUiMessage error)
        => string.Join(" ", new[] { error.HasSuggestion ? error.Suggestion : null, error.HasCode ? $"Código: {error.Code}." : null }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override async Task OnInitializedAsync()
    {
        var result = await UiOps.RunAsync(
            () => ReporteService.GetOptionsAsync(),
            "No se pudieron cargar las opciones del reporte.");
        if (result.Success && result.Value is not null)
            _options = result.Value;
        UpdatePageHeader();
    }

    private async Task GenerarAsync()
    {
        // Generar desde cero siempre arranca en la página 1; la paginación llama a CargarAsync.
        _filtros.Pagina = 1;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _isLoading = true;
        _error = null;
        _mostrarResultados = false;
        UpdatePageHeader();

        try
        {
            switch (_tipoReporte)
            {
                case TipoReporteCompras.ResumenDeCompras:
                    _resumen = await ReporteService.GetResumenAsync(_filtros);
                    break;
                case TipoReporteCompras.DetalleDeCompras:
                    _detalleCompras = await ReporteService.GetDetalleComprasAsync(_filtros);
                    break;
                case TipoReporteCompras.CuentaCorriente:
                    _cuentaCorriente = await ReporteService.GetCuentaCorrienteAsync(_filtros);
                    break;
            }
            _mostrarResultados = true;
        }
        catch (Exception ex)
        {
            _error = UiOps.BuildMessage(ex, "No se pudo generar el reporte.");
        }
        finally
        {
            _isLoading = false;
            UpdatePageHeader();
        }
    }

    private async Task PaginaAnteriorAsync()
    {
        if (_filtros.Pagina <= 1) return;
        _filtros.Pagina--;
        await CargarAsync();
    }

    private async Task PaginaSiguienteAsync()
    {
        if (_filtros.Pagina >= TotalPaginasActual) return;
        _filtros.Pagina++;
        await CargarAsync();
    }

    private Task LimpiarAsync()
    {
        (_filtros.FechaDesde, _filtros.FechaHasta) = GestionRangosFecha.Calcular("mes");
        _filtros.Proveedor       = null;
        _filtros.TipoComprobante = null;
        _filtros.Pagina          = 1;
        _resumen         = null;
        _detalleCompras  = null;
        _cuentaCorriente = null;
        _mostrarResultados = false;
        _error = null;
        _panelAbierto = false;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private void SetRango(string key)
    {
        (_filtros.FechaDesde, _filtros.FechaHasta) = GestionRangosFecha.Calcular(key);
        UpdatePageHeader();
    }

    private sealed record FilterChip(string Key, string Label);

    private List<FilterChip> BuildFilterChips()
    {
        var chips = new List<FilterChip> { new("periodo", GestionRangosFecha.Etiqueta(_filtros.FechaDesde, _filtros.FechaHasta)) };
        if (!string.IsNullOrWhiteSpace(_filtros.TipoComprobante))
            chips.Add(new("tc", $"TC: {_filtros.TipoComprobante}"));
        if (!string.IsNullOrWhiteSpace(_filtros.Proveedor))
            chips.Add(new("proveedor", $"Proveedor: {_filtros.Proveedor}"));
        return chips;
    }

    private void RemoveChip(string key)
    {
        switch (key)
        {
            case "periodo": _panelAbierto = true; break;
            case "tc": _filtros.TipoComprobante = null; break;
            case "proveedor": _filtros.Proveedor = null; break;
        }
        UpdatePageHeader();
    }

    private async Task ImprimirPdfAsync()
    {
        await Js.InvokeVoidAsync("dashboardExport.printCurrentPage", "Reporte de Compras");
    }

    private string GetExcelUrl(string tipo)
    {
        var parts = new System.Collections.Generic.List<string> { $"tipo={tipo}" };
        if (_filtros.FechaDesde.HasValue)
            parts.Add($"fechaDesde={_filtros.FechaDesde.Value:yyyy-MM-dd}");
        if (_filtros.FechaHasta.HasValue)
            parts.Add($"fechaHasta={_filtros.FechaHasta.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(_filtros.Proveedor))
            parts.Add($"proveedor={Uri.EscapeDataString(_filtros.Proveedor)}");
        if (!string.IsNullOrWhiteSpace(_filtros.TipoComprobante))
            parts.Add($"tc={Uri.EscapeDataString(_filtros.TipoComprobante)}");
        return $"/compras/reportes/descargar-excel?{string.Join("&", parts)}";
    }

    private static string BuildViewerUrl(string tc, string idComprobante) =>
        $"/comprobantes/viewer/{Uri.EscapeDataString(tc)}/{Uri.EscapeDataString(idComprobante)}?returnUrl={Uri.EscapeDataString("/compras/reportes")}";

    private string GetSubtituloDetalle() =>
        _detalleCompras is null ? string.Empty
            : $"{_detalleCompras.TotalRegistros} comprobantes — página {_filtros.Pagina} de {_detalleCompras.TotalPaginas}";

    private string GetSubtituloCC() =>
        _cuentaCorriente is null ? string.Empty
            : $"{_cuentaCorriente.TotalRegistros} movimientos — saldo: {Moneda(_cuentaCorriente.SaldoTotal)}";

    private static string Moneda(decimal v) =>
        v.ToString("$ #,##0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
