@page "/portal-cliente"
@page "/{idweb}/{idbase:int}/portal-cliente"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@inject AlfaCore.Services.IPortalClienteService PortalClienteSvc

<PageTitle>Portal Cliente | AlfaCore</PageTitle>

@if (NotFound)
{
    <section class="page-grid portal-cliente">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver al inicio" />
}
else
{
    <section class="page-grid portal-cliente portal-cliente--home">
        <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                              BrandName="@GetBrandingName()"
                              LogoFrameClass="@GetBrandingLogoFrameClass()"
                              ClientLabel="@GetCurrentClientLabel()"
                              Busy="@SessionBusy"
                              OnLogout="LogoutClienteAsync"
                              ActiveTab="inicio"
                              RouteInicio="@BuildPortalRoute("")"
                              RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                              RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                              RouteCatalogos="@BuildPortalRoute("catalogos")"
                              RouteCarrito="@BuildPortalRoute("carrito")"
                              RoutePedidos="@BuildPortalRoute("pedidos")"
                              RouteMiCuenta="@BuildPortalRoute("mi-cuenta")" />

        <section class="portal-cliente__cards">
            <a class="portal-cliente__card" href="@BuildPortalRoute("cuenta-corriente")" aria-label="Abrir Cuenta corriente">
                <span class="portal-cliente__card-icon"><i class="bi bi-cash-stack"></i></span>
                <span>Cuenta corriente</span>
                @if (_resumenCuentaCorriente is not null)
                {
                    <small class="portal-cliente__card__hint">
                        Saldo pendiente @MoneyResumen(_resumenCuentaCorriente.SaldoTotal)
                        @if (_resumenCuentaCorriente.CantidadPendientes > 0)
                        {
                            <text> · @_resumenCuentaCorriente.CantidadPendientes comprobante(s) pendiente(s)</text>
                        }
                    </small>
                }
            </a>
            <a class="portal-cliente__card" href="@BuildPortalRoute("lista-precios")" aria-label="Abrir Lista de precios">
                <span class="portal-cliente__card-icon"><i class="bi bi-tags"></i></span>
                <span>Lista de precios</span>
                <small class="portal-cliente__card__hint">Consultá tus precios actuales</small>
            </a>
            <a class="portal-cliente__card" href="@BuildPortalRoute("catalogos")" aria-label="Abrir Catálogos">
                <span class="portal-cliente__card-icon"><i class="bi bi-book"></i></span>
                <span>Catálogos</span>
            </a>
            <a class="portal-cliente__card" href="@BuildPortalRoute("carrito")" aria-label="Abrir Carrito de compra">
                <span class="portal-cliente__card-icon"><i class="bi bi-cart3"></i></span>
                <span>Carrito de compra</span>
            </a>
            <a class="portal-cliente__card" href="@BuildPortalRoute("pedidos")" aria-label="Abrir Pedidos">
                <span class="portal-cliente__card-icon"><i class="bi bi-receipt"></i></span>
                <span>Pedidos</span>
            </a>
            <a class="portal-cliente__card" href="@BuildPortalRoute("mi-cuenta")" aria-label="Abrir Mi cuenta">
                <span class="portal-cliente__card-icon"><i class="bi bi-person-circle"></i></span>
                <span>Mi cuenta</span>
            </a>
        </section>

        <section class="panel-card">
            <div class="panel-card__header portal-cliente__recent-header">
                <h3 class="panel-card__title">Pedidos recientes</h3>
                <a class="btn btn--ghost btn--sm" href="@BuildPortalRoute("pedidos")">
                    Ver todos <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (_loadingPedidos)
            {
                <p class="text-muted">Cargando pedidos...</p>
            }
            else if (_pedidosRecientes.Count == 0)
            {
                <div class="empty-state">
                    <p>Todavía no tenés pedidos registrados.</p>
                </div>
            }
            else
            {
                <div class="portal-cliente__pedidos-list">
                    @foreach (var pedido in _pedidosRecientes)
                    {
                        <PortalClientePedidoRow Pedido="pedido" DetalleUrl="@BuildPortalRoute($"pedidos/{pedido.IdComprobante}")" />
                    }
                </div>

            }
        </section>
    </section>
}

@code {
    private CatalogoClienteLoginPanel? _loginPanel;
    private bool _loadingPedidos;
    private IReadOnlyList<PortalClientePedidoResumenDto> _pedidosRecientes = [];
    private PortalClienteCuentaCorrienteResumenDto? _resumenCuentaCorriente;

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            await LoadPedidosRecientesAsync();
            await LoadResumenCuentaCorrienteAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
    {
        await LoadPedidosRecientesAsync();
        await LoadResumenCuentaCorrienteAsync();
    }

    private async Task LoadPedidosRecientesAsync()
    {
        _loadingPedidos = true;
        try
        {
            var result = await UiOps.RunAsync(() => PortalClienteSvc.GetPedidosClienteAsync(new PortalClientePedidosFiltroDto
            {
                CodigoCliente = GetCurrentCodigoCliente(),
                PageNumber = 1,
                PageSize = 5
            }), "No se pudieron cargar los pedidos recientes.");

            _pedidosRecientes = result.Success && result.Value is not null
                ? result.Value.Items
                : [];
        }
        finally
        {
            _loadingPedidos = false;
        }
    }

    private async Task LoadResumenCuentaCorrienteAsync()
    {
        var result = await UiOps.RunAsync(() => PortalClienteSvc.GetResumenCuentaCorrienteAsync(GetCurrentCodigoCliente()),
            "No se pudo cargar el resumen de cuenta corriente.");

        _resumenCuentaCorriente = result.Success ? result.Value : null;
    }

    private static string MoneyResumen(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
