@page "/admin/servidor"
@page "/{idweb}/{idbase:int}/admin/servidor"
@layout AlfaCore.Components.Layout.MainLayout
@using AlfaCore.Services
@implements IDisposable
@inject LectoresServidorService Lectores
@inject ArcaServidorService ArcaServidor
@inject IAppUserSessionService Usuario
@inject IAppUiOperationService UiOps
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav

<PageTitle>Servidor | AlfaCore</PageTitle>
<div class="gd-page gd gd-legacy">
    <AlfaFeedbackPanel Message="@_feedback" />
    @if(!EsAdministrador)
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="Acceso restringido" Message="Solo un superadministrador puede configurar esta instalación." />
    }
    else
    {
        <section class="panel-card">
            <h2>Lectores documentales del servidor</h2>
            <p>Se configura una vez en esta instalación de AlfaCore y se aplica a todas sus bases. No modifica appsettings.json ni .env.</p>
            <AlfaInput Label="Ejecutable Python" Value="@_python" ValueChanged="v=>_python=v??string.Empty" Placeholder="C:\Python314\python.exe" HelpText="Ruta completa en el servidor donde corre AlfaCore, accesible para su servicio." Disabled="_busy" />
            <AlfaInput Label="Script de recepción documental (opcional)" Value="@_script" ValueChanged="v=>_script=v??string.Empty" Placeholder="C:\dev\IA_ProcesarDocumentos\lector_facturas_to_json_v5.py" HelpText="Vacío conserva la configuración anterior de cada base. Los lectores de bancos y tarjetas vienen incluidos en AlfaCore." Disabled="_busy" />
            <AlfaInput Label="Carpeta de trabajo de recepción documental (opcional)" Value="@_carpeta" ValueChanged="v=>_carpeta=v??string.Empty" Disabled="_busy" />
            <p>La ruta común tiene prioridad sobre la configuración anterior de Recepción documental. Una ruta propia de TARJETAS-PYTHON sigue siendo una excepción explícita para esa base.</p>
            <p>Probar verifica Python y pypdf con la misma identidad que ejecuta AlfaCore. No importa documentos ni modifica contabilidad.</p>
        </section>
        <section class="panel-card">
            <h2>Descarga de Mis Comprobantes (ARCA)</h2>
            <p>El script viene incluido en AlfaCore (App_Data\scripts\arca\arca_comprobantes.py) y es independiente del Alfa Gestión. Los clientes solo cargan su CUIT y clave fiscal; esto lo define únicamente ALFA NET. Vacío usa lo incluido.</p>
            <AlfaInput Label="Python con playwright y pywin32 (opcional)" Value="@_aPython" ValueChanged="v=>_aPython=v??string.Empty" Placeholder="App_Data\scripts\arca\python\python.exe" HelpText="Vacío usa el Python portable o el venv creado por el instalador junto al script. El script usa Excel instalado en este servidor." Disabled="_busy" />
            <AlfaInput Label="Script alternativo (opcional)" Value="@_aScript" ValueChanged="v=>_aScript=v??string.Empty" Placeholder="App_Data\scripts\arca\arca_comprobantes.py" Disabled="_busy" />
            <AlfaInput Label="Carpeta raíz de descargas (opcional)" Value="@_aCarpeta" ValueChanged="v=>_aCarpeta=v??string.Empty" HelpText="Cada base baja en su propia subcarpeta (base-N). Por defecto, App_Data\arca_descargas." Disabled="_busy" />
            <AlfaInput Label="Meses de descargas que se conservan" Type="number" Value="@_aMeses" ValueChanged="v=>_aMeses=v??string.Empty" HelpText="Por base. Se borran los archivos de períodos más viejos al terminar cada descarga. 0 = no borrar nunca." Disabled="_busy" />
            <AlfaInput Label="Días que se conservan capturas y archivos de diagnóstico" Type="number" Value="@_aDias" ValueChanged="v=>_aDias=v??string.Empty" HelpText="Capturas de pantalla, HTML y archivos intermedios de ARCA." Disabled="_busy" />
            <div class="d-flex gap-2">
                <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-save" Disabled="_busy" OnClick="_ => GuardarArca()">Guardar ARCA</AlfaButton>
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Icon="bi bi-play-circle" Disabled="_busy" OnClick="_ => ProbarArca()">Probar descarga</AlfaButton>
            </div>
            <p>Probar verifica el script, python, playwright y pywin32. No entra a ARCA ni descarga nada.</p>
        </section>
    }
</div>

@code {
    private string _python="",_script="",_carpeta="",_aPython="",_aScript="",_aCarpeta="",_aMeses="13",_aDias="7";
    private bool _busy;
    private AppUiMessage? _feedback;
    private PageHeaderConfig? _publicado;
    private bool EsAdministrador=>Usuario.IsAuthenticated&&Usuario.CurrentUser?.SuperAdmin==true;
    private ArcaServidorConfiguracion ConfigArca=>new(){PythonExe=_aPython,Script=_aScript,Carpeta=_aCarpeta,
        RetencionMeses=int.TryParse(_aMeses,out var meses)?meses:-1,DiagnosticoDias=int.TryParse(_aDias,out var dias)?dias:-1};
    private LectoresServidorConfiguracion Config=>new(){PythonExe=_python,ComprasScriptPath=_script,ComprasWorkDir=_carpeta};
    protected override async Task OnInitializedAsync()
    {
        Header();
        if(!EsAdministrador)return;
        await Ejecutar(async()=>
        {
            var config=await Lectores.ObtenerAsync();_python=config.PythonExe;_script=config.ComprasScriptPath;_carpeta=config.ComprasWorkDir;
            var arca=await ArcaServidor.ObtenerAsync();_aPython=arca.PythonExe;_aScript=arca.Script;_aCarpeta=arca.Carpeta;_aMeses=arca.RetencionMeses.ToString();_aDias=arca.DiagnosticoDias.ToString();
            _feedback=null;
        });
    }
    protected override void OnAfterRender(bool firstRender){if(firstRender)Header();}
    private Task Guardar()=>Ejecutar(async()=>
    {
        await Lectores.GuardarAsync(Config);
        _feedback=AppUiMessage.Success("Configuración guardada","Las bases de esta instalación usarán el ejecutable común sin reiniciar AlfaCore.");
    });
    private Task GuardarArca()=>Ejecutar(async()=>
    {
        await ArcaServidor.GuardarAsync(ConfigArca);
        _feedback=AppUiMessage.Success("Configuración de ARCA guardada","La descarga de Mis Comprobantes usará estos valores en todas las bases, sin reiniciar AlfaCore.");
    });
    private Task ProbarArca()=>Ejecutar(async()=>
    {
        var resultado=await ArcaServidor.ProbarAsync(ConfigArca);
        _feedback=AppUiMessage.Success("Descarga de ARCA disponible",resultado+". Guardá para aplicar esta configuración.");
    });
    private Task Probar()=>Ejecutar(async()=>
    {
        var resultado=await Lectores.ProbarAsync(Config);
        _feedback=AppUiMessage.Success("Lector disponible",resultado+". Guardá para aplicar esta configuración.");
    });
    private async Task Ejecutar(Func<Task> trabajo)
    {
        if(_busy)return;_busy=true;_feedback=AppUiMessage.InProgress("Procesando…","Verificando la configuración del servidor.");Header();await InvokeAsync(StateHasChanged);
        try
        {
            var resultado=await UiOps.RunAsync(async()=>{await trabajo();return true;},"No se pudo completar la configuración del servidor.");
            if(!resultado.Success)_feedback=resultado.Feedback;
            else if(_feedback?.Severity==AppUiFeedbackSeverity.InProgress)_feedback=null;
        }
        finally{_busy=false;Header();await InvokeAsync(StateHasChanged);}
    }
    private void Header()=>PageHeader.Set(_publicado=new PageHeaderConfig
    {
        Title="Servidor",ModuleKey="admin",ShellMode=PageHeaderShellMode.AlfaDesignPilot,
        Breadcrumb=["Administrar","Servidor"],TopNavigationItems=ModuleTopNavPresets.BuildAdministrar(RouteContext,Nav,"servidor"),
        Actions=[new(){Key="guardar",Label="Guardar",Icon="bi-save",Style=PageHeaderActionStyle.Primary,Disabled=_busy||!EsAdministrador,OnClick=Guardar},
                 new(){Key="probar",Label="Probar lector",Icon="bi-play-circle",Disabled=_busy||!EsAdministrador,OnClick=Probar}]
    });
    public void Dispose(){if(ReferenceEquals(PageHeader.Current,_publicado))PageHeader.Clear();}
}
