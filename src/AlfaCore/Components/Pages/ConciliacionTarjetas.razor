        PageHeader.Set(_header=new PageHeaderConfig{ModuleKey="caja-bancos",ShellMode=PageHeaderShellMode.AlfaDesignPilot,Title="Conciliación de tarjetas asistida con IA",ResponsiveToolbar=true,
            TopNavigationItems=[new(){Key="tarjetas",Label="Conciliación de tarjetas asistida con IA",Active=true}],SearchContent=_tab=="conciliar"?Busqueda():null,
