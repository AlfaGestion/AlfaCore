                :[new(){Key="conciliar",Label="Conciliar selección",Icon="bi-link",Disabled=_busy||!PuedeConciliar,OnClick=PedirConfirmar},new(){Key="proponer",Label="Proponer selección",Title="Marca pares únicos con la misma fecha e importe; no usa IA ni confirma vínculos.",Icon="bi-stars",Disabled=_busy||_comparacion is null,OnClick=Proponer},new(){Key="ia",Label=_busy&&_accionEnCurso=="ia"?"Analizando con IA…":"Asistir con IA",Title="Analiza pendientes y propone coincidencias o agrupaciones para revisar antes de confirmar.",Busy=_busy&&_accionEnCurso=="ia",Icon="bi-stars",Disabled=_busy||_comparacion?.Importacion.DetalleCompleto!=true,OnClick=AsistirIa},new(){Key="comparar",Label="Comparar",Title="Actualiza las listas con los filtros elegidos; no propone ni confirma conciliaciones.",Busy=_busy&&_accionEnCurso=="comparar",Icon="bi-arrow-repeat",Disabled=_busy||_comparacion is null,OnClick=Comparar},new(){Key="exportar",Label=_busy&&_accionEnCurso=="exportar"?"Preparando Excel…":"Exportar Excel",Icon="bi-file-earmark-excel",Busy=_busy&&_accionEnCurso=="exportar",Disabled=_busy||_aplicado is null||_comparacion is null,OnClick=PedirExportar},new(){Key="preparar-lt",Label=_busy&&_accionEnCurso=="PrepararLT"?"Preparando LT…":"Preparar LT",Icon="bi-journal-text",Busy=_busy&&_accionEnCurso=="PrepararLT",Disabled=_busy||_comparacion is null,OnClick=AbrirLt}],
