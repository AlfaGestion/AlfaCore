    private void CambioSesion(){if(Sesiones.GetActiveSession()?.Id==_sesion&&TenantDataAccessGuard.IsActiveSessionAuthorized(Sesiones,Usuarios))return;_lifetime.Cancel();_mostrarLt=false;_lt=null;_ltCuentas=[];_mostrarCriteriosIa=false;_criteriosElegidos=null;_mostrarExportar=false;_mostrarDeshacerVarias=false;_vistaDeshacer=null;_deshacerElegidos.Clear();_progreso=null;_accionEnCurso="";_corregirCuenta=null;_eliminarImportacion=null;_motivoEliminar="";_archivo=null;_lectura=null;_comparacion=null;_ia=null;_analisisGuardado=null;_mostrarIa=false;LimpiarIa();_cuentas=[];_importaciones=[];LimpiarSeleccion();_confirmar=false;_feedback=AppUiMessage.Info("La sesión cambió","Volvé a abrir el módulo en la base activa.");_ = InvokeAsync(StateHasChanged);}
    private async Task Operar(Func<CancellationToken,Task> work,AppUiMessage? progreso=null,string accion="")
    {
        if(_busy||_disposed||_lifetime.IsCancellationRequested)return;_busy=true;_accionEnCurso=accion;
        _resultadoPropuesta=null;_progreso=progreso??AppUiMessage.InProgress("Procesando…","Esperá mientras se completa la operación.");Header();
        try{await InvokeAsync(StateHasChanged);await work(_lifetime.Token);}
        catch(OperationCanceledException) when(_lifetime.IsCancellationRequested || _disposed){}
        catch(Exception ex)
        {
            if(!_lifetime.IsCancellationRequested)
            {
                if(ex is not AppUserFacingException)
                {
                    var mensaje=ex is InvalidOperationException?ex.Message:ex is OperationCanceledException
                        ?"Se interrumpió la respuesta. Actualizá la consulta antes de reintentar.":"No se pudo completar la operación.";
                    var codigo=await Eventos.LogErrorAsync("ConciliacionTarjetas","Pantalla",ex,mensaje);
                    ex=new AppUserFacingException(mensaje,codigo,ex);
                }
                _feedback=UiOps.BuildMessage(ex,"Conciliación de tarjetas");
            }
        }
        finally{_busy=false;_progreso=null;_accionEnCurso="";if(!_disposed){Header();await InvokeAsync(StateHasChanged);}}
    }
    private bool _prepararAlImportar=true;
    private void UsarCandidata(TarjetasCuentaCandidata candidata){if(_busy)return;_cuenta=candidata.Cuenta;_sucursalImportar=candidata.Sucursal;Header();}
    private Task Seleccionar(InputFileChangeEventArgs e)=>Operar(async ct=>{
        _lectura=null;_archivo=null;
        await using var s=e.File.OpenReadStream(20*1024*1024,ct);using var ms=new MemoryStream();await s.CopyToAsync(ms,ct);
        _archivo=new(e.File.Name,ms.ToArray());_lectura=await Servicio.LeerAsync(_archivo,ct);_cuenta=_lectura.CuentaSugerida;_sucursalImportar=_lectura.SucursalSugerida;
    },AppUiMessage.InProgress("Leyendo archivo y detectando cuenta…","Comparando las fechas, cupones e importes con las cuentas TJ autorizadas de Alfa. Al finalizar podrás revisar la cuenta sugerida."));
    private Task Importar()=>Operar(async ct=>{
        if(_archivo is null)return;var margen=_lectura?.Deteccion?.Dias??0;var id=await Servicio.ImportarAsync(_archivo,_cuenta,_sucursalImportar,_recordar,ct);
        _importaciones=await Servicio.ImportacionesAsync(_verAnuladas,ct);_archivo=null;_lectura=null;
        await AbrirCore(_importaciones.Single(x=>x.Id==id),ct,margen);
        if(_prepararAlImportar)ProponerCore();
        _feedback=AppUiMessage.Success("Liquidación importada",_prepararAlImportar?$"Se conservó el PDF original. {_detalles.Count} pares únicos por fecha e importe preparados para revisar; confirmá solo después de controlar la selección. Para lotes o fechas diferentes, usá Asistir con IA.":"Se conservó el PDF original. Podés comparar y preparar la conciliación cuando lo necesites.");
    });
    private Task Abrir(TarjetasImportacion i)=>Operar(async ct=>{var c=_criteriosElegidos??await Servicio.CriteriosIaAsync(ct);await AbrirCore(i,ct,c.Dias);});
    private async Task AbrirCore(TarjetasImportacion i,CancellationToken ct,int margen=0){_filtro.FechaDesde=i.Desde.AddDays(-margen);_filtro.FechaHasta=i.Hasta.AddDays(margen);_filtro.Sucursal=i.Sucursal;_filtro.Estado="Pendientes";_filtro.Buscar="";_comparacion=new(i,[],[],0);_tab="conciliar";await CompararCore(ct);}
    private Task Comparar()=>Operar(CompararCore,AppUiMessage.InProgress("Actualizando comparación…","Consultando la liquidación y las tarjetas de Alfa con los filtros elegidos."),"comparar");
    private async Task CompararCore(CancellationToken ct){if(_comparacion is null)return;var f=new TarjetasFiltro(_comparacion.Importacion.Id,_filtro.FechaDesde??DateTime.Today,_filtro.FechaHasta??DateTime.Today,_filtro.Sucursal,_filtro.Estado,_filtro.Buscar);_comparacion=await Servicio.CompararAsync(f,ct);_aplicado=f;_analisisGuardado=await Servicio.UltimoAnalisisAsync(f.Importacion,ct);_ia=null;_mostrarIa=false;LimpiarIa();LimpiarFiltrosLocales();LimpiarSeleccion();_paginaResumen=_paginaAlfa=1;}
    private Task Original(long id)=>Operar(async ct=>{var f=await Servicio.OriginalAsync(id,ct);await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob",Convert.ToBase64String(f.Contenido),"application/pdf",f.Nombre);});
    private Task CambiarTab(string key){_tab=key;Header();return Task.CompletedTask;}
    private void Elegir(long id,bool v){if(_busy)return;if(v&&_comparacion?.Detalles.Any(d=>d.Id==id&&d.Vinculo is null)==true&&_detalles.Count<2000)_detalles.Add(id);else if(!v)_detalles.Remove(id);AjustarPaginas();Header();}
    private void Elegir(string key,bool v){if(_busy)return;if(v&&_comparacion?.Movimientos.Any(m=>m.Clave==key&&Seleccionable(m))==true&&_movimientos.Count<2000)_movimientos.Add(key);else if(!v)_movimientos.Remove(key);AjustarPaginas();Header();}
    private void LimpiarSeleccion(){_resultadoPropuesta=null;_detalles.Clear();_movimientos.Clear();_soloSeleccionados=false;AjustarPaginas();Header();}
    private void OrdenarResumen(bool importe){_descResumen=_ordenResumenImporte==importe?!_descResumen:false;_ordenResumenImporte=importe;_paginaResumen=1;}
    private void OrdenarAlfa(bool importe){_descAlfa=_ordenAlfaImporte==importe?!_descAlfa:false;_ordenAlfaImporte=importe;_paginaAlfa=1;}
    private AppUiMessage? _resultadoPropuesta;
    private async Task Proponer()
    {
        if(_busy)return;
        ProponerCore();
        _feedback=_resultadoPropuesta;
        await InvokeAsync(StateHasChanged);
    }
    private void ProponerCore()
    {
        if(_comparacion is null){_resultadoPropuesta=AppUiMessage.Info("Sin liquidación para proponer","Abrí una importación y compará sus movimientos antes de proponer una selección.");return;}
        var pendientesResumen=ResumenFiltrado.Count(d=>d.Vinculo is null);
        var pendientesAlfa=AlfaFiltrado.Count(Seleccionable);
        LimpiarSeleccion();
        foreach(var p in TarjetasPropuestas.Unicas(_comparacion with{Detalles=ResumenFiltrado.ToList(),Movimientos=AlfaFiltrado.ToList()}))
        {
            _detalles.Add(p.Detalle);_movimientos.Add(p.Clave);
        }
        Header();
        if(pendientesResumen==0||pendientesAlfa==0)
            _resultadoPropuesta=AppUiMessage.Info("Sin pendientes para proponer",$"Con los filtros actuales hay {pendientesResumen} pendientes de liquidación y {pendientesAlfa} de Alfa. Revisá los filtros generales y los de cada lista.");
        else if(_detalles.Count>0)
            _resultadoPropuesta=AppUiMessage.Info("Selección propuesta",$"Se marcaron {_detalles.Count} pares únicos por fecha e importe entre {pendientesResumen} pendientes de liquidación y {pendientesAlfa} de Alfa, incluyendo otras páginas. Revisá antes de confirmar; esto no verifica por sí solo cada cupón.");
        else
            _resultadoPropuesta=AppUiMessage.Info("Sin coincidencias únicas",$"Se revisaron {pendientesResumen} pendientes de liquidación y {pendientesAlfa} de Alfa con los filtros actuales. No hay pares únicos con la misma fecha e importe. Para lotes o fechas diferentes usá Asistir con IA, o seleccioná manualmente.");
    }

    private Task PedirConfirmar()
    {
        if(_busy||!PuedeConciliar)return Task.CompletedTask;
        _motivo="";_desconciliar=null;_confirmar=true;
        // La barra global ejecuta el callback fuera del árbol de eventos de esta página.
        return InvokeAsync(StateHasChanged);
    }
    private Task AnalizarConCriterios()=>Operar(ct=>ConRelojAnalisis(async()=>{
        if(_comparacion is null)return;
        var criterios=LeerFormularioCriterios();_criteriosElegidos=criterios;_mostrarCriteriosIa=false;
        var filtro=new TarjetasFiltro(_comparacion.Importacion.Id,_filtro.FechaDesde??DateTime.Today,_filtro.FechaHasta??DateTime.Today,_filtro.Sucursal,"Pendientes",_filtro.Buscar);
        var comparacion=await Servicio.CompararAsync(filtro,ct);
        var analisis=await Servicio.AnalizarIaAsync(filtro,ct,criterios:criterios,avance:MostrarAvanceAnalisis);
        _analisisGuardado=await Servicio.UltimoAnalisisAsync(filtro.Importacion,ct);
        await MostrarAvanceAnalisis(new(4,"Análisis terminado. Preparando la revisión de propuestas.",Finalizado:true));
        _comparacion=comparacion;_aplicado=filtro;_filtro.Estado="Pendientes";
        LimpiarFiltrosLocales();LimpiarSeleccion();_paginaResumen=_paginaAlfa=1;_ia=analisis;LimpiarIa();_mostrarIa=true;
    },ct),AppUiMessage.InProgress("Paso 1 de 4 · Consultar movimientos","Preparando los movimientos del análisis…"),"ia");
    private Task CerrarIa(){if(!_busy)_mostrarIa=false;return Task.CompletedTask;}
    private Task ElegirIa(TarjetasIaPropuesta propuesta)
    {
        LimpiarSeleccion();
        foreach(var d in propuesta.Detalles)_detalles.Add(d.Id);
        foreach(var m in propuesta.Movimientos)_movimientos.Add(m.Clave);
        _mostrarIa=false;_desconciliar=null;_motivo=propuesta.Origen+" · "+propuesta.Confianza+": "+propuesta.Motivo;
        if(_motivo.Length>500)_motivo=_motivo[..500];
        _confirmar=true;Header();return Task.CompletedTask;
    }
    private Task VerConciliados()=>Operar(async ct=>{_filtro.Estado=_aplicado?.Estado=="Conciliados"?"Pendientes":"Conciliados";await CompararCore(ct);});
    private Task PedirDesconciliar(long id){_motivo="";_desconciliar=id;_confirmar=true;return Task.CompletedTask;}
    private Task CerrarConfirmacion(){if(!_busy)_confirmar=false;return Task.CompletedTask;}
    private Task Guardar()=>Operar(async ct=>{
        if(_aplicado is null||_comparacion is null)return;
        if(_desconciliar is {} id)await Servicio.DesconciliarAsync(id,_aplicado,_motivo,ct);
        else await Servicio.ConfirmarAsync(new(_aplicado,_detalles.ToList(),_comparacion.Movimientos.Where(x=>_movimientos.Contains(x.Clave)).Select(x=>new TarjetasSeleccion(x.Clave,x.Huella)).ToList(),_motivo),ct);
        var deshecha=_desconciliar.HasValue;
        _confirmar=false;if(deshecha)_filtro.Estado="Pendientes";
        await CompararCore(ct);_importaciones=await Servicio.ImportacionesAsync(_verAnuladas,ct);
        _feedback=deshecha?AppUiMessage.Success("Conciliación deshecha","Se liberó el grupo completo. Sus movimientos están pendientes para otra conciliación; se conservó el historial sin modificar asientos."):AppUiMessage.Success("Conciliación actualizada","Se guardó el vínculo y su historial sin modificar la contabilidad.");
    });
