    private IReadOnlyList<string> GetRubrosDisponibles()
        => _catalogo?.Articulos
            .Select(x => x.Rubro?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList()
           ?? [];

    private IReadOnlyList<string> GetMarcasDisponibles()
        => _catalogo?.Articulos
            .Select(x => x.Marca?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList()
           ?? [];

    private IReadOnlyList<AlfaSelectOption> GetMarcaOptions()
        => GetMarcasDisponibles().Select(m => new AlfaSelectOption(m, m)).ToList();

    private IReadOnlyList<CatalogosCatalogoItemDto> GetArticulosFiltrados()
    {
        if (_catalogo is null)
            return [];

        IEnumerable<CatalogosCatalogoItemDto> query = _catalogo.Articulos;

        if (!string.IsNullOrWhiteSpace(_filtroRubro))
            query = query.Where(x => string.Equals((x.Rubro ?? string.Empty).Trim(), _filtroRubro, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_filtroMarca))
            query = query.Where(x => string.Equals((x.Marca ?? string.Empty).Trim(), _filtroMarca, StringComparison.OrdinalIgnoreCase));

        return query.ToList();
    }

    // --- Estado del carrito: en memoria + localStorage (por catálogo y cliente), sin tablas nuevas ---

    private string CarritoStorageKey
        => $"alfacore_catalogo_carrito_{IdInsert}_{(CatalogoClienteSession.CurrentClient?.CodigoCliente ?? string.Empty).Trim().ToUpperInvariant()}";

    private async Task RestoreCarritoAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string?>("localStorage.getItem", CarritoStorageKey);
            if (string.IsNullOrWhiteSpace(json))
                return;

            var data = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, decimal>>(json);
            if (data is null || _catalogo is null)
                return;

            _carrito.Clear();
            foreach (var (idArticulo, cantidad) in data)
            {
                // Solo restauro líneas cuyo artículo sigue existiendo en ESTE catálogo:
                // no confío en lo que haya quedado guardado en el navegador.
                if (cantidad > 0m && _catalogo.Articulos.Any(a => string.Equals(a.IdArticulo, idArticulo, StringComparison.OrdinalIgnoreCase)))
                    _carrito[idArticulo] = cantidad;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task PersistCarritoAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_carrito);
            await Js.InvokeVoidAsync("localStorage.setItem", CarritoStorageKey, json);
        }
        catch
        {
        }
    }

    private decimal GetCantidad(string idArticulo)
        => _carrito.TryGetValue(idArticulo.Trim(), out var cantidad) ? cantidad : 0m;

    private async Task SetCantidadAsync(string idArticulo, decimal nuevaCantidad)
    {
        var codigo = idArticulo.Trim();
        if (string.IsNullOrWhiteSpace(codigo))
            return;

        var cantidad = Math.Max(0m, nuevaCantidad);
        if (cantidad <= 0m)
            _carrito.Remove(codigo);
        else
            _carrito[codigo] = cantidad;

        _validacionError = null;
        await PersistCarritoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task IncrementarAsync(CatalogosCatalogoItemDto item)
        => SetCantidadAsync(item.IdArticulo, GetCantidad(item.IdArticulo) + 1m);

    private Task DecrementarAsync(CatalogosCatalogoItemDto item)
        => SetCantidadAsync(item.IdArticulo, GetCantidad(item.IdArticulo) - 1m);

    private Task AgregarAsync(CatalogosCatalogoItemDto item)
        => SetCantidadAsync(item.IdArticulo, 1m);

    private Task QuitarAsync(CatalogosCatalogoItemDto item)
        => SetCantidadAsync(item.IdArticulo, 0m);

    private Task OnCantidadInputAsync(CatalogosCatalogoItemDto item, ChangeEventArgs args)
    {
        var texto = args.Value?.ToString() ?? string.Empty;
        return decimal.TryParse(texto, NumberStyles.Number, CultureEsAr, out var cantidad)
            ? SetCantidadAsync(item.IdArticulo, cantidad)
            : Task.CompletedTask;
    }

    private IReadOnlyList<(CatalogosCatalogoItemDto Item, decimal Cantidad)> GetLineasCarrito()
        => _catalogo?.Articulos
            .Where(a => GetCantidad(a.IdArticulo) > 0m)
            .Select(a => (a, GetCantidad(a.IdArticulo)))
            .ToList()
           ?? [];

    private int GetArticulosDistintosCount() => GetLineasCarrito().Count;

    private decimal GetCantidadTotal() => GetLineasCarrito().Sum(l => l.Cantidad);

    private decimal GetTotalEstimado()
        => GetLineasCarrito().Sum(l => l.Cantidad * AlfaCore.Services.CatalogosPriceDisplayHelper.GetPrecioAplicado(l.Item));

    // --- Continuar / confirmar (Etapa 2 no graba nada; deja el punto de entrada listo para la Etapa 3) ---

    private bool ValidarParaContinuar()
    {
        _validacionError = null;

        if (_catalogo is null)
        {
            _validacionError = "El catálogo no está disponible.";
            return false;
        }

        var lineas = GetLineasCarrito();
        if (lineas.Count == 0)
        {
            _validacionError = "Agregá al menos un artículo antes de continuar.";
            return false;
        }

        if (lineas.Any(l => l.Cantidad <= 0m))
        {
            _validacionError = "Hay artículos con cantidad inválida.";
            return false;
        }

        // Revalidación defensiva: cada línea debe corresponder a un artículo que
        // realmente está en ESTE catálogo (no confío en el estado del navegador).
        if (lineas.Any(l => !_catalogo.Articulos.Any(a => string.Equals(a.IdArticulo, l.Item.IdArticulo, StringComparison.OrdinalIgnoreCase))))
        {
            _validacionError = "Hay artículos que no pertenecen a este catálogo.";
            return false;
        }

        if (lineas.Any(l => AlfaCore.Services.CatalogosPriceDisplayHelper.GetPrecioAplicado(l.Item) <= 0m))
        {
            _validacionError = "Hay artículos sin precio válido.";
            return false;
        }

        return true;
    }

    private void ContinuarPedido()
    {
        if (!ValidarParaContinuar())
            return;

        _confirmFeedback = null;
        _emailPedido = (CatalogoClienteSession.CurrentClient?.Email ?? string.Empty).Trim();
        _emailRegistradoOriginal = _emailPedido;
        _enviarCopiaEmail = EsEmailValido(_emailPedido);
        _actualizarEmailCliente = false;
        _emailEnvioResultado = null;
        _emailFeedback = null;
        _showCarritoDrawer = false;
        _showConfirmModal = true;
    }

    private static bool EsEmailValido(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;
        try
        {
            _ = new System.Net.Mail.MailAddress(email.Trim());
            return true;
        }
        catch (FormatException)
        {
            return false;
        }
    }

    private async Task ConfirmarPedidoAsync()
    {
        if (_confirmandoPedido || _catalogo is null)
            return;

        _confirmandoPedido = true;
        _confirmFeedback = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var codigoCliente = CatalogoClienteSession.CurrentClient?.CodigoCliente ?? string.Empty;
            var lineas = GetLineasCarrito()
                .Select(l => new CatalogoPedidoLineaSolicitudDto { IdArticulo = l.Item.IdArticulo, Cantidad = l.Cantidad })
                .ToList();

            var result = await UiOps.RunAsync(() => CarritoComprasSvc.ConfirmarPedidoPublicoAsync(new CatalogoPedidoConfirmarRequestDto
            {
                IdInsert = IdInsert,
                CodigoCliente = codigoCliente,
                IdWeb = idweb,
                IdBase = idbase,
                Lineas = lineas
            }), "No se pudo registrar el pedido");

            if (!result.Success || result.Value is null)
            {
                // El carrito se conserva tal cual estaba para que el cliente pueda reintentar.
                _confirmFeedback = result.Feedback;
                return;
            }

            _pedidoResultado = result.Value;
            _carrito.Clear();
            await PersistCarritoAsync();

            await PostProcesarConfirmacionAsync();
        }
        finally
        {
            _confirmandoPedido = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // El NP ya quedó confirmado en firme antes de llegar acá. Todo lo que sigue (actualizar el
    // email del cliente, enviar la copia por mail) es best-effort: si falla, se informa pero
    // el pedido registrado NUNCA se revierte ni se pierde.
    private async Task PostProcesarConfirmacionAsync()
    {
        if (_pedidoResultado is null)
            return;

        var emailDestino = (_emailPedido ?? string.Empty).Trim();
        var emailDistinto = !string.Equals(emailDestino, _emailRegistradoOriginal, StringComparison.OrdinalIgnoreCase);

        if (_actualizarEmailCliente && emailDistinto && EsEmailValido(emailDestino))
            await ActualizarEmailClienteAsync(emailDestino);

        if (_enviarCopiaEmail && EsEmailValido(emailDestino))
            await EnviarEmailPedidoAsync(emailDestino);
    }

    private async Task ActualizarEmailClienteAsync(string nuevoEmail)
    {
        if (_pedidoResultado is null)
            return;

        _actualizandoEmailCliente = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(async () =>
            {
                var detalle = await CuentasSvc.GetByIdAsync(CuentaComercialTipo.Cliente, _pedidoResultado.CodigoCliente)
                    ?? throw new InvalidOperationException("No se encontró la ficha del cliente para actualizar el email.");
                detalle.Mail = nuevoEmail;
                await CuentasSvc.SaveAsync(CuentaComercialTipo.Cliente, detalle);
            }, "No se pudo actualizar el email del cliente");

            if (!result.Success)
                _emailFeedback = result.Feedback?.Message ?? "No se pudo actualizar el email del cliente.";
        }
        finally
        {
            _actualizandoEmailCliente = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnviarEmailPedidoAsync(string emailDestino)
    {
        if (_pedidoResultado is null)
            return;

        _enviandoEmailPedido = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var imagenes = _pedidoResultado.Lineas
                .Select(l => (l.IdArticulo, Url: GetLineaImagenAbsolutaUrl(l.IdArticulo)))
                .Where(x => !string.IsNullOrWhiteSpace(x.Url))
                .ToDictionary(x => x.IdArticulo, x => x.Url!, StringComparer.OrdinalIgnoreCase);

            _emailEnvioResultado = await PedidosEmailSvc.EnviarConfirmacionPedidoAsync(new CatalogoPedidoEmailRequestDto
            {
                Pedido = _pedidoResultado,
                EmailDestino = emailDestino,
                NombreEmpresa = GetBrandingName(),
                LogoUrlAbsoluta = Nav.ToAbsoluteUri(GetBrandingLogoUrl()).ToString(),
                ImagenesPorArticulo = imagenes
            });
        }
        finally
        {
            _enviandoEmailPedido = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string? GetLineaImagenAbsolutaUrl(string idArticulo)
    {
        var relativa = AlfaCore.Services.ArticuloImagenUrlHelper.BuildPublicImageUrl(_puntoVentaSettings.FtpCodigoCta, idArticulo, GetEffectiveIdBase(), thumbnail: true);
        return string.IsNullOrWhiteSpace(relativa) ? null : Nav.ToAbsoluteUri(relativa).ToString();
    }

    private async Task ReintentarEnvioEmailAsync()
    {
        if (_pedidoResultado is null || _enviandoEmailPedido)
            return;

        var email = (_emailPedido ?? string.Empty).Trim();
        if (!EsEmailValido(email))
        {
            _emailEnvioResultado = new CatalogoPedidoEmailResultDto { Enviado = false, MensajeError = "El email indicado no tiene un formato válido." };
            return;
        }

        await EnviarEmailPedidoAsync(email);
    }

    private void HandleConfirmOverlayClick()
    {
        if (_confirmandoPedido)
            return;

        if (_pedidoResultado is not null)
        {
            CerrarConfirmacionExitosa();
            return;
        }

        _showConfirmModal = false;
    }

    private void CerrarConfirmacionExitosa()
    {
        _showConfirmModal = false;
        _pedidoResultado = null;
        _confirmFeedback = null;
        _emailEnvioResultado = null;
        _emailFeedback = null;
    }

    public ValueTask DisposeAsync()
    {
        CatalogoClienteSession.StateChanged -= OnClientSessionStateChanged;
        return ValueTask.CompletedTask;
    }
}
