@page "/carrito/{IdInsert:int}"
@page "/{idweb}/{idbase:int}/carrito/{IdInsert:int}"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits SaaSRoutePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@using AlfaCore.Components.Shared.AlfaDesign
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@inject AlfaCore.Services.IInterfacesCatalogosService CatalogosSvc
@inject AlfaCore.Services.ICarritoComprasService CarritoComprasSvc
@inject AlfaCore.Services.ICatalogosClienteSessionService CatalogoClienteSession
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc
@inject AlfaCore.Services.IPedidosEmailService PedidosEmailSvc
@inject AlfaCore.Services.ICuentasComercialesService CuentasSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.ISessionService SessionSvc
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>Toma de pedidos | AlfaCore</PageTitle>

@if (!_loading && !_notFound && !_carritoDeshabilitado && !IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="@_catalogo?.Nombre"
                                VigenciaTexto="@GetVigenciaTexto()"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@_clienteCodigo"
                                CodigoChanged="v => _clienteCodigo = v"
                                Password="@_clientePassword"
                                PasswordChanged="v => _clientePassword = v"
                                ShowPassword="@_showPassword"
                                ShowPasswordChanged="v => _showPassword = v"
                                Busy="@_sessionBusy"
                                Feedback="@_loginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="@GetReturnUrl()"
                                VolverTexto="@GetReturnText()" />
}
else
{
    <section class="page-grid carrito-page">
        @if (!Embedded)
        {
            <section class="carrito-page__hero">
                <div class="carrito-page__hero-brand">
                    <div class="carrito-page__logo @GetBrandingLogoFrameClass()">
                        <img src="@GetBrandingLogoUrl()" alt="@GetBrandingName()" />
                    </div>
                    <div>
                        <p class="carrito-page__eyebrow">Toma de pedidos</p>
                        <h2 class="carrito-page__title">@(_catalogo?.Nombre ?? "Catálogo")</h2>
                        @if (!string.IsNullOrWhiteSpace(_catalogo?.Observaciones))
                        {
                            <p class="carrito-page__description">@_catalogo.Observaciones.Trim()</p>
                        }
                    </div>
                </div>

                @if (IsAuthenticated)
                {
                    <div class="carrito-page__hero-actions">
                        <AlfaTag Tone="AlfaTagTone.Neutral">Cliente: @GetCurrentClientLabel()</AlfaTag>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-box-arrow-right" Disabled="@_sessionBusy" OnClick="LogoutClienteAsync">
                            Cerrar sesión
                        </AlfaButton>
                    </div>
                }
            </section>
        }

        @if (_loading)
        {
            <div class="carrito-page__loading-state">
                <p class="text-muted">Cargando...</p>
            </div>
        }
        else if (_notFound)
        {
            <div class="carrito-page__empty-panel">
                <AlfaEmptyState Kind="AlfaEmptyStateKind.Error"
                                Title="Catálogo no disponible"
                                Message="El catálogo no existe, no está publicado o venció su vigencia." />
            </div>
        }
        else if (_carritoDeshabilitado)
        {
            <div class="carrito-page__empty-panel">
                <AlfaEmptyState Kind="AlfaEmptyStateKind.NoData"
                                Title="Toma de pedidos no disponible"
                                Message="Este catálogo no tiene habilitada la toma de pedidos." />
            </div>
            <div class="carrito-page__empty-panel">
                <a class="alfa-link-button" href="@GetPublicCatalogUrl()">
                    <i class="bi bi-arrow-left"></i> Ver catálogo
                </a>
            </div>
        }
        else if (_catalogo is not null)
        {
            <section class="panel-card">
                @if (_catalogo.Articulos.Count > 0)
                {
                    <div class="carrito-tabs" role="tablist" aria-label="Filtro por rubro">
                        <div class="carrito-tabs__scroll">
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(string.IsNullOrEmpty(_filtroRubro))"
                                    class="carrito-tabs__btn @(string.IsNullOrEmpty(_filtroRubro) ? "is-active" : string.Empty)"
                                    @onclick="() => _filtroRubro = string.Empty">
                                Todos
                            </button>
                            @foreach (var rubro in GetRubrosDisponibles())
                            {
                                <button type="button"
                                        role="tab"
                                        aria-selected="@(string.Equals(_filtroRubro, rubro, StringComparison.OrdinalIgnoreCase))"
                                        class="carrito-tabs__btn @(string.Equals(_filtroRubro, rubro, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                                        @onclick="() => _filtroRubro = rubro">
                                    @rubro
                                </button>
                            }
                        </div>
                    </div>

                    <div class="carrito-filters">
                        <AlfaSelect Label="Marca"
                                    Value="@_filtroMarca"
                                    ValueChanged="v => _filtroMarca = v ?? string.Empty"
                                    Options="@GetMarcaOptions()"
                                    Placeholder="Todas"
                                    Class="carrito-filters__field" />
                    </div>

                    <div class="carrito-grid">
                        @foreach (var item in GetArticulosFiltrados())
                        {
                            <article class="carrito-card">
                                <div class="carrito-card__media">
                                    @if (ShouldShowImage(item))
                                    {
                                        <img class="carrito-card__img"
                                             src="@GetProductThumbUrl(item)"
                                             alt="@item.DescripcionArticulo"
                                             loading="lazy"
                                             @onerror="@EventCallback.Factory.Create(this, () => HandleImageError(item.IdArticulo))" />
                                    }
                                    else
                                    {
                                        <div class="carrito-card__fallback">@ProductInitials(item.DescripcionArticulo)</div>
                                    }
                                </div>

                                <div class="carrito-card__body">
                                    <div class="carrito-card__title-row">
                                        <strong class="carrito-card__title">@item.DescripcionArticulo</strong>
                                        <span class="carrito-card__code">@item.IdArticulo</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Presentacion))
                                    {
                                        <p class="carrito-card__presentation">@item.Presentacion</p>
                                    }

                                    <div class="carrito-card__meta">
                                        <span>@Display(item.Marca)</span>
                                        <span>@Display(item.Rubro)</span>
                                    </div>

                                    @RenderPrecio(item)

                                    <div class="carrito-card__actions">
                                        @if (GetCantidad(item.IdArticulo) <= 0m)
                                        {
                                            <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-cart-plus" Class="carrito-card__add" OnClick="() => AgregarAsync(item)">
                                                Agregar
                                            </AlfaButton>
                                        }
                                        else
                                        {
                                            <div class="carrito-stepper">
                                                <button type="button" class="carrito-stepper__btn" @onclick="() => DecrementarAsync(item)" title="Restar" aria-label="Restar una unidad">−</button>
                                                <input class="carrito-stepper__input"
                                                       value="@GetCantidad(item.IdArticulo).ToString("N2", CultureEsAr)"
                                                       @onchange="args => OnCantidadInputAsync(item, args)"
                                                       inputmode="decimal" />
                                                <button type="button" class="carrito-stepper__btn" @onclick="() => IncrementarAsync(item)" title="Sumar" aria-label="Sumar una unidad">+</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">Este catálogo todavía no tiene artículos.</p>
                }
            </section>

            @if (GetLineasCarrito().Count > 0)
            {
                <button type="button" class="carrito-fab" @onclick="() => _showCarritoDrawer = true">
                    <i class="bi bi-cart3"></i>
                    <span>Carrito (@GetArticulosDistintosCount())</span>
                    <strong>@AlfaCore.Services.CatalogosPriceDisplayHelper.Money(GetTotalEstimado())</strong>
                </button>
            }
        }
    </section>
}

@if (_showCarritoDrawer)
{
    <div class="carrito-overlay" @onclick="() => _showCarritoDrawer = false">
        <div class="carrito-drawer" @onclick:stopPropagation="true">
            <div class="carrito-drawer__header">
                <h3>Tu pedido</h3>
                <AlfaIconButton Icon="bi bi-x-lg" Label="Cerrar" Size="AlfaSize.Sm" OnClick="() => _showCarritoDrawer = false" />
            </div>

            @if (GetLineasCarrito().Count == 0)
            {
                <p class="text-muted">Todavía no agregaste artículos.</p>
            }
            else
            {
                <div class="carrito-drawer__lines">
                    @foreach (var linea in GetLineasCarrito())
                    {
                        <div class="carrito-line">
                            <div class="carrito-line__media">
                                @if (ShouldShowImage(linea.Item))
                                {
                                    <img src="@GetProductThumbUrl(linea.Item)" alt="@linea.Item.DescripcionArticulo" loading="lazy"
                                         @onerror="@EventCallback.Factory.Create(this, () => HandleImageError(linea.Item.IdArticulo))" />
                                }
                                else
                                {
                                    <div class="carrito-line__fallback">@ProductInitials(linea.Item.DescripcionArticulo)</div>
                                }
                            </div>

                            <div class="carrito-line__body">
                                <strong>@linea.Item.DescripcionArticulo</strong>
                                <span class="carrito-line__code">@linea.Item.IdArticulo</span>
                                <span class="carrito-line__unit">@AlfaCore.Services.CatalogosPriceDisplayHelper.Money(AlfaCore.Services.CatalogosPriceDisplayHelper.GetPrecioAplicado(linea.Item)) c/u</span>
                            </div>

                            <div class="carrito-line__qty">
                                <div class="carrito-stepper carrito-stepper--sm">
                                    <button type="button" class="carrito-stepper__btn" @onclick="() => DecrementarAsync(linea.Item)" title="Restar" aria-label="Restar una unidad">−</button>
                                    <input class="carrito-stepper__input"
                                           value="@linea.Cantidad.ToString("N2", CultureEsAr)"
                                           @onchange="args => OnCantidadInputAsync(linea.Item, args)"
                                           inputmode="decimal" />
                                    <button type="button" class="carrito-stepper__btn" @onclick="() => IncrementarAsync(linea.Item)" title="Sumar" aria-label="Sumar una unidad">+</button>
                                </div>
                            </div>

                            <div class="carrito-line__subtotal">
                                @AlfaCore.Services.CatalogosPriceDisplayHelper.Money(linea.Cantidad * AlfaCore.Services.CatalogosPriceDisplayHelper.GetPrecioAplicado(linea.Item))
                            </div>

                            <AlfaIconButton Icon="bi bi-trash" Label="Quitar artículo" Size="AlfaSize.Sm" Class="carrito-line__remove" OnClick="() => QuitarAsync(linea.Item)" />
                        </div>
                    }
                </div>

                <div class="carrito-drawer__summary">
                    <div><span>Artículos distintos</span><strong>@GetArticulosDistintosCount()</strong></div>
                    <div><span>Unidades</span><strong>@GetCantidadTotal().ToString("N2", CultureEsAr)</strong></div>
                    <div class="carrito-drawer__total"><span>Total</span><strong>@AlfaCore.Services.CatalogosPriceDisplayHelper.Money(GetTotalEstimado())</strong></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_validacionError))
                {
                    <div class="carrito-feedback carrito-feedback--error">
                        <strong>No se puede continuar</strong>
                        <p>@_validacionError</p>
                    </div>
                }

                <div class="carrito-drawer__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-arrow-right-circle" OnClick="ContinuarPedido">
                        Continuar pedido
                    </AlfaButton>
                </div>
            }
        </div>
    </div>
}

@if (_showConfirmModal && _catalogo is not null)
{
    <div class="carrito-overlay" @onclick="HandleConfirmOverlayClick">
        <div class="carrito-drawer" @onclick:stopPropagation="true">
            @if (_pedidoResultado is not null)
            {
                <div class="carrito-drawer__header">
                    <h3>Pedido registrado correctamente</h3>
                </div>

                <div class="carrito-feedback carrito-feedback--success">
                    <strong>Pedido @_pedidoResultado.Tc @_pedidoResultado.IdComprobanteTexto</strong>
                    <p>Fecha: @_pedidoResultado.Fecha.ToString("dd/MM/yyyy")</p>
                    <p>Cliente: @_pedidoResultado.RazonSocial (@_pedidoResultado.CodigoCliente)</p>
                    <p>@_pedidoResultado.Lineas.Count artículo(s) — Total: @AlfaCore.Services.CatalogosPriceDisplayHelper.Money(_pedidoResultado.Total)</p>
                </div>

                @if (_actualizandoEmailCliente || _enviandoEmailPedido)
                {
                    <div class="carrito-feedback">
                        <p><i class="bi bi-arrow-repeat"></i> @(_actualizandoEmailCliente ? "Actualizando email del cliente..." : "Enviando email de confirmación...")</p>
                    </div>
                }
                else if (_enviarCopiaEmail)
                {
                    @if (_emailEnvioResultado?.Enviado == true)
                    {
                        <div class="carrito-feedback carrito-feedback--success">
                            <p>Pedido registrado y email enviado correctamente.</p>
                        </div>
                    }
                    else if (_emailEnvioResultado is not null)
                    {
                        <div class="carrito-feedback carrito-feedback--warning">
                            <p>El pedido se registró correctamente, pero no pudimos enviar el email.</p>
                            @if (!string.IsNullOrWhiteSpace(_emailEnvioResultado.MensajeError))
                            {
                                <p class="text-muted">@_emailEnvioResultado.MensajeError</p>
                            }
                        </div>
                        <div class="carrito-drawer__actions carrito-drawer__actions--start">
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-arrow-clockwise" Disabled="@_enviandoEmailPedido" OnClick="ReintentarEnvioEmailAsync">
                                Reintentar envío
                            </AlfaButton>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(_emailFeedback))
                {
                    <div class="carrito-feedback carrito-feedback--warning">
                        <p>@_emailFeedback</p>
                    </div>
                }

                <div class="carrito-drawer__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-check-lg" OnClick="CerrarConfirmacionExitosa">
                        Listo
                    </AlfaButton>
                </div>
            }
            else
            {
                <div class="carrito-drawer__header">
                    <h3>Resumen del pedido</h3>
                    <AlfaIconButton Icon="bi bi-x-lg" Label="Cerrar" Size="AlfaSize.Sm" Disabled="@_confirmandoPedido" OnClick="() => _showConfirmModal = false" />
                </div>

                <p class="carrito-confirm__cliente"><i class="bi bi-person-circle"></i> @GetCurrentClientLabel()</p>

                <div class="carrito-drawer__lines">
                    @foreach (var linea in GetLineasCarrito())
                    {
                        <div class="carrito-line carrito-line--readonly">
                            <div class="carrito-line__body">
                                <strong>@linea.Item.DescripcionArticulo</strong>
                                <span class="carrito-line__code">@linea.Item.IdArticulo</span>
                                <span class="carrito-line__unit">@linea.Cantidad.ToString("N2", CultureEsAr) x @AlfaCore.Services.CatalogosPriceDisplayHelper.Money(AlfaCore.Services.CatalogosPriceDisplayHelper.GetPrecioAplicado(linea.Item))</span>
                            </div>
                            <div class="carrito-line__subtotal">
                                @AlfaCore.Services.CatalogosPriceDisplayHelper.Money(linea.Cantidad * AlfaCore.Services.CatalogosPriceDisplayHelper.GetPrecioAplicado(linea.Item))
                            </div>
                        </div>
                    }
                </div>

                <div class="carrito-drawer__summary">
                    <div><span>Artículos distintos</span><strong>@GetArticulosDistintosCount()</strong></div>
                    <div><span>Unidades</span><strong>@GetCantidadTotal().ToString("N2", CultureEsAr)</strong></div>
                    <div class="carrito-drawer__total"><span>Total</span><strong>@AlfaCore.Services.CatalogosPriceDisplayHelper.Money(GetTotalEstimado())</strong></div>
                </div>

                <AlfaInput Label="Email para la confirmación"
                           Type="email"
                           Value="@_emailPedido"
                           ValueChanged="v => _emailPedido = v ?? string.Empty"
                           Placeholder="cliente@empresa.com"
                           Disabled="@_confirmandoPedido"
                           Class="carrito-confirm__email" />

                <AlfaCheckbox Value="@_enviarCopiaEmail" ValueChanged="v => _enviarCopiaEmail = v ?? false" Disabled="@_confirmandoPedido" Class="carrito-toggle">
                    <strong>Enviar copia del pedido por email</strong>
                    <small>Te lo mandamos apenas se registre el pedido.</small>
                </AlfaCheckbox>

                @if (_enviarCopiaEmail && !string.IsNullOrWhiteSpace(_emailPedido) && !EsEmailValido(_emailPedido))
                {
                    <p class="carrito-confirm__email-error">El email no tiene un formato válido.</p>
                }

                @if (_enviarCopiaEmail && EsEmailValido(_emailPedido) && !string.Equals((_emailPedido ?? string.Empty).Trim(), _emailRegistradoOriginal, StringComparison.OrdinalIgnoreCase))
                {
                    <AlfaCheckbox Value="@_actualizarEmailCliente" ValueChanged="v => _actualizarEmailCliente = v ?? false" Disabled="@_confirmandoPedido" Class="carrito-toggle carrito-toggle--sub">
                        <strong>Actualizar también el email en la ficha del cliente</strong>
                        <small>Si no lo marcás, se usa solo para este pedido.</small>
                    </AlfaCheckbox>
                }

                @if (_pedidoResultado is null)
                {
                    <div class="carrito-feedback carrito-feedback--success">
                        <strong>El pedido está listo para confirmar.</strong>
                    </div>
                }

                @if (_confirmFeedback is not null)
                {
                    <div class="carrito-feedback @(_confirmFeedback.Severity == AppUiFeedbackSeverity.Success ? "carrito-feedback--success" : "carrito-feedback--warning")">
                        <p>@_confirmFeedback.Message</p>
                    </div>
                }

                <div class="carrito-drawer__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-pencil" Disabled="@_confirmandoPedido" OnClick="() => _showConfirmModal = false">
                        Seguir editando
                    </AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="@(_confirmandoPedido ? "bi bi-arrow-repeat" : "bi bi-check-circle")" Loading="@_confirmandoPedido" Disabled="@_confirmandoPedido" OnClick="ConfirmarPedidoAsync">
                        @(_confirmandoPedido ? "Registrando pedido..." : "Confirmar pedido")
                    </AlfaButton>
                </div>
            }
        </div>
    </div>
}

@code {
    private const string ClientTokenStorageKey = "alfacore_catalogo_cliente_token";
    private static readonly CultureInfo CultureEsAr = CultureInfo.GetCultureInfo("es-AR");

    private CatalogosCatalogoDetalleDto? _catalogo;
    private PuntoVentaSettingsDto _puntoVentaSettings = new();
    private bool _loading = true;
    private bool _notFound;
    private bool _carritoDeshabilitado;
    private bool _restoreAttempted;
    private bool _cartRestoreAttempted;

    private AppUiMessage? _loginFeedback;
    private bool _sessionBusy;
    private bool _showPassword;
    private string _clienteCodigo = string.Empty;
    private string _clientePassword = string.Empty;
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string? VolverUrl { get; set; }
    [Parameter] public string? VolverTexto { get; set; }
    private CatalogoClienteLoginPanel? _loginPanel;
    private CatalogosPublicIdentityDto _branding = new();

    private string _filtroRubro = string.Empty;
    private string _filtroMarca = string.Empty;
    private readonly HashSet<string> _imageFallbacks = new(StringComparer.OrdinalIgnoreCase);

    private readonly Dictionary<string, decimal> _carrito = new(StringComparer.OrdinalIgnoreCase);
    private bool _showCarritoDrawer;
    private bool _showConfirmModal;
    private string? _validacionError;
    private AppUiMessage? _confirmFeedback;
    private bool _confirmandoPedido;
    private CatalogoPedidoResultDto? _pedidoResultado;

    private string _emailPedido = string.Empty;
    private string _emailRegistradoOriginal = string.Empty;
    private bool _enviarCopiaEmail;
    private bool _actualizarEmailCliente;
    private bool _enviandoEmailPedido;
    private bool _actualizandoEmailCliente;
    private CatalogoPedidoEmailResultDto? _emailEnvioResultado;
    private string? _emailFeedback;

    private bool IsAuthenticated
        => CatalogoClienteSession.CurrentClient is { } client
           && string.Equals(client.IdWeb, NormalizeRouteSegment(idweb), StringComparison.OrdinalIgnoreCase)
           && client.IdBase == (idbase ?? 0);

    [Parameter]
    public int IdInsert { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CatalogoClienteSession.StateChanged += OnClientSessionStateChanged;
        await EnsureRouteSessionAsync();
        await LoadPublicIdentityAsync();
        await LoadImageSettingsAsync();
        await RefreshCatalogoAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureRouteSessionAsync();
        await LoadPublicIdentityAsync();
        await LoadImageSettingsAsync();
        await RefreshCatalogoAsync();
    }

    private async Task LoadPublicIdentityAsync()
    {
        try
        {
            _branding = await CatalogosSvc.GetPublicIdentityAsync(idweb);
        }
        catch
        {
            _branding = new CatalogosPublicIdentityDto();
        }
    }

    private async Task LoadImageSettingsAsync()
    {
        try
        {
            _puntoVentaSettings = await PuntoVentaSvc.GetSettingsAsync();
        }
        catch
        {
            _puntoVentaSettings = new PuntoVentaSettingsDto();
        }
    }

    private int? _effectiveIdBase;

    private async Task EnsureRouteSessionAsync()
    {
        if (idbase is > 0)
        {
            _effectiveIdBase = idbase;
        }
        else
        {
            var sessionBaseId = SessionSvc.GetActiveSession()?.BaseId ?? 0;
            _effectiveIdBase = sessionBaseId > 0 ? sessionBaseId : null;
        }

        if (!AppMode.IsSaaSMode || !idbase.HasValue)
            return;

        var routeBaseId = idbase.Value;
        var routeBase = await CentralBasesSvc.GetByIdAsync(routeBaseId);
        if (routeBase is null)
        {
            _notFound = true;
            return;
        }

        SessionSvc.SetWebhookOverride(new SessionDto
        {
            Id = Guid.Parse($"00000000-0000-0000-0000-{routeBaseId:000000000000}"),
            BaseId = routeBase.IdBase,
            Nombre = routeBase.Nombre,
            Servidor = routeBase.DbServer,
            BaseDatos = routeBase.DbName,
            Usuario = routeBase.DbUser,
            Password = routeBase.DbPassword,
            TrustServerCertificate = true,
            Activa = true
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_restoreAttempted)
        {
            _restoreAttempted = true;
            await RestoreClientSessionAsync();

            if (IsAuthenticated)
                await RefreshCatalogoAsync();

            if (_loginPanel is not null)
            {
                try { await _loginPanel.FocusCodigoAsync(); }
                catch { }
            }
        }

        if (IsAuthenticated && _catalogo is not null && !_cartRestoreAttempted)
        {
            _cartRestoreAttempted = true;
            await RestoreCarritoAsync();
        }
    }

    private async Task RefreshCatalogoAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        var catalogo = await CarritoComprasSvc.GetPublicCartAsync(IdInsert, idweb, CatalogoClienteSession.CurrentClient?.CodigoCliente);
        _catalogo = catalogo;
        _notFound = catalogo is null;
        _carritoDeshabilitado = catalogo is not null && !catalogo.HabilitarCarrito;
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreClientSessionAsync()
    {
        try
        {
            var token = await Js.InvokeAsync<string?>("localStorage.getItem", ClientTokenStorageKey);
            if (string.IsNullOrWhiteSpace(token))
                return;

            if (!CatalogoClienteSession.TryRestoreFromToken(token))
            {
                await Js.InvokeVoidAsync("localStorage.removeItem", ClientTokenStorageKey);
                return;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private void OnClientSessionStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    private async Task LoginClienteAsync()
    {
        _loginFeedback = null;
        _sessionBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => CatalogoClienteSession.LoginAsync(new CatalogosClienteLoginRequestDto
            {
                CodigoCliente = _clienteCodigo,
                Password = _clientePassword,
                IdWeb = idweb,
                IdBase = idbase,
                IdInsert = IdInsert
            }), "No pudimos validar el acceso en este momento. Intentá nuevamente.");

            if (!result.Success || result.Value is null)
            {
                _loginFeedback = result.Feedback;
                _clientePassword = string.Empty;
                return;
            }

            await Js.InvokeVoidAsync("localStorage.setItem", ClientTokenStorageKey, CatalogoClienteSession.CurrentToken ?? string.Empty);
            _clientePassword = string.Empty;
            await RefreshCatalogoAsync();
        }
        finally
        {
            _sessionBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LogoutClienteAsync()
    {
        _sessionBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            CatalogoClienteSession.Logout();
            await Js.InvokeVoidAsync("localStorage.removeItem", ClientTokenStorageKey);
        }
        finally
        {
            _sessionBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

