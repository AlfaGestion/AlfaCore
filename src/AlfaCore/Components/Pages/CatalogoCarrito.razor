    private string? GetVigenciaTexto()
    {
        if (_catalogo is null || (_catalogo.VigenciaDesde is null && _catalogo.VigenciaHasta is null))
            return null;

        var desde = _catalogo.VigenciaDesde?.ToString("dd/MM/yyyy") ?? "—";
        var hasta = _catalogo.VigenciaHasta?.ToString("dd/MM/yyyy") ?? "—";
        return $"{desde} - {hasta}";
