@page "/inicio"
@page "/{idweb}/{idbase:int}/inicio"
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Navigation

<PageTitle>Inicio | Dashboard de Compras</PageTitle>

<div class="panel-card empty-state">
    <span class="empty-state__eyebrow">Atajo</span>
    <h2>Redirigiendo al inicio principal</h2>
</div>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo(RouteContext.BuildRoute("/compras"));
    }
}
