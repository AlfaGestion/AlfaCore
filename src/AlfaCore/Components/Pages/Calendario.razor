    private string CurrentUserName => AppUserSession.CurrentUser?.UserName ?? Environment.UserName;

    private static CalendarioEventoSaveRequest NewForm(DateTime day)
        => new()
        {
            Titulo = "GUARDIA",
            Tipo = CalendarioEventoTipos.Guardia,
            FechaInicio = GuardiaStart(day),
            FechaFin = GuardiaEnd(day),
            TodoElDia = true,
            Estado = CalendarioEventoEstados.Confirmado,
            Color = "#14b8a6",
            CrearRecordatorioWhatsApp = true,
            MinutosAntesRecordatorio = 1440
        };

    private static DateTime GuardiaStart(DateTime value)
        => value.Date.AddHours(8);

    private static DateTime GuardiaEnd(DateTime value)
        => value.Date.AddDays(6).AddHours(22);

    private static bool IsGuardiaTemplateExact(string? value)
        => string.Equals(NormalizeTemplateName(value), "AVISO GUARDIA", StringComparison.Ordinal);

    private static bool IsGuardiaTemplateFallback(string? value)
    {
        var normalized = NormalizeTemplateName(value);
        return normalized.Contains("AVISO", StringComparison.Ordinal)
               && normalized.Contains("GUARDIA", StringComparison.Ordinal);
    }

    private static string NormalizeTemplateName(string? value)
        => (value ?? string.Empty).Trim().ToUpperInvariant().Replace(" DE ", " ", StringComparison.Ordinal);

    private static string EventColor(CalendarioEventoDto item)
    {
        if (item.Tipo == CalendarioEventoTipos.Guardia)
        {
            var fixedColor = FixedTechnicianColor(item.IdTecnico, item.TecnicoNombre);
            if (!string.IsNullOrWhiteSpace(fixedColor))
                return fixedColor;
        }

        return string.IsNullOrWhiteSpace(item.Color) ? "#14b8a6" : item.Color;
    }

    private static string EventChipStyle(CalendarioEventoDto item)
    {
        var color = EventColor(item);
        return $"--event-color:{color};border-left-color:{color};";
    }

    private static string EventMarkerStyle(CalendarioEventoDto item)
        => $"--event-color:{EventColor(item)};";

    private static string EventMarkerText(CalendarioEventoDto item)
    {
        var source = FirstNonEmpty(item.TecnicoNombre, TypeLabel(item.Tipo), item.Titulo);
        var letters = source
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => x[0].ToString())
            .Take(2)
            .ToArray();

        return letters.Length == 0 ? "?" : string.Concat(letters);
    }

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? string.Empty;

    private static string ReminderLabel(CalendarioRecordatorioDto reminder)
    {
        var when = reminder.FechaHoraProgramada?.ToString("dd/MM HH:mm", Culture) ?? "sin fecha";
        return $"{reminder.EstadoEnvio} - {when}";
    }

    private static string FeedbackText(AppUiMessage? message)
    {
        if (message is null)
            return "Ocurrió un problema inesperado.";

        var parts = new[] { message.Message, message.Suggestion, string.IsNullOrWhiteSpace(message.Code) ? string.Empty : $"Código: {message.Code}" }
            .Where(x => !string.IsNullOrWhiteSpace(x));
        return string.Join(" ", parts);
    }

    private string TechnicianColor(string? idTecnico, string? tecnicoNombre = null)
        => TechnicianColorPalette.Resolve(idTecnico, tecnicoNombre);

    private static string FixedTechnicianColor(string? idTecnico, string? tecnicoNombre = null)
        => TechnicianColorPalette.ResolveFixed(idTecnico, tecnicoNombre);

    private string ColorForTypeOrTechnician(string? tipo, string? idTecnico)
        => tipo switch
        {
            CalendarioEventoTipos.Guardia when !string.IsNullOrWhiteSpace(idTecnico) => TechnicianColor(idTecnico, _tecnicos.FirstOrDefault(x => x.IdTecnico == idTecnico)?.Nombre),
            CalendarioEventoTipos.Vacaciones => "#22c55e",
            CalendarioEventoTipos.Ausencia => "#f472b6",
            CalendarioEventoTipos.Feriado => "#f59e0b",
            CalendarioEventoTipos.Reunion => "#38bdf8",
            CalendarioEventoTipos.Capacitacion => "#a78bfa",
            _ => "#14b8a6"
        };

    private static bool IsCorporateType(string? tipo)
        => tipo is CalendarioEventoTipos.Vacaciones
            or CalendarioEventoTipos.Ausencia
            or CalendarioEventoTipos.Feriado
            or CalendarioEventoTipos.Reunion
            or CalendarioEventoTipos.Capacitacion
            or CalendarioEventoTipos.Otro;

    private static string TypeLabel(string? tipo)
        => tipo switch
        {
            CalendarioEventoTipos.Guardia => "Guardia",
            CalendarioEventoTipos.Vacaciones => "Vacaciones",
            CalendarioEventoTipos.Ausencia => "Ausencia",
            CalendarioEventoTipos.Feriado => "Feriado",
            CalendarioEventoTipos.Reunion => "Reunión",
            CalendarioEventoTipos.Capacitacion => "Capacitación",
            _ => "Otro"
        };

    private static string DefaultTitleForType(string? tipo, string? tecnicoNombre)
        => tipo switch
        {
            CalendarioEventoTipos.Guardia => string.IsNullOrWhiteSpace(tecnicoNombre) ? "GUARDIA" : $"GUARDIA {tecnicoNombre}",
            CalendarioEventoTipos.Vacaciones => string.IsNullOrWhiteSpace(tecnicoNombre) ? "Vacaciones" : $"Vacaciones {tecnicoNombre}",
            CalendarioEventoTipos.Ausencia => string.IsNullOrWhiteSpace(tecnicoNombre) ? "Ausencia" : $"Ausencia {tecnicoNombre}",
            CalendarioEventoTipos.Feriado => "Feriado",
            CalendarioEventoTipos.Reunion => "Reunión",
            CalendarioEventoTipos.Capacitacion => "Capacitación",
            _ => "Evento"
        };

    private static bool IsDefaultEditableTitle(string? titulo)
        => string.IsNullOrWhiteSpace(titulo)
           || string.Equals(titulo, "GUARDIA", StringComparison.OrdinalIgnoreCase)
           || string.Equals(titulo, "Vacaciones", StringComparison.OrdinalIgnoreCase)
           || string.Equals(titulo, "Ausencia", StringComparison.OrdinalIgnoreCase)
           || string.Equals(titulo, "Feriado", StringComparison.OrdinalIgnoreCase)
           || string.Equals(titulo, "Reunión", StringComparison.OrdinalIgnoreCase)
           || string.Equals(titulo, "Capacitación", StringComparison.OrdinalIgnoreCase)
           || string.Equals(titulo, "Evento", StringComparison.OrdinalIgnoreCase);

    private static string FormatUpcomingDate(UpcomingCalendarItem item)
        => item.FechaInicio.Date == item.FechaFin.Date
            ? item.FechaInicio.ToString("dd/MM", Culture)
            : $"{item.FechaInicio.ToString("dd/MM", Culture)} - {item.FechaFin.ToString("dd/MM", Culture)}";

