@page "/calendario"
@page "/{idweb}/{idbase:int}/calendario"
@using System.Globalization
@inject AlfaCore.Services.ICalendarioService CalendarioSvc
@inject AlfaCore.Services.ITecnicosService TecnicosSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPageHeaderService PageHeader
@implements IDisposable

<PageTitle>Calendario | Alfa Gestión</PageTitle>

<section class="calendario-page" @onclick="DismissFeedbackAsync">
    @if (!string.IsNullOrWhiteSpace(_feedbackText))
    {
        <div class="calendario-feedback calendario-feedback--@_feedbackKind">
            <strong>@_feedbackTitle</strong>
            <span>@_feedbackText</span>
        </div>
    }

    <section class="calendario-toolbar" @onclick:stopPropagation>
        <div class="calendario-nav">
            <button type="button" class="btn btn--ghost btn--icon" title="Mes anterior" @onclick="PreviousMonth">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="btn btn--ghost btn--icon" title="Mes siguiente" @onclick="NextMonth">
                <i class="bi bi-chevron-right"></i>
            </button>
            <button type="button" class="btn btn--ghost" @onclick="GoToday">Hoy</button>
            <strong>@MonthLabel</strong>
        </div>

        <button type="button"
                class="@ActiveGuardClass"
                style="--event-color:@ActiveGuardColor"
                @onclick="OpenActiveGuardAsync">
            <span>Guardia activa</span>
            <strong>@ActiveGuardTitle</strong>
        </button>

    </section>

    <section class="calendario-shell">
        <div class="calendario-grid">
            @foreach (var dayName in _dayNames)
            {
                <div class="calendario-weekday">@dayName</div>
            }

            @foreach (var day in Days)
            {
                var dayEvents = EventsFor(day).ToList();
                <button type="button"
                        class="@DayCellClass(day)"
                        @onclick="() => OpenNewEvent(day)">
                    <span class="calendario-day-number">@day.Day</span>
                    <span class="calendario-day-events">
                        @if (dayEvents.Count <= 1)
                        {
                            @foreach (var item in dayEvents)
                            {
                                <span class="calendario-event-chip"
                                      style="@EventChipStyle(item)"
                                      title="@item.Titulo"
                                      @onclick:stopPropagation
                                      @onclick="() => OpenCalendarItem(item)">
                                    <span>@item.Titulo</span>
                                    @if (!string.IsNullOrWhiteSpace(item.TecnicoNombre))
                                    {
                                        <small>@item.TecnicoNombre</small>
                                    }
                                    else
                                    {
                                        <small>@TypeLabel(item.Tipo)</small>
                                    }
                                </span>
                            }
                        }
                        else
                        {
                            <span class="calendario-event-markers">
                                @foreach (var item in dayEvents.Take(12))
                                {
                                    <span class="calendario-event-marker"
                                          style="@EventMarkerStyle(item)"
                                          title="@($"{item.Titulo} - {FirstNonEmpty(item.TecnicoNombre, TypeLabel(item.Tipo))}")"
                                          @onclick:stopPropagation
                                          @onclick="() => OpenCalendarItem(item)">@EventMarkerText(item)</span>
                                }
                                @if (dayEvents.Count > 12)
                                {
                                    <span class="calendario-more">+@(dayEvents.Count - 12)</span>
                                }
                            </span>
                        }
                    </span>
                </button>
            }
        </div>

    </section>

    @if (_loading)
    {
        <div class="calendario-loading">
            <span class="spinner-border spinner-border-sm"></span>
            <span>Cargando calendario...</span>
        </div>
    }
</section>

@if (_showSidePanel)
{
    <button type="button" class="calendario-panel-backdrop" @onclick="CloseSidePanel" aria-label="Cerrar panel lateral"></button>
    <aside class="calendario-side is-open" @onclick:stopPropagation>
        <header class="calendario-side-title">
            <div>
                <span>Calendario</span>
                <strong>Contexto</strong>
            </div>
            <button type="button" class="btn btn--ghost btn--icon" @onclick="CloseSidePanel" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="calendario-mini">
            <strong>@DateTime.Today.ToString("dddd dd", Culture)</strong>
            <span>@DateTime.Today.ToString("MMMM yyyy", Culture)</span>
        </div>

        <section class="calendario-side-section">
            <div class="calendario-side-head">
                <span>Próximamente</span>
                <button type="button" class="calendario-count-button" @onclick="ToggleUpcomingPopover">@UpcomingEvents.Count</button>
            </div>
            @if (UpcomingEvents.Count == 0)
            {
                <p class="calendario-empty">Sin vacaciones, ausencias o feriados en el rango.</p>
            }
            else
            {
                @foreach (var evento in UpcomingEvents.Take(5))
                {
                    <button type="button" class="calendario-side-event" @onclick="() => OpenUpcomingFromPanel(evento)">
                        <span class="calendario-dot" style="background:@evento.Color"></span>
                        <span>
                            <strong>@evento.Titulo</strong>
                            <small>@evento.Tipo · @evento.FechaInicio.ToString("dd/MM", Culture)</small>
                        </span>
                    </button>
                }
            }
        </section>

        <section class="calendario-side-section">
            <div class="calendario-side-head">
                <span>Técnicos</span>
                <small>@_tecnicos.Count</small>
            </div>
            <div class="calendario-technicians">
                @foreach (var tecnico in _tecnicos)
                {
                    <button type="button"
                            class="@(_request.IdTecnico == tecnico.IdTecnico ? "is-active" : string.Empty)"
                            @onclick="() => FilterTechnicianFromPanelAsync(tecnico.IdTecnico)">
                        <span class="calendario-dot" style="background:@TechnicianColor(tecnico.IdTecnico, tecnico.Nombre)"></span>
                        <span>@tecnico.Nombre</span>
                    </button>
                }
            </div>
        </section>
    </aside>
}

@if (_showUpcomingPopover)
{
    <button type="button" class="calendario-upcoming-backdrop" @onclick="ToggleUpcomingPopover" aria-label="Cerrar próximos eventos"></button>
    <section class="calendario-upcoming-popover" @onclick:stopPropagation>
        <header>
            <strong>Lo que se viene</strong>
            <button type="button" class="btn btn--ghost btn--icon" title="Cerrar" @onclick="ToggleUpcomingPopover">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>
        @foreach (var item in UpcomingEvents)
        {
            <button type="button" class="calendario-side-event" @onclick="() => OpenUpcomingFromPanel(item)">
                <span class="calendario-dot" style="background:@item.Color"></span>
                <span>
                    <strong>@item.Titulo</strong>
                    <small>@item.Tipo · @FormatUpcomingDate(item)</small>
                </span>
            </button>
        }
    </section>
}

@if (_showEditor)
{
    <div class="calendario-modal-backdrop" @onclick="CloseEditor"></div>
    <section class="calendario-modal" @onclick:stopPropagation>
        <header>
            <div>
                <span>@(_form.IdEvento > 0 ? "Editar evento" : "Nuevo evento")</span>
                <strong>@(_form.IdEvento > 0 ? _form.Titulo : "Calendario corporativo")</strong>
            </div>
            <button type="button" class="btn btn--ghost btn--icon" @onclick="CloseEditor" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="calendario-form">
            <div class="field field--wide">
                <label>Título</label>
                <input @bind="_form.Titulo" disabled="@_saving" />
            </div>

            <div class="field">
                <label>Tipo</label>
                <select @bind="_form.Tipo" @bind:after="ApplyTypeDefaults" disabled="@_saving">
                    <option value="@CalendarioEventoTipos.Guardia">Guardia</option>
                    <option value="@CalendarioEventoTipos.Vacaciones">Vacaciones</option>
                    <option value="@CalendarioEventoTipos.Ausencia">Ausencia</option>
                    <option value="@CalendarioEventoTipos.Feriado">Feriado</option>
                    <option value="@CalendarioEventoTipos.Reunion">Reunión</option>
                    <option value="@CalendarioEventoTipos.Capacitacion">Capacitación</option>
                    <option value="@CalendarioEventoTipos.Otro">Otro</option>
                </select>
            </div>

            <div class="field">
                <label>Estado</label>
                <select @bind="_form.Estado" disabled="@_saving">
                    <option value="@CalendarioEventoEstados.Borrador">Borrador</option>
                    <option value="@CalendarioEventoEstados.Confirmado">Confirmado</option>
                    <option value="@CalendarioEventoEstados.Cancelado">Cancelado</option>
                    <option value="@CalendarioEventoEstados.Finalizado">Finalizado</option>
                </select>
            </div>

            <div class="field">
                <label>Inicio</label>
                <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_form.FechaInicio" @bind-Value:after="ApplyStartDefaults" disabled="@_saving" />
            </div>

            <div class="field">
                <label>Fin</label>
                <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_form.FechaFin" disabled="@_saving" />
            </div>

            <label class="checkbox calendario-checkbox">
                <input type="checkbox" @bind="_form.TodoElDia" disabled="@_saving" />
                <span>Todo el día</span>
            </label>

            <div class="field">
                <label>Técnico responsable</label>
                <select value="@_form.IdTecnico" @onchange="OnTechnicianChangedAsync" disabled="@_saving">
                    <option value="">Sin asignar</option>
                    @foreach (var tecnico in _tecnicos)
                    {
                        <option value="@tecnico.IdTecnico">@tecnico.Nombre</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>WhatsApp del técnico</label>
                <input @bind="_form.TelefonoWhatsApp" disabled="@_saving" placeholder="549..." />
            </div>

            <div class="field">
                <label>Color</label>
                <input type="color" @bind="_form.Color" disabled="@_saving" />
            </div>

            <div class="field field--wide">
                <label>Descripción</label>
                <textarea @bind="_form.Descripcion" disabled="@_saving"></textarea>
            </div>

            <section class="calendario-reminder">
                <label class="checkbox calendario-checkbox">
                    <input type="checkbox" @bind="_form.CrearRecordatorioWhatsApp" disabled="@_saving" />
                    <span>Recordatorio por WhatsApp</span>
                </label>

                <div class="field">
                    <label>Recordar antes</label>
                    <select @bind="_form.MinutosAntesRecordatorio" disabled="@(!_form.CrearRecordatorioWhatsApp || _saving)">
                        <option value="60">1 hora</option>
                        <option value="720">12 horas</option>
                        <option value="1440">1 día</option>
                        <option value="2880">2 días</option>
                    </select>
                </div>

                <div class="field">
                    <label>Plantilla WhatsApp</label>
                    <select @bind="_form.IdPlantillaWhatsApp" disabled="@(!_form.CrearRecordatorioWhatsApp || _saving)">
                        <option value="">Sin plantilla</option>
                        @foreach (var plantilla in _plantillas)
                        {
                            <option value="@plantilla.IdPlantilla">@plantilla.NombreVisible</option>
                        }
                    </select>
                </div>

                @if (_selectedEvent?.Recordatorio is not null)
                {
                    <div class="calendario-reminder-state">
                        <span>@ReminderLabel(_selectedEvent.Recordatorio)</span>
                        <button type="button"
                                class="btn btn--ghost"
                                disabled="@_saving"
                                @onclick="SendReminderAsync">
                            <i class="bi bi-whatsapp"></i>
                            <span>Enviar ahora</span>
                        </button>
                    </div>
                }
            </section>
        </div>

        <footer>
            @if (_form.IdEvento > 0)
            {
                <button type="button" class="btn btn--ghost" @onclick="DeleteAsync" disabled="@_saving">
                    <i class="bi bi-trash"></i>
                    <span>Eliminar</span>
                </button>
            }
            <span></span>
            <button type="button" class="btn btn--ghost" @onclick="CloseEditor" disabled="@_saving">Cancelar</button>
            <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                <i class="bi bi-save"></i>
                <span>@(_saving ? "Guardando..." : "Guardar")</span>
            </button>
        </footer>
    </section>
}

@if (_selectedHolidayInfo is not null)
{
    <div class="calendario-modal-backdrop" @onclick="CloseHolidayInfo"></div>
    <section class="calendario-modal calendario-modal--info" @onclick:stopPropagation>
        <header>
            <div>
                <span>Feriado oficial</span>
                <strong>@_selectedHolidayInfo.Titulo</strong>
            </div>
            <button type="button" class="btn btn--ghost btn--icon" @onclick="CloseHolidayInfo" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="calendario-form">
            <div class="field field--wide">
                <label>Fecha</label>
                <input value="@FormatUpcomingDate(_selectedHolidayInfo)" readonly />
            </div>
            <div class="field field--wide">
                <label>Tipo</label>
                <input value="@_selectedHolidayInfo.Tipo" readonly />
            </div>
            <div class="field field--wide">
                <label>Detalle</label>
                <textarea readonly>Feriado nacional de Argentina cargado como referencia del calendario oficial.</textarea>
            </div>
        </div>

        <footer>
            <span></span>
            <button type="button" class="btn btn--primary" @onclick="CloseHolidayInfo">Cerrar</button>
        </footer>
    </section>
}

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("es-AR");
    private readonly string[] _dayNames = ["Lun", "Mar", "Mie", "Jue", "Vie", "Sab", "Dom"];
    private CalendarioMonthRequest _request = new();
    private List<CalendarioEventoDto> _events = [];
    private List<ConversacionTecnicoOptionDto> _tecnicos = [];
    private List<ConversacionPlantillaDto> _plantillas = [];
    private CalendarioEventoDto? _selectedEvent;
    private UpcomingCalendarItem? _selectedHolidayInfo;
    private CalendarioEventoSaveRequest _form = NewForm(DateTime.Today);
    private bool _loading;
    private bool _saving;
    private bool _showEditor;
    private bool _showSidePanel;
    private bool _showHeaderFilters;
    private bool _showUpcomingPopover;
    private string _feedbackTitle = string.Empty;
    private string _feedbackText = string.Empty;
    private string _feedbackKind = "success";
    private CancellationTokenSource? _searchCts;

    private string MonthLabel => new DateTime(_request.Year, _request.Month, 1).ToString("MMMM yyyy", Culture);
    private IEnumerable<DateTime> Days => Enumerable.Range(0, 42).Select(i => GridStart.AddDays(i));
    private DateTime GridStart
    {
        get
        {
            var monthStart = new DateTime(_request.Year, _request.Month, 1);
            return monthStart.AddDays(-(((int)monthStart.DayOfWeek + 6) % 7));
        }
    }
    private List<CalendarioEventoDto> CorporateEvents => _events
        .Where(x => IsCorporateType(x.Tipo) && x.Estado != CalendarioEventoEstados.Cancelado)
        .OrderBy(x => x.FechaInicio)
        .Take(10)
        .ToList();
    private List<CalendarioEventoDto> OfficialHolidayEvents => OfficialArgentinaHolidays
        .Select(x => new CalendarioEventoDto
        {
            IdEvento = 0,
            Titulo = x.Titulo,
            Tipo = CalendarioEventoTipos.Feriado,
            FechaInicio = x.FechaInicio,
            FechaFin = x.FechaFin,
            TodoElDia = true,
            Estado = CalendarioEventoEstados.Confirmado,
            Color = x.Color,
            Descripcion = "Feriado oficial de Argentina."
        })
        .ToList();
    private List<UpcomingCalendarItem> UpcomingEvents
    {
        get
        {
            var monthStart = new DateTime(_request.Year, _request.Month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);
            var allUpcoming = CorporateEvents
                .Select(UpcomingCalendarItem.FromEvent)
                .Concat(OfficialArgentinaHolidays)
                .Where(x => x.FechaFin.Date >= DateTime.Today.Date)
                .OrderBy(x => x.FechaInicio)
                .ToList();

            var currentMonth = allUpcoming
                .Where(x => x.FechaInicio.Date <= monthEnd && x.FechaFin.Date >= monthStart)
                .Take(14)
                .ToList();

            return currentMonth.Count > 0
                ? currentMonth
                : allUpcoming.Take(5).ToList();
        }
    }
    private CalendarioEventoDto? CurrentGuard => _events
        .Where(x => x.Tipo == CalendarioEventoTipos.Guardia
                    && x.Estado != CalendarioEventoEstados.Cancelado
                    && x.FechaInicio.Date <= DateTime.Today
                    && x.FechaFin.Date >= DateTime.Today)
        .OrderBy(x => x.FechaInicio)
        .FirstOrDefault();
    private string ActiveGuardTitle => CurrentGuard is null
        ? "Sin guardia activa"
        : FirstNonEmpty(CurrentGuard.TecnicoNombre, CurrentGuard.Titulo);
    private string ActiveGuardColor => CurrentGuard is null ? "rgba(148, 163, 184, .7)" : EventColor(CurrentGuard);
    private string ActiveGuardClass => CurrentGuard is null
        ? "calendario-active-guard is-empty"
        : "calendario-active-guard";

    protected override async Task OnInitializedAsync()
    {
        UpdatePageHeader();
        await LoadAsync();
        UpdatePageHeader();
    }

    public void Dispose()
    {
        PageHeader.Clear();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await UiOps.RunAsync(() => CalendarioSvc.GetMonthAsync(_request), "No se pudo cargar el calendario.");
        if (result.Success && result.Value is not null)
        {
            _events = result.Value.Eventos;
            _tecnicos = result.Value.Tecnicos;
            _plantillas = result.Value.PlantillasWhatsApp;
            UpdatePageHeader();
        }
        else
        {
            SetFeedback("No se pudo cargar el calendario", FeedbackText(result.Feedback), "error");
        }

        _loading = false;
    }

    private async Task PreviousMonth()
    {
        var current = new DateTime(_request.Year, _request.Month, 1).AddMonths(-1);
        _request.Year = current.Year;
        _request.Month = current.Month;
        await LoadAsync();
    }

    private async Task NextMonth()
    {
        var current = new DateTime(_request.Year, _request.Month, 1).AddMonths(1);
        _request.Year = current.Year;
        _request.Month = current.Month;
        await LoadAsync();
    }

    private async Task GoToday()
    {
        _request.Year = DateTime.Today.Year;
        _request.Month = DateTime.Today.Month;
        await LoadAsync();
    }

    private async Task FilterTechnicianAsync(string idTecnico)
    {
        _request.IdTecnico = _request.IdTecnico == idTecnico ? null : idTecnico;
        await LoadAsync();
    }

    private async Task FilterTechnicianFromPanelAsync(string idTecnico)
    {
        await FilterTechnicianAsync(idTecnico);
        _showSidePanel = false;
        UpdatePageHeader();
    }

    private RenderFragment RenderCalendarSmartSearch() => @<div class="smart-search calendario-header-search" @onclick:stopPropagation>
        <div class="smart-search__bar">
            <i class="bi bi-search"></i>
            <input type="search"
                   placeholder="Evento, técnico o descripción..."
                   value="@_request.Search"
                   @oninput="OnSearchInput" />
            <button type="button" class="smart-search__toggle @(_showHeaderFilters ? "is-active" : string.Empty)" title="Filtros" aria-label="Filtros" @onclick="ToggleHeaderFilters">
                <i class="bi @(_showHeaderFilters ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        <div class="smart-search__chips" aria-live="polite">
            @if (!string.IsNullOrWhiteSpace(_request.Search))
            {
                <button type="button" class="smart-chip" @onclick="ClearSearchAsync">
                    Texto <i class="bi bi-x"></i>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(_request.IdTecnico))
            {
                <button type="button" class="smart-chip" @onclick="async () => { _request.IdTecnico = null; await LoadAsync(); UpdatePageHeader(); }">
                    @TechnicianFilterLabel <i class="bi bi-x"></i>
                </button>
            }
            @if (!string.Equals(_request.Tipo, CalendarioEventoTipos.Todos, StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="smart-chip" @onclick="async () => { _request.Tipo = CalendarioEventoTipos.Todos; await LoadAsync(); UpdatePageHeader(); }">
                    @TypeLabel(_request.Tipo) <i class="bi bi-x"></i>
                </button>
            }
        </div>

        @if (_showHeaderFilters)
        {
            <div class="smart-search__panel calendario-header-search__panel" @onclick:stopPropagation>
                <div class="smart-search__column">
                    <h4><i class="bi bi-person"></i> Técnico</h4>
                    <select value="@_request.IdTecnico" @onchange="SetHeaderTechnicianAsync">
                        <option value="">Todos los técnicos</option>
                        @foreach (var tecnico in _tecnicos)
                        {
                            <option value="@tecnico.IdTecnico">@tecnico.Nombre</option>
                        }
                    </select>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-tags"></i> Tipo</h4>
                    <select value="@_request.Tipo" @onchange="SetHeaderTypeAsync">
                        <option value="@CalendarioEventoTipos.Todos">Todos los tipos</option>
                        <option value="@CalendarioEventoTipos.Guardia">Guardias</option>
                        <option value="@CalendarioEventoTipos.Vacaciones">Vacaciones</option>
                        <option value="@CalendarioEventoTipos.Ausencia">Ausencias</option>
                        <option value="@CalendarioEventoTipos.Feriado">Feriados</option>
                        <option value="@CalendarioEventoTipos.Reunion">Reuniones</option>
                        <option value="@CalendarioEventoTipos.Capacitacion">Capacitaciones</option>
                        <option value="@CalendarioEventoTipos.Otro">Otros</option>
                    </select>
                    <button type="button" class="smart-option" @onclick="ResetHeaderFiltersAsync">
                        <i class="bi bi-x-circle"></i> Limpiar filtros
                    </button>
                </div>
            </div>
        }
    </div>;

    private string TechnicianFilterLabel
        => _tecnicos.FirstOrDefault(x => x.IdTecnico == _request.IdTecnico)?.Nombre
           ?? _request.IdTecnico
           ?? "Técnico";

    private void UpdatePageHeader()
    {
        PageHeader.Set(new PageHeaderConfig
        {
            Title = "Calendario",
            Breadcrumb = ["Calendario"],
            State = _loading ? PageHeaderState.Loading : PageHeaderState.List,
            Search = new PageHeaderSearchConfig(),
            SearchContent = RenderCalendarSmartSearch(),
            Actions =
            [
                new PageHeaderAction
                {
                    Key = "nuevo",
                    Label = "Nuevo",
                    Icon = "bi-plus-circle",
                    Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential,
                    OnClick = OpenNewEventFromHeaderAsync
                },
                new PageHeaderAction
                {
                    Key = "panel",
                    Label = "Panel",
                    Icon = "bi-layout-sidebar-inset-reverse",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential,
                    OnClick = ToggleSidePanelFromHeaderAsync
                }
            ]
        });
    }

    private void ToggleSidePanel()
    {
        _showSidePanel = !_showSidePanel;
        UpdatePageHeader();
    }

    private async Task ToggleSidePanelFromHeaderAsync()
    {
        _showSidePanel = !_showSidePanel;
        UpdatePageHeader();
        await InvokeAsync(StateHasChanged);
    }

    private void CloseSidePanel()
    {
        _showSidePanel = false;
        _showUpcomingPopover = false;
    }

    private void ToggleUpcomingPopover()
        => _showUpcomingPopover = !_showUpcomingPopover;

    private void ToggleHeaderFilters()
    {
        _showHeaderFilters = !_showHeaderFilters;
        UpdatePageHeader();
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _request.Search = args.Value?.ToString() ?? string.Empty;
        UpdatePageHeader();
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(260, token);
            if (!token.IsCancellationRequested)
                await LoadAsync();
        }
        catch (TaskCanceledException) { }
    }

