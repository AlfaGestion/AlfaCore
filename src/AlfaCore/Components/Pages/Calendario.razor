    private IEnumerable<CalendarioEventoDto> EventsFor(DateTime day)
        => _events
            .Concat(OfficialHolidayEvents.Where(ShouldShowOfficialHoliday))
            .Where(x => x.FechaInicio.Date <= day.Date && x.FechaFin.Date >= day.Date)
            .OrderBy(x => x.FechaInicio)
            .ThenBy(x => x.Tipo == CalendarioEventoTipos.Feriado ? 0 : 1)
            .ThenBy(x => x.Titulo);

    private bool ShouldShowOfficialHoliday(CalendarioEventoDto item)
    {
        if (_request.Tipo != CalendarioEventoTipos.Todos && _request.Tipo != CalendarioEventoTipos.Feriado)
            return false;
        if (!string.IsNullOrWhiteSpace(_request.IdTecnico))
            return false;
        if (string.IsNullOrWhiteSpace(_request.Search))
            return true;

        var search = _request.Search.Trim();
        return item.Titulo.Contains(search, StringComparison.OrdinalIgnoreCase)
               || item.Descripcion.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private string DayCellClass(DateTime day)
    {
        var classes = "calendario-day";
        if (day.Month != _request.Month) classes += " is-muted";
        if (day.Date == DateTime.Today) classes += " is-today";
        return classes;
    }

