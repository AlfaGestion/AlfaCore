    private async Task SaveAsync()
    {
        _saving = true;
        _form.UsuarioAccion = CurrentUserName;
        _form.SistemaAccion = "Calendario";
        var result = await UiOps.RunAsync(() => CalendarioSvc.SaveAsync(_form), "No se pudo guardar el evento.");
        if (result.Success)
        {
            SetFeedback("Evento guardado", "Los cambios quedaron registrados.", "success");
            _showEditor = false;
            await LoadAsync();
        }
        else
        {
            SetFeedback("No se pudo guardar", FeedbackText(result.Feedback), "error");
        }

        _saving = false;
    }

    private async Task DeleteAsync()
    {
        if (_form.IdEvento <= 0)
            return;

        _saving = true;
        var result = await UiOps.RunAsync(() => CalendarioSvc.DeleteAsync(_form.IdEvento, CurrentUserName), "No se pudo eliminar el evento.");
        if (result.Success)
        {
            SetFeedback("Evento eliminado", "El evento fue dado de baja.", "success");
            _showEditor = false;
            await LoadAsync();
        }
        else
        {
            SetFeedback("No se pudo eliminar", FeedbackText(result.Feedback), "error");
        }

        _saving = false;
    }

    private async Task SendReminderAsync()
    {
        var reminderId = _selectedEvent?.Recordatorio?.IdRecordatorio ?? 0;
        if (reminderId <= 0)
            return;

        _saving = true;
        var result = await UiOps.RunAsync(() => CalendarioSvc.SendWhatsAppReminderAsync(reminderId, CurrentUserName), "No se pudo enviar el recordatorio.");
        if (result.Success)
        {
            SetFeedback("Recordatorio enviado", "Se envió la plantilla de WhatsApp al técnico.", "success");
            _showEditor = false;
            await LoadAsync();
        }
        else
        {
            SetFeedback("No se pudo enviar", FeedbackText(result.Feedback), "error");
        }

        _saving = false;
    }

    private async Task OnTechnicianChangedAsync(ChangeEventArgs args)
    {
        var id = args.Value?.ToString() ?? string.Empty;
        _form.IdTecnico = id;
        var tecnico = _tecnicos.FirstOrDefault(x => x.IdTecnico == id);
        _form.TecnicoNombre = tecnico?.Nombre;
        if (string.IsNullOrWhiteSpace(id))
        {
            _form.TelefonoWhatsApp = string.Empty;
        }
        else
        {
            var detail = await UiOps.RunAsync(() => TecnicosSvc.GetByIdAsync(id), "No se pudo cargar el teléfono del técnico.");
            if (detail.Success && detail.Value is not null && !string.IsNullOrWhiteSpace(detail.Value.Telefono))
            {
                _form.TelefonoWhatsApp = detail.Value.Telefono.Trim();
            }
            else if (!detail.Success)
            {
                SetFeedback("No se pudo cargar el teléfono", FeedbackText(detail.Feedback), "error");
            }
        }

        if (tecnico is not null && IsDefaultEditableTitle(_form.Titulo))
            _form.Titulo = DefaultTitleForType(_form.Tipo, tecnico.Nombre);
        _form.Color = ColorForTypeOrTechnician(_form.Tipo, id);
    }

    private void ApplyTypeDefaults()
    {
        if (_form.Tipo == CalendarioEventoTipos.Guardia)
        {
            ApplyGuardiaDefaults();
        }

        if (_form.Tipo == CalendarioEventoTipos.Vacaciones || _form.Tipo == CalendarioEventoTipos.Ausencia || _form.Tipo == CalendarioEventoTipos.Feriado)
        {
            _form.TodoElDia = true;
            _form.CrearRecordatorioWhatsApp = false;
            if (_form.FechaFin <= _form.FechaInicio)
                _form.FechaFin = _form.FechaInicio.Date.AddDays(1).AddHours(9);
        }

        if (IsDefaultEditableTitle(_form.Titulo))
            _form.Titulo = DefaultTitleForType(_form.Tipo, _form.TecnicoNombre);

        _form.Color = ColorForTypeOrTechnician(_form.Tipo, _form.IdTecnico);
    }

    private void ApplyStartDefaults()
    {
        if (_form.Tipo == CalendarioEventoTipos.Guardia)
            ApplyGuardiaDefaults();
    }

    private void ApplyGuardiaDefaults()
    {
        _form.TodoElDia = true;
        _form.CrearRecordatorioWhatsApp = true;
        _form.FechaInicio = GuardiaStart(_form.FechaInicio);
        _form.FechaFin = GuardiaEnd(_form.FechaInicio);
        ApplyGuardiaTemplateDefault();
    }

    private void ApplyGuardiaTemplateDefault()
    {
        if (_form.Tipo != CalendarioEventoTipos.Guardia || _plantillas.Count == 0)
            return;

        var plantilla = _plantillas.FirstOrDefault(x => IsGuardiaTemplateExact(x.NombreVisible) || IsGuardiaTemplateExact(x.NombreMeta))
            ?? _plantillas.FirstOrDefault(x => IsGuardiaTemplateFallback(x.NombreVisible) || IsGuardiaTemplateFallback(x.NombreMeta));
        if (plantilla is not null)
            _form.IdPlantillaWhatsApp = plantilla.IdPlantilla;
    }

