            ? "Compartida con todos"
            : users.Count == 0
                ? "Sin compartir"
                : $"Compartida con {string.Join(", ", users)}";

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity == AppUiFeedbackSeverity.Success ? "editor-msg--success" : message.Severity == AppUiFeedbackSeverity.Warning ? "editor-msg--warning" : "editor-msg--error";

    private static string GetFeedbackIcon(AppUiMessage message)
        => message.Severity == AppUiFeedbackSeverity.Warning ? "bi-exclamation-triangle-fill" : message.Severity == AppUiFeedbackSeverity.Success ? "bi-check-circle-fill" : "bi-x-circle-fill";

    private sealed record AssignedFilterOption(string Value, string Label, string Icon);

    private sealed class PendingTaskAttachment
    {
        public string Id { get; set; } = string.Empty;
        public string NombreArchivo { get; set; } = string.Empty;
        public string MimeType { get; set; } = string.Empty;
        public long TamanoBytes { get; set; }
        public byte[] Contenido { get; set; } = [];
        public string ContenidoBase64 { get; set; } = string.Empty;

        public TareaAdjuntoUploadDto ToUpload()
            => new()
            {
                NombreArchivo = NombreArchivo,
                MimeType = MimeType,
                TamanoBytes = TamanoBytes,
                Contenido = Contenido
            };
    }

}
