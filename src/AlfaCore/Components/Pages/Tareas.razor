    {
        if (_dragOverListId == idLista)
            _dragOverListId = null;
    }

    private void ClearTaskDrag()
    {
        _draggingTaskId = null;
        _dragOverListId = null;
    }

    private async Task MoveDraggedTaskToListAsync(TareaListaDto lista)
    {
        if (_draggingTaskId is not long idTarea)
            return;

        var tarea = _page.Tareas.Concat(_page.Completadas).FirstOrDefault(x => x.IdTarea == idTarea);
        if (tarea is null || tarea.IdLista == lista.IdLista)
        {
            ClearTaskDrag();
            return;
        }

        var result = await UiOps.RunAsync(async () =>
        {
            await TareasSvc.MoveTaskToListAsync(idTarea, lista.IdLista, CurrentUser);
            return true;
        }, "No se pudo mover la tarea.");

        _feedback = result.Feedback;
        ClearTaskDrag();
        if (result.Success)
            await LoadAsync();
    }

