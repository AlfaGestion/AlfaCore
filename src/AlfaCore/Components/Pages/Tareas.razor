    private async Task DeleteListAsync(TareaListaDto lista)
    {
        if (!lista.EsPropia)
        {
            _feedback = BuildWarning("No se puede eliminar", "No sos dueño de esta lista. Solo el propietario puede eliminarla.");
            return;
        }

        if (lista.EsDefault)
        {
            _feedback = BuildWarning("No se puede eliminar", "La lista Mis tareas no se puede eliminar.");
            return;
        }

        var result = await UiOps.RunAsync(async () =>
        {
            await TareasSvc.DeleteListAsync(lista.IdLista, CurrentUser);
            return true;
        }, "No se pudo eliminar la lista.");
        _feedback = result.Feedback;
        if (result.Success)
        {
            if (_selectedListId == lista.IdLista) _selectedListId = null;
            await LoadAsync();
        }
    }

    private void OpenNewTask()
    {
        var title = NormalizeTaskTitle(_quickTaskTitle);
        _taskDraft = new TareaSaveRequest
        {
            IdLista = _selectedListId ?? DefaultListId,
            Titulo = title,
            UsuarioAsignado = CurrentUser,
            UsuarioAccion = CurrentUser,
            UsuariosCompartidos = [],
            Estado = TareaEstadoKeys.Pendiente,
            Prioridad = TareaPrioridadKeys.Media
        };
        _taskAttachments = [];
        _pendingTaskAttachments = [];
        _loadingTaskAttachments = false;
        _attachmentPickerVersion++;
        _taskCanShare = true;
        _taskSharePanelOpen = false;
        _taskDraftSnapshot = CreateTaskDraftSnapshot();
        _showTaskModal = true;
    }

    private static string NormalizeTaskTitle(string? title)
        => string.Join(" ", (title ?? string.Empty).Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries));

    private TareaDraftSnapshot CreateTaskDraftSnapshot()
        => new(
            _taskDraft.IdTarea,
            _taskDraft.IdLista,
            NormalizeTaskTitle(_taskDraft.Titulo),
            (_taskDraft.Descripcion ?? string.Empty).Trim(),
            _taskDraft.FechaVencimiento?.Date,
            (_taskDraft.UsuarioAsignado ?? string.Empty).Trim(),
            _taskDraft.Estado,
            NormalizePriorityForUi(_taskDraft.Prioridad),
            _taskDraft.CompartirConTodos,
            _taskDraft.UsuariosCompartidos
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
                .ToArray());

    private bool HasUnsavedTaskModalChanges()
    {
        if (_taskDraftSnapshot is null)
            return false;

        if (_pendingTaskAttachments.Count > 0)
            return true;

        var current = CreateTaskDraftSnapshot();
        return current.IdTarea != _taskDraftSnapshot.IdTarea
               || current.IdLista != _taskDraftSnapshot.IdLista
               || !string.Equals(current.Titulo, _taskDraftSnapshot.Titulo, StringComparison.Ordinal)
               || !string.Equals(current.Descripcion, _taskDraftSnapshot.Descripcion, StringComparison.Ordinal)
               || current.FechaVencimiento != _taskDraftSnapshot.FechaVencimiento
               || !string.Equals(current.UsuarioAsignado, _taskDraftSnapshot.UsuarioAsignado, StringComparison.OrdinalIgnoreCase)
               || !string.Equals(current.Estado, _taskDraftSnapshot.Estado, StringComparison.Ordinal)
               || !string.Equals(current.Prioridad, _taskDraftSnapshot.Prioridad, StringComparison.Ordinal)
               || current.CompartirConTodos != _taskDraftSnapshot.CompartirConTodos
               || !current.UsuariosCompartidos.SequenceEqual(_taskDraftSnapshot.UsuariosCompartidos, StringComparer.OrdinalIgnoreCase);
    }

