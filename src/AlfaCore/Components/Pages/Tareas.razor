    private async Task HandleTaskFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        var added = 0;
        foreach (var file in args.GetMultipleFiles())
        {
            if (!IsAllowedAttachment(file.ContentType))
            {
                _feedback = BuildWarning("Adjunto no permitido", "Solo se permiten imágenes, audios y videos.");
                continue;
            }

            if (file.Size > MaxAttachmentBytes)
            {
                _feedback = BuildWarning("Adjunto demasiado grande", "Cada adjunto puede pesar como máximo 50 MB.");
                continue;
            }

            try
            {
                await using var source = file.OpenReadStream(MaxAttachmentBytes);
                using var buffer = new MemoryStream();
                await source.CopyToAsync(buffer);
                var bytes = buffer.ToArray();
                _pendingTaskAttachments.Add(new PendingTaskAttachment
                {
                    Id = Guid.NewGuid().ToString("N"),
                    NombreArchivo = file.Name,
                    MimeType = file.ContentType,
                    TamanoBytes = file.Size,
                    Contenido = bytes,
                    ContenidoBase64 = Convert.ToBase64String(bytes)
                });
                added++;
            }
            catch
            {
                _feedback = BuildWarning("No se pudo adjuntar", $"No se pudo leer {file.Name}.");
            }
        }

        if (added > 0)
            _feedback = AppUiMessage.Success("Adjuntos listos", $"{added} adjunto(s) se guardarán con la tarea.");
        _attachmentPickerVersion++;
    }

