    private void ToggleShareUser(string user, ChangeEventArgs args)
    {
        var selected = Convert.ToBoolean(args.Value);
        if (selected && !_shareUsers.Contains(user, StringComparer.OrdinalIgnoreCase))
            _shareUsers.Add(user);
