    private static bool IsAllowedAttachment(string? mimeType)
        => !string.IsNullOrWhiteSpace(mimeType)
           && (mimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
               || mimeType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)
               || mimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase));

    private static string GetAttachmentDataUrl(TareaAdjuntoDto adjunto)
        => $"data:{adjunto.MimeType};base64,{adjunto.ContenidoBase64}";

    private static string GetAttachmentDataUrl(PendingTaskAttachment adjunto)
        => $"data:{adjunto.MimeType};base64,{adjunto.ContenidoBase64}";

    private RenderFragment RenderAttachmentPreview(string mimeType, string dataUrl, string label) => builder =>
    {
        if (mimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(0, "button");
            builder.AddAttribute(1, "type", "button");
            builder.AddAttribute(2, "class", "tareas-attachment-card__image");
            builder.AddAttribute(3, "title", "Ver imagen");
            builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => OpenImagePreview(dataUrl, label)));
            builder.OpenElement(5, "img");
            builder.AddAttribute(6, "src", dataUrl);
            builder.AddAttribute(7, "alt", label);
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (mimeType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(8, "audio");
            builder.AddAttribute(9, "controls", true);
            builder.AddAttribute(10, "src", dataUrl);
            builder.CloseElement();
            return;
        }

        if (mimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(11, "video");
            builder.AddAttribute(12, "controls", true);
            builder.AddAttribute(13, "src", dataUrl);
            builder.CloseElement();
            return;
        }

        builder.OpenElement(14, "div");
        builder.AddAttribute(15, "class", "tareas-attachment-card__fallback");
        builder.OpenElement(16, "i");
        builder.AddAttribute(17, "class", "bi bi-file-earmark-play");
        builder.CloseElement();
        builder.CloseElement();
    };

