            if (_pendingTaskAttachments.Count > 0)
            {
                await TareasSvc.AddTaskAttachmentsAsync(
                    idTarea,
                    _pendingTaskAttachments.Select(x => x.ToUpload()).ToList(),
                    CurrentUser);
