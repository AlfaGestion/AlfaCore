    private static string GetFieldOptionClass<T>(T currentValue, T optionValue)
        => EqualityComparer<T>.Default.Equals(currentValue, optionValue)
            ? "tareas-field-option is-selected"
            : "tareas-field-option";

    private static bool IsFieldOptionSelected<T>(T currentValue, T optionValue)
        => EqualityComparer<T>.Default.Equals(currentValue, optionValue);

    private static string GetPriorityIcon(string? prioridad)
        => NormalizePriorityForUi(prioridad) switch
        {
            TareaPrioridadKeys.Alta => "bi-exclamation-circle-fill",
            TareaPrioridadKeys.Baja => "bi-arrow-down-circle",
            _ => "bi-dash-circle"
        };

    private static string GetPriorityBadgeClass(string? prioridad)
        => $"tareas-priority-badge tareas-priority-badge--{GetPriorityCssSuffix(prioridad)}";

    private static string GetPriorityCssSuffix(string? prioridad)
        => NormalizePriorityForUi(prioridad).ToLowerInvariant();

    private static string NormalizePriorityForUi(string? prioridad)
    {
        var value = (prioridad ?? string.Empty).Trim().ToUpperInvariant();
        return TareaPrioridadKeys.All.Contains(value, StringComparer.Ordinal) ? value : TareaPrioridadKeys.Media;
    }

    private static string NormalizeStateForUi(string? estado)
    {
        var value = (estado ?? string.Empty).Trim().ToUpperInvariant();
        return TareaEstadoKeys.All.Contains(value, StringComparer.Ordinal) ? value : TareaEstadoKeys.Pendiente;
    }

    private static int GetPriorityRank(string? prioridad)
        => NormalizePriorityForUi(prioridad) switch
        {
            TareaPrioridadKeys.Alta => 0,
            TareaPrioridadKeys.Media => 1,
            _ => 2
        };

    private static string[] ParseAssignees(string? value)
        => (value ?? string.Empty)
            .Split([',', ';', '|'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static bool AssignmentHasExact(string? assignedTo, string assignee)
        => ParseAssignees(assignedTo).Any(x => string.Equals(x, assignee, StringComparison.OrdinalIgnoreCase));

    private bool AssignmentMatchesFilter(string? assignedTo, string assignee)
    {
        var assignees = ParseAssignees(assignedTo);
        if (assignees.Any(x => string.Equals(x, assignee, StringComparison.OrdinalIgnoreCase)))
            return true;

        if (IsGroupAssignee(assignee) || string.Equals(assignee, EveryoneAssignee, StringComparison.OrdinalIgnoreCase))
            return false;

        return assignees.Any(x => string.Equals(x, EveryoneAssignee, StringComparison.OrdinalIgnoreCase))
            || _page.Grupos.Any(group =>
                group.Usuarios.Contains(assignee, StringComparer.OrdinalIgnoreCase)
                && assignees.Any(x => string.Equals(x, group.Grupo, StringComparison.OrdinalIgnoreCase)));
    }

    private static string GetAssigneeSummary(string? assignedTo)
    {
        var assignees = ParseAssignees(assignedTo);
        return assignees.Length == 0 ? "Sin asignar" : string.Join(", ", assignees);
    }

    private bool IsAssigneeSelected(string assignee)
        => AssignmentHasExact(_taskDraft.UsuarioAsignado, assignee);

    private string GetAssigneeOptionClass(string assignee)
    {
        var classes = "tareas-assignment-option";
        if (IsGroupLikeAssignee(assignee))
            classes += " is-group";
        if (IsAssigneeSelected(assignee))
            classes += " is-selected";
        return classes;
    }

    private bool IsGroupLikeAssignee(string assignee)
        => string.Equals(assignee, EveryoneAssignee, StringComparison.OrdinalIgnoreCase)
           || IsGroupAssignee(assignee);

    private void ToggleAssigneeSelection(string assignee)
    {
        var values = ParseAssignees(_taskDraft.UsuarioAsignado).ToList();
        if (values.Contains(assignee, StringComparer.OrdinalIgnoreCase))
            values.RemoveAll(x => string.Equals(x, assignee, StringComparison.OrdinalIgnoreCase));
        else
            values.Add(assignee);

        _taskDraft.UsuarioAsignado = string.Join(", ", values);
    }

    private void ToggleAssignee(string assignee, ChangeEventArgs args)
    {
        var selected = Convert.ToBoolean(args.Value);
        var values = ParseAssignees(_taskDraft.UsuarioAsignado).ToList();

        if (selected && !values.Contains(assignee, StringComparer.OrdinalIgnoreCase))
            values.Add(assignee);
        if (!selected)
            values.RemoveAll(x => string.Equals(x, assignee, StringComparison.OrdinalIgnoreCase));

        _taskDraft.UsuarioAsignado = string.Join(", ", values);
    }

    private bool IsGroupAssignee(string value)
        => _page.Grupos.Any(x => string.Equals(x.Grupo, value, StringComparison.OrdinalIgnoreCase));

    private void OpenGroupsModal()
    {
        _groupDrafts = _page.Grupos
            .Select(group => new TareaGrupoDto
            {
                Grupo = group.Grupo,
                Usuarios = group.Usuarios.ToList()
            })
            .OrderBy(x => x.Grupo)
            .ToList();
        _newGroupName = string.Empty;
        _assigneeMenuOpen = false;
        _showGroupsModal = true;
