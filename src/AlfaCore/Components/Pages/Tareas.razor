            : _page.Listas.FirstOrDefault(x => x.IdLista == _selectedListId)?.Nombre ?? "Lista";

    private List<TareaItemDto> FilteredTasks => _page.Tareas
        .Where(MatchesCurrentFilters)
        .OrderBy(x => GetPriorityRank(x.Prioridad))
        .ThenBy(x => x.FechaVencimiento is null)
        .ThenBy(x => x.FechaVencimiento)
        .ThenByDescending(x => x.FechaHoraAlta)
        .ToList();

    private List<TareaItemDto> FilteredCompleted => _page.Completadas
        .Where(MatchesCurrentFilters)
        .ToList();

    private IReadOnlyList<string> AssigneeOptions
    {
        get
        {
            var groupValues = new[] { EveryoneAssignee }
                .Concat(_page.Grupos.Select(x => x.Grupo))
                .Concat(ParseAssignees(_taskDraft.UsuarioAsignado).Where(IsGroupLikeAssignee))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => string.Equals(x, EveryoneAssignee, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(x => x)
                .ToArray();

            var userValues = _page.Usuarios.Select(x => x.Nombre)
                .Append(CurrentUser)
                .Concat(ParseAssignees(_taskDraft.UsuarioAsignado).Where(x => !IsGroupLikeAssignee(x)))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToArray();

            var values = groupValues
                .Concat(userValues)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
            return values.Length == 0 ? [CurrentUser] : values;
        }
    }

    private IReadOnlyList<string> UserAssigneeOptions => _page.Usuarios
        .Select(x => x.Nombre)
        .Append(CurrentUser)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToArray();

    private IReadOnlyList<AssignedFilterOption> AssignedFilterOptions
        => new[]
            {
                new AssignedFilterOption(string.Empty, "Todos los asignados", "bi-people"),
                new AssignedFilterOption(CurrentUser, "Asignadas a mí", "bi-person-check"),
                new AssignedFilterOption(AssignedByMeFilter, "Asignadas por mí", "bi-send-check")
            }
            .Concat(new[] { new AssignedFilterOption(EveryoneAssignee, EveryoneAssignee, "bi-broadcast") })
            .Concat(_page.Grupos
                .Select(x => x.Grupo)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .Select(x => new AssignedFilterOption(x, x, "bi-diagram-3")))
            .Concat(_page.Usuarios
                .Select(x => x.Nombre)
                .Where(x => !string.IsNullOrWhiteSpace(x) && !string.Equals(x, CurrentUser, StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .Select(x => new AssignedFilterOption(x, x, "bi-person")))
            .ToArray();

    private AssignedFilterOption SelectedAssignedFilter
        => AssignedFilterOptions.FirstOrDefault(x => string.Equals(x.Value, _assignedFilter, StringComparison.OrdinalIgnoreCase))
           ?? AssignedFilterOptions[0];

    private string SelectedAssignedFilterLabel => SelectedAssignedFilter.Label;
    private string SelectedAssignedFilterIcon => SelectedAssignedFilter.Icon;

    private IReadOnlyList<string> ShareUserOptions => _page.Usuarios
        .Select(x => x.Nombre)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Where(x => !string.Equals(x, CurrentUser, StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToArray();

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await BindTaskMenusAsync();

        if (_showTaskModal && !_attachmentsPasteBound)
            await BindTaskAttachmentPasteAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await UiOps.RunAsync(() => TareasSvc.GetPageAsync(CurrentUser), "No se pudieron cargar las tareas.");
        if (result.Success && result.Value is not null)
        {
            _page = result.Value;
            if (!AssignedFilterOptions.Any(x => string.Equals(x.Value, _assignedFilter, StringComparison.OrdinalIgnoreCase)))
                _assignedFilter = string.Empty;
        }
        else
            _feedback = result.Feedback;
        _loading = false;
    }

    private bool MatchesCurrentFilters(TareaItemDto tarea)
    {
        if (_selectedListId is int listId && tarea.IdLista != listId)
            return false;
        if (string.Equals(_assignedFilter, AssignedByMeFilter, StringComparison.Ordinal))
            return string.Equals(tarea.UsuarioAlta, CurrentUser, StringComparison.OrdinalIgnoreCase)
                && !AssignmentMatchesFilter(tarea.UsuarioAsignado, CurrentUser);
        if (!string.IsNullOrWhiteSpace(_assignedFilter)
            && !AssignmentMatchesFilter(tarea.UsuarioAsignado, _assignedFilter))
            return false;
        return true;
    }

