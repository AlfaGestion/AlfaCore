@page "/tareas"
@inject AlfaCore.Services.ITareasService TareasSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>Tareas | Alfa Gestión</PageTitle>

<style>
    .tareas-priority-badge {
        display: inline-flex;
        align-items: center;
        gap: .28rem;
        width: fit-content;
        padding: .16rem .45rem;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, .2);
        font-size: .72rem;
        font-weight: 800;
    }

    .tareas-priority-badge--alta {
        border-color: rgba(248, 113, 113, .42);
        background: rgba(127, 29, 29, .28);
        color: #fecaca;
    }

    .tareas-priority-badge--media {
        border-color: rgba(251, 191, 36, .38);
        background: rgba(120, 53, 15, .24);
        color: #fde68a;
    }

    .tareas-priority-badge--baja {
        border-color: rgba(45, 212, 191, .35);
        background: rgba(20, 83, 45, .22);
        color: #99f6e4;
    }

    .tareas-row--priority-alta {
        border-left: 3px solid #f87171 !important;
    }

    .tareas-row--priority-media {
        border-left: 3px solid #fbbf24 !important;
    }

    .tareas-row--priority-baja {
        border-left: 3px solid #2dd4bf !important;
    }

    .tareas-confirm {
        position: fixed;
        inset: 0;
        z-index: 1400;
        display: grid;
        place-items: center;
        padding: 1rem;
        background: rgba(2, 6, 23, .62);
        backdrop-filter: blur(3px);
    }

    .tareas-confirm__dialog {
        width: min(460px, 100%);
        padding: 1rem;
        border: 1px solid rgba(56, 189, 248, .22);
        border-radius: 8px;
        background: #071426;
        box-shadow: 0 24px 70px rgba(0, 0, 0, .42);
    }

    .tareas-confirm__dialog h3 {
        margin: 0 0 .45rem;
        color: var(--color-text);
        font-size: 1rem;
    }

    .tareas-confirm__dialog p {
        margin: 0;
        color: var(--color-muted);
        line-height: 1.45;
    }

    .tareas-confirm__actions {
        display: flex;
        justify-content: flex-end;
        gap: .55rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .shell__content .tareas-assignment-picker {
        grid-column: 1 / -1;
        position: relative;
        z-index: 4;
    }

    .shell__content .tareas-assignment-picker > span {
        color: #93c5fd;
        font-size: .78rem;
        font-weight: 900;
    }

    .shell__content .tareas-assignment-dropdown {
        position: relative;
        max-width: 420px;
    }

    .shell__content .tareas-assignment-dropdown__button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        width: 100%;
        min-height: 40px;
        padding: 0 .75rem;
        border: 1px solid rgba(80, 118, 180, .32) !important;
        border-radius: 8px;
        background: rgba(12, 24, 43, .92) !important;
        color: #edf6ff !important;
        box-shadow: none;
        font-weight: 800;
        text-align: left;
    }

    .shell__content .tareas-assignment-dropdown__button:hover,
    .shell__content .tareas-assignment-dropdown__button[aria-expanded="true"] {
        border-color: rgba(56, 189, 248, .5) !important;
        background: rgba(10, 31, 54, .98) !important;
    }

    .shell__content .tareas-assignment-dropdown__button > span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .shell__content .tareas-field-picker {
        position: relative;
        display: grid;
        gap: .55rem;
        min-width: 0;
        color: var(--color-muted);
        font-size: .8rem;
        font-weight: 800;
    }

    .shell__content .tareas-field-picker > span {
        color: #93c5fd;
        font-size: .78rem;
        font-weight: 900;
    }

    .shell__content .tareas-field-button,
    .shell__content .tareas-field-date {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        width: 100%;
        min-height: 40px;
        padding: 0 .75rem;
        border: 1px solid rgba(80, 118, 180, .32) !important;
        border-radius: 8px;
        background: rgba(12, 24, 43, .92) !important;
        color: #edf6ff !important;
        box-shadow: none;
        font-weight: 800;
        text-align: left;
    }

    .shell__content .tareas-field-button:hover,
    .shell__content .tareas-field-button[aria-expanded="true"],
    .shell__content .tareas-field-date:hover,
    .shell__content .tareas-field-date:focus {
        border-color: rgba(56, 189, 248, .5) !important;
        background: rgba(10, 31, 54, .98) !important;
        outline: none;
    }

    .shell__content .tareas-field-button > span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .shell__content .tareas-field-menu {
        position: absolute;
        top: calc(100% + .45rem);
        left: 0;
        z-index: 1410;
        display: grid;
        gap: .25rem;
        width: min(100%, 420px);
        max-height: min(260px, 40vh);
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: .45rem;
        border: 1px solid rgba(56, 189, 248, .28);
        border-radius: 8px;
        background: #071426;
        box-shadow: 0 22px 60px rgba(0, 0, 0, .48);
    }

    .shell__content .tareas-field-option {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 18px;
        align-items: center;
        gap: .55rem;
        width: 100%;
        min-height: 36px;
        padding: .45rem .55rem;
        border: 1px solid transparent;
        border-radius: 7px;
        background: transparent !important;
        color: #edf6ff !important;
        box-shadow: none;
        font-weight: 800;
        text-align: left;
        cursor: pointer;
    }

    .shell__content .tareas-field-option:hover {
        background: rgba(8, 145, 178, .18) !important;
    }

    .shell__content .tareas-field-option.is-selected {
        border-color: rgba(45, 212, 191, .42);
        background: rgba(20, 184, 166, .18) !important;
        color: #ccfbf1 !important;
    }

    .shell__content .tareas-field-option span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .shell__content .tareas-assignment-dropdown__menu {
        position: absolute;
        top: calc(100% + .45rem);
        left: 0;
        z-index: 1400;
        display: grid;
        gap: .25rem;
        width: min(420px, calc(100vw - 3rem));
        max-height: min(320px, 46vh);
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: .45rem;
        border: 1px solid rgba(56, 189, 248, .28);
        border-radius: 8px;
        background: #071426;
        box-shadow: 0 22px 60px rgba(0, 0, 0, .48);
    }

    .shell__content .tareas-assignment-dropdown__config {
        display: grid;
        grid-template-columns: 18px minmax(0, 1fr) 18px;
        align-items: center;
        gap: .55rem;
        width: 100%;
        min-height: 36px;
        margin: 0 0 .25rem;
        padding: .45rem .55rem;
        border: 1px solid rgba(56, 189, 248, .22) !important;
        border-radius: 7px;
        background: rgba(8, 47, 73, .35) !important;
        color: #bae6fd !important;
        box-shadow: none;
        font-weight: 800;
        text-align: left;
        cursor: pointer;
    }

    .shell__content .tareas-assignment-dropdown__config::after {
        content: "";
    }

    .shell__content .tareas-assignment-dropdown__config:hover {
        border-color: rgba(56, 189, 248, .42) !important;
        background: rgba(8, 145, 178, .22) !important;
    }

    .shell__content .tareas-assignment-option {
        display: grid;
        grid-template-columns: 18px minmax(0, 1fr) 18px;
        align-items: center;
        gap: .55rem;
        width: 100%;
        min-height: 36px;
        padding: .45rem .55rem;
        border: 1px solid transparent;
        border-radius: 7px;
        background: transparent !important;
        color: #edf6ff !important;
        box-shadow: none;
        font-weight: 800;
        text-align: left;
        cursor: pointer;
    }

    .shell__content .tareas-assignment-option:hover {
        background: rgba(8, 145, 178, .18) !important;
    }

    .shell__content .tareas-assignment-option.is-selected {
        border-color: rgba(45, 212, 191, .42);
        background: rgba(20, 184, 166, .18) !important;
        color: #ccfbf1 !important;
    }

    .shell__content .tareas-assignment-option.is-group {
        border-color: rgba(56, 189, 248, .24);
        background: rgba(14, 165, 233, .12) !important;
        color: #bae6fd !important;
    }

    .shell__content .tareas-assignment-option.is-group:hover {
        background: rgba(14, 165, 233, .2) !important;
    }

    .shell__content .tareas-assignment-option.is-group.is-selected {
        border-color: rgba(45, 212, 191, .46);
        background: linear-gradient(90deg, rgba(20, 184, 166, .22), rgba(14, 165, 233, .16)) !important;
        color: #ccfbf1 !important;
    }

    .tareas-assignment-option__box,
    .tareas-group-users__box {
        display: inline-grid;
        place-items: center;
        width: 16px;
        height: 16px;
        border: 1px solid rgba(125, 211, 252, .45);
        border-radius: 999px;
        color: transparent;
        font-size: .7rem;
    }

    .shell__content .tareas-assignment-option.is-selected .tareas-assignment-option__box,
    .tareas-group-user.is-selected .tareas-group-users__box {
        border-color: rgba(45, 212, 191, .9);
        background: #14b8a6;
        color: #052e2b;
    }

    .shell__content .tareas-assignment-option span:nth-child(2) {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .tareas-assignment-option__type {
        color: #67e8f9;
        justify-self: center;
    }

    .tareas-groups-modal {
        width: min(760px, calc(100vw - 1rem));
        max-height: calc(100vh - 2rem);
        overflow: auto;
    }

    .tareas-groups-create {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: .55rem;
        margin-bottom: .85rem;
    }

    .tareas-groups-create input {
        min-height: 38px;
        padding: 0 .75rem;
        border: 1px solid rgba(148, 163, 184, .22);
        border-radius: 8px;
        background: rgba(15, 23, 42, .3);
        color: var(--color-text);
    }

    .tareas-groups-list {
        display: grid;
        gap: .65rem;
    }

    .tareas-group-card {
        border: 1px solid rgba(148, 163, 184, .18);
        border-radius: 8px;
        background: rgba(15, 23, 42, .24);
        overflow: hidden;
    }

    .tareas-group-card summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: center;
        gap: .65rem;
        padding: .75rem .85rem;
        cursor: pointer;
        list-style: none;
    }

    .tareas-group-card summary::-webkit-details-marker {
        display: none;
    }

    .tareas-group-card summary strong,
    .tareas-group-card summary small {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .tareas-group-card summary small {
        color: var(--color-muted);
        font-weight: 700;
    }

    .tareas-group-card__body {
        display: grid;
        gap: .65rem;
        padding: 0 .85rem .85rem;
    }

    .tareas-group-users {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .4rem;
    }

    .tareas-group-user {
        display: grid;
        grid-template-columns: 18px minmax(0, 1fr) 18px;
        align-items: center;
        gap: .45rem;
        min-height: 34px;
        padding: .4rem .5rem;
        border: 1px solid transparent;
        border-radius: 7px;
        background: transparent;
        color: var(--color-text);
        font-weight: 700;
        text-align: left;
        cursor: pointer;
    }

    .tareas-group-user:hover {
        background: rgba(8, 145, 178, .18);
    }

    .tareas-group-user.is-selected {
        border-color: rgba(45, 212, 191, .42);
        background: rgba(20, 184, 166, .18);
        color: #ccfbf1;
    }

    .tareas-group-user span:nth-child(2) {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    html[data-theme="light"] .shell__content .tareas-assignment-dropdown__button {
        border-color: #bfdbfe !important;
        background: #fff !important;
        color: #0f172a !important;
    }

    html[data-theme="light"] .shell__content .tareas-field-button,
    html[data-theme="light"] .shell__content .tareas-field-date {
        border-color: #bfdbfe !important;
        background: #fff !important;
        color: #0f172a !important;
    }

    html[data-theme="light"] .shell__content .tareas-assignment-dropdown__menu {
        border-color: #bae6fd;
        background: #fff;
        box-shadow: 0 22px 52px rgba(15, 23, 42, .18);
    }

    html[data-theme="light"] .shell__content .tareas-field-menu {
        border-color: #bae6fd;
        background: #fff;
        box-shadow: 0 22px 52px rgba(15, 23, 42, .18);
    }

    html[data-theme="light"] .shell__content .tareas-assignment-dropdown__config {
        border-color: #bae6fd !important;
        background: #eff6ff !important;
        color: #075985 !important;
    }

    html[data-theme="light"] .shell__content .tareas-assignment-option,
    html[data-theme="light"] .shell__content .tareas-field-option,
    html[data-theme="light"] .tareas-group-user {
        color: #0f172a !important;
    }

    html[data-theme="light"] .shell__content .tareas-assignment-option:hover,
    html[data-theme="light"] .shell__content .tareas-field-option:hover,
    html[data-theme="light"] .tareas-group-user:hover {
        background: #e0f2fe !important;
    }

    html[data-theme="light"] .shell__content .tareas-assignment-option.is-selected,
    html[data-theme="light"] .shell__content .tareas-field-option.is-selected,
    html[data-theme="light"] .tareas-group-user.is-selected {
        border-color: rgba(13, 148, 136, .38);
        background: #ccfbf1 !important;
        color: #115e59 !important;
    }

    html[data-theme="light"] .shell__content .tareas-assignment-option.is-group {
        border-color: #bae6fd;
        background: #eff6ff !important;
        color: #075985 !important;
    }

    .tareas-group-delete {
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 8px;
        background: rgba(248, 113, 113, .12);
        color: #fecaca;
    }

    @@media (max-width: 680px) {
        .tareas-groups-create,
        .tareas-group-card summary {
            grid-template-columns: minmax(0, 1fr);
        }

        .tareas-group-users {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="page-grid tareas-page" @onclick="HandlePageClickAsync">
    <header class="tareas-header">
        <div>
            <p class="shell__eyebrow">Alfa Gestión</p>
            <h2>Tareas</h2>
            <span>Listas simples, asignaciones y notas rápidas para que soporte no pierda nada.</span>
        </div>
        <div class="actions">
            <button type="button" class="btn btn--ghost" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise"></i> Recargar
            </button>
            <button type="button" class="btn btn--primary" @onclick="OpenNewTask">
                <i class="bi bi-plus-circle"></i> Nueva tarea
            </button>
        </div>
    </header>

    @if (_feedback is not null)
    {
        <div class="editor-msg tareas-feedback @GetFeedbackClass(_feedback) @(_feedbackLeaving ? "is-leaving" : string.Empty)" @onclick:stopPropagation>
            <i class="bi @GetFeedbackIcon(_feedback)" aria-hidden="true"></i>
            <div class="tareas-feedback__content">
                <strong>@_feedback.Title</strong>
                <p>@_feedback.Message</p>
                @if (_feedback.HasCode)
                {
                    <small>Código: @_feedback.Code</small>
                }
            </div>
            <button type="button" class="tareas-feedback__close" title="Cerrar aviso" aria-label="Cerrar aviso" @onclick="DismissFeedbackAsync">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="tareas-shell">
        <aside class="tareas-lists" aria-label="Listas de tareas">
            <button type="button" class="@GetListButtonClass(null)" @onclick="() => SelectList(null)">
                <span><i class="bi bi-list-check"></i> Todas las listas</span>
                <strong>@ActiveTaskCount</strong>
            </button>

            <div class="tareas-lists__head">
                <span>Listas</span>
                <button type="button" title="Crear lista" @onclick="StartCreateList">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>

            @if (_editingListId == 0)
            {
                <form class="tareas-list-form" @onsubmit="SaveListAsync">
                    <input value="@_listDraft" @oninput="e => _listDraft = Convert.ToString(e.Value) ?? string.Empty" placeholder="Nombre de lista" />
                    <button type="submit" class="tareas-icon-action is-save" title="Guardar" aria-label="Guardar lista">
                        <i class="bi bi-check2"></i>
                    </button>
                    <button type="button" class="tareas-icon-action" title="Cancelar" aria-label="Cancelar" @onclick="CancelListEdit">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </form>
            }

            <div class="tareas-list-stack">
                @foreach (var lista in _page.Listas)
                {
                    <div class="tareas-list-row"
                         @ondragenter="() => SetListDropTarget(lista.IdLista)"
                         @ondragleave="() => ClearListDropTarget(lista.IdLista)"
                         @ondragover:preventDefault
                         @ondrop:preventDefault
                         @ondrop="() => MoveDraggedTaskToListAsync(lista)">
                        @if (_editingListId == lista.IdLista)
                        {
                            <form class="tareas-list-form" @onsubmit="SaveListAsync">
                                <input value="@_listDraft" @oninput="e => _listDraft = Convert.ToString(e.Value) ?? string.Empty" />
                                <button type="submit" class="tareas-icon-action is-save" title="Guardar" aria-label="Guardar lista">
                                    <i class="bi bi-check2"></i>
                                </button>
                                <button type="button" class="tareas-icon-action" title="Cancelar" aria-label="Cancelar" @onclick="CancelListEdit">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button"
                                    class="@GetListButtonClass(lista.IdLista)"
                                    @onclick="() => SelectList(lista.IdLista)">
                                <span>
                                    <i class="bi @GetListIcon(lista)" title="@GetListIconTitle(lista)"></i> @lista.Nombre
                                </span>
                                <strong>@lista.Pendientes</strong>
                            </button>
                            <details class="tareas-menu">
                                <summary title="Opciones"><i class="bi bi-three-dots-vertical"></i></summary>
                                <div>
                                    <button type="button" @onclick="() => StartRenameList(lista)">Renombrar</button>
                                    <button type="button" @onclick="() => OpenShareList(lista)">Compartir</button>
                                    <button type="button" @onclick="() => DeleteListAsync(lista)">Eliminar</button>
                                </div>
                            </details>
                        }
                    </div>
                }
            </div>
        </aside>

        <main class="tareas-main">
            <section class="tareas-compose">
                <i class="bi bi-check2-circle"></i>
                <input @bind="_quickTaskTitle"
                       @bind:event="oninput"
                       @onkeydown="HandleQuickTaskKeyDown"
                       dir="ltr"
                       autocomplete="off"
                       spellcheck="true"
                       style="direction: ltr; unicode-bidi: plaintext; text-align: left;"
                       placeholder="Añadir una tarea..." />
                <button type="button" class="btn btn--ghost btn--sm" @onclick="OpenNewTask">
                    Detalles
                </button>
            </section>

            <div class="tareas-toolbar">
                <div>
                    <strong>@SelectedListTitle</strong>
                    <span>@FilteredTasks.Count tarea(s) activa(s)</span>
                </div>
                <div class="tareas-assignee-filter" @onclick:stopPropagation @onkeydown="HandleAssignedFilterKeyDown">
                    <button type="button"
                            class="tareas-assignee-filter__button"
                            aria-haspopup="listbox"
                            aria-expanded="@_assignedFilterMenuOpen"
                            @onkeydown="HandleAssignedFilterKeyDown"
                            @onclick="ToggleAssignedFilterMenu">
                        <span>
                            <i class="bi @SelectedAssignedFilterIcon"></i>
                            @SelectedAssignedFilterLabel
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (_assignedFilterMenuOpen)
                    {
                        <div class="tareas-assignee-filter__menu" role="listbox">
                            @foreach (var option in AssignedFilterOptions)
                            {
                                <button type="button"
                                        class="@GetAssignedFilterOptionClass(option.Value)"
                                        role="option"
                                        aria-selected="@IsAssignedFilterSelected(option.Value)"
                                        @onclick="() => SelectAssignedFilter(option.Value)">
                                    <i class="bi @option.Icon"></i>
                                    <span>@option.Label</span>
                                    @if (IsAssignedFilterSelected(option.Value))
                                    {
                                        <i class="bi bi-check2"></i>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <section class="tareas-list" aria-label="Tareas activas">
                @if (_loading)
                {
                    <div class="loading">Cargando tareas...</div>
                }
                else if (FilteredTasks.Count == 0)
                {
                    <div class="tareas-empty">
                        <i class="bi bi-check2-all"></i>
                        <strong>No hay tareas pendientes</strong>
                        <span>Agregá una desde el campo superior o cambiá de lista.</span>
                    </div>
                }
                else
                {
                    @foreach (var tarea in FilteredTasks)
                    {
                        <article class="@GetTaskRowClass(tarea)"
                                 data-tareas-drag-card="true"
                                 draggable="true"
                                 @ondragstart="() => StartTaskDrag(tarea)"
                                 @ondragend="ClearTaskDrag">
                            <button type="button" class="tareas-check" title="Completar" @onclick="() => ChangeStateAsync(tarea, TareaEstadoKeys.Completada)">
                                <i class="bi bi-circle"></i>
                            </button>
                            <button type="button" class="tareas-row__body" @onclick="() => OpenEditTaskAsync(tarea)">
                                <strong>@tarea.Titulo</strong>
                                <span class="@GetPriorityBadgeClass(tarea.Prioridad)">
                                    <i class="bi @GetPriorityIcon(tarea.Prioridad)"></i>
                                    @GetPriorityLabel(tarea.Prioridad)
                                </span>
                                <span>
                                    @tarea.ListaNombre
                                    @if (!string.IsNullOrWhiteSpace(tarea.UsuarioAsignado))
                                    {
                                        <span> · @GetAssigneeSummary(tarea.UsuarioAsignado)</span>
                                    }
                                    @if (tarea.FechaVencimiento is not null)
                                    {
                                        <span> · vence @tarea.FechaVencimiento.Value.ToString("dd/MM")</span>
                                    }
                                    @if (tarea.CompartidaConTodos || tarea.UsuariosCompartidos.Count > 0)
                                    {
                                        <i class="bi bi-share" title="@GetSharingSummary(tarea.CompartidaConTodos, tarea.UsuariosCompartidos)"></i>
                                    }
                                    @if (tarea.Adjuntos > 0)
                                    {
                                        <span><i class="bi bi-paperclip"></i> @tarea.Adjuntos</span>
                                    }
                                </span>
                            </button>
                            <select value="@tarea.Estado" @onchange="e => ChangeStateAsync(tarea, Convert.ToString(e.Value) ?? TareaEstadoKeys.Pendiente)">
                                <option value="@TareaEstadoKeys.Pendiente">Pendiente</option>
                                <option value="@TareaEstadoKeys.EnCurso">En curso</option>
                                <option value="@TareaEstadoKeys.Completada">Completada</option>
                            </select>
                            <details class="tareas-menu">
                                <summary title="Opciones"><i class="bi bi-three-dots-vertical"></i></summary>
                                <div>
                                    <button type="button" @onclick="() => OpenEditTaskAsync(tarea)">Editar</button>
                                    <button type="button" @onclick="() => DuplicateTaskAsync(tarea.IdTarea)">Duplicar</button>
                                    <button type="button" @onclick="() => DeleteTaskAsync(tarea.IdTarea)">Eliminar</button>
                                </div>
                            </details>
                        </article>
                    }
                }
            </section>

            <details class="tareas-completed" open="@_showCompleted" @ontoggle="OnCompletedToggle">
                <summary>Completadas (@FilteredCompleted.Count)</summary>
                <div class="tareas-completed__list">
                    @foreach (var tarea in FilteredCompleted)
                    {
                        <article class="tareas-row tareas-row--completed">
                            <button type="button" class="tareas-check is-done" title="Restaurar" @onclick="() => ChangeStateAsync(tarea, TareaEstadoKeys.Pendiente)">
                                <i class="bi bi-check-circle-fill"></i>
                            </button>
                            <button type="button" class="tareas-row__body" @onclick="() => OpenEditTaskAsync(tarea)">
                                <strong>@tarea.Titulo</strong>
                                <span class="@GetPriorityBadgeClass(tarea.Prioridad)">
                                    <i class="bi @GetPriorityIcon(tarea.Prioridad)"></i>
                                    @GetPriorityLabel(tarea.Prioridad)
                                </span>
                                <span>
                                    @tarea.ListaNombre · completada @FormatDateTime(tarea.FechaHoraCompletada)
                                    @if (!string.IsNullOrWhiteSpace(tarea.UsuarioAsignado))
                                    {
                                        <span> · @GetAssigneeSummary(tarea.UsuarioAsignado)</span>
                                    }
                                    @if (tarea.Adjuntos > 0)
                                    {
                                        <span> · <i class="bi bi-paperclip"></i> @tarea.Adjuntos</span>
                                    }
                                </span>
                            </button>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => DeleteTaskAsync(tarea.IdTarea)">
                                Eliminar
                            </button>
                        </article>
                    }
                </div>
            </details>
        </main>

        <aside class="tareas-quick">
            <div class="tareas-quick__head">
                <div>
                    <span>Rápidas</span>
                    <strong>Para hoy</strong>
                </div>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="ClearCompletedNotesAsync" disabled="@(!_page.NotasRapidas.Any(n => n.EsPropia && n.Completada))">
                    Limpiar completadas
                </button>
            </div>

            <input class="tareas-quick-input"
                   @bind="_quickNoteText"
                   @bind:event="oninput"
                   @onkeydown="HandleQuickNoteKeyDown"
                   dir="ltr"
                   autocomplete="off"
                   spellcheck="true"
                   style="direction: ltr; unicode-bidi: plaintext; text-align: left;"
                   placeholder="Escribí y Enter..." />

            <div class="tareas-notes">
                @foreach (var nota in _page.NotasRapidas)
                {
                    <div class="tareas-note @(nota.Completada ? "is-done" : string.Empty)">
                        <button type="button" class="tareas-check @(nota.Completada ? "is-done" : string.Empty)" title="Marcar rápida" @onclick="() => ToggleNoteAsync(nota, !nota.Completada)">
                            <i class="bi @(nota.Completada ? "bi-check-circle-fill" : "bi-circle")"></i>
                        </button>
                        <span>
                            @nota.Texto
                            @if (!nota.EsPropia)
                            {
                                <small>@nota.Usuario</small>
                            }
                            @if (nota.CompartidaConTodos || nota.UsuariosCompartidos.Count > 0)
                            {
                                <i class="bi bi-share" title="@GetSharingSummary(nota.CompartidaConTodos, nota.UsuariosCompartidos)"></i>
                            }
                        </span>
                        <button type="button" title="Compartir" disabled="@(!nota.EsPropia)" @onclick="() => OpenShareNote(nota)">
                            <i class="bi bi-share"></i>
                        </button>
                        <button type="button" title="Eliminar" disabled="@(!nota.EsPropia)" @onclick="() => DeleteNoteAsync(nota.IdNota)">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                @if (_page.NotasRapidas.Count == 0)
                {
                    <p class="tareas-muted">Todavía no hay anotaciones rápidas.</p>
                }
            </div>
        </aside>
    </div>
</section>

@if (_showTaskModal)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar tarea" @onclick="RequestCloseTaskModalAsync"></button>
    <section class="tareas-modal panel-card no-print" @onclick:stopPropagation>
        <div class="tareas-modal__head">
            <input class="tareas-title-input"
                   value="@_taskDraft.Titulo"
                   @oninput="e => _taskDraft.Titulo = Convert.ToString(e.Value) ?? string.Empty"
                   placeholder="Añade un título" />
            <button type="button" class="drawer__close" @onclick="RequestCloseTaskModalAsync" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="tareas-form-grid">
            <label class="tareas-field-picker">
                <span>Vencimiento</span>
                <input class="tareas-field-date" type="date" value="@DateToInput(_taskDraft.FechaVencimiento)" @onchange="OnDraftDueDateChanged" />
            </label>
            <div class="tareas-field-picker" @onclick:stopPropagation @onkeydown="HandleFieldMenuKeyDown">
                <span>Estado</span>
                <button type="button"
                        class="tareas-field-button"
                        aria-haspopup="listbox"
                        aria-expanded="@_stateMenuOpen"
                        @onclick="ToggleStateMenu">
                    <span>@GetStateLabel(_taskDraft.Estado)</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                @if (_stateMenuOpen)
                {
                    <div class="tareas-field-menu" role="listbox">
                        @foreach (var option in StateOptions)
                        {
                            <button type="button"
                                    class="@GetFieldOptionClass(_taskDraft.Estado, option.Value)"
                                    role="option"
                                    aria-selected="@IsFieldOptionSelected(_taskDraft.Estado, option.Value)"
                                    @onclick="() => SelectState(option.Value)">
                                <span>@option.Label</span>
                                @if (IsFieldOptionSelected(_taskDraft.Estado, option.Value))
                                {
                                    <i class="bi bi-check2"></i>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="tareas-field-picker" @onclick:stopPropagation @onkeydown="HandleFieldMenuKeyDown">
                <span>Prioridad</span>
                <button type="button"
                        class="tareas-field-button"
                        aria-haspopup="listbox"
                        aria-expanded="@_priorityMenuOpen"
                        @onclick="TogglePriorityMenu">
                    <span>@GetPriorityLabel(_taskDraft.Prioridad)</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                @if (_priorityMenuOpen)
                {
                    <div class="tareas-field-menu" role="listbox">
                        @foreach (var option in PriorityOptions)
                        {
                            <button type="button"
                                    class="@GetFieldOptionClass(_taskDraft.Prioridad, option.Value)"
                                    role="option"
                                    aria-selected="@IsFieldOptionSelected(_taskDraft.Prioridad, option.Value)"
                                    @onclick="() => SelectPriority(option.Value)">
                                <span>@option.Label</span>
                                @if (IsFieldOptionSelected(_taskDraft.Prioridad, option.Value))
                                {
                                    <i class="bi bi-check2"></i>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="tareas-field-picker" @onclick:stopPropagation @onkeydown="HandleFieldMenuKeyDown">
                <span>Lista</span>
                <button type="button"
                        class="tareas-field-button"
                        aria-haspopup="listbox"
                        aria-expanded="@_listMenuOpen"
                        @onclick="ToggleListMenu">
                    <span>@GetListName(_taskDraft.IdLista)</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                @if (_listMenuOpen)
                {
                    <div class="tareas-field-menu" role="listbox">
                        @foreach (var lista in _page.Listas)
                        {
                            <button type="button"
                                    class="@GetFieldOptionClass(_taskDraft.IdLista, lista.IdLista)"
                                    role="option"
                                    aria-selected="@IsFieldOptionSelected(_taskDraft.IdLista, lista.IdLista)"
                                    @onclick="() => SelectTaskList(lista.IdLista)">
                                <span>@lista.Nombre</span>
                                @if (IsFieldOptionSelected(_taskDraft.IdLista, lista.IdLista))
                                {
                                    <i class="bi bi-check2"></i>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="tareas-assignment-picker">
                <span>Asignado a</span>
                <div class="tareas-assignment-dropdown" @onclick:stopPropagation @onkeydown="HandleAssignmentKeyDown">
                    <button type="button"
                            class="tareas-assignment-dropdown__button"
                            aria-haspopup="listbox"
                            aria-expanded="@_assigneeMenuOpen"
                            @onclick="ToggleAssigneeMenu">
                        <span>@GetAssigneeSummary(_taskDraft.UsuarioAsignado)</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (_assigneeMenuOpen)
                    {
                        <div class="tareas-assignment-dropdown__menu" role="listbox">
                            <button type="button" class="tareas-assignment-dropdown__config" @onclick="OpenGroupsModal">
                                <i class="bi bi-sliders"></i>
                                <span>Configurar grupos</span>
                            </button>
                            @foreach (var user in AssigneeOptions)
                            {
                                <button type="button"
                                        class="@GetAssigneeOptionClass(user)"
                                        role="option"
                                        aria-selected="@IsAssigneeSelected(user)"
                                        @onclick="() => ToggleAssigneeSelection(user)">
                                    <span class="tareas-assignment-option__box">
                                        <i class="bi bi-check2"></i>
                                    </span>
                                    <span>@user</span>
                                    @if (IsAssigneeSelected(user))
                                    {
                                        <i class="bi bi-check2"></i>
                                    }
                                    else if (IsGroupLikeAssignee(user))
                                    {
                                        <i class="bi bi-diagram-3 tareas-assignment-option__type"></i>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="tareas-task-share">
            <button type="button" class="btn btn--ghost btn--sm" disabled="@(!_taskCanShare)" @onclick="ToggleTaskSharePanel">
                <i class="bi bi-share"></i> Compartir
            </button>
            @if (_taskDraft.CompartirConTodos || _taskDraft.UsuariosCompartidos.Count > 0)
            {
                <span>@GetSharingSummary(_taskDraft.CompartirConTodos, _taskDraft.UsuariosCompartidos)</span>
            }
        </div>

        @if (_taskSharePanelOpen)
        {
            <section class="tareas-task-share-panel">
                <label class="tareas-share-all">
                    <input type="checkbox" checked="@_taskDraft.CompartirConTodos" @onchange="OnTaskShareAllChanged" />
                    <span>Compartir con todos los usuarios</span>
                </label>

                @if (!_taskDraft.CompartirConTodos)
                {
                    <div class="tareas-share-users">
                        @foreach (var user in ShareUserOptions)
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@_taskDraft.UsuariosCompartidos.Contains(user, StringComparer.OrdinalIgnoreCase)"
                                       @onchange="e => ToggleTaskShareUser(user, e)" />
                                <span>@user</span>
                            </label>
                        }
                    </div>
                }
            </section>
        }

        <label class="tareas-description">
            <span>Descripcion</span>
            <textarea value="@_taskDraft.Descripcion"
                      @oninput="e => _taskDraft.Descripcion = Convert.ToString(e.Value) ?? string.Empty"
                      placeholder="Anade una descripcion"></textarea>
        </label>

        <section id="tareas-attachments-dropzone" class="tareas-attachments" tabindex="0">
            <div class="tareas-attachments__head">
                <div>
                    <strong>Adjuntos</strong>
                    <span>Imagenes, audios o videos. Tambien podes pegar con Ctrl+V.</span>
                </div>
                <div class="tareas-attachments__actions">
                    <InputFile id="tareas-attachments-picker"
                               style="display:none"
                               OnChange="HandleTaskFilesSelectedAsync"
                               multiple
                               accept="image/*,audio/*,video/*"
                               disabled="@_savingTask" />
                    <label class="btn btn--ghost btn--sm" for="tareas-attachments-picker">
                        <i class="bi bi-paperclip"></i> Adjuntar
                    </label>
                </div>
            </div>

            @if (_loadingTaskAttachments)
            {
                <div class="tareas-attachments__empty">Cargando adjuntos...</div>
            }
            else if (_taskAttachments.Count == 0 && _pendingTaskAttachments.Count == 0)
            {
                <div class="tareas-attachments__empty">Solta archivos aca o pega una imagen, audio o video.</div>
            }
            else
            {
                <div class="tareas-attachments__grid">
                    @foreach (var adjunto in _taskAttachments)
                    {
                        <article class="tareas-attachment-card">
                            @RenderAttachmentPreview(adjunto.MimeType, GetAttachmentDataUrl(adjunto), adjunto.NombreArchivo)
                            <div class="tareas-attachment-card__body">
                                <strong title="@adjunto.NombreArchivo">@adjunto.NombreArchivo</strong>
                                <span>@FormatSize(adjunto.TamanoBytes)</span>
                            </div>
                            <button type="button" class="tareas-attachment-card__remove" title="Quitar" @onclick="() => DeletePersistedAttachmentAsync(adjunto.IdAdjunto)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </article>
                    }
                    @foreach (var adjunto in _pendingTaskAttachments)
                    {
                        <article class="tareas-attachment-card is-pending">
                            @RenderAttachmentPreview(adjunto.MimeType, GetAttachmentDataUrl(adjunto), adjunto.NombreArchivo)
                            <div class="tareas-attachment-card__body">
                                <strong title="@adjunto.NombreArchivo">@adjunto.NombreArchivo</strong>
                                <span>@FormatSize(adjunto.TamanoBytes) - pendiente</span>
                            </div>
                            <button type="button" class="tareas-attachment-card__remove" title="Quitar" @onclick="() => RemovePendingAttachment(adjunto.Id)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </article>
                    }
                </div>
            }
        </section>

        <div class="tareas-modal__actions">
            @if (_taskDraft.IdTarea is > 0)
            {
                <button type="button" class="btn btn--ghost" @onclick="() => DuplicateTaskAsync(_taskDraft.IdTarea!.Value)">
                    <i class="bi bi-files"></i> Duplicar
                </button>
                <button type="button" class="btn btn--ghost" @onclick="() => DeleteTaskAsync(_taskDraft.IdTarea!.Value)">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            }
            <span></span>
            <button type="button" class="btn btn--primary" @onclick="SaveTaskAsync" disabled="@_savingTask">
                <i class="bi bi-save"></i> @(_savingTask ? "Guardando..." : "Guardar")
            </button>
        </div>
    </section>
}

@if (_showCloseTaskConfirm)
{
    <section class="tareas-confirm no-print" role="dialog" aria-modal="true" aria-labelledby="tareas-confirm-title">
        <div class="tareas-confirm__dialog">
            <h3 id="tareas-confirm-title">Cerrar sin guardar</h3>
            <p>Hay cambios sin guardar en esta tarea. Si cerras ahora, se pierde lo que cargaste.</p>
            <div class="tareas-confirm__actions">
                <button type="button" class="btn btn--ghost" @onclick="CancelCloseTaskModal">
                    Seguir editando
                </button>
                <button type="button" class="btn btn--primary" @onclick="ConfirmCloseTaskModalAsync">
                    Cerrar sin guardar
                </button>
            </div>
        </div>
    </section>
}

@if (_showShareModal)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar compartir" @onclick="CloseShareModal"></button>
    <section class="tareas-modal tareas-share-modal panel-card no-print" @onclick:stopPropagation>
        <div class="tareas-modal__head">
            <div>
                <span class="tareas-modal-kicker">Compartir</span>
                <h3>@_shareTitle</h3>
            </div>
            <button type="button" class="drawer__close" @onclick="CloseShareModal" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <label class="tareas-share-all">
            <input type="checkbox" checked="@_shareAll" @onchange="OnShareAllChanged" />
            <span>Compartir con todos los usuarios</span>
        </label>

        @if (!_shareAll)
        {
            <div class="tareas-share-users">
                @foreach (var user in ShareUserOptions)
                {
                    <label>
                        <input type="checkbox"
                               checked="@_shareUsers.Contains(user, StringComparer.OrdinalIgnoreCase)"
                               @onchange="e => ToggleShareUser(user, e)" />
                        <span>@user</span>
                    </label>
                }
            </div>
        }

        <div class="tareas-modal__actions">
            <button type="button" class="btn btn--ghost" @onclick="ClearSharingAsync">
                Quitar comparticion
            </button>
            <span></span>
            <button type="button" class="btn btn--primary" @onclick="SaveSharingAsync">
                <i class="bi bi-share"></i> Guardar
            </button>
        </div>
    </section>
}

@if (_showGroupsModal)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar grupos" @onclick="CloseGroupsModal"></button>
    <section class="tareas-modal tareas-groups-modal panel-card no-print" @onclick:stopPropagation>
        <div class="tareas-modal__head">
            <div>
                <span class="tareas-modal-kicker">Asignaciones</span>
                <h3>Grupos de tareas</h3>
            </div>
            <button type="button" class="drawer__close" @onclick="CloseGroupsModal" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="tareas-groups-create">
            <input value="@_newGroupName"
                   @oninput="e => _newGroupName = Convert.ToString(e.Value) ?? string.Empty"
                   @onkeydown="HandleNewGroupKeyDown"
                   placeholder="Nuevo grupo" />
            <button type="button" class="btn btn--ghost" @onclick="AddGroupDraft">
                <i class="bi bi-plus-lg"></i> Crear grupo
            </button>
        </div>

        @if (_groupDrafts.Count == 0)
        {
            <div class="tareas-empty">
                <i class="bi bi-diagram-3"></i>
                <strong>No hay grupos</strong>
                <span>Creá un grupo y elegí sus usuarios.</span>
            </div>
        }
        else
        {
            <div class="tareas-groups-list">
            @foreach (var group in _groupDrafts.OrderBy(x => x.Grupo))
            {
                <details class="tareas-group-card" open>
                    <summary>
                        <strong>@group.Grupo</strong>
                        <small>@GetGroupMemberSummary(group)</small>
                        <button type="button" class="tareas-group-delete" title="Eliminar grupo" aria-label="Eliminar grupo" @onclick:stopPropagation @onclick="() => RemoveGroupDraft(group.Grupo)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </summary>
                    <div class="tareas-group-card__body">
                        <div class="tareas-group-users">
                        @foreach (var user in UserAssigneeOptions)
                        {
                            <button type="button"
                                    class="@GetGroupMemberOptionClass(group.Grupo, user)"
                                    @onclick="() => ToggleGroupMemberSelection(group.Grupo, user)">
                                <span class="tareas-group-users__box">
                                    <i class="bi bi-check2"></i>
                                </span>
                                <span>@user</span>
                                @if (IsGroupMemberSelected(group.Grupo, user))
                                {
                                    <i class="bi bi-check2"></i>
                                }
                            </button>
                        }
                        </div>
                    </div>
                </details>
            }
            </div>
        }

        <div class="tareas-modal__actions">
            <button type="button" class="btn btn--ghost" @onclick="CloseGroupsModal">
                Cancelar
            </button>
            <span></span>
            <button type="button" class="btn btn--primary" @onclick="SaveGroupsAsync" disabled="@_savingGroups">
                <i class="bi bi-save"></i> @(_savingGroups ? "Guardando..." : "Guardar grupos")
            </button>
        </div>
    </section>
}

@if (_showImagePreview)
{
    <button type="button" class="modal-backdrop app-modal-backdrop no-print" aria-label="Cerrar imagen" @onclick="CloseImagePreview"></button>
    <section class="tareas-image-preview no-print" @onclick:stopPropagation>
        <div class="tareas-image-preview__head">
            <strong>@_previewImageName</strong>
            <button type="button" class="drawer__close" @onclick="CloseImagePreview" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <img src="@_previewImageUrl" alt="@_previewImageName" />
    </section>
}
