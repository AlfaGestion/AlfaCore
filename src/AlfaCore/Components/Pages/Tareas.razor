    private void CloseGroupsModal()
        => _showGroupsModal = false;

    private bool IsGroupMemberSelected(string group, string user)
        => _groupDrafts
            .FirstOrDefault(x => string.Equals(x.Grupo, group, StringComparison.OrdinalIgnoreCase))
            ?.Usuarios.Contains(user, StringComparer.OrdinalIgnoreCase) == true;

    private string GetGroupMemberOptionClass(string group, string user)
        => IsGroupMemberSelected(group, user) ? "tareas-group-user is-selected" : "tareas-group-user";

    private void ToggleGroupMemberSelection(string group, string user)
    {
        var draft = _groupDrafts.FirstOrDefault(x => string.Equals(x.Grupo, group, StringComparison.OrdinalIgnoreCase));
        if (draft is null)
        {
            draft = new TareaGrupoDto { Grupo = group };
            _groupDrafts.Add(draft);
        }

        if (draft.Usuarios.Contains(user, StringComparer.OrdinalIgnoreCase))
            draft.Usuarios.RemoveAll(x => string.Equals(x, user, StringComparison.OrdinalIgnoreCase));
        else
            draft.Usuarios.Add(user);
    }

    private void ToggleGroupMember(string group, string user, ChangeEventArgs args)
    {
        var draft = _groupDrafts.FirstOrDefault(x => string.Equals(x.Grupo, group, StringComparison.OrdinalIgnoreCase));
        if (draft is null)
        {
            draft = new TareaGrupoDto { Grupo = group };
            _groupDrafts.Add(draft);
        }

        var selected = Convert.ToBoolean(args.Value);
        if (selected && !draft.Usuarios.Contains(user, StringComparer.OrdinalIgnoreCase))
            draft.Usuarios.Add(user);
        if (!selected)
            draft.Usuarios.RemoveAll(x => string.Equals(x, user, StringComparison.OrdinalIgnoreCase));
    }

    private void AddGroupDraft()
    {
        var groupName = NormalizeGroupNameForUi(_newGroupName);
        if (string.IsNullOrWhiteSpace(groupName))
            return;

        if (string.Equals(groupName, EveryoneAssignee, StringComparison.OrdinalIgnoreCase))
        {
            _feedback = BuildWarning("Nombre reservado", "Todos ya existe como asignación general.");
            return;
        }

        if (_groupDrafts.Any(x => string.Equals(x.Grupo, groupName, StringComparison.OrdinalIgnoreCase)))
        {
            _feedback = BuildWarning("Grupo repetido", "Ya existe un grupo con ese nombre.");
            return;
        }

        _groupDrafts.Add(new TareaGrupoDto { Grupo = groupName });
        _newGroupName = string.Empty;
    }

    private void RemoveGroupDraft(string groupName)
    {
        _groupDrafts.RemoveAll(x => string.Equals(x.Grupo, groupName, StringComparison.OrdinalIgnoreCase));
        var assigned = ParseAssignees(_taskDraft.UsuarioAsignado)
            .Where(x => !string.Equals(x, groupName, StringComparison.OrdinalIgnoreCase));
        _taskDraft.UsuarioAsignado = string.Join(", ", assigned);
    }

    private static string GetGroupMemberSummary(TareaGrupoDto group)
        => group.Usuarios.Count == 0 ? "Sin usuarios" : $"{group.Usuarios.Count} usuario(s)";

    private void HandleNewGroupKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            AddGroupDraft();
    }

    private static string NormalizeGroupNameForUi(string? value)
    {
        var clean = string.Join(" ", (value ?? string.Empty).Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries));
        return clean.Length <= 50 ? clean : clean[..50];
    }

