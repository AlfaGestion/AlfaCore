    private void ToggleColumn(string key, ChangeEventArgs args)
    {
        var col = _viewDraft.Columnas.FirstOrDefault(x => x.Key == key);
        if (col is null)
            return;
        col.Visible = args.Value is bool value && value;
        if (!_viewDraft.Columnas.Any(x => x.Visible))
            col.Visible = true;
    }

    private async Task SaveViewSettingsAsync()
    {
        await RunAsync(async () =>
        {
            _viewSettings = CloneViewSettings(_viewDraft);
            await CrmSvc.SaveViewSettingsAsync(AppUserSession.CurrentUser?.UserName ?? Environment.UserName, _viewSettings);
            _showViewSettings = false;
        });
    }

    private static CrmViewSettingsDto CloneViewSettings(CrmViewSettingsDto source) => new()
    {
        AgruparPor = source.AgruparPor,
        Columnas = source.Columnas.Select(x => new CrmViewColumnDto { Key = x.Key, Label = x.Label, Visible = x.Visible, Order = x.Order }).ToList()
    };

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _feedback = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? new Feedback("No se pudo completar la operación", userFacing.UserMessage, userFacing.ErrorCode)
                : new Feedback("No se pudo completar la operación", ex.Message, null);
        }
        finally
        {
            _loading = false;
            _saving = false;
        }
    }

    private void ShowOk(string title, string message) => _feedback = new Feedback(title, message, null, true);
    private string GetFeedbackClass() => _feedback?.Success == true ? "editor-msg--success" : "editor-msg--error";
    private string GetModeClass(string mode) => _viewMode == mode ? "is-active" : string.Empty;
    private static string Display(string primary, string fallback, string empty) => !string.IsNullOrWhiteSpace(primary) ? primary : (!string.IsNullOrWhiteSpace(fallback) ? fallback : empty);
    private static string FormatMoney(decimal value) => value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
    private static string FormatDate(DateTime value) => value == DateTime.MinValue ? "-" : value.ToString("dd/MM/yyyy HH:mm");
    private static string GetPriorityLabel(int value) => value switch
    {
        1 => "Baja",
        2 => "Media",
        3 => "Alta",
        _ => "Sin prioridad"
    };

    private MarkupString RenderCell(CrmOpportunityDto item, string key)
    {
        var value = key switch
        {
            CrmViewColumnKeys.Numero => $"#{item.CodigoVisible}",
            CrmViewColumnKeys.Titulo => item.Titulo,
            CrmViewColumnKeys.Etapa => item.EtapaNombre,
            CrmViewColumnKeys.Importe => FormatMoney(item.ImporteEstimado),
            CrmViewColumnKeys.Probabilidad => $"{item.Probabilidad}%",
            CrmViewColumnKeys.Asignado => Display(item.TecnicoNombre, item.IdTecnico, "Sin asignar"),
            CrmViewColumnKeys.Cliente => Display(item.ClienteNombre, item.ClienteCodigo, "Sin cliente"),
            CrmViewColumnKeys.Contacto => Display(item.ContactoNombre, item.IdContacto?.ToString() ?? string.Empty, "-"),
            CrmViewColumnKeys.Etiquetas => string.Join(", ", item.Etiquetas.Select(x => x.Nombre)),
            _ => item.FechaHoraAlta.ToString("dd/MM/yyyy")
        };
        return new MarkupString(System.Net.WebUtility.HtmlEncode(value));
    }

    public void Dispose() => PageHeader.Clear();

    private sealed record Feedback(string Title, string Message, string? Code, bool Success = false);
    private sealed record FilterChip(string Key, string Label);
}
