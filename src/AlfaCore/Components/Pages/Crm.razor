            await SugerirLineasIaAsync();
    }

    private async Task SugerirLineasIaAsync()
    {
        if (string.IsNullOrWhiteSpace(_cotizIaPrompt))
            return;
        _cotizIaCargando = true;
        await RunAsync(async () =>
        {
            var sugerencias = await CotizSvc.SuggestLinesFromPromptAsync(_cotizClienteCodigo, _cotizIaPrompt);
            _cotizIaSugerencias = sugerencias.ToList();
            _cotizIaSeleccion = _cotizIaSugerencias.Select(x => x.IdArticulo).ToHashSet();
            if (_cotizIaSugerencias.Count == 0)
                _feedback = new Feedback("Sin resultados", "El asistente no encontró artículos para ese pedido. Probá con otras palabras.", null);
        });
        _cotizIaCargando = false;
    }

    private void ToggleSugerencia(string idArticulo, ChangeEventArgs args)
    {
        if (args.Value is bool value && value)
            _cotizIaSeleccion.Add(idArticulo);
        else
            _cotizIaSeleccion.Remove(idArticulo);
    }

    private void ToggleTodasSugerencias()
    {
        if (_cotizIaSeleccion.Count == _cotizIaSugerencias.Count)
            _cotizIaSeleccion.Clear();
        else
            _cotizIaSeleccion = _cotizIaSugerencias.Select(x => x.IdArticulo).ToHashSet();
    }

    private void AgregarSugerenciasSeleccionadas()
    {
        foreach (var sug in _cotizIaSugerencias.Where(x => _cotizIaSeleccion.Contains(x.IdArticulo)))
        {
            _cotizLineas.Add(new CrmCotizacionLineRequest
            {
                IdArticulo = sug.IdArticulo,
                Descripcion = sug.Descripcion,
                Cantidad = sug.Cantidad > 0 ? sug.Cantidad : 1m,
                PrecioUnitario = _cotizPricing.PreciosConIva ? sug.PrecioUnitarioConIva : sug.PrecioUnitarioNeto,
                TasaIva = sug.TasaIva
            });
        }
        _cotizIaSugerencias.Clear();
        _cotizIaSeleccion.Clear();
    }

