    private async Task MoveStageAsync(int sourceStageId, int targetStageId)
    {
        var stages = _lookups.Etapas.OrderBy(x => x.Orden).ThenBy(x => x.IdEtapa).ToList();
        var source = stages.FirstOrDefault(x => x.IdEtapa == sourceStageId);
        var target = stages.FirstOrDefault(x => x.IdEtapa == targetStageId);
        if (source is null || target is null)
        {
            ClearDragState();
            return;
        }

        stages.Remove(source);
        var targetIndex = Math.Max(0, stages.FindIndex(x => x.IdEtapa == target.IdEtapa));
        stages.Insert(targetIndex, source);

        await RunAsync(async () =>
        {
            for (var i = 0; i < stages.Count; i++)
            {
                var stage = stages[i];
                stage.Orden = (i + 1) * 10;
                await CrmSvc.SaveEtapaAsync(new CrmEtapaSaveRequest
                {
                    IdEtapa = stage.IdEtapa,
                    Nombre = stage.Nombre,
                    Color = stage.Color,
                    EsGanada = stage.EsGanada,
                    EsPerdida = stage.EsPerdida,
                    Orden = stage.Orden,
                    UsuarioAccion = CurrentUserName
                });
            }
            _lookups = await CrmSvc.GetLookupsAsync();
            await ReloadCurrentViewAsync(resetPage: false);
            ShowOk("Etapas reordenadas", "El orden del pipeline quedó actualizado.");
        });
        ClearDragState();
        UpdatePageHeader();
    }

