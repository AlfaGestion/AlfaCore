    private void NewTag() => _tagDraft = new CrmEtiquetaSaveRequest { Color = "#14B8A6" };
    private void EditTag(CrmEtiquetaDto tag) => _tagDraft = new CrmEtiquetaSaveRequest { IdEtiqueta = tag.IdEtiqueta, Nombre = tag.Nombre, Color = tag.Color };
    private async Task SaveTagAsync()
    {
        await RunAsync(async () =>
        {
            _tagDraft.UsuarioAccion = AppUserSession.CurrentUser?.UserName;
            await CrmSvc.SaveEtiquetaAsync(_tagDraft);
            _lookups = await CrmSvc.GetLookupsAsync();
            NewTag();
            await ReloadCurrentViewAsync(resetPage: false);
        });
    }

    private async Task DeleteTagAsync(int id)
    {
        await RunAsync(async () =>
        {
            await CrmSvc.DeleteEtiquetaAsync(id, AppUserSession.CurrentUser?.UserName);
            _lookups = await CrmSvc.GetLookupsAsync();
            await ReloadCurrentViewAsync(resetPage: false);
