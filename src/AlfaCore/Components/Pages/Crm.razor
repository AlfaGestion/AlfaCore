    protected override async Task OnInitializedAsync()
    {
        UpdatePageHeader();
        await LoadAsync();
        if (Conv is long idConv && idConv > 0)
            await OpenNewFromConversationAsync(idConv);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();

        if (_cotizEditorNeedsSync && _showCotizEditor && _cotizEsServicio)
        {
            _cotizEditorNeedsSync = false;
            await JS.InvokeVoidAsync("crmCotizacion.setHtml", _cotizEditorRef, _cotizEditorPendingHtml ?? string.Empty);
        }
    }

    private async Task OpenNewFromConversationAsync(long idConv)
    {
        await RunAsync(async () =>
        {
            var prefill = await CrmSvc.GetConversationPrefillAsync(idConv);
            NewOpportunity();
            _form.IdConversacion = idConv;
            if (prefill is not null)
            {
                _form.Titulo = prefill.TituloSugerido;
                _form.ClienteCodigo = string.IsNullOrWhiteSpace(prefill.ClienteCodigo) ? null : prefill.ClienteCodigo;
                _form.IdContacto = prefill.IdContacto;
                _form.CanalOrigen = string.IsNullOrWhiteSpace(prefill.CanalOrigen) ? null : prefill.CanalOrigen;
            }
            _form.IdTecnico ??= CurrentUserTechId;
            UpdatePageHeader();
        });

        // La IA lee la conversación y completa título/descripción (no bloquea la apertura).
        if (_showEditor && _form.IdOportunidad <= 0)
        {
            _extrayendoDatosIa = true;
            StateHasChanged();
            try
            {
                var extra = await CrmSvc.ExtractOportunidadDesdeConversacionAsync(idConv);
                if (extra is not null)
                {
                    if (!string.IsNullOrWhiteSpace(extra.Titulo))
                        _form.Titulo = extra.Titulo;
                    if (!string.IsNullOrWhiteSpace(extra.Descripcion) && string.IsNullOrWhiteSpace(_form.Descripcion))
                        _form.Descripcion = extra.Descripcion;
                }
            }
            catch
            {
            }
            finally
            {
                _extrayendoDatosIa = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadAsync()
    {
        await RunAsync(async () =>
        {
            _loading = true;
            _lookups = await CrmSvc.GetLookupsAsync();
            ApplyDefaultMyFlow();
            _viewSettings = await CrmSvc.GetViewSettingsAsync(AppUserSession.CurrentUser?.UserName ?? Environment.UserName);
            await ReloadCurrentViewAsync(resetPage: true);
            UpdatePageHeader();
        });
        _loading = false;
    }

    private void ApplyDefaultMyFlow()
    {
        if (_defaultFlowApplied)
            return;

        _defaultFlowApplied = true;
        if (string.IsNullOrWhiteSpace(_filters.Texto)
            && _filters.IdEtapa is null
            && string.IsNullOrWhiteSpace(_filters.IdTecnico)
            && _filters.IdEtiqueta is null
            && !string.IsNullOrWhiteSpace(CurrentUserTechId))
        {
            _filters.IdTecnico = CurrentUserTechId;
        }
    }

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();

        if (_showEditor)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "guardar",
                Label = _saving ? "Guardando..." : "Guardar",
                Icon = "bi-floppy",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                Busy = _saving,
                OnClick = () => RunHeaderActionAsync(SaveOpportunityAsync)
            });
            actions.Add(new PageHeaderAction
            {
                Key = "cancelar",
                Label = "Volver",
                Icon = "bi-arrow-left",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                OnClick = () => RunHeaderActionAsync(() => { CloseEditor(); return Task.CompletedTask; })
            });
        }
        else
        {
            actions.Add(new PageHeaderAction
            {
                Key = "nueva",
                Label = "Nueva oportunidad",
                Icon = "bi-plus-circle",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                OnClick = () => RunHeaderActionAsync(() => { NewOpportunity(); return Task.CompletedTask; })
            });
            actions.Add(new PageHeaderAction
            {
                Key = "limpiar",
                Label = "Limpiar filtros",
                Icon = "bi-eraser",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                Disabled = _loading,
                OnClick = () => RunHeaderActionAsync(ClearFiltersAsync)
            });
            if (_viewMode == "lista")
            {
                actions.Add(new PageHeaderAction
                {
                    Key = "vista",
                    Label = "Configurar vista",
                    Icon = "bi-sliders",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    OnClick = () => RunHeaderActionAsync(() => { OpenViewSettings(); return Task.CompletedTask; })
                });
            }
            actions.Add(new PageHeaderAction
            {
                Key = "etapas",
                Label = "Etapas",
                Icon = "bi-columns-gap",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                OnClick = () => RunHeaderActionAsync(() => { OpenStages(); return Task.CompletedTask; })
            });
            actions.Add(new PageHeaderAction
            {
                Key = "etiquetas",
                Label = "Etiquetas",
                Icon = "bi-tags",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                OnClick = () => RunHeaderActionAsync(() => { OpenTags(); return Task.CompletedTask; })
            });
            actions.Add(new PageHeaderAction
            {
                Key = "motivos",
                Label = "Motivos de pérdida",
                Icon = "bi-emoji-frown",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                OnClick = () => RunHeaderActionAsync(() => { OpenMotivos(); return Task.CompletedTask; })
            });
        }

        PageHeader.Set(new PageHeaderConfig
        {
            Title = _showEditor ? (_form.IdOportunidad > 0 ? $"#{_detail?.CodigoVisible} {_form.Titulo}" : "Nueva oportunidad") : "CRM oportunidades",
            Breadcrumb = _showEditor ? ["CRM", "Oportunidades", "Detalle"] : ["CRM", "Oportunidades"],
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCrm(RouteContext, Nav, "oportunidades"),
            State = _loading
                ? PageHeaderState.Loading
                : _showEditor
                    ? (_form.IdOportunidad > 0 ? PageHeaderState.Editing : PageHeaderState.Creating)
                    : _viewMode == "kanban" ? PageHeaderState.Kanban : PageHeaderState.List,
            SearchContent = _showEditor ? null : RenderCrmSmartSearch(),
            Actions = actions,
            ViewButtons = _showEditor
                ? []
                :
                [
                    new PageHeaderViewButton
                    {
                        Key = "kanban",
                        Label = "Tablero",
                        Icon = "bi-kanban",
                        Active = _viewMode == "kanban",
                        Disabled = _loading,
                        OnClick = () => RunHeaderActionAsync(() => SetModeAsync("kanban"))
                    },
                    new PageHeaderViewButton
                    {
                        Key = "lista",
                        Label = "Lista",
                        Icon = "bi-table",
                        Active = _viewMode == "lista",
                        Disabled = _loading,
                        OnClick = () => RunHeaderActionAsync(() => SetModeAsync("lista"))
                    },
                    new PageHeaderViewButton
                    {
                        Key = "resumen",
                        Label = "Resumen",
                        Icon = "bi-bar-chart",
                        Active = _viewMode == "resumen",
                        Disabled = _loading,
                        OnClick = () => RunHeaderActionAsync(() => SetModeAsync("resumen"))
                    }
                ]
        });
    }

    private async Task OnHeaderSearchInputAsync(ChangeEventArgs args)
    {
        _filters.Texto = args.Value?.ToString() ?? string.Empty;
        UpdatePageHeader();
        await Task.CompletedTask;
    }

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }

    private Task ToggleSearchPanelAsync()
    {
        _searchPanelOpen = !_searchPanelOpen;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private Task OpenSearchPanelAsync()
    {
        if (_searchPanelOpen)
            return Task.CompletedTask;

        _searchPanelOpen = true;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private IReadOnlyList<FilterChip> GetFilterChips()
    {
        var chips = new List<FilterChip>();
        if (!string.IsNullOrWhiteSpace(_filters.Texto))
            chips.Add(new("texto", $"Buscar: {_filters.Texto}"));
        if (_filters.IdEtapa is int idEtapa)
            chips.Add(new("etapa", $"Etapa: {_lookups.Etapas.FirstOrDefault(x => x.IdEtapa == idEtapa)?.Nombre ?? idEtapa.ToString()}"));
        if (_filters.SoloSinAsignar)
            chips.Add(new("sin-asignar", "Sin asignar"));
        if (!string.IsNullOrWhiteSpace(_filters.IdTecnico))
            chips.Add(new("asignado", IsMyFlowActive ? "Mi flujo" : $"Asignado: {_lookups.Tecnicos.FirstOrDefault(x => x.IdTecnico == _filters.IdTecnico)?.Nombre ?? _filters.IdTecnico}"));
        if (_filters.IdEtiqueta is int idEtiqueta)
            chips.Add(new("etiqueta", $"Etiqueta: {_lookups.Etiquetas.FirstOrDefault(x => x.IdEtiqueta == idEtiqueta)?.Nombre ?? idEtiqueta.ToString()}"));
        if (_filters.IncluirCerradas)
            chips.Add(new("cerradas", "Incluye ganadas/perdidas"));
        return chips;
    }

    private async Task RemoveFilterChipAsync(string key)
    {
        switch (key)
        {
            case "texto":
                _filters.Texto = string.Empty;
                break;
            case "etapa":
                _filters.IdEtapa = null;
                break;
            case "asignado":
                _filters.IdTecnico = null;
                break;
            case "sin-asignar":
                _filters.SoloSinAsignar = false;
                break;
            case "etiqueta":
                _filters.IdEtiqueta = null;
                break;
            case "cerradas":
                _filters.IncluirCerradas = false;
                break;
        }
        UpdatePageHeader();
        await SearchAsync();
    }

    private async Task RunHeaderActionAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        finally
        {
            // Reconstruye el header con el estado actual (ej. Busy=false tras guardar),
            // si no el botón queda "Procesando..." aunque la acción ya terminó.
            UpdatePageHeader();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnStageFilterChangedAsync(ChangeEventArgs args)
    {
        _filters.IdEtapa = int.TryParse(args.Value?.ToString(), out var value) ? value : null;
        await SearchAsync();
    }

    private async Task OnTagFilterChangedAsync(ChangeEventArgs args)
    {
        _filters.IdEtiqueta = int.TryParse(args.Value?.ToString(), out var value) ? value : null;
        await SearchAsync();
    }

    private async Task OnTechFilterChangedAsync(ChangeEventArgs args)
    {
        _filters.IdTecnico = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value.ToString();
        _filters.SoloSinAsignar = false;
        await SearchAsync();
    }

    private async Task ApplyMyFlowAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUserTechId))
            return;
        _filters.IdTecnico = CurrentUserTechId;
        _filters.SoloSinAsignar = false;
        await SearchAsync();
    }

    private async Task ApplyUnassignedAsync()
    {
        _filters.IdTecnico = null;
        _filters.SoloSinAsignar = true;
        await SearchAsync();
    }

    private async Task ApplyOpenOnlyAsync()
    {
        _filters.IncluirCerradas = false;
        await SearchAsync();
    }

    private async Task ApplyAllStatusesAsync()
    {
        _filters.IncluirCerradas = true;
        await SearchAsync();
    }

    private async Task SetGroupAsync(string groupKey)
    {
        _viewSettings.AgruparPor = groupKey;
        await CrmSvc.SaveViewSettingsAsync(CurrentUserName, _viewSettings);
        ShowOk("Agrupación actualizada", "La preferencia de agrupación quedó guardada.");
        UpdatePageHeader();
    }

    private void ShowFutureFilterPlaceholder()
        => ShowOk("Filtro reservado", "Esta opción queda preparada para cuando sumemos esos datos al CRM.");

    private void SaveFavoritePlaceholder()
        => ShowOk("Favoritos", "Quedó reservado para guardar búsquedas favoritas por usuario.");

    private void BeginStageDrag(int idEtapa)
    {
        _dragOpportunityId = null;
        _dragStageId = idEtapa;
        _dropStageId = null;
    }

    private void BeginOpportunityDrag(long idOportunidad)
    {
        _dragStageId = null;
        _dragOpportunityId = idOportunidad;
        _dropStageId = null;
    }

    private void MarkStageDropTarget(int idEtapa)
    {
        if (_dragStageId is not null || _dragOpportunityId is not null)
            _dropStageId = idEtapa;
    }

    private async Task DropOnStageAsync(int targetStageId)
    {
        if (_dragOpportunityId is long opportunityId)
        {
            await MoveOpportunityToStageAsync(opportunityId, targetStageId);
            return;
        }

        if (_dragStageId is int sourceStageId && sourceStageId != targetStageId)
        {
            await MoveStageAsync(sourceStageId, targetStageId);
        }
    }

    private async Task MoveOpportunityToStageAsync(long opportunityId, int targetStageId)
    {
        var item = _kanban.FirstOrDefault(x => x.IdOportunidad == opportunityId);
        if (item is null || item.IdEtapa == targetStageId)
        {
            ClearDragState();
            return;
        }

        // Si la etapa destino es "perdida", pedimos el motivo antes de mover.
        if (_lookups.Etapas.Any(x => x.IdEtapa == targetStageId && x.EsPerdida))
        {
            _lostOpportunityId = opportunityId;
            _lostStageId = targetStageId;
            _lostMotivoId = null;
            _showLostReason = true;
            ClearDragState();
            return;
        }

        await RunAsync(async () =>
        {
            await CrmSvc.QuickUpdateAsync(new CrmQuickUpdateRequest
            {
                IdOportunidad = opportunityId,
                IdEtapa = targetStageId,
                UsuarioAccion = CurrentUserName
            });
            await ReloadCurrentViewAsync(resetPage: false);
            ShowOk("Oportunidad movida", "La oportunidad cambió de etapa.");
