            await CotizSvc.DeleteAsync(id, AppUserSession.CurrentUser?.UserName);
            await LoadCotizacionesAsync();
        });
    }

    private async Task OnClienteBuscarAfter()
    {
        var texto = (_form.ClienteCodigo ?? string.Empty).Trim();
        if (texto.Length < 2)
        {
            _clienteResultados = [];
            _clienteDropdownOpen = false;
            return;
        }

        _clienteBuscarCts?.Cancel();
        var cts = new CancellationTokenSource();
        _clienteBuscarCts = cts;
        try
        {
            await Task.Delay(250, cts.Token);
            var page = await ClientesSvc.SearchAsync(CuentaComercialTipo.Cliente, new CuentaComercialFilters { Texto = texto, PageNumber = 1, PageSize = 8 }, cts.Token);
            if (cts.Token.IsCancellationRequested)
                return;
            _clienteResultados = page.Items.ToList();
            _clienteDropdownOpen = _clienteResultados.Count > 0;
        }
        catch (OperationCanceledException) { }
    }

    private void SeleccionarCliente(CuentaComercialGridItemDto cli)
    {
        _form.ClienteCodigo = cli.Codigo;
        _clienteResultados = [];
        _clienteDropdownOpen = false;
    }

    private async Task AbrirCompartirAsync(CrmCotizacionDto cot)
    {
        _compartirCot = cot;
        _compartirUrl = string.Empty;
        _compartirEmail = string.Empty;
        _showCompartir = true;
        await RunAsync(async () =>
        {
            var share = await CotizSvc.EnsureShareAsync(cot.IdCotizacion);
            if (!string.IsNullOrWhiteSpace(share.RelativeUrl))
                _compartirUrl = BuildPublicBase().TrimEnd('/') + share.RelativeUrl;
        });
    }

    private void CerrarCompartir()
    {
        _showCompartir = false;
        _compartirCot = null;
    }

    private string BuildPublicBase()
    {
        var configured = Config["ServidorWeb:UrlBasePublica"];
        return string.IsNullOrWhiteSpace(configured) ? Nav.BaseUri : configured;
    }

    private async Task EnviarEmailCotAsync()
    {
        if (_compartirCot is null || string.IsNullOrWhiteSpace(_compartirEmail))
            return;
        await RunAsync(async () =>
        {
            await CotizSvc.SendByEmailAsync(_compartirCot.IdCotizacion, _compartirEmail.Trim(), string.IsNullOrWhiteSpace(_compartirUrl) ? null : _compartirUrl);
            _showCompartir = false;
            await LoadCotizacionesAsync();
            ShowOk("Email enviado", $"La cotización se envió a {_compartirEmail.Trim()}.");
        });
    }

    private async Task EnviarWhatsAppCotAsync()
    {
        if (_compartirCot is null || _detail?.IdConversacion is not long idConv)
            return;
        await RunAsync(async () =>
        {
            var texto = string.IsNullOrWhiteSpace(_compartirUrl)
                ? $"Hola, te comparto la cotización {_compartirCot.CodigoVisible} por un total de {FormatMoney(_compartirCot.Total)}."
                : $"Hola, te comparto la cotización {_compartirCot.CodigoVisible}. La podés ver acá: {_compartirUrl}";
            await ConvSvc.SendMessageAsync(new ConversacionSendMessageRequest
            {
                IdConversacion = idConv,
                Texto = texto,
                MessageType = "TEXT",
                UsuarioAccion = AppUserSession.CurrentUser?.UserName
            });
            _showCompartir = false;
            ShowOk("Enviado por WhatsApp", "La cotización se envió a la conversación del cliente.");
        });
    }

