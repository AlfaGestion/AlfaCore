        || string.Equals(x.IdTecnico, CurrentUserName, StringComparison.OrdinalIgnoreCase))?.IdTecnico;
    private bool IsMyFlowActive => !string.IsNullOrWhiteSpace(CurrentUserTechId)
        && string.Equals(_filters.IdTecnico, CurrentUserTechId, StringComparison.OrdinalIgnoreCase);
