    private (decimal neto, decimal conIva) CotizUnit(CrmCotizacionLineRequest l)
    {
        var factor = 1m + l.TasaIva / 100m;
        if (_cotizPricing.PreciosConIva)
            return (factor == 0 ? l.PrecioUnitario : Math.Round(l.PrecioUnitario / factor, 4), l.PrecioUnitario);
        return (l.PrecioUnitario, Math.Round(l.PrecioUnitario * factor, 4));
    }
    private decimal CotizTotalNeto => _cotizLineas.Sum(l => Math.Round(CotizUnit(l).neto * l.Cantidad, 2));
    private decimal CotizTotal => _cotizLineas.Sum(l => Math.Round(CotizUnit(l).conIva * l.Cantidad, 2));
    private decimal CotizTotalIva => CotizTotal - CotizTotalNeto;

