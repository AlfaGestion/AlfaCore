    private static string FormatProximaAccion(DateTime vencimiento)
    {
        var hoy = DateTime.Today;
        var dia = vencimiento.Date;
        if (dia == hoy)
            return $"Hoy {vencimiento:HH:mm}";
        if (dia == hoy.AddDays(1))
            return $"Mañana {vencimiento:HH:mm}";
        if (dia == hoy.AddDays(-1))
            return $"Ayer {vencimiento:HH:mm}";
        return vencimiento.ToString("dd/MM HH:mm");
    }

