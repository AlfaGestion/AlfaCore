@page "/crm"
@page "/{idweb}/{idbase:int}/crm"
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Web
@inject AlfaCore.Services.ICrmService CrmSvc
@inject AlfaCore.Services.ICrmCotizacionService CotizSvc
@inject AlfaCore.Services.IConversacionesService ConvSvc
@inject AlfaCore.Services.ICuentasComercialesService ClientesSvc
@inject IConfiguration Config
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>CRM | Alfa Gestión</PageTitle>

<section class="page-grid crm-page">
    @if (_feedback is not null)
    {
        <section class="crm-feedback">
            <div class="editor-msg @GetFeedbackClass()">
                <strong>@_feedback.Title</strong>
                <p>@_feedback.Message</p>
                @if (!string.IsNullOrWhiteSpace(_feedback.Code))
                {
                    <small>Código: @_feedback.Code</small>
                }
            </div>
        </section>
    }

    @if (_showEditor)
    {
        @RenderOpportunityPage()
    }
    @if (!_showEditor && _loading)
    {
        <section class="crm-loading">
            <p class="muted">Cargando CRM...</p>
        </section>
    }
    else if (!_showEditor && _viewMode == "kanban")
    {
        <section class="crm-kanban">
            @foreach (var stage in _lookups.Etapas)
            {
                var items = _kanban.Where(x => x.IdEtapa == stage.IdEtapa).ToList();
                var isCollapsed = _collapsedStageIds.Contains(stage.IdEtapa);
                var stats = GetStageTimingStats(items);
                <article class="@GetStageClass(stage.IdEtapa)"
                         @ondragenter="() => MarkStageDropTarget(stage.IdEtapa)"
                         @ondragover:preventDefault
                         @ondrop="() => DropOnStageAsync(stage.IdEtapa)">
                    <header class="crm-stage__header"
                            draggable="true"
                            @ondragstart="() => BeginStageDrag(stage.IdEtapa)"
                            @ondragend="ClearDragState"
                            @ondragenter="() => MarkStageDropTarget(stage.IdEtapa)"
                            @ondragover:preventDefault
                            @ondrop="() => DropOnStageAsync(stage.IdEtapa)">
                        <span role="button"
                            tabindex="0"
                            class="crm-stage__drag"
                            title="Arrastrar etapa">
                            <i class="bi bi-grip-vertical"></i>
                        </span>
                        <span class="crm-stage__dot" style="background:@stage.Color"></span>
                        <div class="crm-stage__title">
                            <h3>@stage.Nombre</h3>
                            <small>@items.Count oportunidad(es) · @FormatMoney(items.Sum(x => x.ImporteEstimado))</small>
                            <div class="crm-stage__health" title="Estado por cierre estimado">
                                <span class="is-ok" style="width:@stats.Ok%"></span>
                                <span class="is-warning" style="width:@stats.Warning%"></span>
                                <span class="is-late" style="width:@stats.Late%"></span>
                                <span class="is-empty" style="width:@stats.Empty%"></span>
                            </div>
                        </div>
                        <div class="crm-stage__actions">
                            <button type="button" title="Carga rápida" @onclick="() => ToggleQuickAdd(stage.IdEtapa)">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <button type="button" title="Ajustes de etapa" @onclick="() => ToggleStageMenu(stage.IdEtapa)">
                                <i class="bi bi-gear"></i>
                            </button>
                            @if (_stageMenuId == stage.IdEtapa)
                            {
                                <div class="crm-stage-menu" @onclick:stopPropagation>
                                    <button type="button" @onclick="() => ToggleStageCollapse(stage.IdEtapa)"><i class="bi bi-arrows-collapse"></i> @(_collapsedStageIds.Contains(stage.IdEtapa) ? "Desplegar" : "Plegar")</button>
                                    <button type="button" @onclick="() => EditStageFromKanban(stage)"><i class="bi bi-pencil"></i> Editar</button>
                                    <button type="button" @onclick="ShowAutomationPlaceholder"><i class="bi bi-magic"></i> Automatizaciones</button>
                                    <button type="button" class="is-danger" @onclick="() => DeleteStageFromKanbanAsync(stage.IdEtapa)"><i class="bi bi-trash"></i> Eliminar</button>
                                </div>
                            }
                        </div>
                    </header>
                    @if (!isCollapsed)
                    {
                        <div class="crm-stage__body"
                             @ondragenter="() => MarkStageDropTarget(stage.IdEtapa)"
                             @ondragover:preventDefault
                             @ondrop="() => DropOnStageAsync(stage.IdEtapa)">
                            @if (_quickAddStageId == stage.IdEtapa)
                            {
                                <div class="crm-quick-card">
                                    <input maxlength="180" placeholder="Nombre de la oportunidad" @bind="_quickForm.Titulo" />
                                    <input maxlength="20" placeholder="Empresa / código cliente" @bind="_quickForm.ClienteCodigo" />
                                    <input type="number" placeholder="Contacto" @bind="_quickForm.IdContacto" />
                                    <input maxlength="120" placeholder="Correo electrónico del contacto" @bind="_quickEmail" />
                                    <input maxlength="80" placeholder="Teléfono del contacto" @bind="_quickPhone" />
                                    <input type="number" step="0.01" min="0" placeholder="$ 0,00" @bind="_quickForm.ImporteEstimado" />
                                    <div class="crm-quick-card__stars" aria-label="Prioridad">
                                        @for (var i = 1; i <= 3; i++)
                                        {
                                            var value = i;
                                            <button type="button" class="@(value <= _quickForm.Prioridad ? "is-active" : string.Empty)" @onclick="() => _quickForm.Prioridad = value">
                                                <i class="bi bi-star-fill"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="crm-quick-card__actions">
                                        <button type="button" class="btn btn--primary btn--sm" @onclick="() => SaveQuickOpportunityAsync(stage.IdEtapa)">Agregar</button>
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="CancelQuickAdd">Cancelar</button>
                                    </div>
                                </div>
                            }
                            @if (items.Count == 0)
                            {
                                <div class="crm-empty-column">Sin oportunidades</div>
                            }
                            @foreach (var item in items)
                            {
                                <article role="button"
                                         tabindex="0"
                                         class="@GetOpportunityDragClass(item.IdOportunidad)"
                                         draggable="true"
                                         @ondragstart="() => BeginOpportunityDrag(item.IdOportunidad)"
                                         @ondragstart:stopPropagation
                                         @ondragend="ClearDragState"
                                         @onclick="() => OpenDetailAsync(item.IdOportunidad)">
                                    <span class="crm-card__code">@($"#{item.CodigoVisible}")</span>
                                    <strong>@item.Titulo</strong>
                                    <span>@Display(item.ClienteNombre, item.ClienteCodigo, "Sin cliente")</span>
                                    <div class="crm-card__meta">
                                        <span>@FormatMoney(item.ImporteEstimado)</span>
                                        <span>@item.Probabilidad%</span>
                                    </div>
                                    @if (item.ProximaAccionVencimiento.HasValue)
                                    {
                                        <div class="crm-card__accion @(item.ProximaAccionVencida ? "is-vencida" : string.Empty)" title="@item.ProximaAccionTitulo">
                                            <i class="bi @GetTareaIcon(item.ProximaAccionTipo)"></i>
                                            <span>@FormatProximaAccion(item.ProximaAccionVencimiento.Value)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="crm-card__accion is-sin-accion" title="Sin próxima acción agendada">
                                            <i class="bi bi-calendar-x"></i>
                                            <span>Sin próxima acción</span>
                                        </div>
                                    }
                                    <div class="crm-tags">
                                        @foreach (var tag in item.Etiquetas.Take(3))
                                        {
                                            <span class="crm-tag" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </article>
            }
            <div class="crm-stage-add">
                @if (_addingStageInline)
                {
                    <div class="crm-stage-add__form">
                        <input maxlength="80" placeholder="Etapa..." @bind="_inlineStageName" />
                        <button type="button" class="is-ok" title="Guardar etapa" @onclick="SaveInlineStageAsync"><i class="bi bi-check-lg"></i></button>
                        <button type="button" class="is-cancel" title="Cancelar" @onclick="CancelInlineStage"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div class="crm-stage-add__ghost"></div>
                    <div class="crm-stage-add__ghost"></div>
                    <div class="crm-stage-add__ghost"></div>
                }
                else
                {
                    <button type="button" @onclick="StartInlineStage">
                        <i class="bi bi-plus-lg"></i>
                        <span>Agregar etapa</span>
                    </button>
                }
            </div>
        </section>
    }
    else if (!_showEditor && _viewMode == "resumen")
    {
        <section class="crm-dashboard">
            @if (_dashboard is null)
            {
                <div class="crm-empty-column">Sin datos para mostrar.</div>
            }
            else
            {
                <div class="crm-kpi-row">
                    <div class="crm-kpi">
                        <span class="crm-kpi__label">Pipeline abierto</span>
                        <strong class="crm-kpi__value">@FormatMoney(_dashboard.ImporteBruto)</strong>
                        <span class="crm-kpi__hint">@_dashboard.TotalAbiertas oportunidad(es)</span>
                    </div>
                    <div class="crm-kpi crm-kpi--accent">
                        <span class="crm-kpi__label">Forecast ponderado</span>
                        <strong class="crm-kpi__value">@FormatMoney(_dashboard.ImportePonderado)</strong>
                        <span class="crm-kpi__hint">importe × probabilidad</span>
                    </div>
                    <div class="crm-kpi">
                        <span class="crm-kpi__label">Tasa de conversión</span>
                        <strong class="crm-kpi__value">@_dashboard.TasaConversion.ToString("P0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong>
                        <span class="crm-kpi__hint">@_dashboard.Ganadas ganada(s) / @_dashboard.Perdidas perdida(s)</span>
                    </div>
                    <div class="crm-kpi @(_dashboard.Estancadas > 0 ? "crm-kpi--warn" : string.Empty)">
                        <span class="crm-kpi__label">Estancadas</span>
                        <strong class="crm-kpi__value">@_dashboard.Estancadas</strong>
                        <span class="crm-kpi__hint">sin actividad hace +@_dashboard.DiasEstancamiento días</span>
                    </div>
                </div>

                <div class="crm-dashboard-grid">
                    <div class="crm-panel">
                        <h3>Pipeline por etapa</h3>
                        @{
                            var maxEtapa = _dashboard.PorEtapa.Count == 0 ? 0m : _dashboard.PorEtapa.Max(x => x.ImporteBruto);
                        }
                        @if (_dashboard.PorEtapa.Count == 0)
                        {
                            <p class="muted">Sin oportunidades abiertas.</p>
                        }
                        else
                        {
                            @foreach (var etapa in _dashboard.PorEtapa)
                            {
                                <div class="crm-bar-row">
                                    <div class="crm-bar-row__head">
                                        <span><span class="crm-bar-dot" style="background:@(string.IsNullOrWhiteSpace(etapa.Color) ? "#38BDF8" : etapa.Color)"></span>@etapa.Nombre</span>
                                        <span>@FormatMoney(etapa.ImporteBruto) · @etapa.Cantidad</span>
                                    </div>
                                    <div class="crm-bar">
                                        <div class="crm-bar__fill" style="width:@(BarWidth(etapa.ImporteBruto, maxEtapa))%;background:@(string.IsNullOrWhiteSpace(etapa.Color) ? "#38BDF8" : etapa.Color)"></div>
                                    </div>
                                    <small class="muted">Ponderado: @FormatMoney(etapa.ImportePonderado)</small>
                                </div>
                            }
                        }
                    </div>

                    <div class="crm-panel">
                        <h3>Ranking por vendedor</h3>
                        @if (_dashboard.PorTecnico.Count == 0)
                        {
                            <p class="muted">Sin oportunidades abiertas.</p>
                        }
                        else
                        {
                            <table class="crm-rank-table">
                                <thead>
                                    <tr><th>Vendedor</th><th>Abiertas</th><th>Pipeline</th><th>Ponderado</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var tec in _dashboard.PorTecnico)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrWhiteSpace(tec.Nombre) ? "Sin asignar" : tec.Nombre)</td>
                                            <td>@tec.Abiertas</td>
                                            <td>@FormatMoney(tec.ImporteBruto)</td>
                                            <td>@FormatMoney(tec.ImportePonderado)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="crm-panel">
                        <h3>Motivos de pérdida</h3>
                        @{
                            var totalPerdidas = _dashboard.MotivosPerdida.Sum(x => x.Cantidad);
                            var maxMotivo = _dashboard.MotivosPerdida.Count == 0 ? 0 : _dashboard.MotivosPerdida.Max(x => x.Cantidad);
                        }
                        @if (_dashboard.MotivosPerdida.Count == 0)
                        {
                            <p class="muted">Todavía no hay oportunidades perdidas.</p>
                        }
                        else
                        {
                            @foreach (var motivo in _dashboard.MotivosPerdida)
                            {
                                <div class="crm-bar-row">
                                    <div class="crm-bar-row__head">
                                        <span>@motivo.Nombre</span>
                                        <span>@motivo.Cantidad@(totalPerdidas > 0 ? $" · {((double)motivo.Cantidad / totalPerdidas).ToString("P0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))}" : string.Empty)</span>
                                    </div>
                                    <div class="crm-bar">
                                        <div class="crm-bar__fill" style="width:@(BarWidth(motivo.Cantidad, maxMotivo))%;background:#F87171"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </section>
    }
    else if (!_showEditor)
    {
        <section class="crm-list">
            <table class="crm-list-table" data-sticky-list-header>
                <thead>
                    <tr>
                        @foreach (var col in VisibleColumns)
                        {
                            <th>@col.Label</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _page.Items)
                    {
                        <tr>
                            @foreach (var col in VisibleColumns)
                            {
                                <td>@RenderCell(item, col.Key)</td>
                            }
                            <td class="table-actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenDetailAsync(item.IdOportunidad)">
                                    <i class="bi bi-pencil"></i> Abrir
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="crm-pager">
                <span>@_page.Total registro(s) · página @_page.PageNumber de @Math.Max(1, _page.TotalPages)</span>
                <div class="actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="PrevPageAsync" disabled="@(!_page.HasPrev)">Anterior</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="NextPageAsync" disabled="@(!_page.HasNext)">Siguiente</button>
                </div>
            </div>
        </section>
    }
</section>

@if (_showStages)
{
    <div class="crm-modal-layer" @onclick="CloseStages">
        <section class="panel-card crm-modal crm-modal--small" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Etapas del CRM</h3>
                    <p class="panel-card__subtitle">Renombrá, creá o eliminá etapas del pipeline.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseStages"><i class="bi bi-x-circle"></i> Cerrar</button>
            </div>
            <div class="crm-stage-form">
                <input maxlength="80" placeholder="Nombre" @bind="_stageDraft.Nombre" />
                <input type="color" @bind="_stageDraft.Color" />
                <input type="number" @bind="_stageDraft.Orden" title="Orden" />
                <label class="checkbox"><input type="checkbox" @bind="_stageDraft.EsGanada" /> <span>Ganada</span></label>
                <label class="checkbox"><input type="checkbox" @bind="_stageDraft.EsPerdida" /> <span>Perdida</span></label>
                <button type="button" class="btn btn--primary btn--sm" @onclick="SaveStageAsync"><i class="bi bi-floppy"></i> Guardar</button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="NewStage">Nueva</button>
            </div>
            @foreach (var stage in _lookups.Etapas)
            {
                <div class="crm-admin-row">
                    <span class="crm-stage__dot" style="background:@stage.Color"></span>
                    <strong>@stage.Nombre</strong>
                    <small>Orden @stage.Orden</small>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditStage(stage)">Editar</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => DeleteStageAsync(stage.IdEtapa)">Eliminar</button>
                </div>
            }
        </section>
    </div>
}

@if (_showTags)
{
    <div class="crm-modal-layer" @onclick="CloseTags">
        <section class="panel-card crm-modal crm-modal--small" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Etiquetas CRM</h3>
                    <p class="panel-card__subtitle">Clasificá oportunidades por interés, origen o urgencia.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseTags"><i class="bi bi-x-circle"></i> Cerrar</button>
            </div>
            <div class="crm-stage-form">
                <input maxlength="60" placeholder="Nombre" @bind="_tagDraft.Nombre" />
                <input type="color" @bind="_tagDraft.Color" />
                <button type="button" class="btn btn--primary btn--sm" @onclick="SaveTagAsync"><i class="bi bi-floppy"></i> Guardar</button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="NewTag">Nueva</button>
            </div>
            @foreach (var tag in _lookups.Etiquetas)
            {
                <div class="crm-admin-row">
                    <span class="crm-tag" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditTag(tag)">Editar</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => DeleteTagAsync(tag.IdEtiqueta)">Eliminar</button>
                </div>
            }
        </section>
    </div>
}

@if (_showLostReason)
{
    <div class="crm-modal-layer" @onmousedown="CancelLostReason">
        <section class="panel-card crm-modal crm-modal--small" @onmousedown:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Motivo de pérdida</h3>
                    <p class="panel-card__subtitle">Indicá por qué se perdió esta oportunidad.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CancelLostReason"><i class="bi bi-x-circle"></i> Cancelar</button>
            </div>
            <div class="field">
                <label>Motivo <span class="crm-required">*</span></label>
                <select @bind="_lostMotivoId" disabled="@_saving">
                    <option value="">Elegí un motivo…</option>
                    @foreach (var motivo in _lookups.MotivosPerdida)
                    {
                        <option value="@motivo.IdMotivo">@motivo.Nombre</option>
                    }
                </select>
            </div>
            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="ConfirmLostReasonAsync" disabled="@_saving"><i class="bi bi-check2"></i> Marcar como perdida</button>
                <button type="button" class="btn btn--ghost" @onclick="CancelLostReason">Cancelar</button>
            </div>
        </section>
    </div>
}

@if (_showMotivos)
{
    <div class="crm-modal-layer" @onclick="CloseMotivos">
        <section class="panel-card crm-modal crm-modal--small" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Motivos de pérdida</h3>
                    <p class="panel-card__subtitle">Personalizá los motivos disponibles al perder una oportunidad.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseMotivos"><i class="bi bi-x-circle"></i> Cerrar</button>
            </div>
            <div class="crm-stage-form">
                <input maxlength="100" placeholder="Nombre" @bind="_motivoDraft.Nombre" />
                <input type="number" @bind="_motivoDraft.Orden" title="Orden" />
                <button type="button" class="btn btn--primary btn--sm" @onclick="SaveMotivoAsync"><i class="bi bi-floppy"></i> Guardar</button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="NewMotivo">Nuevo</button>
            </div>
            @foreach (var motivo in _lookups.MotivosPerdida)
            {
                <div class="crm-admin-row">
                    <strong>@motivo.Nombre</strong>
                    <small>Orden @motivo.Orden</small>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditMotivo(motivo)">Editar</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => DeleteMotivoAsync(motivo.IdMotivo)">Eliminar</button>
                </div>
            }
        </section>
    </div>
}

@if (_showCotizEditor)
{
    <div class="crm-modal-layer" @onmousedown="CerrarCotizEditor">
        <section class="panel-card crm-modal crm-modal--wide" @onmousedown:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@(_cotizEditId > 0 ? "Editar cotización" : "Nueva cotización")</h3>
                    <p class="panel-card__subtitle">
                        @(_cotizPricing.EsConsumidorFinal ? "Consumidor final" : (string.IsNullOrWhiteSpace(_cotizPricing.ClienteNombre) ? "Sin cliente" : _cotizPricing.ClienteNombre))
                        · Lista @(string.IsNullOrWhiteSpace(_cotizPricing.IdLista) ? "maestro" : _cotizPricing.IdLista) · Clase @_cotizPricing.ClasePrecio
                        · @(_cotizPricing.PreciosConIva ? "precios con IVA" : "precios netos")
                    </p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CerrarCotizEditor"><i class="bi bi-x-circle"></i> Cerrar</button>
            </div>

            <div class="crm-cotiz-toolbar">
                <div class="field">
                    <label>Cliente (código)</label>
                    <div class="crm-inline-row">
                        <input maxlength="30" @bind="_cotizClienteCodigo" placeholder="Vacío = consumidor final" />
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="AplicarClienteCotizAsync" disabled="@_saving">Aplicar</button>
                    </div>
                </div>
                <div class="field">
                    <label>Estado</label>
                    <select @bind="_cotizForm.Estado">
                        <option value="BORRADOR">Borrador</option>
                        <option value="ENVIADA">Enviada</option>
                        <option value="ACEPTADA">Aceptada</option>
                        <option value="RECHAZADA">Rechazada</option>
                    </select>
                </div>
                <div class="field">
                    <label>Vence</label>
                    <input type="date" @bind="_cotizForm.FechaVencimiento" />
                </div>
            </div>

            @if (_cotizEsServicio)
            {
                <div class="crm-cotiz-ia">
                    <label><i class="bi bi-stars"></i> Asistente de IA</label>
                    <div class="crm-inline-row">
                        <input placeholder="Ej: cotizar Alfa Gestión para 5 usuarios, con soporte y capacitación" @bind="_cotizIaPrompt" @onkeydown="OnCotizIaKeyDown" />
                        <button type="button" class="btn btn--primary btn--sm" @onclick="GenerarPropuestaIaAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_cotizIaPrompt))">
                            @if (_cotizIaCargando)
                            {
                                <span>Generando…</span>
                            }
                            else
                            {
                                <span><i class="bi bi-magic"></i> Generar</span>
                            }
                        </button>
                    </div>
                    <small class="muted">La IA redacta el texto de la propuesta. Los precios los cargás vos abajo (no los inventa).</small>
                </div>

                <div class="crm-richtext">
                    <div class="crm-richtext__toolbar">
                        <button type="button" title="Negrita" @onclick='() => RichExec("bold")'><i class="bi bi-type-bold"></i></button>
                        <button type="button" title="Cursiva" @onclick='() => RichExec("italic")'><i class="bi bi-type-italic"></i></button>
                        <button type="button" title="Subrayado" @onclick='() => RichExec("underline")'><i class="bi bi-type-underline"></i></button>
                        <button type="button" title="Lista" @onclick='() => RichExec("insertUnorderedList")'><i class="bi bi-list-ul"></i></button>
                        <button type="button" title="Lista numerada" @onclick='() => RichExec("insertOrderedList")'><i class="bi bi-list-ol"></i></button>
                        <span class="crm-richtext__sep"></span>
                        <button type="button" title="Insertar imagen" @onclick="RichInsertImageAsync"><i class="bi bi-image"></i></button>
                        <button type="button" title="Check" @onclick='() => RichInsertText("✓ ")'>✓</button>
                        <button type="button" title="Flecha" @onclick='() => RichInsertText("→ ")'>→</button>
                        <button type="button" title="Estrella" @onclick='() => RichInsertText("★ ")'>★</button>
                    </div>
                    <div class="crm-richtext__area" contenteditable="true" @ref="_cotizEditorRef"></div>
                </div>
            }
            else
            {
                <div class="crm-cotiz-ia">
                    <label><i class="bi bi-stars"></i> Asistente de IA</label>
                    <div class="crm-inline-row">
                        <input placeholder="Ej: todos los tipos de harina, 10 kg de cada uno" @bind="_cotizIaPrompt" @onkeydown="OnCotizIaKeyDown" />
                        <button type="button" class="btn btn--primary btn--sm" @onclick="SugerirLineasIaAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_cotizIaPrompt))">
                            @if (_cotizIaCargando)
                            {
                                <span>Buscando…</span>
                            }
                            else
                            {
                                <span><i class="bi bi-magic"></i> Sugerir</span>
                            }
                        </button>
                    </div>
                    <small class="muted">La IA interpreta tu pedido y busca los artículos reales del catálogo. Los precios salen de la lista del cliente (no los inventa).</small>
                </div>

                @if (_cotizIaSugerencias.Count > 0)
                {
                    <div class="crm-cotiz-ia-sug">
                        <div class="crm-cotiz-ia-sug__head">
                            <strong>@_cotizIaSugerencias.Count sugerencia(s)</strong>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="ToggleTodasSugerencias">@(_cotizIaSeleccion.Count == _cotizIaSugerencias.Count ? "Ninguno" : "Todos")</button>
                                <button type="button" class="btn btn--primary btn--sm" @onclick="AgregarSugerenciasSeleccionadas" disabled="@(_cotizIaSeleccion.Count == 0)"><i class="bi bi-plus-lg"></i> Agregar (@_cotizIaSeleccion.Count)</button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => _cotizIaSugerencias.Clear()">Descartar</button>
                            </div>
                        </div>
                        <div class="crm-cotiz-results">
                            @foreach (var sug in _cotizIaSugerencias)
                            {
                                <label class="crm-cotiz-sug">
                                    <input type="checkbox" checked="@_cotizIaSeleccion.Contains(sug.IdArticulo)" @onchange="args => ToggleSugerencia(sug.IdArticulo, args)" />
                                    <span class="crm-cotiz-result__desc">@sug.Descripcion</span>
                                    <input class="crm-cotiz-cell num crm-cotiz-sug__cant" type="number" step="0.01" min="0" @bind="sug.Cantidad" title="Cantidad" />
                                    <span class="crm-cotiz-result__meta">@FormatMoney(_cotizPricing.PreciosConIva ? sug.PrecioUnitarioConIva : sug.PrecioUnitarioNeto)</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="crm-cotiz-search">
                    <input placeholder="Buscar artículo por código o descripción..." @bind="_cotizBusqueda" @bind:event="oninput" @onkeydown="OnCotizSearchKeyDown" />
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="BuscarArticulosCotizAsync" disabled="@_saving"><i class="bi bi-search"></i> Buscar</button>
                </div>
                @if (_cotizResultados.Count > 0)
                {
                    <div class="crm-cotiz-results">
                        @foreach (var art in _cotizResultados)
                        {
                            <button type="button" class="crm-cotiz-result" @onclick="() => AgregarArticuloCotiz(art)">
                                <span class="crm-cotiz-result__desc">@art.Descripcion</span>
                                <span class="crm-cotiz-result__meta">@art.IdArticulo · @FormatMoney(_cotizPricing.PreciosConIva ? art.PrecioUnitarioConIva : art.PrecioUnitarioNeto)</span>
                            </button>
                        }
                    </div>
                }
            }

            <table class="crm-cotiz-lines">
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th class="num">Cant.</th>
                        <th class="num">P. unit. @(_cotizPricing.PreciosConIva ? "(c/IVA)" : "(neto)")</th>
                        <th class="num">Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_cotizLineas.Count == 0)
                    {
                        <tr><td colspan="5" class="muted">@(_cotizEsServicio ? "Opcional: cargá el detalle de precios en líneas." : "Buscá y agregá artículos, o cargá una línea manual.")</td></tr>
                    }
                    else
                    {
                        @foreach (var l in _cotizLineas)
                        {
                            <tr>
                                <td><input class="crm-cotiz-cell" maxlength="200" @bind="l.Descripcion" /></td>
                                <td class="num"><input class="crm-cotiz-cell num" type="number" step="0.01" min="0" @bind="l.Cantidad" /></td>
                                <td class="num"><input class="crm-cotiz-cell num" type="number" step="0.01" min="0" @bind="l.PrecioUnitario" /></td>
                                <td class="num">@FormatMoney(Math.Round(l.Cantidad * l.PrecioUnitario, 2))</td>
                                <td><button type="button" class="crm-accion__del" @onclick="() => QuitarLineaCotiz(l)"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="crm-cotiz-add-manual">
                <button type="button" class="btn btn--ghost btn--sm" @onclick="AgregarLineaManualCotiz"><i class="bi bi-plus-lg"></i> Línea manual</button>
            </div>

            <div class="crm-cotiz-foot">
                <textarea rows="2" maxlength="2000" placeholder="Observaciones..." @bind="_cotizForm.Observaciones"></textarea>
                <div class="crm-cotiz-totals">
                    <div><span>Neto</span><strong>@FormatMoney(CotizTotalNeto)</strong></div>
                    <div><span>IVA</span><strong>@FormatMoney(CotizTotalIva)</strong></div>
                    <div class="crm-cotiz-totals__grand"><span>Total</span><strong>@FormatMoney(CotizTotal)</strong></div>
                </div>
            </div>

            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="GuardarCotizacionAsync" disabled="@(_saving || (!_cotizEsServicio && _cotizLineas.Count == 0))"><i class="bi bi-floppy"></i> Guardar cotización</button>
                <button type="button" class="btn btn--ghost" @onclick="CerrarCotizEditor">Cancelar</button>
            </div>
        </section>
    </div>
}

@if (_showCompartir && _compartirCot is not null)
{
    <div class="crm-modal-layer" @onmousedown="CerrarCompartir">
        <section class="panel-card crm-modal crm-modal--small" @onmousedown:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Enviar @_compartirCot.CodigoVisible</h3>
                    <p class="panel-card__subtitle">Compartí la cotización por email, WhatsApp o link.</p>
