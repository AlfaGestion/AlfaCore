    private static CrmViewSettingsDto CloneViewSettings(CrmViewSettingsDto source) => new()
    {
        AgruparPor = source.AgruparPor,
        Columnas = source.Columnas.Select(x => new CrmViewColumnDto { Key = x.Key, Label = x.Label, Visible = x.Visible, Order = x.Order }).ToList()
    };

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _feedback = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? new Feedback("No se pudo completar la operación", userFacing.UserMessage, userFacing.ErrorCode)
                : new Feedback("No se pudo completar la operación", ex.Message, null);
        }
        finally
        {
            _loading = false;
            _saving = false;
        }
    }

