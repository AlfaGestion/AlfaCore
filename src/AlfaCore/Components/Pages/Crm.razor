    private async Task GenerarPropuestaIaAsync()
    {
        if (string.IsNullOrWhiteSpace(_cotizIaPrompt))
            return;
        _cotizIaCargando = true;
        await RunAsync(async () =>
        {
            var html = await CotizSvc.GenerateServiceProposalAsync(_cotizIaPrompt, _cotizPricing.ClienteNombre);
            if (!string.IsNullOrWhiteSpace(html))
            {
                // Anexa al contenido existente en el editor, sin pisar lo ya escrito.
                var actual = await JS.InvokeAsync<string>("crmCotizacion.getHtml", _cotizEditorRef);
                await JS.InvokeVoidAsync("crmCotizacion.setHtml", _cotizEditorRef, string.IsNullOrWhiteSpace(actual) ? html : actual + html);
            }
        });
        _cotizIaCargando = false;
    }

    private async Task OnCotizIaKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Enter")
