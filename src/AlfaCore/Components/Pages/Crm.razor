                                        <strong>@cli.RazonSocial</strong>
                                        <small>@cli.Codigo</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="field">
                        <label>ID contacto</label>
                        <input type="number" @bind="_form.IdContacto" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Canal origen</label>
                        <select @bind="_form.CanalOrigen" disabled="@_saving">
                            <option value="">Manual</option>
                            <option value="WHATSAPP">WhatsApp</option>
                            <option value="INSTAGRAM">Instagram</option>
                            <option value="FACEBOOK">Facebook</option>
                            <option value="MERCADOLIBRE">Mercado Libre</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Conversación origen</label>
                        <input type="number" @bind="_form.IdConversacion" disabled="@_saving" />
                    </div>
                    <div class="field field--wide">
                        <label>Descripción @if (_extrayendoDatosIa) { <span class="crm-ia-hint"><i class="bi bi-stars"></i> completando con IA…</span> }</label>
                        <textarea rows="6" maxlength="4000" @bind="_form.Descripcion" disabled="@_saving"></textarea>
                    </div>
                </div>

                <div class="crm-tags-select">
                    @foreach (var tag in _lookups.Etiquetas)
                    {
                        <label class="checkbox">
                            <input type="checkbox" checked="@_selectedTags.Contains(tag.IdEtiqueta)" @onchange="args => ToggleTag(tag.IdEtiqueta, args)" disabled="@_saving" />
                            <span class="crm-tag" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                        </label>
                    }
                </div>
            </section>

            <section class="crm-activity-panel">
                <div class="crm-section-head">
                    <div>
                        <h3>Actividad</h3>
                        <p>Notas comerciales, cambios de etapa y próximos pasos.</p>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary btn--sm" @onclick="AddNoteAsync" disabled="@_saving || _detail is null || string.IsNullOrWhiteSpace(_noteText)">
                            <i class="bi bi-journal-plus"></i> Registrar nota
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="OpenConversationFromDetail"><i class="bi bi-whatsapp"></i> WhatsApp</button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="ShowActivityPlaceholder"><i class="bi bi-clock-history"></i> Actividad</button>
                    </div>
                </div>
                @if (_detail is null)
                {
                    <p class="muted">Guardá la oportunidad para empezar a registrar actividad.</p>
                }
                else
                {
                    <div class="crm-note">
                        <textarea rows="3" maxlength="4000" @bind="_noteText" placeholder="Agregar nota comercial..."></textarea>
                    </div>
                    <div class="crm-timeline">
                        @foreach (var activity in _detail.Actividad)
                        {
                            <article class="crm-activity">
                                <span class="crm-activity__dot"></span>
                                <div>
                                    <strong>@activity.TipoActividad</strong>
                                    <p>@activity.Descripcion</p>
                                    <small>@activity.Usuario · @FormatDate(activity.FechaHora)</small>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="crm-opportunity-side">
            <section class="crm-side-panel">
                <h3>Resumen</h3>
                <dl class="crm-summary">
                    <div><dt>Valor</dt><dd>@FormatMoney(_form.ImporteEstimado)</dd></div>
                    <div><dt>Probabilidad</dt><dd>@_form.Probabilidad%</dd></div>
                    <div><dt>Prioridad</dt><dd>@GetPriorityLabel(_form.Prioridad)</dd></div>
                    <div><dt>Cierre</dt><dd>@(_form.FechaCierreEstimada?.ToString("dd/MM/yyyy") ?? "-")</dd></div>
                </dl>
            </section>

            <section class="crm-side-panel">
                <h3>Próximas acciones</h3>
                @if (_detail is null)
                {
                    <p class="muted">Guardá la oportunidad para agendar su próxima acción.</p>
                }
                else
                {
                    <div class="crm-accion-form">
                        <select @bind="_nuevaTareaTipo">
                            <option value="TAREA">Tarea</option>
                            <option value="LLAMADA">Llamada</option>
                            <option value="EMAIL">Email</option>
                            <option value="REUNION">Reunión</option>
                            <option value="WHATSAPP">WhatsApp</option>
                        </select>
                        <input maxlength="200" placeholder="Qué hay que hacer..." @bind="_nuevaTareaTitulo" />
                        <input type="datetime-local" @bind="_nuevaTareaVencimiento" />
                        <button type="button" class="btn btn--primary btn--sm" @onclick="AddTareaAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_nuevaTareaTitulo))">
                            <i class="bi bi-plus-lg"></i> Agendar
                        </button>
                    </div>
                    @if (_detail.Tareas.Count == 0)
                    {
                        <p class="muted">Sin próximas acciones agendadas.</p>
                    }
                    else
                    {
                        <div class="crm-accion-list">
                            @foreach (var tarea in _detail.Tareas)
                            {
                                <article class="crm-accion @(tarea.Completada ? "is-done" : string.Empty) @(tarea.Vencida ? "is-vencida" : string.Empty)">
                                    <button type="button" class="crm-accion__check" title="@(tarea.Completada ? "Reabrir" : "Completar")" @onclick="() => ToggleTareaAsync(tarea)">
                                        <i class="bi @(tarea.Completada ? "bi-check-circle-fill" : "bi-circle")"></i>
                                    </button>
                                    <div class="crm-accion__body">
                                        <strong><i class="bi @GetTareaIcon(tarea.TipoAccion)"></i> @tarea.Titulo</strong>
                                        <small>@FormatDate(tarea.Vencimiento)@(string.IsNullOrWhiteSpace(tarea.TecnicoNombre) ? string.Empty : $" · {tarea.TecnicoNombre}")</small>
                                    </div>
                                    <button type="button" class="crm-accion__del" title="Eliminar" @onclick="() => DeleteTareaAsync(tarea)"><i class="bi bi-trash"></i></button>
                                </article>
