                            <i class="bi bi-box-seam"></i> Artículos
                        </button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => NuevaCotizacionAsync(CrmCotizacionTipos.Servicio)" disabled="@(_saving || _detail is null)" title="Cotización de servicio con IA">
                            <i class="bi bi-stars"></i> Servicio (IA)
                        </button>
                    </div>
                </div>
                @if (_detail is null)
                {
                    <p class="muted">Guardá la oportunidad para crear cotizaciones.</p>
                }
                else if (_cotizaciones.Count == 0)
                {
                    <p class="muted">Sin cotizaciones todavía.</p>
                }
                else
                {
                    <div class="crm-cotiz-list">
                        @foreach (var cot in _cotizaciones)
                        {
                            <article class="crm-cotiz-item">
                                <div class="crm-cotiz-item__body" @onclick="() => EditarCotizacionAsync(cot.IdCotizacion)">
                                    <strong>@cot.CodigoVisible <i class="bi @(cot.EsServicio ? "bi-stars" : "bi-box-seam")" title="@(cot.EsServicio ? "Servicio" : "Artículos")"></i></strong>
                                    <span class="crm-cotiz-estado crm-cotiz-estado--@cot.Estado.ToLowerInvariant()">@cot.Estado</span>
                                    <small>@FormatMoney(cot.Total) · @cot.Fecha.ToString("dd/MM/yyyy")@(cot.Vencida ? " · vencida" : string.Empty)</small>
                                </div>
                                <button type="button" class="crm-accion__del" title="Compartir / enviar" @onclick="() => AbrirCompartirAsync(cot)"><i class="bi bi-send"></i></button>
                                <button type="button" class="crm-accion__del" title="Eliminar" @onclick="() => EliminarCotizacionAsync(cot.IdCotizacion)"><i class="bi bi-trash"></i></button>
                            </article>
