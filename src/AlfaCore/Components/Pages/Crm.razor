@page "/crm"
@page "/{idweb}/{idbase:int}/crm"
@using AlfaCore.Models
@using Microsoft.AspNetCore.Components.Web
@inject AlfaCore.Services.ICrmService CrmSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPageHeaderService PageHeader
@implements IDisposable

<PageTitle>CRM | Alfa Gestión</PageTitle>

<section class="page-grid crm-page">
    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass()">
                <strong>@_feedback.Title</strong>
                <p>@_feedback.Message</p>
                @if (!string.IsNullOrWhiteSpace(_feedback.Code))
                {
                    <small>Código: @_feedback.Code</small>
                }
            </div>
        </section>
    }

    @if (_showEditor)
    {
        @RenderOpportunityPage()
    }
    else if (_searchPanelOpen)
    {
        @RenderSearchPanel()
    }

    @if (!_showEditor && _loading)
    {
        <section class="panel-card">
            <p class="muted">Cargando CRM...</p>
        </section>
    }
    else if (!_showEditor && _viewMode == "kanban")
    {
        <section class="crm-kanban">
            @foreach (var stage in _lookups.Etapas)
            {
                var items = _kanban.Where(x => x.IdEtapa == stage.IdEtapa).ToList();
                <article class="crm-stage">
                    <header>
                        <span class="crm-stage__dot" style="background:@stage.Color"></span>
                        <div>
                            <h3>@stage.Nombre</h3>
                            <small>@items.Count oportunidad(es) · @FormatMoney(items.Sum(x => x.ImporteEstimado))</small>
                        </div>
                    </header>
                    <div class="crm-stage__body">
                        @if (items.Count == 0)
                        {
                            <div class="crm-empty-column">Sin oportunidades</div>
                        }
                        @foreach (var item in items)
                        {
                            <button type="button" class="crm-card" @onclick="() => OpenDetailAsync(item.IdOportunidad)">
                                <span class="crm-card__code">@($"#{item.CodigoVisible}")</span>
                                <strong>@item.Titulo</strong>
                                <span>@Display(item.ClienteNombre, item.ClienteCodigo, "Sin cliente")</span>
                                <div class="crm-card__meta">
                                    <span>@FormatMoney(item.ImporteEstimado)</span>
                                    <span>@item.Probabilidad%</span>
                                </div>
                                <div class="crm-tags">
                                    @foreach (var tag in item.Etiquetas.Take(3))
                                    {
                                        <span class="crm-tag" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                </article>
            }
        </section>
    }
    else if (!_showEditor)
    {
        <section class="panel-card crm-list">
            <table>
                <thead>
                    <tr>
                        @foreach (var col in VisibleColumns)
                        {
                            <th>@col.Label</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _page.Items)
                    {
                        <tr>
                            @foreach (var col in VisibleColumns)
                            {
                                <td>@RenderCell(item, col.Key)</td>
                            }
                            <td class="table-actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenDetailAsync(item.IdOportunidad)">
                                    <i class="bi bi-pencil"></i> Abrir
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="crm-pager">
                <span>@_page.Total registro(s) · página @_page.PageNumber de @Math.Max(1, _page.TotalPages)</span>
                <div class="actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="PrevPageAsync" disabled="@(!_page.HasPrev)">Anterior</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="NextPageAsync" disabled="@(!_page.HasNext)">Siguiente</button>
                </div>
            </div>
        </section>
    }
</section>

@if (_showStages)
{
    <div class="crm-modal-layer" @onclick="CloseStages">
        <section class="panel-card crm-modal crm-modal--small" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Etapas del CRM</h3>
                    <p class="panel-card__subtitle">Renombrá, creá o eliminá etapas del pipeline.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseStages"><i class="bi bi-x-circle"></i> Cerrar</button>
            </div>
            <div class="crm-stage-form">
                <input maxlength="80" placeholder="Nombre" @bind="_stageDraft.Nombre" />
                <input type="color" @bind="_stageDraft.Color" />
                <input type="number" @bind="_stageDraft.Orden" title="Orden" />
                <label class="checkbox"><input type="checkbox" @bind="_stageDraft.EsGanada" /> <span>Ganada</span></label>
                <label class="checkbox"><input type="checkbox" @bind="_stageDraft.EsPerdida" /> <span>Perdida</span></label>
                <button type="button" class="btn btn--primary btn--sm" @onclick="SaveStageAsync"><i class="bi bi-floppy"></i> Guardar</button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="NewStage">Nueva</button>
            </div>
            @foreach (var stage in _lookups.Etapas)
            {
                <div class="crm-admin-row">
                    <span class="crm-stage__dot" style="background:@stage.Color"></span>
                    <strong>@stage.Nombre</strong>
                    <small>Orden @stage.Orden</small>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditStage(stage)">Editar</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => DeleteStageAsync(stage.IdEtapa)">Eliminar</button>
                </div>
            }
        </section>
    </div>
}

@if (_showTags)
{
    <div class="crm-modal-layer" @onclick="CloseTags">
        <section class="panel-card crm-modal crm-modal--small" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Etiquetas CRM</h3>
                    <p class="panel-card__subtitle">Clasificá oportunidades por interés, origen o urgencia.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseTags"><i class="bi bi-x-circle"></i> Cerrar</button>
            </div>
            <div class="crm-stage-form">
                <input maxlength="60" placeholder="Nombre" @bind="_tagDraft.Nombre" />
                <input type="color" @bind="_tagDraft.Color" />
                <button type="button" class="btn btn--primary btn--sm" @onclick="SaveTagAsync"><i class="bi bi-floppy"></i> Guardar</button>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="NewTag">Nueva</button>
            </div>
            @foreach (var tag in _lookups.Etiquetas)
            {
                <div class="crm-admin-row">
                    <span class="crm-tag" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditTag(tag)">Editar</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => DeleteTagAsync(tag.IdEtiqueta)">Eliminar</button>
                </div>
            }
        </section>
    </div>
}

@if (_showViewSettings)
{
    <div class="crm-modal-layer" @onclick="CloseViewSettings">
        <section class="panel-card crm-modal crm-modal--small" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configurar vista</h3>
                    <p class="panel-card__subtitle">Columnas visibles del listado CRM.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseViewSettings"><i class="bi bi-x-circle"></i> Cerrar</button>
            </div>
            <div class="crm-view-settings">
                @foreach (var col in _viewDraft.Columnas.OrderBy(x => x.Order))
                {
                    <label class="checkbox">
                        <input type="checkbox" checked="@col.Visible" @onchange="args => ToggleColumn(col.Key, args)" />
                        <span>@col.Label</span>
                    </label>
                }
            </div>
            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="SaveViewSettingsAsync"><i class="bi bi-floppy"></i> Guardar vista</button>
                <button type="button" class="btn btn--ghost" @onclick="CloseViewSettings">Cancelar</button>
            </div>
        </section>
    </div>
}

@code {
    private CrmLookupDto _lookups = new();
    private CrmFilters _filters = new();
    private PagedResult<CrmOpportunityDto> _page = new();
    private List<CrmOpportunityDto> _kanban = [];
    private CrmViewSettingsDto _viewSettings = new();
    private CrmViewSettingsDto _viewDraft = new();
    private string _viewMode = "kanban";
    private bool _loading;
    private bool _saving;
    private bool _showEditor;
    private bool _showStages;
    private bool _showTags;
    private bool _showViewSettings;
    private bool _searchPanelOpen;
    private CrmOpportunitySaveRequest _form = new();
    private CrmOpportunityDetailDto? _detail;
    private HashSet<int> _selectedTags = [];
    private CrmEtapaSaveRequest _stageDraft = new() { Color = "#2563EB", Orden = 10 };
    private CrmEtiquetaSaveRequest _tagDraft = new() { Color = "#14B8A6" };
    private string _noteText = string.Empty;
    private Feedback? _feedback;

    private IEnumerable<CrmViewColumnDto> VisibleColumns => _viewSettings.Columnas.Where(x => x.Visible).OrderBy(x => x.Order);

    private RenderFragment RenderCrmSmartSearch() => @<div class="smart-search crm-smart-search" @onclick:stopPropagation>
        <div class="smart-search__bar">
            <i class="bi bi-search"></i>
            <input type="search"
                   value="@_filters.Texto"
                   placeholder="Buscar oportunidad, cliente, contacto..."
                   disabled="@_loading"
                   @oninput="OnHeaderSearchInputAsync"
                   @onkeydown="HandleSearchKeyDownAsync" />
            <button type="button" class="smart-search__toggle @(_searchPanelOpen ? "is-active" : string.Empty)" @onclick="ToggleSearchPanelAsync" aria-label="Mostrar filtros">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
        <div class="smart-search__chips" aria-live="polite">
            @foreach (var chip in GetFilterChips())
            {
                <button type="button" class="smart-chip" @onclick="() => RemoveFilterChipAsync(chip.Key)">
                    <span>@chip.Label</span>
                    <i class="bi bi-x"></i>
                </button>
            }
            @if (!GetFilterChips().Any())
            {
                <span class="smart-search__hint">Filtrá por etapa, asignado, etiqueta o estado de cierre.</span>
            }
        </div>
    </div>;

    private RenderFragment RenderSearchPanel() => @<section class="panel-card crm-search-panel">
        <div class="field">
            <label>Etapa</label>
            <select @bind="_filters.IdEtapa">
                <option value="">Todas</option>
                @foreach (var stage in _lookups.Etapas)
                {
                    <option value="@stage.IdEtapa">@stage.Nombre</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Asignado</label>
            <select @bind="_filters.IdTecnico">
                <option value="">Todos</option>
                @foreach (var tech in _lookups.Tecnicos)
                {
                    <option value="@tech.IdTecnico">@tech.Nombre</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Etiqueta</label>
            <select @bind="_filters.IdEtiqueta">
                <option value="">Todas</option>
                @foreach (var tag in _lookups.Etiquetas)
                {
                    <option value="@tag.IdEtiqueta">@tag.Nombre</option>
                }
            </select>
        </div>
        <label class="checkbox crm-check">
            <input type="checkbox" @bind="_filters.IncluirCerradas" />
            <span>Incluir ganadas/perdidas</span>
        </label>
        <div class="actions">
            <button type="button" class="btn btn--primary" @onclick="SearchAsync" disabled="@_loading">
                <i class="bi bi-search"></i> Buscar
            </button>
            <button type="button" class="btn btn--ghost" @onclick="ClearFiltersAsync" disabled="@_loading">
                <i class="bi bi-eraser"></i> Limpiar
            </button>
        </div>
    </section>;

    private RenderFragment RenderOpportunityPage() => @<section class="crm-opportunity-page">
        <div class="crm-opportunity-main">
            <section class="panel-card crm-opportunity-form">
                <div class="crm-opportunity-title">
                    <span>@(_form.IdOportunidad > 0 ? $"#{_detail?.CodigoVisible}" : "Nueva")</span>
                    <input maxlength="180" @bind="_form.Titulo" disabled="@_saving" placeholder="Nombre de la oportunidad" />
                </div>

                <div class="crm-editor-grid">
                    <div class="field">
                        <label>Etapa</label>
                        <select @bind="_form.IdEtapa" disabled="@_saving">
                            @foreach (var stage in _lookups.Etapas)
                            {
                                <option value="@stage.IdEtapa">@stage.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Asignado</label>
                        <select @bind="_form.IdTecnico" disabled="@_saving">
                            <option value="">Sin asignar</option>
                            @foreach (var tech in _lookups.Tecnicos)
                            {
                                <option value="@tech.IdTecnico">@tech.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Importe estimado</label>
                        <input type="number" step="0.01" min="0" @bind="_form.ImporteEstimado" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Probabilidad</label>
                        <input type="number" min="0" max="100" @bind="_form.Probabilidad" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Prioridad</label>
                        <select @bind="_form.Prioridad" disabled="@_saving">
                            <option value="0">Sin prioridad</option>
                            <option value="1">Baja</option>
                            <option value="2">Media</option>
                            <option value="3">Alta</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Cierre estimado</label>
                        <input type="date" @bind="_form.FechaCierreEstimada" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Código cliente</label>
                        <input maxlength="20" @bind="_form.ClienteCodigo" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>ID contacto</label>
                        <input type="number" @bind="_form.IdContacto" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Canal origen</label>
                        <select @bind="_form.CanalOrigen" disabled="@_saving">
                            <option value="">Manual</option>
                            <option value="WHATSAPP">WhatsApp</option>
                            <option value="INSTAGRAM">Instagram</option>
                            <option value="FACEBOOK">Facebook</option>
                            <option value="MERCADOLIBRE">Mercado Libre</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Conversación origen</label>
                        <input type="number" @bind="_form.IdConversacion" disabled="@_saving" />
                    </div>
                    <div class="field field--wide">
                        <label>Descripción</label>
                        <textarea rows="6" maxlength="4000" @bind="_form.Descripcion" disabled="@_saving"></textarea>
                    </div>
                </div>

                <div class="crm-tags-select">
                    @foreach (var tag in _lookups.Etiquetas)
                    {
                        <label class="checkbox">
                            <input type="checkbox" checked="@_selectedTags.Contains(tag.IdEtiqueta)" @onchange="args => ToggleTag(tag.IdEtiqueta, args)" disabled="@_saving" />
                            <span class="crm-tag" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                        </label>
                    }
                </div>
            </section>

            <section class="panel-card crm-activity-panel">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Actividad</h3>
                        <p class="panel-card__subtitle">Notas comerciales, cambios de etapa y próximos pasos.</p>
                    </div>
                </div>
                @if (_detail is null)
                {
                    <p class="muted">Guardá la oportunidad para empezar a registrar actividad.</p>
                }
                else
                {
                    <div class="crm-note">
                        <textarea rows="3" maxlength="4000" @bind="_noteText" placeholder="Agregar nota comercial..."></textarea>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="AddNoteAsync" disabled="@_saving || string.IsNullOrWhiteSpace(_noteText)">
                            <i class="bi bi-plus-circle"></i> Nota
                        </button>
                    </div>
                    <div class="crm-timeline">
                        @foreach (var activity in _detail.Actividad)
                        {
                            <article class="crm-activity">
                                <span class="crm-activity__dot"></span>
                                <div>
                                    <strong>@activity.TipoActividad</strong>
                                    <p>@activity.Descripcion</p>
                                    <small>@activity.Usuario · @FormatDate(activity.FechaHora)</small>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="crm-opportunity-side">
            <section class="panel-card crm-side-panel">
                <h3>Resumen</h3>
                <dl class="crm-summary">
                    <div><dt>Valor</dt><dd>@FormatMoney(_form.ImporteEstimado)</dd></div>
                    <div><dt>Probabilidad</dt><dd>@_form.Probabilidad%</dd></div>
                    <div><dt>Prioridad</dt><dd>@GetPriorityLabel(_form.Prioridad)</dd></div>
                    <div><dt>Cierre</dt><dd>@(_form.FechaCierreEstimada?.ToString("dd/MM/yyyy") ?? "-")</dd></div>
                </dl>
            </section>

            <section class="panel-card crm-side-panel">
                <h3>Origen</h3>
                @if (_detail?.IdConversacion is long idConv)
                {
                    <a class="btn btn--ghost btn--sm" href="@($"/conversaciones?id={idConv}")">
                        <i class="bi bi-chat-dots"></i> Ver conversación
                    </a>
                }
                @if (_detail is null || _detail.MensajesOrigenDetalle.Count == 0)
                {
                    <p class="muted">Sin mensajes vinculados todavía.</p>
                }
                else
                {
                    @foreach (var msg in _detail.MensajesOrigenDetalle)
                    {
                        <article class="crm-origin-message">
                            <strong>@msg.Autor</strong>
                            <span>@msg.Texto</span>
                            <small>@FormatDate(msg.FechaHora)</small>
                        </article>
                    }
                }
            </section>
        </aside>
    </section>;

    protected override async Task OnInitializedAsync()
    {
        UpdatePageHeader();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunAsync(async () =>
        {
            _loading = true;
            _lookups = await CrmSvc.GetLookupsAsync();
            _viewSettings = await CrmSvc.GetViewSettingsAsync(AppUserSession.CurrentUser?.UserName ?? Environment.UserName);
            await ReloadCurrentViewAsync(resetPage: true);
            UpdatePageHeader();
        });
        _loading = false;
    }

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();

        if (_showEditor)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "guardar",
                Label = _saving ? "Guardando..." : "Guardar",
                Icon = "bi-floppy",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                Busy = _saving,
                OnClick = SaveOpportunityAsync
            });
            actions.Add(new PageHeaderAction
            {
                Key = "cancelar",
                Label = "Volver",
                Icon = "bi-arrow-left",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                OnClick = () => { CloseEditor(); return Task.CompletedTask; }
            });
        }
        else
        {
            actions.Add(new PageHeaderAction
            {
                Key = "nueva",
                Label = "Nueva oportunidad",
                Icon = "bi-plus-circle",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                OnClick = () => { NewOpportunity(); return Task.CompletedTask; }
            });
            actions.Add(new PageHeaderAction
            {
                Key = "buscar",
                Label = "Buscar",
                Icon = "bi-search",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Normal,
                Disabled = _loading,
                OnClick = SearchAsync
            });
            actions.Add(new PageHeaderAction
            {
                Key = "limpiar",
                Label = "Limpiar filtros",
                Icon = "bi-eraser",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                Disabled = _loading,
                OnClick = ClearFiltersAsync
            });
            if (_viewMode == "lista")
            {
                actions.Add(new PageHeaderAction
                {
                    Key = "vista",
                    Label = "Configurar vista",
                    Icon = "bi-sliders",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    OnClick = () => { OpenViewSettings(); return Task.CompletedTask; }
                });
            }
            actions.Add(new PageHeaderAction
            {
                Key = "etapas",
                Label = "Etapas",
                Icon = "bi-columns-gap",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                OnClick = () => { OpenStages(); return Task.CompletedTask; }
            });
            actions.Add(new PageHeaderAction
            {
                Key = "etiquetas",
                Label = "Etiquetas",
                Icon = "bi-tags",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                OnClick = () => { OpenTags(); return Task.CompletedTask; }
            });
        }

        PageHeader.Set(new PageHeaderConfig
        {
            Title = _showEditor ? (_form.IdOportunidad > 0 ? $"#{_detail?.CodigoVisible} {_form.Titulo}" : "Nueva oportunidad") : "CRM oportunidades",
            Breadcrumb = _showEditor ? ["CRM", "Oportunidades", "Detalle"] : ["CRM", "Oportunidades"],
            State = _loading
                ? PageHeaderState.Loading
                : _showEditor
                    ? (_form.IdOportunidad > 0 ? PageHeaderState.Editing : PageHeaderState.Creating)
                    : _viewMode == "kanban" ? PageHeaderState.Kanban : PageHeaderState.List,
            SearchContent = _showEditor ? null : RenderCrmSmartSearch(),
            Actions = actions,
            ViewButtons = _showEditor
                ? []
                :
                [
                    new PageHeaderViewButton
                    {
                        Key = "kanban",
                        Label = "Tablero",
                        Icon = "bi-kanban",
                        Active = _viewMode == "kanban",
                        Disabled = _loading,
                        OnClick = () => SetModeAsync("kanban")
                    },
                    new PageHeaderViewButton
                    {
                        Key = "lista",
                        Label = "Lista",
                        Icon = "bi-table",
                        Active = _viewMode == "lista",
                        Disabled = _loading,
                        OnClick = () => SetModeAsync("lista")
                    }
                ]
        });
    }

    private async Task OnHeaderSearchInputAsync(ChangeEventArgs args)
    {
        _filters.Texto = args.Value?.ToString() ?? string.Empty;
        UpdatePageHeader();
        await Task.CompletedTask;
    }

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }

    private Task ToggleSearchPanelAsync()
    {
        _searchPanelOpen = !_searchPanelOpen;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private IReadOnlyList<FilterChip> GetFilterChips()
    {
        var chips = new List<FilterChip>();
        if (!string.IsNullOrWhiteSpace(_filters.Texto))
            chips.Add(new("texto", $"Buscar: {_filters.Texto}"));
        if (_filters.IdEtapa is int idEtapa)
            chips.Add(new("etapa", $"Etapa: {_lookups.Etapas.FirstOrDefault(x => x.IdEtapa == idEtapa)?.Nombre ?? idEtapa.ToString()}"));
        if (!string.IsNullOrWhiteSpace(_filters.IdTecnico))
            chips.Add(new("asignado", $"Asignado: {_lookups.Tecnicos.FirstOrDefault(x => x.IdTecnico == _filters.IdTecnico)?.Nombre ?? _filters.IdTecnico}"));
        if (_filters.IdEtiqueta is int idEtiqueta)
            chips.Add(new("etiqueta", $"Etiqueta: {_lookups.Etiquetas.FirstOrDefault(x => x.IdEtiqueta == idEtiqueta)?.Nombre ?? idEtiqueta.ToString()}"));
        if (_filters.IncluirCerradas)
            chips.Add(new("cerradas", "Incluye ganadas/perdidas"));
        return chips;
    }

    private async Task RemoveFilterChipAsync(string key)
    {
        switch (key)
        {
            case "texto":
                _filters.Texto = string.Empty;
                break;
            case "etapa":
                _filters.IdEtapa = null;
                break;
            case "asignado":
                _filters.IdTecnico = null;
                break;
            case "etiqueta":
                _filters.IdEtiqueta = null;
                break;
            case "cerradas":
                _filters.IncluirCerradas = false;
                break;
        }
        UpdatePageHeader();
        await SearchAsync();
    }

    private async Task ReloadCurrentViewAsync(bool resetPage)
    {
        if (resetPage)
            _filters.PageNumber = 1;
        if (_viewMode == "kanban")
            _kanban = (await CrmSvc.GetKanbanAsync(_filters)).ToList();
        else
            _page = await CrmSvc.SearchAsync(_filters);
    }

    private async Task SearchAsync()
    {
        await RunAsync(() => ReloadCurrentViewAsync(resetPage: true));
        UpdatePageHeader();
    }

    private async Task ClearFiltersAsync()
    {
        _filters = new CrmFilters();
        await ReloadCurrentViewAsync(resetPage: true);
        UpdatePageHeader();
    }

    private async Task SetModeAsync(string mode)
    {
        _viewMode = mode;
        await ReloadCurrentViewAsync(resetPage: true);
        UpdatePageHeader();
    }

    private async Task PrevPageAsync()
    {
        if (!_page.HasPrev)
            return;
        _filters.PageNumber--;
        await ReloadCurrentViewAsync(resetPage: false);
        UpdatePageHeader();
    }

    private async Task NextPageAsync()
    {
        if (!_page.HasNext)
            return;
        _filters.PageNumber++;
        await ReloadCurrentViewAsync(resetPage: false);
        UpdatePageHeader();
    }

    private void NewOpportunity()
    {
        _detail = null;
        _selectedTags = [];
        _noteText = string.Empty;
        _form = new CrmOpportunitySaveRequest
        {
            IdEtapa = _lookups.Etapas.FirstOrDefault()?.IdEtapa,
            Probabilidad = 10,
            Prioridad = 1
        };
        _showEditor = true;
        _searchPanelOpen = false;
        UpdatePageHeader();
    }

    private async Task OpenDetailAsync(long id)
    {
        await RunAsync(async () =>
        {
            _detail = await CrmSvc.GetByIdAsync(id);
            if (_detail is null)
                return;
            _form = new CrmOpportunitySaveRequest
            {
                IdOportunidad = _detail.IdOportunidad,
                Titulo = _detail.Titulo,
                Descripcion = _detail.Descripcion,
                IdEtapa = _detail.IdEtapa,
                Prioridad = _detail.Prioridad,
                Probabilidad = _detail.Probabilidad,
                ImporteEstimado = _detail.ImporteEstimado,
                FechaCierreEstimada = _detail.FechaCierreEstimada,
                IdTecnico = _detail.IdTecnico,
                ClienteCodigo = _detail.ClienteCodigo,
                IdContacto = _detail.IdContacto,
                CanalOrigen = _detail.CanalOrigen,
                IdConversacion = _detail.IdConversacion
            };
            _selectedTags = _detail.Etiquetas.Select(x => x.IdEtiqueta).ToHashSet();
            _noteText = string.Empty;
            _showEditor = true;
            _searchPanelOpen = false;
            UpdatePageHeader();
        });
    }

    private async Task SaveOpportunityAsync()
    {
        await RunAsync(async () =>
        {
            _saving = true;
            _form.IdEtiquetas = _selectedTags.ToList();
            _form.UsuarioAccion = AppUserSession.CurrentUser?.UserName;
            var id = await CrmSvc.SaveOpportunityAsync(_form);
            _detail = await CrmSvc.GetByIdAsync(id);
            await ReloadCurrentViewAsync(resetPage: false);
            _form.IdOportunidad = id;
            if (_detail is not null)
                _selectedTags = _detail.Etiquetas.Select(x => x.IdEtiqueta).ToHashSet();
            ShowOk("Oportunidad guardada", "La oportunidad quedó actualizada en el pipeline.");
            UpdatePageHeader();
        });
        _saving = false;
    }

    private async Task AddNoteAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_noteText))
            return;
        await RunAsync(async () =>
        {
            await CrmSvc.AddNoteAsync(new CrmNotaRequest
            {
                IdOportunidad = _detail.IdOportunidad,
                Texto = _noteText,
                UsuarioAccion = AppUserSession.CurrentUser?.UserName
            });
            _noteText = string.Empty;
            _detail = await CrmSvc.GetByIdAsync(_detail.IdOportunidad);
            UpdatePageHeader();
        });
    }

    private void ToggleTag(int id, ChangeEventArgs args)
    {
        if (args.Value is bool value && value)
            _selectedTags.Add(id);
        else
            _selectedTags.Remove(id);
    }

    private void CloseEditor()
    {
        _showEditor = false;
        UpdatePageHeader();
    }
    private void OpenStages() { NewStage(); _showStages = true; }
    private void CloseStages() => _showStages = false;
    private void OpenTags() { NewTag(); _showTags = true; }
    private void CloseTags() => _showTags = false;
    private void OpenViewSettings() { _viewDraft = CloneViewSettings(_viewSettings); _showViewSettings = true; }
    private void CloseViewSettings() => _showViewSettings = false;

    private void NewStage() => _stageDraft = new CrmEtapaSaveRequest { Color = "#2563EB", Orden = (_lookups.Etapas.Count + 1) * 10 };
    private void EditStage(CrmEtapaDto stage) => _stageDraft = new CrmEtapaSaveRequest { IdEtapa = stage.IdEtapa, Nombre = stage.Nombre, Color = stage.Color, EsGanada = stage.EsGanada, EsPerdida = stage.EsPerdida, Orden = stage.Orden };
    private async Task SaveStageAsync()
    {
        await RunAsync(async () =>
        {
            _stageDraft.UsuarioAccion = AppUserSession.CurrentUser?.UserName;
            await CrmSvc.SaveEtapaAsync(_stageDraft);
