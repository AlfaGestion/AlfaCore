    private static string Display(string primary, string fallback, string empty) => !string.IsNullOrWhiteSpace(primary) ? primary : (!string.IsNullOrWhiteSpace(fallback) ? fallback : empty);
    private static string FormatMoney(decimal value) => value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static int BarWidth(decimal value, decimal max)
        => max <= 0 ? 0 : (int)Math.Round(Math.Clamp((double)(value / max) * 100.0, 2, 100));
    private static string FormatDate(DateTime value) => value == DateTime.MinValue ? "-" : value.ToString("dd/MM/yyyy HH:mm");
    private static string BuildQuickDescription(string email, string phone)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(email))
            parts.Add($"Correo electrónico del contacto: {email.Trim()}");
        if (!string.IsNullOrWhiteSpace(phone))
            parts.Add($"Teléfono del contacto: {phone.Trim()}");
        return string.Join(Environment.NewLine, parts);
    }
    private string GetSmartOptionClass(bool active) => active ? "smart-option is-active" : "smart-option";
    private string GetStageClass(int idEtapa)
    {
        var parts = new List<string> { "crm-stage" };
        if (_dragStageId == idEtapa)
            parts.Add("is-dragging");
        if (_dropStageId == idEtapa)
            parts.Add("is-drop-active");
        if (_dragOpportunityId is not null || (_dragStageId is not null && _dragStageId != idEtapa))
            parts.Add("is-drop-target");
        if (_collapsedStageIds.Contains(idEtapa))
            parts.Add("is-collapsed");
        return string.Join(" ", parts);
    }

    private string GetOpportunityDragClass(long idOportunidad)
        => _dragOpportunityId == idOportunidad ? "crm-card is-dragging" : "crm-card";

    private static StageTimingStats GetStageTimingStats(IReadOnlyList<CrmOpportunityDto> items)
    {
        if (items.Count == 0)
            return new StageTimingStats(0, 0, 0, 100);

        var today = DateTime.Today;
        var ok = 0;
        var warning = 0;
        var late = 0;
        var empty = 0;

        foreach (var item in items)
        {
            if (item.FechaCierreEstimada is null)
            {
                empty++;
                continue;
            }

            var days = (item.FechaCierreEstimada.Value.Date - today).TotalDays;
            if (days < 0)
                late++;
            else if (days <= 2)
                warning++;
            else
                ok++;
        }

        decimal total = items.Count;
        return new StageTimingStats(
            Percent(ok, total),
            Percent(warning, total),
            Percent(late, total),
            Percent(empty, total));
    }

    private static decimal Percent(int value, decimal total)
        => total <= 0 ? 0 : Math.Round(value * 100m / total, 2);

    private static string GetPriorityLabel(int value) => value switch
    {
        1 => "Baja",
        2 => "Media",
        3 => "Alta",
        _ => "Sin prioridad"
    };

    private MarkupString RenderCell(CrmOpportunityDto item, string key)
    {
        var value = key switch
        {
            CrmViewColumnKeys.Numero => $"#{item.CodigoVisible}",
            CrmViewColumnKeys.Titulo => item.Titulo,
            CrmViewColumnKeys.Etapa => item.EtapaNombre,
            CrmViewColumnKeys.Importe => FormatMoney(item.ImporteEstimado),
            CrmViewColumnKeys.Probabilidad => $"{item.Probabilidad}%",
            CrmViewColumnKeys.Asignado => Display(item.TecnicoNombre, item.IdTecnico, "Sin asignar"),
            CrmViewColumnKeys.Cliente => Display(item.ClienteNombre, item.ClienteCodigo, "Sin cliente"),
            CrmViewColumnKeys.Contacto => Display(item.ContactoNombre, item.IdContacto?.ToString() ?? string.Empty, "-"),
            CrmViewColumnKeys.Etiquetas => string.Join(", ", item.Etiquetas.Select(x => x.Nombre)),
            _ => item.FechaHoraAlta.ToString("dd/MM/yyyy")
        };
        return new MarkupString(System.Net.WebUtility.HtmlEncode(value));
    }

