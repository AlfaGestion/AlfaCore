@page "/portal-cliente/pedidos"
@page "/{idweb}/{idbase:int}/portal-cliente/pedidos"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@using AlfaCore.Components.Shared.AlfaDesign
@inject AlfaCore.Services.IPortalClienteService PortalClienteSvc

<PageTitle>Pedidos | Portal Cliente</PageTitle>

@if (NotFound)
{
    <section class="page-grid portal-cliente">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver" />
}
else
{
    <section class="page-grid portal-cliente portal-cliente--detail">
        <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                              BrandName="@GetBrandingName()"
                              LogoFrameClass="@GetBrandingLogoFrameClass()"
                              ClientLabel="@GetCurrentClientLabel()"
                              Busy="@SessionBusy"
                              OnLogout="LogoutClienteAsync"
                              ActiveTab="pedidos"
                              RouteInicio="@BuildPortalRoute("")"
                              RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                              RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                              RouteCatalogos="@BuildPortalRoute("catalogos")"
                              RouteCarrito="@BuildPortalRoute("carrito")"
                              RoutePedidos="@BuildPortalRoute("pedidos")"
                              RouteMiCuenta="@BuildPortalRoute("mi-cuenta")"
                              SeccionesHabilitadas="@PortalSecciones" />

        <section class="portal-cliente__section">
            <header class="portal-cliente__section-head">
                <div>
                    <h3 class="portal-cliente__section-title">Pedidos</h3>
                    <p class="portal-cliente__section-subtitle">Consultá tus pedidos registrados.</p>
                </div>
            </header>

            <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

            <div class="portal-cliente__ctacte-toolbar portal-cliente__pedidos-toolbar">
                <AlfaSelect Label="Rango"
                            Value="@_rango"
                            ValueChanged="SetRangoAsync"
                            Options="@RangoOptions"
                            Class="portal-cliente__filter-field portal-cliente__ctacte-field" />
                <AlfaInput Label="Desde"
                           Type="date"
                           Value="@FechaDesdeTexto"
                           ValueChanged="SetFechaDesdeAsync"
                           Class="portal-cliente__filter-field portal-cliente__ctacte-field" />
                <AlfaInput Label="Hasta"
                           Type="date"
                           Value="@FechaHastaTexto"
                           ValueChanged="SetFechaHastaAsync"
                           Class="portal-cliente__filter-field portal-cliente__ctacte-field" />
                <AlfaInput Label="Número"
                           Type="search"
                           Value="@_numero"
                           ValueChanged="SetNumeroAsync"
                           Placeholder="9999-00001234"
                           Class="portal-cliente__filter-field portal-cliente__ctacte-field portal-cliente__filter-field--search" />
                <AlfaButton Variant="AlfaButtonVariant.Primary"
                            Size="AlfaSize.Sm"
                            Disabled="@_loading"
                            OnClick="ConsultarPedidosAsync"
                            Class="portal-cliente__ctacte-submit">
                    Consultar
                </AlfaButton>
            </div>

            @if (_loading)
            {
                <div class="portal-cliente__loading-state">
                    <p class="text-muted">Cargando pedidos...</p>
                </div>
            }
            else if (_pedidos.Items.Count == 0)
            {
                <div class="portal-cliente__empty-panel">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoData"
                                    Title="Todavía no tenés pedidos registrados."
                                    Class="portal-cliente__empty-state" />
                </div>
            }
            else
            {
                <div class="portal-cliente__section-head portal-cliente__ctacte-table-head">
                    <h3 class="portal-cliente__section-title">Pedidos</h3>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-file-earmark-excel" OnClick="ExportarExcelAsync" Class="portal-cliente__ctacte-export">
                        Exportar Excel
                    </AlfaButton>
                </div>

                <div class="table-wrap">
                    <table class="data-table portal-cliente__ctacte-table">
                        <thead><tr><th>Fecha</th><th>Comprobante</th><th>Descripción</th><th>Vencimiento</th><th class="text-end">Importe</th><th>Estado</th><th>Acciones</th></tr></thead>
                        <tbody>
                            @foreach (var pedido in _pedidos.Items)
                            {
                                <tr>
                                    <td data-label="Fecha">@pedido.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td data-label="Comprobante">@pedido.Tc @pedido.IdComprobanteTexto</td>
                                    <td data-label="Descripción">@(pedido.EsPedidoWeb ? "Pedido web" : "Pedido registrado")</td>
                                    <td data-label="Vencimiento">—</td>
                                    <td data-label="Importe" class="text-end">@Money(pedido.Total)</td>
                                    <td data-label="Estado"><AlfaTag Tone="@(pedido.Anulada ? AlfaTagTone.Danger : AlfaTagTone.Success)">@(pedido.Anulada ? "Anulado" : "Registrado")</AlfaTag></td>
                                    <td data-label="Acciones"><a class="btn btn--ghost btn--sm" href="@BuildPortalRoute($"pedidos/{pedido.IdComprobante}")"><i class="bi bi-eye"></i> Ver comprobante</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <footer class="alfa-data-view-footer portal-cliente__list-footer">
                    <span class="alfa-data-view-footer__summary">@GetPedidosSummaryText()</span>
                    <div class="alfa-data-view-footer__controls portal-cliente__pagination-controls">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@(!_pedidos.HasPrev)" OnClick="() => CambiarPaginaAsync(_pageNumber - 1)">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </AlfaButton>
                        <span class="portal-cliente__pagination-page">Página @_pedidos.PageNumber de @Math.Max(_pedidos.TotalPages, 1)</span>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@(!_pedidos.HasNext)" OnClick="() => CambiarPaginaAsync(_pageNumber + 1)">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </AlfaButton>
                    </div>
                </footer>
            }
        </section>
    </section>
}

@code {
    protected override string? RequiredSectionKey => "pedidos";

    private CatalogoClienteLoginPanel? _loginPanel;
    private bool _loading;
    private int _pageNumber = 1;
    private const int PageSize = 10;
    private DateTime? _fechaDesde;
    private DateTime? _fechaHasta;
    private string _numero = string.Empty;
    private string _rango = "ultimos-30-dias";
    private PagedResult<PortalClientePedidoResumenDto> _pedidos = new();
    private AppUiMessage? _feedback;

    private static readonly IReadOnlyList<AlfaSelectOption> RangoOptions =
    [
        new AlfaSelectOption("mes-actual", "Mes actual"),
        new AlfaSelectOption("mes-anterior", "Mes anterior"),
        new AlfaSelectOption("ultimos-30-dias", "Últimos 30 días"),
        new AlfaSelectOption("ultimos-3-meses", "Últimos 3 meses"),
        new AlfaSelectOption("anio-actual", "Año actual"),
        new AlfaSelectOption("todo", "Todo"),
        new AlfaSelectOption("personalizado", "Personalizado")
    ];

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            AplicarRango(_rango);
            await CargarPedidosAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
    {
        AplicarRango(_rango);
        await CargarPedidosAsync();
    }

    private Task ConsultarPedidosAsync()
    {
        _pageNumber = 1;
        return CargarPedidosAsync();
    }

    private string FechaDesdeTexto
        => _fechaDesde?.ToString("yyyy-MM-dd") ?? string.Empty;

    private string FechaHastaTexto
        => _fechaHasta?.ToString("yyyy-MM-dd") ?? string.Empty;

    private Task SetFechaDesdeAsync(string? value)
    {
        _fechaDesde = ParseDate(value);
        _rango = "personalizado";
        return Task.CompletedTask;
    }

    private Task SetFechaHastaAsync(string? value)
    {
        _fechaHasta = ParseDate(value);
        _rango = "personalizado";
        return Task.CompletedTask;
    }

    private Task SetNumeroAsync(string? value)
    {
        _numero = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task SetRangoAsync(string? value)
    {
        AplicarRango(value);
        return ConsultarPedidosAsync();
    }

    private void AplicarRango(string? rango)
    {
        _rango = string.IsNullOrWhiteSpace(rango) ? "personalizado" : rango;
        var hoy = DateTime.Today;

        switch (_rango)
        {
            case "mes-actual":
                _fechaDesde = new DateTime(hoy.Year, hoy.Month, 1);
                _fechaHasta = _fechaDesde.Value.AddMonths(1).AddDays(-1);
                break;
            case "mes-anterior":
                var inicioMesActual = new DateTime(hoy.Year, hoy.Month, 1);
                _fechaDesde = inicioMesActual.AddMonths(-1);
                _fechaHasta = inicioMesActual.AddDays(-1);
                break;
            case "ultimos-30-dias":
                _fechaDesde = hoy.AddDays(-29);
                _fechaHasta = hoy;
                break;
            case "ultimos-3-meses":
                _fechaDesde = hoy.AddMonths(-3).AddDays(1);
                _fechaHasta = hoy;
                break;
            case "anio-actual":
                _fechaDesde = new DateTime(hoy.Year, 1, 1);
                _fechaHasta = new DateTime(hoy.Year, 12, 31);
                break;
            case "todo":
                _fechaDesde = null;
                _fechaHasta = null;
                break;
        }
    }

    private string GetPedidosSummaryText()
        => $"{_pedidos.Total} {(_pedidos.Total == 1 ? "pedido" : "pedidos")} · Página {_pedidos.PageNumber} de {Math.Max(_pedidos.TotalPages, 1)}";

    private static DateTime? ParseDate(string? value)
        => DateTime.TryParse(value, out var parsed) ? parsed.Date : null;

    private string BuildExportUrl()
    {
        var query = $"?token={Uri.EscapeDataString(CatalogoClienteSession.CurrentToken ?? string.Empty)}&idweb={Uri.EscapeDataString(idweb ?? string.Empty)}&idbase={idbase ?? 0}";
        if (_fechaDesde is { } desde) query += $"&desde={desde:yyyy-MM-dd}";
        if (_fechaHasta is { } hasta) query += $"&hasta={hasta:yyyy-MM-dd}";
        if (!string.IsNullOrWhiteSpace(_numero)) query += $"&numero={Uri.EscapeDataString(_numero.Trim())}";
        return "/api/portal-cliente/pedidos/excel" + query;
    }

    private Task ExportarExcelAsync()
    {
        Nav.NavigateTo(BuildExportUrl(), forceLoad: true);
        return Task.CompletedTask;
    }

    private static string Money(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private Task CambiarPaginaAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _pedidos.TotalPages)
            return Task.CompletedTask;

        _pageNumber = pageNumber;
        return CargarPedidosAsync();
    }

    private async Task CargarPedidosAsync()
    {
        _loading = true;
        _feedback = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => PortalClienteSvc.GetPedidosClienteAsync(new PortalClientePedidosFiltroDto
            {
                CodigoCliente = GetCurrentCodigoCliente(),
                FechaDesde = _fechaDesde,
                FechaHasta = _fechaHasta,
                Numero = string.IsNullOrWhiteSpace(_numero) ? null : _numero.Trim(),
                PageNumber = _pageNumber,
                PageSize = PageSize
            }), "No se pudieron cargar los pedidos.");

            if (result.Success && result.Value is not null)
            {
                _pedidos = result.Value;
            }
            else
            {
                _pedidos = new PagedResult<PortalClientePedidoResumenDto>();
                _feedback = result.Feedback;
            }
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
