@page "/portal-cliente/pedidos"
@page "/{idweb}/{idbase:int}/portal-cliente/pedidos"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@inject AlfaCore.Services.IPortalClienteService PortalClienteSvc

<PageTitle>Pedidos | Portal Cliente</PageTitle>

@if (NotFound)
{
    <section class="page-grid portal-cliente">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver" />
}
else
{
    <section class="page-grid portal-cliente portal-cliente--detail">
        <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                              BrandName="@GetBrandingName()"
                              LogoFrameClass="@GetBrandingLogoFrameClass()"
                              ClientLabel="@GetCurrentClientLabel()"
                              Busy="@SessionBusy"
                              OnLogout="LogoutClienteAsync"
                              ActiveTab="pedidos"
                              RouteInicio="@BuildPortalRoute("")"
                              RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                              RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                              RouteCatalogos="@BuildPortalRoute("catalogos")"
                              RouteCarrito="@BuildPortalRoute("carrito")"
                              RoutePedidos="@BuildPortalRoute("pedidos")"
                              RouteMiCuenta="@BuildPortalRoute("mi-cuenta")" />

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Pedidos</h3>
                    <p class="panel-card__subtitle">Notas de pedido registradas a tu nombre.</p>
                </div>
            </div>

            <div class="portal-cliente__filtros">
                <div class="field">
                    <label>Fecha desde</label>
                    <input type="date" @bind="_fechaDesde" @bind:after="AplicarFiltrosAsync" />
                </div>
                <div class="field">
                    <label>Fecha hasta</label>
                    <input type="date" @bind="_fechaHasta" @bind:after="AplicarFiltrosAsync" />
                </div>
                <div class="field">
                    <label>Número</label>
                    <input type="text" placeholder="9999-00001234" @bind="_numero" @bind:event="oninput" @bind:after="AplicarFiltrosAsync" />
                </div>
            </div>

            @if (_loading)
            {
                <p class="text-muted">Cargando pedidos...</p>
            }
            else if (_pedidos.Items.Count == 0)
            {
                <div class="empty-state">
                    <p>Todavía no tenés pedidos registrados.</p>
                </div>
            }
            else
            {
                <div class="portal-cliente__pedidos-list">
                    @foreach (var pedido in _pedidos.Items)
                    {
                        <PortalClientePedidoRow Pedido="pedido" DetalleUrl="@BuildPortalRoute($"pedidos/{pedido.IdComprobante}")" />
                    }
                </div>

                @if (_pedidos.TotalPages > 1)
                {
                    <div class="portal-cliente__paginador">
                        <button type="button" class="btn btn--ghost btn--sm" disabled="@(!_pedidos.HasPrev)" @onclick="() => CambiarPaginaAsync(_pageNumber - 1)">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </button>
                        <span class="text-muted">Página @_pedidos.PageNumber de @_pedidos.TotalPages</span>
                        <button type="button" class="btn btn--ghost btn--sm" disabled="@(!_pedidos.HasNext)" @onclick="() => CambiarPaginaAsync(_pageNumber + 1)">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                }
            }
        </section>
    </section>
}

@code {
    private CatalogoClienteLoginPanel? _loginPanel;
    private bool _loading;
    private int _pageNumber = 1;
    private const int PageSize = 10;
    private DateTime? _fechaDesde;
    private DateTime? _fechaHasta;
    private string _numero = string.Empty;
    private PagedResult<PortalClientePedidoResumenDto> _pedidos = new();

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            await CargarPedidosAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
        => await CargarPedidosAsync();

    private Task AplicarFiltrosAsync()
    {
        _pageNumber = 1;
        return CargarPedidosAsync();
    }

    private Task CambiarPaginaAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _pedidos.TotalPages)
            return Task.CompletedTask;

        _pageNumber = pageNumber;
        return CargarPedidosAsync();
    }

    private async Task CargarPedidosAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => PortalClienteSvc.GetPedidosClienteAsync(new PortalClientePedidosFiltroDto
            {
                CodigoCliente = GetCurrentCodigoCliente(),
                FechaDesde = _fechaDesde,
                FechaHasta = _fechaHasta,
                Numero = string.IsNullOrWhiteSpace(_numero) ? null : _numero.Trim(),
                PageNumber = _pageNumber,
                PageSize = PageSize
            }), "No se pudieron cargar los pedidos.");

            _pedidos = result.Success && result.Value is not null ? result.Value : new PagedResult<PortalClientePedidoResumenDto>();
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
