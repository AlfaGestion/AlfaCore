@page "/costos"
@page "/{idweb}/{idbase:int}/costos"
@inject AlfaCore.Services.ICostosService CostosSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Actualización de Costos | Alfa Gestión</PageTitle>

@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando módulo…
    </div>
}
else
{
    <div class="gd-page gd gd-legacy">
        <header class="gd-header">
            <h2>Actualización de Costos</h2>
            <p>Importá listas de proveedores, apoyate en perfiles de `V_Ta_InterODBC` y dejá trazabilidad de cada corrida para revisión y aplicación controlada.</p>
        </header>

        <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

        <section class="kpi-grid">
            <article class="kpi-card">
                <div class="kpi-card__label">Perfiles activos</div>
                <div class="kpi-card__value">@_profiles.Count</div>
            </article>
            <article class="kpi-card">
                <div class="kpi-card__label">Corridas recientes</div>
                <div class="kpi-card__value">@_batches.Count</div>
            </article>
            <article class="kpi-card">
                <div class="kpi-card__label">Último estado</div>
                <div class="kpi-card__value">@(_batches.FirstOrDefault()?.Status ?? "—")</div>
            </article>
            <article class="kpi-card">
                <div class="kpi-card__label">Historial cargado</div>
                <div class="kpi-card__value">@_history.Count</div>
            </article>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Perfiles de importación</h3>
                    <p class="panel-card__subtitle">Configuración tomada desde `V_Ta_InterODBC`.</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th>Perfil</th>
                            <th>Código proveedor</th>
                            <th>Reglas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var profile in _profiles.Take(10))
                        {
                            <tr>
                                <td><strong>@profile.ProviderName</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(profile.ProviderAccount) ? "—" : profile.ProviderAccount)</td>
                                <td>@BuildRules(profile)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Corridas recientes</h3>
                    <p class="panel-card__subtitle">Cabeceras desde `IA_Costos_Importacion_CAB`.</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Proveedor</th>
                            <th>Archivo</th>
                            <th>Estado</th>
                            <th>Filas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in _batches)
                        {
                            <tr>
                                <td><a class="action-link" href="@RouteContext.BuildRoute($"/costos/lotes/{batch.Id}")">#@batch.Id</a></td>
                                <td>@batch.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@batch.ProviderName</td>
                                <td>@batch.SourceFileName</td>
                                <td>@batch.Status</td>
                                <td>@batch.TotalRowsRead</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Historial</h3>
                    <p class="panel-card__subtitle">Últimas actualizaciones registradas en `IA_Costos_Actualizacion_Hist`.</p>
                </div>
                <a class="action-link" href="@RouteContext.BuildRoute("/costos/historial")">Ver todo</a>
            </div>
            <div class="table-wrap">
                <table class="data-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Proveedor</th>
                            <th>Artículo</th>
                            <th>Descripción</th>
                            <th>Nuevo costo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _history.Take(10))
                        {
                            <tr>
                                <td>@item.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.ProviderName</td>
                                <td>@item.ArticleId</td>
                                <td>@item.ImportedDescription</td>
                                <td>@(item.NewCost?.ToString("N2") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private AlfaCore.Models.AppUiMessage? _feedback;
    private IReadOnlyList<AlfaCore.Models.CostosProfileDto> _profiles = [];
    private IReadOnlyList<AlfaCore.Models.CostosBatchSummaryDto> _batches = [];
    private IReadOnlyList<AlfaCore.Models.CostosHistoryDto> _history = [];

    private PageHeaderConfig? _pageHeaderPublicado;
    private string _headerSnapshot = string.Empty;

    // Estado que muestra la barra superior (acciones habilitadas, buscador): si cambia, se
    // republica el header después del render de la página.
    private string HeaderSnapshot() => string.Empty;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || HeaderSnapshot() != _headerSnapshot)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private void UpdatePageHeader()
    {
        _headerSnapshot = HeaderSnapshot();
        PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
        {
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "costos",
            Title = "Actualización de costos",
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCostos(RouteContext, Nav, "inicio"),
            Actions =
            [
                new PageHeaderAction
                {
                    Key = "nueva",
                    Label = "Nueva importación",
                    Icon = "bi-upload",
                    Style = PageHeaderActionStyle.Primary,
                    Disabled = false,
                    OnClick = () => InvokeAsync(() => { Nav.NavigateTo(RouteContext.BuildRoute("/costos/nueva")); StateHasChanged(); })
                },
            ],
        });
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await UiOps.RunAsync(async () =>
        {
            _profiles = await CostosSvc.GetProfilesAsync();
            _batches = await CostosSvc.GetRecentBatchesAsync();
            _history = await CostosSvc.GetRecentHistoryAsync(25);
        }, "No se pudo cargar el módulo de costos.");

        _feedback = result.Feedback;
        _loading = false;
    }

    private static string BuildRules(AlfaCore.Models.CostosProfileDto profile)
    {
        var parts = new List<string>();
        if (profile.OnlyAdd) parts.Add("SoloAlta");
        if (profile.OnlyModify) parts.Add("SoloModificación");
        if (parts.Count == 0) parts.Add("Sin reglas");
        return string.Join(" · ", parts);
    }

    private static string GetFeedbackClass(AlfaCore.Models.AppUiMessage message)
        => message.Severity switch
        {
            AlfaCore.Models.AppUiFeedbackSeverity.Success => "conversations-inline--ok",
            AlfaCore.Models.AppUiFeedbackSeverity.Warning => "conversations-inline--error",
            AlfaCore.Models.AppUiFeedbackSeverity.Error => "conversations-inline--error",
            _ => "conversations-inline--ok"
        };
}
