@if (_loading)
{
    <div class="consultas-loading">
        <i class="bi bi-hourglass-split"></i> Cargando mÃ³duloâ€¦
    </div>
}
else
{
    <div class="page-grid">
        <section class="page-intro">
            <div>
                <h2 class="page-intro__title">ActualizaciÃ³n de Costos</h2>
                <p class="page-intro__text">ImportÃ¡ listas de proveedores, apoyate en perfiles de `V_Ta_InterODBC` y dejÃ¡ trazabilidad de cada corrida para revisiÃ³n y aplicaciÃ³n controlada.</p>
            </div>
            <div class="actions">
                <a class="btn btn--primary" href="/costos/nueva">
                    <i class="bi bi-upload"></i>
                    <span>Nueva importaciÃ³n</span>
