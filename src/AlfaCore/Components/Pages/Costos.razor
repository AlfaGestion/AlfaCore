@code {
    private bool _loading = true;
    private AlfaCore.Models.AppUiMessage? _feedback;
    private IReadOnlyList<AlfaCore.Models.CostosProfileDto> _profiles = [];
    private IReadOnlyList<AlfaCore.Models.CostosBatchSummaryDto> _batches = [];
    private IReadOnlyList<AlfaCore.Models.CostosHistoryDto> _history = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await UiOps.RunAsync(async () =>
        {
            _profiles = await CostosSvc.GetProfilesAsync();
            _batches = await CostosSvc.GetRecentBatchesAsync();
            _history = await CostosSvc.GetRecentHistoryAsync(25);
        }, "No se pudo cargar el mÃ³dulo de costos.");

        _feedback = result.Feedback;
        _loading = false;
    }

    private static string BuildRules(AlfaCore.Models.CostosProfileDto profile)
    {
        var parts = new List<string>();
        if (profile.OnlyAdd) parts.Add("SoloAlta");
        if (profile.OnlyModify) parts.Add("SoloModificaciÃ³n");
        if (parts.Count == 0) parts.Add("Sin reglas");
        return string.Join(" Â· ", parts);
    }

    private static string GetFeedbackClass(AlfaCore.Models.AppUiMessage message)
        => message.Severity switch
        {
            AlfaCore.Models.AppUiFeedbackSeverity.Success => "conversations-inline--ok",
            AlfaCore.Models.AppUiFeedbackSeverity.Warning => "conversations-inline--error",
            AlfaCore.Models.AppUiFeedbackSeverity.Error => "conversations-inline--error",
            _ => "conversations-inline--ok"
        };
}
