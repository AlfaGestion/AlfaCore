@page "/stock"
@page "/{idweb}/{idbase:int}/stock"
@inject AlfaCore.Services.IGestionDashboardService GestionSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.GestionFilterStateService FilterState
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Stock | Alfa Gestión</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>Stock</h2>
            <p>Seguimiento de valorización, movimiento y artículos críticos para reposición.</p>
        </div>
    </header>

    @if (_loading)
    {
        <AlfaEmptyState Title="Cargando" Message="Buscando datos del período." />
    }
    else
    {
        @if (_feedback is not null)
        {
            <div class="conversations-inline @GetFeedbackClass(_feedback)">
                <strong>@_feedback.Title</strong>
                <div>@_feedback.Message</div>
                @if (_feedback.HasCode)
                {
                    <div>Código: @_feedback.Code</div>
                }
                @if (_feedback.HasSuggestion)
                {
                    <div>@_feedback.Suggestion</div>
                }
            </div>
        }

        <section class="kpi-grid">
            <article class="kpi-card"><div class="kpi-card__label">Stock valorizado</div><div class="kpi-card__value">@FmtMoney(_data.StockValorizado)</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Artículos con stock</div><div class="kpi-card__value">@_data.ArticulosConStock</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Bajo punto pedido</div><div class="kpi-card__value">@_data.BajoPuntoPedido</div></article>
            <article class="kpi-card"><div class="kpi-card__label">Sin stock</div><div class="kpi-card__value">@_data.SinStock</div></article>
        </section>

        <section class="two-grid">
            <article class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Stock valorizado</h3>
                        <p class="panel-card__subtitle">Últimos 12 cierres mensuales</p>
                    </div>
                </div>
                <LineChart Data="_data.EvolucionMensual" Titulo="Stock valorizado" Subtitulo="Últimos 12 cierres mensuales" />
            </article>
            <article class="panel-card">
                <HorizontalBarChart Data="_data.TopMovimientos" Titulo="Artículos más movidos" Subtitulo="Rotación del período" />
            </article>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Artículos críticos</h3>
                    <p class="panel-card__subtitle">Debajo del punto de pedido o cerca del faltante.</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data-table" data-sticky-list-header>
                    <thead><tr><th>Artículo</th><th>Descripción</th><th>Stock actual</th><th>Punto pedido</th><th>Valorizado</th></tr></thead>
                    <tbody>
                    @foreach (var item in _data.Criticos)
                    {
                        <tr>
                            <td>@item.IdArticulo</td>
                            <td>@item.Descripcion</td>
                            <td>@item.StockActual.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td>
                            <td>@item.PuntoPedido.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td>
                            <td>@FmtMoney(item.Valorizado)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private bool _loading = true;
    private AlfaCore.Models.AppUiMessage? _feedback;
    private StockDashboardDto _data = new();
    private StockDashboardFilters _filters = null!;
    private StockFilterOptionsDto _options = new();

    protected override void OnInitialized()
    {
        _filters = FilterState.Stock;
        UpdatePageHeader();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    // Filtros en el Context Toolbar (Smart Search): el texto busca por descripción del artículo;
    // el panel agrega código, rubro/familia y depósito/sucursal/estado.
    private RenderFragment RenderSmartSearch() => @<GestionSmartSearch Model="_filters" Placeholder="Buscar artículo..." Texto="@_filters.ArticuloDescripcion" TextoChanged="v => _filters.ArticuloDescripcion = v" Chips="SmartChips" OnRemoveChip="RemoveSmartChip" OnClear="LimpiarFiltrosPropios" OnApply="LoadAsync">
        <Columnas>
            <div class="smart-search__column">
                <h4><i class="bi bi-box-seam"></i> Artículo</h4>
                <div class="smart-search__inline">
                    <label>Código</label>
                    <input type="text" value="@_filters.ArticuloCodigo" @oninput="e => _filters.ArticuloCodigo = NullIfEmpty(e.Value?.ToString())" />
                </div>
                <div class="smart-search__inline">
                    <label>Rubro</label>
                    <select value="@(_filters.Rubro ?? string.Empty)" @onchange="e => _filters.Rubro = NullIfEmpty(e.Value?.ToString())">
                        <option value="">Todos</option>
                        @foreach (var item in _options.Rubros)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
                <div class="smart-search__inline">
                    <label>Familia</label>
                    <select value="@(_filters.Familia ?? string.Empty)" @onchange="e => _filters.Familia = NullIfEmpty(e.Value?.ToString())">
                        <option value="">Todas</option>
                        @foreach (var item in _options.Familias)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
            </div>
            <div class="smart-search__column">
                <h4><i class="bi bi-sliders"></i> Más filtros</h4>
                <div class="smart-search__inline">
                    <label>Depósito</label>
                    <select value="@(_filters.Deposito ?? string.Empty)" @onchange="e => _filters.Deposito = NullIfEmpty(e.Value?.ToString())">
                        <option value="">Todos</option>
                        @foreach (var item in _options.Depositos)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
                <div class="smart-search__inline">
                    <label>Sucursal</label>
                    <select value="@(_filters.Sucursal ?? string.Empty)" @onchange="e => _filters.Sucursal = NullIfEmpty(e.Value?.ToString())">
                        <option value="">Todas</option>
                        @foreach (var item in _options.Sucursales)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
                <div class="smart-search__inline">
                    <label>Estado</label>
                    <select value="@(_filters.Estado ?? string.Empty)" @onchange="e => _filters.Estado = NullIfEmpty(e.Value?.ToString())">
                        <option value="">Todos</option>
                        @foreach (var item in _options.Estados)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
            </div>
        </Columnas>
    </GestionSmartSearch>;

    private IReadOnlyList<GestionSmartChip> SmartChips
    {
        get
        {
            var chips = new List<GestionSmartChip>();
            void Add(string key, string label, string? value)
            {
                if (!string.IsNullOrWhiteSpace(value)) chips.Add(new(key, $"{label}: {value}"));
            }
            Add("codigo", "Código", _filters.ArticuloCodigo);
            Add("rubro", "Rubro", _filters.Rubro);
            Add("familia", "Familia", _filters.Familia);
            Add("deposito", "Depósito", _filters.Deposito);
            Add("sucursal", "Sucursal", _filters.Sucursal);
            Add("estado", "Estado", _filters.Estado);
            return chips;
        }
    }

    private void RemoveSmartChip(string key)
    {
        switch (key)
        {
            case "codigo": _filters.ArticuloCodigo = null; break;
            case "rubro": _filters.Rubro = null; break;
            case "familia": _filters.Familia = null; break;
            case "deposito": _filters.Deposito = null; break;
            case "sucursal": _filters.Sucursal = null; break;
            case "estado": _filters.Estado = null; break;
        }
    }

    private void LimpiarFiltrosPropios()
    {
        _filters.ArticuloCodigo = null;
        _filters.ArticuloDescripcion = null;
        _filters.Rubro = null;
        _filters.Familia = null;
        _filters.Deposito = null;
        _filters.Sucursal = null;
        _filters.Estado = null;
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = "stock",
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildStock(RouteContext, Nav, "resumen")
    });

    protected override async Task OnInitializedAsync()
    {
        _filters = FilterState.Stock;
        var result = await UiOps.RunAsync(async () =>
        {
            _options = await GestionSvc.GetStockFilterOptionsAsync();
            UpdatePageHeader();
            await LoadAsync();
        }, "No se pudo cargar stock.");

        _feedback = result.Success ? null : result.Feedback;
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _feedback = null;

        var result = await UiOps.RunAsync(
            () => GestionSvc.GetStockAsync(_filters),
            "No se pudieron cargar los datos de stock.");

        if (result.Success && result.Value is not null)
            _data = result.Value;
        else
            _feedback = result.Feedback;

        _loading = false;
    }


    private async Task HandleApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase) || _loading)
            return;

        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        var today = DateTime.Today;
        _filters.FechaDesde = new DateTime(today.Year, today.Month, 1);
        _filters.FechaHasta = today;
        _filters.ArticuloCodigo = null;
        _filters.ArticuloDescripcion = null;
        _filters.Rubro = null;
        _filters.Familia = null;
        _filters.Deposito = null;
        _filters.Sucursal = null;
        _filters.Estado = null;
        await LoadAsync();
    }

    private async Task ApplyQuickRangeAsync(string key)
    {
        var today = DateTime.Today;
        switch (key)
        {
            case "hoy":
                _filters.FechaDesde = today;
                _filters.FechaHasta = today;
                break;
            case "semana":
                var diff = ((int)today.DayOfWeek + 6) % 7;
                _filters.FechaDesde = today.AddDays(-diff);
                _filters.FechaHasta = today;
                break;
            case "mes":
                _filters.FechaDesde = new DateTime(today.Year, today.Month, 1);
                _filters.FechaHasta = today;
                break;
            case "mes-anterior":
                var firstThisMonth = new DateTime(today.Year, today.Month, 1);
                _filters.FechaDesde = firstThisMonth.AddMonths(-1);
                _filters.FechaHasta = firstThisMonth.AddDays(-1);
                break;
            case "ultimos-3":
                _filters.FechaDesde = today.AddMonths(-3);
                _filters.FechaHasta = today;
                break;
            case "anio":
                _filters.FechaDesde = new DateTime(today.Year, 1, 1);
                _filters.FechaHasta = today;
                break;
        }

        await LoadAsync();
    }

    private string BuildSummary()
    {
        var parts = new List<string>();
        if (_filters.FechaDesde.HasValue || _filters.FechaHasta.HasValue)
        {
            parts.Add($"Fecha: {_filters.FechaDesde:dd/MM/yyyy} a {_filters.FechaHasta:dd/MM/yyyy}");
        }

        AddIfPresent(parts, "Código", _filters.ArticuloCodigo);
        AddIfPresent(parts, "Descripción", _filters.ArticuloDescripcion);
        AddIfPresent(parts, "Rubro", _filters.Rubro);
        AddIfPresent(parts, "Familia", _filters.Familia);
        AddIfPresent(parts, "Depósito", _filters.Deposito);
        AddIfPresent(parts, "Sucursal", _filters.Sucursal);
        AddIfPresent(parts, "Estado", _filters.Estado);

        return parts.Count == 0 ? "Sin filtros seleccionados." : string.Join(" | ", parts);
    }

    private static void AddIfPresent(List<string> parts, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            parts.Add($"{label}: {value}");
        }
    }

    private static string FmtMoney(decimal value) => value.ToString("$ #,##0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static string GetFeedbackClass(AlfaCore.Models.AppUiMessage message)
        => message.Severity switch
        {
            AlfaCore.Models.AppUiFeedbackSeverity.Success => "conversations-inline--ok",
            AlfaCore.Models.AppUiFeedbackSeverity.Warning => "conversations-inline--error",
            AlfaCore.Models.AppUiFeedbackSeverity.Error => "conversations-inline--error",
            _ => "conversations-inline--ok"
        };
}
