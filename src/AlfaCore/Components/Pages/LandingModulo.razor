@page "/landing/{Slug}"
@layout AlfaCore.Components.Layout.PublicLayout
@using AlfaCore.Services
@inject ICentralAdminService AdminService
@inject IPlanesService PlanesSvc

<PageTitle>@(_contenido?.Nombre ?? "Módulo") | AlfaNet</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="/css/landing.css" />
    <meta name="description" content="@(_contenido?.MetaDescripcion ?? "Módulos de AlfaNet para hacer crecer tu negocio.")" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@(_contenido?.Nombre ?? "AlfaNet") — AlfaNet" />
    <meta property="og:description" content="@(_contenido?.MetaDescripcion ?? "Módulos de AlfaNet para hacer crecer tu negocio.")" />
    <meta property="og:image" content="/logos/Logo.png" />
    <meta name="twitter:card" content="summary" />
</HeadContent>

@if (_contenido is null || _suspendida)
{
    <section class="landing-404">
        <div class="landing-404__card">
            <h1>@(_suspendida ? "Esta landing no está disponible" : "No encontramos ese módulo")</h1>
            <p>@(_suspendida ? "Por ahora no está disponible para nuevos registros." : "Puede que el link esté mal escrito o el módulo ya no exista.")</p>
            <a href="/modulos" class="btn btn--primary">Ver todos los módulos</a>
        </div>
    </section>
}
else
{
    <section class="landing-hero">
        <div class="landing-hero__bg"></div>
        <div class="landing-hero__inner">
            <a href="/modulos" class="landing-brand">
                <img src="/logos/Logo.png" alt="AlfaNet" />
                <span>AlfaNet</span>
            </a>

            <span class="landing-hero__badge"><i class="bi @_contenido.Icono"></i> Módulo AlfaNet</span>
            <h1>@_contenido.Nombre</h1>
            <p class="landing-hero__tagline">@_contenido.Tagline</p>
            <p class="landing-hero__desc">@_contenido.Descripcion</p>

            <div class="landing-hero__actions">
                <a href="@($"/registrarme?modulo={_contenido.Slug}")" class="btn btn--primary btn--lg">@(_planes.Count > 0 ? "Empezar ahora" : "Probar 30 días gratis")</a>
                <a href="/modulos" class="btn btn--ghost btn--lg">Ver todos los módulos</a>
            </div>

            @if (_planes.Count == 0 && _contenido.Precio > 0)
            {
                <p class="landing-hero__price">Desde <strong>USD @_contenido.Precio.ToString("0.##")/mes</strong> después de la prueba gratuita — sin tarjeta, sin compromiso.</p>
            }
        </div>
    </section>

    @if (_planes.Count > 0)
    {
        <section class="landing-planes">
            <div class="landing-planes__inner">
                <h2>Elegí tu plan</h2>
                <div class="landing-planes__grid">
                    @foreach (var plan in _planes)
                    {
                        <article class="landing-plan-card" @key="plan.Id">
                            <strong class="landing-plan-card__name">@plan.Nombre</strong>
                            <span class="landing-plan-card__price">
                                @plan.Moneda @plan.Precio.ToString("0.##")<small>@PlanDisplayHelper.FormatPeriodoCorto(plan.TipoFacturacion)</small>
                            </span>
                            @if (plan.DiasPrueba > 0)
                            {
                                <span class="landing-plan-card__trial"><i class="bi bi-gift-fill"></i> @plan.DiasPrueba días de prueba gratis</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(plan.Descripcion))
                            {
                                <span class="landing-plan-card__desc">@plan.Descripcion</span>
                            }
                        </article>
                    }
                </div>
                <p class="landing-planes__note">Elegís el plan al registrarte. Si el plan tiene prueba gratuita, arranca sola, sin pedirte ningún dato de pago.</p>
            </div>
        </section>
    }

    @if (_contenido.Capturas.Count > 0)
    {
        <section class="landing-showcase">
            <div class="landing-showcase__grid">
                @foreach (var captura in _contenido.Capturas)
                {
                    <figure class="landing-showcase__frame">
                        <div class="landing-showcase__bar"><span></span><span></span><span></span></div>
                        <img src="@captura.Ruta" alt="@captura.Titulo" loading="lazy" />
                        <figcaption>@captura.Titulo</figcaption>
                    </figure>
                }
            </div>
        </section>
    }

    <section class="landing-features">
        <div class="landing-features__inner">
            <h2>Qué podés hacer con @_contenido.Nombre</h2>
            <div class="landing-features__grid">
                @foreach (var feature in _contenido.Features)
                {
                    <article class="landing-feature">
                        <span class="landing-feature__icon"><i class="bi @feature.Icono"></i></span>
                        <div>
                            <strong>@feature.Titulo</strong>
                            <span>@feature.Texto</span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="landing-respaldo">
        <div class="landing-respaldo__inner">
            <h2>El respaldo de AlfaNet</h2>
            <p class="landing-respaldo__lead">Más de 30 años trabajando con sistemas ERP y miles de clientes que ya confían en nosotros.</p>
            <div class="landing-respaldo__grid">
                <article class="landing-respaldo__item">
                    <span class="landing-respaldo__icon"><i class="bi bi-headset"></i></span>
                    <strong>Soporte incluido</strong>
                    <span>Resolvemos tus dudas sin costo extra, incluido en el importe mensual.</span>
                </article>
                <article class="landing-respaldo__item">
                    <span class="landing-respaldo__icon"><i class="bi bi-mortarboard"></i></span>
                    <strong>Capacitación incluida</strong>
                    <span>Capacitamos a tu equipo para que aproveche cada función desde el primer día.</span>
                </article>
                <article class="landing-respaldo__item">
                    <span class="landing-respaldo__icon"><i class="bi bi-rocket-takeoff"></i></span>
                    <strong>Puesta en marcha incluida</strong>
                    <span>Te acompañamos en la implementación inicial, sin cargos ocultos.</span>
                </article>
                <article class="landing-respaldo__item">
                    <span class="landing-respaldo__icon"><i class="bi bi-award"></i></span>
                    <strong>+30 años de trayectoria</strong>
                    <span>Décadas desarrollando sistemas ERP, con miles de clientes satisfechos.</span>
                </article>
            </div>
        </div>
    </section>

    @if (_contenido.Dependencias.Count > 0)
    {
        <section class="landing-deps">
            <div class="landing-deps__inner">
                <p>
                    <i class="bi bi-link-45deg"></i>
                    @_contenido.Nombre funciona junto a @string.Join(" y ", _contenido.Dependencias) — se activan automáticamente, sin pasos extra.
                </p>
            </div>
        </section>
    }

    @if (_contenido.Testimonios.Count > 0)
    {
        <section class="landing-testimonios">
            <div class="landing-testimonios__inner">
                <h2>Esto es lo que opinan nuestros clientes</h2>
                <div class="landing-testimonios__grid">
                    @foreach (var testimonio in _contenido.Testimonios)
                    {
                        <blockquote class="landing-testimonio">
                            <i class="bi bi-quote landing-testimonio__icon"></i>
                            <p>@testimonio.Texto</p>
                        </blockquote>
                    }
                </div>
            </div>
        </section>
    }

    <section class="landing-cta">
        <div class="landing-cta__inner">
            <h2>Empezá a usar @_contenido.Nombre hoy</h2>
            <p>
                @(_planes.Count > 0
                    ? "Creá tu cuenta, confirmá el email y elegí tu plan."
                    : "Creá tu cuenta, confirmá el email y elegí este módulo en la prueba gratuita de 30 días.")
            </p>
            <a href="@($"/registrarme?modulo={_contenido.Slug}")" class="btn btn--primary btn--lg">Registrarme gratis</a>
        </div>
    </section>

    <footer class="landing-footer">
        <span>© @DateTime.Now.Year AlfaNet — Soluciones Informáticas</span>
        <a href="/modulos">Ver todos los módulos</a>
    </footer>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private LandingContenido? _contenido;
    private bool _suspendida;
    private IReadOnlyList<PlanDto> _planes = [];

    protected override async Task OnParametersSetAsync()
    {
        _contenido = LandingContenidoCatalogo.Todos.FirstOrDefault(m =>
            string.Equals(m.Slug, Slug, StringComparison.OrdinalIgnoreCase));

        _suspendida = false;
        _planes = [];
        if (_contenido is not null)
        {
            try
            {
                var estados = await AdminService.GetLandingEstadosAsync();
                _suspendida = estados.Any(e => string.Equals(e.Slug, _contenido.Slug, StringComparison.OrdinalIgnoreCase) && !e.Activo);
            }
            catch
            {
                _suspendida = false;
            }

            if (!_suspendida)
            {
                // Si el módulo todavía no tiene Planes reales cargados (o falla la consulta por
                // cualquier motivo), se mantiene el precio hardcodeado de LandingContenidoCatalogo
                // sin romper la landing — ver IPlanesService.GetPlanesVisiblesPorCodigoModuloAsync.
                try
                {
                    var planesPorModulo = await PlanesSvc.GetPlanesVisiblesPorCodigoModuloAsync();
                    if (planesPorModulo.TryGetValue(_contenido.Codigo, out var planes))
                        _planes = planes;
                }
                catch
                {
                    _planes = [];
                }
            }
        }
    }
}
