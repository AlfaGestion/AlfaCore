    private string GetPdfExportUrl()
    {
        if (!string.IsNullOrWhiteSpace(_publicLinkRouteSegment) && !string.IsNullOrWhiteSpace(idweb))
        {
            var publicRelative = $"/api/catalogos/public/{Uri.EscapeDataString(idweb)}/{Uri.EscapeDataString(_publicLinkRouteSegment)}/pdf";
            return $"{publicRelative}?vista={Uri.EscapeDataString(_viewMode == CatalogoViewMode.Cuadricula ? "cuadricula" : "lista")}";
        }

        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(idweb))
            query.Add($"idweb={Uri.EscapeDataString(idweb)}");
        var effectiveIdBase = GetEffectiveIdBase();
        if (effectiveIdBase is > 0)
            query.Add($"idbase={effectiveIdBase.Value}");
        query.Add($"vista={(_viewMode == CatalogoViewMode.Cuadricula ? "cuadricula" : "lista")}");

        var relative = $"/api/catalogos/{IdInsert}/pdf";
        if (query.Count > 0)
            relative += "?" + string.Join("&", query);

        return relative;
    }

    private string BuildCatalogRelativeUrl()
    {
        // Si se entró por el link seguro (token), los links propios de la página (logo, PDF,
        // "volver al catálogo") tienen que seguir apuntando al token — nunca reconstruir la URL
        // legacy con idbase, que es justamente lo que este esquema evita exponer.
        if (!string.IsNullOrWhiteSpace(_publicLinkRouteSegment) && !string.IsNullOrWhiteSpace(idweb))
            return $"/{Uri.EscapeDataString(idweb)}/catalogo/{_publicLinkRouteSegment}";

        return AlfaCore.Services.CatalogosUrlHelper.BuildRelativeCatalogUrl(
            IdInsert,
            idweb,
            idbase,
            Nav.Uri,
            CatalogoClienteSession.CurrentClient?.IdWeb,
            SessionSvc.GetActiveSession()?.BaseId);
    }

    private string VigenciaTexto()
    {
        if (_catalogo is null)
            return string.Empty;

        var desde = _catalogo.VigenciaDesde?.ToString("dd/MM/yyyy") ?? "sin fecha";
        var hasta = _catalogo.VigenciaHasta?.ToString("dd/MM/yyyy") ?? "sin fecha";
        return $"{desde} - {hasta}";
    }

