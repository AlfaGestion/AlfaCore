    private async Task RestoreClientSessionAsync()
    {
        // Mientras hay un redirect de ruta legacy en curso (ver RedirectLegacyPublicRouteAsync),
        // IdInsert/_effectiveIdBase todavía corresponden a la ruta VIEJA (ej. /catalogo/0) — cargar
        // el catálogo acá mostraba "no disponible/no vigente" de más, antes de que termine de
        // navegar al link seguro real.
        if (_redirecting)
            return;

        try
        {
            var token = await Js.InvokeAsync<string?>("localStorage.getItem", ClientTokenStorageKey);
            if (string.IsNullOrWhiteSpace(token))
                return;

            if (!CatalogoClienteSession.TryRestoreFromToken(token))
            {
                await Js.InvokeVoidAsync("localStorage.removeItem", ClientTokenStorageKey);
            }
        }
        catch
        {
        }

        await EnsureCatalogStateAsync();
    }

    private async Task LogoutClienteAsync()
    {
        _sessionBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            CatalogoClienteSession.Logout();
            await Js.InvokeVoidAsync("localStorage.removeItem", ClientTokenStorageKey);
            Nav.NavigateTo(GetPublicCatalogUrl(), replace: true);
        }
        finally
        {
            _sessionBusy = false;
        }
    }

    private async Task SetViewModeAsync(CatalogoViewMode mode)
    {
        if (_viewMode == mode)
            return;

        _viewMode = mode;
        await PersistViewModeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private string GetViewModeClass(CatalogoViewMode mode)
        => _viewMode == mode ? "is-active" : string.Empty;

    private async Task RestoreViewModeAsync()
    {
        try
        {
            var value = await Js.InvokeAsync<string?>("localStorage.getItem", ViewModeStorageKey);
            if (string.Equals(value, nameof(CatalogoViewMode.Cuadricula), StringComparison.OrdinalIgnoreCase))
            {
                _viewMode = CatalogoViewMode.Cuadricula;
                return;
            }

            if (string.Equals(value, nameof(CatalogoViewMode.Lista), StringComparison.OrdinalIgnoreCase))
            {
                _viewMode = CatalogoViewMode.Lista;
                return;
            }

            // Sin preferencia guardada todavia (primera visita): en mobile arrancamos en Cuadricula.
            var esMobile = await Js.InvokeAsync<bool>("alfaCoreViewport.isMobile");
            _viewMode = esMobile ? CatalogoViewMode.Cuadricula : CatalogoViewMode.Lista;
        }
        catch
        {
            _viewMode = CatalogoViewMode.Lista;
        }
    }

    private async Task PersistViewModeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", ViewModeStorageKey, _viewMode.ToString());
        }
        catch
        {
        }
    }

