    private CatalogosCatalogoItemDto? _lightboxItem;
    private bool _lightboxLoading;
    private bool _lightboxError;
    private string? _preloadedLightboxArticuloId;

    private void PreloadLightboxImage(CatalogosCatalogoItemDto item)
    {
        if (string.IsNullOrWhiteSpace(item.IdArticulo))
            return;

        if (string.Equals(_preloadedLightboxArticuloId, item.IdArticulo, StringComparison.OrdinalIgnoreCase))
            return;

        _preloadedLightboxArticuloId = item.IdArticulo;
    }

    private void OpenLightbox(CatalogosCatalogoItemDto item)
    {
        // La imagen completa (thumbnail:false) no se precalienta como los thumbs del grid — recién
        // se pide al FTP cuando se abre el lightbox, y sin este estado se veía como un ícono de
        // imagen rota mientras tanto. Mientras carga se muestra el mismo spinner que "Cargando
        // catálogo...", en versión chica.
        PreloadLightboxImage(item);
        _lightboxItem = item;
        _lightboxLoading = true;
        _lightboxError = false;
    }

    private void CloseLightbox()
    {
        _lightboxItem = null;
        _lightboxLoading = false;
        _lightboxError = false;
        _preloadedLightboxArticuloId = null;
    }

    private void OnLightboxImageLoaded()
        => _lightboxLoading = false;

    private void OnLightboxImageError()
    {
        _lightboxLoading = false;
        _lightboxError = true;
    }

    private static string ProductInitials(string descripcion)
    {
        if (string.IsNullOrWhiteSpace(descripcion))
            return "CA";

        var parts = descripcion
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => char.ToUpperInvariant(x[0]));

        return string.Concat(parts);
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string Display(string? value, string? fallback)
    {
        if (!string.IsNullOrWhiteSpace(value))
            return value.Trim();

        if (!string.IsNullOrWhiteSpace(fallback))
            return fallback.Trim();

        return "—";
    }

