        => AlfaCore.Services.ArticuloImagenUrlHelper.BuildPublicImageUrl(_puntoVentaSettings.FtpCodigoCta, item.IdArticulo, GetEffectiveIdBase(), thumbnail: true);

    private string GetProductImageUrl(CatalogosCatalogoItemDto item)
        => AlfaCore.Services.ArticuloImagenUrlHelper.BuildPublicImageUrl(_puntoVentaSettings.FtpCodigoCta, item.IdArticulo, GetEffectiveIdBase());

    private CatalogosCatalogoItemDto? _lightboxItem;

    private void OpenLightbox(CatalogosCatalogoItemDto item)
        => _lightboxItem = item;

    private void CloseLightbox()
        => _lightboxItem = null;

    private static string ProductInitials(string descripcion)
    {
        if (string.IsNullOrWhiteSpace(descripcion))
            return "CA";

        var parts = descripcion
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => char.ToUpperInvariant(x[0]));

        return string.Concat(parts);
    }

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--success",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            _ => "editor-msg--error"
        };

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string Money(decimal? value)
        => AlfaCore.Services.CatalogosPriceDisplayHelper.Money(value);

    private void SetFiltroRubro(string rubro)
        => _filtroRubro = rubro ?? string.Empty;

    private IReadOnlyList<string> GetRubrosDisponibles()
        => _catalogo?.Articulos
            .Select(x => x.Rubro?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList()
           ?? [];

    private IReadOnlyList<string> GetMarcasDisponibles()
        => _catalogo?.Articulos
            .Select(x => x.Marca?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList()
           ?? [];

    private IReadOnlyList<CatalogosCatalogoItemDto> GetArticulosFiltrados()
    {
        if (_catalogo is null)
            return [];

        IEnumerable<CatalogosCatalogoItemDto> query = _catalogo.Articulos;

        if (!string.IsNullOrWhiteSpace(_filtroRubro))
            query = query.Where(x => string.Equals((x.Rubro ?? string.Empty).Trim(), _filtroRubro, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_filtroMarca))
            query = query.Where(x => string.Equals((x.Marca ?? string.Empty).Trim(), _filtroMarca, StringComparison.OrdinalIgnoreCase));

        return query.ToList();
    }

    private IReadOnlyList<CatalogoPublicoGrupoMarca> GetGruposVisibles()
    {
        var articulos = GetArticulosFiltrados();
        if (articulos.Count == 0)
            return [];

        if (!_agruparPorMarca)
            return [new CatalogoPublicoGrupoMarca { Etiqueta = string.Empty, Articulos = articulos }];

        return articulos
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Marca) ? "VARIOS" : x.Marca.Trim().ToUpperInvariant())
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => new CatalogoPublicoGrupoMarca { Etiqueta = g.Key, Articulos = g.ToList() })
            .ToList();
    }
}
