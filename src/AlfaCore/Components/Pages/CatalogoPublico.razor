@page "/catalogo/{IdInsert:int}"
@page "/{idweb}/{idbase:int}/catalogo/{IdInsert:int}"
@page "/{idweb}/catalogo/{PublicToken}"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits SaaSRoutePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared.AlfaDesign
@inject AlfaCore.Services.IInterfacesCatalogosService CatalogosSvc
@inject AlfaCore.Services.ICarritoComprasService CarritoComprasSvc
@inject AlfaCore.Services.ICatalogosClienteSessionService CatalogoClienteSession
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject AlfaCore.Services.ICentralPublicLinkService PublicLinkSvc
@inject AlfaCore.Services.IArticuloImagenFtpService ArticuloImagenSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.ISessionService SessionSvc
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ILogger<CatalogoPublico> Logger
@implements IAsyncDisposable

<PageTitle>Catálogo público | AlfaCore</PageTitle>

<section class="@(Embedded ? "catalogo-publico-page catalogo-publico-page--embedded" : "page-grid catalogo-publico-page")">
    @if (_redirecting || _loading)
    {
        @* Un único estado de carga, sin encabezado: mientras se resuelve el link seguro o se
           consulta la base no hay branding real todavía (GetBrandingName()/GetBrandingLogoUrl()
           siguen en sus valores por defecto) — mostrarlo acá era lo que se veía como "dos
           encabezados", uno genérico seguido del real del cliente apenas terminaba de cargar. *@
        <PublicCatalogLoadingScreen LogoUrl="@GetLoadingLogoUrl()" Text="@(_redirecting ? "Redirigiendo..." : "Cargando catálogo...")" />
    }
    else
    {
        @if (!Embedded)
        {
            <section class="catalogo-publico-hero panel-card catalogo-publico-hero--sticky">
                <div class="catalogo-publico-hero__brand">
                    <a class="catalogo-publico-hero__logo @GetBrandingLogoFrameClass()" href="@GetPublicCatalogUrl()" title="Catálogo público" aria-label="Catálogo público">
                        <img src="@GetBrandingLogoUrl()" alt="@GetBrandingName()" />
                    </a>
                    <div class="catalogo-publico-hero__copy">
                        <p class="catalogo-publico-hero__eyebrow">@GetBrandingName()</p>
                        <h2 class="catalogo-publico-hero__title">@GetCatalogHeaderTitle()</h2>
                        @if (!string.IsNullOrWhiteSpace(GetCatalogHeaderCatalogName()))
                        {
                            <p class="catalogo-publico-hero__catalog-name">@GetCatalogHeaderCatalogName()</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(GetCatalogHeaderSubtitle()))
                        {
                            <p class="catalogo-publico-hero__text">@GetCatalogHeaderSubtitle()</p>
                        }
                    </div>
                </div>

                <div class="catalogo-publico-hero__actions">
                    <AlfaIconButton Icon="@(_isDark ? "bi bi-sun" : "bi bi-moon")"
                                    Label="@(_isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro")"
                                    Size="AlfaSize.Sm"
                                    OnClick="ToggleThemeAsync" />
                    @if (IsAuthenticatedForCurrentCatalog)
                    {
                        <AlfaTag Tone="AlfaTagTone.Neutral">Cliente: @GetCurrentClientLabel()</AlfaTag>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-box-arrow-right" Disabled="@_sessionBusy" OnClick="LogoutClienteAsync">
                            Cerrar sesión
                        </AlfaButton>
                    }
                </div>
            </section>
        }

        @if (_catalogo is null)
        {
            <div class="catalogo-publico-empty-panel">
                <AlfaEmptyState Kind="AlfaEmptyStateKind.Error"
                                Title="Catálogo no disponible"
                                Message="El catálogo no está disponible, fue finalizado o todavía no cumple la vigencia requerida." />
            </div>
            @if (_catalogFeedback is not null)
            {
                <AlfaNotification Message="@_catalogFeedback" OnDismiss="() => _catalogFeedback = null" />
            }
        }
        else
        {
        <section class="panel-card">
            <div class="catalogo-publico-list__header">
                <div>
                    <h3 class="panel-card__title">Artículos</h3>
                    <p class="panel-card__subtitle">Elegí entre vista de lista o cuadrícula sin recargar el catálogo.</p>
                </div>
                @if (_catalogo.Articulos.Count > 0)
                {
                    <a class="alfa-link-button" href="@GetPdfExportUrl()" target="_blank" rel="noopener">
                        <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
                    </a>
                }
            </div>

            @if (_catalogo.Articulos.Count > 0)
            {
                <div class="catalogo-publico-tabs" role="tablist" aria-label="Filtro por rubro">
                    <div class="catalogo-publico-tabs__scroll">
                        <button type="button"
                                role="tab"
                                aria-selected="@(string.IsNullOrEmpty(_filtroRubro))"
                                class="catalogo-publico-tabs__btn @(string.IsNullOrEmpty(_filtroRubro) ? "is-active" : string.Empty)"
                                @onclick="() => SetFiltroRubro(string.Empty)">
                            Todos
                        </button>
                        @foreach (var rubro in GetRubrosDisponibles())
                        {
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(string.Equals(_filtroRubro, rubro, StringComparison.OrdinalIgnoreCase))"
                                    class="catalogo-publico-tabs__btn @(string.Equals(_filtroRubro, rubro, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                                    @onclick="() => SetFiltroRubro(rubro)">
                                @rubro
                            </button>
                        }
                    </div>
                </div>

                <div class="catalogo-publico-filters">
                    <AlfaSelect Label="Marca"
                                Value="@_filtroMarca"
                                ValueChanged="v => _filtroMarca = v ?? string.Empty"
                                Options="@GetMarcaOptions()"
                                Placeholder="Todas"
                                Class="catalogo-publico-filters__field" />
                    <AlfaCheckbox Value="@_agruparPorMarca" ValueChanged="v => _agruparPorMarca = v ?? false" Class="catalogo-publico-filters__toggle">
                        Agrupar por marca
                    </AlfaCheckbox>
                    <div class="catalogo-publico-view-switch catalogo-publico-filters__view" role="group" aria-label="Selector de vista de artículos">
                        <AlfaIconButton Icon="bi bi-list-ul"
                                        Label="Vista de lista"
                                        Active="@(_viewMode == CatalogoViewMode.Lista)"
                                        Class="catalogo-publico-view-switch__btn"
                                        OnClick="() => SetViewModeAsync(CatalogoViewMode.Lista)" />
                        <AlfaIconButton Icon="bi bi-grid-3x3-gap"
                                        Label="Vista de cuadrícula"
                                        Active="@(_viewMode == CatalogoViewMode.Cuadricula)"
                                        Class="catalogo-publico-view-switch__btn"
                                        OnClick="() => SetViewModeAsync(CatalogoViewMode.Cuadricula)" />
                    </div>
                </div>
            }

            @{
                var gruposVisibles = GetGruposVisibles();
            }

            @if (_catalogo.Articulos.Count == 0)
            {
                <div class="catalogo-publico-empty-panel">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoData" Title="Este catálogo no tiene artículos publicados." />
                </div>
            }
            else if (gruposVisibles.Count == 0)
            {
                <div class="catalogo-publico-empty-panel">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="No se encontraron artículos con los filtros seleccionados." />
                </div>
            }
            else
            {
                @foreach (var grupo in gruposVisibles)
                {
                    @if (!string.IsNullOrWhiteSpace(grupo.Etiqueta))
                    {
                        <h4 class="catalogo-publico-grupo-marca__titulo">@grupo.Etiqueta</h4>
                    }

                    @if (_viewMode == CatalogoViewMode.Lista)
                    {
                        <div class="table-responsive">
                            <table class="data-table usuarios-table catalogo-publico-table">
                                <thead>
                                    <tr>
                                        <th style="width:120px;">Imagen</th>
                                        <th>Artículo</th>
                                        <th>Descripción</th>
                                        <th>Marca</th>
                                        <th>Rubro</th>
                                        <th style="text-align:right;">Precio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in grupo.Articulos)
                                    {
                                        <tr>
                                            <td>
                                                <div class="catalogo-articulo-media">
                                                    @if (ShouldShowImage(item))
                                                    {
                                                        <button type="button"
                                                                class="catalogo-articulo-media__trigger"
                                                                @onclick="() => OpenLightbox(item)"
                                                                @onmouseenter="() => PreloadLightboxImage(item)"
                                                                @onfocus="() => PreloadLightboxImage(item)"
                                                                @onpointerdown="() => PreloadLightboxImage(item)"
                                                                title="Ver imagen completa">
                                                            <img class="catalogo-articulo-media__img"
                                                                 src="@GetProductThumbUrl(item)"
                                                                 alt="@item.DescripcionArticulo"
                                                                 loading="lazy"
                                                                 @onerror="@EventCallback.Factory.Create(this, () => HandleImageError(item.IdArticulo))" />
                                                        </button>
                                                        @if (ShouldPreloadLightbox(item))
                                                        {
                                                            <img class="catalogo-publico-lightbox__preload"
                                                                 src="@GetProductImageUrl(item)"
                                                                 alt=""
                                                                 aria-hidden="true"
                                                                 loading="eager"
                                                                 decoding="async" />
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="catalogo-articulo-media__fallback">@ProductInitials(item.DescripcionArticulo)</div>
                                                    }
                                                </div>
                                            </td>
                                            <td><strong>@item.IdArticulo</strong></td>
                                            <td>
                                                <strong>@item.DescripcionArticulo</strong>
                                                @if (!string.IsNullOrWhiteSpace(item.Presentacion))
                                                {
                                                    <div class="text-muted">@item.Presentacion</div>
                                                }
                                            </td>
                                            <td>@Display(item.Marca)</td>
                                            <td>@Display(item.Rubro)</td>
                                            <td style="text-align:right;">
                                                @RenderPrecio(item)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="catalogo-publico-grid">
                            @foreach (var item in grupo.Articulos)
                            {
                                <article class="catalogo-publico-grid__card">
                                    <div class="catalogo-publico-grid__media">
                                            @if (ShouldShowImage(item))
                                            {
                                            <button type="button"
                                                    class="catalogo-publico-grid__trigger"
                                                    @onclick="() => OpenLightbox(item)"
                                                    @onmouseenter="() => PreloadLightboxImage(item)"
                                                    @onfocus="() => PreloadLightboxImage(item)"
                                                    @onpointerdown="() => PreloadLightboxImage(item)"
                                                    title="Ver imagen completa">
                                                <img class="catalogo-publico-grid__img"
                                                     src="@GetProductThumbUrl(item)"
                                                     alt="@item.DescripcionArticulo"
                                                     loading="lazy"
                                                     @onerror="@EventCallback.Factory.Create(this, () => HandleImageError(item.IdArticulo))" />
                                            </button>
                                            @if (ShouldPreloadLightbox(item))
                                            {
                                                <img class="catalogo-publico-lightbox__preload"
                                                     src="@GetProductImageUrl(item)"
                                                     alt=""
                                                     aria-hidden="true"
                                                     loading="eager"
                                                     decoding="async" />
                                            }
                                        }
                                        else
                                        {
                                            <div class="catalogo-publico-grid__fallback">@ProductInitials(item.DescripcionArticulo)</div>
                                        }
                                    </div>

                                    <div class="catalogo-publico-grid__body">
                                        <div class="catalogo-publico-grid__title-row">
                                            <strong class="catalogo-publico-grid__title">@item.DescripcionArticulo</strong>
                                            <span class="catalogo-publico-grid__code">@item.IdArticulo</span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Presentacion))
                                        {
                                            <p class="catalogo-publico-grid__presentation">@item.Presentacion</p>
                                        }

                                        <div class="catalogo-publico-grid__meta">
                                            <span>@Display(item.Marca)</span>
                                            <span>@Display(item.Rubro)</span>
                                        </div>

                                        <div class="catalogo-publico-grid__prices">
                                            @RenderPrecio(item, alignEnd: false)
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            }
        </section>
        }
    }
</section>

@if (_lightboxItem is not null)
{
    <div class="catalogo-publico-lightbox" @onclick="CloseLightbox">
        <button type="button" class="catalogo-publico-lightbox__close" @onclick="CloseLightbox" @onclick:stopPropagation="true" title="Cerrar">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="catalogo-publico-lightbox__content" @onclick:stopPropagation="true">
            @if (_lightboxError)
            {
                <div class="catalogo-publico-lightbox__error">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.Error"
                                    Title="No se pudo cargar la imagen"
                                    Message="Cerrá y probá de nuevo en un momento." />
                </div>
            }
            else
            {
                <div class="catalogo-publico-lightbox__stage">
                    <div class="catalogo-publico-lightbox__media">
                        @if (_lightboxLoading)
                        {
                            <PublicCatalogLoadingScreen LogoUrl="@GetLoadingLogoUrl()" Text="Cargando imagen..." Compact="true" />
                        }
                        <img class="catalogo-publico-lightbox__img @(_lightboxLoading ? "catalogo-publico-lightbox__img--hidden" : string.Empty)"
                             src="@GetProductImageUrl(_lightboxItem)"
                             alt="@_lightboxItem.DescripcionArticulo"
                             loading="eager"
                             fetchpriority="high"
                             decoding="async"
                             @onload="OnLightboxImageLoaded"
                             @onerror="OnLightboxImageError" />
                    </div>
                    <aside class="catalogo-publico-lightbox__details" aria-label="Detalles del artículo">
                        <p class="catalogo-publico-lightbox__eyebrow">Artículo</p>
                        <h3 class="catalogo-publico-lightbox__title">@_lightboxItem.DescripcionArticulo</h3>
                        <p class="catalogo-publico-lightbox__code">@_lightboxItem.IdArticulo</p>

                        @if (!string.IsNullOrWhiteSpace(_lightboxItem.ObservacionesArticulo) || !string.IsNullOrWhiteSpace(_lightboxItem.Presentacion))
                        {
                            <div class="catalogo-publico-lightbox__section">
                                <p class="catalogo-publico-lightbox__section-label">Observación</p>
                                <p class="catalogo-publico-lightbox__observation">@Display(_lightboxItem.ObservacionesArticulo, _lightboxItem.Presentacion)</p>
                            </div>
                        }

                        <div class="catalogo-publico-lightbox__meta">
                            <span>@Display(_lightboxItem.Marca)</span>
                            <span>@Display(_lightboxItem.Rubro)</span>
                        </div>

                        <div class="catalogo-publico-lightbox__price">
                            @RenderPrecio(_lightboxItem, alignEnd: false)
                        </div>
                    </aside>
                </div>
            }
        </div>
    </div>
}

@code {
    private const string ClientTokenStorageKey = "alfacore_catalogo_cliente_token";

    [Parameter] public int IdInsert { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string? PublicToken { get; set; }

    /// <summary>Segmento "slug-token" resuelto cuando se entró por /{idweb}/catalogo/{PublicToken}; null en la ruta legacy por idbase/IdInsert.</summary>
    private string? _publicLinkRouteSegment;

    private CatalogosCatalogoDetalleDto? _catalogo;
    private CatalogosPublicIdentityDto _branding = new();
    private AppUiMessage? _catalogFeedback;
    private bool _loading = true;
    private bool _redirecting;
    private bool _hasRendered;
    private bool _sessionBusy;
    private readonly HashSet<string> _imageFallbacks = new(StringComparer.OrdinalIgnoreCase);
    private bool _restoreAttempted;
    private bool _viewModeRestored;
    private CatalogoViewMode _viewMode = CatalogoViewMode.Lista;
    private PuntoVentaSettingsDto _puntoVentaSettings = new();
    private bool _routeSessionError;
    private const string ViewModeStorageKey = "alfacore_catalogo_publico_view_mode";
    private bool _isDark = true;
    private string _filtroRubro = string.Empty;
    private string _filtroMarca = string.Empty;
    private bool _agruparPorMarca;

    private enum CatalogoViewMode
    {
        Lista = 0,
        Cuadricula = 1
    }

    private sealed class CatalogoPublicoGrupoMarca
    {
        public string Etiqueta { get; init; } = string.Empty;
        public IReadOnlyList<CatalogosCatalogoItemDto> Articulos { get; init; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        CatalogoClienteSession.StateChanged += OnClientSessionStateChanged;
        await EnsureRouteSessionAsync();
        if (_redirecting)
            return;
        await LoadImageSettingsAsync();
        await LoadPublicIdentityAsync();
        await RefreshCatalogAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureRouteSessionAsync();
        if (_redirecting)
            return;

        // Blazor reutiliza esta MISMA instancia de componente para la navegación in-place que
        // dispara RedirectLegacyPublicRouteAsync (misma ruta de componente, sólo cambian los
        // parámetros) — OnAfterRenderAsync(firstRender:true) ya se disparó y se saltó el intento de
        // restaurar la sesión de cliente porque en ese momento _redirecting todavía era true. Este
        // es el único lugar donde se vuelve a intentar una vez que la ruta ya quedó resuelta.
        if (_hasRendered && !_restoreAttempted)
        {
            _restoreAttempted = true;
            await RestoreClientSessionAsync();
        }

        await LoadPublicIdentityAsync();
        await EnsureCatalogStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _hasRendered = true;

        if (firstRender)
        {
            if (!_viewModeRestored)
            {
                _viewModeRestored = true;
                await RestoreViewModeAsync();
                await InvokeAsync(StateHasChanged);
            }

            // Si hay un redirect legacy en curso, IdInsert/_effectiveIdBase todavía son los de la
            // ruta VIEJA — no intentar restaurar/cargar nada acá; OnParametersSetAsync se encarga
            // una vez que la navegación al link seguro haya resuelto la ruta final (ver arriba).
            if (!_restoreAttempted && !_redirecting)
            {
                _restoreAttempted = true;
                await RestoreClientSessionAsync();
            }

            try
            {
                var theme = await Js.InvokeAsync<string>("dashboardTheme.get");
                _isDark = !string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase);
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                // Sin JS interop disponible (prerender): se mantiene el modo oscuro por defecto.
            }
        }

    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        try
        {
            await Js.InvokeVoidAsync("dashboardTheme.set", _isDark ? "dark" : "light");
        }
        catch
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        CatalogoClienteSession.StateChanged -= OnClientSessionStateChanged;
        await Task.CompletedTask;
    }

    private void OnClientSessionStateChanged()
        => _ = InvokeAsync(async () =>
        {
            await EnsureCatalogStateAsync();
            await InvokeAsync(StateHasChanged);
        });

    private bool IsAuthenticatedForCurrentCatalog
        => CatalogoClienteSession.CurrentClient is { } client
           && string.Equals(client.IdWeb, NormalizeRouteSegment(idweb), StringComparison.OrdinalIgnoreCase)
           && client.IdBase == (GetEffectiveIdBase() ?? 0);

    private async Task EnsureCatalogStateAsync()
    {
        if (_routeSessionError)
        {
            _loading = false;
            _catalogo = null;
            return;
        }

        if (_catalogo is not null
            && _catalogo.IdInsert == IdInsert
            && !_loading)
            return;

        await RefreshCatalogAsync();
    }

    private int? _effectiveIdBase;

    private int? GetEffectiveIdBase() => _effectiveIdBase;

    private async Task EnsureRouteSessionAsync()
    {
        _redirecting = false;

        if (!string.IsNullOrWhiteSpace(PublicToken))
        {
            await EnsurePublicTokenSessionAsync();
            return;
        }

        if (idbase is > 0 && !string.IsNullOrWhiteSpace(idweb))
        {
            await RedirectLegacyPublicRouteAsync();
            return;
        }

        var activeSessionBaseId = SessionSvc.GetActiveSession()?.BaseId ?? 0;
        if (idbase is not > 0 && activeSessionBaseId <= 0)
        {
            _routeSessionError = true;
            _catalogFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Enlace no disponible",
                Message = "Este enlace no está disponible."
            };
            return;
        }

        if (idbase is > 0)
        {
            _effectiveIdBase = idbase;
        }
        else
        {
            _effectiveIdBase = activeSessionBaseId > 0 ? activeSessionBaseId : null;
        }

        if (!AppMode.IsSaaSMode || !idbase.HasValue)
            return;

        var routeBaseId = idbase.Value;
        var routeBase = await CentralBasesSvc.GetByIdAsync(routeBaseId);
        if (routeBase is null)
        {
            _routeSessionError = true;
            _catalogFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Base no disponible",
                Message = "No se pudo resolver la base asociada a este catálogo. Probá nuevamente desde el enlace correcto."
            };
            return;
        }

        SessionSvc.SetWebhookOverride(new SessionDto
        {
            Id = Guid.Parse($"00000000-0000-0000-0000-{routeBaseId:000000000000}"),
            BaseId = routeBase.IdBase,
            Nombre = routeBase.Nombre,
            Servidor = routeBase.DbServer,
            BaseDatos = routeBase.DbName,
            Usuario = routeBase.DbUser,
            Password = routeBase.DbPassword,
            TrustServerCertificate = true,
            Activa = true
        });

        try
        {
            await Js.InvokeVoidAsync("alfaCoreSqlSession.setActive", Guid.Parse($"00000000-0000-0000-0000-{routeBaseId:000000000000}").ToString());
        }
        catch
        {
            // El override en memoria ya quedó activo; el storage solo acompaña la navegación.
        }

        _routeSessionError = false;
    }

    /// <summary>
    /// Las URLs públicas legacy /{idweb}/{idbase}/catalogo/{id} no deben renderizar el recurso
    /// directamente. Se resuelven o crean en ALFA_PUBLIC_LINK y se redirige al token seguro.
    /// </summary>
    private async Task RedirectLegacyPublicRouteAsync()
    {
        if (string.IsNullOrWhiteSpace(idweb) || idbase is not > 0)
        {
            _routeSessionError = true;
            _catalogFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Enlace no disponible",
                Message = "Este enlace no está disponible."
            };
            return;
        }

        try
        {
            var routeBase = await CentralBasesSvc.GetByIdAsync(idbase.Value);
            if (routeBase is null)
            {
                _routeSessionError = true;
                _catalogFeedback = new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Base no disponible",
                    Message = "No se pudo resolver la base asociada a este catálogo."
                };
                return;
            }

            SessionSvc.SetWebhookOverride(new SessionDto
            {
                Id = Guid.Parse($"00000000-0000-0000-0000-{idbase.Value:000000000000}"),
                BaseId = routeBase.IdBase,
                Nombre = routeBase.Nombre,
                Servidor = routeBase.DbServer,
                BaseDatos = routeBase.DbName,
                Usuario = routeBase.DbUser,
                Password = routeBase.DbPassword,
                TrustServerCertificate = true,
                Activa = true
            });

            try
            {
                await Js.InvokeVoidAsync("alfaCoreSqlSession.setActive", Guid.Parse($"00000000-0000-0000-0000-{idbase.Value:000000000000}").ToString());
            }
            catch
            {
                // El override en memoria ya quedó activo; el storage solo acompaña la navegación.
            }

            var catalogoPublicado = IdInsert <= 0
                ? await CatalogosSvc.GetCatalogoPublicoAsync(0)
                : await CatalogosSvc.GetCatalogoPublicoAsync(IdInsert);
            if (catalogoPublicado is null)
            {
                _routeSessionError = true;
                _catalogFeedback = new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Catálogo no disponible",
                    Message = "Este catálogo no está disponible para acceso público."
                };
                return;
            }

            var catalogoIdInsert = catalogoPublicado.IdInsert;

            var existing = await PublicLinkSvc.TryGetExistingAsync(idweb, idbase.Value, PublicLinkTipos.Catalogo, catalogoIdInsert);
            if (existing is not null)
            {
                _publicLinkRouteSegment = existing.RouteSegment;
                _redirecting = true;
                Nav.NavigateTo($"/{Uri.EscapeDataString(idweb)}/catalogo/{existing.RouteSegment}", replace: true);
                return;
            }

            var link = await PublicLinkSvc.GetOrCreateAsync(idweb, idbase.Value, PublicLinkTipos.Catalogo, catalogoIdInsert, null);
            _publicLinkRouteSegment = link.RouteSegment;
            _redirecting = true;
            Nav.NavigateTo($"/{Uri.EscapeDataString(idweb)}/catalogo/{link.RouteSegment}", replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            // NavigateTo durante el prerender estático dispara esto a propósito — es cómo Blazor
            // convierte la navegación en un 302 HTTP real antes de que se termine de renderizar la
            // página. Atajarla acá la convertía en "Enlace no disponible" y pisaba el redirect real
            // (por eso hacía falta recargar a mano: recién en la segunda carga, ya interactiva, el
            // NavigateTo no vuelve a lanzar esta excepción).
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "CatalogoPublico: RedirectLegacyPublicRouteAsync falló. IdWeb={IdWeb}, IdBase={IdBase}, IdInsert={IdInsert}", idweb, idbase, IdInsert);
            _routeSessionError = true;
            _catalogFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Enlace no disponible",
                Message = "No se pudo resolver el enlace seguro de este catálogo."
            };
        }
    }

    /// <summary>
    /// /{idweb}/catalogo/{PublicToken}: el token (nunca el slug) es la única fuente de verdad para
    /// resolver IdBase + IdInsert. Se valida contra ALFA_CENTRAL antes de tocar cualquier base de
    /// cliente; si el token no existe, no es de tipo CATALOGO, no coincide con este idweb, está
    /// inactivo o venció, se responde igual que "catálogo no disponible" — sin distinguir el
    /// motivo, para no confirmar que la base existe.
    /// </summary>
    private async Task EnsurePublicTokenSessionAsync()
    {
        var link = await PublicLinkSvc.ResolveAsync(idweb ?? string.Empty, PublicLinkTipos.Catalogo, PublicToken ?? string.Empty);
        if (link is null)
        {
            _routeSessionError = true;
            _effectiveIdBase = null;
            _catalogFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Enlace no disponible",
                Message = "Este enlace no es válido o ya no está disponible."
            };
            return;
        }

        var routeBase = await CentralBasesSvc.GetByIdAsync(link.IdBase);
        if (routeBase is null)
        {
            _routeSessionError = true;
            _effectiveIdBase = null;
            _catalogFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Enlace no disponible",
                Message = "Este enlace no es válido o ya no está disponible."
            };
            return;
        }

        _effectiveIdBase = link.IdBase;
        _publicLinkRouteSegment = link.RouteSegment;
        IdInsert = link.IdReferencia;

        SessionSvc.SetWebhookOverride(new SessionDto
        {
            Id = Guid.Parse($"00000000-0000-0000-0000-{link.IdBase:000000000000}"),
            BaseId = routeBase.IdBase,
            Nombre = routeBase.Nombre,
            Servidor = routeBase.DbServer,
            BaseDatos = routeBase.DbName,
            Usuario = routeBase.DbUser,
            Password = routeBase.DbPassword,
            TrustServerCertificate = true,
            Activa = true
        });

        try
        {
            await Js.InvokeVoidAsync("alfaCoreSqlSession.setActive", Guid.Parse($"00000000-0000-0000-0000-{link.IdBase:000000000000}").ToString());
        }
        catch
        {
            // El override en memoria ya quedó activo; el storage solo acompaña la navegación.
        }

        _routeSessionError = false;
    }

    private async Task RefreshCatalogAsync()
    {
        _loading = true;

        if (_routeSessionError)
        {
            _catalogo = null;
            _loading = false;
            return;
        }

        _catalogFeedback = null;

        var result = await UiOps.RunAsync(
            () => IdInsert <= 0 ? CatalogosSvc.GetCatalogoPublicoAsync(0) : CatalogosSvc.GetCatalogoPublicoAsync(IdInsert),
            "No se pudo cargar el catálogo público.");
        if (result.Success)
        {
            _catalogo = result.Value;
            // Fire-and-forget: esperar acá a que bajen las ~50-200 imágenes del catálogo antes de
            // mostrar nada (como se hizo en un intento anterior) hacía que la carga se sintiera
            // muy lenta — mejor mostrar el catálogo ya mismo (nombre, precios, filtros) y dejar que
            // las imágenes se sigan bajando en paralelo mientras tanto; con catálogos ya visitados
            // (caché tibia) igual aparecen casi al instante.
            _ = PrecalentarImagenesAsync();
        }
        else
        {
            _catalogo = null;
            _catalogFeedback = result.Feedback;
        }
        _loading = false;
    }

    // Tope duro: si el FTP está lento/caído, mejor mostrar el catálogo con imágenes sueltas
    // resolviéndose de a poco que dejar al visitante mirando "Cargando catálogo..." sin fin.
    private static readonly TimeSpan PrecalentamientoTimeout = TimeSpan.FromSeconds(15);

    /// <summary>
    /// Descarga/cachea los thumbnails de todos los artículos ANTES de terminar de cargar el
    /// catálogo (se espera acá, con el spinner de "Cargando catálogo..." puesto), en vez de
    /// dejar que cada &lt;img&gt; del browser gatille su propio viaje al FTP recién cuando ya se
    /// está pintando la página — eso era lo que obligaba a recargar 1-2 veces para ver las
    /// imágenes la primera vez que alguien abría un catálogo. ObtenerImagenAsync resuelve al
    /// toque los que ya estén cacheados, así que sólo paga este costo el primer visitante.
    /// </summary>
    private async Task PrecalentarImagenesAsync()
    {
        if (_catalogo is null || _catalogo.Articulos.Count == 0)
            return;

        var ftpCodigoCta = _puntoVentaSettings.FtpCodigoCta;
        if (string.IsNullOrWhiteSpace(ftpCodigoCta))
            return;

        var idArticulos = _catalogo.Articulos.Select(a => a.IdArticulo).ToArray();
        var idArticulosForzados = _catalogo.Articulos
            .Where(a => a.ImagenModificada)
            .Select(a => a.IdArticulo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var idBase = GetEffectiveIdBase();

        try
        {
            using var cts = new CancellationTokenSource(PrecalentamientoTimeout);
            await ArticuloImagenSvc.PrecalentarAsync(ftpCodigoCta, idBase, idArticulos, thumbnail: true, idArticulosForzados, cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Se superó el tope de espera: se sigue igual, lo que faltó cachear se resuelve
            // (más lento) cuando el browser pida esa imagen puntual.
        }
    }

