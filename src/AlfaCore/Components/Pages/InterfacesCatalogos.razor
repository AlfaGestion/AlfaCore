    private async Task PublicarAsync()
    {
        if (_modo != CatalogosViewGroupKeys.Tipo)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Catálogo permanente",
                Message = "La publicación física del catálogo permanente se definirá en una etapa posterior."
            };
            StateHasChanged();
            return;
        }

        var result = await UiOps.RunAsync(() => CatalogosSvc.SaveCatalogoVigenciaAsync(BuildSaveRequest()), "No se pudo publicar el catálogo con vigencia.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            StateHasChanged();
            return;
        }

        _editingIdInsert = result.Value.IdInsert;
        await SetCatalogUrlsAsync(result.Value.IdInsert, _nombre);
        _feedback = AppUiMessage.Success("Catálogo publicado", result.Value.Mensaje);
        UpdatePageHeader();
        await BuscarCatalogosAsync();
        StateHasChanged();
    }

