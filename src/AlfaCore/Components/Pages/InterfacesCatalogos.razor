    // Un catálogo no puede mezclar artículos de dos listas (ni Maestro + Lista a la vez): si ya
    // hay artículos cargados, cambiar la lista pide confirmación y reemplaza el contenido en vez
    // de agregarse encima. Cambiar de lista mientras el picker está abierto también invalidaría
    // su búsqueda ya en curso (Origen/IdLista solo se releen al reabrirlo), así que de paso se cierra.
    private async Task OnListaPrecioChangedAsync(string? nuevaListaRaw)
    {
        var nuevaLista = (nuevaListaRaw ?? string.Empty).Trim();
        if (string.Equals(nuevaLista, _idLista, StringComparison.OrdinalIgnoreCase))
            return;

        if (_articulosSeleccionados.Count > 0 && !string.IsNullOrWhiteSpace(_idLista))
        {
            var nombreActual = GetNombreLista(_idLista);
            var nombreNueva = string.IsNullOrWhiteSpace(nuevaLista) ? "(sin seleccionar)" : GetNombreLista(nuevaLista);

            var confirm = await DialogSvc.ConfirmAsync(
                "Cambiar lista de artículos",
                $"Este catálogo actualmente utiliza la lista {nombreActual}. Si cambiás a {nombreNueva}, los artículos actuales serán reemplazados por los de la nueva lista.\n\n¿Querés continuar?",
                "Cambiar lista",
                "Cancelar");

            if (!confirm)
            {
                // El <select> nativo ya quedó visualmente en la opción elegida por el usuario;
                // como _idLista no cambió, forzamos un remount con @key para que vuelva a
                // mostrar el valor real (un re-render normal no reescribe su value).
                _listaSelectToken++;
                await InvokeAsync(StateHasChanged);
                return;
            }

            _articulosSeleccionados.Clear();
            _articulosQuitarSeleccionados.Clear();
        }

        _idLista = nuevaLista;
        _showLookupModal = false;
    }

    private string DescribirOrigenArticulos(string origen, string idLista)
    {
        if (string.Equals(origen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(idLista) ? "una lista de precios" : $"la lista {GetNombreLista(idLista)}";

        return "el maestro de artículos";
    }

    private string GetNombreLista(string idLista)
    {
        var lista = _listasPrecio.FirstOrDefault(x => string.Equals(x.IdLista, idLista, StringComparison.OrdinalIgnoreCase));
        return lista is null ? idLista : $"{lista.Nombre} ({lista.IdLista})";
    }

    private async Task AgregarArticuloAsync(CatalogosArticuloBusquedaDto item)
    {
        if (_articulosSeleccionados.Any(x => string.Equals(x.IdArticulo, item.IdArticulo, StringComparison.OrdinalIgnoreCase)))
            return;

        _articulosSeleccionados.Add(new CatalogosArticuloCatalogoDto
        {
            IdArticulo = item.IdArticulo,
            DescripcionArticulo = item.DescripcionArticulo,
            CodigoBarra = item.CodigoBarra,
            RutaImagen = item.RutaImagen,
            Presentacion = item.Presentacion,
            Marca = item.Marca,
            Rubro = item.Rubro,
            Precio = item.Precio,
            PrecioOferta = item.PrecioOferta
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task AgregarDesdeLookupAsync(IReadOnlyList<CatalogosArticuloBusquedaDto> items)
    {
        foreach (var item in items)
            await AgregarArticuloAsync(item);
    }

    private async Task QuitarArticuloAsync(string idArticulo)
    {
        var existing = _articulosSeleccionados.FirstOrDefault(x => string.Equals(x.IdArticulo, idArticulo, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            _articulosSeleccionados.Remove(existing);
            _articulosQuitarSeleccionados.Remove(idArticulo);
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task AbrirLookupArticulosAsync()
    {
        // La validación "falta la lista" y la búsqueda en sí quedan dentro de ArticuloPickerDialog
        // (BloqueoMensaje / carga al abrir); acá solo corresponde mostrarlo.
        _showLookupModal = true;
        return Task.CompletedTask;
    }

    private void CloseLookupArticulos()
        => _showLookupModal = false;

    private async Task SelectArticuloSourceAsync(string origen)
    {
        if (string.Equals(origen, _articuloOrigen, StringComparison.OrdinalIgnoreCase))
            return;

        if (_articulosSeleccionados.Count > 0)
        {
            var etiquetaActual = DescribirOrigenArticulos(_articuloOrigen, _idLista);
            var etiquetaNueva = string.Equals(origen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase)
                ? "una lista de precios"
                : "el maestro de artículos";

            var confirm = await DialogSvc.ConfirmAsync(
                "Cambiar origen de artículos",
                $"Este catálogo actualmente usa {etiquetaActual}. Si cambiás a {etiquetaNueva}, los artículos actuales serán reemplazados por los del nuevo origen.\n\n¿Querés continuar?",
                "Cambiar origen",
                "Cancelar");

            if (!confirm)
                return;

            _articulosSeleccionados.Clear();
            _articulosQuitarSeleccionados.Clear();
        }

        _articuloOrigen = origen;
        if (!string.Equals(origen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase))
            _idLista = string.Empty;

        _listaSelectToken++;
        _showLookupModal = false;
    }

    // "Importar todo" trae el origen completo (sin filtros de rubro/familia/marca: esos no existen
    // en esta pantalla) excluyendo lo que ya está en el catálogo, en una sola operación de backend
    // (CountArticulosAllAsync/SearchArticulosAllAsync, compartidas con "Seleccionar todos los
    // resultados" del picker). No pagina ni hace un alta por artículo: agrega el lote completo al
    // arreglo en memoria del catálogo, igual que ya hacía "Importar lista completa".
    private async Task ImportarTodoAsync()
    {
        if (!PuedeImportarTodo())
            return;

        var esLista = string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase);
        var origenTexto = esLista ? $"la lista \"{GetNombreListaActual()}\"" : "el maestro de artículos";

        _importandoListaCompleta = true;
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var filtros = new CatalogosArticuloBusquedaFiltersDto
            {
                Origen = _articuloOrigen,
                IdLista = _idLista,
                IdWeb = idweb,
                ExcludedIds = _articulosSeleccionados.Select(x => x.IdArticulo).ToList()
            };

            var conteo = await UiOps.RunAsync(() => CatalogosSvc.CountArticulosAllAsync(filtros, _disposeCts.Token), "No se pudo contar los artículos a importar.");
            if (!conteo.Success)
            {
                _feedback = conteo.Feedback;
                return;
            }

            if (conteo.Value == 0)
            {
                _feedback = new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Info,
                    Title = "Nada para importar",
                    Message = $"No hay artículos nuevos disponibles en {origenTexto}."
                };
                return;
            }

            var confirmado = await DialogSvc.ConfirmAsync(
                "Importar todo",
                $"Se agregarán {conteo.Value} artículo(s) de {origenTexto} al catálogo. ¿Querés continuar?",
                "Importar",
                "Cancelar");

            if (!confirmado)
                return;

            var result = await UiOps.RunAsync(() => CatalogosSvc.SearchArticulosAllAsync(filtros, _disposeCts.Token), "No se pudo importar los artículos.");
            if (!result.Success || result.Value is null)
            {
                _feedback = result.Feedback;
                return;
            }

            foreach (var item in result.Value)
            {
                _articulosSeleccionados.Add(new CatalogosArticuloCatalogoDto
                {
                    IdArticulo = item.IdArticulo,
                    DescripcionArticulo = item.DescripcionArticulo,
                    CodigoBarra = item.CodigoBarra,
                    RutaImagen = item.RutaImagen,
                    Presentacion = item.Presentacion,
                    Marca = item.Marca,
                    Rubro = item.Rubro,
                    Precio = item.Precio,
                    PrecioOferta = item.PrecioOferta
                });
            }

            _feedback = AppUiMessage.Success("Importación completa", $"Se agregaron {result.Value.Count} artículo(s) nuevos desde {origenTexto}.");
        }
        finally
        {
            _importandoListaCompleta = false;
        }
    }

    private async Task QuitarSeleccionadosAsync()
    {
        if (_articulosQuitarSeleccionados.Count == 0)
            return;

        var confirm = await DialogSvc.ConfirmAsync(
            "Quitar seleccionados",
            $"Se quitarán {_articulosQuitarSeleccionados.Count} artículo(s) del catálogo.",
            "Quitar",
            "Cancelar");

        if (!confirm)
            return;

        _articulosSeleccionados.RemoveAll(x => _articulosQuitarSeleccionados.Contains(x.IdArticulo));
        _articulosQuitarSeleccionados.Clear();
        _feedback = AppUiMessage.Success("Artículos quitados", "Los seleccionados fueron removidos del catálogo.");
    }

    private async Task LimpiarCatalogoAsync()
    {
        if (_articulosSeleccionados.Count == 0)
            return;

        var confirm = await DialogSvc.ConfirmAsync(
            "Limpiar catálogo",
            "Se quitarán todos los artículos del catálogo actual.",
            "Limpiar",
            "Cancelar");

        if (!confirm)
            return;

        _articulosSeleccionados.Clear();
        _articulosQuitarSeleccionados.Clear();
        _feedback = AppUiMessage.Success("Catálogo limpiado", "Se quitaron todos los artículos.");
    }

    private async Task ToggleSeleccionTodosQuitarAsync(ChangeEventArgs args)
    {
        var seleccionar = args.Value is bool flag && flag;
        _articulosQuitarSeleccionados.Clear();
        if (seleccionar)
        {
            foreach (var item in _articulosSeleccionados)
                _articulosQuitarSeleccionados.Add(item.IdArticulo);
        }

        await Task.CompletedTask;
    }

    private async Task ToggleQuitarSeleccionAsync(string idArticulo, ChangeEventArgs args)
    {
        var seleccionar = args.Value is bool flag && flag;
        if (seleccionar)
            _articulosQuitarSeleccionados.Add(idArticulo);
        else
            _articulosQuitarSeleccionados.Remove(idArticulo);

        await Task.CompletedTask;
    }

    // "Importar todo" está disponible con los dos orígenes: con Lista de precios requiere una lista
    // elegida (igual que antes); con Maestro de artículos no depende de ninguna selección previa.
    private bool PuedeImportarTodo()
        => string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase)
           ? !string.IsNullOrWhiteSpace(_idLista)
           : string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.Maestro, StringComparison.OrdinalIgnoreCase);

    private bool IsLookupBusy => _importandoListaCompleta;

    private string GetNombreListaActual()
        => _listasPrecio.FirstOrDefault(x => string.Equals(x.IdLista, _idLista, StringComparison.OrdinalIgnoreCase))?.Nombre
           ?? _idLista;

    // Variante de GetNombreListaActual() para una lista arbitraria (no necesariamente la
    // seleccionada ahora) — la usa el confirm de cambio de origen/lista para nombrar "antes" y
    // "después". Incluye el código entre paréntesis (formato distinto a GetNombreListaActual,
    // que ya se usa en otros mensajes existentes y no convenía tocar).

    private static string GetArticuloRowClass(string idArticulo)
