@page "/catalogos"
@page "/{idweb}/{idbase:int}/catalogos"
@page "/interfaces/catalogos"
@page "/{idweb}/{idbase:int}/interfaces/catalogos"
@inherits SaaSRoutePageBase
@using AlfaCore.Models
@inject AlfaCore.Services.IInterfacesCatalogosService CatalogosSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUiDialogService DialogSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Catálogos | Alfa Gestión</PageTitle>

<section class="page-grid">
    <div class="page-intro">
        <div>
            <h2 class="page-intro__title">Catálogos web</h2>
            <p class="page-intro__text">Elegí entre ver catálogos publicados o crear uno nuevo.</p>
        </div>
    </div>

    @if (_feedback is not null)
    {
        <div class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </div>
    }

    @if (_homeSelection is null)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Catálogos</h3>
                    <p class="panel-card__subtitle">Usá las acciones de arriba para abrir publicaciones, crear un catálogo nuevo o entrar al modo predeterminado.</p>
                </div>
            </div>
        </section>
    }
    else if (_homeSelection == CatalogosHomeSelection.NuevoCatalogo)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Crear catálogo nuevo</h3>
                    <p class="panel-card__subtitle">Completá los datos, buscá artículos y publicá cuando esté listo.</p>
                </div>
                <div class="actions flex-wrap">
                    <button type="button" class="btn btn--ghost" @onclick="GuardarAsync" disabled="@_loading">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <button type="button" class="btn btn--primary" @onclick="PublicarAsync" disabled="@_loading">
                        <i class="bi bi-bullhorn"></i> Publicar
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CancelarAsync" disabled="@_loading">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </div>

            <div class="section-block">
                <div class="section-block__head">
                    <h4 class="section-block__title">Datos del catálogo</h4>
                    <p class="section-block__subtitle">Agrupamos lo básico para completar la carga más rápido.</p>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="field">
                            <label>Tipo de catálogo</label>
                            <div class="catalog-mode-group">
                                @foreach (var item in _modalidades)
                                {
                                    <button type="button" class="@GetModeButtonClass(item.Clave)" @onclick="() => SelectModeAsync(item.Clave)">
                                        @GetModeLabel(item.Clave)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="field">
                            <label>Nombre</label>
                            <input @bind="_nombre" placeholder="Catálogo de temporada" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="field">
                            <label>Descripción / observaciones</label>
                            <textarea rows="3" @bind="_descripcion" placeholder="Texto que se mostrará al inicio de la publicación."></textarea>
                        </div>
                    </div>
                    @if (_modo == CatalogosViewGroupKeys.Tipo)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="field">
                                <label>Fecha desde</label>
                                <InputDate TValue="DateTime?" @bind-Value="_vigenciaDesde" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="field">
                                <label>Fecha hasta</label>
                                <InputDate TValue="DateTime?" @bind-Value="_vigenciaHasta" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="section-block mt-4">
                <div class="section-block__head">
                    <h4 class="section-block__title">Agregar artículos desde</h4>
                    <p class="section-block__subtitle">Elegí de dónde queremos consultar y sumar artículos al catálogo.</p>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <button type="button" class="catalog-source-card @(string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectArticuloSourceAsync(CatalogosArticuloOrigenKeys.ListaPrecio)">
                            <strong>Lista de precios</strong>
                        </button>
                        <p class="catalog-source-card__hint">Consultar o importar artículos de una lista.</p>
                    </div>
                    <div class="col-12 col-lg-6">
                        <button type="button" class="catalog-source-card @(string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.Maestro, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectArticuloSourceAsync(CatalogosArticuloOrigenKeys.Maestro)">
                            <strong>Maestro de artículos</strong>
                        </button>
                        <p class="catalog-source-card__hint">Buscar directamente en el maestro de artículos.</p>
                    </div>
                </div>

                @if (string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase))
                {
                    <div class="row g-3 mt-1">
                        <div class="col-12 col-lg-6 col-xxl-4">
                            <div class="field">
                                <label>Lista de precios</label>
                                <select @bind="_idLista" @bind:after="OnListaPrecioChangedAsync">
                                    <option value="">Seleccionar...</option>
                                    @foreach (var lista in _listasPrecio)
                                    {
                                        <option value="@lista.IdLista">@lista.Nombre (@lista.IdLista)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }

                <div class="toolbar mt-3">
                    <button type="button" class="btn btn--primary" @onclick="AbrirLookupArticulosAsync" disabled="@_loading">
                        <i class="bi bi-search"></i> Consultar artículos
                    </button>
                    @if (PuedeImportarListaCompleta())
                    {
                        <button type="button" class="btn btn--ghost" @onclick="ImportarListaCompletaAsync" disabled="@_loading">
                            <i class="bi bi-cloud-arrow-down"></i> Importar lista completa
                        </button>
                    }
                    <button type="button" class="btn btn--ghost" @onclick="QuitarSeleccionadosAsync" disabled="@(!_articulosQuitarSeleccionados.Any())">
                        <i class="bi bi-dash-circle"></i> Quitar seleccionados
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="LimpiarCatalogoAsync" disabled="@(!_articulosSeleccionados.Any())">
                        <i class="bi bi-trash"></i> Limpiar catálogo
                    </button>
                </div>
            </div>

            <div class="section-block mt-4">
                <div class="section-block__head d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h4 class="section-block__title">Artículos del catálogo</h4>
                        <p class="section-block__subtitle">@_articulosSeleccionados.Count artículo(s) seleccionados</p>
                    </div>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="AbrirLookupArticulosAsync">
                        <i class="bi bi-search"></i> Consultar artículos
                    </button>
                </div>

                @if (_articulosSeleccionados.Count == 0)
                {
                    <div class="usuarios-empty">Todavía no agregaste artículos.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table usuarios-table">
                            <thead>
                                <tr>
                                    <th style="width:44px;">
                                        <input type="checkbox" @onchange="ToggleSeleccionTodosQuitarAsync" checked="@(_articulosQuitarSeleccionados.Count == _articulosSeleccionados.Count && _articulosSeleccionados.Count > 0)" />
                                    </th>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th>Presentación</th>
                                    <th>Marca</th>
                                    <th>Rubro</th>
                                    <th style="text-align:right;">Precio</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _articulosSeleccionados)
                                {
                                    <tr class="@GetArticuloRowClass(item.IdArticulo)">
                                        <td>
                                            <input type="checkbox" checked="@_articulosQuitarSeleccionados.Contains(item.IdArticulo)" @onchange="(ChangeEventArgs args) => ToggleQuitarSeleccionAsync(item.IdArticulo, args)" />
                                        </td>
                                        <td><strong>@item.IdArticulo</strong></td>
                                        <td>@item.DescripcionArticulo</td>
                                        <td>@Display(item.Presentacion)</td>
                                        <td>@Display(item.Marca)</td>
                                        <td>@Display(item.Rubro)</td>
                                        <td style="text-align:right;">@Money(item.Precio)</td>
                                        <td style="text-align:right;">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => QuitarArticuloAsync(item.IdArticulo)">
                                                <i class="bi bi-trash"></i> Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_urlPublica))
            {
                <div class="context-card mt-4">
                    <span class="context-card__label">Enlace público</span>
                    <strong>@_urlPublica</strong>
                    <div class="actions mt-2">
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => CopiarEnlaceAsync()">
                            <i class="bi bi-clipboard"></i> Copiar enlace
                        </button>
                        <a class="btn btn--ghost btn--sm" href="@_urlPublica" target="_blank" rel="noopener">
                            <i class="bi bi-box-arrow-up-right"></i> Abrir
                        </a>
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Catálogos publicados</h3>
                    <p class="panel-card__subtitle">Mostramos solo catálogos vigentes para la fecha que elijas.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="BackToHomeAsync">
                        <i class="bi bi-arrow-left"></i> Volver
                    </button>
                </div>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <div class="field">
                        <label>Buscar catálogo</label>
                        <input class="form-control" @bind="_catalogosTexto" @bind:event="oninput" placeholder="Nombre, grupo, lista o id" />
                    </div>
                </div>
                <div class="col-12 col-lg-3">
                    <div class="field">
                        <label>Fecha</label>
                        <InputDate TValue="DateTime?" @bind-Value="_catalogosFechaFiltro" />
                    </div>
                </div>
                <div class="col-12 col-lg-2">
                    <div class="field">
                        <label>Resultados</label>
                        <select class="form-select" @bind="_catalogosPageSize">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-lg-3">
                    <div class="actions">
                        <button type="button" class="btn btn--ghost" @onclick="() => BuscarCatalogosAsync()">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <button type="button" class="btn btn--primary" @onclick="ShowNuevoCatalogoAsync">
                            <i class="bi bi-plus-circle"></i> Crear nuevo
                        </button>
                    </div>
                </div>
            </div>

            <div class="panel-card__header mt-4">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Mostrá u ocultá columnas y reordenalas según tu criterio.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="ToggleViewSettings">
                        <i class="bi bi-sliders"></i> Configurar vista
                    </button>
                </div>
            </div>

            @if (_showViewSettings)
            {
                <div class="usuarios-view-settings">
                    <div class="field">
                        <label>Agrupar por</label>
                        <select @bind="_draftAgruparPor">
                            <option value="@CatalogosViewGroupKeys.None">Sin agrupar</option>
                            <option value="@CatalogosViewGroupKeys.Tipo">Tipo</option>
                            <option value="@CatalogosViewGroupKeys.Estado">Estado</option>
                        </select>
                    </div>
                    <div class="usuarios-view-settings__list">
                        @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                        {
                            <div class="usuarios-view-settings__item">
                                <label class="checkbox">
                                    <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                    <span>@column.Label</span>
                                </label>
                                <div class="actions">
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarVistaAsync">
                            <i class="bi bi-floppy"></i> Guardar vista
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="CancelarVistaAsync">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </button>
                    </div>
                </div>
            }

            <div class="panel-card__header mt-4">
                <div>
                    <h3 class="panel-card__title">Catálogos publicados</h3>
                    <p class="panel-card__subtitle">@(_catalogosPage?.Total ?? 0) registro(s) · página @(_catalogosPage?.PageNumber ?? 1) de @(_catalogosPage?.TotalPages ?? 1)</p>
                </div>
            </div>

            @if (_catalogosPage is null)
            {
                <div class="loading">Cargando catálogos...</div>
            }
            else if (_catalogosPage.Items.Count == 0)
            {
                <div class="usuarios-empty">No hay catálogos publicados para la fecha y filtros actuales.</div>
            }
            else
            {
                var visibleColumns = GetVisibleColumns();
                var groups = BuildGroups(_catalogosPage.Items);
                <div class="table-responsive">
                    <table class="data-table usuarios-table">
                        <thead>
                            <tr>
                                @foreach (var col in visibleColumns)
                                {
                                    <th>@col.Label</th>
                                }
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in groups)
                            {
                                if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@GetColumnSpan(visibleColumns.Count)">@group.Label</td>
                                    </tr>
                                }

                                @foreach (var item in group.Items)
                                {
                                    <tr>
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td>
                                                @switch (col.Key)
                                                {
                                                    case CatalogosViewColumnKeys.Id:
                                                        <strong>@item.IdInsert</strong>
                                                        break;
                                                    case CatalogosViewColumnKeys.Tipo:
                                                        @item.Tipo
                                                        break;
                                                    case CatalogosViewColumnKeys.Nombre:
                                                        @item.Nombre
                                                        break;
                                                    case CatalogosViewColumnKeys.Vigencia:
                                                        @item.Vigencia
                                                        break;
                                                    case CatalogosViewColumnKeys.Estado:
                                                        @item.Estado
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td>
                                            <div class="actions">
                                                <a class="btn btn--ghost btn--sm" href="@GetPublicUrl(item.IdInsert)" target="_blank" rel="noopener">
                                                    <i class="bi bi-eye"></i> Abrir
                                                </a>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => CopiarEnlaceAsync(item.IdInsert)">
                                                    <i class="bi bi-clipboard"></i> Copiar enlace
                                                </button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarCatalogoAsync(item.IdInsert)">
                                                    <i class="bi bi-pencil-square"></i> Editar
                                                </button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => FinalizarCatalogoAsync(item.IdInsert)" disabled="@item.Finalizado">
                                                    <i class="bi bi-check2-circle"></i> Finalizar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                    <span class="panel-card__subtitle">Página @_catalogosPage.PageNumber de @_catalogosPage.TotalPages</span>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="PrevPageAsync" disabled="@(!_catalogosPage.HasPrev)">Anterior</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="NextPageAsync" disabled="@(!_catalogosPage.HasNext)">Siguiente</button>
                </div>
            }
        </section>
    }
</section>

@if (_showLookupModal)
{
    <div class="catalogos-modal-backdrop" @onclick="CloseLookupArticulos"></div>
    <div class="catalogos-modal" role="dialog" aria-modal="true" aria-labelledby="catalogos-lookup-title">
        <div class="catalogos-modal__card">
            <div class="catalogos-modal__header">
                <div>
                    <h4 id="catalogos-lookup-title">Consultar artículos</h4>
                    <p>@(string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase) ? "Búsqueda filtrada por la lista seleccionada." : "Búsqueda sobre el maestro oficial de artículos.")</p>
                </div>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseLookupArticulos">Cerrar</button>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-8">
                    <div class="field">
                        <label>Buscar</label>
                        <input @bind="_lookupTexto" @bind:event="oninput" @onkeydown="HandleSearchKeyDownAsync" placeholder="Código, descripción, marca o rubro" />
                    </div>
                </div>
                <div class="col-12 col-lg-2">
                    <div class="field">
                        <label>Mostrar</label>
                        <select @bind="_lookupPageSize">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-lg-2">
                    <button type="button" class="btn btn--primary w-100" @onclick="BuscarArticulosAsync" disabled="@_loading">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </div>

            <div class="catalogos-modal__meta">
                <span>@_lookupTotal resultado(s)</span>
                <span>@(string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase) ? $"Lista: {GetNombreListaActual()}" : "Origen: maestro de artículos")</span>
            </div>

            <div class="table-responsive catalogos-modal__table">
                <table class="data-table usuarios-table">
                    <thead>
                        <tr>
                            <th style="width:44px;"></th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Presentación</th>
                            <th>Marca</th>
                            <th>Rubro</th>
                            <th style="text-align:right;">Precio</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _lookupResultados)
                        {
                            <tr class="@(IsArticuloAlreadyAdded(item.IdArticulo) ? "is-duplicate" : string.Empty)">
                                <td>
                                    <input type="checkbox" checked="@_lookupSeleccionados.Contains(item.IdArticulo)" @onchange="(ChangeEventArgs args) => ToggleLookupSeleccionAsync(item.IdArticulo, args)" />
                                </td>
                                <td><strong>@item.IdArticulo</strong></td>
                                <td>@item.DescripcionArticulo</td>
                                <td>@Display(item.Presentacion)</td>
                                <td>@Display(item.Marca)</td>
                                <td>@Display(item.Rubro)</td>
                                <td style="text-align:right;">@Money(item.Precio)</td>
                                <td style="text-align:right;">
                                    @if (IsArticuloAlreadyAdded(item.IdArticulo))
                                    {
                                        <span class="badge text-bg-secondary">Ya agregado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="catalogos-modal__footer">
                <button type="button" class="btn btn--ghost" @onclick="CloseLookupArticulos">Cancelar</button>
                <button type="button" class="btn btn--primary" @onclick="AgregarSeleccionadosDesdeLookupAsync" disabled="@(!_lookupSeleccionados.Any())">
                    Agregar seleccionados
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<CatalogosModalidadOptionDto> _modalidades = [];
    private readonly List<CatalogosListaPrecioDto> _listasPrecio = [];
    private readonly List<CatalogosArticuloCatalogoDto> _articulosSeleccionados = [];
    private readonly List<CatalogosArticuloBusquedaDto> _lookupResultados = [];
    private readonly HashSet<string> _lookupSeleccionados = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _articulosQuitarSeleccionados = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<CatalogosViewColumnDto> _viewSettingsDraft = [];

    private CatalogosViewSettingsDto _viewSettings = BuildDefaultViewSettings();
    private PagedResult<CatalogosCatalogoResumenDto>? _catalogosPage;
    private AppUiMessage? _feedback;
    private bool _loading;
    private bool _showViewSettings;
    private CatalogosHomeSelection? _homeSelection;
    private string _modo = CatalogosViewGroupKeys.Tipo;
    private string _nombre = string.Empty;
    private string _descripcion = string.Empty;
    private string _idLista = string.Empty;
    private string _articuloOrigen = CatalogosArticuloOrigenKeys.ListaPrecio;
    private string _lookupTexto = string.Empty;
    private DateTime? _vigenciaDesde = DateTime.Today;
    private DateTime? _vigenciaHasta = DateTime.Today.AddMonths(1);
    private int _lookupPageNumber = 1;
    private int _lookupPageSize = 50;
    private int _lookupTotal = 0;
    private bool _showLookupModal;
    private string _catalogosTexto = string.Empty;
    private DateTime? _catalogosFechaFiltro = DateTime.Today;
    private int _catalogosPageNumber = 1;
    private int _catalogosPageSize = 50;
    private string _catalogosUserName = string.Empty;
    private string _draftAgruparPor = CatalogosViewGroupKeys.None;
    private int? _editingIdInsert;
    private string _urlPublica = string.Empty;
    private readonly CancellationTokenSource _disposeCts = new();
    private readonly List<PageHeaderAction> _headerActions = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        UpdatePageHeader();
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        PageHeader.Clear();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _feedback = null;

        try
        {
            var currentUser = AppUserSession.GetCurrentUserName(Environment.UserName).Trim();
            _catalogosUserName = currentUser;

            var modalidadesTask = CatalogosSvc.GetModalidadesAsync(_disposeCts.Token);
            var listasTask = CatalogosSvc.GetListasPrecioAsync(_disposeCts.Token);
            var viewTask = CatalogosSvc.GetViewSettingsAsync(currentUser, _disposeCts.Token);

            await Task.WhenAll(modalidadesTask, listasTask, viewTask);

            _modalidades.Clear();
            _modalidades.AddRange(modalidadesTask.Result);

            _listasPrecio.Clear();
            _listasPrecio.AddRange(listasTask.Result);

            _viewSettings = viewTask.Result;
            _viewSettingsDraft.Clear();
            _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
            _draftAgruparPor = _viewSettings.AgruparPor;

            if (_homeSelection == CatalogosHomeSelection.VerCatalogos)
                await BuscarCatalogosAsync(resetPage: false);
        }
        catch (Exception ex)
        {
            _feedback = UiOps.BuildMessage(ex, "No se pudo cargar el módulo de catálogos.");
        }
        finally
        {
            _loading = false;
            UpdatePageHeader();
        }
    }

    private async Task RecargarAsync()
    {
        await LoadAsync();
        UpdatePageHeader();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowCatalogosAsync()
    {
        _homeSelection = CatalogosHomeSelection.VerCatalogos;
        _showViewSettings = false;
        _feedback = null;
        await BuscarCatalogosAsync(resetPage: true);
        UpdatePageHeader();
        await InvokeAsync(StateHasChanged);
    }

