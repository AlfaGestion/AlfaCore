@page "/catalogo"
@page "/catalogo/{Vista}"
@page "/catalogo/nuevo"
@page "/catalogo/predeterminado"
@page "/catalogo/menu"
@page "/catalogo/configuracion"
@page "/{idweb}/{idbase:int}/catalogo"
@page "/{idweb}/{idbase:int}/catalogo/{Vista}"
@page "/{idweb}/{idbase:int}/catalogo/nuevo"
@page "/{idweb}/{idbase:int}/catalogo/predeterminado"
@page "/{idweb}/{idbase:int}/catalogo/menu"
@page "/{idweb}/{idbase:int}/catalogo/configuracion"
@page "/catalogos"
@page "/catalogos/{Vista}"
@page "/{idweb}/{idbase:int}/catalogos"
@page "/{idweb}/{idbase:int}/catalogos/{Vista}"
@page "/interfaces/catalogos"
@page "/interfaces/catalogos/{Vista}"
@page "/{idweb}/{idbase:int}/interfaces/catalogos"
@page "/{idweb}/{idbase:int}/interfaces/catalogos/{Vista}"
@inherits SaaSRoutePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@using AlfaCore.Components.Shared.AlfaDesign
@inject AlfaCore.Services.IInterfacesCatalogosService CatalogosSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUiDialogService DialogSvc
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject AlfaCore.Services.ICentralPublicLinkService PublicLinkSvc
@inject AlfaCore.Services.IAppModeService AppMode
@inject AlfaCore.Services.IPuntoVentaService PuntoVentaSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ILogger<InterfacesCatalogos> Logger
@implements IDisposable

<PageTitle>Catálogos | Alfa Gestión</PageTitle>

@if (ShouldRenderCatalogosSection)
{
<section class="page-grid">
    @if (_feedback is not null && _homeSelection != CatalogosHomeSelection.NuevoCatalogo)
    {
        <div class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </div>
    }

    @if (_homeSelection is null || _homeSelection == CatalogosHomeSelection.VerCatalogos)
    {
        <ModuleListToolbar AriaLabel="Herramientas de catálogos"
                           PagerAriaLabel="Paginación de catálogos"
                           ActionsAriaLabel="Acciones de catálogos"
                           ShowPager="true"
                           CurrentPage="@(_catalogosPage?.PageNumber ?? 1)"
                           TotalPages="@(_catalogosPage?.TotalPages ?? 1)"
                           IsLoading="@_loading"
                           OnPageChanged="OnCatalogosPageChangedAsync"
                           Actions="@BuildListadoActions()">
            <SearchContent>
                <div class="catalogos-toolbar">
                    <div class="field catalogos-toolbar__field catalogos-toolbar__field--wide">
                        <label>Buscar catálogo</label>
                        <input type="search"
                               class="form-control"
                               @bind="_catalogosTexto"
                               @bind:event="oninput"
                               @onkeydown="HandleCatalogosSearchKeyDownAsync"
                               placeholder="Nombre, grupo, lista o id" />
                    </div>
                    <div class="field catalogos-toolbar__field">
                        <label>Tipo</label>
                        <select class="form-select" @bind="_catalogosTipoFiltro">
                            <option value="todos">Todos</option>
                            <option value="predeterminado">Predeterminado</option>
                            <option value="vigencia">Con vigencia</option>
                        </select>
                    </div>
                    <div class="field catalogos-toolbar__field">
                        <label>Estado</label>
                        <select class="form-select" @bind="_catalogosEstadoFiltro">
                            <option value="todos">Todos</option>
                            <option value="publicado">Publicado</option>
                            <option value="finalizado">Finalizado</option>
                        </select>
                    </div>
                    <div class="field catalogos-toolbar__field">
                        <label>Fecha</label>
                        <InputDate TValue="DateTime?" class="form-control" @bind-Value="_catalogosFechaFiltro" />
                    </div>
                    <div class="catalogos-toolbar__search-action">
                        <button type="button" class="btn btn--primary" @onclick="() => BuscarCatalogosAsync()" disabled="@_loading">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </div>
            </SearchContent>
        </ModuleListToolbar>

        @if (_showViewSettings)
        {
            <section class="panel-card">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Vista</h3>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarVistaAsync">
                            <i class="bi bi-floppy"></i> Guardar vista
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="CancelarVistaAsync">
                            <i class="bi bi-x-circle"></i> Cerrar
                        </button>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-4">
                        <div class="field">
                            <label>Agrupar por</label>
                            <select @bind="_draftAgruparPor">
                                <option value="@CatalogosViewGroupKeys.None">Sin agrupar</option>
                                <option value="@CatalogosViewGroupKeys.Tipo">Tipo</option>
                                <option value="@CatalogosViewGroupKeys.Estado">Estado</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="usuarios-view-settings__list mt-3">
                    @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="checkbox">
                                <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                <span>@column.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Catálogos publicados</h3>
                    <p class="panel-card__subtitle">@(_catalogosPage?.Total ?? 0) registro(s) · página @(_catalogosPage?.PageNumber ?? 1) de @(_catalogosPage?.TotalPages ?? 1)</p>
                </div>
            </div>

            @if (_catalogosPage is null)
            {
                <div class="loading">Cargando catálogos...</div>
            }
            else if (_catalogosPage.Items.Count == 0)
            {
                <div class="usuarios-empty">No hay catálogos publicados para los filtros actuales.</div>
            }
            else
            {
                var visibleColumns = GetVisibleColumns();
                var groups = BuildGroups(_catalogosPage.Items);
                <div class="table-responsive">
                    <table class="data-table usuarios-table">
                        <thead>
                            <tr>
                                @foreach (var col in visibleColumns)
                                {
                                    <th>@col.Label</th>
                                }
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in groups)
                            {
                                if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@GetColumnSpan(visibleColumns.Count)">@group.Label</td>
                                    </tr>
                                }

                                @foreach (var item in group.Items)
                                {
                                    <tr>
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td>
                                                @switch (col.Key)
                                                {
                                                    case CatalogosViewColumnKeys.Id:
                                                        <strong>@item.IdInsert</strong>
                                                        break;
                                                    case CatalogosViewColumnKeys.Tipo:
                                                        @item.Tipo
                                                        break;
                                                    case CatalogosViewColumnKeys.Nombre:
                                                        @item.Nombre
                                                        @if (item.Predeterminado)
                                                        {
                                                            <span class="badge text-bg-primary ms-1" title="Accesible vía /catalogo/0">Predeterminado</span>
                                                        }
                                                        break;
                                                    case CatalogosViewColumnKeys.Vigencia:
                                                        @item.Vigencia
                                                        break;
                                                    case CatalogosViewColumnKeys.Estado:
                                                        @item.Estado
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td>
                                            <div class="actions">
                                                <a class="btn btn--ghost btn--sm" href="@GetPublicUrl(item.IdInsert)" target="_blank" rel="noopener">
                                                    <i class="bi bi-eye"></i> Abrir
                                                </a>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => CopiarEnlaceAsync(item.IdInsert)">
                                                    <i class="bi bi-clipboard"></i> Copiar enlace
                                                </button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarCatalogoAsync(item.IdInsert)">
                                                    <i class="bi bi-pencil-square"></i> Editar
                                                </button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => FinalizarCatalogoAsync(item.IdInsert)" disabled="@item.Finalizado">
                                                    <i class="bi bi-check2-circle"></i> Finalizar
                                                </button>
                                                @if (item.Predeterminado)
                                                {
                                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => QuitarPredeterminadoAsync()">
                                                        <i class="bi bi-star-fill"></i> Quitar predeterminado
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MarcarPredeterminadoAsync(item.IdInsert)">
                                                        <i class="bi bi-star"></i> Marcar como predeterminado
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (_homeSelection == CatalogosHomeSelection.NuevoCatalogo)
    {
        @if (_feedback is not null)
        {
            <div class="panel-card">
                <div class="editor-msg @GetFeedbackClass(_feedback)">
                    <div>
                        <strong>@_feedback.Title</strong>
                        <p>@_feedback.Message</p>
                        @if (_feedback.HasSuggestion)
                        {
                            <small>@_feedback.Suggestion</small>
                        }
                        @if (_feedback.HasCode)
                        {
                            <small>Código: @_feedback.Code</small>
                        }
                    </div>
                </div>
            </div>
        }

        <section class="section-block">
                <div class="section-block__head">
                    <h4 class="section-block__title">Datos del catálogo</h4>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="field">
                            <label>Tipo de catálogo</label>
                            <div class="catalog-mode-group">
                                @foreach (var item in _modalidades)
                                {
                                    <button type="button" class="@GetModeButtonClass(item.Clave)" @onclick="() => SelectModeAsync(item.Clave)">
                                        @GetModeLabel(item.Clave)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="field">
                            <label>Nombre</label>
                            <input @bind="_nombre" placeholder="Catálogo de temporada" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="field">
                            <label>Descripción / observaciones</label>
                            <textarea rows="3" @bind="_descripcion" placeholder="Opcional"></textarea>
                        </div>
                    </div>
                    @if (_modo == CatalogosViewGroupKeys.Tipo)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="field">
                                <label>Fecha desde</label>
                                <InputDate TValue="DateTime?" @bind-Value="_vigenciaDesde" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="field">
                                <label>Fecha hasta</label>
                                <InputDate TValue="DateTime?" @bind-Value="_vigenciaHasta" />
                            </div>
                        </div>
                    }
                    <div class="col-12">
                        <div class="field">
                            <label class="catalogos-toggle">
                                <input type="checkbox" class="catalogos-toggle__input" @bind="_habilitarCarrito" />
                                <span class="catalogos-toggle__track" aria-hidden="true"></span>
                                <span class="catalogos-toggle__label">
                                    <strong>Habilitar carrito</strong>
                                    <small>Permite a los clientes armar un pedido desde este catálogo (toma de pedidos).</small>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>
        </section>

        <section class="section-block mt-4">
                <div class="section-block__head">
                    <h4 class="section-block__title">Artículos</h4>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <button type="button" class="catalog-source-card @(string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectArticuloSourceAsync(CatalogosArticuloOrigenKeys.ListaPrecio)">
                            <strong>Lista de precios</strong>
                        </button>
                    </div>
                    <div class="col-12 col-lg-6">
                        <button type="button" class="catalog-source-card @(string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.Maestro, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)" @onclick="() => SelectArticuloSourceAsync(CatalogosArticuloOrigenKeys.Maestro)">
                            <strong>Maestro de artículos</strong>
                        </button>
                    </div>
                </div>

                @if (string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase))
                {
                    <div class="row g-3 mt-1">
                        <div class="col-12 col-lg-6 col-xxl-4">
                            <div class="field">
                                <label>Lista de precios</label>
                                <select @key="_listaSelectToken" value="@_idLista" @onchange="e => OnListaPrecioChangedAsync((string?)e.Value)">
                                    <option value="">Seleccionar...</option>
                                    @foreach (var lista in _listasPrecio)
                                    {
                                        <option value="@lista.IdLista">@lista.Nombre (@lista.IdLista)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }

                <div class="toolbar mt-3">
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-search" Disabled="@(_loading || IsLookupBusy)" OnClick="AbrirLookupArticulosAsync">
                        Consultar artículos
                    </AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-images" Disabled="@(_loading || !_articulosSeleccionados.Any())" OnClick="AbrirBaseMaestraImagenesAsync">
                        Obtener imágenes
                    </AlfaButton>
                    @if (PuedeImportarTodo())
                    {
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-cloud-arrow-down" Loading="@_importandoListaCompleta" Disabled="@(_loading || IsLookupBusy)" OnClick="ImportarTodoAsync">
                            @( _importandoListaCompleta ? "Importando..." : "Importar todo" )
                        </AlfaButton>
                    }
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-dash-circle" Disabled="@(!_articulosQuitarSeleccionados.Any() || IsLookupBusy)" OnClick="QuitarSeleccionadosAsync">
                        Quitar seleccionados
                    </AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-trash" Disabled="@(!_articulosSeleccionados.Any() || IsLookupBusy)" OnClick="LimpiarCatalogoAsync">
                        Limpiar catálogo
                    </AlfaButton>
                </div>
        </section>

        <section class="section-block mt-4">
                <div class="section-block__head d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h4 class="section-block__title">Artículos del catálogo</h4>
                    </div>
                </div>

                @if (_articulosSeleccionados.Count == 0)
                {
                    <div class="usuarios-empty">Todavía no agregaste artículos.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table usuarios-table">
                            <thead>
                                <tr>
                                    <th style="width:44px;">
                                        <input type="checkbox" @onchange="ToggleSeleccionTodosQuitarAsync" checked="@(_articulosQuitarSeleccionados.Count == _articulosSeleccionados.Count && _articulosSeleccionados.Count > 0)" />
                                    </th>
                                    <th style="width:88px;">Imagen</th>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th>Presentación</th>
                                    <th>Marca</th>
                                    <th>Rubro</th>
                                    <th style="text-align:right;">Precio</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _articulosSeleccionados)
                                {
                                    <tr class="@GetArticuloRowClass(item.IdArticulo)">
                                        <td>
                                            <input type="checkbox" checked="@_articulosQuitarSeleccionados.Contains(item.IdArticulo)" @onchange="(ChangeEventArgs args) => ToggleQuitarSeleccionAsync(item.IdArticulo, args)" />
                                        </td>
                                        <td>
                                            @if (ShouldShowArticuloImage(item.IdArticulo))
                                            {
                                                <img class="catalogos-article-thumb"
                                                     src="@GetArticuloImageUrl(item.IdArticulo)"
                                                     alt="@item.DescripcionArticulo"
                                                     loading="lazy"
                                                     @onerror="@EventCallback.Factory.Create(this, () => HandleArticuloImageError(item.IdArticulo))" />
                                            }
                                            else
                                            {
                                                <div class="catalogos-article-thumb catalogos-article-thumb--fallback">@ProductInitials(item.DescripcionArticulo)</div>
                                            }
                                        </td>
                                        <td><strong>@item.IdArticulo</strong></td>
                                        <td>@item.DescripcionArticulo</td>
                                        <td>@Display(item.Presentacion)</td>
                                        <td>@Display(item.Marca)</td>
                                        <td>@Display(item.Rubro)</td>
                                        <td style="text-align:right;">@Money(item.Precio)</td>
                                        <td style="text-align:right;">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => QuitarArticuloAsync(item.IdArticulo)">
                                                <i class="bi bi-trash"></i> Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
        </section>

        @if (!string.IsNullOrWhiteSpace(_urlPublica))
        {
            <div class="context-card mt-4">
                    <span class="context-card__label">Enlaces del catálogo</span>
                    @if (!string.IsNullOrWhiteSpace(_urlPublica))
                    {
                        <strong class="mt-3 d-block">Acceso público</strong>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <code class="text-break">@_urlPublica</code>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="CopiarEnlacePublicoAsync">
                                <i class="bi bi-clipboard"></i> Copiar enlace
                            </button>
                            <a class="btn btn--ghost btn--sm" href="@_urlPublica" target="_blank" rel="noopener">
                                <i class="bi bi-box-arrow-up-right"></i> Abrir
                            </a>
                        </div>
                    }
                    @if (_habilitarCarrito && !string.IsNullOrWhiteSpace(_urlCarrito))
                    {
                        <strong class="mt-3 d-block">Toma de pedidos</strong>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <code class="text-break">@_urlCarrito</code>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="CopiarEnlaceCarritoAsync">
                                <i class="bi bi-clipboard"></i> Copiar enlace
                            </button>
                            <a class="btn btn--ghost btn--sm" href="@_urlCarrito" target="_blank" rel="noopener">
                                <i class="bi bi-box-arrow-up-right"></i> Abrir
                            </a>
                        </div>
                    }
            </div>
        }
    }
</section>
}

@if (IsMenuSection)
{
    <section class="page-grid">
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Menú</h3>
                </div>
            </div>

            @if (_menuHabilitado)
            {
                <div class="context-card">
                    <span class="context-card__label">Estado</span>
                    <strong>Habilitado</strong>
                </div>
            }
            else
            {
                <div class="usuarios-empty">El menú de catálogos no está habilitado en esta base.</div>
            }
        </section>
    </section>
}

@if (IsConfiguracionSection)
{
    <section class="page-grid">
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración</h3>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionCatalogosAsync" disabled="@_loading">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                </div>
            </div>

            <div class="section-block">
                <div class="field">
                    <label>Menú</label>
                    <label class="checkbox">
                        <input type="checkbox" checked="@_menuHabilitadoDraft" @onchange="ToggleMenuHabilitadoDraft" />
                        <span>Mostrar opción Menú</span>
                    </label>
                </div>

                <div class="field">
                    <label>Nombre visible</label>
                    <input @bind="_publicIdentityNameDraft" placeholder="@GetPublicIdentityPlaceholder()" maxlength="80" />
                    <small class="catalogos-config-help">Si está vacío se utiliza el nombre de la empresa.</small>
                </div>

                <div class="field">
                    <label>Logo</label>
                    <div class="catalogos-config-logo">
                        <div class="catalogos-config-logo__preview @GetPublicLogoFrameClass(_publicLogoFormatDraft)">
                            <img src="@GetPublicLogoPreviewUrl()" alt="Vista previa del logo público" />
                        </div>
                        <div class="catalogos-config-logo__actions">
                            <InputFile OnChange="HandlePublicLogoSelectedAsync" accept="image/jpeg,image/png,image/webp,image/gif" />
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="RestorePublicLogoDefaultAsync" disabled="@(!_hasCustomPublicLogo && _publicLogoBytes.Length == 0)">
                                    <i class="bi bi-arrow-counterclockwise"></i> Restaurar predeterminado
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="field mt-3">
                    <label>Formato del logo</label>
                    <select @bind="_publicLogoFormatDraft">
                        <option value="@CatalogosPublicLogoFormatKeys.Auto">Automático</option>
                        <option value="@CatalogosPublicLogoFormatKeys.Square">Cuadrado</option>
                        <option value="@CatalogosPublicLogoFormatKeys.Horizontal">Horizontal</option>
                    </select>
                </div>

                <div class="field mt-3">
                    <label>Clase de precio</label>
                    <select @bind="_clasePrecioDraft">
                        <option value="1">Clase 1</option>
                        <option value="2">Clase 2</option>
                        <option value="3">Clase 3</option>
                        <option value="4">Clase 4</option>
                        <option value="5">Clase 5</option>
                        <option value="6">Clase 6</option>
                        <option value="7">Clase 7</option>
                        <option value="8">Clase 8</option>
                    </select>
                    <small class="catalogos-config-help">Define qué columna de precio del artículo (Precio1 a Precio8) se usa al buscar o importar artículos para el catálogo. Los catálogos ya publicados no cambian.</small>
                </div>
            </div>

            <div class="context-card mt-4">
                <span class="context-card__label">Clave</span>
                <strong>CATALOGOS-MENU-HABILITADO</strong>
                <span class="context-card__muted">Valor esperado: SI / NO.</span>
            </div>

            <div class="context-card mt-3">
                <span class="context-card__label">Identidad pública</span>
                <strong>@GetPublicIdentitySummary()</strong>
                <span class="context-card__muted">Se guarda en <code>TA_CONFIGURACION</code> y se aplica al encabezado público del catálogo.</span>
            </div>
        </section>
    </section>
}

