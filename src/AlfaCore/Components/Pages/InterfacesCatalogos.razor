    private async Task EditarCatalogoAsync(int idInsert)
    {
        var result = await UiOps.RunAsync(() => CatalogosSvc.GetCatalogoAsync(idInsert, _disposeCts.Token), "No se pudo cargar el catálogo.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        _homeSelection = CatalogosHomeSelection.NuevoCatalogo;
        var detail = result.Value;
        _editingIdInsert = detail.IdInsert;
        _modo = string.Equals(detail.Tipo, "Permanente", StringComparison.OrdinalIgnoreCase)
            ? CatalogosViewGroupKeys.None
            : CatalogosViewGroupKeys.Tipo;
        _nombre = detail.Nombre;
        _descripcion = detail.Observaciones;
        _idLista = detail.IdLista;
        _articuloOrigen = string.IsNullOrWhiteSpace(detail.IdLista)
            ? CatalogosArticuloOrigenKeys.Maestro
            : CatalogosArticuloOrigenKeys.ListaPrecio;
        _listaSelectToken++;
        _vigenciaDesde = detail.VigenciaDesde;
        _vigenciaHasta = detail.VigenciaHasta;
        _habilitarCarrito = detail.HabilitarCarrito;
        _articulosSeleccionados.Clear();
        _articulosSeleccionados.AddRange(detail.Articulos.Select(x => new CatalogosArticuloCatalogoDto
        {
            IdArticulo = x.IdArticulo,
            DescripcionArticulo = x.DescripcionArticulo,
            CodigoBarra = x.CodigoBarra,
            RutaImagen = x.RutaImagen,
            Presentacion = x.Presentacion,
            Marca = x.Marca,
            Rubro = x.Rubro,
            Precio = x.Precio ?? 0m,
            PrecioOferta = x.PrecioOferta
        }));
        await SetCatalogUrlsAsync(detail.IdInsert, detail.Nombre);
        _feedback = AppUiMessage.Success("Catálogo cargado", $"Se abrió el catálogo #{detail.IdInsert} para editarlo.");
        UpdatePageHeader();
    }

