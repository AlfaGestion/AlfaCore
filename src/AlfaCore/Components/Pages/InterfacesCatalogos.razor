    /// <summary>
    /// Panel "Enlaces del catálogo": genera (o reutiliza) el link público seguro por token para
    /// este catálogo y su carrito. Reemplaza los links legacy /{idweb}/{idbase}/catalogo|carrito/
    /// {idInsert} — el token nunca revela IdBase. Si por algún motivo no hay IdWeb/IdBase
    /// resueltos (ej. legacy on-prem sin ALFA_CENTRAL), cae al esquema anterior para no romper el
    /// botón de compartir.
    /// </summary>
    private async Task SetCatalogUrlsAsync(int idInsert, string? nombreCatalogo)
    {
        var ownerIdWeb = GetPublicLinkOwnerIdWeb();
        var ownerIdBase = SessionSvc.GetActiveSession()?.BaseId ?? idbase;

        if (!AppMode.IsSaaSMode || string.IsNullOrWhiteSpace(ownerIdWeb) || ownerIdBase is not > 0)
        {
            _urlPublica = GetPublicUrl(idInsert);
            _urlCarrito = GetCarritoUrl(idInsert);
            return;
        }

        try
        {
            var catalogoLink = await PublicLinkSvc.GetOrCreateAsync(
                ownerIdWeb, ownerIdBase.Value, PublicLinkTipos.Catalogo, idInsert, nombreCatalogo, _disposeCts.Token);
            var carritoLink = await PublicLinkSvc.GetOrCreateAsync(
                ownerIdWeb, ownerIdBase.Value, PublicLinkTipos.Carrito, idInsert, nombreCatalogo, _disposeCts.Token);

            _urlPublica = Nav.ToAbsoluteUri($"/{Uri.EscapeDataString(ownerIdWeb)}/catalogo/{catalogoLink.RouteSegment}").ToString();
            _urlCarrito = Nav.ToAbsoluteUri($"/{Uri.EscapeDataString(ownerIdWeb)}/carrito/{carritoLink.RouteSegment}").ToString();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "InterfacesCatalogos: no se pudo generar el link público seguro para el catálogo #{IdInsert}; se usa el esquema anterior.", idInsert);
            _urlPublica = GetPublicUrl(idInsert);
            _urlCarrito = GetCarritoUrl(idInsert);
        }
    }

