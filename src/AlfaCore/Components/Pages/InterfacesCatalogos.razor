    private async Task OnListaPrecioChangedAsync()
    {
        if (_showLookupModal)
            await BuscarArticulosAsync();
    }

    private async Task BuscarArticulosAsync()
    {
        _feedback = null;
        if (string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(_idLista))
        {
            _lookupResultados.Clear();
            _lookupTotal = 0;
            return;
        }

        var result = await UiOps.RunAsync(() => CatalogosSvc.SearchArticulosAsync(new CatalogosArticuloBusquedaFiltersDto
        {
            Texto = _lookupTexto,
            IdLista = _idLista,
            Origen = _articuloOrigen,
            PageNumber = _lookupPageNumber,
            PageSize = _lookupPageSize
        }, _disposeCts.Token), "No se pudieron cargar los artículos.");

        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        _lookupResultados.Clear();
        _lookupResultados.AddRange(result.Value.Items);
        _lookupTotal = result.Value.Total;
        _showLookupModal = true;
    }

    private Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
            return BuscarArticulosAsync();

        return Task.CompletedTask;
    }

    private async Task AgregarArticuloAsync(CatalogosArticuloBusquedaDto item)
    {
        if (_articulosSeleccionados.Any(x => string.Equals(x.IdArticulo, item.IdArticulo, StringComparison.OrdinalIgnoreCase)))
            return;

        _articulosSeleccionados.Add(new CatalogosArticuloCatalogoDto
        {
            IdArticulo = item.IdArticulo,
            DescripcionArticulo = item.DescripcionArticulo,
            Presentacion = item.Presentacion,
            Marca = item.Marca,
            Rubro = item.Rubro,
            Precio = item.Precio,
            PrecioOferta = item.PrecioOferta
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task QuitarArticuloAsync(string idArticulo)
    {
        var existing = _articulosSeleccionados.FirstOrDefault(x => string.Equals(x.IdArticulo, idArticulo, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            _articulosSeleccionados.Remove(existing);
            _articulosQuitarSeleccionados.Remove(idArticulo);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task AbrirLookupArticulosAsync()
    {
        _lookupPageNumber = 1;
        await BuscarArticulosAsync();
    }

    private void CloseLookupArticulos()
    {
        _showLookupModal = false;
        _lookupSeleccionados.Clear();
    }

    private async Task SelectArticuloSourceAsync(string origen)
    {
        _articuloOrigen = origen;
        if (!string.Equals(origen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase))
            _idLista = string.Empty;

        _lookupResultados.Clear();
        _lookupSeleccionados.Clear();
        await Task.CompletedTask;
    }

    private async Task ToggleLookupSeleccionAsync(string idArticulo, ChangeEventArgs args)
    {
        var checkedValue = args.Value is bool flag && flag;
        if (checkedValue)
            _lookupSeleccionados.Add(idArticulo);
        else
            _lookupSeleccionados.Remove(idArticulo);

        await Task.CompletedTask;
    }

    private async Task AgregarSeleccionadosDesdeLookupAsync()
    {
        var seleccionados = _lookupResultados.Where(x => _lookupSeleccionados.Contains(x.IdArticulo)).ToList();
        foreach (var item in seleccionados)
            await AgregarArticuloAsync(item);

        _lookupSeleccionados.Clear();
        _showLookupModal = false;
    }

    private async Task ImportarListaCompletaAsync()
    {
        if (!PuedeImportarListaCompleta())
            return;

        var total = await UiOps.RunAsync(() => CatalogosSvc.CountArticulosDesdeListaAsync(_idLista, _disposeCts.Token), "No se pudo contar la lista de precios.");
        if (!total.Success)
        {
            _feedback = total.Feedback;
            return;
        }

        var confirmado = await DialogSvc.ConfirmAsync(
            "Importar lista completa",
            $"Se agregarán {total.Value} artículos de la lista \"{GetNombreListaActual()}\". ¿Desea continuar?",
            "Importar",
            "Cancelar");

        if (!confirmado)
            return;

        var result = await UiOps.RunAsync(() => CatalogosSvc.GetArticulosDesdeListaAsync(_idLista, _disposeCts.Token), "No se pudo importar la lista completa.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        var agregados = 0;
        foreach (var item in result.Value)
        {
            if (_articulosSeleccionados.Any(x => string.Equals(x.IdArticulo, item.IdArticulo, StringComparison.OrdinalIgnoreCase)))
                continue;

            _articulosSeleccionados.Add(new CatalogosArticuloCatalogoDto
            {
                IdArticulo = item.IdArticulo,
                DescripcionArticulo = item.DescripcionArticulo,
                Presentacion = item.Presentacion,
                Marca = item.Marca,
                Rubro = item.Rubro,
                Precio = item.Precio,
                PrecioOferta = item.PrecioOferta
            });
            agregados++;
        }

        _feedback = AppUiMessage.Success("Lista importada", $"Se agregaron {agregados} artículos nuevos desde \"{GetNombreListaActual()}\".");
    }

    private async Task QuitarSeleccionadosAsync()
    {
        if (_articulosQuitarSeleccionados.Count == 0)
            return;

        var confirm = await DialogSvc.ConfirmAsync(
            "Quitar seleccionados",
            $"Se quitarán {_articulosQuitarSeleccionados.Count} artículo(s) del catálogo.",
            "Quitar",
            "Cancelar");

        if (!confirm)
            return;

        _articulosSeleccionados.RemoveAll(x => _articulosQuitarSeleccionados.Contains(x.IdArticulo));
        _articulosQuitarSeleccionados.Clear();
        _feedback = AppUiMessage.Success("Artículos quitados", "Los seleccionados fueron removidos del catálogo.");
    }

    private async Task LimpiarCatalogoAsync()
    {
        if (_articulosSeleccionados.Count == 0)
            return;

        var confirm = await DialogSvc.ConfirmAsync(
            "Limpiar catálogo",
            "Se quitarán todos los artículos del catálogo actual.",
            "Limpiar",
            "Cancelar");

        if (!confirm)
            return;

        _articulosSeleccionados.Clear();
        _articulosQuitarSeleccionados.Clear();
        _feedback = AppUiMessage.Success("Catálogo limpiado", "Se quitaron todos los artículos.");
    }

    private async Task ToggleSeleccionTodosQuitarAsync(ChangeEventArgs args)
    {
        var seleccionar = args.Value is bool flag && flag;
        _articulosQuitarSeleccionados.Clear();
        if (seleccionar)
        {
            foreach (var item in _articulosSeleccionados)
                _articulosQuitarSeleccionados.Add(item.IdArticulo);
        }

        await Task.CompletedTask;
    }

    private async Task ToggleQuitarSeleccionAsync(string idArticulo, ChangeEventArgs args)
    {
        var seleccionar = args.Value is bool flag && flag;
        if (seleccionar)
            _articulosQuitarSeleccionados.Add(idArticulo);
        else
            _articulosQuitarSeleccionados.Remove(idArticulo);

        await Task.CompletedTask;
    }

    private bool PuedeImportarListaCompleta()
        => string.Equals(_articuloOrigen, CatalogosArticuloOrigenKeys.ListaPrecio, StringComparison.OrdinalIgnoreCase)
           && !string.IsNullOrWhiteSpace(_idLista);

    private string GetNombreListaActual()
        => _listasPrecio.FirstOrDefault(x => string.Equals(x.IdLista, _idLista, StringComparison.OrdinalIgnoreCase))?.Nombre
           ?? _idLista;

    private static string GetArticuloRowClass(string idArticulo)
        => string.IsNullOrWhiteSpace(idArticulo) ? string.Empty : string.Empty;

    private bool IsArticuloAlreadyAdded(string idArticulo)
        => _articulosSeleccionados.Any(x => string.Equals(x.IdArticulo, idArticulo, StringComparison.OrdinalIgnoreCase));

    private async Task GuardarAsync()
    {
        if (_modo == CatalogosViewGroupKeys.None)
        {
            _feedback = AppUiMessage.Success("Borrador actualizado", "El catálogo permanente quedó preparado en pantalla.");
            return;
        }

        _feedback = AppUiMessage.Success("Borrador preparado", "El catálogo con vigencia quedó listo para publicar.");
        await Task.CompletedTask;
    }

    private async Task PublicarAsync()
    {
        if (_modo != CatalogosViewGroupKeys.Tipo)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Catálogo permanente",
                Message = "La publicación física del catálogo permanente se definirá en una etapa posterior."
            };
            return;
        }

        var result = await UiOps.RunAsync(() => CatalogosSvc.SaveCatalogoVigenciaAsync(BuildSaveRequest()), "No se pudo publicar el catálogo con vigencia.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        _editingIdInsert = result.Value.IdInsert;
        _urlPublica = GetPublicUrl(result.Value.IdInsert);
        _feedback = AppUiMessage.Success("Catálogo publicado", result.Value.Mensaje);
        await BuscarCatalogosAsync();
    }

    private CatalogosCatalogoSaveRequestDto BuildSaveRequest()
        => new()
        {
            IdInsert = _editingIdInsert,
            Tipo = _modo,
            Nombre = _nombre.Trim(),
            Observaciones = _descripcion.Trim(),
            IdLista = _idLista.Trim(),
            VigenciaDesde = _vigenciaDesde,
            VigenciaHasta = _vigenciaHasta,
            Usuario = _catalogosUserName,
            Pc = Environment.MachineName,
            Articulos = _articulosSeleccionados.ToArray()
        };

    private async Task CancelarAsync()
    {
        ResetNuevoCatalogo();
        _feedback = AppUiMessage.Success("Formulario reiniciado", "La pantalla volvió al estado inicial.");
        await Task.CompletedTask;
    }

    private async Task BuscarCatalogosAsync(bool resetPage = true)
    {
        if (resetPage)
            _catalogosPageNumber = 1;

        var result = await UiOps.RunAsync(() => CatalogosSvc.SearchCatalogosAsync(
            _catalogosTexto,
            _catalogosPageNumber,
            _catalogosPageSize,
            _catalogosFechaFiltro,
            _disposeCts.Token), "No se pudieron cargar los catálogos.");

        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        _catalogosPage = result.Value;
    }

    private async Task PrevPageAsync()
    {
        if (_catalogosPage is null || !_catalogosPage.HasPrev)
            return;

        _catalogosPageNumber = Math.Max(1, _catalogosPage.PageNumber - 1);
        await BuscarCatalogosAsync(resetPage: false);
    }

    private async Task NextPageAsync()
    {
        if (_catalogosPage is null || !_catalogosPage.HasNext)
            return;

        _catalogosPageNumber = _catalogosPage.PageNumber + 1;
        await BuscarCatalogosAsync(resetPage: false);
    }

    private async Task EditarCatalogoAsync(int idInsert)
    {
        var result = await UiOps.RunAsync(() => CatalogosSvc.GetCatalogoAsync(idInsert, _disposeCts.Token), "No se pudo cargar el catálogo.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        _homeSelection = CatalogosHomeSelection.NuevoCatalogo;
        var detail = result.Value;
        _editingIdInsert = detail.IdInsert;
        _modo = string.Equals(detail.Tipo, "Permanente", StringComparison.OrdinalIgnoreCase)
            ? CatalogosViewGroupKeys.None
            : CatalogosViewGroupKeys.Tipo;
        _nombre = detail.Nombre;
        _descripcion = detail.Observaciones;
        _idLista = detail.IdLista;
        _vigenciaDesde = detail.VigenciaDesde;
        _vigenciaHasta = detail.VigenciaHasta;
        _articulosSeleccionados.Clear();
        _articulosSeleccionados.AddRange(detail.Articulos.Select(x => new CatalogosArticuloCatalogoDto
        {
            IdArticulo = x.IdArticulo,
            DescripcionArticulo = x.DescripcionArticulo,
            Presentacion = x.Presentacion,
            Marca = x.Marca,
            Rubro = x.Rubro,
            Precio = x.Precio ?? 0m,
            PrecioOferta = x.PrecioOferta
        }));
        _urlPublica = GetPublicUrl(detail.IdInsert);
        _feedback = AppUiMessage.Success("Catálogo cargado", $"Se abrió el catálogo #{detail.IdInsert} para editarlo.");
        await Task.CompletedTask;
    }

    private async Task FinalizarCatalogoAsync(int idInsert)
    {
        var result = await UiOps.RunAsync(async () =>
        {
            await CatalogosSvc.FinalizarCatalogoAsync(idInsert, _catalogosUserName, Environment.MachineName, _disposeCts.Token);
            return true;
        }, "No se pudo finalizar el catálogo.");

        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Catálogo finalizado", $"El catálogo #{idInsert} quedó marcado como finalizado.");
        await BuscarCatalogosAsync();
    }

    private async Task CopiarEnlaceAsync(int? idInsert = null)
    {
        var targetId = idInsert ?? _editingIdInsert;
        if (!targetId.HasValue)
            return;

        var url = GetPublicUrl(targetId.Value);
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
        _feedback = AppUiMessage.Success("Enlace copiado", url);
    }

    private async Task GuardarVistaAsync()
    {
        if (string.IsNullOrWhiteSpace(_catalogosUserName))
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Sesión requerida",
                Message = "Necesitás iniciar sesión para guardar la configuración de vista."
            };
            return;
        }

        var settings = new CatalogosViewSettingsDto { AgruparPor = _draftAgruparPor, Columnas = CloneColumns(_viewSettingsDraft) };
        var result = await UiOps.RunAsync(async () =>
        {
            await CatalogosSvc.SaveViewSettingsAsync(_catalogosUserName, settings, _disposeCts.Token);
            return true;
        }, "No se pudo guardar la configuración de vista.");

        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _viewSettings = settings;
        _showViewSettings = false;
        _feedback = AppUiMessage.Success("Vista guardada", "La grilla de catálogos quedó actualizada para tu usuario.");
    }

    private async Task CancelarVistaAsync()
    {
        _showViewSettings = false;
        await Task.CompletedTask;
    }

    private void ToggleViewSettings()
    {
        _showViewSettings = !_showViewSettings;
        _draftAgruparPor = _viewSettings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
    }

    private void ToggleViewColumn(string key, ChangeEventArgs args)
    {
        var column = _viewSettingsDraft.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null)
            return;

        column.Visible = args.Value is bool flag && flag;
        if (!_viewSettingsDraft.Any(c => c.Visible))
            column.Visible = true;
    }

    private void MoveViewColumn(string key, int offset)
    {
        var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
            return;

        var target = index + offset;
        if (target < 0 || target >= ordered.Count)
            return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++)
            ordered[i].Order = i;

        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(ordered);
    }

    private IReadOnlyList<CatalogosViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private static int GetColumnSpan(int visibleColumnsCount) => visibleColumnsCount + 1;

    private IReadOnlyList<CatalogosGridGroup> BuildGroups(IEnumerable<CatalogosCatalogoResumenDto> items)
    {
        if (_viewSettings.AgruparPor == CatalogosViewGroupKeys.None)
            return [new CatalogosGridGroup { Label = string.Empty, ShowHeader = false, Items = items.ToList() }];

        return items
            .GroupBy(x => ResolveGroupValue(x, _viewSettings.AgruparPor))
            .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(g => new CatalogosGridGroup { Label = g.Key, ShowHeader = true, Items = g.ToList() })
            .ToList();
    }

    private static string ResolveGroupValue(CatalogosCatalogoResumenDto item, string grouping)
        => grouping switch
        {
            CatalogosViewGroupKeys.Tipo => item.Tipo,
            CatalogosViewGroupKeys.Estado => item.Estado,
            _ => string.Empty
        };

    private string GetModeButtonClass(string mode)
        => string.Equals(mode, "vigencia", StringComparison.OrdinalIgnoreCase)
            ? _modo == CatalogosViewGroupKeys.Tipo ? "catalog-mode-card is-active" : "catalog-mode-card"
            : _modo == CatalogosViewGroupKeys.None ? "catalog-mode-card is-active" : "catalog-mode-card";

    private static string GetModeLabel(string mode)
        => string.Equals(mode, "vigencia", StringComparison.OrdinalIgnoreCase)
            ? "Catálogo con vigencia"
            : "Catálogo predeterminado";

    private string GetPublicUrl(int idInsert)
    {
        if (!string.IsNullOrWhiteSpace(idweb) && idbase.HasValue)
            return $"/{idweb}/{idbase.Value}/catalogo/{idInsert}";

        return $"/catalogo/{idInsert}";
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string Money(decimal? value)
        => value.HasValue ? value.Value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR")) : "—";

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--ok",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            _ => "editor-msg--error"
        };

    private static CatalogosViewSettingsDto BuildDefaultViewSettings()
        => new()
        {
            AgruparPor = CatalogosViewGroupKeys.None,
            Columnas =
            [
                new() { Key = CatalogosViewColumnKeys.Id, Label = "ID", Visible = true, Order = 0 },
                new() { Key = CatalogosViewColumnKeys.Tipo, Label = "Tipo", Visible = true, Order = 1 },
                new() { Key = CatalogosViewColumnKeys.Nombre, Label = "Nombre", Visible = true, Order = 2 },
                new() { Key = CatalogosViewColumnKeys.Vigencia, Label = "Vigencia", Visible = true, Order = 3 },
                new() { Key = CatalogosViewColumnKeys.Estado, Label = "Estado", Visible = true, Order = 4 }
            ]
        };

    private static List<CatalogosViewColumnDto> CloneColumns(IEnumerable<CatalogosViewColumnDto> columns)
        => columns.OrderBy(c => c.Order)
                  .Select(c => new CatalogosViewColumnDto { Key = c.Key, Label = c.Label, Visible = c.Visible, Order = c.Order })
                  .ToList();

    private sealed class CatalogosGridGroup
    {
        public string Label { get; init; } = string.Empty;
        public bool ShowHeader { get; init; }
        public List<CatalogosCatalogoResumenDto> Items { get; init; } = [];
    }

    private enum CatalogosHomeSelection
    {
        VerCatalogos = 1,
        NuevoCatalogo = 2
    }
}
