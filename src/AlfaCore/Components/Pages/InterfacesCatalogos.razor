    {
        _homeSelection = CatalogosHomeSelection.NuevoCatalogo;
        _showViewSettings = false;
        _feedback = null;
        ResetNuevoCatalogo();
        UpdatePageHeader();
        await InvokeAsync(StateHasChanged);
        await Task.CompletedTask;
