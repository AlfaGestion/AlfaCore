    private async Task BuscarCatalogosAsync(bool resetPage = true)
    {
        var traceId = Interlocked.Increment(ref _catalogosSearchSequence);
        Logger.LogInformation("CATALOGOS - BuscarCatalogosAsync START #{TraceId} | resetPage={ResetPage} page={Page} size={Size} loading={Loading} loaded={Loaded} pageNull={PageNull}",
            traceId,
            resetPage,
            _catalogosPageNumber,
            _catalogosPageSize,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null);
        if (resetPage)
            _catalogosPageNumber = 1;

        Logger.LogInformation("CATALOGOS - BuscarCatalogosAsync #{TraceId} antes UiOps.RunAsync", traceId);
        var result = await UiOps.RunAsync(() => CatalogosSvc.SearchCatalogosAsync(
            _catalogosTexto,
            _catalogosPageNumber,
            _catalogosPageSize,
            _catalogosFechaFiltro,
            _catalogosTipoFiltro,
            _catalogosEstadoFiltro,
            _disposeCts.Token), "No se pudieron cargar los catálogos.");
        Logger.LogInformation("CATALOGOS - BuscarCatalogosAsync #{TraceId} después UiOps.RunAsync | success={Success} hasValue={HasValue} total={Total}",
            traceId,
            result.Success,
            result.Value is not null,
            result.Value?.Total ?? 0);

        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            Logger.LogWarning("CATALOGOS - BuscarCatalogosAsync #{TraceId} terminó sin resultados válidos", traceId);
            return;
        }

        _catalogosPage = result.Value;
        Logger.LogInformation("CATALOGOS - BuscarCatalogosAsync END #{TraceId} | total={Total} pageNumber={PageNumber} pageSize={PageSize}",
            traceId,
            _catalogosPage.Total,
            _catalogosPage.PageNumber,
            _catalogosPage.PageSize);

        await ResolveGridPublicUrlsAsync();
    }

    private readonly Dictionary<int, string> _catalogUrls = new();

    /// <summary>
    /// Resuelve (o genera) en un solo lote el link público seguro por token de cada catálogo de la
    /// página actual — mismo ALFA_PUBLIC_LINK y mismo servicio que usa el panel de detalle
    /// (SetCatalogUrlsAsync). Los botones "Abrir"/"Copiar enlace" de la grilla leen de acá.
    /// </summary>
    private async Task ResolveGridPublicUrlsAsync()
    {
        _catalogUrls.Clear();

        if (_catalogosPage is null || _catalogosPage.Items.Count == 0)
            return;

        var ownerIdWeb = GetPublicLinkOwnerIdWeb();
        var ownerIdBase = SessionSvc.GetActiveSession()?.BaseId ?? idbase;

        if (!AppMode.IsSaaSMode || string.IsNullOrWhiteSpace(ownerIdWeb) || ownerIdBase is not > 0)
            return;

        var referencias = _catalogosPage.Items
            .Select(i => (IdReferencia: i.IdInsert, Nombre: (string?)i.Nombre))
            .ToArray();

        try
        {
            var links = await PublicLinkSvc.GetOrCreateManyAsync(ownerIdWeb, ownerIdBase.Value, PublicLinkTipos.Catalogo, referencias, _disposeCts.Token);
            foreach (var (idInsert, link) in links)
                _catalogUrls[idInsert] = Nav.ToAbsoluteUri($"/{Uri.EscapeDataString(ownerIdWeb)}/catalogo/{link.RouteSegment}").ToString();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "InterfacesCatalogos: no se pudieron generar los links públicos seguros de la grilla en lote; los botones usan el esquema anterior.");
            _catalogUrls.Clear();
        }
    }

    private async Task<T> TraceTaskAsync<T>(int traceId, string origin, string step, Func<Task<T>> factory)
    {
        Logger.LogInformation("CATALOGOS - {Origin} #{TraceId} antes {Step}", origin, traceId, step);
        var result = await factory();
        Logger.LogInformation("CATALOGOS - {Origin} #{TraceId} después {Step} | {Result}",
            origin,
            traceId,
            step,
            DescribeTraceResult(result));
        return result;
    }

    private static string DescribeTraceResult<T>(T result)
    {
        return result switch
        {
            null => "null",
            IReadOnlyCollection<CatalogosModalidadOptionDto> modalidades => $"count={modalidades.Count}",
            IReadOnlyCollection<CatalogosListaPrecioDto> listas => $"count={listas.Count}",
            CatalogosViewSettingsDto view => $"columnas={view.Columnas.Count} agruparPor={view.AgruparPor}",
            bool flag => $"value={flag}",
            PuntoVentaSettingsDto pos => $"ftp={pos.FtpCodigoCta}",
            _ => result.ToString() ?? string.Empty
        };
    }

