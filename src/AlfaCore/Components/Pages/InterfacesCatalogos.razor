@code {
    private const string SectionCatalogos = "catalogo";
    private const string SectionNuevo = "nuevo";
    private const string SectionPredeterminado = "predeterminado";
    private const string SectionMenu = "menu";
    private const string SectionConfiguracion = "configuracion";

    private readonly List<CatalogosModalidadOptionDto> _modalidades = [];
    private readonly List<CatalogosListaPrecioDto> _listasPrecio = [];
    private readonly List<CatalogosArticuloCatalogoDto> _articulosSeleccionados = [];
    private readonly HashSet<string> _articulosQuitarSeleccionados = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _articuloImageFallbacks = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<CatalogosViewColumnDto> _viewSettingsDraft = [];
    private IReadOnlyList<BaseMaestraImagenOrigenDto> _baseMaestraImagenesOrigen = [];

    private CatalogosViewSettingsDto _viewSettings = BuildDefaultViewSettings();
    private PagedResult<CatalogosCatalogoResumenDto>? _catalogosPage;
    private AppUiMessage? _feedback;
    private bool _loading;
    private bool _importandoListaCompleta;
    private bool _showViewSettings;
    private CatalogosHomeSelection? _homeSelection;
    private string _modo = CatalogosViewGroupKeys.Tipo;
    private string _nombre = string.Empty;
    private string _descripcion = string.Empty;
    private string _idLista = string.Empty;
    private int _listaSelectToken;
    private string _articuloOrigen = CatalogosArticuloOrigenKeys.ListaPrecio;
    private DateTime? _vigenciaDesde = DateTime.Today;
    private DateTime? _vigenciaHasta = DateTime.Today.AddMonths(1);
    private bool _showLookupModal;
    private bool _showBaseMaestraImagenesModal;
    private int _articuloImageVersion;
    private string _catalogosTexto = string.Empty;
    private DateTime? _catalogosFechaFiltro = DateTime.Today;
    private int _catalogosPageNumber = 1;
    private int _catalogosPageSize = 50;
    private string _catalogosTipoFiltro = "todos";
    private string _catalogosEstadoFiltro = "publicado";
    private string _catalogosUserName = string.Empty;
    private string _draftAgruparPor = CatalogosViewGroupKeys.None;
    private string _currentSection = SectionCatalogos;
    private int? _editingIdInsert;
    private string _urlPublica = string.Empty;
    private string _urlCarrito = string.Empty;
    private bool _habilitarCarrito;
    private bool _menuHabilitado;
    private bool _menuHabilitadoDraft;
    private CatalogosPublicIdentityDto _publicIdentity = new();
    private string _publicIdentityNameDraft = string.Empty;
    private string _publicLogoFormatDraft = CatalogosPublicLogoFormatKeys.Auto;
    private string _clasePrecioDraft = "1";
    private string _publicLogoPreviewUrl = string.Empty;
    private byte[] _publicLogoBytes = [];
    private string _publicLogoFileName = string.Empty;
    private string _publicLogoContentType = string.Empty;
    private bool _publicLogoRestoreRequested;
    private bool _hasCustomPublicLogo;
    private PuntoVentaSettingsDto _puntoVentaSettings = new();
    private bool _routeSessionReady;
    private bool _catalogosLoaded;
    private bool _catalogosInitialLoadPending = true;
    private int _catalogosLoadSequence;
    private int _catalogosSearchSequence;
    private string _lastCatalogRouteKey = string.Empty;
    private readonly CancellationTokenSource _disposeCts = new();

    [Parameter]
    public string? Vista { get; set; }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        if (TryRedirectToCanonicalRoute())
            return;

        Logger.LogInformation("CATALOGOS - OnInitializedAsync | idweb={IdWeb} idbase={IdBase} loading={Loading} loaded={Loaded} pageNull={PageNull} currentSection={Section} homeSelection={HomeSelection}",
            idweb ?? string.Empty,
            idbase?.ToString() ?? string.Empty,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null,
            _currentSection,
            _homeSelection?.ToString() ?? string.Empty);

        UpdatePageHeader();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && (!_catalogosInitialLoadPending || _loading))
            return;

        await Task.Yield();
        UpdatePageHeader();

        if (_catalogosInitialLoadPending && !_catalogosLoaded && !_loading)
        {
            _catalogosInitialLoadPending = false;
            await CargarCatalogosAsync(forceReloadCatalogos: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TryRedirectToCanonicalRoute())
            return;

        Logger.LogInformation("CATALOGOS - OnParametersSetAsync | idweb={IdWeb} idbase={IdBase} loading={Loading} loaded={Loaded} pageNull={PageNull} currentSection={Section} homeSelection={HomeSelection}",
            idweb ?? string.Empty,
            idbase?.ToString() ?? string.Empty,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null,
            _currentSection,
            _homeSelection?.ToString() ?? string.Empty);

        var routeKey = BuildRouteKey();
        if (!string.Equals(_lastCatalogRouteKey, routeKey, StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogInformation("CATALOGOS - OnParametersSetAsync cambio de ruta detectado | previous={PreviousRouteKey} current={CurrentRouteKey}", _lastCatalogRouteKey, routeKey);
            _lastCatalogRouteKey = routeKey;
            _catalogosLoaded = false;
            _catalogosPage = null;
            _catalogosInitialLoadPending = true;
        }

        if (_catalogosLoaded)
            await ApplyRouteSectionAsync(ResolveSection(Vista), forceReloadCatalogos: false);
        else
            _catalogosInitialLoadPending = true;

        UpdatePageHeader();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _disposeCts.Cancel();
        PageHeader.Clear();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _feedback = null;
        var traceId = Interlocked.Increment(ref _catalogosLoadSequence);
        Logger.LogInformation("CATALOGOS - LoadAsync START #{TraceId} | idweb={IdWeb} idbase={IdBase} loading={Loading} loaded={Loaded} pageNull={PageNull}",
            traceId,
            idweb ?? string.Empty,
            idbase?.ToString() ?? string.Empty,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null);

        try
        {
            var currentUser = AppUserSession.GetCurrentUserName(Environment.UserName).Trim();
            _catalogosUserName = currentUser;

            var modalidadesTask = TraceTaskAsync(traceId, "LoadAsync", "GetModalidadesAsync", () => CatalogosSvc.GetModalidadesAsync(_disposeCts.Token));
            var listasTask = TraceTaskAsync(traceId, "LoadAsync", "GetListasPrecioAsync", () => CatalogosSvc.GetListasPrecioAsync(_disposeCts.Token));
            var viewTask = TraceTaskAsync(traceId, "LoadAsync", "GetViewSettingsAsync", () => CatalogosSvc.GetViewSettingsAsync(currentUser, _disposeCts.Token));
            var menuTask = TraceTaskAsync(traceId, "LoadAsync", "GetMenuHabilitadoAsync", () => CatalogosSvc.GetMenuHabilitadoAsync(_disposeCts.Token));
            var identityTask = TraceTaskAsync(traceId, "LoadAsync", "GetPublicIdentityAsync", () => CatalogosSvc.GetPublicIdentityAsync(idweb, _disposeCts.Token));
            var posSettingsTask = TraceTaskAsync(traceId, "LoadAsync", "PuntoVentaSvc.GetSettingsAsync", () => PuntoVentaSvc.GetSettingsAsync(_disposeCts.Token));
            var clasePrecioTask = TraceTaskAsync(traceId, "LoadAsync", "GetPublicClasePrecioAsync", () => CatalogosSvc.GetPublicClasePrecioAsync(idweb, _disposeCts.Token));

            Logger.LogInformation("CATALOGOS - LoadAsync #{TraceId} esperando tareas paralelas", traceId);
            await Task.WhenAll(modalidadesTask, listasTask, viewTask, menuTask, identityTask, posSettingsTask, clasePrecioTask);
            Logger.LogInformation("CATALOGOS - LoadAsync #{TraceId} tareas paralelas completadas", traceId);

            _modalidades.Clear();
            _modalidades.AddRange(modalidadesTask.Result);

            _listasPrecio.Clear();
            _listasPrecio.AddRange(listasTask.Result);

            _viewSettings = viewTask.Result;
            _viewSettingsDraft.Clear();
            _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
            _draftAgruparPor = _viewSettings.AgruparPor;
            _menuHabilitado = menuTask.Result;
            _menuHabilitadoDraft = _menuHabilitado;
            _publicIdentity = identityTask.Result;
            _publicIdentityNameDraft = _publicIdentity.NombreVisible;
            _publicLogoPreviewUrl = _publicIdentity.LogoUrl;
            _publicLogoBytes = [];
            _publicLogoFileName = string.Empty;
            _publicLogoContentType = string.Empty;
            _publicLogoRestoreRequested = false;
            _hasCustomPublicLogo = _publicIdentity.TieneLogoPersonalizado;
            _puntoVentaSettings = posSettingsTask.Result;
            _clasePrecioDraft = clasePrecioTask.Result;

            Logger.LogInformation("CATALOGOS - LoadAsync END #{TraceId} | modalidades={Modalidades} listas={Listas} menu={Menu} viewColumns={Columns} loading={Loading}",
                traceId,
                _modalidades.Count,
                _listasPrecio.Count,
                _menuHabilitado,
                _viewSettings.Columnas.Count,
                _loading);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CATALOGOS - LoadAsync ERROR | idweb={IdWeb} idbase={IdBase} loading={Loading} loaded={Loaded} pageNull={PageNull}",
                idweb ?? string.Empty,
                idbase?.ToString() ?? string.Empty,
                _loading,
                _catalogosLoaded,
                _catalogosPage is null);
            _feedback = UiOps.BuildMessage(ex, "No se pudo cargar el módulo de catálogos.");
        }
        finally
        {
            _loading = false;
            Logger.LogInformation("CATALOGOS - LoadAsync FINALLY | loading={Loading}", _loading);
        }
    }

    private async Task ApplyRouteSectionAsync(string section, bool forceReloadCatalogos)
    {
        var normalizedSection = NormalizeSection(section);
        if (string.Equals(_currentSection, normalizedSection, StringComparison.OrdinalIgnoreCase) && !forceReloadCatalogos)
            return;

        _currentSection = normalizedSection;
        _showViewSettings = false;
        _showLookupModal = false;

        if (IsCatalogosSection)
        {
            _homeSelection = CatalogosHomeSelection.VerCatalogos;

            if (_catalogosPage is null || forceReloadCatalogos || _homeSelection == CatalogosHomeSelection.VerCatalogos)
                await BuscarCatalogosAsync(resetPage: forceReloadCatalogos || _catalogosPage is null);
            return;
        }

        if (IsNuevoSection)
        {
            _homeSelection = CatalogosHomeSelection.NuevoCatalogo;
            ResetNuevoCatalogo();
            return;
        }

        if (IsPredeterminadoSection)
        {
            _homeSelection = CatalogosHomeSelection.NuevoCatalogo;
            ResetNuevoCatalogo();
            await SelectModeAsync("permanente");
            return;
        }

        if (IsMenuSection || IsConfiguracionSection)
        {
            _homeSelection = CatalogosHomeSelection.VerCatalogos;
            if (IsConfiguracionSection)
                _menuHabilitadoDraft = _menuHabilitado;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!IsCatalogosRoute(e.Location))
            return;

        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            var targetSection = ResolveSectionFromLocation(e.Location);
            await ApplyRouteSectionAsync(targetSection, forceReloadCatalogos: false);
            UpdatePageHeader();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task CargarCatalogosAsync(bool forceReloadCatalogos)
        => await CargarCatalogosAsync(forceReloadCatalogos, "AUTOMATICA");

    private async Task CargarCatalogosAsync(bool forceReloadCatalogos, string origen)
    {
        var traceId = Interlocked.Increment(ref _catalogosLoadSequence);
        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync START #{TraceId} ORIGEN={Origen} forceReload={ForceReload} | idweb={IdWeb} idbase={IdBase} loading={Loading} loaded={Loaded} pageNull={PageNull}",
            traceId,
            origen,
            forceReloadCatalogos,
            idweb ?? string.Empty,
            idbase?.ToString() ?? string.Empty,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null);

        if (_loading)
        {
            Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} ABORTA por _loading=true", traceId);
            return;
        }

        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} antes EnsureRouteSessionAsync", traceId);
        _routeSessionReady = await EnsureRouteSessionAsync();
        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} después EnsureRouteSessionAsync | routeSessionReady={RouteSessionReady}", traceId, _routeSessionReady);
        if (!_routeSessionReady)
        {
            Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} sale porque no hay sesión de ruta", traceId);
            return;
        }

        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} antes LoadAsync", traceId);
        await LoadAsync();
        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} después LoadAsync | loading={Loading}", traceId, _loading);
        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} antes ApplyRouteSectionAsync", traceId);
        await ApplyRouteSectionAsync(ResolveSection(Vista), forceReloadCatalogos);
        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync #{TraceId} después ApplyRouteSectionAsync | pageNull={PageNull} total={Total} loaded={Loaded}",
            traceId,
            _catalogosPage is null,
            _catalogosPage?.Total ?? 0,
            _catalogosLoaded);
        _catalogosLoaded = true;
        UpdatePageHeader();
        await InvokeAsync(StateHasChanged);
        Logger.LogInformation("CATALOGOS - CargarCatalogosAsync END #{TraceId} | loading={Loading} loaded={Loaded} pageNull={PageNull} total={Total}",
            traceId,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null,
            _catalogosPage?.Total ?? 0);
    }

    private async Task<bool> EnsureRouteSessionAsync()
    {
        var traceId = Interlocked.Increment(ref _catalogosLoadSequence);
        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync START #{TraceId} | idweb={IdWeb} idbase={IdBase}",
            traceId,
            idweb ?? string.Empty,
            idbase?.ToString() ?? string.Empty);

        if (!idbase.HasValue)
        {
            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} sin idbase -> true", traceId);
            return true;
        }

        var routeBaseId = idbase.Value;
        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} antes GetActiveSession", traceId);
        var activeSession = SessionSvc.GetActiveSession();
        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} después GetActiveSession | activeBaseId={ActiveBaseId}",
            traceId,
            activeSession is null ? string.Empty : activeSession.BaseId.ToString());
        if (activeSession is not null && activeSession.BaseId == routeBaseId)
        {
            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} sesión ya activa -> true", traceId);
            return true;
        }

        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} antes GetAllSessions", traceId);
        var availableSession = SessionSvc.GetAllSessions().FirstOrDefault(x => x.BaseId == routeBaseId);
        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} después GetAllSessions | found={Found}", traceId, availableSession is not null);
        if (availableSession is not null)
        {
            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} antes SwitchSession | sessionId={SessionId} baseId={BaseId}",
                traceId,
                availableSession.Id,
                availableSession.BaseId);
            SessionSvc.SwitchSession(availableSession.Id);
            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} después SwitchSession", traceId);
            try
            {
                Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} antes JS setActive", traceId);
                await Js.InvokeVoidAsync("alfaCoreSqlSession.setActive", availableSession.Id.ToString());
                Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} después JS setActive", traceId);
            }
            catch
            {
                // La sesión en memoria ya quedó activa; el storage es solo persistencia auxiliar.
                Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} JS setActive falló o no estaba disponible", traceId);
            }

            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} returning true por sesión disponible", traceId);
            return true;
        }

        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} antes CentralBasesSvc.GetByIdAsync", traceId);
        var routeBase = await CentralBasesSvc.GetByIdAsync(routeBaseId);
        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} después CentralBasesSvc.GetByIdAsync | routeBaseNull={RouteBaseNull}", traceId, routeBase is null);
        if (routeBase is null)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Base no disponible",
                Message = "No se pudo resolver la base asociada a esta URL."
            };
            Logger.LogWarning("CATALOGOS - EnsureRouteSessionAsync #{TraceId} no pudo resolver la base", traceId);
            return false;
        }

        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} antes SetWebhookOverride", traceId);
        SessionSvc.SetWebhookOverride(new SessionDto
        {
            Id = Guid.Parse($"00000000-0000-0000-0000-{routeBaseId:000000000000}"),
            BaseId = routeBase.IdBase,
            Nombre = routeBase.Nombre,
            Servidor = routeBase.DbServer,
            BaseDatos = routeBase.DbName,
            Usuario = routeBase.DbUser,
            Password = routeBase.DbPassword,
            TrustServerCertificate = true,
            Activa = true
        });
        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} después SetWebhookOverride", traceId);

        try
        {
            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} antes JS setActive (webhook)", traceId);
            await Js.InvokeVoidAsync("alfaCoreSqlSession.setActive", Guid.Parse($"00000000-0000-0000-0000-{routeBaseId:000000000000}").ToString());
            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} después JS setActive (webhook)", traceId);
        }
        catch
        {
            // La sesión en memoria ya quedó activa; el storage es solo persistencia auxiliar.
            Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync #{TraceId} JS setActive (webhook) falló o no estaba disponible", traceId);
        }

        Logger.LogInformation("CATALOGOS - EnsureRouteSessionAsync END #{TraceId} -> true", traceId);
        return true;
    }

    private string BuildRouteKey()
        => $"{(idweb ?? string.Empty).Trim().ToUpperInvariant()}|{idbase?.ToString() ?? string.Empty}";

    private void NavigateToSection(string section)
    {
        var target = BuildSectionRoute(section);
        if (string.Equals(GetCurrentRoutePath(), NormalizeRoutePath(target), StringComparison.OrdinalIgnoreCase))
            return;

        Nav.NavigateTo(target);
    }

    private async Task RecargarAsync()
    {
        var traceId = Interlocked.Increment(ref _catalogosLoadSequence);
        Logger.LogInformation("CATALOGOS - Recargar START #{TraceId} | idweb={IdWeb} idbase={IdBase} loading={Loading} loaded={Loaded} pageNull={PageNull}",
            traceId,
            idweb ?? string.Empty,
            idbase?.ToString() ?? string.Empty,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null);
        await CargarCatalogosAsync(forceReloadCatalogos: true, "RECARGAR");
        Logger.LogInformation("CATALOGOS - Recargar END #{TraceId} | loading={Loading} loaded={Loaded} pageNull={PageNull} total={Total}",
            traceId,
            _loading,
            _catalogosLoaded,
            _catalogosPage is null,
            _catalogosPage?.Total ?? 0);
    }

    private IReadOnlyList<PageHeaderAction> BuildListadoActions()
        => [
            new PageHeaderAction
            {
                Key = "nuevo-catalogo",
                Label = "Nuevo catálogo",
                Icon = "bi-plus-circle",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _loading,
                OnClick = ShowNuevoCatalogoAsync
            },
            new PageHeaderAction
            {
                Key = "recargar-catalogos",
                Label = "Recargar",
                Icon = "bi-arrow-clockwise",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _loading,
                OnClick = RecargarAsync
            },
            new PageHeaderAction
            {
                Key = "configurar-vista",
                Label = "Configurar vista",
                Icon = "bi-sliders",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                Disabled = _loading,
                OnClick = () => { ToggleViewSettings(); return Task.CompletedTask; }
            }
        ];

    private Task ShowCatalogosAsync()
    {
        NavigateToSection(SectionCatalogos);
        return Task.CompletedTask;
    }

    private async Task ShowNuevoCatalogoAsync()
    {
        NavigateToSection(SectionNuevo);
        await Task.CompletedTask;
    }

    private Task ShowCatalogoPredeterminadoAsync()
    {
        NavigateToSection(SectionPredeterminado);
        return Task.CompletedTask;
    }

    private Task ShowMenuAsync()
    {
        NavigateToSection(SectionMenu);
        return Task.CompletedTask;
    }

    private Task ShowConfiguracionAsync()
    {
        NavigateToSection(SectionConfiguracion);
        return Task.CompletedTask;
    }

    private void ResetNuevoCatalogo()
    {
        _modo = CatalogosViewGroupKeys.None;
        _nombre = string.Empty;
        _descripcion = string.Empty;
        _idLista = _listasPrecio.FirstOrDefault()?.IdLista ?? string.Empty;
        _articuloOrigen = CatalogosArticuloOrigenKeys.ListaPrecio;
        _listaSelectToken++;
        _vigenciaDesde = DateTime.Today;
        _vigenciaHasta = DateTime.Today.AddMonths(1);
        _articulosSeleccionados.Clear();
        _articulosQuitarSeleccionados.Clear();
        _showLookupModal = false;
        _urlPublica = string.Empty;
        _urlCarrito = string.Empty;
        _habilitarCarrito = false;
        _editingIdInsert = null;
    }

    private async Task SelectModeAsync(string mode)
    {
        _modo = string.Equals(mode, "vigencia", StringComparison.OrdinalIgnoreCase)
            ? CatalogosViewGroupKeys.Tipo
            : CatalogosViewGroupKeys.None;

        if (_modo == CatalogosViewGroupKeys.None)
        {
            _vigenciaDesde = null;
            _vigenciaHasta = null;
        }
        else
        {
            _vigenciaDesde ??= DateTime.Today;
            _vigenciaHasta ??= DateTime.Today.AddMonths(1);
        }

        _feedback = null;
        UpdatePageHeader();
        await Task.CompletedTask;
    }

    private bool IsCatalogosSection => string.Equals(_currentSection, SectionCatalogos, StringComparison.OrdinalIgnoreCase);
    private bool IsNuevoSection => string.Equals(_currentSection, SectionNuevo, StringComparison.OrdinalIgnoreCase);
    private bool IsPredeterminadoSection => string.Equals(_currentSection, SectionPredeterminado, StringComparison.OrdinalIgnoreCase);
    private bool IsMenuSection => string.Equals(_currentSection, SectionMenu, StringComparison.OrdinalIgnoreCase);
    private bool IsConfiguracionSection => string.Equals(_currentSection, SectionConfiguracion, StringComparison.OrdinalIgnoreCase);
    private bool ShouldRenderCatalogosSection => IsCatalogosSection || IsNuevoSection || IsPredeterminadoSection || IsLegacyCatalogosRoute();

    private string GetSectionTitle()
        => IsPredeterminadoSection ? "Catálogo predeterminado" : "Catálogos web";

    private string GetSectionIntro()
        => IsPredeterminadoSection
            ? "Administrá el catálogo general sin fechas de vigencia."
            : "Elegí entre ver catálogos publicados o crear uno nuevo.";

    private static string NormalizeSection(string? value)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            SectionNuevo => SectionNuevo,
            SectionPredeterminado => SectionPredeterminado,
            SectionMenu => SectionMenu,
            SectionConfiguracion => SectionConfiguracion,
            SectionCatalogos => SectionCatalogos,
            _ => SectionCatalogos
        };

    private string ResolveSection(string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            return NormalizeSection(value);

        var routeBody = GetRouteBody(GetCurrentRoutePath()).ToLowerInvariant();
        return routeBody switch
        {
            "catalogo" => SectionCatalogos,
            "catalogo/nuevo" => SectionNuevo,
            "catalogo/predeterminado" => SectionPredeterminado,
            "catalogo/menu" => SectionMenu,
            "catalogo/configuracion" => SectionConfiguracion,
            "catalogos" => SectionCatalogos,
            "catalogos/nuevo" => SectionNuevo,
            "catalogos/predeterminado" => SectionPredeterminado,
            "catalogos/menu" => SectionMenu,
            "catalogos/configuracion" => SectionConfiguracion,
            "interfaces/catalogos" => SectionCatalogos,
            "interfaces/catalogos/nuevo" => SectionNuevo,
            "interfaces/catalogos/predeterminado" => SectionPredeterminado,
            "interfaces/catalogos/menu" => SectionMenu,
            "interfaces/catalogos/configuracion" => SectionConfiguracion,
            _ => SectionCatalogos
        };
    }

    private string ResolveSectionFromLocation(string location)
    {
        var routeBody = GetRouteBody(Nav.ToBaseRelativePath(location)).ToLowerInvariant();
        return routeBody switch
        {
            "catalogo" => SectionCatalogos,
            "catalogo/nuevo" => SectionNuevo,
            "catalogo/predeterminado" => SectionPredeterminado,
            "catalogo/menu" => SectionMenu,
            "catalogo/configuracion" => SectionConfiguracion,
            "catalogos" => SectionCatalogos,
            "catalogos/nuevo" => SectionNuevo,
            "catalogos/predeterminado" => SectionPredeterminado,
            "catalogos/menu" => SectionMenu,
            "catalogos/configuracion" => SectionConfiguracion,
            "interfaces/catalogos" => SectionCatalogos,
            "interfaces/catalogos/nuevo" => SectionNuevo,
            "interfaces/catalogos/predeterminado" => SectionPredeterminado,
            "interfaces/catalogos/menu" => SectionMenu,
            "interfaces/catalogos/configuracion" => SectionConfiguracion,
            _ => SectionCatalogos
        };
    }

    private string GetCurrentRoutePath()
        => NormalizeRoutePath(Nav.ToBaseRelativePath(Nav.Uri));

    private static string NormalizeRoutePath(string? value)
        => (value ?? string.Empty).Split('?', '#')[0].Trim().Trim('/');

    private static string GetRouteBody(string? value)
    {
        var normalized = NormalizeRoutePath(value);
        if (string.IsNullOrWhiteSpace(normalized))
            return string.Empty;

        var segments = normalized.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (segments.Length >= 2 && int.TryParse(segments[1], out _))
            return string.Join('/', segments.Skip(2));

        return normalized;
    }

    private bool IsLegacyCatalogosRoute()
    {
        var routeBody = GetRouteBody(GetCurrentRoutePath());
        return routeBody.Equals("catalogos", StringComparison.OrdinalIgnoreCase)
               || routeBody.StartsWith("catalogos/", StringComparison.OrdinalIgnoreCase)
               || routeBody.Equals("interfaces/catalogos", StringComparison.OrdinalIgnoreCase)
               || routeBody.StartsWith("interfaces/catalogos/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCatalogosRoute(string location)
    {
        var routeBody = GetRouteBody(Nav.ToBaseRelativePath(location));
        return routeBody.Equals("catalogo", StringComparison.OrdinalIgnoreCase)
               || routeBody.StartsWith("catalogo/", StringComparison.OrdinalIgnoreCase)
               || routeBody.Equals("catalogos", StringComparison.OrdinalIgnoreCase)
               || routeBody.StartsWith("catalogos/", StringComparison.OrdinalIgnoreCase)
               || routeBody.Equals("interfaces/catalogos", StringComparison.OrdinalIgnoreCase)
               || routeBody.StartsWith("interfaces/catalogos/", StringComparison.OrdinalIgnoreCase);
    }

    private bool TryRedirectToCanonicalRoute()
    {
        var routeBody = GetRouteBody(GetCurrentRoutePath());
        if (!routeBody.Equals("catalogos", StringComparison.OrdinalIgnoreCase)
            && !routeBody.StartsWith("catalogos/", StringComparison.OrdinalIgnoreCase)
            && !routeBody.Equals("interfaces/catalogos", StringComparison.OrdinalIgnoreCase)
            && !routeBody.StartsWith("interfaces/catalogos/", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var target = BuildSectionRoute(ResolveSection(Vista));
        if (string.Equals(NormalizeRoutePath(GetCurrentRoutePath()), NormalizeRoutePath(target), StringComparison.OrdinalIgnoreCase))
            return false;

        Nav.NavigateTo(target, replace: true);
        return true;
    }

    private string BuildSectionRoute(string section)
    {
        var normalized = NormalizeSection(section);
        var route = normalized switch
        {
            SectionCatalogos => "/catalogo",
            SectionNuevo => "/catalogo/nuevo",
            SectionPredeterminado => "/catalogo/predeterminado",
            SectionConfiguracion => "/catalogo/configuracion",
            SectionMenu => "/catalogo/menu",
            _ => "/catalogo"
        };

        return RouteContext.BuildRoute(route);
    }

