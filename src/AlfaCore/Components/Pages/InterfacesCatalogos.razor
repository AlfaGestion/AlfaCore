    private async Task GuardarConfiguracionCatalogosAsync()
    {
        var result = await UiOps.RunAsync(async () =>
        {
            await CatalogosSvc.SaveMenuHabilitadoAsync(_catalogosUserName, _menuHabilitadoDraft, _disposeCts.Token);
            await CatalogosSvc.SavePublicIdentityNameAsync(_catalogosUserName, _publicIdentityNameDraft, _disposeCts.Token);
            await CatalogosSvc.SavePublicLogoFormatAsync(_catalogosUserName, idweb, _publicLogoFormatDraft, _disposeCts.Token);
            await CatalogosSvc.SavePublicClasePrecioAsync(_catalogosUserName, idweb, _clasePrecioDraft, _disposeCts.Token);

            if (_publicLogoRestoreRequested)
            {
                await CatalogosSvc.ResetPublicIdentityLogoAsync(_catalogosUserName, idweb, _disposeCts.Token);
                _publicIdentity = await CatalogosSvc.GetPublicIdentityAsync(idweb, _disposeCts.Token);
            }
            else if (_publicLogoBytes.Length > 0)
            {
                await using var stream = new MemoryStream(_publicLogoBytes);
                _publicIdentity = await CatalogosSvc.SavePublicIdentityLogoAsync(
                    _catalogosUserName,
                    idweb,
                    stream,
                    _publicLogoFileName,
                    _publicLogoContentType,
                    _disposeCts.Token);
            }
            else
            {
                _publicIdentity = await CatalogosSvc.GetPublicIdentityAsync(idweb, _disposeCts.Token);
            }

            return true;
        }, "No se pudo guardar la configuración de catálogos.");

        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _menuHabilitado = _menuHabilitadoDraft;
        _publicIdentityNameDraft = _publicIdentity.NombreVisible;
        _publicLogoPreviewUrl = string.IsNullOrWhiteSpace(_publicIdentity.LogoUrl) ? "/logos/Logo.png" : _publicIdentity.LogoUrl;
        _publicLogoFormatDraft = _publicIdentity.LogoFormato;
        _clasePrecioDraft = await CatalogosSvc.GetPublicClasePrecioAsync(idweb, _disposeCts.Token);
        _publicLogoBytes = [];
        _publicLogoFileName = string.Empty;
        _publicLogoContentType = string.Empty;
        _publicLogoRestoreRequested = false;
        _hasCustomPublicLogo = _publicIdentity.TieneLogoPersonalizado;
        _feedback = AppUiMessage.Success("Configuración guardada", "La identidad pública y la visibilidad del menú quedaron actualizadas.");
        UpdatePageHeader();
    }

    private async Task HandlePublicLogoSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
            return;

        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        await using var ms = new MemoryStream();
        await stream.CopyToAsync(ms, _disposeCts.Token);

        _publicLogoBytes = ms.ToArray();
        _publicLogoFileName = file.Name;
        _publicLogoContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        _publicLogoPreviewUrl = $"data:{_publicLogoContentType};base64,{Convert.ToBase64String(_publicLogoBytes)}";
        _publicLogoRestoreRequested = false;
        _hasCustomPublicLogo = true;
    }

    private Task RestorePublicLogoDefaultAsync()
    {
        _publicLogoBytes = [];
        _publicLogoFileName = string.Empty;
        _publicLogoContentType = string.Empty;
        _publicLogoPreviewUrl = "/logos/Logo.png";
        _publicLogoRestoreRequested = true;
        _hasCustomPublicLogo = false;
        return Task.CompletedTask;
    }

