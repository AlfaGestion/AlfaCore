@page "/portal-cliente/pedidos/{IdComprobante:int}"
@page "/{idweb}/{idbase:int}/portal-cliente/pedidos/{IdComprobante:int}"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@using AlfaCore.Components.Shared.AlfaDesign
@inject AlfaCore.Services.IPortalClienteService PortalClienteSvc
@inject AlfaCore.Services.IConfiguracionGeneralService ConfiguracionSvc
@inject AlfaCore.Services.ICotizacionDocumentService DocumentoSvc

<PageTitle>Pedido | Portal Cliente</PageTitle>

@if (NotFound)
{
    <section class="page-grid portal-cliente">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver" />
}
else
{
    <section class="page-grid portal-cliente portal-cliente--detail">
        <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                              BrandName="@GetBrandingName()"
                              LogoFrameClass="@GetBrandingLogoFrameClass()"
                              ClientLabel="@GetCurrentClientLabel()"
                              Busy="@SessionBusy"
                              OnLogout="LogoutClienteAsync"
                              ActiveTab="pedidos"
                              RouteInicio="@BuildPortalRoute("")"
                              RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                              RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                              RouteCatalogos="@BuildPortalRoute("catalogos")"
                              RouteCarrito="@BuildPortalRoute("carrito")"
                              RoutePedidos="@BuildPortalRoute("pedidos")"
                              RouteMiCuenta="@BuildPortalRoute("mi-cuenta")"
                              SeccionesHabilitadas="@PortalSecciones" />

        @if (_loading)
        {
            <section class="portal-cliente__section">
                <div class="portal-cliente__loading-state">
                    <p class="text-muted">Cargando pedido...</p>
                </div>
            </section>
        }
        else if (_pedido is null)
        {
            <section class="portal-cliente__section">
                <div class="portal-cliente__empty-panel">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults"
                                    Title="Pedido no encontrado"
                                    Message="No existe o no pertenece a tu cuenta."
                                    Class="portal-cliente__empty-state" />
                </div>
                <div class="portal-cliente__empty-panel">
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-arrow-left" OnClick="VolverAPedidos">
                        Volver a pedidos
                    </AlfaButton>
                </div>
            </section>
        }
        else
        {
            <div class="portal-comprobante-actions no-print">
                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-arrow-left" OnClick="VolverAPedidos">
                    Volver a pedidos
                </AlfaButton>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="ImprimirAsync">
                    <i class="bi bi-printer"></i> Imprimir
                </button>
            </div>

            <div class="portal-comprobante-wrap">
                @if (!string.IsNullOrWhiteSpace(_documentoHtml))
                {
                    <iframe class="portal-comprobante-document-frame" style="display:block;width:100%;max-width:820px;height:1120px;margin:0 auto;border:1px solid #d5dde5;border-radius:14px;background:#fff;" srcdoc="@_documentoHtml" title="Nota de pedido"></iframe>
                }
                else
                {
                    <PortalClienteComprobanteView Item="_comprobante" Empresa="_empresa" LogoUrl="@GetBrandingLogoUrl()" LogoAlt="@GetBrandingName()" />
                }
            </div>
            @* La tarjeta es la misma que se usa para comprobantes de Cuenta Corriente/Cobranza. *@
            @if (_pedido.Anulada || _pedido.EsPedidoWeb)
            {
                <div class="no-print portal-cliente__detalle-meta-tags">
                    @if (_pedido.EsPedidoWeb) { <AlfaTag Tone="AlfaTagTone.Accent">Pedido Web</AlfaTag> }
                    @if (_pedido.EsPedidoWeb && _pedido.IdCatalogoWeb is { } idCat) { <AlfaTag Tone="AlfaTagTone.Neutral">Catálogo #@idCat</AlfaTag> }
                    @if (_pedido.Anulada) { <AlfaTag Tone="AlfaTagTone.Danger">Anulado</AlfaTag> }
                </div>
            }
        }
    </section>
}

@code {
    protected override string? RequiredSectionKey => "pedidos";

    private static readonly System.Globalization.CultureInfo CultureEsAr = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    [Parameter] public int IdComprobante { get; set; }

    private CatalogoClienteLoginPanel? _loginPanel;
    private bool _loading;
    private PortalClientePedidoDetalleDto? _pedido;
    private ConfiguracionEmpresaDto _empresa = new();
    private PortalClienteComprobantePendienteDetalleDto _comprobante = new();
    private string? _documentoHtml;

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            await CargarDetalleAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
        => await CargarDetalleAsync();

    private void VolverAPedidos()
        => Nav.NavigateTo(BuildPortalRoute("pedidos"));

    private async Task CargarDetalleAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // El servicio valida CodigoCliente contra la sesión autenticada — nunca contra un
            // valor recibido del navegador. Un pedido de otro cliente devuelve null, no un error.
            var result = await UiOps.RunAsync(() => PortalClienteSvc.GetPedidoClienteDetalleAsync(GetCurrentCodigoCliente(), IdComprobante),
                "No se pudo cargar el pedido.");

            _pedido = result.Success ? result.Value : null;
            if (_pedido is not null)
            {
                try { _empresa = await ConfiguracionSvc.GetEmpresaAsync(); }
                catch { _empresa = new ConfiguracionEmpresaDto(); }
                _comprobante = new PortalClienteComprobantePendienteDetalleDto
                {
                    IdComprobante = _pedido.IdComprobante,
                    Tc = _pedido.Tc,
                    TcDescripcion = "Nota de pedido",
                    IdComprobanteTexto = _pedido.IdComprobanteTexto,
                    Fecha = _pedido.Fecha,
                    CodigoCliente = _pedido.CodigoCliente,
                    RazonSocial = _pedido.RazonSocial,
                    ImporteOriginal = _pedido.Total,
                    ImporteSinIva = _pedido.Total,
                    Lineas = _pedido.Lineas.Select(x => new PortalClienteComprobanteLineaDto
                    {
                        IdArticulo = x.IdArticulo, Descripcion = x.Descripcion, Cantidad = x.Cantidad,
                        PrecioUnitario = x.PrecioUnitario, Subtotal = x.Subtotal
                    }).ToList()
                };
                try
                {
                    var documento = await DocumentoSvc.RenderNotaPedidoAsync(_pedido.IdComprobante, null);
                    _documentoHtml = documento.Html;
                }
                catch
                {
                    // Si una instalación todavía no tiene plantilla de NP, se conserva la vista
                    // segura anterior como fallback.
                    _documentoHtml = null;
                }
            }
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string Money(decimal value)
        => value.ToString("C2", CultureEsAr);

    private Task ImprimirAsync()
        => Js.InvokeVoidAsync("print").AsTask();
}
