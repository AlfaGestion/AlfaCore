@page "/portal-cliente/cuenta-corriente"
@page "/{idweb}/{idbase:int}/portal-cliente/cuenta-corriente"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits PortalClientePageBase
@using AlfaCore.Models
@using AlfaCore.Components.Shared
@using AlfaCore.Components.Shared.AlfaDesign
@inject AlfaCore.Services.IPortalClienteService PortalClienteSvc

<PageTitle>Cuenta corriente | Portal Cliente</PageTitle>

@if (NotFound)
{
    <section class="page-grid portal-cliente">
        <section class="panel-card empty-state">
            <h3 class="panel-card__title">Base no disponible</h3>
            <p class="panel-card__subtitle">No se pudo resolver la base asociada a esta URL. Probá nuevamente desde el enlace correcto.</p>
        </section>
    </section>
}
else if (!IsAuthenticated)
{
    <CatalogoClienteLoginPanel @ref="_loginPanel"
                                CatalogoNombre="Portal Cliente"
                                BrandLogoUrl="@GetBrandingLogoUrl()"
                                BrandName="@GetBrandingName()"
                                IdWeb="@idweb"
                                IdBase="@idbase"
                                Codigo="@ClienteCodigo"
                                CodigoChanged="v => ClienteCodigo = v"
                                Password="@ClientePassword"
                                PasswordChanged="v => ClientePassword = v"
                                ShowPassword="@ShowPassword"
                                ShowPasswordChanged="v => ShowPassword = v"
                                Busy="@SessionBusy"
                                Feedback="@LoginFeedback"
                                OnSubmit="LoginClienteAsync"
                                VolverUrl="/"
                                VolverTexto="Volver" />
}
else
{
    <section class="page-grid portal-cliente portal-cliente--detail portal-cliente--ctacte">
        <PortalClienteHeader BrandLogoUrl="@GetBrandingLogoUrl()"
                              BrandName="@GetBrandingName()"
                              LogoFrameClass="@GetBrandingLogoFrameClass()"
                              ClientLabel="@GetCurrentClientLabel()"
                              Busy="@SessionBusy"
                              OnLogout="LogoutClienteAsync"
                              ActiveTab="cuenta-corriente"
                              RouteInicio="@BuildPortalRoute("")"
                              RouteCuentaCorriente="@BuildPortalRoute("cuenta-corriente")"
                              RouteListaPrecios="@BuildPortalRoute("lista-precios")"
                              RouteCatalogos="@BuildPortalRoute("catalogos")"
                              RouteCarrito="@BuildPortalRoute("carrito")"
                              RoutePedidos="@BuildPortalRoute("pedidos")"
                              RouteMiCuenta="@BuildPortalRoute("mi-cuenta")" />

        @if (_feedback is not null)
        {
            <div class="editor-msg editor-msg--warning portal-cliente__feedback">
                <div><p>@_feedback</p></div>
            </div>
        }

        <h2 class="portal-cliente__page-heading">Cuenta Corriente</h2>

        <section class="portal-cliente__summary-grid" aria-label="Resumen de cuenta corriente">
            <article class="portal-cliente__summary-card">
                <span>Saldo actual</span>
                <strong>@Money(_resumen.SaldoTotal)</strong>
            </article>
            <article class="portal-cliente__summary-card portal-cliente__summary-card--danger">
                <span>Vencido</span>
                <strong>@Money(_resumen.Vencido)</strong>
            </article>
            <article class="portal-cliente__summary-card">
                <span>A vencer</span>
                <strong>@Money(_resumen.AVencer)</strong>
            </article>
            <article class="portal-cliente__summary-card">
                <span>Pendientes</span>
                <strong>@_resumen.CantidadPendientes</strong>
            </article>
        </section>

        <section class="portal-cliente__section">
            <div class="portal-cliente__ctacte-toolbar">
                <AlfaSelect Label="Rango"
                            Value="@_rango"
                            ValueChanged="SetRangoAsync"
                            Options="@RangoOptions"
                            Class="portal-cliente__filter-field portal-cliente__ctacte-field" />
                <AlfaInput Label="Desde"
                           Type="date"
                           Value="@EstadoFechaDesdeTexto"
                           ValueChanged="SetEstadoFechaDesdeAsync"
                           Class="portal-cliente__filter-field portal-cliente__ctacte-field" />
                <AlfaInput Label="Hasta"
                           Type="date"
                           Value="@EstadoFechaHastaTexto"
                           ValueChanged="SetEstadoFechaHastaAsync"
                           Class="portal-cliente__filter-field portal-cliente__ctacte-field" />
                <AlfaInput Label="Cuenta"
                           Value="@GetCurrentCodigoCliente()"
                           Disabled="true"
                           Class="portal-cliente__filter-field portal-cliente__ctacte-field portal-cliente__ctacte-field--cuenta" />
                <AlfaCheckbox Value="@_ocultarSaldoCero" ValueChanged="SetOcultarSaldoCeroAsync" Class="portal-cliente__ctacte-checkbox">
                    Ocultar saldo 0
                </AlfaCheckbox>
                <AlfaButton Variant="AlfaButtonVariant.Primary"
                            Size="AlfaSize.Sm"
                            Disabled="@_loadingEstado"
                            OnClick="@(_ => ConsultarEstadoCuentaAsync())"
                            Class="portal-cliente__ctacte-submit">
                    Consultar
                </AlfaButton>
            </div>

            @if (_loadingEstado)
            {
                <div class="portal-cliente__loading-state">
                    <p class="text-muted">Cargando cuenta corriente...</p>
                </div>
            }
            else if (_estadoCuenta.Movimientos.Count == 0)
            {
                <div class="portal-cliente__empty-panel">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoData"
                                    Title="No hay movimientos para el rango seleccionado."
                                    Message="Probá ajustar el rango de fechas o quitar el filtro de saldo 0."
                                    Class="portal-cliente__empty-state" />
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table portal-cliente__ctacte-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Comprobante</th>
                                <th>Descripción</th>
                                <th>Vencimiento</th>
                                <th class="text-end">Importe</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mov in _estadoCuenta.Movimientos)
                            {
                                <tr>
                                    <td data-label="Fecha">@mov.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td data-label="Comprobante">@mov.Comprobante</td>
                                    <td data-label="Descripción">@mov.Detalle</td>
                                    <td data-label="Vencimiento">@(mov.Vencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td data-label="Importe" class="text-end">@Money(mov.Importe)</td>
                                    <td data-label="Estado">
                                        <AlfaTag Tone="@GetEstadoTono(mov.Estado)">@mov.Estado</AlfaTag>
                                    </td>
                                    <td data-label="Acciones">
                                        @if (mov.IdComprobante is { } idComprobante)
                                        {
                                            <a class="btn btn--ghost btn--sm" href="@BuildPortalRoute($"cuenta-corriente/{idComprobante}")">
                                                <i class="bi bi-eye"></i> Ver comprobante
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>
}

@code {
    private CatalogoClienteLoginPanel? _loginPanel;
    private string? _feedback;
    private PortalClienteCuentaCorrienteResumenDto _resumen = new();

    private bool _loadingEstado;
    private string _rango = "mes-actual";
    private DateTime? _estadoFechaDesde;
    private DateTime? _estadoFechaHasta;
    private bool _ocultarSaldoCero;
    private PortalClienteEstadoCuentaDto _estadoCuenta = new();

    private static readonly IReadOnlyList<AlfaSelectOption> RangoOptions =
    [
        new AlfaSelectOption("mes-actual", "Mes actual"),
        new AlfaSelectOption("mes-anterior", "Mes anterior"),
        new AlfaSelectOption("ultimos-30-dias", "Últimos 30 días"),
        new AlfaSelectOption("ultimos-3-meses", "Últimos 3 meses"),
        new AlfaSelectOption("anio-actual", "Año actual"),
        new AlfaSelectOption("todo", "Todo"),
        new AlfaSelectOption("personalizado", "Personalizado")
    ];

    protected override async Task OnAfterClientSessionRestoredAsync()
    {
        if (_loginPanel is not null)
        {
            try { await _loginPanel.FocusCodigoAsync(); }
            catch { }
        }

        if (IsAuthenticated)
        {
            await CargarTodoAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterLoginAsync()
        => await CargarTodoAsync();

    private async Task CargarTodoAsync()
    {
        AplicarRango(_rango);
        await Task.WhenAll(CargarResumenAsync(), ConsultarEstadoCuentaAsync());
    }

    private async Task CargarResumenAsync()
    {
        _feedback = null;

        var result = await UiOps.RunAsync(() => PortalClienteSvc.GetResumenCuentaCorrienteAsync(GetCurrentCodigoCliente()),
            "No pudimos consultar tu cuenta corriente en este momento.");

        if (result.Success && result.Value is not null)
            _resumen = result.Value;
        else
            _feedback = result.Feedback?.Message ?? "No pudimos consultar tu cuenta corriente en este momento.";

        await InvokeAsync(StateHasChanged);
    }

    private string EstadoFechaDesdeTexto
        => _estadoFechaDesde?.ToString("yyyy-MM-dd") ?? string.Empty;

    private string EstadoFechaHastaTexto
        => _estadoFechaHasta?.ToString("yyyy-MM-dd") ?? string.Empty;

    private Task SetEstadoFechaDesdeAsync(string? value)
    {
        _estadoFechaDesde = ParseDate(value);
        _rango = "personalizado";
        return Task.CompletedTask;
    }

    private Task SetEstadoFechaHastaAsync(string? value)
    {
        _estadoFechaHasta = ParseDate(value);
        _rango = "personalizado";
        return Task.CompletedTask;
    }

    private Task SetOcultarSaldoCeroAsync(bool? value)
    {
        _ocultarSaldoCero = value ?? false;
        return Task.CompletedTask;
    }

    private Task SetRangoAsync(string? value)
    {
        AplicarRango(value);
        return ConsultarEstadoCuentaAsync();
    }

    private void AplicarRango(string? rango)
    {
        _rango = string.IsNullOrWhiteSpace(rango) ? "personalizado" : rango;
        var hoy = DateTime.Today;

        switch (_rango)
        {
            case "mes-actual":
                _estadoFechaDesde = new DateTime(hoy.Year, hoy.Month, 1);
                _estadoFechaHasta = _estadoFechaDesde.Value.AddMonths(1).AddDays(-1);
                break;
            case "mes-anterior":
                var inicioMesActual = new DateTime(hoy.Year, hoy.Month, 1);
                _estadoFechaDesde = inicioMesActual.AddMonths(-1);
                _estadoFechaHasta = inicioMesActual.AddDays(-1);
                break;
            case "ultimos-30-dias":
                _estadoFechaDesde = hoy.AddDays(-29);
                _estadoFechaHasta = hoy;
                break;
            case "ultimos-3-meses":
                _estadoFechaDesde = hoy.AddMonths(-3).AddDays(1);
                _estadoFechaHasta = hoy;
                break;
            case "anio-actual":
                _estadoFechaDesde = new DateTime(hoy.Year, 1, 1);
                _estadoFechaHasta = new DateTime(hoy.Year, 12, 31);
                break;
            case "todo":
                _estadoFechaDesde = null;
                _estadoFechaHasta = null;
                break;
            default:
                break;
        }
    }

    private async Task ConsultarEstadoCuentaAsync()
    {
        _loadingEstado = true;
        _feedback = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await UiOps.RunAsync(() => PortalClienteSvc.GetEstadoCuentaAsync(new PortalClienteEstadoCuentaFiltroDto
            {
                CodigoCliente = GetCurrentCodigoCliente(),
                FechaDesde = _estadoFechaDesde,
                FechaHasta = _estadoFechaHasta,
                OcultarSaldoCero = _ocultarSaldoCero
            }), "No pudimos consultar tu cuenta corriente en este momento.");

            if (result.Success && result.Value is not null)
                _estadoCuenta = result.Value;
            else
                _feedback = result.Feedback?.Message ?? "No pudimos consultar tu cuenta corriente en este momento.";
        }
        finally
        {
            _loadingEstado = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static AlfaTagTone GetEstadoTono(string estado)
        => estado switch
        {
            "Vencido" => AlfaTagTone.Danger,
            "Pagado" => AlfaTagTone.Neutral,
            _ => AlfaTagTone.Warning
        };

    private static string Money(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    private static DateTime? ParseDate(string? value)
        => DateTime.TryParse(value, out var parsed) ? parsed.Date : null;
}
