    private bool TryOpenPendingUserCleanup(string action, string? targetId = null)
    {
        if (string.IsNullOrEmpty(_pendingCreatedUserName))
            return false;

        var name = _pendingCreatedUserName;
        _pendingCreatedUserName = string.Empty;
        _pendingCleanupUserName = name;
        _pendingCleanupAction = action;
        _pendingCleanupTargetId = targetId ?? string.Empty;
        _showPendingUserCleanupConfirm = true;
        _ = InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task ResolvePendingUserCleanupAsync(bool deactivate)
    {
        var name = _pendingCleanupUserName;
        var action = _pendingCleanupAction;
        var targetId = _pendingCleanupTargetId;

        _showPendingUserCleanupConfirm = false;
        _pendingCleanupUserName = string.Empty;
        _pendingCleanupAction = string.Empty;
        _pendingCleanupTargetId = string.Empty;

        if (deactivate && !string.IsNullOrWhiteSpace(name))
        {
            await UiOps.RunAsync(() => UsuariosSvc.DeactivateAsync(name), "No se pudo desactivar el usuario.");
            await RecargarUsuariosAsync();
        }

        switch (action)
        {
            case "begin-new":
                await BeginNewCoreAsync();
                break;
            case "close-editor":
                CloseEditorCore();
                break;
            case "open-editor":
                await OpenEditorCoreAsync(targetId);
                break;
        }
    }

    private async Task CrearUsuarioDesdeModalAsync()
    {
        _modalErrors.Clear();

        if (string.IsNullOrWhiteSpace(_modalNombre))
        {
            _modalErrors["nombre"] = "El nombre de usuario es obligatorio.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_modalClave))
        {
            _modalErrors["clave"] = "La contraseña es obligatoria.";
            return;
        }
        if (_modalClave != _modalConfirmacion)
        {
            _modalErrors["confirmacion"] = "La confirmación no coincide con la contraseña.";
            return;
        }

        _modalSaving = true;
        try
        {
            var request = new UsuarioSaveRequest
            {
                NombreOriginal        = string.Empty,
                Nombre                = _modalNombre.Trim(),
                Email                 = _modalEmail.Trim(),
                Contrasena            = _modalClave,
                EsGrupo               = false,
                CambiarProximoInicio  = false
            };

            try
            {
                await UsuariosSvc.SaveAsync(request);
                var nombreCreado = _modalNombre.Trim();
                CerrarModalCrearUsuario();
                await RecargarUsuariosAsync();
                _form.UsuarioAsociado   = nombreCreado;
                _pendingCreatedUserName = nombreCreado;
                _editorUserCreatedNote  = $"El usuario '{nombreCreado}' fue creado y asociado al técnico. Recordá asignarle permisos en Seguridad → Autorización de tareas.";
                SetFeedback(AppUiMessage.Success("Usuario creado", $"El usuario {nombreCreado} quedó seleccionado. Guardá el técnico para completar la asociación."));
            }
            catch (AppValidationException validationEx)
            {
                foreach (var issue in validationEx.Validation.Issues.Where(i => !string.IsNullOrWhiteSpace(i.FieldKey)))
                {
                    var key = issue.FieldKey.Trim();
                    if (string.Equals(key, "contrasena", StringComparison.OrdinalIgnoreCase))
                        key = "clave";
                    _modalErrors[key] = issue.Message;
                }
                if (_modalErrors.Count == 0)
                    _modalErrors["general"] = validationEx.UserMessage;
            }
            catch (Exception ex)
            {
                var msg = UiOps.BuildMessage(ex, "No se pudo crear el usuario.");
                _modalErrors["general"] = msg?.Message ?? "No se pudo crear el usuario.";
            }
        }
        finally
        {
            _modalSaving = false;
        }
    }

    // ── Configurar vista ──────────────────────────────────────────────────────

    private async Task EnsureViewSettingsLoadedAsync(bool force = false)
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (!force && _viewSettingsLoaded && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            ApplyViewSettings(BuildDefaultViewSettings(), string.Empty);
            return;
        }

        var result = await UiOps.RunAsync(
            () => TecnicosSvc.GetViewSettingsAsync(currentUser),
            "No se pudo cargar la configuración de vista.");

        ApplyViewSettings(result.Success && result.Value is not null ? result.Value : BuildDefaultViewSettings(), currentUser);
    }

    private void AbrirConfiguracionVista()
    {
        _showViewSettings = true;
        _draftAgruparPor  = _viewSettings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
    }

    private void CancelarConfiguracionVista()
    {
        _showViewSettings = false;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
    }

    private void SetDraftGrouping(string? value)
        => _draftAgruparPor = value ?? TecnicosViewGroupKeys.None;

    private void SetViewColumnVisibility(string key, bool? value)
    {
        var column = _viewSettingsDraft.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null)
            return;

        column.Visible = value is true;
        if (!_viewSettingsDraft.Any(c => c.Visible))
            column.Visible = true;
    }

    private void ToggleViewColumn(string key, ChangeEventArgs args)
    {
        var column = _viewSettingsDraft.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null) return;
        column.Visible = args.Value is bool flag && flag;
        if (!_viewSettingsDraft.Any(c => c.Visible))
            column.Visible = true;
    }

    private void MoveViewColumn(string key, int offset)
    {
        var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
        var index   = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        var target = index + offset;
        if (target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(ordered);
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        if (_savingViewSettings)
            return;

        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title    = "Sesión requerida",
                Message  = "Necesitás iniciar sesión para guardar la configuración de vista."
            });
            return;
        }

        _savingViewSettings = true;
        try
        {
            var settings = new TecnicosViewSettingsDto
            {
                AgruparPor = _draftAgruparPor,
                Columnas   = CloneColumns(_viewSettingsDraft)
            };

            var result = await UiOps.RunAsync(async () =>
            {
                await TecnicosSvc.SaveViewSettingsAsync(currentUser, settings);
                return true;
            }, "No se pudo guardar la configuración de vista.");

            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            ApplyViewSettings(settings, currentUser);
            _showViewSettings = false;
            SetFeedback(AppUiMessage.Success("Vista guardada", "La configuración de la grilla quedó actualizada para tu usuario."));
        }
        finally
        {
            _savingViewSettings = false;
        }
    }

    private void ApplyViewSettings(TecnicosViewSettingsDto settings, string userName)
    {
        _viewSettings        = settings;
        _viewSettingsUserName = userName;
        _viewSettingsLoaded  = true;
        _draftAgruparPor     = settings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(settings.Columnas));
    }

    private void OnAppUserSessionChanged()
        => _ = InvokeAsync(async () =>
        {
            await EnsureViewSettingsLoadedAsync(force: true);
            StateHasChanged();
        });

