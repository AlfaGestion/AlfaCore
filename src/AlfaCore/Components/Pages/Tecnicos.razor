@page "/tecnicos"
@page "/{idweb}/{idbase:int}/tecnicos"
@using AlfaCore.Models
@using AlfaCore.Services
@inject AlfaCore.Services.ITecnicosService TecnicosSvc
@inject AlfaCore.Services.IUsuariosService UsuariosSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject IRouteContextService RouteContext
@inject IPageHeaderService PageHeader
@implements IDisposable

<PageTitle>Técnicos | Alfa Gestión</PageTitle>

<div class="@(_showEditor ? "tecnicos-page tecnicos-page--editor" : "tecnicos-page tecnicos-page--list")" @onclick="HandlePageClickAsync">


    <!-- ── Feedback ────────────────────────────────────────────────────── -->
    <AlfaNotification Message="@_feedback" OnDismiss="ClearFeedback" />

    <!-- ── Configurar vista ────────────────────────────────────────────── -->
    <AlfaDialog Open="@(_showViewSettings && !_showEditor)"
                Title="Configurar vista"
                Eyebrow="Listado de técnicos"
                Description="Elegí las columnas visibles, su orden y la agrupación de la grilla."
                Size="AlfaDialogSize.Md"
                Loading="@_savingViewSettings"
                OnClose="CancelarConfiguracionVista">
        <ChildContent>
            <div class="tecnicos-view-settings">
                <AlfaSelect Label="Agrupar por"
                            Value="@_draftAgruparPor"
                            ValueChanged="SetDraftGrouping"
                            Options="@ViewGroupingOptions"
                            Disabled="@_savingViewSettings" />

                <div class="tecnicos-view-settings__list" aria-label="Columnas del listado">
                    @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        var orderedColumns = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
                        var columnIndex = orderedColumns.FindIndex(item => string.Equals(item.Key, column.Key, StringComparison.OrdinalIgnoreCase));
                        <div class="tecnicos-view-settings__item">
                            <AlfaCheckbox Value="@column.Visible"
                                          ValueChanged="value => SetViewColumnVisibility(column.Key, value)"
                                          Disabled="@_savingViewSettings">
                                @column.Label
                            </AlfaCheckbox>
                            <div class="tecnicos-view-settings__order" aria-label="Ordenar @column.Label">
                                <AlfaIconButton Icon="bi bi-arrow-up"
                                                Label="@($"Subir {column.Label}")"
                                                Size="AlfaSize.Sm"
                                                Disabled="@(_savingViewSettings || columnIndex <= 0)"
                                                OnClick="_ => MoveViewColumn(column.Key, -1)" />
                                <AlfaIconButton Icon="bi bi-arrow-down"
                                                Label="@($"Bajar {column.Label}")"
                                                Size="AlfaSize.Sm"
                                                Disabled="@(_savingViewSettings || columnIndex == orderedColumns.Count - 1)"
                                                OnClick="_ => MoveViewColumn(column.Key, 1)" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </ChildContent>
        <Footer>
            <AlfaButton Variant="AlfaButtonVariant.Ghost"
                        Disabled="@_savingViewSettings"
                        OnClick="_ => CancelarConfiguracionVista()">Cancelar</AlfaButton>
            <AlfaButton Variant="AlfaButtonVariant.Primary"
                        Icon="bi bi-floppy"
                        Loading="@_savingViewSettings"
                        OnClick="_ => GuardarConfiguracionVistaAsync()">Guardar vista</AlfaButton>
        </Footer>
    </AlfaDialog>

    <!-- ── Editor ──────────────────────────────────────────────────────── -->
    @if (_showEditor)
    {
        <TecnicosEditView Model="@_form"
                          CreateMode="@_isNewMode"
                          Active="@_selectedActivo"
                          Saving="@_saving"
                          CostPerHour="@_costoHoraStr"
                          CostPerHourChanged="SetCostPerHour"
                          Provinces="@_estados"
                          Users="@_usuarios"
                          FieldErrors="@_fieldErrors"
                          UserCreatedNote="@_editorUserCreatedNote"
                          OnReloadUsers="RecargarUsuariosAsync"
                          OnCreateUser="AbrirModalCrearUsuario" />
    }
    else
    {
        <!-- ── Grilla ───────────────────────────────────────────────────────── -->
        var visibleColumns = GetVisibleColumns();
        var groups         = BuildGridGroups();

        <section class="tecnicos-list-shell">
            <header class="tecnicos-list-shell__summary">
                <div>
                    <span class="tecnicos-list-shell__eyebrow">Listado de técnicos</span>
                    <strong>@GetBrowseSummary()</strong>
                </div>
                <AlfaSelect Value="@_filters.PageSize.ToString()"
                            ValueChanged="SetPageSizeAsync"
                            Options="@PageSizeOptions"
                            Disabled="@_loadingList"
                            Class="tecnicos-list-shell__page-size" />
            </header>

            @if (_loadingList)
            {
                <div class="tecnicos-list-shell__state">
                    <AlfaEmptyState Title="Cargando técnicos"
                                    Message="Estamos consultando la base activa con los filtros actuales." />
                </div>
            }
            else if (_listLoadFailed)
            {
                <div class="tecnicos-list-shell__state">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.Error"
                                    Title="No se pudieron cargar los técnicos"
                                    Message="Reintentá la consulta sobre la base activa."
                                    ActionLabel="Reintentar"
                                    ActionIcon="bi bi-arrow-clockwise"
                                    OnAction="_ => BuscarAsync()" />
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="tecnicos-list-shell__state">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults"
                                    Title="No encontramos técnicos"
                                    Message="No hay técnicos para los filtros seleccionados."
                                    ActionLabel="Limpiar filtros"
                                    ActionIcon="bi bi-eraser"
                                    OnAction="_ => LimpiarFiltrosAsync()" />
                </div>
            }
            else
            {
                <div class="tecnicos-list-shell__table-scroll">
                    <table class="tecnicos-list-table" aria-label="Técnicos encontrados">
                        <thead>
                            <tr>
                                @foreach (var column in visibleColumns)
                                {
                                    <th class="@GetTecnicoColumnCssClass(column.Key)">@column.Label</th>
                                }
                                <th class="tecnicos-list-table__actions" aria-label="Acciones">…</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="tecnicos-list-table__group">
                                        <td colspan="@(visibleColumns.Count + 1)">@group.Label</td>
                                    </tr>
                                }

                                @foreach (var item in group.Items)
                                {
                                    <tr class="@GetTecnicoRowClass(item)"
                                        @onclick="() => SeleccionarFila(item.IdTecnico)"
                                        @ondblclick="() => AbrirEditorAsync(item.IdTecnico)">
                                        @foreach (var column in visibleColumns)
                                        {
                                            <td class="@GetTecnicoColumnCssClass(column.Key)">
                                                @switch (column.Key)
                                                {
                                                    case TecnicosViewColumnKeys.IdTecnico:
                                                        <span class="tecnicos-list-table__code">@item.IdTecnico</span>
                                                        break;
                                                    case TecnicosViewColumnKeys.Nombre:
                                                        <strong>@item.Nombre</strong>
                                                        break;
                                                    case TecnicosViewColumnKeys.Cargo:
                                                        @item.Cargo
                                                        break;
                                                    case TecnicosViewColumnKeys.Localidad:
                                                        @(string.IsNullOrWhiteSpace(item.Localidad) ? "—" : item.Localidad)
                                                        break;
                                                    case TecnicosViewColumnKeys.Telefono:
                                                        @(string.IsNullOrWhiteSpace(item.Telefono) ? "—" : item.Telefono)
                                                        break;
                                                    case TecnicosViewColumnKeys.CostoHora:
                                                        <span class="tecnicos-list-table__money">@FormatMoney(item.CostoHora)</span>
                                                        break;
                                                    case TecnicosViewColumnKeys.OcultarCliente:
                                                        <AlfaTag Tone="@(item.OcultarCliente ? AlfaTagTone.Warning : AlfaTagTone.Neutral)">@(item.OcultarCliente ? "Sí" : "No")</AlfaTag>
                                                        break;
                                                    case TecnicosViewColumnKeys.UsuarioAsociado:
                                                        @(string.IsNullOrWhiteSpace(item.UsuarioAsociado) ? "—" : item.UsuarioAsociado)
                                                        break;
                                                    case TecnicosViewColumnKeys.Activo:
                                                        <AlfaTag Tone="@(item.Baja ? AlfaTagTone.Neutral : AlfaTagTone.Success)">@(item.Baja ? "Inactivo" : "Activo")</AlfaTag>
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td class="tecnicos-list-table__actions" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
                                            <AlfaActionMenu Items="@BuildTecnicoActionMenu(item)"
                                                            TriggerLabel="@($"Acciones de {item.Nombre}")"
                                                            MenuLabel="@($"Acciones de {item.Nombre}")"
                                                            Align="AlfaActionMenuAlign.End" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>

            }
        </section>
    }

    <AlfaConfirmDialog Open="@_showBrowseDeactivateConfirm"
                       Title="Dar de baja técnico"
                       Message="@($"“{_browseDeactivateTargetName}” dejará de estar activo.")"
                       SecondaryMessage="La baja es lógica: el registro quedará inactivo."
                       ConfirmLabel="Dar de baja"
                       LoadingLabel="Procesando..."
                       Loading="@_saving"
                       OnConfirm="ConfirmBrowseDeactivateAsync"
                       OnCancel="CloseBrowseDeactivateConfirm" />

</div>

<!-- ── Dialog: Crear usuario ─────────────────────────────────────────────── -->
<AlfaDialog Open="@_showCrearUsuarioModal"
            Title="Crear usuario del sistema"
            Eyebrow="Técnico"
            Description="El usuario se creará con acceso básico y quedará asociado al formulario actual."
            ErrorMessage="@GetModalError("general")"
            Size="AlfaDialogSize.Sm"
            Loading="@_modalSaving"
            OnClose="CerrarModalCrearUsuario">
    <ChildContent>
        <div class="tecnicos-user-dialog">
            <div class="tecnicos-user-dialog__notice">
                <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                <div>
                    <strong>Recordá asignar permisos</strong>
                    <p>Después de crear el usuario, asignale las opciones del menú en Seguridad → Autorización de tareas.</p>
                </div>
            </div>

            <AlfaInput Label="Nombre de usuario"
                       Required
                       MaxLength="50"
                       Placeholder="Nombre de usuario del sistema"
                       Value="@_modalNombre"
                       ValueChanged="SetModalName"
                       ErrorText="@GetModalError("nombre")"
                       Disabled="@_modalSaving" />
            <AlfaInput Label="Email"
                       Type="email"
                       MaxLength="200"
                       Placeholder="correo@ejemplo.com"
                       Value="@_modalEmail"
                       ValueChanged="SetModalEmail"
                       ErrorText="@GetModalError("email")"
                       Disabled="@_modalSaving" />
            <div class="tecnicos-user-dialog__password">
                <AlfaInput Label="Contraseña"
                           Required
                           Type="@(_modalShowClave ? "text" : "password")"
                           MaxLength="13"
                           Placeholder="Contraseña"
                           Value="@_modalClave"
                           ValueChanged="SetModalPassword"
                           ErrorText="@GetModalError("clave")"
                           Disabled="@_modalSaving" />
                <AlfaIconButton Icon="@($"bi {(_modalShowClave ? "bi-eye-slash" : "bi-eye")}")"
                                Label="@(_modalShowClave ? "Ocultar contraseña" : "Mostrar contraseña")"
                                Active="@_modalShowClave"
                                Disabled="@_modalSaving"
                                OnClick="_ => ToggleModalPassword()" />
            </div>
            <AlfaInput Label="Confirmación"
                       Required
                       Type="@(_modalShowClave ? "text" : "password")"
                       MaxLength="13"
                       Placeholder="Repetí la contraseña"
                       Value="@_modalConfirmacion"
                       ValueChanged="SetModalConfirmation"
                       ErrorText="@GetModalError("confirmacion")"
                       Disabled="@_modalSaving" />
        </div>
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Ghost"
                    Disabled="@_modalSaving"
                    OnClick="_ => CerrarModalCrearUsuario()">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary"
                    Icon="bi bi-person-plus"
                    Loading="@_modalSaving"
                    OnClick="_ => CrearUsuarioDesdeModalAsync()">Crear usuario</AlfaButton>
    </Footer>
</AlfaDialog>

<AlfaConfirmDialog Open="@_showDeactivateConfirm"
                   Title="Dar de baja técnico"
                   Message="@($"“{_form.Nombre}” dejará de estar activo.")"
                   SecondaryMessage="La baja es lógica y no reactiva registros automáticamente."
                   ConfirmLabel="Dar de baja"
                   LoadingLabel="Procesando..."
                   Loading="@_saving"
                   OnConfirm="ConfirmDeactivateAsync"
                   OnCancel="CloseDeactivateConfirm" />

<AlfaConfirmDialog Open="@_showPendingUserCleanupConfirm"
                   Title="Usuario sin técnico guardado"
                   Message="@($"Se creó el usuario “{_pendingCleanupUserName}”, pero el técnico todavía no fue guardado.")"
                   SecondaryMessage="Podés desactivar el usuario para evitar dejar un acceso pendiente, o mantenerlo y continuar."
                   ConfirmLabel="Desactivar usuario"
                   CancelLabel="Mantener usuario"
                   LoadingLabel="Desactivando..."
                   OnConfirm="() => ResolvePendingUserCleanupAsync(true)"
                   OnCancel="() => ResolvePendingUserCleanupAsync(false)" />

@code {
    // ── Estado de lista ──────────────────────────────────────────────────────
    private readonly TecnicosFilters          _filters          = new();
    private readonly List<TecnicoGridItemDto> _items            = [];
    private readonly List<TecnicoViewColumnDto> _viewSettingsDraft = [];
    private readonly Dictionary<string, string> _fieldErrors    = new(StringComparer.OrdinalIgnoreCase);
    private AppUiMessage?         _feedback;
    private TecnicosViewSettingsDto _viewSettings             = BuildDefaultViewSettings();
    private bool _loadingList;
    private bool _listLoadFailed;
    private bool _saving;
    private bool _showEditor;
    private bool _showViewSettings;
    private bool _showSearchPanel;
    private bool _showDeactivateConfirm;
    private bool _showBrowseDeactivateConfirm;
    private bool _viewSettingsLoaded;
    private bool _savingViewSettings;
    private int  _pagedTotal;
    private int  _pageNumber  = 1;
    private int  _totalPages  = 1;
    private bool _hasPrev;
    private bool _hasNext;
    private string _selectedIdTecnico = string.Empty;
    private string _activoFiltro      = "1";
    private string _draftAgruparPor   = TecnicosViewGroupKeys.None;
    private string _viewSettingsUserName = string.Empty;
    private string _browseDeactivateTargetId = string.Empty;
    private string _browseDeactivateTargetName = string.Empty;

    private static readonly IReadOnlyList<AlfaSelectOption> ViewGroupingOptions =
    [
        new(TecnicosViewGroupKeys.None, "Sin agrupar"),
        new(TecnicosViewGroupKeys.Cargo, "Cargo"),
        new(TecnicosViewGroupKeys.OcultarCliente, "Ocultar cliente"),
        new(TecnicosViewGroupKeys.Activo, "Activo")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> PageSizeOptions =
    [
        new("25", "25 por página"),
        new("50", "50 por página"),
        new("100", "100 por página")
    ];

    // ── Estado de editor ─────────────────────────────────────────────────────
    private readonly TecnicoSaveRequest _form = new();
    private bool   _isNewMode    = true;
    private bool   _selectedActivo = true;
    private string _costoHoraStr = string.Empty;

    // ── Modal crear usuario ───────────────────────────────────────────────────
    private bool   _showCrearUsuarioModal;
    private bool   _modalSaving;
    private bool   _modalShowClave;
    private string _modalNombre           = string.Empty;
    private string _modalEmail            = string.Empty;
    private string _modalClave            = string.Empty;
    private string _modalConfirmacion     = string.Empty;
    private string _editorUserCreatedNote = string.Empty;
    private string _pendingCreatedUserName = string.Empty;
    private bool _showPendingUserCleanupConfirm;
    private string _pendingCleanupUserName = string.Empty;
    private string _pendingCleanupAction = string.Empty;
    private string _pendingCleanupTargetId = string.Empty;
    private readonly Dictionary<string, string> _modalErrors = new(StringComparer.OrdinalIgnoreCase);

    // ── Datos de combos ───────────────────────────────────────────────────────
    private IReadOnlyList<EstadoItemDto> _estados   = [];
    private IReadOnlyList<string>        _usuarios  = [];

    // ── Ciclo de vida ─────────────────────────────────────────────────────────

    private RenderFragment RenderTecnicosSmartSearch() => @<div class="smart-search" @onclick:stopPropagation @onkeydown="HandleApplyKeyDownAsync">
        @{ var activeChips = BuildFilterChips(); }
        <div class="smart-search__bar @(_showSearchPanel ? "is-open" : string.Empty)">
            <span class="smart-search__search-icon" aria-hidden="true">
                <i class="bi bi-search"></i>
            </span>
            <button type="button"
                    class="smart-search__filter-button @(_showSearchPanel || activeChips.Count > 0 ? "is-active" : string.Empty)"
                    title="Abrir filtros"
                    aria-label="Abrir filtros"
                    aria-expanded="@_showSearchPanel"
                    @onclick="ToggleSearchPanel">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
            </button>
            <div class="smart-search__active-filters" aria-label="Filtros activos">
                @foreach (var chip in activeChips.Take(2))
                {
                    <button type="button"
                            class="smart-search__active-filter"
                            title="@($"Quitar filtro {chip.Label}")"
                            aria-label="@($"Quitar filtro {chip.Label}")"
                            @onclick="() => RemoveChipAsync(chip.Key)">
                        <span>@chip.Label</span>
                        <span class="smart-search__active-filter-remove" aria-hidden="true"><i class="bi bi-x"></i></span>
                    </button>
                }
            </div>
            <input type="search"
                   placeholder="Buscar por código, nombre, teléfono, cargo o usuario asociado..."
                   value="@_filters.Texto"
                   @onfocus="OpenSearchPanel"
                   @oninput="OnSearchInputAsync"
                   @onkeydown="HandleApplyKeyDownAsync" />
            <button type="button" class="smart-search__toggle" @onclick="ToggleSearchPanel" aria-label="Mostrar filtros" aria-expanded="@_showSearchPanel">
                <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_showSearchPanel)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CloseSearchPanel"></button>
            <div class="smart-search__panel" @onclick:stopPropagation @onkeydown="HandleApplyKeyDownAsync">
                <div class="smart-search__column">
                    <h4><i class="bi bi-funnel-fill"></i> Estado</h4>
                    <button type="button" class="@GetSmartOptionClass(_activoFiltro == "1")" @onclick='() => SetStatusFilterAsync("1")'>Activos</button>
                    <button type="button" class="@GetSmartOptionClass(_activoFiltro == "0")" @onclick='() => SetStatusFilterAsync("0")'>Dados de baja</button>
                    <button type="button" class="@GetSmartOptionClass(string.IsNullOrWhiteSpace(_activoFiltro))" @onclick='() => SetStatusFilterAsync("")'>Todos</button>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-stack"></i> Agrupar por</h4>
                    <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == TecnicosViewGroupKeys.None)"          @onclick='() => SetGroupAsync(TecnicosViewGroupKeys.None)'>Sin agrupar</button>
                    <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == TecnicosViewGroupKeys.Cargo)"         @onclick='() => SetGroupAsync(TecnicosViewGroupKeys.Cargo)'>Cargo</button>
                    <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == TecnicosViewGroupKeys.OcultarCliente)" @onclick='() => SetGroupAsync(TecnicosViewGroupKeys.OcultarCliente)'>Ocultar cliente</button>
                    <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == TecnicosViewGroupKeys.Activo)"        @onclick='() => SetGroupAsync(TecnicosViewGroupKeys.Activo)'>Estado</button>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-lightning-charge-fill"></i> Acciones</h4>
                    <div class="actions">
                        <AlfaButton Variant="AlfaButtonVariant.Primary"
                                    Size="AlfaSize.Sm"
                                    Icon="bi bi-search"
                                    Disabled="@_loadingList"
                                    OnClick="_ => AplicarFiltrosAsync()">Aplicar</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost"
                                    Size="AlfaSize.Sm"
                                    Icon="bi bi-eraser"
                                    Disabled="@_loadingList"
                                    OnClick="_ => LimpiarFiltrosAsync()">Limpiar</AlfaButton>
                    </div>
                </div>
            </div>
        }
    </div>;

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();

        if (_showEditor)
        {
            actions.Add(new PageHeaderAction { Key = "guardar", Label = _saving ? "Guardando..." : "Guardar", Icon = "bi-floppy", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _saving, Busy = _saving, OnClick = GuardarAsync });
            actions.Add(new PageHeaderAction { Key = "cancelar", Label = "Cancelar", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = _saving, OnClick = CerrarEditor });
            if (!_isNewMode && _selectedActivo)
                actions.Add(new PageHeaderAction { Key = "baja", Label = "Dar de baja", Icon = "bi-person-dash", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow, Disabled = _saving, OnClick = DarDeBajaAsync });
        }
        else
        {
            actions.Add(new PageHeaderAction { Key = "nuevo", Label = "Nuevo técnico", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = BeginNewAsync });
            actions.Add(new PageHeaderAction { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Disabled = _loadingList, OnClick = RecargarAsync });
            actions.Add(new PageHeaderAction { Key = "vista", Label = "Configurar vista", Icon = "bi-sliders", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = () => { AbrirConfiguracionVista(); UpdatePageHeader(); return Task.CompletedTask; } });
            actions.Add(new PageHeaderAction { Key = "agrupar", Label = GetGroupingLabel(_viewSettings.AgruparPor), Icon = "bi-collection", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = ToggleSearchPanelAsync });
        }

        PageHeader.Set(new PageHeaderConfig
        {
            Title = _showEditor ? (_isNewMode ? "Nuevo técnico" : $"Editar {_form.Nombre}") : "Técnicos",
            Breadcrumb = ["Soporte", "Técnicos"],
            State = _saving ? PageHeaderState.Loading : _showEditor ? (_isNewMode ? PageHeaderState.Creating : PageHeaderState.Editing) : PageHeaderState.List,
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = BuildTopNavigationItems(),
            OnBack = null,
            Search = _showEditor
                ? null
                : new PageHeaderSearchConfig(),
            SearchContent = _showEditor ? null : RenderTecnicosSmartSearch(),
            Pagination = _showEditor ? null : BuildHeaderPagination(),
            Actions = actions
        });
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        AppUserSession.StateChanged += OnAppUserSessionChanged;
        UpdatePageHeader();
        await Task.WhenAll(
            EnsureViewSettingsLoadedAsync(),
            CargarCombosAsync(),
            BuscarAsync());
        UpdatePageHeader();
    }

    public void Dispose()
    {
        AppUserSession.StateChanged -= OnAppUserSessionChanged;
        PageHeader.Clear();
    }

    private async Task CargarCombosAsync()
    {
        var estadosResult  = await UiOps.RunAsync(() => TecnicosSvc.GetEstadosAsync(), "No se pudieron cargar las provincias.");
        var usuariosResult = await UiOps.RunAsync(() => TecnicosSvc.GetUsuariosDisponiblesAsync(), "No se pudieron cargar los usuarios.");

        if (estadosResult.Success && estadosResult.Value is not null)
            _estados = estadosResult.Value;

        if (usuariosResult.Success && usuariosResult.Value is not null)
            _usuarios = usuariosResult.Value;
    }

    private async Task RecargarUsuariosAsync()
    {
        var result = await UiOps.RunAsync(() => TecnicosSvc.GetUsuariosDisponiblesAsync(), "No se pudieron cargar los usuarios.");
        if (result.Success && result.Value is not null)
            _usuarios = result.Value;
    }

    // ── Búsqueda y paginación ─────────────────────────────────────────────────

    private async Task RecargarAsync()
    {
        UpdatePageHeader();
        await EnsureViewSettingsLoadedAsync(force: true);
        await BuscarAsync();
        if (!_isNewMode && !string.IsNullOrWhiteSpace(_selectedIdTecnico))
            await CargarEditorAsync(_selectedIdTecnico);
        UpdatePageHeader();
    }

    private async Task AplicarFiltrosAsync()
    {
        _filters.PageNumber = 1;
        await BuscarAsync();
        _showSearchPanel = false;
        UpdatePageHeader();
    }

    private async Task HandleApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            _showSearchPanel = false;
            return;
        }

        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase) || _loadingList)
            return;

        await AplicarFiltrosAsync();
    }

    private async Task BuscarAsync()
    {
        _loadingList = true;
        _listLoadFailed = false;
        SyncFilters();
        try
        {
            var result = await UiOps.RunAsync(() => TecnicosSvc.SearchAsync(_filters), "No se pudieron cargar los técnicos.");
            if (!result.Success || result.Value is null)
            {
                _listLoadFailed = true;
                SetFeedback(result.Feedback);
                return;
            }

            _items.Clear();
            _items.AddRange(result.Value.Items);
            if (!string.IsNullOrWhiteSpace(_selectedIdTecnico) &&
                !_items.Any(i => string.Equals(i.IdTecnico, _selectedIdTecnico, StringComparison.OrdinalIgnoreCase)))
                _selectedIdTecnico = string.Empty;

            _pagedTotal = result.Value.Total;
            _pageNumber = result.Value.PageNumber;
            _totalPages = result.Value.TotalPages;
            _hasPrev    = result.Value.HasPrev;
            _hasNext    = result.Value.HasNext;
        }
        finally
        {
            _loadingList = false;
            UpdatePageHeader();
        }
    }

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page > _totalPages || _loadingList)
            return;
        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
            _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task SetPageSizeAsync(string? value)
    {
        if (int.TryParse(value, out var size) && size > 0)
            _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private void SyncFilters()
    {
        _filters.Activo = _activoFiltro switch
        {
            "1" => true,
            "0" => false,
            _   => null
        };
    }

