    private string GetTecnicoRowClass(TecnicoGridItemDto item)
        => string.Join(" ", new[]
        {
            "tecnicos-list-table__row",
            IsSelected(item) ? "is-selected" : null
        }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    private IReadOnlyList<AlfaActionMenuItem> BuildTecnicoActionMenu(TecnicoGridItemDto item)
    {
        var actions = new List<AlfaActionMenuItem>
        {
            new()
            {
                Key = "editar",
                Label = "Editar",
                Icon = "bi bi-pencil-square",
                OnClick = () => AbrirEditorAsync(item.IdTecnico)
            }
        };

        if (!item.Baja)
        {
            actions.Add(new AlfaActionMenuItem
            {
                Key = "dar-de-baja",
                Label = "Dar de baja",
                Icon = "bi bi-person-dash",
                Danger = true,
                SeparatorBefore = true,
                OnClick = () => OpenBrowseDeactivateConfirmAsync(item)
            });
        }

        return actions;
    }

    private async Task OpenBrowseDeactivateConfirmAsync(TecnicoGridItemDto item)
    {
        if (item.Baja || _loadingList || _saving)
            return;

        _browseDeactivateTargetId = item.IdTecnico.Trim();
        _browseDeactivateTargetName = item.Nombre.Trim();
        _showBrowseDeactivateConfirm = true;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseBrowseDeactivateConfirm()
    {
        if (_saving)
            return;

        _showBrowseDeactivateConfirm = false;
        _browseDeactivateTargetId = string.Empty;
        _browseDeactivateTargetName = string.Empty;
    }

    private async Task ConfirmBrowseDeactivateAsync()
    {
        if (string.IsNullOrWhiteSpace(_browseDeactivateTargetId) || _saving)
            return;

        var targetId = _browseDeactivateTargetId;
        var targetName = _browseDeactivateTargetName;
        _saving = true;
        try
        {
            var result = await UiOps.RunAsync(
                () => TecnicosSvc.DarDeBajaAsync(targetId),
                "No se pudo dar de baja el técnico.");

            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            if (string.Equals(_selectedIdTecnico, targetId, StringComparison.OrdinalIgnoreCase))
                _selectedIdTecnico = string.Empty;

            _showBrowseDeactivateConfirm = false;
            _browseDeactivateTargetId = string.Empty;
            _browseDeactivateTargetName = string.Empty;
            SetFeedback(AppUiMessage.Success("Técnico dado de baja", $"El técnico {targetName} quedó inactivo."));
            await BuscarAsync();
        }
        finally
        {
            _saving = false;
            UpdatePageHeader();
        }
    }

    // ── Helpers de UI ──────────────────────────────────────────────────────────

    private bool IsSelected(TecnicoGridItemDto item)
        => !_isNewMode && string.Equals(_selectedIdTecnico, item.IdTecnico, StringComparison.OrdinalIgnoreCase);

    private void ClearFieldErrors() => _fieldErrors.Clear();

    private void ApplyFieldErrors(ValidationResult validation)
    {
        ClearFieldErrors();
        foreach (var issue in validation.Issues.Where(i => !string.IsNullOrWhiteSpace(i.FieldKey)))
            _fieldErrors[issue.FieldKey.Trim()] = issue.Message;
    }

    private void SetFeedback(AppUiMessage? message) => _feedback = message;

    private void ClearFeedback() => SetFeedback(null);

    private static string FormatMoney(decimal? value)
        => value.HasValue ? value.Value.ToString("N2") : "—";

