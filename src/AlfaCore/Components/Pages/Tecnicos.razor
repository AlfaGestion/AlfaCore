@page "/tecnicos"
@using AlfaCore.Models
@using AlfaCore.Services
@inject AlfaCore.Services.ITecnicosService TecnicosSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Técnicos | Alfa Gestión</PageTitle>

<div class="page-grid">

    <!-- ── Intro ───────────────────────────────────────────────────────── -->
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">Técnicos</h2>
            <p class="page-intro__text">Administrá los técnicos del sistema: mecánicos, soporte y personal vinculado a usuarios.</p>
        </div>
        <div class="actions">
            <button type="button" class="btn btn--primary" @onclick="BeginNew">
                <i class="bi bi-plus-circle"></i> Nuevo técnico
            </button>
            <button type="button" class="btn btn--ghost" @onclick="RecargarAsync" disabled="@_loadingList">
                <i class="bi bi-arrow-clockwise"></i> Recargar
            </button>
        </div>
    </section>

    <!-- ── Feedback ────────────────────────────────────────────────────── -->
    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ── Filtros ──────────────────────────────────────────────────────── -->
    <section class="panel-card">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Filtros</h3>
                <p class="panel-card__subtitle">Buscá por código, nombre, cargo o usuario asociado.</p>
            </div>
        </div>
        <div class="filters-grid">
            <div class="field field--wide">
                <label>Buscar</label>
                <input type="search"
                       placeholder="Código, nombre, cargo..."
                       @bind="_filters.Texto"
                       @bind:event="oninput" />
            </div>
            <div class="field">
                <label>Estado</label>
                <select @bind="_activoFiltro">
                    <option value="1">Activos</option>
                    <option value="">Todos</option>
                    <option value="0">Dados de baja</option>
                </select>
            </div>
            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="AplicarFiltrosAsync" disabled="@_loadingList">
                    <i class="bi bi-funnel"></i> Aplicar
                </button>
                <button type="button" class="btn btn--ghost" @onclick="LimpiarFiltros" disabled="@_loadingList">
                    <i class="bi bi-eraser"></i> Limpiar
                </button>
            </div>
        </div>
    </section>

    <!-- ── Configurar vista ────────────────────────────────────────────── -->
    @if (_showViewSettings && !_showEditor)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Elegí columnas visibles, orden y agrupación para tu grilla de técnicos.</p>
                </div>
            </div>

            <div class="usuarios-view-settings">
                <div class="field">
                    <label>Agrupar por</label>
                    <select @bind="_draftAgruparPor">
                        <option value="@TecnicosViewGroupKeys.None">Sin agrupar</option>
                        <option value="@TecnicosViewGroupKeys.Cargo">Cargo</option>
                        <option value="@TecnicosViewGroupKeys.OcultarCliente">Ocultar cliente</option>
                        <option value="@TecnicosViewGroupKeys.Activo">Activo</option>
                    </select>
                </div>

                <div class="usuarios-view-settings__list">
                    @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="checkbox">
                                <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                <span>@column.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">
                        <i class="bi bi-floppy"></i> Guardar vista
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </div>
        </section>
    }

    <!-- ── Editor ──────────────────────────────────────────────────────── -->
    @if (_showEditor)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@(_isNewMode ? "Nuevo técnico" : $"Editar — {_form.Nombre}")</h3>
                    <p class="panel-card__subtitle">
                        @if (_isNewMode)
                        {
                            <span>Completá los datos del técnico.</span>
                        }
                        else
                        {
                            <span>Código: @_form.IdTecnicoOriginal · Estado: @(_selectedActivo ? "Activo" : "Dado de baja")</span>
                        }
                    </p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="CerrarEditor" disabled="@_saving">
                        <i class="bi bi-arrow-left"></i> Volver al listado
                    </button>
                </div>
            </div>

            <div class="usuarios-editor">
                <div class="usuarios-editor__form" style="max-width:720px;">

                    <!-- Fila 1: Código y Nombre -->
                    <div class="usuarios-editor__grid">
                        <div class="field">
                            <label>Código</label>
                            <input type="text"
                                   class="@GetFieldInputClass("id-tecnico")"
                                   maxlength="4"
                                   style="text-align:right;"
                                   @bind="_form.IdTecnico"
                                   disabled="@(_saving || !_isNewMode)" />
                            @if (HasFieldError("id-tecnico"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("id-tecnico")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Nombre</label>
                            <input type="text"
                                   class="@GetFieldInputClass("nombre")"
                                   maxlength="100"
                                   @bind="_form.Nombre"
                                   disabled="@_saving" />
                            @if (HasFieldError("nombre"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("nombre")</small>
                            }
                        </div>
                    </div>

                    <!-- Fila 2: Cargo y Teléfono -->
                    <div class="usuarios-editor__grid">
                        <div class="field">
                            <label>Cargo</label>
                            <input type="text"
                                   class="@GetFieldInputClass("cargo")"
                                   maxlength="100"
                                   @bind="_form.Cargo"
                                   disabled="@_saving" />
                            @if (HasFieldError("cargo"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("cargo")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Teléfono</label>
                            <input type="text"
                                   class="@GetFieldInputClass("telefono")"
                                   maxlength="50"
                                   @bind="_form.Telefono"
                                   disabled="@_saving" />
                            @if (HasFieldError("telefono"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("telefono")</small>
                            }
                        </div>
                    </div>

                    <!-- Fila 3: Domicilio y Localidad -->
                    <div class="usuarios-editor__grid">
                        <div class="field">
                            <label>Domicilio</label>
                            <input type="text"
                                   class="@GetFieldInputClass("domicilio")"
                                   maxlength="100"
                                   @bind="_form.Domicilio"
                                   disabled="@_saving" />
                            @if (HasFieldError("domicilio"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("domicilio")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Localidad</label>
                            <input type="text"
                                   class="@GetFieldInputClass("localidad")"
                                   maxlength="100"
                                   @bind="_form.Localidad"
                                   disabled="@_saving" />
                            @if (HasFieldError("localidad"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("localidad")</small>
                            }
                        </div>
                    </div>

                    <!-- Fila 4: Provincia y Costo/hora -->
                    <div class="usuarios-editor__grid">
                        <div class="field">
                            <label>Provincia</label>
                            <select class="@GetFieldInputClass("id-provincia")"
                                    @bind="_form.IdProvincia"
                                    disabled="@_saving">
                                <option value="">— Sin provincia —</option>
                                @foreach (var estado in _estados)
                                {
                                    <option value="@estado.Codigo">@estado.Descripcion</option>
                                }
                            </select>
                            @if (HasFieldError("id-provincia"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("id-provincia")</small>
                            }
                        </div>
                        <div class="field">
                            <label>Costo por hora</label>
                            <input type="number"
                                   class="@GetFieldInputClass("costo-hora")"
                                   style="text-align:right;"
                                   min="0"
                                   step="0.01"
                                   @bind="_costoHoraStr"
                                   disabled="@_saving" />
                            @if (HasFieldError("costo-hora"))
                            {
                                <small class="usuarios-field-error">@GetFieldError("costo-hora")</small>
                            }
                        </div>
                    </div>

                    <!-- Fila 5: Usuario asociado -->
                    <div class="field">
                        <label>Usuario del sistema</label>
                        <div class="actions" style="align-items:flex-start; gap:0.5rem;">
                            <select class="@GetFieldInputClass("usuario-asociado")"
                                    style="flex:1;"
                                    @bind="_form.UsuarioAsociado"
                                    disabled="@_saving">
                                <option value="">— Sin usuario asociado —</option>
                                @foreach (var u in _usuarios)
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                            <button type="button"
                                    class="btn btn--ghost"
                                    title="Recargar lista de usuarios"
                                    @onclick="RecargarUsuariosAsync"
                                    disabled="@_saving">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button type="button"
                                    class="btn btn--ghost"
                                    title="Ir al ABM de Usuarios para crear uno nuevo"
                                    @onclick="IrACrearUsuario"
                                    disabled="@_saving">
                                <i class="bi bi-box-arrow-up-right"></i> Crear usuario
                            </button>
                        </div>
                        @if (HasFieldError("usuario-asociado"))
                        {
                            <small class="usuarios-field-error">@GetFieldError("usuario-asociado")</small>
                        }
                        <small class="panel-card__subtitle">Al crear un nuevo usuario, guardá el técnico primero, luego volvé para seleccionarlo.</small>
                    </div>

                    <!-- Fila 6: Ocultar cliente -->
                    <div class="usuarios-toggle-row">
                        <label class="checkbox">
                            <input type="checkbox" @bind="_form.OcultarCliente" disabled="@_saving" />
                            <span>Ocultar los datos del cliente</span>
                        </label>
                    </div>

                    <!-- Acciones -->
                    <div class="actions usuarios-editor__actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarAsync" disabled="@_saving">
                            <i class="bi bi-floppy"></i>
                            <span>@(_saving ? "Guardando..." : "Guardar técnico")</span>
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="ResetForm" disabled="@_saving">
                            <i class="bi bi-eraser"></i>
                            <span>@(_isNewMode ? "Limpiar" : "Revertir")</span>
                        </button>
                        @if (!_isNewMode && _selectedActivo)
                        {
                            <button type="button" class="btn btn--ghost usuarios-btn-danger" @onclick="DarDeBajaAsync" disabled="@_saving">
                                <i class="bi bi-person-dash"></i>
                                <span>Dar de baja</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <!-- ── Grilla ───────────────────────────────────────────────────────── -->
        var visibleColumns = GetVisibleColumns();
        var groups         = BuildGridGroups();

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Técnicos</h3>
                    <p class="panel-card__subtitle">@_pagedTotal registro(s) · Página @_pageNumber de @_totalPages · abrí la ficha con el botón editar o doble clic.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="AbrirConfiguracionVista">
                        <i class="bi bi-sliders"></i> Configurar vista
                    </button>
                    <span class="panel-card__subtitle">Agrupación: @GetGroupingLabel(_viewSettings.AgruparPor)</span>
                </div>
            </div>

            @if (_loadingList)
            {
                <div class="usuarios-empty">Cargando técnicos...</div>
            }
            else if (_items.Count == 0)
            {
                <div class="usuarios-empty">No hay técnicos para los filtros seleccionados.</div>
            }
            else
            {
                <div class="usuarios-table-wrap">
                    <table class="data-table usuarios-table">
                        <thead>
                            <tr>
                                @foreach (var column in visibleColumns)
                                {
                                    <th>@column.Label</th>
                                }
                                <th class="interfaces-table__actions">Acciones</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@(visibleColumns.Count + 1)">@group.Label</td>
                                    </tr>
                                }

                                @foreach (var item in group.Items)
                                {
                                    <tr class="@(IsSelected(item) ? "usuarios-table__row is-selected" : "usuarios-table__row")"
                                        @onclick="() => SeleccionarFila(item.IdTecnico)"
                                        @ondblclick="() => AbrirEditorAsync(item.IdTecnico)">
                                        @foreach (var column in visibleColumns)
                                        {
                                            <td>
                                                @switch (column.Key)
                                                {
                                                    case TecnicosViewColumnKeys.IdTecnico:
                                                        <span style="display:block; text-align:right; font-family:monospace;">@item.IdTecnico</span>
                                                        break;
                                                    case TecnicosViewColumnKeys.Nombre:
                                                        <strong>@item.Nombre</strong>
                                                        break;
                                                    case TecnicosViewColumnKeys.Cargo:
                                                        @item.Cargo
                                                        break;
                                                    case TecnicosViewColumnKeys.Localidad:
                                                        @(string.IsNullOrWhiteSpace(item.Localidad) ? "—" : item.Localidad)
                                                        break;
                                                    case TecnicosViewColumnKeys.Telefono:
                                                        @(string.IsNullOrWhiteSpace(item.Telefono) ? "—" : item.Telefono)
                                                        break;
                                                    case TecnicosViewColumnKeys.CostoHora:
                                                        <span style="display:block; text-align:right;">@FormatMoney(item.CostoHora)</span>
                                                        break;
                                                    case TecnicosViewColumnKeys.OcultarCliente:
                                                        @(item.OcultarCliente ? "Sí" : "No")
                                                        break;
                                                    case TecnicosViewColumnKeys.UsuarioAsociado:
                                                        @(string.IsNullOrWhiteSpace(item.UsuarioAsociado) ? "—" : item.UsuarioAsociado)
                                                        break;
                                                    case TecnicosViewColumnKeys.Activo:
                                                        @(item.Baja ? "No" : "Sí")
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td class="interfaces-table__actions" @onclick:stopPropagation="true">
                                            <button type="button" class="btn btn--ghost btn--sm interfaces-table__edit"
                                                    @onclick="() => AbrirEditorAsync(item.IdTecnico)">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Editar</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>

                <div class="result-pagination">
                    <span class="result-pagination__info">@_pagedTotal registro(s)</span>
                    <div class="result-pagination__controls">
                        <button class="result-pagination__btn" title="Página anterior"
                                @onclick="() => CambiarPaginaAsync(_pageNumber - 1)"
                                disabled="@(!_hasPrev || _loadingList)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="result-pagination__btn result-pagination__btn--active">@_pageNumber / @_totalPages</span>
                        <button class="result-pagination__btn" title="Página siguiente"
                                @onclick="() => CambiarPaginaAsync(_pageNumber + 1)"
                                disabled="@(!_hasNext || _loadingList)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <select class="result-pagination__size" title="Registros por página"
                            value="@_filters.PageSize"
                            @onchange="OnPageSizeChangedAsync"
                            disabled="@_loadingList">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            }
        </section>
    }

</div>

@code {
    // ── Estado de lista ──────────────────────────────────────────────────────
    private readonly TecnicosFilters          _filters          = new();
    private readonly List<TecnicoGridItemDto> _items            = [];
    private readonly List<TecnicoViewColumnDto> _viewSettingsDraft = [];
    private readonly Dictionary<string, string> _fieldErrors    = new(StringComparer.OrdinalIgnoreCase);
    private AppUiMessage?         _feedback;
    private TecnicosViewSettingsDto _viewSettings             = BuildDefaultViewSettings();
    private bool _loadingList;
    private bool _saving;
    private bool _showEditor;
    private bool _showViewSettings;
    private bool _viewSettingsLoaded;
    private int  _pagedTotal;
    private int  _pageNumber  = 1;
    private int  _totalPages  = 1;
    private bool _hasPrev;
    private bool _hasNext;
    private string _selectedIdTecnico = string.Empty;
    private string _activoFiltro      = "1";
    private string _draftAgruparPor   = TecnicosViewGroupKeys.None;
    private string _viewSettingsUserName = string.Empty;

    // ── Estado de editor ─────────────────────────────────────────────────────
    private readonly TecnicoSaveRequest _form = new();
    private bool   _isNewMode    = true;
    private bool   _selectedActivo = true;
    private string _costoHoraStr = string.Empty;

    // ── Datos de combos ───────────────────────────────────────────────────────
    private IReadOnlyList<EstadoItemDto> _estados   = [];
    private IReadOnlyList<string>        _usuarios  = [];

    // ── Ciclo de vida ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        AppUserSession.StateChanged += OnAppUserSessionChanged;
        await Task.WhenAll(
            EnsureViewSettingsLoadedAsync(),
            CargarCombosAsync(),
            BuscarAsync());
    }

    public void Dispose()
        => AppUserSession.StateChanged -= OnAppUserSessionChanged;

    private async Task CargarCombosAsync()
    {
        var estadosResult   = await UiOps.RunAsync(() => TecnicosSvc.GetEstadosAsync(), "No se pudieron cargar las provincias.");
        var usuariosResult  = await UiOps.RunAsync(() => TecnicosSvc.GetUsuariosDisponiblesAsync(), "No se pudieron cargar los usuarios.");

        if (estadosResult.Success && estadosResult.Value is not null)
            _estados = estadosResult.Value;

        if (usuariosResult.Success && usuariosResult.Value is not null)
            _usuarios = usuariosResult.Value;
    }

    private async Task RecargarUsuariosAsync()
    {
        var result = await UiOps.RunAsync(() => TecnicosSvc.GetUsuariosDisponiblesAsync(), "No se pudieron cargar los usuarios.");
        if (result.Success && result.Value is not null)
            _usuarios = result.Value;
    }

    // ── Búsqueda y paginación ─────────────────────────────────────────────────

    private async Task RecargarAsync()
    {
        await EnsureViewSettingsLoadedAsync(force: true);
        await BuscarAsync();
        if (!_isNewMode && !string.IsNullOrWhiteSpace(_selectedIdTecnico))
            await CargarEditorAsync(_selectedIdTecnico);
    }

    private async Task AplicarFiltrosAsync()
    {
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _loadingList = true;
        SyncFilters();
        try
        {
            var result = await UiOps.RunAsync(() => TecnicosSvc.SearchAsync(_filters), "No se pudieron cargar los técnicos.");
            if (!result.Success || result.Value is null)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _items.Clear();
            _items.AddRange(result.Value.Items);
            if (!string.IsNullOrWhiteSpace(_selectedIdTecnico) &&
                !_items.Any(i => string.Equals(i.IdTecnico, _selectedIdTecnico, StringComparison.OrdinalIgnoreCase)))
                _selectedIdTecnico = string.Empty;

            _pagedTotal = result.Value.Total;
            _pageNumber = result.Value.PageNumber;
            _totalPages = result.Value.TotalPages;
            _hasPrev    = result.Value.HasPrev;
            _hasNext    = result.Value.HasNext;
        }
        finally
        {
            _loadingList = false;
        }
    }

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page > _totalPages || _loadingList)
            return;
        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
            _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private void SyncFilters()
    {
        _filters.Activo = _activoFiltro switch
        {
            "1" => true,
            "0" => false,
            _   => null
        };
    }

    private void LimpiarFiltros()
    {
        _filters.Texto = string.Empty;
        _activoFiltro  = "1";
    }

    // ── Editor ────────────────────────────────────────────────────────────────

    private void BeginNew()
    {
        ClearFieldErrors();
        _showEditor    = true;
        _showViewSettings = false;
        _isNewMode     = true;
        _selectedIdTecnico = string.Empty;
        _selectedActivo    = true;
        _costoHoraStr      = string.Empty;

        _form.IdTecnicoOriginal = string.Empty;
        _form.IdTecnico         = string.Empty;
        _form.Nombre            = string.Empty;
        _form.Cargo             = string.Empty;
        _form.Domicilio         = string.Empty;
        _form.Localidad         = string.Empty;
        _form.IdProvincia       = string.Empty;
        _form.Telefono          = string.Empty;
        _form.CostoHora         = null;
        _form.UsuarioAsociado   = string.Empty;
        _form.OcultarCliente    = false;
    }

    private void CerrarEditor()
    {
        ClearFieldErrors();
        _showEditor = false;
    }

    private void ResetForm()
    {
        ClearFieldErrors();
        if (_isNewMode)
        {
            BeginNew();
            return;
        }
        _ = CargarEditorAsync(_selectedIdTecnico);
    }

    private async Task AbrirEditorAsync(string idTecnico)
    {
        _showEditor       = true;
        _showViewSettings = false;
        await CargarEditorAsync(idTecnico);
    }

    private async Task CargarEditorAsync(string idTecnico)
    {
        var result = await UiOps.RunAsync(() => TecnicosSvc.GetByIdAsync(idTecnico), "No se pudo cargar el técnico.");
        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }
        if (result.Value is null)
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title    = "Técnico no disponible",
                Message  = "El técnico seleccionado ya no existe en la base activa."
            });
            await BuscarAsync();
            BeginNew();
            return;
        }
        MapDetailToForm(result.Value);
    }

    private async Task GuardarAsync()
    {
        ClearFieldErrors();
        SyncCostoHora();
        _saving = true;
        try
        {
            try
            {
                var savedId = await TecnicosSvc.SaveAsync(_form);
                SetFeedback(AppUiMessage.Success("Técnico guardado", $"El técnico {savedId} se guardó correctamente."));
                await BuscarAsync();
                await CargarEditorAsync(savedId);
            }
            catch (AppValidationException validationEx)
            {
                ApplyFieldErrors(validationEx.Validation);
                SetFeedback(new AppUiMessage
                {
                    Severity   = AppUiFeedbackSeverity.Warning,
                    Title      = "Revisá los datos del técnico",
                    Message    = validationEx.UserMessage,
                    Suggestion = "Corregí los campos marcados y volvé a intentar."
                });
            }
            catch (Exception ex)
            {
                SetFeedback(UiOps.BuildMessage(ex, "No se pudo guardar el técnico."));
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DarDeBajaAsync()
    {
        if (_isNewMode || string.IsNullOrWhiteSpace(_selectedIdTecnico))
            return;

        var confirm = await Js.InvokeAsync<bool>("confirm", $"¿Dar de baja al técnico {_form.Nombre}?");
        if (!confirm)
            return;

        _saving = true;
        try
        {
            var result = await UiOps.RunAsync(
                () => TecnicosSvc.DarDeBajaAsync(_selectedIdTecnico),
                "No se pudo dar de baja el técnico.");

            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            SetFeedback(AppUiMessage.Success("Técnico dado de baja", $"El técnico {_form.Nombre} quedó inactivo."));
            BeginNew();
            _showEditor = false;
            await BuscarAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void IrACrearUsuario()
    {
        Nav.NavigateTo("/usuarios");
    }

    private void SeleccionarFila(string idTecnico)
        => _selectedIdTecnico = idTecnico?.Trim() ?? string.Empty;

    private void MapDetailToForm(TecnicoDetailDto detail)
    {
        ClearFieldErrors();
        _isNewMode         = false;
        _showEditor        = true;
        _selectedIdTecnico = detail.IdTecnico;
        _selectedActivo    = !detail.Baja;
        _costoHoraStr      = detail.CostoHora.HasValue ? detail.CostoHora.Value.ToString("F2") : string.Empty;

        _form.IdTecnicoOriginal = detail.IdTecnico;
        _form.IdTecnico         = detail.IdTecnico;
        _form.Nombre            = detail.Nombre;
        _form.Cargo             = detail.Cargo;
        _form.Domicilio         = detail.Domicilio;
        _form.Localidad         = detail.Localidad;
        _form.IdProvincia       = detail.IdProvincia;
        _form.Telefono          = detail.Telefono;
        _form.CostoHora         = detail.CostoHora;
        _form.UsuarioAsociado   = detail.UsuarioAsociado;
        _form.OcultarCliente    = detail.OcultarCliente;
    }

    private void SyncCostoHora()
    {
        if (string.IsNullOrWhiteSpace(_costoHoraStr))
        {
            _form.CostoHora = null;
            return;
        }
        _form.CostoHora = decimal.TryParse(_costoHoraStr, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var val)
            ? val
            : null;
    }

    // ── Configurar vista ──────────────────────────────────────────────────────

    private async Task EnsureViewSettingsLoadedAsync(bool force = false)
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (!force && _viewSettingsLoaded && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            ApplyViewSettings(BuildDefaultViewSettings(), string.Empty);
            return;
        }

        var result = await UiOps.RunAsync(
            () => TecnicosSvc.GetViewSettingsAsync(currentUser),
            "No se pudo cargar la configuración de vista.");

        ApplyViewSettings(result.Success && result.Value is not null ? result.Value : BuildDefaultViewSettings(), currentUser);
    }

    private void AbrirConfiguracionVista()
    {
        _showViewSettings = true;
        _draftAgruparPor  = _viewSettings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
    }

    private void CancelarConfiguracionVista()
    {
        _showViewSettings = false;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(_viewSettings.Columnas));
    }

    private void ToggleViewColumn(string key, ChangeEventArgs args)
    {
        var column = _viewSettingsDraft.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null) return;
        column.Visible = args.Value is bool flag && flag;
        if (!_viewSettingsDraft.Any(c => c.Visible))
            column.Visible = true;
    }

    private void MoveViewColumn(string key, int offset)
    {
        var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
        var index   = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        var target = index + offset;
        if (target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(ordered);
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            SetFeedback(new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title    = "Sesión requerida",
                Message  = "Necesitás iniciar sesión para guardar la configuración de vista."
            });
            return;
        }

        var settings = new TecnicosViewSettingsDto
        {
            AgruparPor = _draftAgruparPor,
            Columnas   = CloneColumns(_viewSettingsDraft)
        };

        var result = await UiOps.RunAsync(async () =>
        {
            await TecnicosSvc.SaveViewSettingsAsync(currentUser, settings);
            return true;
        }, "No se pudo guardar la configuración de vista.");

        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }

        ApplyViewSettings(settings, currentUser);
        _showViewSettings = false;
        SetFeedback(AppUiMessage.Success("Vista guardada", "La configuración de la grilla quedó actualizada para tu usuario."));
    }

    private void ApplyViewSettings(TecnicosViewSettingsDto settings, string userName)
    {
        _viewSettings        = settings;
        _viewSettingsUserName = userName;
        _viewSettingsLoaded  = true;
        _draftAgruparPor     = settings.AgruparPor;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(CloneColumns(settings.Columnas));
    }

    private void OnAppUserSessionChanged()
        => _ = InvokeAsync(async () =>
        {
            await EnsureViewSettingsLoadedAsync(force: true);
            StateHasChanged();
        });

    // ── Grilla: agrupación y columnas visibles ────────────────────────────────

    private IReadOnlyList<TecnicoViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private IReadOnlyList<TecnicoGridGroup> BuildGridGroups()
    {
        if (_viewSettings.AgruparPor == TecnicosViewGroupKeys.None)
            return [new TecnicoGridGroup { Label = string.Empty, ShowHeader = false, Items = _items.ToList() }];

        return _items
            .GroupBy(item => ResolveGroupValue(item, _viewSettings.AgruparPor))
            .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(g => new TecnicoGridGroup { Label = g.Key, ShowHeader = true, Items = g.ToList() })
            .ToList();
    }

    private static string ResolveGroupValue(TecnicoGridItemDto item, string grouping)
        => grouping switch
        {
            TecnicosViewGroupKeys.Cargo          => string.IsNullOrWhiteSpace(item.Cargo) ? "Sin cargo" : item.Cargo,
            TecnicosViewGroupKeys.OcultarCliente => item.OcultarCliente ? "Oculta datos de cliente" : "Muestra datos de cliente",
            TecnicosViewGroupKeys.Activo         => item.Baja ? "Inactivos" : "Activos",
            _                                    => string.Empty
        };

    private static string GetGroupingLabel(string grouping)
        => grouping switch
        {
            TecnicosViewGroupKeys.Cargo          => "Cargo",
            TecnicosViewGroupKeys.OcultarCliente => "Ocultar cliente",
            TecnicosViewGroupKeys.Activo         => "Activo",
            _                                    => "Sin agrupar"
        };

    private static TecnicosViewSettingsDto BuildDefaultViewSettings() => new()
    {
        AgruparPor = TecnicosViewGroupKeys.None,
        Columnas =
        [
            new() { Key = TecnicosViewColumnKeys.IdTecnico,       Label = "Código",         Visible = true,  Order = 0 },
            new() { Key = TecnicosViewColumnKeys.Nombre,          Label = "Nombre",          Visible = true,  Order = 1 },
            new() { Key = TecnicosViewColumnKeys.Cargo,           Label = "Cargo",           Visible = true,  Order = 2 },
            new() { Key = TecnicosViewColumnKeys.Localidad,       Label = "Localidad",       Visible = false, Order = 3 },
            new() { Key = TecnicosViewColumnKeys.Telefono,        Label = "Teléfono",        Visible = true,  Order = 4 },
            new() { Key = TecnicosViewColumnKeys.CostoHora,       Label = "Costo/hora",      Visible = true,  Order = 5 },
            new() { Key = TecnicosViewColumnKeys.OcultarCliente,  Label = "Ocultar cliente", Visible = false, Order = 6 },
            new() { Key = TecnicosViewColumnKeys.UsuarioAsociado, Label = "Usuario sistema", Visible = true,  Order = 7 },
            new() { Key = TecnicosViewColumnKeys.Activo,          Label = "Activo",          Visible = true,  Order = 8 }
        ]
    };

    private static List<TecnicoViewColumnDto> CloneColumns(IEnumerable<TecnicoViewColumnDto> columns)
        => columns.OrderBy(c => c.Order)
                  .Select(c => new TecnicoViewColumnDto { Key = c.Key, Label = c.Label, Visible = c.Visible, Order = c.Order })
                  .ToList();

    // ── Helpers de UI ──────────────────────────────────────────────────────────

    private bool IsSelected(TecnicoGridItemDto item)
        => !_isNewMode && string.Equals(_selectedIdTecnico, item.IdTecnico, StringComparison.OrdinalIgnoreCase);

    private void ClearFieldErrors() => _fieldErrors.Clear();

    private void SetFieldError(string key, string message)
    {
        if (!string.IsNullOrWhiteSpace(key) && !string.IsNullOrWhiteSpace(message))
            _fieldErrors[key.Trim()] = message.Trim();
    }

    private void ApplyFieldErrors(ValidationResult validation)
    {
        ClearFieldErrors();
        foreach (var issue in validation.Issues.Where(i => !string.IsNullOrWhiteSpace(i.FieldKey)))
            _fieldErrors[issue.FieldKey.Trim()] = issue.Message;
    }

    private bool HasFieldError(string key)
        => !string.IsNullOrWhiteSpace(key) && _fieldErrors.ContainsKey(key.Trim());

    private string GetFieldError(string key)
        => HasFieldError(key) ? _fieldErrors[key.Trim()] : string.Empty;

    private string GetFieldInputClass(string key)
        => HasFieldError(key) ? "usuarios-input usuarios-input--invalid" : "usuarios-input";

    private void SetFeedback(AppUiMessage? message) => _feedback = message;

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--ok",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            _                             => "editor-msg--error"
        };

    private static string FormatMoney(decimal? value)
        => value.HasValue ? value.Value.ToString("N2") : "—";

    // ── Tipos internos ────────────────────────────────────────────────────────

    private sealed class TecnicoGridGroup
    {
        public string                  Label      { get; init; } = string.Empty;
        public bool                    ShowHeader { get; init; }
        public List<TecnicoGridItemDto> Items     { get; init; } = [];
    }
