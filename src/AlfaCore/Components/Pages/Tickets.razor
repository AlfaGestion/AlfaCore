    }

    private Task HandleTicketParteLineaKeyDownAsync(KeyboardEventArgs args, int index)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return InsertTicketParteLineaAfterAsync(index);

        return Task.CompletedTask;
    }

    private Task InsertTicketParteLineaAfterAsync(int index)
    {
        var previous = index >= 0 && index < _ticketParteLineas.Count ? _ticketParteLineas[index] : _ticketParteLineas.LastOrDefault();
        var nueva = new TicketParteHoraLineaForm
        {
            IdTecnico = previous?.IdTecnico ?? _ticketParteForm.IdTecnico,
            TipoTrabajo = previous?.TipoTrabajo ?? ParteHoraTipoTrabajoKeys.Soporte,
            Minutos = 15
        };

        if (index < 0 || index >= _ticketParteLineas.Count - 1)
            _ticketParteLineas.Add(nueva);
        else
            _ticketParteLineas.Insert(index + 1, nueva);

        _pendingTicketParteLineaDescripcionFocusIndex = Math.Min(index + 1, _ticketParteLineas.Count - 1);
        return Task.CompletedTask;
    }

    private async Task GuardarParteHoraTicketAsync()
    {
        if (_detail is null)
            return;

        _savingParteHora = true;
        try
        {
            var usuario = AppUserSession.GetCurrentUserName(Environment.UserName);
            var lineas = _ticketParteLineas
                .Where(linea => linea.Minutos > 0 || !string.IsNullOrWhiteSpace(linea.Descripcion) || !string.IsNullOrWhiteSpace(linea.IdTecnico))
                .ToList();

            if (lineas.Count == 0)
                lineas.Add(new TicketParteHoraLineaForm { IdTecnico = _ticketParteForm.IdTecnico, TipoTrabajo = ParteHoraTipoTrabajoKeys.Soporte, Minutos = 15 });

            if (lineas.Any(linea => string.IsNullOrWhiteSpace(linea.Descripcion)))
            {
                SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Tarea requerida", Message = "Todas las lineas del parte deben tener descripcion de tarea." });
                return;
            }

            var lineIndex = 0;
            foreach (var linea in lineas)
            {
                var request = new ParteHoraSaveRequest
                {
                    IdParteHora = lineIndex == 0 ? _editingTicketParteHoraId : null,
                    Fecha = _ticketParteForm.Fecha,
                    ClienteCodigo = _detail.ClienteCodigo,
                    IdContacto = _detail.IdContacto,
                    IdTicket = _detail.IdTicket,
                    IdTecnico = linea.IdTecnico,
                    Usuario = usuario,
                    TipoTrabajo = linea.TipoTrabajo,
                    Minutos = linea.Minutos,
                    Facturable = _ticketParteForm.Facturable,
                    Excedente = _ticketParteForm.Excedente,
                    Estado = ParteHoraEstadoKeys.Presentado,
                    Descripcion = linea.Descripcion,
                    UsuarioAccion = usuario
                };

                var result = await UiOps.RunAsync(() => PartesSvc.SaveAsync(request), "No se pudo guardar el parte de horas.");
                if (!result.Success)
                {
                    SetFeedback(result.Feedback);
                    return;
                }

                lineIndex++;
            }

            SetFeedback(AppUiMessage.Success(_editingTicketParteHoraId.HasValue ? "Parte actualizado" : "Parte guardado", lineas.Count == 1 ? "La hora quedo vinculada al ticket." : $"Se vincularon {lineas.Count} lineas de trabajo al ticket."));
            var id = _detail.IdTicket;
            await AbrirTicketAsync(id, updateUrl: false);
            _ticketEditorTab = TicketEditorTabParteHora;
        }
        finally
        {
            _savingParteHora = false;
        }
    }

