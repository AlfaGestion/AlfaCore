@page "/tickets"
@page "/{idweb}/{idbase:int}/tickets"
@using Microsoft.AspNetCore.WebUtilities
@using AlfaCore.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject AlfaCore.Services.ITicketsService TicketsSvc
@inject AlfaCore.Services.IPartesHorasService PartesHorasSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Tickets de asistencia | Alfa Gestión</PageTitle>

<section class="page-grid tickets-page tickets-page--odoo" @onclick="HandleTicketPageClickAsync">
    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg editor-msg--animated @GetFeedbackClass(_feedback) @(_feedbackLeaving ? "is-leaving" : string.Empty)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                    @if (IsTicketsInitializationPending(_feedback.Message))
                    {
                        <div class="actions" style="margin-top: .75rem;">
                            <a class="btn btn--primary btn--sm" href="/actualizaciones">
                                <i class="bi bi-cloud-arrow-up"></i> Ir a Actualizaciones
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (_showViewSettings && _viewMode == "lista" && !_showEditor)
    {
        <div class="tickets-view-settings-layer" @ref="_viewSettingsLayer" @onclick="CloseViewSettings" @onkeydown="HandleViewSettingsKeyDown" tabindex="-1">
        <section class="panel-card tickets-view-settings-modal" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Columnas visibles, orden y agrupación del listado.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseViewSettings">
                    <i class="bi bi-x-circle"></i> Cerrar
                </button>
            </div>
            <div class="usuarios-view-settings">
                <div class="field">
                    <label>Agrupar por</label>
                    <select @bind="_draftAgruparPor">
                        <option value="@TicketViewGroupKeys.None">Sin agrupar</option>
                        <option value="@TicketViewGroupKeys.Estado">Etapa</option>
                        <option value="@TicketViewGroupKeys.Prioridad">Prioridad</option>
                        <option value="@TicketViewGroupKeys.Tecnico">Asignado</option>
                    </select>
                </div>
                <div class="usuarios-view-settings__list">
                    @foreach (var col in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="checkbox">
                                <input type="checkbox" checked="@col.Visible" @onchange="args => ToggleViewColumn(col.Key, args)" />
                                <span>@col.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(col.Key, -1)"><i class="bi bi-arrow-up"></i></button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(col.Key, 1)"><i class="bi bi-arrow-down"></i></button>
                            </div>
                        </div>
                    }
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">
                        <i class="bi bi-floppy"></i> Guardar vista
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CloseViewSettings">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </div>
        </section>
        </div>
    }

    @if (_showTagManager)
    {
        <div class="tickets-tags-modal-layer" @ref="_tagManagerLayer" @onclick="CloseTagManager" @onkeydown="HandleTagManagerKeyDown" tabindex="-1">
        <section class="panel-card tickets-tags-manager" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Etiquetas</h3>
                    <p class="panel-card__subtitle">Clasificá tickets por programación, soporte, capacitación u otros criterios.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseTagManager">
                    <i class="bi bi-x-circle"></i> Cerrar
                </button>
            </div>
            <div class="tickets-tags-manager__body">
                <div class="tickets-tags-manager__form">
                    <div class="field">
                        <label>Nombre</label>
                        <input type="text" maxlength="60" @bind="_tagDraftName" placeholder="Ej.: Soporte" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Color</label>
                        <input type="color" @bind="_tagDraftColor" disabled="@_saving" />
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarEtiquetaAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_tagDraftName))">
                            <i class="bi bi-floppy"></i> @(_tagDraftId > 0 ? "Guardar etiqueta" : "Crear etiqueta")
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="NuevaEtiqueta" disabled="@_saving">
                            <i class="bi bi-plus-circle"></i> Nueva
                        </button>
                    </div>
                </div>
                <div class="tickets-tags-manager__list">
                    @foreach (var tag in _lookups.Etiquetas)
                    {
                        <div class="tickets-tags-manager__item">
                            <span class="tickets-tag-chip" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarEtiqueta(tag)" disabled="@_saving">
                                    <i class="bi bi-pencil"></i> Editar
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EliminarEtiquetaAsync(tag)" disabled="@_saving">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
        </div>
    }

    @if (_showBulkAction && _viewMode == "lista" && !_showEditor)
    {
        <div class="tickets-bulk-layer" @onclick="CloseBulkAction">
            <section class="panel-card tickets-bulk-modal" @onclick:stopPropagation>
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">@BulkActionTitle</h3>
                        <p class="panel-card__subtitle">La acción se aplicará a @_selectedTicketIds.Count ticket(s).</p>
                    </div>
                    <button type="button" class="btn btn--ghost" @onclick="CloseBulkAction" disabled="@_bulkUpdating">
                        <i class="bi bi-x-circle"></i> Cerrar
                    </button>
                </div>
                <div class="field">
                    @if (_bulkAction == BulkActionEstado)
                    {
                        <label>Nueva etapa</label>
                        <select @bind="_bulkValue" disabled="@_bulkUpdating">
                            @foreach (var state in _lookups.Estados.OrderBy(x => x.Orden))
                            {
                                <option value="@state.CodigoEstado">@state.Nombre</option>
                            }
                        </select>
                    }
                    else if (_bulkAction == BulkActionTecnico)
                    {
                        <label>Asignar a</label>
                        <select @bind="_bulkValue" disabled="@_bulkUpdating">
                            <option value="">Sin asignar</option>
                            @foreach (var tech in _lookups.Tecnicos)
                            {
                                <option value="@tech.IdTecnico">@tech.Nombre</option>
                            }
                        </select>
                    }
                    else
                    {
                        <label>Prioridad</label>
                        <select @bind="_bulkValue" disabled="@_bulkUpdating">
                            <option value="3">Alta</option>
                            <option value="2">Media</option>
                            <option value="1">Baja</option>
                            <option value="0">Sin prioridad</option>
                        </select>
                    }
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="ApplyBulkActionAsync" disabled="@_bulkUpdating">
                        <i class="bi bi-check2-circle"></i> @(_bulkUpdating ? "Aplicando..." : "Aplicar")
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CloseBulkAction" disabled="@_bulkUpdating">Cancelar</button>
                </div>
            </section>
        </div>
    }

    @if (_showEditor)
    {
        <section class="panel-card tickets-editor">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@(_isNew ? "Nuevo ticket" : $"{_detail?.CodigoVisible} {_form.Titulo}")</h3>
                    <p class="panel-card__subtitle">@(_isNew ? "Cargá lo mínimo para que soporte lo tome rápido." : BuildDetailSubtitle())</p>
                </div>
                <div class="actions">
                    @if (!_isNew && _detail?.IdConversacion is long idConv)
                    {
                        <a class="btn btn--ghost" href="@($"/conversaciones?id={idConv}")">
                            <i class="bi bi-chat-dots"></i> Ver chat
                        </a>
                    }
                    @if (!_isNew && _detail?.IdContacto is int idContacto)
                    {
                        <a class="btn btn--ghost" href="@($"/contactos?editar={idContacto}")">
                            <i class="bi bi-person-lines-fill"></i> Ver contacto
                        </a>
                    }
                    <button type="button" class="btn btn--ghost" @onclick="CerrarEditor">
                        <i class="bi bi-arrow-left"></i> Volver
                    </button>
                </div>
            </div>

            <div class="tickets-editor-grid">
                <div class="tickets-editor-main">
                    <div class="field">
                        <label>Nombre del ticket</label>
                        <input type="text" maxlength="180" @bind="_form.Titulo" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Descripción</label>
                        <div class="tickets-rich-editor">
                            <div class="tickets-rich-editor__surface"
                                 @ref="_descriptionEditor"
                                 contenteditable="@(!_saving)"
                                 data-placeholder="Escribí / para comandos"
                                 @oninput="OnDescripcionChangedAsync"
                                 @onkeyup="OnDescripcionChangedAsync"
                                 @onfocus="OnDescripcionFocusAsync"></div>
                            <div class="tickets-rich-editor__bar">
                                @foreach (var option in ToolbarDescriptionCommands)
                                {
                                    <button type="button"
                                            class="tickets-rich-editor__tool"
                                            title="@option.Title"
                                            disabled="@_saving"
                                            @onclick="() => RunDescriptionCommandAsync(option)">
                                        <i class="bi @option.Icon"></i>
                                    </button>
                                }
                                <button type="button"
                                        class="tickets-rich-editor__tool"
                                        title="Comandos"
                                        disabled="@_saving"
                                        @onclick="ToggleDescriptionCommands">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                            </div>
                            @if (_showDescriptionCommands)
                            {
                                <div class="tickets-slash-menu">
                                    @foreach (var group in DescriptionCommands.GroupBy(x => x.Group))
                                    {
                                        <div class="tickets-slash-menu__group">
                                            <span>@group.Key</span>
                                            @foreach (var option in group)
                                            {
                                                <button type="button" @onclick="() => RunDescriptionCommandAsync(option)">
                                                    <i class="bi @option.Icon"></i>
                                                    <span>
                                                        <strong>@option.Title</strong>
                                                        <small>@option.Description</small>
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <aside class="tickets-editor-side">
                    <div class="field">
                        <label>Etapa</label>
                        <select @bind="_form.CodigoEstado" disabled="@_saving">
                            @foreach (var state in _lookups.Estados)
                            {
                                <option value="@state.CodigoEstado">@state.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Prioridad</label>
                        <select @bind="_form.Prioridad" disabled="@_saving">
                            <option value="0">Sin prioridad</option>
                            <option value="1">Baja</option>
                            <option value="2">Media</option>
                            <option value="3">Alta</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Asignado a</label>
                        <select @bind="_form.IdTecnico" disabled="@_saving">
                            <option value="">Sin asignar</option>
                            @foreach (var tech in _lookups.Tecnicos)
                            {
                                <option value="@tech.IdTecnico">@tech.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Etiquetas</label>
                        <div class="tickets-tag-picker">
                            @foreach (var tag in _lookups.Etiquetas)
                            {
                                <label class="tickets-tag-option">
                                    <input type="checkbox"
                                           checked="@_formTagIds.Contains(tag.IdEtiqueta)"
                                           @onchange="args => ToggleTicketTag(tag.IdEtiqueta, args)"
                                           disabled="@_saving" />
                                    <span class="tickets-tag-chip" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                                </label>
                            }
                            @if (_lookups.Etiquetas.Count == 0)
                            {
                                <span class="panel-card__subtitle">Todavía no hay etiquetas.</span>
                            }
                        </div>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="OpenTagManager" disabled="@_saving">
                            <i class="bi bi-tags"></i> Administrar etiquetas
                        </button>
                    </div>
                    <div class="field tickets-lookup">
                        <label>Cliente / empresa</label>
                        <input type="text" value="@_ticketClientSearch" @oninput="OnTicketClientSearchInputAsync" disabled="@_saving" placeholder="Buscar cliente..." />
                        @if (!string.IsNullOrWhiteSpace(_selectedClientLabel))
                        {
                            <span class="tickets-lookup__selected">@_selectedClientLabel <button type="button" @onclick="ClearTicketClient" disabled="@_saving"><i class="bi bi-x"></i></button></span>
                        }
                        @if (_ticketClientSuggestions.Count > 0)
                        {
                            <div class="tickets-lookup__results">
                                @foreach (var client in _ticketClientSuggestions)
                                {
                                    <button type="button" @onclick="() => SelectTicketClient(client)" disabled="@_saving">
                                        <strong>@client.RazonSocial</strong>
                                        <small>@client.Codigo @client.Localidad</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="field tickets-lookup">
                        <label>Usuario / contacto</label>
                        <input type="text" value="@_ticketContactSearch" @oninput="OnTicketContactSearchInputAsync" disabled="@_saving" placeholder="Buscar contacto..." />
                        @if (!string.IsNullOrWhiteSpace(_selectedContactLabel))
                        {
                            <span class="tickets-lookup__selected">@_selectedContactLabel <button type="button" @onclick="ClearTicketContact" disabled="@_saving"><i class="bi bi-x"></i></button></span>
                        }
                        @if (_ticketContactSuggestions.Count > 0)
                        {
                            <div class="tickets-lookup__results">
                                @foreach (var contact in _ticketContactSuggestions)
                                {
                                    <button type="button" @onclick="() => SelectTicketContact(contact)" disabled="@_saving">
                                        <strong>@contact.Nombre</strong>
                                        <small>@DisplayOrFallback(contact.ClienteNombre, contact.Email, contact.Celular)</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </aside>
            </div>

        </section>

        @if (!_isNew && _detail is not null)
        {
            <section class="tickets-detail-layout">
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Mensajes incluidos</h3>
                            <p class="panel-card__subtitle">@_detail.MensajesOrigenDetalle.Count mensaje(s) guardados como contexto.</p>
                        </div>
                    </div>
                    @if (_detail.MensajesOrigenDetalle.Count == 0)
                    {
                        <div class="usuarios-empty">Este ticket no tiene mensajes de conversación vinculados.</div>
                    }
                    else
                    {
                        <div class="tickets-message-list">
                            @foreach (var message in _detail.MensajesOrigenDetalle)
                            {
                                <article class="tickets-message">
                                    <div class="tickets-message__meta">
                                        <strong>@message.Autor</strong>
                                        <span>@message.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(message.Texto))
                                    {
                                        <p>@message.Texto</p>
                                    }
                                    @if (message.Adjuntos.Count > 0)
                                    {
                                        <div class="tickets-attachments">
                                            @foreach (var adj in message.Adjuntos)
                                            {
                                                @if (IsImageAttachment(adj))
                                                {
                                                    <a href="@GetAttachmentUrl(adj.IdAdjunto)" target="_blank" class="tickets-attachment tickets-attachment--image">
                                                        <img src="@GetAttachmentUrl(adj.IdAdjunto)" alt="@adj.NombreArchivo" loading="lazy" />
                                                        <span>@GetAttachmentLabel(adj)</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@GetAttachmentDownloadUrl(adj.IdAdjunto)" class="tickets-attachment">
                                                        <i class="bi bi-file-earmark-arrow-down"></i>
                                                        <span>@GetAttachmentLabel(adj)</span>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </div>
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Partes de horas</h3>
                            <p class="panel-card__subtitle">@GetTicketPartesHorasSubtitle()</p>
                        </div>
                    </div>
                    @if (_loadingTicketPartesHoras)
                    {
                        <div class="usuarios-empty">Buscando partes de horas...</div>
                    }
                    else if (_ticketPartesHoras.Count == 0)
                    {
                        <div class="usuarios-empty">Este ticket todavía no tiene partes de horas cargados.</div>
                    }
                    else
                    {
                        <div class="tickets-activity">
                            @foreach (var parte in _ticketPartesHoras)
                            {
                                <div class="tickets-activity__item">
                                    <strong>@FormatParteHoraTicketHours(parte.Minutos) · @parte.TecnicoNombre</strong>
                                    <p>@DisplayOrFallback(parte.Descripcion, "Sin descripción")</p>
                                    <span>@parte.Fecha.ToString("dd/MM/yyyy") · @FormatParteHoraTipoTicket(parte.TipoTrabajo) · @(parte.Facturable ? "Facturable" : "No facturable")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Actividad</h3>
                            <p class="panel-card__subtitle">Notas e historial del ticket.</p>
                        </div>
                    </div>
                    <div class="field">
                        <label>Nueva nota</label>
                        <textarea rows="3" @bind="_newNote"></textarea>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="AgregarNotaAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_newNote))">
                            <i class="bi bi-chat-left-text"></i> Registrar nota
                        </button>
                    </div>
                    <div class="tickets-activity">
                        @foreach (var activity in _detail.Actividad)
                        {
                            <div class="tickets-activity__item">
                                <strong>@activity.TipoActividad</strong>
                                <p>@activity.Descripcion</p>
                                <span>@activity.Usuario · @activity.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    }
    else if (_loading && !HasVisibleTicketData())
    {
        <section class="panel-card"><div class="loading">Cargando tickets...</div></section>
    }
    else if (_viewMode == "kanban")
    {
        @if (IsTicketsUpdating())
        {
            <section class="panel-card">
                <div class="loading"><i class="bi bi-arrow-repeat"></i> Actualizando tickets...</div>
            </section>
        }
        <section class="tickets-kanban" @ref="_kanbanRoot">
            @foreach (var state in _lookups.Estados.OrderBy(x => x.Orden))
            {
                var items = _kanbanItems.Where(x => x.CodigoEstado == state.CodigoEstado).ToList();
                <div class="@GetKanbanColumnClass(state.CodigoEstado)"
                     data-ticket-state="@state.CodigoEstado"
                     @ondragenter="() => MarcarDestinoArrastre(state.CodigoEstado)"
                     @ondragover:preventDefault="true"
                     @ondrop="() => SoltarTicketAsync(state.CodigoEstado)">
                    <div class="tickets-kanban-column__head">
                        <span class="tickets-state-dot" style="background:@state.Color"></span>
                        <strong>@state.Nombre</strong>
                        <small>@items.Count</small>
                    </div>
                    <div class="tickets-kanban-column__body"
                         @ondragenter="() => MarcarDestinoArrastre(state.CodigoEstado)"
                         @ondragover:preventDefault="true"
                         @ondrop="() => SoltarTicketAsync(state.CodigoEstado)">
                        @foreach (var item in items)
                        {
                            <article class="@GetTicketCardClass(item)"
                                     draggable="true"
                                     data-ticket-id="@item.IdTicket"
                                     title="Arrastrá para cambiar de etapa"
                                     @ondragstart="() => IniciarArrastreTicket(item)"
                                     @ondragend="FinalizarArrastreTicketAsync"
                                     @onclick="() => AbrirTicketDesdeKanbanAsync(item.IdTicket)">
                                <div class="tickets-card__head">
                                    <strong>@item.CodigoVisible @item.Titulo</strong>
                                    <span>@RenderPriority(item.Prioridad)</span>
                                </div>
                                <div class="tickets-card__meta">
                                    <span><i class="bi bi-person"></i> @DisplayOrFallback(item.TecnicoNombre, "Sin asignar")</span>
                                    <span><i class="bi bi-building"></i> @DisplayOrFallback(item.ClienteNombre, item.ContactoNombre, "Sin contacto")</span>
                                </div>
                                @if (item.Etiquetas.Count > 0)
                                {
                                    <div class="tickets-tags">
                                        @foreach (var tag in item.Etiquetas)
                                        {
                                            <span style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                                        }
                                    </div>
                                }
                                <div class="tickets-card__footer">
                                    <span>@item.MensajesOrigen mensaje(s)</span>
                                    <span>@item.FechaHoraAlta.ToString("dd/MM HH:mm")</span>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        var visibleColumns = GetVisibleColumns();
        var groups = BuildListGroups();
        <section class="panel-card tickets-list-panel" @ref="_listRoot">
            @if (IsTicketsUpdating())
            {
                <div class="loading"><i class="bi bi-arrow-repeat"></i> Actualizando tickets...</div>
            }
            @if (_listItems.Count == 0)
            {
                <div class="usuarios-empty">No hay tickets para los filtros seleccionados.</div>
            }
            else
            {
                <div class="tickets-list-sticky-head"
                     @onpointermove="ResizeTicketColumn"
                     @onpointerup="FinishTicketColumnResizeAsync"
                     @onpointercancel="FinishTicketColumnResizeAsync">
                    <div class="tickets-list-sticky-head__viewport">
                        <table class="data-table usuarios-table tickets-table tickets-list-head-table" style="@GetTicketsTableStyle(visibleColumns)" data-tickets-list-head>
                            <colgroup>
                                <col class="tickets-selection-col" />
                                @foreach (var col in visibleColumns)
                                {
                                    <col style="width:@GetColumnWidth(col)px" />
                                }
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="tickets-selection-cell">
                                        <input type="checkbox"
                                               data-tickets-select-all
                                               data-partial="@HasPartialVisibleTicketSelection.ToString().ToLowerInvariant()"
                                               checked="@AreAllVisibleTicketsSelected"
                                               aria-label="Seleccionar todos los tickets de esta página"
                                               title="Seleccionar todos los tickets de esta página"
                                               @onchange="ToggleAllVisibleTickets" />
                                    </th>
                                    @foreach (var col in visibleColumns)
                                    {
                                        <th style="width:@GetColumnWidth(col)px">
                                            <button type="button"
                                                    class="@GetTicketSortButtonClass(col.Key)"
                                                    title="@GetTicketSortTitle(col)"
                                                    aria-label="@GetTicketSortTitle(col)"
                                                    @onclick="() => SortTicketsByAsync(col.Key)">
                                                <span>@col.Label</span>
                                                <i class="bi @GetTicketSortIcon(col.Key)"></i>
                                            </button>
                                            <span class="tickets-column-resizer"
                                                  title="Arrastrar para ajustar columna"
                                                  @onpointerdown="args => StartTicketColumnResize(col.Key, args)"
                                                  @onpointerdown:stopPropagation="true"
                                                  @onclick:stopPropagation="true"></span>
                                        </th>
                                    }
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
                <div class="usuarios-table-wrap tickets-table-wrap tickets-list-body"
                     data-tickets-list-body
                     @onpointermove="ResizeTicketColumn"
                     @onpointerup="FinishTicketColumnResizeAsync"
                     @onpointercancel="FinishTicketColumnResizeAsync">
                    <table class="data-table usuarios-table tickets-table" style="@GetTicketsTableStyle(visibleColumns)">
                        <colgroup>
                            <col class="tickets-selection-col" />
                            @foreach (var col in visibleColumns)
                            {
                                <col style="width:@GetColumnWidth(col)px" />
                            }
                        </colgroup>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row"><td colspan="@(visibleColumns.Count + 1)">@group.Label</td></tr>
                                }
                                @foreach (var item in group.Items)
                                {
                                    <tr class="@GetTicketRowClass(item)" @onclick="() => AbrirTicketAsync(item.IdTicket)">
                                        <td class="tickets-selection-cell" @onclick:stopPropagation>
                                            <input type="checkbox"
                                                   checked="@IsTicketSelected(item.IdTicket)"
                                                   aria-label="Seleccionar @item.CodigoVisible"
                                                   @onchange="args => ToggleTicketSelection(item.IdTicket, args)" />
                                        </td>
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td>@RenderColumn(item, col.Key)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
                <div class="table-toolbar">
                    <div class="pagination">
                        <span>@_pagedTotal registro(s)</span>
                        <select @onchange="OnPageSizeChangedAsync" value="@_filters.PageSize">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div class="pagination">
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => CambiarPaginaAsync(_pageNumber - 1)" disabled="@(!_hasPrev)">Anterior</button>
                        <span>Página @_pageNumber / @_totalPages</span>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => CambiarPaginaAsync(_pageNumber + 1)" disabled="@(!_hasNext)">Siguiente</button>
                    </div>
                </div>
            }
        </section>
    }
</section>

@if (_showParteHorasDialog)
{
    <div class="conversations-modal-backdrop conversations-hours-backdrop" @onclick="CancelCloseTicketParteHorasDialog"></div>
    <section class="panel-card conversations-modal conversations-hours-dialog"
             aria-labelledby="tickets-hours-title"
             tabindex="-1"
             @onkeydown="HandleTicketParteHorasDialogKeyDownAsync">
        <div class="conversations-hours-dialog__head">
            <div class="conversations-hours-dialog__title">
                <span class="conversations-hours-dialog__icon"><i class="bi bi-stopwatch"></i></span>
                <div>
                    <h3 id="tickets-hours-title" class="panel-card__title">Parte de horas</h3>
                    <p class="panel-card__subtitle">Estás cerrando @_detail?.CodigoVisible. ¿Cargamos el tiempo trabajado?</p>
                </div>
            </div>
            <button type="button" class="btn btn--ghost btn--sm conversations-hours-dialog__close" @onclick="CancelCloseTicketParteHorasDialog" disabled="@_savingParteHora" aria-label="Cerrar parte de horas">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (_ticketPartesHoras.Count > 0)
        {
            <div class="conversations-hours-hint">
                <i class="bi bi-info-circle"></i>
                <span>Este ticket ya tiene @GetTicketPartesHorasSubtitle().</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_parteHoraError))
        {
            <div class="conversations-error conversations-notice">@_parteHoraError</div>
        }

        <div class="conversations-hours-form">
            <label class="conversations-hours-check">
                <input type="checkbox" @bind="_parteHoraFacturable" disabled="@_savingParteHora" />
                <span>Facturable</span>
            </label>

            <div class="conversations-hours-lines">
                <div class="conversations-hours-lines__header">
                    <span>Técnico</span>
                    <span>Tipo</span>
                    <span>Tarea</span>
                    <span>Horas</span>
                    <span>Minutos</span>
                    <span></span>
                </div>
                <div class="conversations-hours-lines__row">
                    <select @bind="_parteHoraIdTecnico" disabled="@_savingParteHora">
                        <option value="">Sin técnico</option>
                        @foreach (var tecnico in _lookups.Tecnicos)
                        {
                            <option value="@tecnico.IdTecnico">@tecnico.Nombre</option>
                        }
                    </select>
                    <select @bind="_parteHoraTipoTrabajo" disabled="@_savingParteHora">
                        @foreach (var tipo in ParteHoraTipoTrabajoKeys.All)
                        {
                            <option value="@tipo">@FormatParteHoraTipoTicket(tipo)</option>
                        }
                    </select>
                    <input type="text" maxlength="1000" placeholder="Descripción de la tarea" @bind="_parteHoraDescripcion" disabled="@_savingParteHora" />
                    <input type="number" min="0" max="24" step="1" @bind="_parteHoraHoras" disabled="@_savingParteHora" />
                    <input type="number" min="0" max="59" step="1" @bind="_parteHoraMinutos" disabled="@_savingParteHora" />
                    <span></span>
                </div>
            </div>
        </div>

        <div class="actions conversations-hours-actions">
            <button type="button" class="btn btn--primary" @onclick="SaveTicketParteHorasAsync" disabled="@_savingParteHora">
                <i class="bi bi-stopwatch"></i> @(_savingParteHora ? "Guardando..." : "Guardar parte y cerrar")
            </button>
            <button type="button" class="btn btn--ghost" @onclick="CloseTicketWithoutParteHorasAsync" disabled="@_savingParteHora">
                Cerrar sin cargar parte
            </button>
        </div>
    </section>
}

