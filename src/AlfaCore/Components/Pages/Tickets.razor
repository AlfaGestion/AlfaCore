    protected override async Task OnInitializedAsync()
    {
        AppUserSession.StateChanged += OnAppUserSessionChanged;
        Nav.LocationChanged += OnLocationChanged;
        UpdatePageHeader();
        ApplyStartupQuery();
        await EnsureViewSettingsLoadedAsync();
        await CargarLookupsAsync();
        await BuscarAsync();
        if (_startupTicketId.HasValue)
            await AbrirTicketAsync(_startupTicketId.Value);
        UpdatePageHeader();
    }

    public void Dispose()
    {
        AppUserSession.StateChanged -= OnAppUserSessionChanged;
        Nav.LocationChanged -= OnLocationChanged;
        PageHeader.Clear();
        _ = DisposeEditorAsync();
        _kanbanDotNetRef?.Dispose();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            UpdatePageHeader();
            _ticketsEditorJs = await JS.InvokeAsync<IJSObjectReference>("import", "/js/tickets-rich-editor.js?v=20260519i");
            _ticketsKanbanJs = await JS.InvokeAsync<IJSObjectReference>("import", "/js/tickets-kanban.js?v=20260519a");
            _ticketsListJs = await JS.InvokeAsync<IJSObjectReference>("import", "/js/tickets-list.js?v=20260714b");
            _kanbanDotNetRef = DotNetObjectReference.Create(this);
        }

        if (_showEditor && !_descriptionEditorReady && _ticketsEditorJs is not null)
        {
            await _ticketsEditorJs.InvokeVoidAsync("setHtml", _descriptionEditor, _form.Descripcion ?? string.Empty);
            _descriptionEditorReady = true;
        }

        if (!_showEditor && _viewMode == "kanban" && !_loading && !_refreshingTickets && _ticketsKanbanJs is not null && _kanbanDotNetRef is not null)
            await _ticketsKanbanJs.InvokeVoidAsync("wireKanban", _kanbanRoot, _kanbanDotNetRef);

        if (!_showEditor && _viewMode == "lista" && _listItems.Count > 0 && _ticketsListJs is not null)
            await _ticketsListJs.InvokeVoidAsync("wireListHeader", _listRoot);

        if (_showTagManager && _tagManagerFocusPending)
        {
            _tagManagerFocusPending = false;
            await _tagManagerLayer.FocusAsync();
        }

        if (_showViewSettings && _viewSettingsFocusPending)
        {
            _viewSettingsFocusPending = false;
            await _viewSettingsLayer.FocusAsync();
        }
    }

    private void OnAppUserSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await EnsureViewSettingsLoadedAsync(force: true);
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(DismissFeedbackAsync);
        _ = InvokeAsync(ApplyCurrentLocationAsync);
    }

    private void ApplyStartupQuery()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("id", out var rawId) && long.TryParse(rawId.ToString(), out var id) && id > 0)
            _startupTicketId = id;
    }

    private async Task ApplyCurrentLocationAsync()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("id", out var rawId) && long.TryParse(rawId.ToString(), out var id) && id > 0)
        {
            if (!_showEditor || _detail?.IdTicket != id)
                await AbrirTicketAsync(id, updateUrl: false);
            return;
        }

        if (_showEditor && !_isNew)
            CerrarEditor();
    }

    private async Task CargarLookupsAsync()
    {
        var result = await UiOps.RunAsync(() => TicketsSvc.GetLookupsAsync(), "No se pudieron cargar los datos de tickets.");
        if (!result.Success || result.Value is null)
        {
            SetFeedback(result.Feedback);
            return;
        }

        _lookups = result.Value;
        ClearErrorFeedback();
        if (string.IsNullOrWhiteSpace(_form.CodigoEstado))
            _form.CodigoEstado = _lookups.Estados.FirstOrDefault()?.CodigoEstado ?? TicketEstadoKeys.Nuevo;
    }

    private async Task RecargarAsync()
    {
        UpdatePageHeader();
        await CargarLookupsAsync();
        await BuscarAsync(keepCurrent: true);
        if (_detail is not null)
            await AbrirTicketAsync(_detail.IdTicket, updateUrl: false);
        UpdatePageHeader();
    }

