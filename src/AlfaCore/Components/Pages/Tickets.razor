@page "/tickets"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject AlfaCore.Services.ITicketsService TicketsSvc
@inject AlfaCore.Services.IPartesHorasService PartesSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Tickets de asistencia | Alfa Gestión</PageTitle>

<style>
    .tickets-editor-tabs {
        margin: 4px 0 18px;
    }

    .tickets-page select,
    .tickets-page option {
        background: #081220;
        color: var(--text);
    }

    .tickets-page select {
        color-scheme: dark;
    }

    .tickets-view-settings-modal .panel-card__header {
        align-items: flex-start;
    }

    .tickets-view-settings-modal .panel-card__header .actions {
        align-items: center;
        flex-wrap: nowrap;
    }

    .tickets-view-settings-check {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
        margin: 0;
        cursor: pointer;
        color: var(--text);
        font-weight: 700;
    }

    .tickets-view-settings-check input {
        appearance: none;
        width: 18px;
        height: 18px;
        flex: 0 0 18px;
        margin: 0;
        border: 1px solid rgba(148, 163, 184, .55);
        border-radius: 5px;
        background: rgba(2, 6, 23, .72);
        display: grid;
        place-items: center;
        color: #ffffff;
        cursor: pointer;
    }

    .tickets-view-settings-check input::before {
        content: "";
        width: 9px;
        height: 5px;
        border-left: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(-45deg) translate(1px, -1px) scale(0);
        transform-origin: center;
        transition: transform .12s ease;
    }

    .tickets-view-settings-check input:checked {
        border-color: rgba(14, 165, 233, .95);
        background: #0ea5e9;
    }

    .tickets-view-settings-check input:checked::before {
        transform: rotate(-45deg) translate(1px, -1px) scale(1);
    }

    .tickets-view-settings-check input:focus-visible {
        outline: 2px solid rgba(34, 211, 238, .55);
        outline-offset: 2px;
    }

    .tickets-view-settings-check span {
        overflow-wrap: anywhere;
    }

    .tickets-group-toggle {
        width: 100%;
        min-height: 46px;
        border: 0;
        padding: 0 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: transparent;
        color: inherit;
        text-align: left;
        font: inherit;
        font-weight: 800;
        cursor: pointer;
    }

    .tickets-group-toggle i {
        color: var(--muted);
        font-size: .92rem;
    }

    .tickets-group-toggle small {
        margin-left: auto;
        color: var(--muted);
        font-size: .78rem;
        font-weight: 700;
    }

    .tickets-group-toggle:hover,
    .tickets-group-toggle:focus-visible {
        background: rgba(34, 211, 238, .08);
        outline: none;
    }

    .tickets-tag-field__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
    }

    .tickets-tag-field__head label {
        margin: 0;
    }

    .tickets-tag-field__head .btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-grid;
        place-items: center;
    }

    .tickets-activity-panel {
        display: grid;
        gap: 14px;
    }

    .tickets-activity__item strong {
        display: block;
        margin-bottom: 4px;
        text-transform: capitalize;
    }

    .tickets-partes-panel {
        display: grid;
        gap: 16px;
    }

    .tickets-partes-registrados {
        display: grid;
        gap: 10px;
        padding-bottom: 4px;
    }

    .tickets-partes-registrados__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
    }

    .tickets-partes-registrados__head h4 {
        margin: 0;
        color: var(--text);
        font-size: .95rem;
    }

    .tickets-partes-registrados__head span {
        color: var(--muted);
        font-size: .82rem;
    }

    .tickets-partes-registrados__list {
        display: grid;
        gap: 8px;
    }

    .tickets-parte-registrado {
        display: grid;
        grid-template-columns: minmax(92px, .6fr) minmax(130px, .8fr) minmax(110px, .65fr) minmax(80px, .45fr) minmax(220px, 1.6fr) auto;
        gap: 10px;
        align-items: start;
        padding: .72rem .8rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: rgba(255, 255, 255, .025);
    }

    .tickets-parte-registrado span,
    .tickets-parte-registrado strong {
        display: block;
    }

    .tickets-parte-registrado span {
        color: var(--muted);
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .tickets-parte-registrado strong {
        margin-top: 3px;
        color: var(--text);
        font-size: .9rem;
        overflow-wrap: anywhere;
    }

    .tickets-parte-registrado__actions {
        display: flex;
        gap: 6px;
        justify-content: flex-end;
    }

    .tickets-partes-lines {
        display: grid;
        gap: 8px;
    }

    .tickets-partes-lines .partes-lines__header,
    .tickets-partes-lines .partes-lines__row {
        display: grid;
        grid-template-columns: minmax(140px, .8fr) minmax(130px, .75fr) minmax(260px, 2fr) minmax(90px, .45fr) 40px;
        gap: 8px;
        align-items: center;
    }

    .tickets-partes-lines .partes-lines__header {
        color: var(--muted);
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .tickets-partes-lines .partes-lines__row input,
    .tickets-partes-lines .partes-lines__row select {
        width: 100%;
        min-height: 38px;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: rgba(2, 6, 23, .45);
        color: var(--text);
        padding: .55rem .7rem;
    }

    .tickets-partes-lines .partes-lines__row input:focus,
    .tickets-partes-lines .partes-lines__row select:focus {
        outline: 2px solid rgba(34, 211, 238, .45);
        border-color: rgba(34, 211, 238, .9);
    }

    @@media (max-width: 760px) {
        .tickets-partes-lines .partes-lines__header {
            display: none;
        }

        .tickets-partes-lines .partes-lines__row {
            grid-template-columns: 1fr;
        }

        .tickets-parte-registrado {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="page-grid tickets-page tickets-page--odoo" @onclick="HandleTicketPageClickAsync">
    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg editor-msg--animated @GetFeedbackClass(_feedback) @(_feedbackLeaving ? "is-leaving" : string.Empty)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                    @if (IsTicketsInitializationPending(_feedback.Message))
                    {
                        <div class="actions" style="margin-top: .75rem;">
                            <a class="btn btn--primary btn--sm" href="/actualizaciones">
                                <i class="bi bi-cloud-arrow-up"></i> Ir a Actualizaciones
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (!_showEditor)
    {
        <section class="tickets-commandbar">
            <div class="tickets-view-switch">
                <button type="button" class="btn @(_viewMode == "kanban" ? "btn--primary" : "btn--ghost")" @onclick='() => CambiarVistaAsync("kanban")'>
                    <i class="bi bi-kanban"></i> Kanban
                </button>
                <button type="button" class="btn @(_viewMode == "lista" ? "btn--primary" : "btn--ghost")" @onclick='() => CambiarVistaAsync("lista")'>
                    <i class="bi bi-list-ul"></i> Lista
                </button>
            </div>
            <div class="smart-search tickets-smart-search" @onclick:stopPropagation>
                <div class="smart-search__bar">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           placeholder="Buscar por ticket, cliente, contacto, teléfono, email o técnico..."
                           value="@_filters.Texto"
                           @onfocus="OpenTicketSearchPanel"
                           @oninput="OnTicketSearchInput"
                           @onkeydown="HandleTicketApplyKeyDownAsync" />
                    <button type="button" class="smart-search__toggle" @onclick="ToggleTicketSearchPanel" aria-label="Mostrar filtros">
                        <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                    </button>
                </div>

                <div class="smart-search__chips" aria-live="polite">
                    @foreach (var chip in BuildTicketFilterChips())
                    {
                        <button type="button" class="smart-chip" @onclick="() => RemoveTicketChipAsync(chip.Key)">
                            @chip.Label <i class="bi bi-x"></i>
                        </button>
                    }
                    @if (BuildTicketFilterChips().Count == 0)
                    {
                        <span class="smart-search__hint">Filtrá por etapa, prioridad, técnico o reglas personalizadas.</span>
                    }
                </div>

                @if (_showSearchPanel)
                {
                    <div class="tickets-search-backdrop" @onclick="CloseTicketSearchPanel"></div>
                    <div class="smart-search__panel" @onclick="CloseTicketLookupSuggestions" @onclick:stopPropagation @onkeydown="HandleTicketApplyKeyDownAsync">
                        <div class="smart-search__column">
                            <h4><i class="bi bi-funnel-fill"></i> Filtros</h4>
                            <button type="button" class="@GetSmartOptionClass(_filters.IncluirCerrados)" @onclick='() => ToggleTicketClosedAsync(true)'>Todos</button>
                            <button type="button" class="@GetSmartOptionClass(!_filters.IncluirCerrados)" @onclick='() => ToggleTicketClosedAsync(false)'>Abiertos</button>
                            <button type="button" class="@GetSmartOptionClass(_filters.TieneAsignado == false)" @onclick='() => ToggleTicketBoolFilterAsync("sin-asignar")'>Sin asignar</button>
                            <button type="button" class="@GetSmartOptionClass(_filters.TieneMensajes == true)" @onclick='() => ToggleTicketBoolFilterAsync("mensajes")'>Con mensajes</button>
                            <button type="button" class='@GetSmartOptionClass(_filters.FechaRapida == "hoy")' @onclick='() => SetTicketDateFilterAsync("hoy")'>Creados hoy</button>
                            <button type="button" class='@GetSmartOptionClass(_filters.FechaRapida == "recientes")' @onclick='() => SetTicketDateFilterAsync("recientes")'>Actualizados 7 días</button>
                        </div>
                        <div class="smart-search__column">
                            <h4><i class="bi bi-kanban"></i> Soporte</h4>
                            <div class="smart-search__inline">
                                <label>Etapa</label>
                                <select value="@_filters.CodigoEstado" @onchange="OnTicketStateChangedAsync">
                                    <option value="">Todas</option>
                                    @foreach (var state in _lookups.Estados)
                                    {
                                        <option value="@state.CodigoEstado">@state.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>Asignado</label>
                                <select value="@_filters.IdTecnico" @onchange="OnTicketTechChangedAsync">
                                    <option value="">Todos</option>
                                    @foreach (var tech in _lookups.Tecnicos)
                                    {
                                        <option value="@tech.IdTecnico">@tech.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>Prioridad</label>
                                <select value="@_prioridadFiltro" @onchange="OnTicketPriorityChangedAsync">
                                    <option value="">Todas</option>
                                    <option value="3">Alta</option>
                                    <option value="2">Media</option>
                                    <option value="1">Baja</option>
                                    <option value="0">Sin prioridad</option>
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>Etiqueta</label>
                                <select value="@_filters.IdEtiqueta" @onchange="OnTicketTagFilterChangedAsync">
                                    <option value="">Todas</option>
                                    @foreach (var tag in _lookups.Etiquetas)
                                    {
                                        <option value="@tag.IdEtiqueta">@tag.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="smart-search__column">
                            <h4><i class="bi bi-building"></i> Cliente / usuario</h4>
                            <div class="smart-search__inline tickets-lookup" @onclick:stopPropagation>
                                <label>Cliente</label>
                                <input type="text" value="@_filterClientSearch" @oninput="OnFilterClientSearchInputAsync" placeholder="Buscar empresa..." />
                                @if (_filterClientSuggestions.Count > 0)
                                {
                                    <div class="tickets-lookup__results">
                                        @foreach (var client in _filterClientSuggestions)
                                        {
                                            <button type="button" @onclick="() => SelectFilterClientAsync(client)">
                                                <strong>@client.RazonSocial</strong>
                                                <small>@client.Codigo @client.Localidad</small>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="smart-search__inline tickets-lookup" @onclick:stopPropagation>
                                <label>Contacto</label>
                                <input type="text" value="@_filterContactSearch" @oninput="OnFilterContactSearchInputAsync" placeholder="Buscar usuario/contacto..." />
                                @if (_filterContactSuggestions.Count > 0)
                                {
                                    <div class="tickets-lookup__results">
                                        @foreach (var contact in _filterContactSuggestions)
                                        {
                                            <button type="button" @onclick="() => SelectFilterContactAsync(contact)">
                                                <strong>@contact.Nombre</strong>
                                                <small>@DisplayOrFallback(contact.ClienteNombre, contact.Email, contact.Celular)</small>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="smart-search__column">
                            <h4><i class="bi bi-star-fill"></i> Favoritos</h4>
                            <button type="button" @onclick='() => ApplyTicketFavoriteAsync("urgentes")'>Alta prioridad abiertos</button>
                            <button type="button" @onclick='() => ApplyTicketFavoriteAsync("seguimiento")'>Seguimiento soporte</button>
                            <button type="button" @onclick="SaveTicketFavorite">Guardar búsqueda actual</button>
                            <button type="button" @onclick="OpenTagManager">Administrar etiquetas</button>
                            @foreach (var favorite in _ticketFavorites)
                            {
                                <button type="button" @onclick="() => ApplySavedTicketFavoriteAsync(favorite)">@favorite.Label</button>
                            }
                            <div class="actions">
                                <button type="button" class="btn btn--primary btn--sm" @onclick="AplicarFiltrosAsync" disabled="@_loading">
                                    <i class="bi bi-search"></i> Aplicar
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltros" disabled="@_loading">
                                    <i class="bi bi-eraser"></i> Limpiar
                                </button>
                            </div>
                        </div>
                        <div class="smart-search__custom">
                            <h4><i class="bi bi-sliders"></i> Filtro personalizado</h4>
                            <select @bind="_ticketRuleDraft.Campo">
                                <option value="titulo">Título</option>
                                <option value="descripcion">Descripción</option>
                                <option value="cliente">Cliente</option>
                                <option value="contacto">Contacto</option>
                                <option value="tecnico">Técnico</option>
                            </select>
                            <select @bind="_ticketRuleDraft.Operador">
                                <option value="contains">contiene</option>
                                <option value="equals">es igual a</option>
                                <option value="starts">empieza con</option>
                                <option value="empty">está vacío</option>
                                <option value="not-empty">no está vacío</option>
                            </select>
                            <input type="text" placeholder="Valor" @bind="_ticketRuleDraft.Valor" disabled="@IsValueOptionalOperator(_ticketRuleDraft.Operador)" />
                            <button type="button" class="btn btn--primary btn--sm" @onclick="AddTicketRuleAsync">Agregar regla</button>
                        </div>
                    </div>
                }
            </div>
            <div class="actions tickets-commandbar__actions">
                <button type="button" class="btn btn--primary" @onclick="NuevoTicket">
                    <i class="bi bi-plus-circle"></i> Nuevo
                </button>
                <button type="button" class="btn btn--ghost" @onclick="RecargarAsync" disabled="@_loading">
                    <i class="bi bi-arrow-clockwise"></i> Recargar
                </button>
            </div>
        </section>
    }

    @if (_showViewSettings && _viewMode == "lista" && !_showEditor)
    {
        <div class="tickets-view-settings-layer" @ref="_viewSettingsLayer" @onclick="CloseViewSettings" @onkeydown="HandleViewSettingsKeyDown" tabindex="-1">
        <section class="panel-card tickets-view-settings-modal" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configuración de vista</h3>
                    <p class="panel-card__subtitle">Columnas visibles, orden y agrupación del listado.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">
                        <i class="bi bi-floppy"></i> Guardar vista
                    </button>
                    <button type="button" class="btn btn--ghost" @onclick="CloseViewSettings">
                        <i class="bi bi-x-circle"></i> Cerrar
                    </button>
                </div>
            </div>
            <div class="usuarios-view-settings">
                <div class="field">
                    <label>Agrupar por</label>
                    <select @bind="_draftAgruparPor">
                        <option value="@TicketViewGroupKeys.None">Sin agrupar</option>
                        <option value="@TicketViewGroupKeys.Estado">Etapa</option>
                        <option value="@TicketViewGroupKeys.Prioridad">Prioridad</option>
                        <option value="@TicketViewGroupKeys.Tecnico">Asignado</option>
                    </select>
                </div>
                <div class="usuarios-view-settings__list">
                    @foreach (var col in _viewSettingsDraft.OrderBy(c => c.Order))
                    {
                        <div class="usuarios-view-settings__item">
                            <label class="tickets-view-settings-check">
                                <input type="checkbox" checked="@col.Visible" @onchange="args => ToggleViewColumn(col.Key, args)" />
                                <span>@col.Label</span>
                            </label>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(col.Key, -1)"><i class="bi bi-arrow-up"></i></button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(col.Key, 1)"><i class="bi bi-arrow-down"></i></button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
        </div>
    }

    @if (_showTagManager)
    {
        <div class="tickets-tags-modal-layer" @ref="_tagManagerLayer" @onclick="CloseTagManager" @onkeydown="HandleTagManagerKeyDown" tabindex="-1">
        <section class="panel-card tickets-tags-manager" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Etiquetas</h3>
                    <p class="panel-card__subtitle">Clasificá tickets por programación, soporte, capacitación u otros criterios.</p>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="CloseTagManager">
                    <i class="bi bi-x-circle"></i> Cerrar
                </button>
            </div>
            <div class="tickets-tags-manager__body">
                <div class="tickets-tags-manager__form">
                    <div class="field">
                        <label>Nombre</label>
                        <input type="text" maxlength="60" @bind="_tagDraftName" placeholder="Ej.: Soporte" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Color</label>
                        <input type="color" @bind="_tagDraftColor" disabled="@_saving" />
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarEtiquetaAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_tagDraftName))">
                            <i class="bi bi-floppy"></i> @(_tagDraftId > 0 ? "Guardar etiqueta" : "Crear etiqueta")
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="NuevaEtiqueta" disabled="@_saving">
                            <i class="bi bi-plus-circle"></i> Nueva
                        </button>
                    </div>
                </div>
                <div class="tickets-tags-manager__list">
                    @foreach (var tag in _lookups.Etiquetas)
                    {
                        <div class="tickets-tags-manager__item">
                            <span class="tickets-tag-chip" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                            <div class="actions">
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarEtiqueta(tag)" disabled="@_saving">
                                    <i class="bi bi-pencil"></i> Editar
                                </button>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EliminarEtiquetaAsync(tag)" disabled="@_saving">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
        </div>
    }

    @if (_showEditor)
    {
        <section class="panel-card tickets-editor">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@(_isNew ? "Nuevo ticket" : $"{_detail?.CodigoVisible} {_form.Titulo}")</h3>
                    <p class="panel-card__subtitle">@(_isNew ? "Cargá lo mínimo para que soporte lo tome rápido." : BuildDetailSubtitle())</p>
                </div>
                <div class="actions">
                    @if (!_isNew && _detail?.IdConversacion is long idConv)
                    {
                        <a class="btn btn--ghost" href="@($"/conversaciones?id={idConv}")">
                            <i class="bi bi-chat-dots"></i> Ver chat
                        </a>
                    }
                    @if (!_isNew && _detail?.IdContacto is int idContacto)
                    {
                        <a class="btn btn--ghost" href="@($"/contactos?editar={idContacto}")">
                            <i class="bi bi-person-lines-fill"></i> Ver contacto
                        </a>
                    }
                    <button type="button" class="btn btn--ghost" @onclick="CerrarEditor">
                        <i class="bi bi-arrow-left"></i> Volver
                    </button>
                </div>
            </div>

            <div class="contactos-tabs tickets-editor-tabs" role="tablist" aria-label="Detalle de ticket">
                <button type="button" class="cuentas-tab @GetTicketEditorTabClass(TicketEditorTabTicket)" @onclick='() => _ticketEditorTab = TicketEditorTabTicket'>Ticket</button>
                <button type="button" class="cuentas-tab @GetTicketEditorTabClass(TicketEditorTabParteHora)" @onclick="SetTicketParteHoraTab" disabled="@_isNew">Parte de hora</button>
                <button type="button" class="cuentas-tab @GetTicketEditorTabClass(TicketEditorTabActividad)" @onclick="SetTicketActividadTab" disabled="@_isNew">Actividad</button>
            </div>

            @if (_ticketEditorTab == TicketEditorTabTicket)
            {
            <div class="tickets-editor-grid">
                <div class="tickets-editor-main">
                    <div class="field">
                        <label>Nombre del ticket</label>
                        <input type="text" maxlength="180" @bind="_form.Titulo" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label>Descripción</label>
                        <div class="tickets-rich-editor">
                            <div class="tickets-rich-editor__surface"
                                 @ref="_descriptionEditor"
                                 contenteditable="@(!_saving)"
                                 data-placeholder="Escribí / para comandos"
                                 @oninput="OnDescripcionChangedAsync"
                                 @onkeyup="OnDescripcionChangedAsync"
                                 @onfocus="OnDescripcionFocusAsync"></div>
                            <div class="tickets-rich-editor__bar">
                                @foreach (var option in ToolbarDescriptionCommands)
                                {
                                    <button type="button"
                                            class="tickets-rich-editor__tool"
                                            title="@option.Title"
                                            disabled="@_saving"
                                            @onclick="() => RunDescriptionCommandAsync(option)">
                                        <i class="bi @option.Icon"></i>
                                    </button>
                                }
                                <button type="button"
                                        class="tickets-rich-editor__tool"
                                        title="Comandos"
                                        disabled="@_saving"
                                        @onclick="ToggleDescriptionCommands">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                            </div>
                            @if (_showDescriptionCommands)
                            {
                                <div class="tickets-slash-menu">
                                    @foreach (var group in DescriptionCommands.GroupBy(x => x.Group))
                                    {
                                        <div class="tickets-slash-menu__group">
                                            <span>@group.Key</span>
                                            @foreach (var option in group)
                                            {
                                                <button type="button" @onclick="() => RunDescriptionCommandAsync(option)">
                                                    <i class="bi @option.Icon"></i>
                                                    <span>
                                                        <strong>@option.Title</strong>
                                                        <small>@option.Description</small>
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <aside class="tickets-editor-side">
                    <div class="field">
                        <label>Etapa</label>
                        <select @bind="_form.CodigoEstado" @bind:after="AutoGuardarTicketAsync" disabled="@_saving">
                            @foreach (var state in _lookups.Estados)
                            {
                                <option value="@state.CodigoEstado">@state.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Prioridad</label>
                        <select @bind="_form.Prioridad" @bind:after="AutoGuardarTicketAsync" disabled="@_saving">
                            <option value="0">Sin prioridad</option>
                            <option value="1">Baja</option>
                            <option value="2">Media</option>
                            <option value="3">Alta</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Asignado a</label>
                        <select @bind="_form.IdTecnico" @bind:after="AutoGuardarTicketAsync" disabled="@_saving">
                            <option value="">Sin asignar</option>
                            @foreach (var tech in _lookups.Tecnicos)
                            {
                                <option value="@tech.IdTecnico">@tech.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="field tickets-tag-field">
                        <div class="tickets-tag-field__head">
                            <label>Etiquetas</label>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="OpenTagManager" disabled="@_saving" title="Administrar etiquetas" aria-label="Administrar etiquetas">
                                <i class="bi bi-tags"></i>
                            </button>
                        </div>
                        <div class="tickets-tag-picker">
                            @foreach (var tag in _lookups.Etiquetas)
                            {
                                <label class="tickets-tag-option">
                                    <input type="checkbox"
                                           checked="@_formTagIds.Contains(tag.IdEtiqueta)"
                                           @onchange="args => ToggleTicketTagAsync(tag.IdEtiqueta, args)"
                                           disabled="@_saving" />
                                    <span class="tickets-tag-chip" style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                                </label>
                            }
                            @if (_lookups.Etiquetas.Count == 0)
                            {
                                <span class="panel-card__subtitle">Todavía no hay etiquetas.</span>
                            }
                        </div>
                    </div>
                    <div class="field tickets-lookup">
                        <label>Cliente / empresa</label>
                        <input type="text" value="@_ticketClientSearch" @oninput="OnTicketClientSearchInputAsync" disabled="@_saving" placeholder="Buscar cliente..." />
                        @if (!string.IsNullOrWhiteSpace(_selectedClientLabel))
                        {
                            <span class="tickets-lookup__selected">@_selectedClientLabel <button type="button" @onclick="ClearTicketClient" disabled="@_saving"><i class="bi bi-x"></i></button></span>
                        }
                        @if (_ticketClientSuggestions.Count > 0)
                        {
                            <div class="tickets-lookup__results">
                                @foreach (var client in _ticketClientSuggestions)
                                {
                                    <button type="button" @onclick="() => SelectTicketClient(client)" disabled="@_saving">
                                        <strong>@client.RazonSocial</strong>
                                        <small>@client.Codigo @client.Localidad</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="field tickets-lookup">
                        <label>Usuario / contacto</label>
                        <input type="text" value="@_ticketContactSearch" @oninput="OnTicketContactSearchInputAsync" disabled="@_saving" placeholder="Buscar contacto..." />
                        @if (!string.IsNullOrWhiteSpace(_selectedContactLabel))
                        {
                            <span class="tickets-lookup__selected">@_selectedContactLabel <button type="button" @onclick="ClearTicketContact" disabled="@_saving"><i class="bi bi-x"></i></button></span>
                        }
                        @if (_ticketContactSuggestions.Count > 0)
                        {
                            <div class="tickets-lookup__results">
                                @foreach (var contact in _ticketContactSuggestions)
                                {
                                    <button type="button" @onclick="() => SelectTicketContact(contact)" disabled="@_saving">
                                        <strong>@contact.Nombre</strong>
                                        <small>@DisplayOrFallback(contact.ClienteNombre, contact.Email, contact.Celular)</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </aside>
            </div>

            <div class="actions usuarios-editor__actions">
                <button type="button" class="btn btn--primary" @onclick="GuardarAsync" disabled="@_saving">
                    <i class="bi bi-floppy"></i> @(_saving ? "Guardando..." : "Guardar ticket")
                </button>
                <button type="button" class="btn btn--ghost" @onclick="ResetForm" disabled="@_saving">
                    <i class="bi bi-eraser"></i> Revertir
                </button>
            </div>
            }
            else if (_ticketEditorTab == TicketEditorTabActividad && _detail is not null)
            {
                <section class="tickets-activity-panel">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Actividad del ticket</h3>
                            <p class="panel-card__subtitle">Notas, horas y cambios registrados sobre este ticket.</p>
                        </div>
                    </div>
                    <div class="field">
                        <label>Nueva nota</label>
                        <textarea rows="3" @bind="_newNote"></textarea>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="AgregarNotaAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_newNote))">
                            <i class="bi bi-chat-left-text"></i> Registrar nota
                        </button>
                    </div>
                    <div class="tickets-activity">
                        @foreach (var activity in _detail.Actividad)
                        {
                            <div class="tickets-activity__item">
                                <strong>@FormatActivityType(activity.TipoActividad)</strong>
                                <p>@FormatActivityDescription(activity)</p>
                                <span>@activity.Usuario · @activity.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="tickets-partes-panel">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Parte de hora</h3>
                            <p class="panel-card__subtitle">Registrá tiempo trabajado y dejalo vinculado a este ticket.</p>
                        </div>
                    </div>
                    <div class="tickets-partes-registrados">
                        <div class="tickets-partes-registrados__head">
                            <h4>Partes vinculados</h4>
                            <span>@(_loadingTicketPartes ? "Cargando..." : $"{_ticketPartesRegistrados.Count} linea(s)")</span>
                        </div>
                        @if (!_loadingTicketPartes && _ticketPartesRegistrados.Count == 0)
                        {
                            <p class="panel-card__subtitle">Todavia no hay partes de horas vinculados a este ticket.</p>
                        }
                        else if (_ticketPartesRegistrados.Count > 0)
                        {
                            <div class="tickets-partes-registrados__list">
                                @foreach (var parte in _ticketPartesRegistrados)
                                {
                                    <article class="tickets-parte-registrado">
                                        <div>
                                            <span>Fecha</span>
                                            <strong>@parte.Fecha.ToString("dd/MM/yyyy")</strong>
                                        </div>
                                        <div>
                                            <span>Tecnico</span>
                                            <strong>@DisplayOrFallback(parte.TecnicoNombre, parte.Usuario, "Sin tecnico")</strong>
                                        </div>
                                        <div>
                                            <span>Tipo</span>
                                            <strong>@LabelParteTipo(parte.TipoTrabajo)</strong>
                                        </div>
                                        <div>
                                            <span>Horas</span>
                                            <strong>@FormatParteMinutes(parte.Minutos)</strong>
                                        </div>
                                        <div>
                                            <span>Tarea</span>
                                            <strong>@DisplayOrFallback(parte.Descripcion, "Sin descripcion")</strong>
                                        </div>
                                        <div class="tickets-parte-registrado__actions">
                                            <button type="button" class="btn btn--ghost btn--sm" title="Editar parte" aria-label="Editar parte" @onclick="() => EditarParteVinculadoAsync(parte.IdParteHora)" disabled="@_savingParteHora">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" class="btn btn--ghost btn--sm" title="Borrar parte" aria-label="Borrar parte" @onclick="() => BorrarParteVinculadoAsync(parte.IdParteHora)" disabled="@_savingParteHora">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                    <div class="filters-grid filters-grid--wide">
                        <div class="field">
                            <label>Fecha</label>
                            <input type="date" @bind="_ticketParteForm.Fecha" disabled="@_savingParteHora" />
                        </div>
                        <div class="field">
                            <label>Cliente</label>
                            <input type="text" value="@DisplayOrFallback(_detail?.ClienteNombre, _detail?.ClienteCodigo, "Sin cliente")" disabled />
                        </div>
                        <div class="field">
                            <label>Ticket</label>
                            <input type="text" value="@($"{_detail?.CodigoVisible} {_detail?.Titulo}".Trim())" disabled />
                        </div>
                        <div class="field">
                            <label>Contacto / usuario</label>
                            <input type="text" value="@DisplayOrFallback(_detail?.ContactoNombre, _ticketParteForm.Usuario, "Sin contacto")" disabled />
                        </div>
                        <label class="checkbox">
                            <input type="checkbox" @bind="_ticketParteForm.Facturable" disabled="@_savingParteHora" />
                            <span>Facturable</span>
                        </label>
                        <label class="checkbox">
                            <input type="checkbox" @bind="_ticketParteForm.Excedente" disabled="@_savingParteHora" />
                            <span>Excedente</span>
                        </label>
                    </div>

                    <div class="partes-lines tickets-partes-lines">
                        <div class="partes-lines__header">
                            <span>Técnico</span>
                            <span>Tipo</span>
                            <span>Tarea</span>
                            <span>Minutos</span>
                            <span></span>
                        </div>
                        @for (var i = 0; i < _ticketParteLineas.Count; i++)
                        {
                            var index = i;
                            var linea = _ticketParteLineas[index];
                            <div class="partes-lines__row" @key="linea">
                                <select @bind="linea.IdTecnico" disabled="@_savingParteHora">
                                    <option value="">Sin técnico</option>
                                    @foreach (var tecnico in _partesLookups.Tecnicos)
                                    {
                                        <option value="@tecnico.Codigo">@tecnico.Titulo</option>
                                    }
                                </select>
                                <select @bind="linea.TipoTrabajo" disabled="@_savingParteHora">
                                    @foreach (var tipo in GetTicketParteTiposVisibles())
                                    {
                                        <option value="@tipo">@LabelParteTipo(tipo)</option>
                                    }
                                </select>
                                <input type="text"
                                       id="@GetTicketParteLineaDescripcionId(index)"
                                       @bind="linea.Descripcion"
                                       maxlength="1000"
                                       @onkeydown="args => HandleTicketParteLineaKeyDownAsync(args, index)"
                                       disabled="@_savingParteHora"
                                       placeholder="Descripción de la tarea" />
                                <input type="number" min="1" max="1440" step="5" @bind="linea.Minutos" disabled="@_savingParteHora" />
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => RemoveTicketParteLinea(index)" disabled="@(_savingParteHora || _ticketParteLineas.Count <= 1)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                        <div class="actions">
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="AddTicketParteLinea" disabled="@_savingParteHora">
                                <i class="bi bi-plus-circle"></i> Agregar línea
                            </button>
                        </div>
                    </div>

                    <div class="actions usuarios-editor__actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarParteHoraTicketAsync" disabled="@(_savingParteHora || _detail is null)">
                            <i class="bi bi-stopwatch"></i> @(_savingParteHora ? "Guardando..." : (_editingTicketParteHoraId.HasValue ? "Actualizar parte" : "Guardar parte"))
                        </button>
                        <button type="button" class="btn btn--ghost" @onclick="ResetTicketParteHoraForm" disabled="@_savingParteHora">
                            <i class="bi bi-eraser"></i> @(_editingTicketParteHoraId.HasValue ? "Cancelar edicion" : "Limpiar")
                        </button>
                    </div>
                </section>
            }
        </section>

        @if (!_isNew && _detail is not null && _ticketEditorTab == TicketEditorTabTicket)
        {
            <section class="tickets-detail-layout">
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h3 class="panel-card__title">Mensajes incluidos</h3>
                            <p class="panel-card__subtitle">@_detail.MensajesOrigenDetalle.Count mensaje(s) guardados como contexto.</p>
                        </div>
                    </div>
                    @if (_detail.MensajesOrigenDetalle.Count == 0)
                    {
                        <div class="usuarios-empty">Este ticket no tiene mensajes de conversación vinculados.</div>
                    }
                    else
                    {
                        <div class="tickets-message-list">
                            @foreach (var message in _detail.MensajesOrigenDetalle)
                            {
                                <article class="tickets-message">
                                    <div class="tickets-message__meta">
                                        <strong>@message.Autor</strong>
                                        <span>@message.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(message.Texto))
                                    {
                                        <p>@message.Texto</p>
                                    }
                                    @if (message.Adjuntos.Count > 0)
                                    {
                                        <div class="tickets-attachments">
                                            @foreach (var adj in message.Adjuntos)
                                            {
                                                @if (IsImageAttachment(adj))
                                                {
                                                    <a href="@GetAttachmentUrl(adj.IdAdjunto)" target="_blank" class="tickets-attachment tickets-attachment--image">
                                                        <img src="@GetAttachmentUrl(adj.IdAdjunto)" alt="@adj.NombreArchivo" loading="lazy" />
                                                        <span>@GetAttachmentLabel(adj)</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@GetAttachmentDownloadUrl(adj.IdAdjunto)" class="tickets-attachment">
                                                        <i class="bi bi-file-earmark-arrow-down"></i>
                                                        <span>@GetAttachmentLabel(adj)</span>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    }
    else if (_loading && !HasVisibleTicketData())
    {
        <section class="panel-card"><div class="loading">Cargando tickets...</div></section>
    }
    else if (_viewMode == "kanban")
    {
        @if (IsTicketsUpdating())
        {
            <section class="panel-card">
                <div class="loading"><i class="bi bi-arrow-repeat"></i> Actualizando tickets...</div>
            </section>
        }
        <section class="tickets-kanban" @ref="_kanbanRoot">
            @foreach (var state in _lookups.Estados.OrderBy(x => x.Orden))
            {
                var items = _kanbanItems.Where(x => x.CodigoEstado == state.CodigoEstado).ToList();
                <div class="@GetKanbanColumnClass(state.CodigoEstado)"
                     data-ticket-state="@state.CodigoEstado"
                     @ondragenter="() => MarcarDestinoArrastre(state.CodigoEstado)"
                     @ondragover:preventDefault="true"
                     @ondrop="() => SoltarTicketAsync(state.CodigoEstado)">
                    <div class="tickets-kanban-column__head">
                        <span class="tickets-state-dot" style="background:@state.Color"></span>
                        <strong>@state.Nombre</strong>
                        <small>@items.Count</small>
                    </div>
                    <div class="tickets-kanban-column__body"
                         @ondragenter="() => MarcarDestinoArrastre(state.CodigoEstado)"
                         @ondragover:preventDefault="true"
                         @ondrop="() => SoltarTicketAsync(state.CodigoEstado)">
                        @foreach (var item in items)
                        {
                            <article class="@GetTicketCardClass(item)"
                                     draggable="true"
                                     data-ticket-id="@item.IdTicket"
                                     title="Arrastrá para cambiar de etapa"
                                     @ondragstart="() => IniciarArrastreTicket(item)"
                                     @ondragend="FinalizarArrastreTicketAsync"
                                     @onclick="() => AbrirTicketDesdeKanbanAsync(item.IdTicket)">
                                <div class="tickets-card__head">
                                    <strong>@item.CodigoVisible @item.Titulo</strong>
                                    <span>@RenderPriority(item.Prioridad)</span>
                                </div>
                                <div class="tickets-card__meta">
                                    <span><i class="bi bi-person"></i> @DisplayOrFallback(item.TecnicoNombre, "Sin asignar")</span>
                                    <span><i class="bi bi-building"></i> @DisplayOrFallback(item.ClienteNombre, item.ContactoNombre, "Sin contacto")</span>
                                </div>
                                @if (item.Etiquetas.Count > 0)
                                {
                                    <div class="tickets-tags">
                                        @foreach (var tag in item.Etiquetas)
                                        {
                                            <span style="border-color:@tag.Color;color:@tag.Color">@tag.Nombre</span>
                                        }
                                    </div>
                                }
                                <div class="tickets-card__footer">
                                    <span>@item.MensajesOrigen mensaje(s)</span>
                                    <span>@item.FechaHoraAlta.ToString("dd/MM HH:mm")</span>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        var visibleColumns = GetVisibleColumns();
        var groups = BuildListGroups();
        <section class="panel-card">
            @if (IsTicketsUpdating())
            {
                <div class="loading"><i class="bi bi-arrow-repeat"></i> Actualizando tickets...</div>
            }
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Listado</h3>
                    <p class="panel-card__subtitle">@_pagedTotal registro(s) · Página @_pageNumber de @_totalPages</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="AbrirConfiguracionVista">
                        <i class="bi bi-sliders"></i> Configurar vista
                    </button>
                </div>
            </div>
            @if (_listItems.Count == 0)
            {
                <div class="usuarios-empty">No hay tickets para los filtros seleccionados.</div>
            }
            else
            {
                <div class="usuarios-table-wrap tickets-table-wrap"
                     @onpointermove="ResizeTicketColumn"
                     @onpointerup="FinishTicketColumnResizeAsync"
                     @onpointercancel="FinishTicketColumnResizeAsync">
                    <table class="data-table usuarios-table tickets-table" style="@GetTicketsTableStyle(visibleColumns)">
                        <colgroup>
                            @foreach (var col in visibleColumns)
                            {
                                <col style="width:@GetColumnWidth(col)px" />
                            }
                        </colgroup>
                        <thead>
                            <tr>
                                @foreach (var col in visibleColumns)
                                {
                                    <th style="width:@GetColumnWidth(col)px">
                                        <span>@col.Label</span>
                                        <span class="tickets-column-resizer"
                                              title="Arrastrar para ajustar columna"
                                              @onpointerdown="args => StartTicketColumnResize(col.Key, args)"
                                              @onpointerdown:stopPropagation="true"
                                              @onclick:stopPropagation="true"></span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@visibleColumns.Count">
                                            <button type="button"
                                                    class="tickets-group-toggle"
                                                    @onclick="() => ToggleListGroup(group.Key)"
                                                    aria-expanded="@(!IsListGroupCollapsed(group.Key))">
                                                <i class="bi @(IsListGroupCollapsed(group.Key) ? "bi-chevron-right" : "bi-chevron-down")"></i>
                                                <span>@group.Label</span>
                                                <small>@group.Items.Count ticket(s)</small>
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!group.ShowHeader || !IsListGroupCollapsed(group.Key))
                                {
                                    @foreach (var item in group.Items)
                                    {
                                        <tr class="@GetTicketRowClass(item)" @onclick="() => AbrirTicketAsync(item.IdTicket)">
                                            @foreach (var col in visibleColumns)
                                            {
                                                <td>@RenderColumn(item, col.Key)</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        }
                    </table>
                </div>
                <div class="table-toolbar">
                    <div class="pagination">
                        <span>@_pagedTotal registro(s)</span>
                        <select @onchange="OnPageSizeChangedAsync" value="@_filters.PageSize">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div class="pagination">
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => CambiarPaginaAsync(_pageNumber - 1)" disabled="@(!_hasPrev)">Anterior</button>
                        <span>Página @_pageNumber / @_totalPages</span>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => CambiarPaginaAsync(_pageNumber + 1)" disabled="@(!_hasNext)">Siguiente</button>
                    </div>
                </div>
            }
        </section>
    }
</section>

@code {
    private sealed class TicketParteHoraLineaForm
    {
        public string IdTecnico { get; set; } = string.Empty;
        public string TipoTrabajo { get; set; } = ParteHoraTipoTrabajoKeys.Soporte;
        public string Descripcion { get; set; } = string.Empty;
        public int Minutos { get; set; } = 15;
    }

    private const string TicketEditorTabTicket = "ticket";
    private const string TicketEditorTabParteHora = "parte-hora";
    private const string TicketEditorTabActividad = "actividad";

    private TicketLookupDto _lookups = new();
    private ParteHoraLookupDto _partesLookups = new();
    private TicketsFilters _filters = new();
    private string _prioridadFiltro = string.Empty;
    private string _viewMode = "kanban";
    private bool _loading;
    private bool _refreshingTickets;
    private bool _saving;
    private bool _savingParteHora;
    private bool _loadingTicketPartes;
    private bool _showEditor;
    private bool _isNew;
    private bool _showViewSettings;
    private bool _showTagManager;
    private List<TicketGridItemDto> _kanbanItems = [];
    private List<TicketGridItemDto> _listItems = [];
    private TicketDetailDto? _detail;
    private AppUiMessage? _feedback;
