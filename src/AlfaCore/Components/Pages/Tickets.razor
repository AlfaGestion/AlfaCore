    private static string FormatParteMinutes(int minutes)
    {
        var safe = Math.Max(0, minutes);
        return $"{safe / 60}h {safe % 60:00}m";
    }

    private static string FormatActivityType(string value) => value switch
    {
        "EDICION" => "Edición",
        "CAMBIO" => "Cambio",
        "HORAS" => "Horas",
        "NOTA" => "Nota",
        "CREACION" => "Creación",
        _ => string.IsNullOrWhiteSpace(value) ? "Actividad" : value.ToLowerInvariant()
    };

    private static string FormatActivityDescription(TicketActividadDto activity)
    {
        if (string.IsNullOrWhiteSpace(activity.Descripcion))
            return "Movimiento registrado.";

        if (string.Equals(activity.TipoActividad, "EDICION", StringComparison.OrdinalIgnoreCase)
            && activity.Descripcion.StartsWith("Ticket actualizado.", StringComparison.OrdinalIgnoreCase))
            return activity.Descripcion.Length > "Ticket actualizado.".Length
                ? $"Ticket actualizado - {activity.Descripcion["Ticket actualizado.".Length..].Trim(' ', '-', '.')}"
                : "Ticket actualizado.";

        return activity.Descripcion;
    }

