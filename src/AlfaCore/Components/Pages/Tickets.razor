    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();
        if (_showEditor)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "guardar",
                Label = _saving ? "Guardando..." : "Guardar",
                Icon = "bi-floppy",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                Busy = _saving,
                OnClick = GuardarAsync
            });
            actions.Add(new PageHeaderAction
            {
                Key = "cancelar",
                Label = "Cancelar",
                Icon = "bi-x-circle",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _saving,
                OnClick = () => { CerrarEditor(); return Task.CompletedTask; }
            });
        }
        else if (HasTicketSelection)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "cambiar-etapa",
                Label = "Cambiar etapa",
                Icon = "bi-arrow-left-right",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _bulkUpdating,
                OnClick = () => { OpenBulkAction(BulkActionEstado); return Task.CompletedTask; }
            });
            actions.Add(new PageHeaderAction
            {
                Key = "asignar",
                Label = "Asignar",
                Icon = "bi-person-check",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _bulkUpdating,
                OnClick = () => { OpenBulkAction(BulkActionTecnico); return Task.CompletedTask; }
            });
            actions.Add(new PageHeaderAction
            {
                Key = "prioridad",
                Label = "Prioridad",
                Icon = "bi-flag",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Normal,
                Disabled = _bulkUpdating,
                OnClick = () => { OpenBulkAction(BulkActionPrioridad); return Task.CompletedTask; }
            });
            actions.Add(new PageHeaderAction
            {
                Key = "limpiar-seleccion",
                Label = "Quitar selección",
                Icon = "bi-x-circle",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                Disabled = _bulkUpdating,
                OnClick = () => { ClearTicketSelection(); return Task.CompletedTask; }
            });
        }
        else
        {
            actions.Add(new PageHeaderAction
            {
                Key = "nuevo",
                Label = "Nuevo",
                Icon = "bi-plus-circle",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                OnClick = () => { NuevoTicket(); return Task.CompletedTask; }
            });
            actions.Add(new PageHeaderAction
            {
                Key = "recargar",
                Label = "Recargar",
                Icon = "bi-arrow-clockwise",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _loading,
                OnClick = RecargarAsync
            });
            if (_viewMode == "lista")
            {
                actions.Add(new PageHeaderAction
                {
                    Key = "vista",
                    Label = "Configurar vista",
                    Icon = "bi-sliders",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Overflow,
                    OnClick = () => { AbrirConfiguracionVista(); return Task.CompletedTask; }
                });
            }
            actions.Add(new PageHeaderAction
            {
                Key = "etiquetas",
                Label = "Administrar etiquetas",
                Icon = "bi-tags",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Overflow,
                OnClick = () => { OpenTagManager(); return Task.CompletedTask; }
            });
        }

        var title = _showEditor
            ? _isNew ? "Nuevo ticket" : $"{_detail?.CodigoVisible} {_form.Titulo}".Trim()
            : HasTicketSelection
                ? $"{_selectedTicketIds.Count} ticket{(_selectedTicketIds.Count == 1 ? string.Empty : "s")} seleccionado{(_selectedTicketIds.Count == 1 ? string.Empty : "s")}"
                : "Tickets";

        PageHeader.Set(new PageHeaderConfig
        {
            Title = title,
            Breadcrumb = ["Soporte", "Tickets"],
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildTickets(RouteContext, Nav, "mesadeayuda"),
            State = _saving
                ? PageHeaderState.Loading
                : _showEditor
                    ? (_isNew ? PageHeaderState.Creating : PageHeaderState.Editing)
                    : HasTicketSelection
                        ? PageHeaderState.Selection
                        : _viewMode == "kanban" ? PageHeaderState.Kanban : PageHeaderState.List,
            OnBack = _showEditor && _isNew ? new Func<Task>(() => { CerrarEditor(); return Task.CompletedTask; }) : null,
            Search = _showEditor ? null : new PageHeaderSearchConfig(),
            SearchContent = _showEditor ? null : RenderTicketSmartSearch(),
            ViewButtons = _showEditor || HasTicketSelection
                ? []
                :
                [
                    new PageHeaderViewButton
                    {
                        Key = "kanban",
                        Label = "Kanban",
                        Icon = "bi-kanban",
                        Active = _viewMode == "kanban",
                        Disabled = _loading,
                        OnClick = () => CambiarVistaAsync("kanban")
                    },
                    new PageHeaderViewButton
                    {
                        Key = "lista",
                        Label = "Lista",
                        Icon = "bi-list-ul",
                        Active = _viewMode == "lista",
                        Disabled = _loading,
                        OnClick = () => CambiarVistaAsync("lista")
                    }
                ],
            Actions = actions
        });
        _ = InvokeAsync(StateHasChanged);
    }

    private string _ticketClientSearch = string.Empty;
    private string _ticketContactSearch = string.Empty;
