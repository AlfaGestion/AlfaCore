    private void QueueTicketPartesHorasLoad(long idTicket)
    {
        _ticketPartesHoras = [];
        _loadingTicketPartesHoras = true;
        _ = InvokeAsync(async () =>
        {
            await LoadTicketPartesHorasAsync(idTicket);
            StateHasChanged();
        });
    }

    private async Task LoadTicketPartesHorasAsync(long idTicket)
    {
        try
        {
            var result = await PartesHorasSvc.SearchAsync(new PartesHorasFilters
            {
                IdTicket = idTicket,
                FechaDesde = null,
                FechaHasta = null,
                PageSize = 100
            });

            if (_detail?.IdTicket == idTicket)
                _ticketPartesHoras = result.Items.ToList();
        }
        catch
        {
            if (_detail?.IdTicket == idTicket)
                _ticketPartesHoras = [];
        }
        finally
        {
            if (_detail?.IdTicket == idTicket)
                _loadingTicketPartesHoras = false;
        }
    }

    private string GetTicketPartesHorasSubtitle()
    {
        if (_loadingTicketPartesHoras)
            return "Buscando partes de horas...";
        if (_ticketPartesHoras.Count == 0)
            return "Sin partes de horas cargados.";

        var totalMinutos = _ticketPartesHoras.Sum(x => x.Minutos);
        return _ticketPartesHoras.Count == 1
            ? $"1 parte cargado · {FormatParteHoraTicketHours(totalMinutos)}"
            : $"{_ticketPartesHoras.Count} partes cargados · {FormatParteHoraTicketHours(totalMinutos)}";
    }

    private static string FormatParteHoraTicketHours(int minutes)
    {
        minutes = Math.Clamp(minutes, 0, 24 * 60 * 30);
        var hours = minutes / 60;
        var remaining = minutes % 60;
        return hours > 0
            ? remaining > 0 ? $"{hours}h {remaining}m" : $"{hours}h"
            : $"{remaining}m";
    }

    private static string FormatParteHoraTipoTicket(string tipo)
        => tipo switch
        {
            ParteHoraTipoTrabajoKeys.Soporte => "Soporte",
            ParteHoraTipoTrabajoKeys.Desarrollo => "Desarrollo",
            ParteHoraTipoTrabajoKeys.Implementacion => "Implementación",
            ParteHoraTipoTrabajoKeys.Capacitacion => "Capacitación",
            ParteHoraTipoTrabajoKeys.Reunion => "Reunión",
            ParteHoraTipoTrabajoKeys.Viaje => "Viaje",
            ParteHoraTipoTrabajoKeys.Interno => "Interno",
            _ => tipo
        };

