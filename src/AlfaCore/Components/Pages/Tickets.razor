            _saving = false;
        }
    }

    private async Task EliminarEtiquetaAsync(TicketEtiquetaDto tag)
    {
        _saving = true;
        try
        {
            var result = await UiOps.RunAsync(async () =>
            {
                await TicketsSvc.DeleteEtiquetaAsync(new TicketEtiquetaDeleteRequest
                {
                    IdEtiqueta = tag.IdEtiqueta,
                    UsuarioAccion = CurrentUserName
                });
                return true;
            }, "No se pudo eliminar la etiqueta.");

            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _formTagIds.Remove(tag.IdEtiqueta);
            if (_filters.IdEtiqueta == tag.IdEtiqueta)
                _filters.IdEtiqueta = null;
            await CargarLookupsAsync();
            await BuscarAsync(keepCurrent: true);
            NuevaEtiqueta();
            SetFeedback(AppUiMessage.Success("Etiqueta eliminada", "La etiqueta se desactivó y ya no aparece para nuevos filtros."));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task GuardarAsync()
    {
        _saving = true;
        try
        {
            await SyncDescriptionFromEditorAsync();
            if (_isNew)
            {
                var create = new TicketCreateRequest
                {
                    Titulo = _form.Titulo,
                    Descripcion = _form.Descripcion,
                    CodigoEstado = _form.CodigoEstado,
                    Prioridad = _form.Prioridad,
                    IdTecnico = _form.IdTecnico,
                    ClienteCodigo = _form.ClienteCodigo,
                    IdContacto = _form.IdContacto,
                    IdEtiquetas = _formTagIds.ToList(),
                    UsuarioAccion = CurrentUserName
                };
                var result = await UiOps.RunAsync(() => TicketsSvc.CreateAsync(create), "No se pudo crear el ticket.");
                if (!result.Success) { SetFeedback(result.Feedback); return; }
                SetFeedback(AppUiMessage.Success("Ticket creado", "El ticket quedó listo para el equipo de soporte."));
                await BuscarAsync();
                await AbrirTicketAsync(result.Value);
            }
            else if (IsClosingTicketTransition(_detail?.CodigoEstado, _form.CodigoEstado))
            {
                PromptCloseTicketParteHoras(_form.CodigoEstado);
            }
            else
            {
                await PersistTicketUpdateAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private bool IsClosingTicketTransition(string? previousCode, string? nextCode)
    {
        if (string.Equals(previousCode, nextCode, StringComparison.OrdinalIgnoreCase))
            return false;

        var wasClosed = _lookups.Estados.FirstOrDefault(x => string.Equals(x.CodigoEstado, previousCode, StringComparison.OrdinalIgnoreCase))?.EsCerrado ?? false;
        var willBeClosed = _lookups.Estados.FirstOrDefault(x => string.Equals(x.CodigoEstado, nextCode, StringComparison.OrdinalIgnoreCase))?.EsCerrado ?? false;
        return !wasClosed && willBeClosed;
    }

    private void PromptCloseTicketParteHoras(string closeStatusCode)
    {
        if (_detail is null)
            return;

        _parteHoraPendingCloseStatusCode = closeStatusCode;
        _form.CodigoEstado = _detail.CodigoEstado;

        _parteHoraIdTecnico = _form.IdTecnico ?? string.Empty;
        _parteHoraTipoTrabajo = ParteHoraTipoTrabajoKeys.Soporte;
        _parteHoraDescripcion = _detail.Titulo;
        _parteHoraHoras = 0;
        _parteHoraMinutos = 30;
        _parteHoraFacturable = true;
        _parteHoraError = null;
        _showParteHorasDialog = true;
    }

