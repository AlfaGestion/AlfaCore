    private async Task AddTicketRuleAsync()
    {
        if (!IsValueOptionalOperator(_ticketRuleDraft.Operador) && string.IsNullOrWhiteSpace(_ticketRuleDraft.Valor))
            return;

        _filters.Reglas.Add(new SearchRuleDto
        {
            Campo = _ticketRuleDraft.Campo,
            Operador = _ticketRuleDraft.Operador,
            Valor = _ticketRuleDraft.Valor
        });
        _ticketRuleDraft = new SearchRuleDto { Campo = "titulo", Operador = "contains" };
        await AplicarFiltrosAsync();
    }

    private async Task RemoveTicketChipAsync(string key)
    {
        switch (key)
        {
            case "texto":
                _filters.Texto = string.Empty;
                break;
            case "estado":
                _filters.CodigoEstado = null;
                break;
            case "tecnico":
                _filters.IdTecnico = null;
                break;
            case "prioridad":
                _prioridadFiltro = string.Empty;
                _filters.Prioridad = null;
                break;
            case "cerrados":
                _filters.IncluirCerrados = false;
                break;
            case "asignado":
                _filters.TieneAsignado = null;
                break;
            case "mensajes":
                _filters.TieneMensajes = null;
                break;
            case "fecha":
                _filters.FechaRapida = string.Empty;
                break;
            default:
                if (key.StartsWith("rule:", StringComparison.OrdinalIgnoreCase)
                    && int.TryParse(key[5..], out var index)
                    && index >= 0
                    && index < _filters.Reglas.Count)
                {
                    _filters.Reglas.RemoveAt(index);
                }
                break;
        }

        await AplicarFiltrosAsync();
    }

    private async Task ApplyTicketFavoriteAsync(string key)
    {
        if (key == "urgentes")
        {
            _filters.IncluirCerrados = false;
            _prioridadFiltro = "3";
            _filters.TieneMensajes = null;
            _filters.TieneAsignado = null;
        }
        else if (key == "seguimiento")
        {
            _filters.IncluirCerrados = false;
            _filters.TieneMensajes = true;
            _filters.FechaRapida = "recientes";
        }

        await AplicarFiltrosAsync();
    }

    private void SaveTicketFavorite()
    {
        var chips = BuildTicketFilterChips();
        var label = chips.Count == 0 ? "Tickets sin filtros" : string.Join(" + ", chips.Take(2).Select(c => c.Label));
        _ticketFavorites.Add(new SavedTicketSearch(label, CloneTicketFilters(_filters), _prioridadFiltro));
    }

    private async Task ApplySavedTicketFavoriteAsync(SavedTicketSearch favorite)
    {
        _filters = CloneTicketFilters(favorite.Filters);
        _prioridadFiltro = favorite.PrioridadFiltro;
        await AplicarFiltrosAsync();
    }

    private async Task AplicarFiltrosAsync()
    {
        SyncFilters();
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _loading = true;
        SyncFilters();
        try
        {
            if (_viewMode == "kanban")
            {
                var result = await UiOps.RunAsync(() => TicketsSvc.GetKanbanAsync(_filters), "No se pudo cargar la vista kanban.");
                if (!result.Success || result.Value is null) { SetFeedback(result.Feedback); return; }
                _kanbanItems = result.Value.ToList();
                ClearErrorFeedback();
            }
            else
            {
                var result = await UiOps.RunAsync(() => TicketsSvc.SearchAsync(_filters), "No se pudo cargar el listado.");
                if (!result.Success || result.Value is null) { SetFeedback(result.Feedback); return; }
                _listItems = result.Value.Items.ToList();
                _pagedTotal = result.Value.Total;
                _pageNumber = result.Value.PageNumber;
                _totalPages = result.Value.TotalPages;
                _hasPrev = result.Value.HasPrev;
                _hasNext = result.Value.HasNext;
                ClearErrorFeedback();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page > _totalPages || _loading)
            return;
        _filters.PageNumber = page;
        await BuscarAsync();
    }

