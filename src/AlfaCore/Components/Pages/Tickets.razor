    private bool IsTicketSelected(long idTicket)
        => _selectedTicketIds.Contains(idTicket);

    private void ToggleTicketSelection(long idTicket, ChangeEventArgs args)
    {
        if (args.Value is true)
            _selectedTicketIds.Add(idTicket);
        else
            _selectedTicketIds.Remove(idTicket);

        if (_selectedTicketIds.Count == 0)
            CloseBulkAction();
        UpdatePageHeader();
    }

    private void ToggleAllVisibleTickets(ChangeEventArgs args)
    {
        var selected = args.Value is true;
        foreach (var item in _listItems)
        {
            if (selected)
                _selectedTicketIds.Add(item.IdTicket);
            else
                _selectedTicketIds.Remove(item.IdTicket);
        }

        if (_selectedTicketIds.Count == 0)
            CloseBulkAction();
        UpdatePageHeader();
    }

    private void ClearTicketSelection(bool updateHeader = true)
    {
        _selectedTicketIds.Clear();
        CloseBulkAction();
        if (updateHeader)
            UpdatePageHeader();
    }

    private void OpenBulkAction(string action)
    {
        if (!HasTicketSelection)
            return;

        _bulkAction = action;
        _bulkValue = action switch
        {
            BulkActionEstado => _lookups.Estados.OrderBy(x => x.Orden).FirstOrDefault()?.CodigoEstado ?? string.Empty,
            BulkActionPrioridad => "1",
            _ => string.Empty
        };
        _showBulkAction = true;
    }

    private void CloseBulkAction()
    {
        if (_bulkUpdating)
            return;

        _showBulkAction = false;
        _bulkAction = string.Empty;
        _bulkValue = string.Empty;
    }

    private async Task ApplyBulkActionAsync()
    {
        if (!HasTicketSelection || _bulkUpdating)
            return;

        var request = new TicketBulkUpdateRequest
        {
            IdTickets = _selectedTicketIds.ToList(),
            UsuarioAccion = CurrentUserName
        };

        switch (_bulkAction)
        {
            case BulkActionEstado:
                request.CodigoEstado = _bulkValue;
                break;
            case BulkActionTecnico:
                request.ActualizarTecnico = true;
                request.IdTecnico = _bulkValue;
                break;
            case BulkActionPrioridad when int.TryParse(_bulkValue, out var prioridad):
                request.Prioridad = prioridad;
                break;
            default:
                return;
        }

        _bulkUpdating = true;
        UpdatePageHeader();
        try
        {
            var selectedCount = request.IdTickets.Count;
            var result = await UiOps.RunAsync(async () =>
            {
                await TicketsSvc.BulkUpdateAsync(request);
                return true;
            }, "No se pudieron actualizar los tickets seleccionados.");

            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _showBulkAction = false;
            _bulkAction = string.Empty;
            _bulkValue = string.Empty;
            _selectedTicketIds.Clear();
            SetFeedback(AppUiMessage.Success("Tickets actualizados", $"La acción se aplicó a {selectedCount} ticket(s)."));
            await BuscarAsync(keepCurrent: true);
        }
        finally
        {
            _bulkUpdating = false;
            UpdatePageHeader();
        }
    }

