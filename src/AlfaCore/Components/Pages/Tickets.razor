        => _showSearchPanel = true;

    private void ToggleTicketSearchPanel()
        => _showSearchPanel = !_showSearchPanel;

    private void OnTicketSearchInput(ChangeEventArgs e)
    {
        _filters.Texto = e.Value?.ToString() ?? string.Empty;
        DebounceTicketSearch();
    }

    private void DebounceTicketSearch()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounceCts = cts;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(300, cts.Token);
                if (cts.IsCancellationRequested)
                    return;
                _filters.PageNumber = 1;
                await BuscarAsync();
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

