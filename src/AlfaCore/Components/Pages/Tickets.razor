    private async Task AddTicketRuleAsync()
    {
        if (!IsValueOptionalOperator(_ticketRuleDraft.Operador) && string.IsNullOrWhiteSpace(_ticketRuleDraft.Valor))
            return;

        _filters.Reglas.Add(new SearchRuleDto
        {
            Campo = _ticketRuleDraft.Campo,
            Operador = _ticketRuleDraft.Operador,
            Valor = _ticketRuleDraft.Valor
        });
        _ticketRuleDraft = new SearchRuleDto { Campo = "titulo", Operador = "contains" };
        await AplicarFiltrosAsync();
    }

    private async Task RemoveTicketChipAsync(string key)
    {
        switch (key)
        {
            case "texto":
                _filters.Texto = string.Empty;
                break;
            case "estado":
                _filters.CodigoEstado = null;
                break;
            case "tecnico":
                _filters.IdTecnico = null;
                break;
            case "cliente":
                _filters.ClienteCodigo = null;
                _filterClientLabel = string.Empty;
                _filterClientSearch = string.Empty;
                break;
            case "contacto":
                _filters.IdContacto = null;
                _filterContactLabel = string.Empty;
                _filterContactSearch = string.Empty;
                break;
            case "etiqueta":
                _filters.IdEtiqueta = null;
                break;
            case "prioridad":
                _prioridadFiltro = string.Empty;
                _filters.Prioridad = null;
                break;
            case "cerrados":
                _filters.IncluirCerrados = true;
                break;
            case "asignado":
                _filters.TieneAsignado = null;
                break;
            case "mensajes":
                _filters.TieneMensajes = null;
                break;
            case "fecha":
                _filters.FechaRapida = string.Empty;
                break;
            default:
                if (key.StartsWith("rule:", StringComparison.OrdinalIgnoreCase)
                    && int.TryParse(key[5..], out var index)
                    && index >= 0
                    && index < _filters.Reglas.Count)
                {
                    _filters.Reglas.RemoveAt(index);
                }
                break;
        }

        await AplicarFiltrosAsync();
    }

    private async Task ApplyTicketFavoriteAsync(string key)
    {
        if (key == "urgentes")
        {
            _filters.IncluirCerrados = false;
            _prioridadFiltro = "3";
            _filters.TieneMensajes = null;
            _filters.TieneAsignado = null;
        }
        else if (key == "seguimiento")
        {
            _filters.IncluirCerrados = false;
            _filters.TieneMensajes = true;
            _filters.FechaRapida = "recientes";
        }

        await AplicarFiltrosAsync();
    }

