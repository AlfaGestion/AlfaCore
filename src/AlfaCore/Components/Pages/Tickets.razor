    private static List<TicketViewColumnDto> CloneColumns(IEnumerable<TicketViewColumnDto> columns)
        => columns.OrderBy(c => c.Order).Select(c => new TicketViewColumnDto
        {
            Key = c.Key,
            Label = c.Label,
            Visible = c.Visible,
            Order = c.Order,
            WidthPx = NormalizeColumnWidth(c.WidthPx, GetDefaultColumnWidth(c.Key))
        }).ToList();

    private static int GetDefaultColumnWidth(string key)
        => key switch
        {
            TicketViewColumnKeys.Numero => 84,
            TicketViewColumnKeys.Titulo => 300,
            TicketViewColumnKeys.Prioridad => 118,
            TicketViewColumnKeys.Estado => 128,
            TicketViewColumnKeys.Asignado => 150,
            TicketViewColumnKeys.Cliente => 210,
            TicketViewColumnKeys.Contacto => 190,
            TicketViewColumnKeys.Etiquetas => 180,
            TicketViewColumnKeys.Mensajes => 112,
            TicketViewColumnKeys.Fecha => 160,
            _ => 150
        };

    private static int NormalizeColumnWidth(int width, int fallback)
        => Math.Clamp(width > 0 ? width : fallback, 72, 520);

