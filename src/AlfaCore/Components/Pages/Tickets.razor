    private async Task SaveTicketParteHorasAsync()
    {
        if (_detail is null)
            return;

        var totalMinutos = _parteHoraHoras * 60 + _parteHoraMinutos;
        if (totalMinutos <= 0)
        {
            _parteHoraError = "Cargá una duración mayor a cero.";
            return;
        }
        if (_parteHoraHoras < 0 || _parteHoraMinutos < 0 || _parteHoraMinutos > 59)
        {
            _parteHoraError = "Revisá horas y minutos: los minutos deben estar entre 0 y 59.";
            return;
        }
        if (totalMinutos > 24 * 60)
        {
            _parteHoraError = "El parte no puede superar 24 horas.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_parteHoraIdTecnico))
        {
            _parteHoraError = "Elegí un técnico para el parte de horas.";
            return;
        }

        _savingParteHora = true;
        _parteHoraError = null;
        try
        {
            var idParte = await PartesHorasSvc.SaveAsync(new ParteHoraSaveRequest
            {
                Fecha = DateTime.Today,
                ClienteCodigo = _detail.ClienteCodigo,
                IdContacto = _detail.IdContacto,
                IdTicket = _detail.IdTicket,
                IdTecnico = _parteHoraIdTecnico,
                Usuario = CurrentUserName,
                TipoTrabajo = _parteHoraTipoTrabajo,
                Minutos = totalMinutos,
                Facturable = _parteHoraFacturable,
                Estado = ParteHoraEstadoKeys.Presentado,
                Descripcion = _parteHoraDescripcion,
                UsuarioAccion = CurrentUserName
            });

            await FinalizeTicketCloseAsync(
                "Ticket cerrado",
                $"Parte de horas #{idParte.ToString(System.Globalization.CultureInfo.InvariantCulture)} guardado y ticket cerrado.");
        }
        catch (Exception ex)
        {
            _parteHoraError = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.Message
                : "No se pudo guardar el parte de horas. Revisá los datos y volvé a intentar.";
        }
        finally
        {
            _savingParteHora = false;
        }
    }

    private async Task CloseTicketWithoutParteHorasAsync()
    {
        _savingParteHora = true;
        try
        {
            await FinalizeTicketCloseAsync("Ticket cerrado", "El ticket se cerró sin parte de horas.");
        }
        finally
        {
            _savingParteHora = false;
        }
    }

    private async Task FinalizeTicketCloseAsync(string successTitle, string successMessage)
    {
        if (string.IsNullOrWhiteSpace(_parteHoraPendingCloseStatusCode))
            return;

        _form.CodigoEstado = _parteHoraPendingCloseStatusCode;
        if (!await PersistTicketUpdateAsync(successTitle, successMessage))
        {
            _parteHoraError = "No se pudo cerrar el ticket. Si cargaste un parte de horas, quedó guardado, pero el ticket sigue abierto.";
            return;
        }

        _showParteHorasDialog = false;
        _parteHoraPendingCloseStatusCode = string.Empty;
    }

    private async Task<bool> PersistTicketUpdateAsync(string? successTitle = null, string? successMessage = null)
    {
        _form.UsuarioAccion = CurrentUserName;
        _form.IdEtiquetas = _formTagIds.ToList();
        var result = await UiOps.RunAsync(async () => { await TicketsSvc.UpdateAsync(_form); return true; }, "No se pudo guardar el ticket.");
        if (!result.Success) { SetFeedback(result.Feedback); return false; }
        SetFeedback(AppUiMessage.Success(successTitle ?? "Ticket guardado", successMessage ?? "Los cambios quedaron registrados."));
        await BuscarAsync();
        await AbrirTicketAsync(_form.IdTicket, updateUrl: false);
        return true;
    }

