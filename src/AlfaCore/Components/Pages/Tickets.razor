    private async Task GuardarEtiquetaAsync()
    {
        _saving = true;
        try
        {
            var result = await UiOps.RunAsync(() => TicketsSvc.SaveEtiquetaAsync(new TicketEtiquetaSaveRequest
            {
                IdEtiqueta = _tagDraftId,
                Nombre = _tagDraftName,
                Color = _tagDraftColor,
                UsuarioAccion = CurrentUserName
            }), "No se pudo guardar la etiqueta.");

