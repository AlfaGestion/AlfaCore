    [JSInvokable]
    public async Task MoveTicketFromKanbanAsync(long idTicket, string codigoEstadoDestino)
    {
        if (idTicket <= 0 || string.IsNullOrWhiteSpace(codigoEstadoDestino))
            return;

        var ticket = _kanbanItems.FirstOrDefault(x => x.IdTicket == idTicket);
        if (ticket is null)
        {
            await BuscarAsync();
            return;
        }

        _draggingTicket = ticket;
        await SoltarTicketAsync(codigoEstadoDestino);
    }

    private async Task SoltarTicketAsync(string codigoEstadoDestino)
    {
        if (_draggingTicket is null || string.IsNullOrWhiteSpace(codigoEstadoDestino))
            return;

        var ticket = _draggingTicket;
        _draggingTicket = null;
        _dragTargetEstado = null;
        _ignoreNextKanbanClick = true;

        if (string.Equals(ticket.CodigoEstado, codigoEstadoDestino, StringComparison.OrdinalIgnoreCase))
            return;

        var estadoAnterior = ticket.CodigoEstado;
        var estadoNombreAnterior = ticket.EstadoNombre;
        var estadoColorAnterior = ticket.EstadoColor;
        var estadoOrdenAnterior = ticket.EstadoOrden;
        var fechaModificacionAnterior = ticket.FechaHoraModificacion;
        var estadoDestino = _lookups.Estados.FirstOrDefault(x => string.Equals(x.CodigoEstado, codigoEstadoDestino, StringComparison.OrdinalIgnoreCase));

        ticket.CodigoEstado = codigoEstadoDestino;
        ticket.EstadoNombre = estadoDestino?.Nombre ?? ticket.EstadoNombre;
        ticket.EstadoColor = estadoDestino?.Color ?? ticket.EstadoColor;
        ticket.EstadoOrden = estadoDestino?.Orden ?? ticket.EstadoOrden;
        ticket.FechaHoraModificacion = DateTime.Now;

        var result = await UiOps.RunAsync(async () =>
        {
            await TicketsSvc.QuickUpdateAsync(new TicketQuickUpdateRequest
            {
                IdTicket = ticket.IdTicket,
                CodigoEstado = codigoEstadoDestino,
                UsuarioAccion = CurrentUserName
            });
            return true;
        }, "No se pudo cambiar la etapa del ticket.");

        if (!result.Success)
        {
            ticket.CodigoEstado = estadoAnterior;
            ticket.EstadoNombre = estadoNombreAnterior;
            ticket.EstadoColor = estadoColorAnterior;
            ticket.EstadoOrden = estadoOrdenAnterior;
            ticket.FechaHoraModificacion = fechaModificacionAnterior;
            SetFeedback(result.Feedback);
            return;
        }

        SetFeedback(AppUiMessage.Success("Etapa actualizada", "El ticket se movió correctamente."));
        await BuscarAsync(keepCurrent: true);
    }

