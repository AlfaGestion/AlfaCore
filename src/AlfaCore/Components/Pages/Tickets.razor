    private string GetTicketEditorTabClass(string tab)
        => string.Equals(_ticketEditorTab, tab, StringComparison.Ordinal) ? "is-active" : string.Empty;

    private async Task LoadTicketPartesAsync()
    {
        if (_detail is null)
        {
            _ticketPartesRegistrados = [];
            return;
        }

        _loadingTicketPartes = true;
        try
        {
            var result = await UiOps.RunAsync(() => PartesSvc.SearchAsync(new PartesHorasFilters
            {
                IdTicket = _detail.IdTicket,
                FechaDesde = null,
                FechaHasta = null,
                PageNumber = 1,
                PageSize = 200
            }), "No se pudieron cargar los partes vinculados al ticket.");

            if (result.Success && result.Value is not null)
                _ticketPartesRegistrados = result.Value.Items.ToList();
            else if (result.Feedback is not null)
                SetFeedback(result.Feedback);
        }
        finally
        {
            _loadingTicketPartes = false;
        }
    }

    private async Task EditarParteVinculadoAsync(long idParteHora)
    {
        var result = await UiOps.RunAsync(() => PartesSvc.GetByIdAsync(idParteHora), "No se pudo cargar el parte de horas.");
        if (!result.Success || result.Value is null)
        {
