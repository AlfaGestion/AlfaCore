            return;
        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private async Task SortTicketsByAsync(string columnKey)
    {
        if (_loading || string.IsNullOrWhiteSpace(columnKey))
            return;

        if (string.Equals(_filters.OrdenarPor, columnKey, StringComparison.OrdinalIgnoreCase))
            _filters.OrdenDescendente = !_filters.OrdenDescendente;
        else
        {
            _filters.OrdenarPor = columnKey;
            _filters.OrdenDescendente = false;
        }

        _filters.PageNumber = 1;
        ClearTicketSelection(updateHeader: false);
        await BuscarAsync();
    }

