        => (_loading || _refreshingTickets) && HasVisibleTicketData();

    private void NuevoTicket()
    {
        _showEditor = true;
        _isNew = true;
        _detail = null;
        _newNote = string.Empty;
        _descriptionEditorReady = false;
        _form = new TicketUpdateRequest
        {
            CodigoEstado = _lookups.Estados.FirstOrDefault()?.CodigoEstado ?? TicketEstadoKeys.Nuevo,
            Prioridad = 1
        };
        _formTagIds = [];
        ClearTicketRelations();
        _ticketEditorTab = TicketEditorTabTicket;
        _ticketPartesRegistrados = [];
        ResetTicketParteHoraForm();
    }

    private async Task AbrirTicketAsync(long idTicket, bool updateUrl = true)
    {
        if (updateUrl && NavigateToTicketUrl(idTicket))
            return;

        var result = await UiOps.RunAsync(() => TicketsSvc.GetByIdAsync(idTicket), "No se pudo cargar el ticket.");
        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }
        if (result.Value is null)
        {
            SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Ticket no disponible", Message = "El ticket seleccionado ya no existe." });
            await BuscarAsync();
            return;
        }

        _detail = result.Value;
        _form = new TicketUpdateRequest
        {
            IdTicket = _detail.IdTicket,
            Titulo = _detail.Titulo,
            Descripcion = _detail.Descripcion,
            CodigoEstado = _detail.CodigoEstado,
            Prioridad = _detail.Prioridad,
            IdTecnico = _detail.IdTecnico,
            ClienteCodigo = _detail.ClienteCodigo,
            IdContacto = _detail.IdContacto
        };
        _formTagIds = _detail.Etiquetas.Select(x => x.IdEtiqueta).Distinct().ToList();
        _selectedClientLabel = _detail.ClienteNombre;
        _selectedContactLabel = _detail.ContactoNombre;
        _ticketClientSearch = _detail.ClienteNombre;
        _ticketContactSearch = _detail.ContactoNombre;
        _ticketClientSuggestions = [];
        _ticketContactSuggestions = [];
        _isNew = false;
        _showEditor = true;
        _ticketEditorTab = TicketEditorTabTicket;
        _newNote = string.Empty;
        _descriptionEditorReady = false;
        ResetTicketParteHoraForm();
        await LoadTicketPartesAsync();
    }

    private void SetTicketParteHoraTab()
    {
        if (_isNew)
            return;

        _ticketEditorTab = TicketEditorTabParteHora;
        if (_ticketParteLineas.Count == 0)
            ResetTicketParteHoraForm();
    }

