    private void MoveViewColumn(string key, int offset)
    {
        var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        var target = index + offset;
        if (target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(ordered);
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUserName))
        {
            SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Sesión requerida", Message = "Necesitás iniciar sesión para guardar la configuración de vista." });
            return;
        }

        var settings = new TicketViewSettingsDto { AgruparPor = _draftAgruparPor, Columnas = CloneColumns(_viewSettingsDraft) };
        var result = await UiOps.RunAsync(async () => { await TicketsSvc.SaveViewSettingsAsync(CurrentUserName, settings); return true; }, "No se pudo guardar la configuración de vista.");
        if (!result.Success) { SetFeedback(result.Feedback); return; }
        ApplyViewSettings(settings, CurrentUserName);
        CloseViewSettings();
        SetFeedback(AppUiMessage.Success("Vista guardada", "La configuración del listado quedó actualizada para tu usuario."));
    }

    private IReadOnlyList<TicketViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private static int GetColumnWidth(TicketViewColumnDto column)
        => NormalizeColumnWidth(column.WidthPx, GetDefaultColumnWidth(column.Key));

    private static string GetTicketsTableStyle(IReadOnlyList<TicketViewColumnDto> columns)
    {
        var width = 44 + columns.Sum(GetColumnWidth);
        var invariantWidth = width.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"width:max(100%, {invariantWidth}px);min-width:{invariantWidth}px";
    }

    private void StartTicketColumnResize(string key, PointerEventArgs args)
    {
        var column = _viewSettings.Columnas.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null)
            return;

        _resizingColumnKey = column.Key;
        _resizeStartX = args.ClientX;
        _resizeStartWidth = GetColumnWidth(column);
    }

    private void ResizeTicketColumn(PointerEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(_resizingColumnKey))
            return;

        var delta = (int)Math.Round(args.ClientX - _resizeStartX, MidpointRounding.AwayFromZero);
        var width = NormalizeColumnWidth(_resizeStartWidth + delta, _resizeStartWidth);
        SetTicketColumnWidth(_viewSettings.Columnas, _resizingColumnKey, width);
        SetTicketColumnWidth(_viewSettingsDraft, _resizingColumnKey, width);
    }

    private async Task FinishTicketColumnResizeAsync(PointerEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(_resizingColumnKey))
            return;

        _resizingColumnKey = string.Empty;
        if (!string.IsNullOrWhiteSpace(CurrentUserName))
            await SaveCurrentViewSettingsQuietlyAsync();
    }

    private async Task SaveCurrentViewSettingsQuietlyAsync()
    {
        var settings = new TicketViewSettingsDto { AgruparPor = _viewSettings.AgruparPor, Columnas = CloneColumns(_viewSettings.Columnas) };
        var result = await UiOps.RunAsync(async () => { await TicketsSvc.SaveViewSettingsAsync(CurrentUserName, settings); return true; }, "No se pudo guardar el ancho de columnas.");
        if (!result.Success)
            SetFeedback(result.Feedback);
    }

    private static void SetTicketColumnWidth(IEnumerable<TicketViewColumnDto> columns, string key, int width)
    {
        var column = columns.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is not null)
            column.WidthPx = width;
    }

    private IReadOnlyList<TicketGridGroup> BuildListGroups()
    {
        return _viewSettings.AgruparPor switch
        {
            TicketViewGroupKeys.Prioridad => _listItems.GroupBy(x => RenderPriority(x.Prioridad)).Select(g => new TicketGridGroup { Label = g.Key, ShowHeader = true, Items = g.ToList() }).ToList(),
            TicketViewGroupKeys.Tecnico => _listItems.GroupBy(x => DisplayOrFallback(x.TecnicoNombre, "Sin asignar")).Select(g => new TicketGridGroup { Label = g.Key, ShowHeader = true, Items = g.ToList() }).ToList(),
            TicketViewGroupKeys.Estado => _listItems.GroupBy(x => x.EstadoNombre).Select(g => new TicketGridGroup { Label = g.Key, ShowHeader = true, Items = g.ToList() }).ToList(),
            _ => [new TicketGridGroup { Label = string.Empty, ShowHeader = false, Items = _listItems.ToList() }]
        };
    }

    private MarkupString RenderColumn(TicketGridItemDto item, string key)
    {
        if (string.Equals(key, TicketViewColumnKeys.Etiquetas, StringComparison.OrdinalIgnoreCase))
            return RenderTicketTags(item.Etiquetas);

        var text = key switch
        {
            TicketViewColumnKeys.Numero => item.CodigoVisible,
            TicketViewColumnKeys.Titulo => item.Titulo,
            TicketViewColumnKeys.Prioridad => RenderPriority(item.Prioridad),
            TicketViewColumnKeys.Estado => item.EstadoNombre,
            TicketViewColumnKeys.Asignado => DisplayOrFallback(item.TecnicoNombre, "Sin asignar"),
            TicketViewColumnKeys.Cliente => DisplayOrFallback(item.ClienteNombre, "-"),
            TicketViewColumnKeys.Contacto => DisplayOrFallback(item.ContactoNombre, "-"),
            TicketViewColumnKeys.Mensajes => item.MensajesOrigen.ToString(),
            TicketViewColumnKeys.Fecha => item.FechaHoraAlta.ToString("dd/MM/yyyy HH:mm"),
            _ => string.Empty
        };
        return new MarkupString(System.Net.WebUtility.HtmlEncode(text));
    }

    private static MarkupString RenderTicketTags(IReadOnlyList<TicketEtiquetaDto> tags)
    {
        if (tags.Count == 0)
            return new MarkupString("<span class=\"panel-card__subtitle\">-</span>");

        var parts = tags.Select(tag =>
        {
            var name = System.Net.WebUtility.HtmlEncode(tag.Nombre);
            var color = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(tag.Color) ? "#94A3B8" : tag.Color);
            return $"<span class=\"tickets-tag-chip\" style=\"border-color:{color};color:{color}\">{name}</span>";
        });

        return new MarkupString($"<div class=\"tickets-tags\">{string.Join(string.Empty, parts)}</div>");
    }

    private string CurrentUserName => AppUserSession.GetCurrentUserName(string.Empty).Trim();

    private string BuildDetailSubtitle()
        => _detail is null ? string.Empty : $"{DisplayOrFallback(_detail.ClienteNombre, _detail.ContactoNombre, "Sin contacto")} · {_detail.EstadoNombre} · {RenderPriority(_detail.Prioridad)}";

    private IReadOnlyList<SmartFilterChip> BuildTicketFilterChips()
    {
        var chips = new List<SmartFilterChip>();
        if (!string.IsNullOrWhiteSpace(_filters.Texto))
            chips.Add(new("texto", $"Buscar: {_filters.Texto}"));
        if (!string.IsNullOrWhiteSpace(_filters.CodigoEstado))
            chips.Add(new("estado", $"Etapa: {_lookups.Estados.FirstOrDefault(x => x.CodigoEstado == _filters.CodigoEstado)?.Nombre ?? _filters.CodigoEstado}"));
        if (!string.IsNullOrWhiteSpace(_filters.IdTecnico))
            chips.Add(new("tecnico", $"Asignado: {_lookups.Tecnicos.FirstOrDefault(x => x.IdTecnico == _filters.IdTecnico)?.Nombre ?? _filters.IdTecnico}"));
        if (!string.IsNullOrWhiteSpace(_filters.ClienteCodigo))
            chips.Add(new("cliente", $"Cliente: {DisplayOrFallback(_filterClientLabel, _filters.ClienteCodigo)}"));
        if (_filters.IdContacto.HasValue)
            chips.Add(new("contacto", $"Contacto: {DisplayOrFallback(_filterContactLabel, _filters.IdContacto.Value.ToString())}"));
        if (_filters.IdEtiqueta.HasValue)
            chips.Add(new("etiqueta", $"Etiqueta: {_lookups.Etiquetas.FirstOrDefault(x => x.IdEtiqueta == _filters.IdEtiqueta.Value)?.Nombre ?? _filters.IdEtiqueta.Value.ToString()}"));
        if (!string.IsNullOrWhiteSpace(_prioridadFiltro) && int.TryParse(_prioridadFiltro, out var priority))
            chips.Add(new("prioridad", $"Prioridad: {RenderPriority(priority)}"));
        if (!_filters.IncluirCerrados)
            chips.Add(new("cerrados", "Solo abiertos"));
        if (_filters.TieneAsignado.HasValue)
            chips.Add(new("asignado", _filters.TieneAsignado.Value ? "Con asignado" : "Sin asignar"));
        if (_filters.TieneMensajes.HasValue)
            chips.Add(new("mensajes", _filters.TieneMensajes.Value ? "Con mensajes" : "Sin mensajes"));
        if (!string.IsNullOrWhiteSpace(_filters.FechaRapida))
            chips.Add(new("fecha", _filters.FechaRapida == "hoy" ? "Creados hoy" : "Actualizados 7 días"));

        for (var i = 0; i < _filters.Reglas.Count; i++)
            chips.Add(new($"rule:{i}", $"{GetTicketRuleFieldLabel(_filters.Reglas[i].Campo)} {GetRuleOperatorLabel(_filters.Reglas[i].Operador)} {_filters.Reglas[i].Valor}".Trim()));

        return chips;
    }

    private static string GetSmartOptionClass(bool active)
        => active ? "smart-option is-active" : "smart-option";

    private static bool IsValueOptionalOperator(string? op)
        => NormalizeRuleOperator(op) is "empty" or "not-empty";

    private static string NormalizeRuleOperator(string? op)
        => (op ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "equals" => "equals",
            "starts" => "starts",
            "empty" => "empty",
            "not-empty" => "not-empty",
            _ => "contains"
        };

    private static string GetRuleOperatorLabel(string? op)
        => NormalizeRuleOperator(op) switch
        {
            "equals" => "es igual a",
            "starts" => "empieza con",
            "empty" => "está vacío",
            "not-empty" => "no está vacío",
            _ => "contiene"
        };

    private static string GetTicketRuleFieldLabel(string? field)
        => (field ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "descripcion" => "Descripción",
            "cliente" => "Cliente",
            "contacto" => "Contacto",
            "tecnico" => "Técnico",
            _ => "Título"
        };

    private static string? EmptyToNull(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

