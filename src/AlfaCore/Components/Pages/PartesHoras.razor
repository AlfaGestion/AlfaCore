@page "/partes-horas"
@page "/partes-de-horas"
@page "/horas"
@page "/crm/partes-horas"
@page "/soporte/partes-horas"
@page "/shell/D010186"
@using AlfaCore.Models
@using AlfaCore.Services
@inject IPartesHorasService PartesSvc
@inject IAppUiOperationService UiOps
@inject IAppUserSessionService AppUserSession
@inject IFloatingWindowService FloatingWindows
@implements IDisposable

<PageTitle>Partes de horas | Alfa Gestión</PageTitle>

<style>
    .partes-horas-page {
        display: grid;
        gap: 14px;
        max-width: 1440px;
    }

    .partes-horas-page .partes-hero {
        display: grid;
        grid-template-columns: minmax(260px, 1.15fr) minmax(460px, 2fr) auto;
        gap: 18px;
        align-items: center;
        padding: 6px 0 12px;
    }

    .partes-horas-page .partes-hero__main {
        min-width: 0;
    }

    .partes-horas-page .partes-hero__eyebrow {
        display: block;
        margin-bottom: 5px;
        color: var(--color-muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .partes-horas-page .partes-hero__title {
        margin: 0;
        color: var(--color-text);
        font-size: 28px;
        line-height: 1.1;
    }

    .partes-horas-page .partes-hero__text {
        max-width: 620px;
        margin: 8px 0 0;
        color: var(--color-muted);
        font-size: 14px;
        line-height: 1.45;
    }

    .partes-horas-page .partes-hero__metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(102px, 1fr));
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-panel);
    }

    .partes-horas-page .partes-metric {
        min-width: 0;
        padding: 12px 14px;
        border-right: 1px solid var(--color-border);
    }

    .partes-horas-page .partes-metric:last-child {
        border-right: 0;
    }

    .partes-horas-page .partes-metric span,
    .partes-horas-page .partes-metric strong {
        display: block;
    }

    .partes-horas-page .partes-metric span {
        overflow: hidden;
        color: var(--color-muted);
        font-size: 11px;
        font-weight: 700;
        text-overflow: ellipsis;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .partes-horas-page .partes-metric strong {
        margin-top: 4px;
        color: var(--color-text);
        font-size: 18px;
    }

    .partes-horas-page .partes-metric--warn strong {
        color: #f2b84b;
    }

    .partes-horas-page .partes-hero__actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .partes-horas-page .partes-hero__actions {
        justify-content: flex-end;
    }

    .partes-horas-page .partes-search-card {
        padding: 1rem;
    }

    .partes-horas-page .smart-search__panel {
        width: min(980px, calc(100vw - 3rem));
    }

    .partes-horas-page .smart-search__column .btn {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: .35rem;
    }

    .partes-horas-page .smart-search input[type="date"] {
        min-width: 0;
        border: 1px solid rgba(125, 161, 207, .28);
        border-radius: 6px;
        background: rgba(4, 12, 24, .78);
        color: var(--color-text);
        padding: .58rem .65rem;
    }

    .partes-horas-page .partes-panel-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr);
        gap: 14px;
        align-items: start;
    }

    .partes-horas-page .partes-panel-stack {
        display: grid;
        gap: 14px;
        min-width: 0;
    }

    .partes-horas-page .panel-card {
        padding: 16px;
    }

    .partes-horas-page .usuarios-table-wrap {
        max-height: 520px;
    }

    .partes-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 960;
        background: rgba(2, 6, 23, .56);
        backdrop-filter: blur(3px);
    }

    .partes-editor-modal {
        position: fixed;
        z-index: 961;
        top: 50%;
        left: 50%;
        width: min(920px, calc(100vw - 2rem));
        max-height: min(760px, calc(100dvh - 2rem));
        overflow: auto;
        transform: translate(-50%, -50%);
        display: grid;
        gap: 14px;
        padding: 18px;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-panel);
        box-shadow: 0 24px 70px rgba(0, 0, 0, .42);
    }

    .partes-editor-form {
        display: grid;
        grid-template-columns: repeat(4, minmax(140px, 1fr));
        gap: 12px;
        align-items: end;
    }

    .partes-editor-form .field--wide,
    .partes-ticket-results {
        grid-column: 1 / -1;
    }

    .partes-ticket-results {
        max-height: 220px;
    }

    .partes-check-row {
        display: flex;
        gap: 14px;
        align-items: center;
        min-height: 42px;
    }

    @@media (max-width: 1280px) {
        .partes-horas-page .partes-hero {
            grid-template-columns: minmax(220px, 1fr) minmax(360px, 1.7fr);
        }

        .partes-horas-page .partes-hero__actions {
            grid-column: 1 / -1;
            justify-content: flex-start;
        }

        .partes-horas-page .partes-panel-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 820px) {
        .partes-horas-page .partes-hero {
            grid-template-columns: 1fr;
        }

        .partes-horas-page .partes-hero__metrics {
            grid-template-columns: repeat(2, minmax(100px, 1fr));
        }

        .partes-horas-page .partes-metric:nth-child(2) {
            border-right: 0;
        }

        .partes-horas-page .partes-metric:nth-child(-n + 2) {
            border-bottom: 1px solid var(--color-border);
        }

        .partes-editor-form {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 520px) {
        .partes-horas-page .partes-hero__metrics {
            grid-template-columns: 1fr;
        }

        .partes-horas-page .partes-metric {
            border-right: 0;
            border-bottom: 1px solid var(--color-border);
        }

        .partes-horas-page .partes-metric:last-child {
            border-bottom: 0;
        }

        .partes-horas-page .partes-hero__actions .btn {
            flex: 1 1 auto;
        }

        .partes-editor-modal {
            width: calc(100vw - 1rem);
            max-height: calc(100dvh - 1rem);
            padding: 14px;
        }

        .partes-editor-form {
            grid-template-columns: 1fr;
        }

        .partes-check-row {
            display: grid;
            gap: 8px;
        }
    }
</style>

<div class="page-grid partes-horas-page" @onclick="CloseFiltros" @onkeydown="HandleQuickSearchKeyDownAsync" tabindex="-1">
    <section class="partes-hero">
        <div class="partes-hero__main">
            <span class="partes-hero__eyebrow">Control operativo</span>
            <h2 class="partes-hero__title">Partes de horas</h2>
            <p class="partes-hero__text">Registro de tiempo por cliente, ticket y técnico, con lectura rápida de excedentes mensuales.</p>
        </div>
        <div class="partes-hero__metrics">
            <article class="partes-metric">
                <span>Total</span>
                <strong>@FormatMinutes(_dashboard.MinutosTrabajados)</strong>
            </article>
            <article class="partes-metric">
                <span>Facturable</span>
                <strong>@FormatMinutes(_dashboard.MinutosFacturables)</strong>
            </article>
            <article class="partes-metric partes-metric--warn">
                <span>Excedente</span>
                <strong>@FormatMinutes(_dashboard.MinutosExcedentes)</strong>
            </article>
            <article class="partes-metric">
                <span>Pendientes</span>
                <strong>@_dashboard.PartesPendientes</strong>
            </article>
        </div>
        <div class="partes-hero__actions">
            <button type="button" class="btn btn--primary" @onclick="NuevoParte" @onclick:stopPropagation>Nuevo parte</button>
            <button type="button" class="btn btn--ghost" @onclick="RecargarAsync" disabled="@_loading">Recargar</button>
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel-card smart-search-card partes-search-card">
        <div class="smart-search" @onclick:stopPropagation>
            <div class="smart-search__bar">
                <i class="bi bi-search"></i>
                <input type="search"
                       value="@_quickSearch"
                       @oninput="OnQuickSearchChanged"
                       @onfocus="OpenFiltros"
                       @onkeydown="HandleQuickSearchKeyDownAsync"
                       placeholder="Buscar por cliente, ticket, tecnico o descripcion..." />
                <button type="button" class="smart-search__toggle" @onclick="ToggleFiltros" aria-label="Mostrar filtros">
                    <i class="bi @(_filtersExpanded ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                </button>
            </div>

        <div class="smart-search__chips" aria-live="polite">
            <button type="button" class="smart-chip" @onclick="ClearDateRangeAsync">
                @FormatDateRange() <i class="bi bi-x"></i>
            </button>
            @if (!string.IsNullOrWhiteSpace(_filters.Texto))
            {
                <button type="button" class="smart-chip" @onclick="ClearQuickSearchAsync">
                    Busqueda @_filters.Texto <i class="bi bi-x"></i>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(_filters.Estado))
            {
                <button type="button" class="smart-chip" @onclick="ClearEstadoAsync">
                    @LabelEstado(_filters.Estado) <i class="bi bi-x"></i>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(_filters.TipoTrabajo))
            {
                <button type="button" class="smart-chip" @onclick="ClearTipoAsync">
                    @LabelTipo(_filters.TipoTrabajo) <i class="bi bi-x"></i>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(_filters.ClienteCodigo))
            {
                <button type="button" class="smart-chip" @onclick="ClearClienteAsync">
                    Cliente @_filters.ClienteCodigo <i class="bi bi-x"></i>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(_filters.IdTecnico))
            {
                <button type="button" class="smart-chip" @onclick="ClearTecnicoAsync">
                    Tecnico @_filters.IdTecnico <i class="bi bi-x"></i>
                </button>
            }
            @if (_filters.SoloFacturables)
            {
                <button type="button" class="smart-chip" @onclick="ClearFacturableAsync">
                    Facturables <i class="bi bi-x"></i>
                </button>
            }
            @if (_filters.SoloExcedentes)
            {
                <button type="button" class="smart-chip" @onclick="ClearExcedenteAsync">
                    Excedentes <i class="bi bi-x"></i>
                </button>
            }
        </div>

        @if (_filtersExpanded)
        {
            <div class="smart-search__panel" @onkeydown="HandleQuickSearchKeyDownAsync">
                <div class="smart-search__column">
                    <h4><i class="bi bi-funnel-fill"></i> Estado</h4>
                    <button type="button" class="@GetSmartOptionClass(string.IsNullOrWhiteSpace(_filters.Estado))" @onclick='() => SetEstadoFilterAsync(string.Empty)'>Todos</button>
                    @foreach (var estado in _lookups.Estados)
                    {
                        <button type="button" class="@GetSmartOptionClass(string.Equals(_filters.Estado, estado, StringComparison.OrdinalIgnoreCase))" @onclick="() => SetEstadoFilterAsync(estado)">
                            @LabelEstado(estado)
                        </button>
                    }
                    <button type="button" class="btn btn--primary btn--sm" @onclick="AplicarBusquedaAsync" disabled="@_loading">
                        <i class="bi bi-search"></i> Aplicar
                    </button>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-clock-history"></i> Tipo y condicion</h4>
                    <button type="button" class="@GetSmartOptionClass(string.IsNullOrWhiteSpace(_filters.TipoTrabajo))" @onclick='() => SetTipoFilterAsync(string.Empty)'>Todos los tipos</button>
                    @foreach (var tipo in GetTiposTrabajoVisibles())
                    {
                        <button type="button" class="@GetSmartOptionClass(string.Equals(_filters.TipoTrabajo, tipo, StringComparison.OrdinalIgnoreCase))" @onclick="() => SetTipoFilterAsync(tipo)">
                            @LabelTipo(tipo)
                        </button>
                    }
                    <button type="button" class="@GetSmartOptionClass(_filters.SoloFacturables)" @onclick="ToggleSoloFacturablesAsync">Solo facturables</button>
                    <button type="button" class="@GetSmartOptionClass(_filters.SoloExcedentes)" @onclick="ToggleSoloExcedentesAsync">Solo excedentes</button>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-calendar-week"></i> Periodo y asignacion</h4>
                    <div class="smart-search__inline">
                        <label>Fecha desde</label>
                        <InputDate @bind-Value="_filters.FechaDesde" />
                    </div>
                    <div class="smart-search__inline">
                        <label>Fecha hasta</label>
                        <InputDate @bind-Value="_filters.FechaHasta" />
                    </div>
                    <div class="smart-search__inline">
                        <label>Cliente</label>
                        <input type="text" @bind="_filters.ClienteCodigo" @bind:event="oninput" placeholder="Codigo cliente" />
                    </div>
                    <div class="smart-search__inline">
                        <label>Tecnico</label>
                        <select @bind="_filters.IdTecnico">
                            <option value="">Todos</option>
                            @foreach (var tecnico in _lookups.Tecnicos)
                            {
                                <option value="@tecnico.Codigo">@tecnico.Codigo - @tecnico.Titulo</option>
                            }
                        </select>
                    </div>
                    <button type="button" @onclick="LimpiarFiltrosYCerrarAsync" disabled="@_loading">Limpiar busqueda</button>
                </div>
            </div>
        }
        </div>
    </section>

    @if (_showEditor)
    {
        <div class="partes-modal-backdrop" @onclick="CerrarEditor"></div>
        <section class="partes-editor-modal" @onclick:stopPropagation>
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@(_form.IdParteHora.HasValue ? "Editar parte" : "Nuevo parte")</h3>
                    <p class="panel-card__subtitle">Imputá tiempo a un cliente y, cuando aplique, vinculalo con un ticket.</p>
                </div>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarEditor">Cerrar</button>
            </div>

            <div class="partes-editor-form">
                <div class="field">
                    <label>Fecha</label>
                    <InputDate @bind-Value="_form.Fecha" />
                </div>
                <div class="field">
                    <label>Cliente</label>
                    <input type="text" @bind="_form.ClienteCodigo" @bind:event="oninput" placeholder="Código cliente" />
                </div>
                <div class="field">
                    <label>Ticket</label>
                    <input type="number" @bind="_ticketNumeroBusqueda" placeholder="Número o búsqueda" />
                </div>
                <div class="field">
                    <label>Técnico</label>
                    <select @bind="_form.IdTecnico">
                        <option value="">Sin técnico</option>
                        @foreach (var tecnico in _lookups.Tecnicos)
                        {
                            <option value="@tecnico.Codigo">@tecnico.Codigo - @tecnico.Titulo</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Usuario</label>
                    <input type="text" @bind="_form.Usuario" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label>Tipo</label>
                    <select @bind="_form.TipoTrabajo">
                        @foreach (var tipo in GetTiposTrabajoVisibles())
                        {
                            <option value="@tipo">@LabelTipo(tipo)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Minutos</label>
                    <input type="number" min="1" max="1440" step="15" @bind="_form.Minutos" />
                </div>
                <div class="field">
                    <label>Estado</label>
                    <select @bind="_form.Estado">
                        @foreach (var estado in _lookups.Estados)
                        {
                            <option value="@estado">@LabelEstado(estado)</option>
                        }
                    </select>
                </div>
                <label class="checkbox">
                    <input type="checkbox" @bind="_form.Facturable" />
                    <span>Facturable</span>
                </label>
                <label class="checkbox">
                    <input type="checkbox" @bind="_form.Excedente" />
                    <span>Excedente</span>
                </label>
            </div>

            <div class="field">
                <label>Descripción</label>
                <textarea rows="3" @bind="_form.Descripcion" @bind:event="oninput"></textarea>
            </div>

            <div class="actions">
                <button type="button" class="btn btn--ghost" @onclick="BuscarTicketsAsync" disabled="@_saving">Buscar ticket</button>
                <button type="button" class="btn btn--primary" @onclick="GuardarParteAsync" disabled="@_saving">Guardar</button>
                <button type="button" class="btn btn--ghost" @onclick="CerrarEditor" disabled="@_saving">Cancelar</button>
            </div>

            @if (_ticketOptions.Count > 0)
            {
                <div class="usuarios-table-wrap partes-ticket-results">
                    <table class="data-table usuarios-table">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Cliente</th>
                                <th>Título</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in _ticketOptions)
                            {
                                <tr>
                                    <td>@ticket.CodigoVisible</td>
                                    <td>@ticket.ClienteCodigo - @ticket.ClienteNombre</td>
                                    <td>@ticket.Titulo</td>
                                    <td><button type="button" class="btn btn--ghost btn--sm" @onclick="() => SeleccionarTicket(ticket)">Usar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <div class="partes-panel-grid">
    <section class="panel-card">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Partes registrados</h3>
                <p class="panel-card__subtitle">@_result.Total registro(s) · Página @_result.PageNumber de @_result.TotalPages</p>
            </div>
        </div>

        @if (_loading)
        {
            <div class="usuarios-empty">Cargando partes...</div>
        }
        else if (_result.Items.Count == 0)
        {
            <div class="usuarios-empty">No hay partes de horas para los filtros seleccionados.</div>
        }
        else
        {
            <div class="usuarios-table-wrap">
                <table class="data-table usuarios-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Ticket</th>
                            <th>Técnico</th>
                            <th>Tipo</th>
                            <th>Horas</th>
                            <th>Estado</th>
                            <th>Fact.</th>
                            <th>Exc.</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var parte in _result.Items)
                        {
                            <tr>
                                <td>@parte.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@parte.ClienteCodigo<br /><small>@parte.ClienteNombre</small></td>
                                <td>@(string.IsNullOrWhiteSpace(parte.TicketCodigo) ? "-" : parte.TicketCodigo)<br /><small>@parte.TicketTitulo</small></td>
                                <td>@(string.IsNullOrWhiteSpace(parte.TecnicoNombre) ? parte.Usuario : parte.TecnicoNombre)</td>
                                <td>@LabelTipo(parte.TipoTrabajo)</td>
                                <td>@FormatMinutes(parte.Minutos)</td>
                                <td>@LabelEstado(parte.Estado)</td>
                                <td>@(parte.Facturable ? "Sí" : "No")</td>
                                <td>@(parte.Excedente ? "Sí" : "No")</td>
                                <td>
                                    <div class="actions">
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarParteAsync(parte.IdParteHora)" @onclick:stopPropagation>Editar</button>
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AprobarAsync(parte.IdParteHora)">Aprobar</button>
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => RechazarAsync(parte.IdParteHora)">Rechazar</button>
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AnularAsync(parte.IdParteHora)">Anular</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="result-pagination">
            <div class="result-pagination__info">Total: @_result.Total</div>
            <div class="result-pagination__controls">
                <button class="result-pagination__btn" @onclick="() => CambiarPaginaAsync(_result.PageNumber - 1)" disabled="@(!_result.HasPrev)">Anterior</button>
                <button class="result-pagination__btn" @onclick="() => CambiarPaginaAsync(_result.PageNumber + 1)" disabled="@(!_result.HasNext)">Siguiente</button>
            </div>
        </div>
    </section>

    <div class="partes-panel-stack">
    <section class="panel-card">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Consumo por cliente</h3>
                <p class="panel-card__subtitle">Control mensual para detectar clientes que superan su bolsa contratada.</p>
            </div>
        </div>
        <div class="usuarios-table-wrap">
            <table class="data-table usuarios-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Trabajado</th>
                        <th>Facturable</th>
                        <th>Incluido</th>
                        <th>Excedente</th>
                        <th>Costo interno</th>
                        <th>Tickets</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in _dashboard.Clientes)
                    {
                        <tr>
                            <td>@cliente.ClienteCodigo<br /><small>@cliente.ClienteNombre</small></td>
                            <td>@FormatMinutes(cliente.MinutosTrabajados)</td>
                            <td>@FormatMinutes(cliente.MinutosFacturables)</td>
                            <td>@FormatMinutes(cliente.MinutosIncluidos + cliente.ToleranciaMinutos)</td>
                            <td>@FormatMinutes(cliente.MinutosExcedentes)</td>
                            <td>@cliente.CostoInterno.ToString("C2")</td>
                            <td>@cliente.Tickets</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Bolsa mensual por cliente</h3>
                <p class="panel-card__subtitle">Configurá las horas incluidas para marcar excedentes automáticamente.</p>
            </div>
        </div>
        <div class="filters-grid filters-grid--wide">
            <div class="field">
                <label>Cliente</label>
                <input type="text" @bind="_config.ClienteCodigo" @bind:event="oninput" />
            </div>
            <div class="field">
                <label>Horas incluidas</label>
                <input type="number" min="0" @bind="_config.HorasIncluidasMes" />
            </div>
            <div class="field">
                <label>Tolerancia minutos</label>
                <input type="number" min="0" step="15" @bind="_config.ToleranciaMinutos" />
            </div>
            <label class="checkbox">
                <input type="checkbox" @bind="_config.Activa" />
                <span>Activa</span>
            </label>
        </div>
        <div class="field">
            <label>Observaciones</label>
            <textarea rows="2" @bind="_config.Observaciones" @bind:event="oninput"></textarea>
        </div>
        <div class="actions">
            <button type="button" class="btn btn--ghost" @onclick="CargarConfigClienteAsync">Cargar configuración</button>
            <button type="button" class="btn btn--primary" @onclick="GuardarConfigClienteAsync">Guardar bolsa</button>
        </div>
    </section>
    </div>
    </div>
</div>

@code {
    private PartesHorasFilters _filters = new();
    private PagedResult<ParteHoraGridItemDto> _result = new();
    private ParteHoraDashboardDto _dashboard = new();
    private ParteHoraLookupDto _lookups = new();
    private ParteHoraSaveRequest _form = new();
    private ParteHoraClienteConfigDto _config = new();
    private List<ParteHoraTicketOptionDto> _ticketOptions = [];
    private AppUiMessage? _feedback;
    private bool _loading;
    private bool _saving;
    private bool _showEditor;
    private bool _filtersExpanded;
    private string _quickSearch = string.Empty;
    private int? _ticketNumeroBusqueda;
    private IDisposable? _floatingWindowRegistration;

    protected override async Task OnInitializedAsync()
    {
        _floatingWindowRegistration = FloatingWindows.Register(FloatingWindowType.Popover, CloseFloatingWindowsAsync);
        NuevoParte();
        _showEditor = false;
        await RecargarAsync();
    }

    private Task CloseFloatingWindowsAsync()
    {
        if (_saving || !_showEditor)
            return Task.CompletedTask;

        CerrarEditor();
        return InvokeAsync(StateHasChanged);
    }

    private async Task RecargarAsync()
    {
        _loading = true;
        try
        {
            var lookupsResult = await UiOps.RunAsync(() => PartesSvc.GetLookupsAsync(), "No se pudieron cargar los datos auxiliares.");
            if (lookupsResult.Success && lookupsResult.Value is not null)
                _lookups = lookupsResult.Value;
            else if (lookupsResult.Feedback is not null)
                _feedback = lookupsResult.Feedback;

            await BuscarAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BuscarAsync()
    {
        var searchResult = await UiOps.RunAsync(() => PartesSvc.SearchAsync(_filters), "No se pudieron cargar los partes de horas.");
        if (searchResult.Success && searchResult.Value is not null)
            _result = searchResult.Value;
        else if (searchResult.Feedback is not null)
            _feedback = searchResult.Feedback;

        var dashboardResult = await UiOps.RunAsync(() => PartesSvc.GetDashboardAsync(_filters), "No se pudo cargar el resumen de horas.");
        if (dashboardResult.Success && dashboardResult.Value is not null)
            _dashboard = dashboardResult.Value;
        else if (dashboardResult.Feedback is not null)
            _feedback = dashboardResult.Feedback;
    }

    private async Task AplicarFiltrosAsync()
    {
        _filters.Texto = _quickSearch.Trim();
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        _filters = new PartesHorasFilters();
        _quickSearch = string.Empty;
        await BuscarAsync();
    }

    private async Task LimpiarFiltrosYCerrarAsync()
    {
        await LimpiarFiltrosAsync();
        CloseFiltros();
    }

    private void ToggleFiltros()
        => _filtersExpanded = !_filtersExpanded;

    private void OpenFiltros()
        => _filtersExpanded = true;

    private void CloseFiltros()
        => _filtersExpanded = false;

    private void OnQuickSearchChanged(ChangeEventArgs args)
        => _quickSearch = Convert.ToString(args.Value) ?? string.Empty;

    private async Task HandleQuickSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            await AplicarBusquedaAsync();
        else if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            CloseFiltros();
    }

    private async Task AplicarBusquedaAsync()
    {
        await AplicarFiltrosAsync();
        CloseFiltros();
    }

    private async Task SetEstadoFilterAsync(string estado)
    {
        _filters.Estado = estado;
        await AplicarFiltrosAsync();
    }

    private async Task SetTipoFilterAsync(string tipo)
    {
        _filters.TipoTrabajo = tipo;
        await AplicarFiltrosAsync();
    }

    private async Task ToggleSoloFacturablesAsync()
    {
        _filters.SoloFacturables = !_filters.SoloFacturables;
        await AplicarFiltrosAsync();
    }

    private async Task ToggleSoloExcedentesAsync()
    {
        _filters.SoloExcedentes = !_filters.SoloExcedentes;
        await AplicarFiltrosAsync();
    }

    private async Task ClearDateRangeAsync()
    {
        _filters.FechaDesde = null;
        _filters.FechaHasta = null;
        await AplicarFiltrosAsync();
    }

    private async Task ClearQuickSearchAsync()
    {
        _quickSearch = string.Empty;
        _filters.Texto = string.Empty;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task ClearEstadoAsync()
    {
        _filters.Estado = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearTipoAsync()
    {
        _filters.TipoTrabajo = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearClienteAsync()
    {
        _filters.ClienteCodigo = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearTecnicoAsync()
    {
        _filters.IdTecnico = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearFacturableAsync()
    {
        _filters.SoloFacturables = false;
        await AplicarFiltrosAsync();
    }

    private async Task ClearExcedenteAsync()
    {
        _filters.SoloExcedentes = false;
        await AplicarFiltrosAsync();
    }

    private static string GetSmartOptionClass(bool active)
        => active ? "smart-option is-active" : "smart-option";

    private IEnumerable<string> GetTiposTrabajoVisibles()
        => _lookups.TiposTrabajo.Where(tipo => !string.Equals(tipo, ParteHoraTipoTrabajoKeys.Viaje, StringComparison.OrdinalIgnoreCase));

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page == _filters.PageNumber)
            return;

        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private void NuevoParte()
    {
        CloseFiltros();
        _form = new ParteHoraSaveRequest
        {
            Fecha = DateTime.Today,
            Usuario = AppUserSession.GetCurrentUserName(Environment.UserName),
            UsuarioAccion = AppUserSession.GetCurrentUserName(Environment.UserName),
            TipoTrabajo = ParteHoraTipoTrabajoKeys.Soporte,
            Estado = ParteHoraEstadoKeys.Borrador,
            Facturable = true,
            Minutos = 60
        };
        _ticketNumeroBusqueda = null;
        _ticketOptions.Clear();
        _showEditor = true;
    }

    private void CerrarEditor()
    {
        _showEditor = false;
        _ticketOptions.Clear();
    }

    private async Task EditarParteAsync(long id)
    {
        CloseFiltros();
        var result = await UiOps.RunAsync(() => PartesSvc.GetByIdAsync(id), "No se pudo cargar el parte.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        var detail = result.Value;
        _form = new ParteHoraSaveRequest
        {
            IdParteHora = detail.IdParteHora,
            Fecha = detail.Fecha,
            ClienteCodigo = detail.ClienteCodigo,
            IdContacto = detail.IdContacto,
            IdTicket = detail.IdTicket,
            IdTecnico = detail.IdTecnico,
            Usuario = detail.Usuario,
            TipoTrabajo = detail.TipoTrabajo,
            Minutos = detail.Minutos,
            Facturable = detail.Facturable,
            Excedente = detail.Excedente,
            Estado = detail.Estado,
            Descripcion = detail.Descripcion,
            UsuarioAccion = AppUserSession.GetCurrentUserName(Environment.UserName)
        };
        _ticketNumeroBusqueda = null;
        _showEditor = true;
    }

    private async Task GuardarParteAsync()
    {
        _saving = true;
        try
        {
            _form.UsuarioAccion = AppUserSession.GetCurrentUserName(Environment.UserName);
            var result = await UiOps.RunAsync(() => PartesSvc.SaveAsync(_form), "No se pudo guardar el parte de horas.");
            if (!result.Success)
            {
                _feedback = result.Feedback;
                return;
            }

            _feedback = AppUiMessage.Success("Parte guardado", "Las horas quedaron registradas correctamente.");
            _showEditor = false;
            await BuscarAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task BuscarTicketsAsync()
    {
        var text = _ticketNumeroBusqueda?.ToString() ?? string.Empty;
        var result = await UiOps.RunAsync(() => PartesSvc.SearchTicketsAsync(text, _form.ClienteCodigo), "No se pudieron buscar tickets.");
        if (result.Success && result.Value is not null)
            _ticketOptions = result.Value.ToList();
        else if (result.Feedback is not null)
            _feedback = result.Feedback;
    }

    private void SeleccionarTicket(ParteHoraTicketOptionDto ticket)
    {
        _form.IdTicket = ticket.IdTicket;
        _form.ClienteCodigo = ticket.ClienteCodigo;
        _ticketNumeroBusqueda = ticket.Numero;
        _ticketOptions.Clear();
    }

    private async Task AprobarAsync(long id)
    {
        var result = await UiOps.RunAsync(() => PartesSvc.AprobarAsync(id, AppUserSession.GetCurrentUserName(Environment.UserName)), "No se pudo aprobar el parte.");
        _feedback = result.Success ? AppUiMessage.Success("Parte aprobado", "El registro quedó aprobado.") : result.Feedback;
        await BuscarAsync();
    }

    private async Task RechazarAsync(long id)
    {
        var result = await UiOps.RunAsync(() => PartesSvc.RechazarAsync(id, AppUserSession.GetCurrentUserName(Environment.UserName)), "No se pudo rechazar el parte.");
        _feedback = result.Success ? AppUiMessage.Success("Parte rechazado", "El registro quedó rechazado.") : result.Feedback;
        await BuscarAsync();
    }

    private async Task AnularAsync(long id)
    {
        var result = await UiOps.RunAsync(() => PartesSvc.DeleteAsync(id, AppUserSession.GetCurrentUserName(Environment.UserName)), "No se pudo anular el parte.");
        _feedback = result.Success ? AppUiMessage.Success("Parte anulado", "El registro fue dado de baja.") : result.Feedback;
        await BuscarAsync();
    }

    private async Task CargarConfigClienteAsync()
    {
        var cliente = _config.ClienteCodigo;
        var result = await UiOps.RunAsync(() => PartesSvc.GetClienteConfigAsync(cliente), "No se pudo cargar la bolsa del cliente.");
        if (result.Success)
        {
            _config = result.Value ?? new ParteHoraClienteConfigDto { ClienteCodigo = cliente, Activa = true };
            return;
        }

        _feedback = result.Feedback;
    }

    private async Task GuardarConfigClienteAsync()
    {
        var result = await UiOps.RunAsync(() => PartesSvc.SaveClienteConfigAsync(_config, AppUserSession.GetCurrentUserName(Environment.UserName)), "No se pudo guardar la bolsa del cliente.");
        _feedback = result.Success ? AppUiMessage.Success("Bolsa guardada", "La configuración mensual del cliente quedó actualizada.") : result.Feedback;
        await BuscarAsync();
    }

    private static string FormatMinutes(int minutes)
        => $"{minutes / 60}h {minutes % 60:00}m";

    private string FormatDateRange()
    {
        var desde = _filters.FechaDesde?.ToString("dd/MM/yyyy") ?? "Sin inicio";
        var hasta = _filters.FechaHasta?.ToString("dd/MM/yyyy") ?? "Sin fin";
        return $"{desde} - {hasta}";
    }

    private static string LabelEstado(string value) => value switch
    {
        ParteHoraEstadoKeys.Borrador => "Borrador",
        ParteHoraEstadoKeys.Presentado => "Presentado",
        ParteHoraEstadoKeys.Aprobado => "Aprobado",
        ParteHoraEstadoKeys.Rechazado => "Rechazado",
        _ => value
    };

    private static string LabelTipo(string value) => value switch
    {
        ParteHoraTipoTrabajoKeys.Soporte => "Soporte",
        ParteHoraTipoTrabajoKeys.Desarrollo => "Desarrollo",
        ParteHoraTipoTrabajoKeys.Implementacion => "Implementación",
        ParteHoraTipoTrabajoKeys.Capacitacion => "Capacitación",
        ParteHoraTipoTrabajoKeys.Reunion => "Reunión",
        ParteHoraTipoTrabajoKeys.Viaje => "Viaje",
        ParteHoraTipoTrabajoKeys.Interno => "Interno",
        _ => value
    };

    private static string GetFeedbackClass(AppUiMessage feedback)
        => feedback.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--success",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            AppUiFeedbackSeverity.Error => "editor-msg--error",
            _ => "editor-msg--info"
        };

    public void Dispose()
        => _floatingWindowRegistration?.Dispose();
}
