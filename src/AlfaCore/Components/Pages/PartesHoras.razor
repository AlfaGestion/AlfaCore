                                <td>@(string.IsNullOrWhiteSpace(parte.TecnicoNombre) ? parte.Usuario : parte.TecnicoNombre)</td>
                                <td>@LabelTipo(parte.TipoTrabajo)</td>
                                <td>@FormatMinutes(parte.Minutos)</td>
                                <td>@LabelEstado(parte.Estado)</td>
                                <td>@(parte.Facturable ? "Sí" : "No")</td>
                                <td>@(parte.Excedente ? "Sí" : "No")</td>
                                <td>
                                    <div class="actions">
                                        <button type="button" class="btn btn--ghost btn--sm" title="Editar parte" aria-label="Editar parte" @onclick="() => EditarParteAsync(parte.IdParteHora)" @onclick:stopPropagation>
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button type="button" class="btn btn--ghost btn--sm" title="Borrar parte" aria-label="Borrar parte" @onclick="() => BorrarParteAsync(parte.IdParteHora)" @onclick:stopPropagation>
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="result-pagination">
            <div class="result-pagination__info">Total: @_result.Total</div>
            <div class="result-pagination__controls">
                <button class="result-pagination__btn" @onclick="() => CambiarPaginaAsync(_result.PageNumber - 1)" disabled="@(!_result.HasPrev)">Anterior</button>
                <button class="result-pagination__btn" @onclick="() => CambiarPaginaAsync(_result.PageNumber + 1)" disabled="@(!_result.HasNext)">Siguiente</button>
            </div>
        </div>
    </section>
    }

    @if (_partesActiveTab == PartesTabConsumo)
    {
    <section class="panel-card">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Consumo por cliente</h3>
                <p class="panel-card__subtitle">Control mensual para detectar clientes que superan su bolsa contratada.</p>
            </div>
        </div>
        <div class="usuarios-table-wrap">
            <table class="data-table usuarios-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Trabajado</th>
                        <th>Facturable</th>
                        <th>Incluido</th>
                        <th>Excedente</th>
                        <th>Costo interno</th>
                        <th>Tickets</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in _dashboard.Clientes)
                    {
                        <tr>
                            <td>@cliente.ClienteCodigo<br /><small>@cliente.ClienteNombre</small></td>
                            <td>@FormatMinutes(cliente.MinutosTrabajados)</td>
                            <td>@FormatMinutes(cliente.MinutosFacturables)</td>
                            <td>@FormatMinutes(cliente.MinutosIncluidos + cliente.ToleranciaMinutos)</td>
                            <td>@FormatMinutes(cliente.MinutosExcedentes)</td>
                            <td>@cliente.CostoInterno.ToString("C2")</td>
                            <td>@cliente.Tickets</td>
                        </tr>
