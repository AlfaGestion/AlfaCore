                </tbody>
            </table>
        </div>
    </section>
    }

    @if (_partesActiveTab == PartesTabBolsa)
    {
    <section class="panel-card">
        <div class="panel-card__header">
            <div>
                <h3 class="panel-card__title">Bolsa mensual por cliente</h3>
                <p class="panel-card__subtitle">Configurá las horas incluidas para marcar excedentes automáticamente.</p>
            </div>
        </div>
        <div class="filters-grid filters-grid--wide">
            <div class="field">
                <label>Cliente</label>
                <input type="text" @bind="_config.ClienteCodigo" @bind:event="oninput" />
            </div>
            <div class="field">
                <label>Horas incluidas</label>
                <input type="number" min="0" @bind="_config.HorasIncluidasMes" />
            </div>
            <div class="field">
                <label>Tolerancia minutos</label>
                <input type="number" min="0" step="15" @bind="_config.ToleranciaMinutos" />
            </div>
            <label class="checkbox">
                <input type="checkbox" @bind="_config.Activa" />
                <span>Activa</span>
            </label>
        </div>
        <div class="field">
            <label>Observaciones</label>
            <textarea rows="2" @bind="_config.Observaciones" @bind:event="oninput"></textarea>
        </div>
        <div class="actions">
            <button type="button" class="btn btn--ghost" @onclick="CargarConfigClienteAsync">Cargar configuración</button>
            <button type="button" class="btn btn--primary" @onclick="GuardarConfigClienteAsync">Guardar bolsa</button>
        </div>
    </section>
    }
</div>

@code {
    private sealed class ParteHoraLineaForm
    {
        public string IdTecnico { get; set; } = string.Empty;
        public string TipoTrabajo { get; set; } = ParteHoraTipoTrabajoKeys.Soporte;
        public string Descripcion { get; set; } = string.Empty;
        public int Minutos { get; set; } = 15;
    }

    private const string TicketSelectDefaultValue = "__select__";
    private const string TicketSelectNoneValue = "__none__";
    private const string PartesTabRegistradas = "registradas";
    private const string PartesTabConsumo = "consumo";
    private const string PartesTabBolsa = "bolsa";

    private PartesHorasFilters _filters = new();
    private PagedResult<ParteHoraGridItemDto> _result = new();
    private ParteHoraDashboardDto _dashboard = new();
    private ParteHoraLookupDto _lookups = new();
    private ParteHoraSaveRequest _form = new();
    private ParteHoraClienteConfigDto _config = new();
    private List<ParteHoraTicketOptionDto> _ticketOptions = [];
    private List<ParteHoraLookupOptionDto> _clienteOptions = [];
    private List<ParteHoraPersonaOptionDto> _personaOptions = [];
    private List<ParteHoraLineaForm> _lineas = [];
    private AppUiMessage? _feedback;
    private bool _loading;
    private bool _saving;
    private bool _showEditor;
    private bool _filtersExpanded;
    private string _quickSearch = string.Empty;
    private string _clienteSearch = string.Empty;
    private string _personaSearch = string.Empty;
    private string _ticketSelectValue = TicketSelectDefaultValue;
    private string _partesActiveTab = PartesTabRegistradas;
    private int? _ticketNumeroBusqueda;
    private int? _pendingLineaDescripcionFocusIndex;
    private IDisposable? _floatingWindowRegistration;

    protected override async Task OnInitializedAsync()
    {
        _floatingWindowRegistration = FloatingWindows.Register(FloatingWindowType.Popover, CloseFloatingWindowsAsync);
        NuevoParte();
        _showEditor = false;
        await RecargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingLineaDescripcionFocusIndex.HasValue)
        {
            var focusIndex = _pendingLineaDescripcionFocusIndex.Value;
            _pendingLineaDescripcionFocusIndex = null;

            try
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{GetLineaDescripcionId(focusIndex)}')?.focus()");
            }
            catch
            {
            }
        }
    }

    private Task CloseFloatingWindowsAsync()
    {
        if (_saving || !_showEditor)
            return Task.CompletedTask;

        CerrarEditor();
        return InvokeAsync(StateHasChanged);
    }

    private async Task RecargarAsync()
    {
        _loading = true;
        try
        {
            var lookupsResult = await UiOps.RunAsync(() => PartesSvc.GetLookupsAsync(), "No se pudieron cargar los datos auxiliares.");
            if (lookupsResult.Success && lookupsResult.Value is not null)
                _lookups = lookupsResult.Value;
            else if (lookupsResult.Feedback is not null)
                _feedback = lookupsResult.Feedback;

            await BuscarAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BuscarAsync()
    {
        var searchResult = await UiOps.RunAsync(() => PartesSvc.SearchAsync(_filters), "No se pudieron cargar los partes de horas.");
        if (searchResult.Success && searchResult.Value is not null)
            _result = searchResult.Value;
        else if (searchResult.Feedback is not null)
            _feedback = searchResult.Feedback;

        var dashboardResult = await UiOps.RunAsync(() => PartesSvc.GetDashboardAsync(_filters), "No se pudo cargar el resumen de horas.");
        if (dashboardResult.Success && dashboardResult.Value is not null)
            _dashboard = dashboardResult.Value;
        else if (dashboardResult.Feedback is not null)
            _feedback = dashboardResult.Feedback;
    }

    private async Task AplicarFiltrosAsync()
    {
        _filters.Texto = _quickSearch.Trim();
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        _filters = new PartesHorasFilters();
        _quickSearch = string.Empty;
        await BuscarAsync();
    }

    private async Task LimpiarFiltrosYCerrarAsync()
    {
        await LimpiarFiltrosAsync();
        CloseFiltros();
    }

    private void ToggleFiltros()
        => _filtersExpanded = !_filtersExpanded;

    private void OpenFiltros()
        => _filtersExpanded = true;

    private void CloseFiltros()
        => _filtersExpanded = false;

    private void CloseTransientUi()
    {
        CloseFiltros();
        DismissFeedback();
    }

    private void DismissFeedback()
        => _feedback = null;

    private void OnQuickSearchChanged(ChangeEventArgs args)
        => _quickSearch = Convert.ToString(args.Value) ?? string.Empty;

    private async Task HandleQuickSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            await AplicarBusquedaAsync();
        else if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            CloseFiltros();
    }

    private async Task AplicarBusquedaAsync()
    {
        await AplicarFiltrosAsync();
        CloseFiltros();
    }

    private async Task SetEstadoFilterAsync(string estado)
    {
        _filters.Estado = estado;
        await AplicarFiltrosAsync();
    }

    private async Task SetTipoFilterAsync(string tipo)
    {
        _filters.TipoTrabajo = tipo;
        await AplicarFiltrosAsync();
    }

    private async Task ToggleSoloFacturablesAsync()
    {
        _filters.SoloFacturables = !_filters.SoloFacturables;
        await AplicarFiltrosAsync();
    }

    private async Task ToggleSoloExcedentesAsync()
    {
        _filters.SoloExcedentes = !_filters.SoloExcedentes;
        await AplicarFiltrosAsync();
    }

    private async Task ClearDateRangeAsync()
    {
        _filters.FechaDesde = null;
        _filters.FechaHasta = null;
        await AplicarFiltrosAsync();
    }

    private async Task ClearQuickSearchAsync()
    {
        _quickSearch = string.Empty;
        _filters.Texto = string.Empty;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private async Task ClearEstadoAsync()
    {
        _filters.Estado = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearTipoAsync()
    {
        _filters.TipoTrabajo = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearClienteAsync()
    {
        _filters.ClienteCodigo = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearTecnicoAsync()
    {
        _filters.IdTecnico = string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task ClearFacturableAsync()
    {
        _filters.SoloFacturables = false;
        await AplicarFiltrosAsync();
    }

    private async Task ClearExcedenteAsync()
    {
        _filters.SoloExcedentes = false;
        await AplicarFiltrosAsync();
    }

    private static string GetSmartOptionClass(bool active)
        => active ? "smart-option is-active" : "smart-option";

    private string GetPartesTabClass(string tab)
        => string.Equals(_partesActiveTab, tab, StringComparison.Ordinal) ? "is-active" : string.Empty;

    private IEnumerable<string> GetTiposTrabajoVisibles()
        => _lookups.TiposTrabajo.Where(tipo => !string.Equals(tipo, ParteHoraTipoTrabajoKeys.Viaje, StringComparison.OrdinalIgnoreCase));

    private async Task CambiarPaginaAsync(int page)
    {
        if (page < 1 || page == _filters.PageNumber)
            return;

        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private void NuevoParte()
    {
        CloseFiltros();
        _form = new ParteHoraSaveRequest
        {
            Fecha = DateTime.Today,
            Usuario = AppUserSession.GetCurrentUserName(Environment.UserName),
            UsuarioAccion = AppUserSession.GetCurrentUserName(Environment.UserName),
            TipoTrabajo = ParteHoraTipoTrabajoKeys.Soporte,
            Estado = ParteHoraEstadoKeys.Borrador,
            Facturable = true,
            Minutos = 60
        };
        _clienteSearch = string.Empty;
        _personaSearch = AppUserSession.GetCurrentUserName(Environment.UserName);
        _ticketSelectValue = TicketSelectDefaultValue;
        _ticketNumeroBusqueda = null;
        _clienteOptions.Clear();
        _personaOptions.Clear();
        _ticketOptions.Clear();
        _lineas =
        [
            new ParteHoraLineaForm
            {
                TipoTrabajo = ParteHoraTipoTrabajoKeys.Soporte,
                Minutos = 15
            }
        ];
        _showEditor = true;
    }

    private void CerrarEditor()
    {
        _showEditor = false;
        _clienteOptions.Clear();
        _personaOptions.Clear();
        _ticketOptions.Clear();
    }

    private async Task EditarParteAsync(long id)
    {
        CloseFiltros();
        var result = await UiOps.RunAsync(() => PartesSvc.GetByIdAsync(id), "No se pudo cargar el parte.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        var detail = result.Value;
        _form = new ParteHoraSaveRequest
        {
            IdParteHora = detail.IdParteHora,
            Fecha = detail.Fecha,
            ClienteCodigo = detail.ClienteCodigo,
            IdContacto = detail.IdContacto,
            IdTicket = detail.IdTicket,
            IdTecnico = detail.IdTecnico,
            Usuario = detail.Usuario,
            TipoTrabajo = detail.TipoTrabajo,
            Minutos = detail.Minutos,
            Facturable = detail.Facturable,
            Excedente = detail.Excedente,
            Estado = detail.Estado,
            Descripcion = detail.Descripcion,
            UsuarioAccion = AppUserSession.GetCurrentUserName(Environment.UserName)
        };
        _clienteSearch = string.IsNullOrWhiteSpace(detail.ClienteNombre) ? detail.ClienteCodigo : $"{detail.ClienteNombre} ({detail.ClienteCodigo})";
        _personaSearch = string.IsNullOrWhiteSpace(detail.ContactoNombre) ? detail.Usuario : detail.ContactoNombre;
        _lineas =
        [
            new ParteHoraLineaForm
            {
                IdTecnico = detail.IdTecnico,
                TipoTrabajo = detail.TipoTrabajo,
                Minutos = detail.Minutos,
                Descripcion = detail.Descripcion
            }
        ];
        _ticketNumeroBusqueda = null;
        _ticketSelectValue = detail.IdTicket.HasValue
            ? detail.IdTicket.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : TicketSelectNoneValue;
        _showEditor = true;
        await BuscarTicketsAsync();
    }

    private async Task GuardarParteAsync()
    {
        _saving = true;
        try
        {
            _form.UsuarioAccion = AppUserSession.GetCurrentUserName(Environment.UserName);
            var lineas = _lineas
                .Where(linea => linea.Minutos > 0 || !string.IsNullOrWhiteSpace(linea.Descripcion) || !string.IsNullOrWhiteSpace(linea.IdTecnico))
                .ToList();
            if (lineas.Count == 0)
                lineas.Add(new ParteHoraLineaForm { TipoTrabajo = _form.TipoTrabajo, Minutos = _form.Minutos, Descripcion = _form.Descripcion, IdTecnico = _form.IdTecnico });

            for (var i = 0; i < lineas.Count; i++)
            {
                var linea = lineas[i];
                var request = new ParteHoraSaveRequest
                {
                    IdParteHora = i == 0 ? _form.IdParteHora : null,
                    Fecha = _form.Fecha,
                    ClienteCodigo = _form.ClienteCodigo,
                    IdContacto = _form.IdContacto,
                    IdTicket = _form.IdTicket,
                    IdTecnico = linea.IdTecnico,
                    Usuario = _form.Usuario,
                    TipoTrabajo = linea.TipoTrabajo,
                    Minutos = linea.Minutos,
                    Facturable = _form.Facturable,
                    Excedente = _form.Excedente,
                    Estado = _form.Estado,
                    Descripcion = linea.Descripcion,
                    UsuarioAccion = _form.UsuarioAccion
                };
                var result = await UiOps.RunAsync(() => PartesSvc.SaveAsync(request), "No se pudo guardar el parte de horas.");
                if (!result.Success)
                {
                    _feedback = result.Feedback;
                    return;
                }
            }

            _feedback = AppUiMessage.Success("Parte guardado", lineas.Count == 1 ? "Las horas quedaron registradas correctamente." : $"Se registraron {lineas.Count} lineas de trabajo.");
            _showEditor = false;
            await BuscarAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task BuscarTicketsAsync()
    {
        var text = _ticketNumeroBusqueda?.ToString() ?? string.Empty;
        var result = await UiOps.RunAsync(() => PartesSvc.SearchTicketsAsync(text, _form.ClienteCodigo), "No se pudieron buscar tickets.");
        if (result.Success && result.Value is not null)
        {
            _ticketOptions = result.Value.ToList();
            if (_form.IdTicket.HasValue && _ticketOptions.All(ticket => ticket.IdTicket != _form.IdTicket.Value))
                _ticketSelectValue = TicketSelectNoneValue;
        }
        else if (result.Feedback is not null)
            _feedback = result.Feedback;
    }

    private void SeleccionarTicket(ParteHoraTicketOptionDto ticket)
    {
        _form.IdTicket = ticket.IdTicket;
        _form.ClienteCodigo = ticket.ClienteCodigo;
        _clienteSearch = string.IsNullOrWhiteSpace(ticket.ClienteNombre) ? ticket.ClienteCodigo : $"{ticket.ClienteNombre} ({ticket.ClienteCodigo})";
        _ticketNumeroBusqueda = ticket.Numero;
        _ticketSelectValue = ticket.IdTicket.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task OnTicketSelectChangedAsync(ChangeEventArgs args)
    {
        _ticketSelectValue = Convert.ToString(args.Value, System.Globalization.CultureInfo.InvariantCulture) ?? TicketSelectDefaultValue;
        if (string.Equals(_ticketSelectValue, TicketSelectDefaultValue, StringComparison.Ordinal)
            || string.Equals(_ticketSelectValue, TicketSelectNoneValue, StringComparison.Ordinal)
            || !long.TryParse(_ticketSelectValue, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var id))
        {
            _form.IdTicket = null;
            _ticketNumeroBusqueda = null;
            return;
        }

        _form.IdTicket = id;
        var ticket = _ticketOptions.FirstOrDefault(x => x.IdTicket == id);
        if (ticket is not null)
            SeleccionarTicket(ticket);
        await Task.CompletedTask;
    }

    private async Task OnClienteSearchChangedAsync(ChangeEventArgs args)
    {
        _clienteSearch = Convert.ToString(args.Value) ?? string.Empty;
        _form.ClienteCodigo = string.Empty;
        _form.IdContacto = null;
        await BuscarClientesAsync();
    }

    private async Task BuscarClientesAsync()
    {
        if (_clienteSearch.Trim().Length < 2)
        {
            _clienteOptions.Clear();
            return;
        }

        var result = await UiOps.RunAsync(() => PartesSvc.SearchClientesAsync(_clienteSearch), "No se pudieron buscar clientes.");
        if (result.Success && result.Value is not null)
            _clienteOptions = result.Value.ToList();
        else if (result.Feedback is not null)
            _feedback = result.Feedback;
    }

    private async Task SeleccionarClienteAsync(ParteHoraLookupOptionDto cliente)
    {
        _form.ClienteCodigo = cliente.Codigo;
        _clienteSearch = $"{cliente.Titulo} ({cliente.Codigo})";
        _form.IdContacto = null;
        _form.IdTicket = null;
        _ticketSelectValue = TicketSelectDefaultValue;
        _personaSearch = string.Empty;
        _clienteOptions.Clear();
        _personaOptions.Clear();
        await BuscarTicketsAsync();
    }

    private async Task OnPersonaSearchChangedAsync(ChangeEventArgs args)
    {
        _personaSearch = Convert.ToString(args.Value) ?? string.Empty;
        _form.IdContacto = null;
        _form.Usuario = _personaSearch;
        await BuscarPersonasAsync();
    }

    private async Task BuscarPersonasAsync()
    {
        if (_personaSearch.Trim().Length < 2 && string.IsNullOrWhiteSpace(_form.ClienteCodigo))
        {
            _personaOptions.Clear();
            return;
        }

        var result = await UiOps.RunAsync(() => PartesSvc.SearchPersonasAsync(_personaSearch, _form.ClienteCodigo), "No se pudieron buscar contactos o usuarios.");
        if (result.Success && result.Value is not null)
            _personaOptions = result.Value.ToList();
        else if (result.Feedback is not null)
            _feedback = result.Feedback;
    }

    private void SeleccionarPersona(ParteHoraPersonaOptionDto persona)
    {
        _form.IdContacto = persona.IdContacto;
        _form.Usuario = string.IsNullOrWhiteSpace(persona.Usuario) ? persona.Nombre : persona.Usuario;
        if (string.IsNullOrWhiteSpace(_form.ClienteCodigo) && !string.IsNullOrWhiteSpace(persona.ClienteCodigo))
        {
            _form.ClienteCodigo = persona.ClienteCodigo;
            _clienteSearch = string.IsNullOrWhiteSpace(persona.ClienteNombre) ? persona.ClienteCodigo : $"{persona.ClienteNombre} ({persona.ClienteCodigo})";
        }

        _personaSearch = persona.Nombre;
        _personaOptions.Clear();
    }

    private void AgregarLinea()
    {
        var previous = _lineas.LastOrDefault();
        _lineas.Add(new ParteHoraLineaForm
        {
            IdTecnico = previous?.IdTecnico ?? string.Empty,
            TipoTrabajo = previous?.TipoTrabajo ?? ParteHoraTipoTrabajoKeys.Soporte,
            Minutos = 15
        });
    }

    private void QuitarLinea(int index)
    {
        if (_lineas.Count <= 1 || index < 0 || index >= _lineas.Count)
            return;

        _lineas.RemoveAt(index);
    }

    private Task HandleLineaKeyDownAsync(KeyboardEventArgs args, int index)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return InsertarLineaDespuesAsync(index);

        return Task.CompletedTask;
    }

    private Task InsertarLineaDespuesAsync(int index)
    {
        var previous = index >= 0 && index < _lineas.Count ? _lineas[index] : _lineas.LastOrDefault();
        var nueva = new ParteHoraLineaForm
        {
            IdTecnico = previous?.IdTecnico ?? string.Empty,
            TipoTrabajo = previous?.TipoTrabajo ?? ParteHoraTipoTrabajoKeys.Soporte,
            Minutos = 15
        };

        if (index < 0 || index >= _lineas.Count - 1)
            _lineas.Add(nueva);
        else
            _lineas.Insert(index + 1, nueva);

        var focusIndex = Math.Min(index + 1, _lineas.Count - 1);
        _pendingLineaDescripcionFocusIndex = focusIndex;
        return Task.CompletedTask;
    }

    private static string GetLineaDescripcionId(int index)
        => $"parte-linea-desc-{index.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private static string FormatParteHoraTicket(ParteHoraTicketOptionDto ticket)
    {
        var code = string.IsNullOrWhiteSpace(ticket.CodigoVisible)
            ? ticket.Numero.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : ticket.CodigoVisible;
        return $"#{code} - {DisplayText(ticket.Titulo, ticket.ClienteNombre)}";
    }

    private static string DisplayText(string value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private async Task BorrarParteAsync(long id)
    {
        var result = await UiOps.RunAsync(() => PartesSvc.DeleteAsync(id, AppUserSession.GetCurrentUserName(Environment.UserName)), "No se pudo borrar el parte.");
        _feedback = result.Success ? AppUiMessage.Success("Parte borrado", "El registro fue dado de baja.") : result.Feedback;
        await BuscarAsync();
    }

    private async Task CargarConfigClienteAsync()
    {
        var cliente = _config.ClienteCodigo;
        var result = await UiOps.RunAsync(() => PartesSvc.GetClienteConfigAsync(cliente), "No se pudo cargar la bolsa del cliente.");
        if (result.Success)
        {
            _config = result.Value ?? new ParteHoraClienteConfigDto { ClienteCodigo = cliente, Activa = true };
            return;
        }

        _feedback = result.Feedback;
    }

    private async Task GuardarConfigClienteAsync()
    {
        var result = await UiOps.RunAsync(() => PartesSvc.SaveClienteConfigAsync(_config, AppUserSession.GetCurrentUserName(Environment.UserName)), "No se pudo guardar la bolsa del cliente.");
        _feedback = result.Success ? AppUiMessage.Success("Bolsa guardada", "La configuración mensual del cliente quedó actualizada.") : result.Feedback;
        await BuscarAsync();
    }

    private static string FormatMinutes(int minutes)
        => $"{minutes / 60}h {minutes % 60:00}m";

    private string FormatDateRange()
    {
        var desde = _filters.FechaDesde?.ToString("dd/MM/yyyy") ?? "Sin inicio";
        var hasta = _filters.FechaHasta?.ToString("dd/MM/yyyy") ?? "Sin fin";
        return $"{desde} - {hasta}";
    }

