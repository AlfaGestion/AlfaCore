    private static string FormatPersonaOption(ParteHoraPersonaOptionDto persona)
    {
        var datos = new List<string>();
        if (!string.IsNullOrWhiteSpace(persona.ClienteNombre))
            datos.Add($"{persona.ClienteCodigo} {persona.ClienteNombre}".Trim());
        if (!string.IsNullOrWhiteSpace(persona.Telefono))
            datos.Add(persona.Telefono);
        if (!string.IsNullOrWhiteSpace(persona.Celular))
            datos.Add(persona.Celular);
        if (!string.IsNullOrWhiteSpace(persona.Email))
            datos.Add(persona.Email);
        if (!string.IsNullOrWhiteSpace(persona.Direccion))
            datos.Add(persona.Direccion);
        if (datos.Count == 0 && !string.IsNullOrWhiteSpace(persona.Tipo))
            datos.Add(persona.Tipo);

        return string.Join(" · ", datos);
    }

    private static string GetFeedbackClass(AppUiMessage feedback)
        => feedback.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--success",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            AppUiFeedbackSeverity.Error => "editor-msg--error",
            _ => "editor-msg--info"
        };

