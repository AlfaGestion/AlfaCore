        <button type="button" class="cuentas-tab @GetPartesTabClass(PartesTabConsumo)" @onclick='() => _partesActiveTab = PartesTabConsumo'>Consumo por cliente</button>
        <button type="button" class="cuentas-tab @GetPartesTabClass(PartesTabBolsa)" @onclick='() => _partesActiveTab = PartesTabBolsa'>Bolsa mensual</button>
