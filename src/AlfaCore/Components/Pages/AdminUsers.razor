@page "/admin/users"
@page "/{idweb}/{idbase:int}/admin/users"
@layout AlfaCore.Components.Layout.MainLayout
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ICentralAdminService AdminSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components

<PageTitle>Admin usuarios | AlfaCore</PageTitle>

<div class="panel-card">
    <div class="panel-card__header">
        <div>
            <h1 class="panel-card__title">Usuarios centrales</h1>
            <p class="panel-card__subtitle">Alta y ediciÃ³n de usuarios en ALFA_CENTRAL.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-light" @onclick="GoHome">Inicio</button>
            <button type="button" class="btn btn-primary" @onclick="StartNew">Nuevo usuario</button>
        </div>
    </div>

    @if (_loading)
    {
        <p>Cargando usuarios...</p>
    }
    else if (!IsSuperAdmin)
    {
        <div class="editor-msg editor-msg--warning">
            <strong>Acceso restringido</strong>
            <p>Solo los superadmin pueden ver esta secciÃ³n.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Cliente))
        {
            <div class="editor-msg editor-msg--info">
                <strong>Filtro activo</strong>
                <p>Mostrando usuarios del cliente <strong>@Cliente</strong>.</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="editor-msg editor-msg--success">
                <strong>Listo</strong>
                <p>@_message</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="editor-msg editor-msg--warning">
                <strong>No se pudo guardar</strong>
                <p>@_error</p>
            </div>
        }

        <div class="row g-3">
            <div class="col-12 col-xl-5">
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h2 class="panel-card__title">@(_editing ? "Editar usuario" : "Nuevo usuario")</h2>
                            <p class="panel-card__subtitle">La contraseÃ±a no se muestra en ningÃºn listado.</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input class="form-control" @bind="_form.UserName" disabled="@_editing" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cliente</label>
                        <select class="form-select" @bind="_form.IdCliente">
                            <option value="">SeleccionÃ¡ un cliente</option>
                            @foreach (var client in _clients)
                            {
                                <option value="@client.IdCliente">@client.IdCliente - @client.RazonSocial</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ContraseÃ±a</label>
                        <input class="form-control" type="password" @bind="_form.Password" placeholder="Dejala vacÃ­a para conservar la actual al editar" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" @onclick="SaveAsync">@(_editing ? "Guardar cambios" : "Crear usuario")</button>
                        <button type="button" class="btn btn-outline-light" @onclick="StartNew">Limpiar</button>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h2 class="panel-card__title">Listado</h2>
                            <p class="panel-card__subtitle">Usuarios registrados en la central.</p>
                        </div>
                    </div>

                    @if (FilteredItems.Count == 0)
                    {
                        <p>No hay usuarios para mostrar.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Usuario</th>
                                        <th>Cliente</th>
                                        <th>RazÃ³n social</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in FilteredItems)
                                    {
                                        <tr>
                                            <td>@item.UserName</td>
                                            <td>@item.IdCliente</td>
                                            <td>@item.RazonSocial</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => EditAsync(item.UserName)">Editar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly CrearUserRequest _form = new();
    private readonly List<AlfaCore.Models.AdminUserDto> _items = [];
    private readonly List<AlfaCore.Models.AdminClienteDto> _clients = [];
    [SupplyParameterFromQuery(Name = "cliente")]
    public string? Cliente { get; set; }

    private bool _loading = true;
    private bool _editing;
    private bool IsSuperAdmin => AppUserSession.CurrentUser?.SuperAdmin == true;
    private string _message = string.Empty;
    private string _error = string.Empty;

    private IReadOnlyList<AlfaCore.Models.AdminUserDto> FilteredItems => string.IsNullOrWhiteSpace(Cliente)
        ? _items
        : _items.Where(item => string.Equals(item.IdCliente, Cliente, StringComparison.OrdinalIgnoreCase)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        if (!IsSuperAdmin)
        {
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private void GoHome()
        => Nav.NavigateTo(RouteContext.BuildRoute("/admin"));

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items.Clear();
            _clients.Clear();
            _items.AddRange(await AdminSvc.GetUsersAsync());
            _clients.AddRange(await AdminSvc.GetClientesAsync());
            if (!string.IsNullOrWhiteSpace(Cliente) && string.IsNullOrWhiteSpace(_form.IdCliente))
                _form.IdCliente = Cliente.Trim();
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartNew()
    {
        _editing = false;
        _form.UserName = string.Empty;
        _form.IdCliente = string.Empty;
        _form.Password = string.Empty;
    }

    private async Task EditAsync(string userName)
    {
        var item = await AdminSvc.GetUserAsync(userName);
        if (item is null)
            return;

        _editing = true;
        _message = string.Empty;
        _error = string.Empty;
        _form.UserName = item.UserName;
        _form.IdCliente = item.IdCliente;
        _form.Password = string.Empty;
    }

    private async Task SaveAsync()
    {
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            if (_editing)
                await AdminSvc.UpdateUserAsync(_form);
            else
                await AdminSvc.CreateUserAsync(_form);

            await LoadAsync();
            _message = _editing ? "Usuario actualizado." : "Usuario creado.";
            StartNew();
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
    }
}
