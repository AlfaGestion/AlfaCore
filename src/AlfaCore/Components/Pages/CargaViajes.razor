    private async Task ActualizarTarifaIdListaAsync()
    {
        if (!_isNewTarifa)
        {
            _tarifaForm.IdLista = _tarifaOriginalIdLista;
            return;
        }

        var codigoBase = _tarifaForm.TarifaFletero ? _tarifaForm.Chofer : _tarifaForm.Cliente;
        var normalized = (codigoBase ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            _tarifaForm.IdLista = string.Empty;
            return;
        }

        try
        {
            _tarifaForm.IdLista = await CargaViajesSvc.GetUniqueTarifaListaCodigoAsync(normalized, _tarifaForm.TarifaFletero);
        }
        catch (Exception ex)
        {
            _tarifaForm.IdLista = string.Empty;
            _tarifaEditorFeedback = UiOps.BuildMessage(ex, "No se pudo determinar el Id lista de la tarifa.");
        }
    }

    private static string BuildLookupDisplayText(CargaViajeLookupOptionDto item)
    {
        var title = (item.Titulo ?? string.Empty).Trim();
        var code = (item.Codigo ?? string.Empty).Trim();
        return string.IsNullOrWhiteSpace(title) ? code : title;
    }

    private static string BuildListaDesdeCodigo(string codigo, bool esFletero = false)
    {
        var value = (codigo ?? string.Empty).Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        if (esFletero)
        {
            var lastThree = value.Length <= 3 ? value : value[^3..];
            return $"F{lastThree.PadLeft(3, '0')}";
        }

        return value.Length <= 4
            ? value.PadLeft(4, '0')
            : value[^4..];
    }

    private static string GetTarifaImporteInputId(int id) => $"tarifa-importe-{id}";

    private async Task ActivarEdicionRapidaTarifaAsync(CargaViajeTarifaGridItemDto row, int index)
    {
        if (!_tarifasQuickImportEditMode || row.Id <= 0)
            return;

        _tarifasQuickImportEditId = row.Id;
