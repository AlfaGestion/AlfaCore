                            <table class="data-table carga-viajes-liquidaciones__table">
                                <thead>
                                    <tr>
                                        <th>Selección</th>
                                        <th>Fecha</th>
                                        <th>Comprobante</th>
                                        <th>Chofer</th>
                                        <th>Tipo</th>
                                        <th>Cliente</th>
                                        <th>Destino</th>
                                        <th>Tipo vehículo</th>
                                        <th>Cantidad viajes</th>
                                        <th>Total flete</th>
                                        <th>Pagado</th>
                                        <th>Fecha pago</th>
                                        <th>Usuario pago</th>
                                        <th>Observación pago</th>
