@page "/carga-viajes"
@page "/carga-viajes/{Vista}"
@using AlfaCore.Models
@using AlfaCore.Services
@inject ICargaViajesService CargaViajesSvc
@inject IAppUiOperationService UiOps
@inject IAppUiDialogService AppDialogs
@inject IAppUserSessionService AppUserSession
@inject IJSRuntime Js
@inject ILogger<CargaViajes> Logger
@inject NavigationManager Nav

<PageTitle>Carga de Viajes | Alfa Gestión</PageTitle>

<div class="page-grid carga-viajes-page @(IsAnyOverlayOpen() ? "carga-viajes-page--overlay-open" : string.Empty)" @onclick="HandlePageClickAsync">
    <header class="carga-viajes-brand">
        <span class="carga-viajes-brand__eyebrow">ALFA GESTIÓN</span>
        <h1 class="carga-viajes-brand__title">Carga de Viajes</h1>
    </header>

    <section class="carga-viajes-tabs">
        <div class="actions carga-viajes-tabs__actions">
            <button type="button" class="btn btn--sm @(_activeSection == SectionViajes ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionViajes)">Viajes</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionTarifas ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionTarifas)">Tarifas</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionChoferes ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionChoferes)">Choferes</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionDestinos ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionDestinos)">Destinos</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionTipoVehiculo ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionTipoVehiculo)">Tipo vehículo</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionReportes ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionReportes)">Reportes</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionLiquidaciones ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionLiquidaciones)">Liquidaciones</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionConfiguracion ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionConfiguracion)">Configuración</button>
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="carga-viajes-feedback" hidden="@IsAnyOverlayOpen()">
            <div class="editor-msg carga-viajes-feedback__box @GetFeedbackClass(_feedback)">
                <div class="carga-viajes-feedback__content">
                    @if (ShouldShowFeedbackTitle(_feedback))
                    {
                        <strong class="carga-viajes-feedback__title">@_feedback.Title</strong>
                    }
                    <div class="carga-viajes-feedback__line">
                        <span>@FormatFeedbackMessage(_feedback)</span>
                    </div>
                    @if (_feedback.HasSuggestion)
                    {
                        <small class="carga-viajes-feedback__suggestion">@_feedback.Suggestion</small>
                    }
                </div>
            </div>
        </section>
    }

    @if (_activeSection == SectionViajes || _activeSection == SectionNuevo)
    {
        <section class="panel-card carga-viajes-section carga-viajes-section--filters" @onkeydown="HandleViajesFilterKeyDownAsync">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Viajes</h3>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary btn--sm" @onclick="AbrirNuevoViajeAsync"><i class="bi bi-plus-lg"></i> Nuevo viaje</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="RecargarViajesAsync" disabled="@_viajesLoading">Recargar</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="AbrirConfiguracionVista">Configurar vista</button>
                </div>
            </div>

            <div class="carga-viajes-toolbar">
                <div class="field field--wide carga-viajes-toolbar__search">
                    <label>Búsqueda general</label>
                    <input type="search" @bind="_viajesFilters.Texto" @bind:event="oninput" />
                </div>
                <div class="carga-viajes-toolbar__actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="ToggleViajesAdvancedFilters" aria-expanded="@_showViajesAdvancedFilters" aria-controls="carga-viajes-viajes-filtros-avanzados">
                        @(_showViajesAdvancedFilters ? "Ocultar filtros" : "Filtros")
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltrosViajesAsync" disabled="@_viajesLoading">Limpiar</button>
                </div>
            </div>

            @if (_showViajesAdvancedFilters)
            {
                <div id="carga-viajes-viajes-filtros-avanzados" class="carga-viajes-advanced-grid">
                    <div class="carga-viajes-date-row field--wide">
                        <div class="field">
                            <label>Fecha desde</label>
                            <InputDate @bind-Value="_viajesFilters.FechaDesde" />
                        </div>
                        <div class="field">
                            <label>Fecha hasta</label>
                            <InputDate @bind-Value="_viajesFilters.FechaHasta" />
                        </div>
                    </div>
                    <div class="field">
                        <label>Cliente</label>
                        <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_clienteFiltroTexto" TextChanged="OnClienteFiltroTextoChangedAsync" SelectedChanged="OnClienteSeleccionadoAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" />
                    </div>
                    <div class="field">
                        <label>Chofer</label>
                        <LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_choferFiltroTexto" TextChanged="OnChoferFiltroTextoChangedAsync" SelectedChanged="OnChoferSeleccionadoAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" />
                    </div>
                    <div class="field">
                        <label>Destino</label>
                        <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_destinoFiltroTexto" TextChanged="OnDestinoFiltroTextoChangedAsync" SelectedChanged="OnDestinoSeleccionadoAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" />
                    </div>
                    <div class="field">
                        <label>Estado</label>
                        <select @bind="_viajesFilters.Estado">
                            <option value="">Todos</option>
                            @foreach (var estado in _lookups.Estados)
                            {
                                <option value="@estado">@estado</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Usuario</label>
                        <input type="text" @bind="_viajesFilters.Usuario" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label>Id comprobante</label>
                        <input type="text" @bind="_viajesFilters.IdComprobante" @bind:event="oninput" />
                    </div>
                </div>
            }
        </section>

        @if (_showViewSettings)
        {
            <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onclick="CancelarConfiguracionVista">
                <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--wide" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-view-settings-title" @onclick:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                    <header class="cuentas-modal__header">
                        <div>
                            <span class="cuentas-modal__eyebrow">Viajes</span>
                            <h3 id="carga-viajes-view-settings-title">Configuración de vista</h3>
                        </div>
                        <button type="button" class="cuentas-modal__close" @onclick="CancelarConfiguracionVista" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>

                    <div class="cuentas-modal__body">
                        <div class="usuarios-view-settings">
                            <div class="field">
                                <label>Agrupar por</label>
                                <select @bind="_draftAgruparPor">
                                    <option value="@CargaViajesViewGroupKeys.None">Sin agrupar</option>
                                    <option value="@CargaViajesViewGroupKeys.Estado">Estado</option>
                                    <option value="@CargaViajesViewGroupKeys.Usuario">Usuario</option>
                                </select>
                            </div>

                            <div class="usuarios-view-settings__list">
                                @foreach (var column in _viewSettingsDraft.Columnas.OrderBy(c => c.Order))
                                {
                                    <div class="usuarios-view-settings__item">
                                        <label class="carga-viajes-check">
                                            <input class="carga-viajes-check__input" type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                            <span class="carga-viajes-check__box" aria-hidden="true"></span>
                                            <span class="carga-viajes-check__text">@column.Label</span>
                                        </label>
                                        <div class="actions">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">â†‘</button>
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">â†“</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <footer class="cuentas-modal__actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">Guardar vista</button>
                        <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">Cancelar</button>
                    </footer>
                </section>
            </div>
        }

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Viajes</h3>
                    <span class="panel-card__subtitle">@_viajesTotal registro(s) · Página @_viajesPage de @_viajesTotalPages</span>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="RecargarViajesAsync" disabled="@_viajesLoading">Recargar</button>
                </div>
            </div>

            @if (_viajesLoading)
            {
                <div class="usuarios-empty">Cargando viajes...</div>
            }
            else if (_viajes.Count == 0)
            {
                <div class="usuarios-empty">No hay viajes para los filtros seleccionados.</div>
            }
            else
            {
                var visibleColumns = GetVisibleColumns();
                var groups = BuildViajeGroups();
                <div class="usuarios-table-wrap">
                    <table class="data-table usuarios-table">
                        <thead>
                            <tr>
                                @foreach (var column in visibleColumns)
                                {
                                    <th>@column.Label</th>
                                }
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@(visibleColumns.Count + 1)">@group.Label</td>
                                    </tr>
                                }
                                @foreach (var row in group.Items)
                                {
                                    <tr class="data-grid__row" @ondblclick="() => EditarViajeAsync(row.Id)">
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td>@RenderViajeColumn(row, col.Key)</td>
                                        }
                                        <td>
                                            <div class="actions">
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => VerViajeAsync(row.Id)">Ver</button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarViajeAsync(row.Id)">Editar</button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AnularViajeAsync(row.Id)">Anular</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
            }

            <div class="result-pagination">
                <div class="result-pagination__info">Total: @_viajesTotal</div>
                <div class="result-pagination__controls">
                    <button class="result-pagination__btn" @onclick="() => CambiarPaginaViajesAsync(_viajesPage - 1)" disabled="@(_viajesPage <= 1)">Anterior</button>
                    <button class="result-pagination__btn" @onclick="() => CambiarPaginaViajesAsync(_viajesPage + 1)" disabled="@(_viajesPage >= _viajesTotalPages)">Siguiente</button>
                </div>
            </div>
        </section>
    }
    else if (_activeSection == SectionTarifas)
    {
        <section class="panel-card carga-viajes-section carga-viajes-section--filters">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Tarifas</h3>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary btn--sm" @onclick="NuevaTarifaAsync">Nueva tarifa</button>
                </div>
            </div>

            <div class="carga-viajes-toolbar">
                <div class="field field--wide carga-viajes-toolbar__search">
                    <label>Búsqueda general</label>
                    <input type="search" @bind="_tarifasFilters.Texto" @bind:event="oninput" />
                </div>
                <div class="carga-viajes-toolbar__actions">
                    <button type="button"
                            class="carga-viajes-check carga-viajes-quick-edit-toggle @(_tarifasQuickImportEditMode ? "carga-viajes-check--active" : string.Empty)"
                            aria-pressed="@_tarifasQuickImportEditMode"
                            @onclick="ToggleTarifasQuickImportEditModeAsync">
                        <span class="carga-viajes-check__text">Editar solo importes</span>
                        <span class="carga-viajes-check__pill" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="ToggleTarifasAdvancedFilters" aria-expanded="@_showTarifasAdvancedFilters" aria-controls="carga-viajes-tarifas-filtros-avanzados">
                        @(_showTarifasAdvancedFilters ? "Ocultar filtros" : "Filtros")
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltrosTarifasAsync">Limpiar</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="RecargarTarifasAsync">Recargar</button>
                </div>
            </div>

            @if (_showTarifasAdvancedFilters)
            {
                <div id="carga-viajes-tarifas-filtros-avanzados" class="carga-viajes-advanced-grid">
                    <div class="field">
                        <label>Cliente</label>
                        <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_tarifasFilters.Cliente" TextChanged="OnTarifaClienteFiltroChangedAsync" SelectedChanged="OnTarifaClienteFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" />
                    </div>
                    <div class="field">
                        <label>Chofer</label>
                        <LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_tarifasFilters.Chofer" TextChanged="OnTarifaChoferFiltroChangedAsync" SelectedChanged="OnTarifaChoferFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" />
                    </div>
                    <div class="field">
                        <label>Destino</label>
                        <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_tarifasFilters.Destino" TextChanged="OnTarifaDestinoFiltroChangedAsync" SelectedChanged="OnTarifaDestinoFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" />
                    </div>
                    <div class="field">
                        <label>Tipo vehículo</label>
                        <LookupAutocomplete Label="" Placeholder="Buscar tipo..." Text="@_tarifasFilters.TipoVehiculo" TextChanged="OnTarifaTipoVehiculoFiltroChangedAsync" SelectedChanged="OnTarifaTipoVehiculoFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" />
                    </div>
                    <div class="field">
                        <label>Tarifa fletero</label>
                        <select @bind="_tarifasFilters.TarifaFletero">
                            <option value="">Todas</option>
                            <option value="0">Cliente</option>
                            <option value="1">Fletero</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Activo</label>
                        <select @bind="_tarifasFilters.Activo">
                            <option value="">Todos</option>
                            <option value="1">Activo</option>
                            <option value="0">Desactivado</option>
                        </select>
                    </div>
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Listado de tarifas</h3>
                    <span class="panel-card__subtitle">@_tarifasTotal registro(s)</span>
                </div>
            </div>
            @if (_tarifasLoading)
            {
                <div class="usuarios-empty">Cargando tarifas...</div>
            }
            else if (_tarifas.Count == 0)
            {
                <div class="usuarios-empty">Sin tarifas para mostrar.</div>
            }
            else
            {
                <div class="usuarios-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nombre</th><th>Tipo tarifa</th><th>Cliente / Chofer</th><th>Destino</th><th>Tipo vehículo</th><th>Importe</th><th>Activo</th><th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _tarifas.Select((row, index) => new { row, index }))
                            {
                                <tr class="@GetTarifaRowClass(item.row, item.index)" @ondblclick="() => EditarTarifaAsync(item.row)">
                                    <td>@item.row.Nombre</td>
                                    <td>@(item.row.TarifaFletero ? "Fletero" : "Cliente")</td>
                                    <td>@GetTarifaEntidadDisplay(item.row)</td>
                                    <td>@item.row.Destino</td>
                                    <td>@item.row.TipoVehiculo</td>
                                    <td class="@GetTarifaImporteCellClass(item.row)" @onclick:stopPropagation="_tarifasQuickImportEditMode" @ondblclick:stopPropagation="_tarifasQuickImportEditMode">
                                        @if (_tarifasQuickImportEditMode && _tarifasQuickImportEditId == item.row.Id && item.row.Id > 0)
                                        {
                                            <input id="@GetTarifaImporteInputId(item.row.Id)"
                                                   class="carga-viajes-tarifas__importe-editor"
                                                   type="text"
                                                   inputmode="decimal"
                                                   step="0.01"
                                                   @bind-value="_tarifasQuickImportValue"
                                                   @bind-value:event="oninput"
                                                   @onfocus="() => SelectTarifaImporteAsync(item.row.Id)"
                                                   @onkeydown="args => HandleTarifaImporteKeyDownAsync(args, item.row, item.index)" />
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="carga-viajes-tarifas__importe-cell"
                                                    @onclick:stopPropagation="true"
                                                    @ondblclick:stopPropagation="true"
                                                    @onclick="() => ActivarEdicionRapidaTarifaAsync(item.row, item.index)">
                                                @item.row.Importe.ToString("N2")
                                            </button>
                                        }
                                    </td>
                                    <td>@(item.row.Activo ? "Activo" : "Desactivado")</td>
                                    <td>
                                        <div class="actions">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarTarifaAsync(item.row)">Editar</button>
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => BajaTarifaAsync(item.row)">Baja</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (_showTarifaEditor)
        {
            <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onclick="CerrarTarifaEditorAsync">
                <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--wide" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-tarifa-title" @onclick:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                    <header class="cuentas-modal__header">
                        <div>
                            <span class="cuentas-modal__eyebrow">Tarifas</span>
                            <h3 id="carga-viajes-tarifa-title">@(_isNewTarifa ? "Nueva tarifa" : "Editar tarifa")</h3>
                        </div>
                        <button type="button" class="cuentas-modal__close" @onclick="CerrarTarifaEditorAsync" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>
                    <div class="cuentas-modal__body">
                        <div class="carga-viajes-form-grid carga-viajes-tarifa-editor__grid">
                            <div class="field field--wide">
                                <label>Tipo de tarifa</label>
                                <div class="carga-viajes-tarifa-editor__type" role="group" aria-label="Tipo de tarifa">
                                    <button type="button"
                                            class="carga-viajes-filter-pill @(!_tarifaForm.TarifaFletero ? "carga-viajes-filter-pill--active" : string.Empty)"
                                            aria-pressed="@(!_tarifaForm.TarifaFletero)"
                                            @onclick="SetTarifaClienteTypeAsync">
                                        <span class="carga-viajes-filter-pill__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                        <span>Cliente</span>
                                    </button>
                                    <button type="button"
                                            class="carga-viajes-filter-pill @(_tarifaForm.TarifaFletero ? "carga-viajes-filter-pill--active" : string.Empty)"
                                            aria-pressed="@_tarifaForm.TarifaFletero"
                                            @onclick="SetTarifaFleteroTypeAsync">
                                        <span class="carga-viajes-filter-pill__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                        <span>Fletero</span>
                                    </button>
                                </div>
                            </div>

                            <div class="field field--wide">
                                @if (_tarifaForm.TarifaFletero)
                                {
                                    <label>Chofer / fletero</label>
                                    <LookupAutocomplete @ref="_tarifaChoferLookup"
                                                        Label=""
                                                        Placeholder="Buscar chofer o fletero..."
                                                        Text="@_tarifaChoferTexto"
                                                        TextChanged="OnTarifaChoferTextoChangedAsync"
                                                        SelectedChanged="OnTarifaChoferSeleccionadoAsync"
                                                        OnEnterCommitted="FocusTarifaNombreAsync"
                                                        SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" />
                                }
                                else
                                {
                                    <label>Cliente</label>
                                    <LookupAutocomplete @ref="_tarifaClienteLookup"
                                                        Label=""
                                                        Placeholder="Buscar cliente..."
                                                        Text="@_tarifaClienteTexto"
                                                        TextChanged="OnTarifaClienteTextoChangedAsync"
                                                        SelectedChanged="OnTarifaClienteSeleccionadoAsync"
                                                        OnEnterCommitted="FocusTarifaNombreAsync"
                                                        SearchFunc="CargaViajesSvc.SearchClientesAsync" />
                                }
                            </div>

                            <div class="field field--wide">
                                <label>Nombre de lista</label>
                                <input @ref="_tarifaNombreInput" type="text" @bind="_tarifaForm.Nombre" @onkeydown="args => HandleEnterAdvanceAsync(args, FocusTarifaDestinoAsync)" />
                            </div>

                            <div class="field">
                                <label>Destino</label>
                                <LookupAutocomplete @ref="_tarifaDestinoLookup"
                                                    Label=""
                                                    Placeholder="Buscar destino..."
                                                    Text="@_tarifaDestinoTexto"
                                                    TextChanged="OnTarifaDestinoTextoChangedAsync"
                                                    SelectedChanged="OnTarifaDestinoSeleccionadoAsync"
                                                    OnEnterCommitted="FocusTarifaTipoVehiculoAsync"
                                                    SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" />
                            </div>

                            <div class="field">
                                <label>Tipo vehículo</label>
                                <LookupAutocomplete @ref="_tarifaTipoVehiculoLookup"
                                                    Label=""
                                                    Placeholder="Buscar tipo..."
                                                    Text="@_tarifaTipoVehiculoTexto"
                                                    TextChanged="OnTarifaTipoVehiculoTextoChangedAsync"
                                                    SelectedChanged="OnTarifaTipoVehiculoSeleccionadoAsync"
                                                    OnEnterCommitted="FocusTarifaImporteAsync"
                                                    SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" />
                            </div>

                            <div class="field">
                                <label>Importe</label>
