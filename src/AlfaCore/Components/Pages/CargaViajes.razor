        _reporteLiquidacionFilters.FechaDesde ??= defaults.FechaDesde;
        _reporteLiquidacionFilters.FechaHasta ??= defaults.FechaHasta;
        if (string.IsNullOrWhiteSpace(_reporteLiquidacionFilters.RangoRapido))
            _reporteLiquidacionFilters.RangoRapido = defaults.RangoRapido;
        if (string.IsNullOrWhiteSpace(_reporteLiquidacionFilters.TipoPersona))
            ApplyReporteTipoPersona(defaults.TipoPersona, clearSelection: false);
        else
            ApplyReporteTipoPersona(_reporteLiquidacionFilters.TipoPersona, clearSelection: false);
        if (string.IsNullOrWhiteSpace(_reporteLiquidacionFilters.Modo))
            _reporteLiquidacionFilters.Modo = defaults.Modo;
        if (string.IsNullOrWhiteSpace(_reporteLiquidacionFilters.Estado))
            _reporteLiquidacionFilters.Estado = defaults.Estado;
        if (string.IsNullOrWhiteSpace(_reporteLiquidacionFilters.EstadoPago))
            _reporteLiquidacionFilters.EstadoPago = defaults.EstadoPago;
        if (string.IsNullOrWhiteSpace(_reporteLiquidacionFilters.ChoferTexto))
            _reporteLiquidacionFilters.ChoferTexto = string.Empty;
        if (string.IsNullOrWhiteSpace(_reporteLiquidacionFilters.ClienteTexto))
