                                                    @(row.FletePagado ? "Pagado" : selected ? "Seleccionado" : "Seleccionar")
                                                </button>
                                            </td>
                                            <td>@row.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@row.Comprobante</td>
                                            <td>@DisplayText(row.ChoferNombre, row.ChoferCodigo)</td>
                                            <td>@(row.EsFletero ? "Fletero" : "Chofer")</td>
