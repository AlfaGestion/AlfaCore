    private void ApplyLiquidacionesTipoPersona(string value, bool clearSelection = true)
    {
        var normalized = NormalizeLiquidacionesTipoPersona(value);
        _liquidacionesFilters.TipoPersona = normalized;
        _liquidacionesFilters.IncluirChoferes = normalized != CargaViajesReporteTipoPersonaKeys.Fleteros;
        _liquidacionesFilters.IncluirFleteros = normalized != CargaViajesReporteTipoPersonaKeys.Choferes;
        SyncLiquidacionesTipoPersonaSelection(clearSelection);
    }

    private void SyncReporteTipoPersonaSelection(bool clearSelection = true)
    {
        if (!_reporteLiquidacionFilters.IncluirChoferes && !_reporteLiquidacionFilters.IncluirFleteros)
        {
            _reporteLiquidacionFilters.IncluirChoferes = true;
            _reporteLiquidacionFilters.IncluirFleteros = true;
        }

        _reporteLiquidacionFilters.TipoPersona = _reporteLiquidacionFilters.IncluirChoferes && _reporteLiquidacionFilters.IncluirFleteros
            ? CargaViajesReporteTipoPersonaKeys.ChoferesYFleteros
            : _reporteLiquidacionFilters.IncluirFleteros
                ? CargaViajesReporteTipoPersonaKeys.Fleteros
                : CargaViajesReporteTipoPersonaKeys.Choferes;

        if (clearSelection)
        {
            _reporteLiquidacionFilters.ChoferCodigo = string.Empty;
            _reporteLiquidacionFilters.ChoferTexto = string.Empty;
            _reporteChoferFleteroTexto = string.Empty;
        }
    }

    private void SyncLiquidacionesTipoPersonaSelection(bool clearSelection = true)
    {
        if (!_liquidacionesFilters.IncluirChoferes && !_liquidacionesFilters.IncluirFleteros)
        {
            _liquidacionesFilters.IncluirChoferes = true;
            _liquidacionesFilters.IncluirFleteros = true;
        }

        _liquidacionesFilters.TipoPersona = _liquidacionesFilters.IncluirChoferes && _liquidacionesFilters.IncluirFleteros
            ? CargaViajesReporteTipoPersonaKeys.ChoferesYFleteros
            : _liquidacionesFilters.IncluirFleteros
                ? CargaViajesReporteTipoPersonaKeys.Fleteros
                : CargaViajesReporteTipoPersonaKeys.Choferes;

        if (clearSelection)
        {
            _liquidacionesFilters.ChoferCodigo = string.Empty;
            _liquidacionesFilters.ChoferTexto = string.Empty;
            _liquidacionesChoferFleteroTexto = string.Empty;
        }
    }

    private void ApplyLiquidacionesRangoRapido(string value)
    {
        var normalized = NormalizeLiquidacionesRangoRapido(value);
        _liquidacionesFilters.RangoRapido = normalized;

        var today = DateTime.Today;
        switch (normalized)
        {
            case CargaViajesReporteRangoRapidoKeys.Hoy:
                _liquidacionesFilters.FechaDesde = today;
                _liquidacionesFilters.FechaHasta = today;
                break;
            case CargaViajesReporteRangoRapidoKeys.SemanaActual:
                var startOfWeek = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
                _liquidacionesFilters.FechaDesde = startOfWeek;
                _liquidacionesFilters.FechaHasta = startOfWeek.AddDays(6);
                break;
            case CargaViajesReporteRangoRapidoKeys.MesActual:
                var firstDay = new DateTime(today.Year, today.Month, 1);
                _liquidacionesFilters.FechaDesde = firstDay;
                _liquidacionesFilters.FechaHasta = firstDay.AddMonths(1).AddDays(-1);
                break;
            case CargaViajesReporteRangoRapidoKeys.MesAnterior:
                var firstDayPrev = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
                _liquidacionesFilters.FechaDesde = firstDayPrev;
                _liquidacionesFilters.FechaHasta = firstDayPrev.AddMonths(1).AddDays(-1);
                break;
            case CargaViajesReporteRangoRapidoKeys.AnioActual:
                _liquidacionesFilters.FechaDesde = new DateTime(today.Year, 1, 1);
                _liquidacionesFilters.FechaHasta = new DateTime(today.Year, 12, 31);
                break;
            case CargaViajesReporteRangoRapidoKeys.AnioAnterior:
                var prevYear = today.Year - 1;
                _liquidacionesFilters.FechaDesde = new DateTime(prevYear, 1, 1);
                _liquidacionesFilters.FechaHasta = new DateTime(prevYear, 12, 31);
                break;
            case CargaViajesReporteRangoRapidoKeys.Todo:
                _liquidacionesFilters.FechaDesde = null;
                _liquidacionesFilters.FechaHasta = null;
                break;
            default:
                _liquidacionesFilters.RangoRapido = CargaViajesReporteRangoRapidoKeys.Personalizado;
                break;
        }
    }

    private static string NormalizeLiquidacionesRangoRapido(string? value)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            CargaViajesReporteRangoRapidoKeys.Hoy => CargaViajesReporteRangoRapidoKeys.Hoy,
            CargaViajesReporteRangoRapidoKeys.SemanaActual => CargaViajesReporteRangoRapidoKeys.SemanaActual,
            CargaViajesReporteRangoRapidoKeys.MesActual => CargaViajesReporteRangoRapidoKeys.MesActual,
            CargaViajesReporteRangoRapidoKeys.MesAnterior => CargaViajesReporteRangoRapidoKeys.MesAnterior,
            CargaViajesReporteRangoRapidoKeys.AnioActual => CargaViajesReporteRangoRapidoKeys.AnioActual,
            CargaViajesReporteRangoRapidoKeys.AnioAnterior => CargaViajesReporteRangoRapidoKeys.AnioAnterior,
            CargaViajesReporteRangoRapidoKeys.Todo => CargaViajesReporteRangoRapidoKeys.Todo,
            _ => CargaViajesReporteRangoRapidoKeys.Personalizado
        };

    private static string NormalizeLiquidacionesTipoPersona(string? value)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            CargaViajesReporteTipoPersonaKeys.Choferes => CargaViajesReporteTipoPersonaKeys.Choferes,
            CargaViajesReporteTipoPersonaKeys.Fleteros => CargaViajesReporteTipoPersonaKeys.Fleteros,
            _ => CargaViajesReporteTipoPersonaKeys.ChoferesYFleteros
        };

    private static string NormalizeLiquidacionesEstado(string? value)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            CargaViajeEstadoKeys.Pendiente => CargaViajeEstadoKeys.Pendiente,
            CargaViajeEstadoKeys.Finalizado => CargaViajeEstadoKeys.Finalizado,
            CargaViajeEstadoKeys.Anulado => CargaViajeEstadoKeys.Anulado,
            _ => string.Empty
        };

