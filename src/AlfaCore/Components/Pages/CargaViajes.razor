    private static string FormatFilterDateRange(DateTime? desde, DateTime? hasta)
    {
        if (desde.HasValue && hasta.HasValue)
        {
            var desdeText = FormatReporteDate(desde);
            var hastaText = FormatReporteDate(hasta);
            return string.Equals(desdeText, hastaText, StringComparison.Ordinal) ? desdeText : $"{desdeText} - {hastaText}";
        }

        if (desde.HasValue)
            return $"Desde {FormatReporteDate(desde)}";

        if (hasta.HasValue)
            return $"Hasta {FormatReporteDate(hasta)}";

        return "Todo";
    }

