            }
            else if (_liquidacionesRows.Count == 0)
            {
                <div class="usuarios-empty">No se encontraron viajes para liquidar con los filtros seleccionados.</div>
            }
            else
            {
                var groups = GetLiquidacionGroups();
                @foreach (var group in groups)
                {
                    <section class="carga-viajes-liquidaciones__group">
                        <div class="carga-viajes-liquidaciones__group-header">
                            <div>
                                <h4>@group.Label</h4>
                                <span>@group.Items.Count viaje(s) · Total: @group.Items.Sum(x => x.TotalFlete).ToString("N2")</span>
                            </div>
                            <div class="actions">
                                <button type="button" class="carga-viajes-row-select carga-viajes-liquidaciones__group-action" @onclick="() => SeleccionarPendientesDelGrupoAsync(group.EsFletero)">@GetLiquidacionesGrupoActionLabel(group.EsFletero)</button>
                            </div>
                        </div>

