    }

    private async Task GuardarViajeAsync()
    {
        if (_savingViaje)
            return;

        _savingViaje = true;
        _viajeEditorFeedback = new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Info,
            Title = "Guardando viaje",
            Message = "Se está registrando el viaje. No cierres el modal."
        };

        try
        {
            var result = await UiOps.RunAsync(async () =>
            {
                var id = await CargaViajesSvc.SaveViajeAsync(_viajeForm);
                return id;
            }, "No se pudo guardar el viaje.");

            if (!result.Success)
            {
                _viajeEditorFeedback = result.Feedback;
                _feedback = result.Feedback;
                return;
            }

            var savedId = result.Value is int id ? id.ToString() : string.Empty;
            _viajeEditorFeedback = AppUiMessage.Success("Viaje guardado correctamente", string.IsNullOrWhiteSpace(savedId) ? "El viaje quedó registrado correctamente." : $"El viaje #{savedId} quedó registrado correctamente.");
            _feedback = _viajeEditorFeedback;
            _showViajeEditor = false;
            _viajeReadOnly = false;
            _viajeEditorFeedback = null;
            _viajesFilters.PageNumber = 1;
            await RecargarViajesAsync();
            await NavigateSectionAsync(SectionViajes);
        }
        finally
        {
            _savingViaje = false;
        }
    }

    private async Task LimpiarViajeFormAsync() => await AbrirNuevoViajeAsync();

    private async Task CerrarViajeEditorAsync()
    {
        _showViajeEditor = false;
        _viajeReadOnly = false;
        _viajeEditorFeedback = null;
        if (_activeSection == SectionNuevo)
            await NavigateSectionAsync(SectionViajes);
    }

    private async Task AnularViajeAsync(int id)
    {
        var result = await UiOps.RunAsync(() => CargaViajesSvc.AnularViajeAsync(id, AppUserSession.GetCurrentUserName(string.Empty)), "No se pudo anular el viaje.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Viaje anulado", "El viaje quedó en estado ANULADO.");
        await RecargarViajesAsync();
    }

    private IReadOnlyList<CargaViajesViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private IReadOnlyList<CargaViajeGroupDto> BuildViajeGroups()
    {
        if (_viewSettings.AgruparPor == CargaViajesViewGroupKeys.Estado)
            return _viajes.GroupBy(x => x.Estado).Select(g => new CargaViajeGroupDto { Label = g.Key, ShowHeader = true, Items = g.ToList() }).ToList();
        if (_viewSettings.AgruparPor == CargaViajesViewGroupKeys.Usuario)
            return _viajes.GroupBy(x => x.Usuario).Select(g => new CargaViajeGroupDto { Label = string.IsNullOrWhiteSpace(g.Key) ? "Sin usuario" : g.Key, ShowHeader = true, Items = g.ToList() }).ToList();
        return [new CargaViajeGroupDto { Label = string.Empty, ShowHeader = false, Items = _viajes.ToList() }];
    }

    private static string RenderViajeColumn(CargaViajesGridItemDto row, string key)
        => (key ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            CargaViajesViewColumnKeys.Fecha => row.Fecha.ToString("dd/MM/yyyy"),
            CargaViajesViewColumnKeys.IdComprobante => row.IdComprobante,
            CargaViajesViewColumnKeys.Cliente => $"{row.ClienteCodigo} - {row.ClienteNombre}",
            CargaViajesViewColumnKeys.Destino => $"{row.DestinoCodigo} - {row.DestinoDescripcion}",
            CargaViajesViewColumnKeys.Chofer => $"{row.ChoferCodigo} - {row.ChoferNombre}",
            CargaViajesViewColumnKeys.TipoVehiculo => $"{row.TipoVehiculoCodigo} - {row.TipoVehiculoDescripcion}",
            CargaViajesViewColumnKeys.TotalCliente => row.TotalCliente.ToString("N2"),
            CargaViajesViewColumnKeys.TotalFletero => row.TotalFletero.ToString("N2"),
            CargaViajesViewColumnKeys.Estado => row.Estado,
            CargaViajesViewColumnKeys.Usuario => row.Usuario,
            CargaViajesViewColumnKeys.Alta => row.FechaHoraAlta.HasValue ? row.FechaHoraAlta.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty,
            _ => string.Empty
        };

    private string GetAdicionalLabel(int index)
    {
        var name = _config.NombresAdicionales.ElementAtOrDefault(index);
        return string.IsNullOrWhiteSpace(name) ? $"Adicional {index + 1}" : name.Trim();
    }

    private static string FormatLookupDisplay(string code, string description)
    {
        var cleanCode = (code ?? string.Empty).Trim();
        var cleanDescription = (description ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(cleanCode))
            return cleanDescription;

        return string.IsNullOrWhiteSpace(cleanDescription)
            ? cleanCode
            : $"{cleanCode} - {cleanDescription}";
    }

    private static string FormatListaDisplay(string lista, string descripcion)
    {
        var display = FormatLookupDisplay(lista, descripcion);
        return string.IsNullOrWhiteSpace(display) ? string.Empty : display;
    }

    private void MapViajeToForm(CargaViajesDetailDto detail)
    {
        _viajeForm = new CargaViajeSaveRequest
        {
            Id = detail.Id,
            Tc = detail.Tc,
            IdComprobante = detail.IdComprobante,
            Fecha = detail.Fecha,
            Cliente = detail.ClienteCodigo,
            Chofer = detail.ChoferCodigo,
            Destino = detail.DestinoCodigo,
            TipoVehiculo = detail.TipoVehiculoCodigo,
            Lista = detail.Lista,
            ClienteDisplay = FormatLookupDisplay(detail.ClienteCodigo, detail.ClienteNombre),
            ChoferDisplay = FormatLookupDisplay(detail.ChoferCodigo, detail.ChoferNombre),
            DestinoDisplay = FormatLookupDisplay(detail.DestinoCodigo, detail.DestinoDescripcion),
            TipoVehiculoDisplay = FormatLookupDisplay(detail.TipoVehiculoCodigo, detail.TipoVehiculoDescripcion),
            ListaDisplay = FormatListaDisplay(detail.Lista, detail.ListaDescripcion),
            ImporteCliente = detail.TotalImporte,
            ImporteFletero = detail.TotalFlete,
            Peaje = detail.Peaje,
            CantidadViajes = detail.CantidadViajes,
            PorcentajeAdic = detail.PorcentajeAdic,
            PorcentajeAdic1 = detail.PorcentajeAdic1,
            PorcentajeAdic2 = detail.PorcentajeAdic2,
            PorcentajeAdic3 = detail.PorcentajeAdic3,
            PorcentajeAdic4 = detail.PorcentajeAdic4,
            Observaciones = detail.Observaciones,
            Estado = detail.Estado
        };

        _viajeClienteTexto = _viajeForm.ClienteDisplay;
        _viajeChoferTexto = _viajeForm.ChoferDisplay;
        _viajeDestinoTexto = _viajeForm.DestinoDisplay;
        _viajeTipoVehiculoTexto = _viajeForm.TipoVehiculoDisplay;
    }

