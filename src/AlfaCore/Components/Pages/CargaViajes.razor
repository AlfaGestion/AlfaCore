    private static string FormatTarifaUltimaModificacion(CargaViajeTarifaGridItemDto row)
    {
        if (!row.FechaHoraModificacion.HasValue && string.IsNullOrWhiteSpace(row.UsuarioModificacion))
            return "-";

        var fecha = row.FechaHoraModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "-";
        var usuario = string.IsNullOrWhiteSpace(row.UsuarioModificacion) ? string.Empty : row.UsuarioModificacion.Trim();
        return string.IsNullOrWhiteSpace(usuario) ? fecha : $"{fecha} · {usuario}";
    }

