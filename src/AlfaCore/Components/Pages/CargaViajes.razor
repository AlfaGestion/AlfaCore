                    <header class="cuentas-modal__header">
                        <div>
                            <span class="cuentas-modal__eyebrow">Tipo vehículo</span>
                            <h3 id="carga-viajes-tipo-vehiculo-title">@(_isNewTipoVehiculo ? "Nuevo tipo de vehículo" : $"Editar tipo de vehículo {_tipoVehiculoForm.Codigo}")</h3>
                        </div>
                        <button type="button" class="cuentas-modal__close" @onclick="CerrarTipoVehiculoEditorAsync" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>
                    <div class="cuentas-modal__body">
                        <div class="carga-viajes-form-grid">
                            <div class="field"><label>Código</label><input type="text" @bind="_tipoVehiculoForm.Codigo" disabled="@(!_isNewTipoVehiculo)" /></div>
