                                                       class="carga-viajes-adicionales__fixed-quantity-input"
                                                       min="1"
                                                       step="1"
                                                       value="@GetViajeAdicionalFijoCantidad(index).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
