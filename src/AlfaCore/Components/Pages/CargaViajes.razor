            (SortKeyTotalFletero, false) => list.OrderBy(x => x.TotalFlete).ThenBy(x => x.Fecha).ThenBy(x => x.Id).ToList(),
            (SortKeyTotalFletero, true) => list.OrderByDescending(x => x.TotalFlete).ThenByDescending(x => x.Fecha).ThenByDescending(x => x.Id).ToList(),
            (SortKeyPeaje, false) => list.OrderBy(x => x.Peaje).ThenBy(x => x.Fecha).ThenBy(x => x.Id).ToList(),
            (SortKeyPeaje, true) => list.OrderByDescending(x => x.Peaje).ThenByDescending(x => x.Fecha).ThenByDescending(x => x.Id).ToList(),
            (SortKeyTotal, false) => list.OrderBy(x => x.TotalConPeaje).ThenBy(x => x.Fecha).ThenBy(x => x.Id).ToList(),
