    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdatePageHeader();
    }

    private void UpdatePageHeader()
    {
        _lastPageHeaderSignature = BuildPageHeaderSignature();
        var actions = new List<PageHeaderAction>();
        RenderFragment? searchContent = null;

        var isEditingOverlayOpen = IsAnyEditingOverlayOpen();
        if (isEditingOverlayOpen)
            AddEditorHeaderActions(actions);

        PageHeader.Set(new PageHeaderConfig
        {
            Title = GetHeaderTitle(),
            Breadcrumb = [],
            State = GetHeaderState(),
            SearchContent = searchContent,
            Actions = actions,
            ViewButtons = BuildHeaderViewButtons(),
            InlineViewButtons = true,
            ActionsBelowViewButtons = isEditingOverlayOpen,
            AlwaysVisible = true,
            ShowHomeNavigation = !IsDirectRoute(),
            HomeUrl = RouteContext.BuildRoute("/"),
            HomeTitle = "Volver a Inicio",
            OnBack = IsAnyOverlayOpen() ? HandleHeaderBackAsync : null
        });

        _ = InvokeAsync(StateHasChanged);
    }

    private string BuildPageHeaderSignature()
        => string.Join('|',
            _activeSection,
            _showViajeEditor,
            _showTarifaEditor,
            _showChoferEditor,
            _showDestinoEditor,
            _showTipoVehiculoEditor,
            _showConfigEditor,
            _showViewSettings,
            _showTipoVehiculoViewSettings,
            _showLiquidacionesPagoModal,
            _isNewViaje,
            _isNewTarifa,
            _isNewChofer,
            _isNewDestino,
            _isNewTipoVehiculo,
            _savingViaje,
            _viajesLoading,
            _tarifasLoading,
            _choferesLoading,
            _destinosLoading,
            _tipoVehiculosLoading,
            _reportesLoading,
            _liquidacionesLoading,
            _liquidacionesSeleccionadas.Count);

    protected override void OnAfterRender(bool firstRender)
    {
        var signature = BuildPageHeaderSignature();
        if (!string.Equals(signature, _lastPageHeaderSignature, StringComparison.Ordinal))
            UpdatePageHeader();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!TryResolveCargaViajesSection(e.Location, out var targetSection))
            return;

        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _activeSection = targetSection;
            UpdatePageHeader();
        });
    }

    private bool TryResolveCargaViajesSection(string location, out string section)
    {
        section = SectionViajes;

        var path = Nav.ToBaseRelativePath(location)
            .Split('?')[0]
            .Split('#')[0]
            .Trim('/');

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var moduleIndex = Array.FindIndex(
            segments,
            value => string.Equals(value, "carga-viajes", StringComparison.OrdinalIgnoreCase));

        if (moduleIndex < 0)
            return false;

        section = moduleIndex + 1 < segments.Length
            ? NormalizeSection(segments[moduleIndex + 1])
            : SectionViajes;

        return true;
    }

