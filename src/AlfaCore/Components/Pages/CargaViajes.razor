    private async Task SeleccionarPendientesVisiblesAsync()
    {
        var pendingVisible = _liquidacionesRows.Where(x => !x.FletePagado).ToList();
        if (pendingVisible.Count == 0)
        {
            await Task.CompletedTask;
            return;
        }

        var allSelected = pendingVisible.All(x => _liquidacionesSeleccionadas.Contains(x.Id));
        if (allSelected)
        {
            foreach (var row in pendingVisible)
                _liquidacionesSeleccionadas.Remove(row.Id);
        }
        else
        {
            foreach (var row in pendingVisible)
                _liquidacionesSeleccionadas.Add(row.Id);
        }

        RecalcularTotalSeleccionado();
        await Task.CompletedTask;
    }

    private async Task SeleccionarPendientesDelGrupoAsync(bool esFletero)
