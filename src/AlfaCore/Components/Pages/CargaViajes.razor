@page "/carga-viajes"
@page "/{idweb}/{idbase:int}/carga-viajes"
@page "/carga-viajes/{Vista}"
@page "/{idweb}/{idbase:int}/carga-viajes/{Vista}"
@using AlfaCore.Models
@using AlfaCore.Services
@using Microsoft.AspNetCore.WebUtilities
@inject ICargaViajesService CargaViajesSvc
@inject IAppUiOperationService UiOps
@inject IAppUiDialogService AppDialogs
@inject IAppUserSessionService AppUserSession
@inject IViajePreviewStateService ViajePreviewState
@inject IRouteContextService RouteContext
@inject IPageHeaderService PageHeader
@inject IJSRuntime Js
@inject ILogger<CargaViajes> Logger
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Carga de Viajes | Alfa Gestión</PageTitle>

<div class="page-grid carga-viajes-page @(IsAnyOverlayOpen() ? "carga-viajes-page--overlay-open" : string.Empty)" @onclick="HandlePageClickAsync">
    <section class="carga-viajes-tabs" hidden>
        <div class="actions carga-viajes-tabs__actions">
            <button type="button" class="btn btn--sm @(_activeSection == SectionViajes ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionViajes)">Viajes</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionTarifas ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionTarifas)">Tarifas</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionChoferes ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionChoferes)">Choferes</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionDestinos ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionDestinos)">Destinos</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionTipoVehiculo ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionTipoVehiculo)">Tipo vehículo</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionReportes ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionReportes)">Reportes</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionLiquidaciones ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionLiquidaciones)">Liquidaciones</button>
            <button type="button" class="btn btn--sm @(_activeSection == SectionConfiguracion ? "btn--primary" : "btn--ghost")" @onclick="() => NavigateSectionAsync(SectionConfiguracion)">Configuración</button>
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="carga-viajes-feedback @(IsAnyOverlayOpen() ? "carga-viajes-feedback--floating" : string.Empty)">
            <div class="editor-msg carga-viajes-feedback__box @GetFeedbackClass(_feedback)">
                <div class="carga-viajes-feedback__content">
                    @if (ShouldShowFeedbackTitle(_feedback))
                    {
                        <strong class="carga-viajes-feedback__title">@_feedback.Title</strong>
                    }
                    <div class="carga-viajes-feedback__line">
                        <span>@FormatFeedbackMessage(_feedback)</span>
                    </div>
                    @if (_feedback.HasSuggestion)
                    {
                        <small class="carga-viajes-feedback__suggestion">@_feedback.Suggestion</small>
                    }
                </div>
            </div>
        </section>
    }

    @if (_activeSection == SectionViajes || _activeSection == SectionNuevo)
    {
        @if (ShouldShowViajesToolbar())
        {
            var pageActions = BuildListPageActions();
            var viajesFilterChips = BuildViajesFilterChips();
            var showViajesClearButton = viajesFilterChips.Count > 0 || !string.IsNullOrWhiteSpace(_viajesFilters.Texto);

            <ModuleListToolbar AriaLabel="Herramientas de viajes"
                               PagerAriaLabel="Paginación de viajes"
                               ActionsAriaLabel="Acciones de viajes"
                               ShowPager="true"
                               CurrentPage="@_viajesPage"
                               TotalPages="@_viajesTotalPages"
                               IsLoading="@_viajesLoading"
                               OnPageChanged="CambiarPaginaViajesAsync"
                               Actions="@pageActions">
                <SearchContent>
                    <div class="smart-search carga-viajes-smart-search carga-viajes-smart-search--viajes" @onkeydown="HandleViajesFilterKeyDownAsync">
                        <div class="carga-viajes-smart-search__anchor">
                            <div class="smart-search__bar carga-viajes-smart-search__bar--with-chips">
                                <i class="bi bi-search carga-viajes-smart-search__search-icon"></i>
                                <div class="carga-viajes-smart-search__entry">
                                    @if (viajesFilterChips.Count > 0)
                                    {
                                        <div class="carga-viajes-smart-search__inline-chips" aria-live="polite">
                                            @foreach (var chip in viajesFilterChips)
                                            {
                                                <button type="button"
                                                        class="smart-chip carga-viajes-filter-chip"
                                                        @key="chip.Key"
                                                        title="@chip.Label"
                                                        aria-label="@($"Quitar filtro {chip.Label}")"
                                                        @onclick="() => RemoveViajesFilterChipAsync(chip.Key)"
                                                        @onclick:stopPropagation="true">
                                                    <span>@chip.Label</span>
                                                    <i class="bi bi-x" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                    <input type="search"
                                           class="carga-viajes-smart-search__text-input"
                                           placeholder=""
                                           aria-label="Buscar viaje, cliente, chofer, destino, comprobante o usuario"
                                           @bind="_viajesFilters.Texto"
                                           @bind:event="oninput"
                                           @onfocus="AbrirViajesAdvancedFilters" />
                                </div>
                                @if (showViajesClearButton)
                                {
                                    <button type="button"
                                            class="carga-viajes-clear-filters-btn"
                                            title="Limpiar filtros"
                                            aria-label="Limpiar filtros"
                                            @onclick="LimpiarFiltrosViajesAsync"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                }
                                <button type="button" class="smart-search__toggle" @onclick="ToggleViajesAdvancedFilters" aria-expanded="@_showViajesAdvancedFilters" aria-controls="carga-viajes-viajes-filtros-avanzados" aria-label="Mostrar filtros avanzados">
                                    <i class="bi @(_showViajesAdvancedFilters ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                </button>
                            </div>

                            @if (_showViajesAdvancedFilters)
                            {
                                <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onmousedown="() => _showViajesAdvancedFilters = false"></button>
                                <div id="carga-viajes-viajes-filtros-avanzados" class="smart-search__panel carga-viajes-smart-search__panel--viajes">
                                    <div class="smart-search__column">
                                        <h4><i class="bi bi-calendar-range"></i> Fecha</h4>
                                        <div class="smart-search__inline">
                                            <label>Rango rápido</label>
                                            <select value="@_viajesFechaRango" @onchange="OnViajesFechaRangoChangedAsync">
                                                <option value="todo">Todo</option>
                                                <option value="hoy">Hoy</option>
                                                <option value="semana">Hace una semana</option>
                                                <option value="mes-actual">Mes actual</option>
                                                <option value="mes-pasado">Mes pasado</option>
                                                <option value="anio-actual">Este año</option>
                                                <option value="anio-pasado">Año pasado</option>
                                                <option value="personalizado">Personalizado</option>
                                            </select>
                                        </div>
                                        <div class="smart-search__inline">
                                            <label>Fecha desde</label>
                                            <InputDate @bind-Value="_viajesFilters.FechaDesde" @bind-Value:after="OnViajesFechaManualChangedAsync" />
                                        </div>
                                        <div class="smart-search__inline">
                                            <label>Fecha hasta</label>
                                            <InputDate @bind-Value="_viajesFilters.FechaHasta" @bind-Value:after="OnViajesFechaManualChangedAsync" />
                                        </div>
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltroFechaViajesAsync">Limpiar fecha</button>
                                    </div>

                                    <div class="smart-search__column">
                                        <h4><i class="bi bi-person-vcard"></i> Partes</h4>
                                        <div class="smart-search__inline">
                                            <label>Cliente</label>
                                            <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_clienteFiltroTexto" TextChanged="OnClienteFiltroTextoChangedAsync" SelectedChanged="OnClienteSeleccionadoAsync" OnEnterCommitted="AplicarFiltrosViajesAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" MinimumCharacters="0" />
                                        </div>
                                        <div class="smart-search__inline">
                                            <label>Chofer / Fletero</label>
                                            <LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_choferFiltroTexto" TextChanged="OnChoferFiltroTextoChangedAsync" SelectedChanged="OnChoferSeleccionadoAsync" OnEnterCommitted="AplicarFiltrosViajesAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" MinimumCharacters="0" />
                                        </div>
                                        <div class="smart-search__inline">
                                            <label>Destino</label>
                                            <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_destinoFiltroTexto" TextChanged="OnDestinoFiltroTextoChangedAsync" SelectedChanged="OnDestinoSeleccionadoAsync" OnEnterCommitted="AplicarFiltrosViajesAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" MinimumCharacters="0" />
                                        </div>
                                    </div>

                                    <div class="smart-search__column">
                                        <h4><i class="bi bi-sliders"></i> Estado y referencia</h4>
                                        <div class="smart-search__inline">
                                            <label>Estado</label>
                                            <select @bind="_viajesFilters.Estado">
                                                <option value="">Todos</option>
                                                @foreach (var estado in _lookups.Estados)
                                                {
                                                    <option value="@estado">@estado</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="smart-search__inline">
                                            <label>Usuario</label>
                                            <input type="text" @bind="_viajesFilters.Usuario" @bind:event="oninput" />
                                        </div>
                                        <div class="smart-search__inline">
                                            <label>Id comprobante</label>
                                            <input type="text" @bind="_viajesFilters.IdComprobante" @bind:event="oninput" />
                                        </div>
                                    </div>
                                    <div class="carga-viajes-smart-search__apply-row">
                                        <button type="button" class="btn btn--primary carga-viajes-smart-search__apply-btn" @onclick="AplicarFiltrosViajesYCerrarAsync">Aplicar filtros</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </SearchContent>
            </ModuleListToolbar>
        }

        @if (_showViewSettings)
        {
            <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onmousedown="CancelarConfiguracionVista">
                <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--wide" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-view-settings-title" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                    <header class="cuentas-modal__header">
                        <div>
                            <span class="cuentas-modal__eyebrow">Viajes</span>
                            <h3 id="carga-viajes-view-settings-title">Configuración de vista</h3>
                        </div>
                        <button type="button" class="cuentas-modal__close" @onclick="CancelarConfiguracionVista" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>

                    <div class="cuentas-modal__body">
                        <div class="usuarios-view-settings">
                            <div class="field">
                                <label>Agrupar por</label>
                                <select @bind="_draftAgruparPor">
                                    <option value="@CargaViajesViewGroupKeys.None">Sin agrupar</option>
                                    <option value="@CargaViajesViewGroupKeys.Estado">Estado</option>
                                    <option value="@CargaViajesViewGroupKeys.Usuario">Usuario</option>
                                </select>
                            </div>

                            <div class="usuarios-view-settings__list">
                                @foreach (var column in _viewSettingsDraft.Columnas.OrderBy(c => c.Order))
                                {
                                    <div class="usuarios-view-settings__item">
                                        <label class="carga-viajes-check">
                                            <input class="carga-viajes-check__input" type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                            <span class="carga-viajes-check__box" aria-hidden="true"></span>
                                            <span class="carga-viajes-check__text">@column.Label</span>
                                        </label>
                                        <div class="actions">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">↑</button>
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">↓</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <footer class="cuentas-modal__actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">Guardar vista</button>
                        <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">Cancelar</button>
                    </footer>
                </section>
            </div>
        }

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Viajes</h3>
                </div>
            </div>

            @if (_viajesLoading)
            {
                <div class="usuarios-empty">Cargando viajes...</div>
            }
            else if (_viajes.Count == 0)
            {
                <div class="usuarios-empty">No hay viajes para los filtros seleccionados.</div>
            }
            else
            {
                var visibleColumns = GetVisibleColumns();
                var groups = BuildViajeGroups();
                <div class="usuarios-table-wrap carga-viajes-viajes-table-wrap">
                    <table class="data-table usuarios-table" data-sticky-list-header>
                        <thead>
                            <tr>
                                @foreach (var column in visibleColumns)
                                {
                                    <th>
                                        <button type="button" class="carga-viajes-sort-button" @onclick="() => SortViajesAsync(column.Key)">
                                            <span>@column.Label</span>
                                            <i class="bi @GetSortIcon(_viajesFilters, column.Key)"></i>
                                        </button>
                                    </th>
                                }
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@(visibleColumns.Count + 1)">@group.Label</td>
                                    </tr>
                                }
                                @foreach (var row in group.Items)
                                {
                                    <tr class="data-grid__row" @ondblclick="() => EditarViajeAsync(row.Id)">
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td>@RenderViajeColumn(row, col.Key)</td>
                                        }
                                        <td>
                                            <div class="actions">
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AbrirViajePreviewAsync(row.Id)">Ver</button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarViajeAsync(row.Id)">Editar</button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AnularViajeAsync(row.Id)">Anular</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                        @if (_viajes.Count > 0)
                        {
                            <tfoot>
                                <tr class="carga-viajes-viajes-total-row">
                                    @for (var i = 0; i < visibleColumns.Count; i++)
                                    {
                                        var column = visibleColumns[i];
                                        if (i == 0)
                                        {
                                            <td class="carga-viajes-viajes-total-row__label">Totales</td>
                                        }
                                        else if (column.Key == CargaViajesViewColumnKeys.TotalCliente)
                                        {
                                            <td class="carga-viajes-viajes-total-row__value">Total cliente: @FormatMoney(_viajes.Sum(v => v.TotalCliente))</td>
                                        }
                                        else if (column.Key == CargaViajesViewColumnKeys.TotalFletero)
                                        {
                                            <td class="carga-viajes-viajes-total-row__value">Total fletero: @FormatMoney(_viajes.Sum(v => v.TotalFletero))</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                    }
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                <div class="carga-viajes-list-footer">@GetViajesFoundText()</div>
            }
        </section>
    }
    else if (_activeSection == SectionTarifas)
    {
        var pageActions = BuildListPageActions();
        var tarifasFilterChips = BuildTarifasFilterChips();
        var showTarifasClearButton = tarifasFilterChips.Count > 0 || !string.IsNullOrWhiteSpace(_tarifasFilters.Texto);

        <section class="panel-card carga-viajes-section carga-viajes-section--filters">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Tarifas</h3>
                </div>
            </div>

            <ModuleListToolbar AriaLabel="Herramientas de tarifas"
                               PagerAriaLabel="Paginación de tarifas"
                               ActionsAriaLabel="Acciones de tarifas"
                               ShowPager="true"
                               CurrentPage="@_tarifasPage"
                               TotalPages="@_tarifasTotalPages"
                               IsLoading="@_tarifasLoading"
                               OnPageChanged="CambiarPaginaTarifasAsync"
                               Actions="@pageActions">
                <SearchContent>
                    <div class="smart-search carga-viajes-smart-search carga-viajes-smart-search--tarifas" @onkeydown="HandleTarifasSearchKeyDownAsync">
                        <div class="carga-viajes-smart-search__anchor">
                            <div class="smart-search__bar carga-viajes-smart-search__bar--with-chips">
                                <i class="bi bi-search carga-viajes-smart-search__search-icon"></i>
                                <div class="carga-viajes-smart-search__entry">
                                    @if (tarifasFilterChips.Count > 0)
                                    {
                                        <div class="carga-viajes-smart-search__inline-chips" aria-live="polite">
                                            @foreach (var chip in tarifasFilterChips)
                                            {
                                                <button type="button"
                                                        class="smart-chip carga-viajes-filter-chip"
                                                        @key="chip.Key"
                                                        title="@chip.Label"
                                                        aria-label="@($"Quitar filtro {chip.Label}")"
                                                        @onclick="() => RemoveTarifasFilterChipAsync(chip.Key)"
                                                        @onclick:stopPropagation="true">
                                                    <span>@chip.Label</span>
                                                    <i class="bi bi-x" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                    <input type="search"
                                           class="carga-viajes-smart-search__text-input"
                                           placeholder=""
                                           aria-label="Buscar tarifa, cliente, chofer, destino o tipo vehículo"
                                           @bind="_tarifasFilters.Texto"
                                           @bind:event="oninput"
                                           @onfocus="AbrirTarifasAdvancedFilters" />
                                </div>
                                @if (showTarifasClearButton)
                                {
                                    <button type="button"
                                            class="carga-viajes-clear-filters-btn"
                                            title="Limpiar filtros"
                                            aria-label="Limpiar filtros"
                                            @onclick="LimpiarFiltrosTarifasAsync"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                }
                                <button type="button" class="smart-search__toggle" @onclick="ToggleTarifasAdvancedFilters" aria-expanded="@_showTarifasAdvancedFilters" aria-controls="carga-viajes-tarifas-filtros-avanzados" aria-label="Mostrar filtros avanzados">
                                    <i class="bi @(_showTarifasAdvancedFilters ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                </button>
                            </div>

                            @if (_showTarifasAdvancedFilters)
                            {
                                <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onmousedown="() => _showTarifasAdvancedFilters = false"></button>
                                <div id="carga-viajes-tarifas-filtros-avanzados" class="smart-search__panel carga-viajes-smart-search__panel--tarifas" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                        <div class="smart-search__column">
                            <h4><i class="bi bi-tags"></i> Tipo y estado</h4>
                            <div class="carga-viajes-tarifas__type-filter" role="group" aria-label="Tipo tarifa">
                                <button type="button"
                                        class="carga-viajes-filter-pill @(!HasTarifaFleteroFilter() ? "carga-viajes-filter-pill--active" : string.Empty)"
                                        aria-pressed="@(!HasTarifaFleteroFilter())"
                                        @onclick="SetTarifasTipoTodasAsync">
                                    Todas
                                </button>
                                <button type="button"
                                        class="carga-viajes-filter-pill @(_tarifasFilters.TarifaFletero == "0" ? "carga-viajes-filter-pill--active" : string.Empty)"
                                        aria-pressed="@(_tarifasFilters.TarifaFletero == "0")"
                                        @onclick="SetTarifasTipoClientesAsync">
                                    Clientes
                                </button>
                                <button type="button"
                                        class="carga-viajes-filter-pill @(_tarifasFilters.TarifaFletero == "1" ? "carga-viajes-filter-pill--active" : string.Empty)"
                                        aria-pressed="@(_tarifasFilters.TarifaFletero == "1")"
                                        @onclick="SetTarifasTipoFleterosAsync">
                                    Fleteros
                                </button>
                            </div>
                            <div class="smart-search__inline">
                                <label>Activo</label>
                                <select @bind="_tarifasFilters.Activo">
                                    <option value="">Todos</option>
                                    <option value="1">Activo</option>
                                    <option value="0">Desactivado</option>
                                </select>
                            </div>
                            <div class="smart-search__inline">
                                <label>Agrupar por</label>
                                <select @bind="_tarifasFilters.AgruparPor">
                                    <option value="">Sin agrupar</option>
                                    <option value="@CargaViajesViewGroupKeys.Cliente">Cliente</option>
                                    <option value="@CargaViajesViewGroupKeys.Chofer">Chofer / fletero</option>
                                </select>
                            </div>
                        </div>
                        <div class="smart-search__column">
                            <h4><i class="bi bi-people"></i> Entidades</h4>
                            <div class="smart-search__inline">
                                <label>Cliente</label>
                                <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_tarifasFilters.Cliente" TextChanged="OnTarifaClienteFiltroChangedAsync" SelectedChanged="OnTarifaClienteFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" MinimumCharacters="0" />
                            </div>
                            <div class="smart-search__inline">
                                <label>Chofer</label>
                                <LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_tarifasFilters.Chofer" TextChanged="OnTarifaChoferFiltroChangedAsync" SelectedChanged="OnTarifaChoferFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" MinimumCharacters="0" />
                            </div>
                        </div>
                        <div class="smart-search__column">
                            <h4><i class="bi bi-geo-alt"></i> Ruta</h4>
                            <div class="smart-search__inline">
                                <label>Destino</label>
                                <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_tarifasFilters.Destino" TextChanged="OnTarifaDestinoFiltroChangedAsync" SelectedChanged="OnTarifaDestinoFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" MinimumCharacters="0" />
                            </div>
                            <div class="smart-search__inline">
                                <label>Tipo vehículo</label>
                                <LookupAutocomplete Label="" Placeholder="Buscar tipo..." Text="@_tarifasFilters.TipoVehiculo" TextChanged="OnTarifaTipoVehiculoFiltroChangedAsync" SelectedChanged="OnTarifaTipoVehiculoFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAsync" SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" MinimumCharacters="0" />
                            </div>
                        </div>
                        <div class="carga-viajes-smart-search__apply-row">
                            <button type="button" class="btn btn--primary carga-viajes-smart-search__apply-btn" @onclick="AplicarFiltrosTarifasYCerrarAsync">Aplicar filtros</button>
                        </div>
                                </div>
                            }
                        </div>
                    </div>
                </SearchContent>
            </ModuleListToolbar>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Tarifas</h3>
                </div>
            </div>
            @if (_tarifasLoading)
            {
                <div class="usuarios-empty">Cargando tarifas...</div>
            }
            else if (_tarifas.Count == 0)
            {
                <div class="usuarios-empty">Sin tarifas para mostrar.</div>
            }
            else
            {
                var tarifaGroups = BuildTarifaGroups();
                <div class="usuarios-table-wrap">
                    <div class="carga-viajes-tarifas__toolbar">
                        <label class="carga-viajes-checkbox carga-viajes-quick-edit-toggle carga-viajes-tarifas__quick-toggle @(_tarifasQuickImportEditMode ? "carga-viajes-check--active" : string.Empty)">
                            <input type="checkbox"
                                   class="carga-viajes-checkbox__input"
                                   checked="@_tarifasQuickImportEditMode"
                                   @onchange="async _ => await ToggleTarifasQuickImportEditModeAsync()" />
                            <span class="carga-viajes-checkbox__box" aria-hidden="true"></span>
                            <span class="carga-viajes-checkbox__label">Editar importes</span>
                        </label>
                    </div>

                    <table class="data-table carga-viajes-tarifas-table" data-sticky-list-header>
                        <thead>
                            <tr>
                                <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortTarifasAsync(SortKeyNombre)"><span>Nombre</span><i class="bi @GetSortIcon(_tarifasFilters, SortKeyNombre)"></i></button></th>
                                <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortTarifasAsync(SortKeyTipoTarifa)"><span>Tipo tarifa</span><i class="bi @GetSortIcon(_tarifasFilters, SortKeyTipoTarifa)"></i></button></th>
                                <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortTarifasAsync(SortKeyCliente)"><span>Cliente / Chofer</span><i class="bi @GetSortIcon(_tarifasFilters, SortKeyCliente)"></i></button></th>
                                <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortTarifasAsync(SortKeyDestino)"><span>Destino</span><i class="bi @GetSortIcon(_tarifasFilters, SortKeyDestino)"></i></button></th>
                                <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortTarifasAsync(SortKeyTipoVehiculo)"><span>Tipo vehículo</span><i class="bi @GetSortIcon(_tarifasFilters, SortKeyTipoVehiculo)"></i></button></th>
                                <th class="carga-viajes-tarifas__importe-col"><button type="button" class="carga-viajes-sort-button" @onclick="() => SortTarifasAsync(SortKeyImporte)"><span>Importe</span><i class="bi @GetSortIcon(_tarifasFilters, SortKeyImporte)"></i></button></th>
                                <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortTarifasAsync(SortKeyActivo)"><span>Activo</span><i class="bi @GetSortIcon(_tarifasFilters, SortKeyActivo)"></i></button></th>
                                <th class="carga-viajes-tarifas__mod-col">Última modificación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in tarifaGroups)
                            {
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="9">@group.Label · @group.Items.Count tarifa(s) · Total @FormatMoney(group.TotalImporte)</td>
                                    </tr>
                                }

                                @foreach (var item in group.Items.Select((row, index) => new { row, index }))
                                {
                                    <tr class="@GetTarifaRowClass(item.row, item.index)" @ondblclick="() => EditarTarifaAsync(item.row)">
                                        <td>@item.row.Nombre</td>
                                        <td>@(item.row.TarifaFletero ? "Fletero" : "Cliente")</td>
                                        <td>@GetTarifaEntidadDisplay(item.row)</td>
                                        <td>@ExtractVisibleText(item.row.Destino)</td>
                                        <td>@ExtractVisibleText(item.row.TipoVehiculo)</td>
                                        <td class="carga-viajes-tarifas__importe-col @GetTarifaImporteCellClass(item.row)" @onclick:stopPropagation="_tarifasQuickImportEditMode" @ondblclick:stopPropagation="_tarifasQuickImportEditMode">
                                            @if (_tarifasQuickImportEditMode && _tarifasQuickImportEditId == item.row.Id && item.row.Id > 0)
                                            {
                                                <input id="@GetTarifaImporteInputId(item.row.Id)"
                                                       class="carga-viajes-tarifas__importe-editor"
                                                       type="number"
                                                       inputmode="decimal"
                                                       step="0.01"
                                                       @bind-value="_tarifasQuickImportValue"
                                                       @bind-value:event="oninput"
                                                       @onfocus="() => SelectTarifaImporteAsync(item.row.Id)"
                                                       @onkeydown="args => HandleTarifaImporteKeyDownAsync(args, item.row, item.index)" />
                                            }
                                            else
                                            {
                                                <div class="carga-viajes-tarifas__importe-display" @onclick="() => ActivarEdicionRapidaTarifaAsync(item.row, item.index)">
                                                    @item.row.Importe.ToString("N2")
                                                </div>
                                            }
                                        </td>
                                        <td>@(item.row.Activo ? "Activo" : "Desactivado")</td>
                                        <td class="carga-viajes-tarifas__mod-col">@FormatTarifaUltimaModificacion(item.row)</td>
                                        <td>
                                            <div class="actions">
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarTarifaAsync(item.row)">Editar</button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => BajaTarifaAsync(item.row)">Baja</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="carga-viajes-list-footer">@GetTarifasFoundText()</div>
            }
        </section>

        @if (_showTarifasBulkEditModal)
        {
            <div class="tarifa-aumento-backdrop-v2" @onclick="CerrarTarifasBulkEditAsync">
                <section class="tarifa-aumento-modal-v2" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-tarifas-bulk-title" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                    <header class="tarifa-aumento-header-v2">
                        <div class="tarifa-aumento-header-v2__text">
                            <span class="tarifa-aumento-header-v2__eyebrow">Tarifas</span>
                            <h3 id="carga-viajes-tarifas-bulk-title" class="tarifa-aumento-header-v2__title">Aumento de tarifa</h3>
                            <p class="tarifa-aumento-header-v2__subtitle">Filtrá, simulá y aplicá aumentos masivos sobre las tarifas seleccionadas.</p>
                        </div>
                        <button type="button" class="tarifa-aumento-header-v2__close" @onclick="CerrarTarifasBulkEditAsync" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>
                    <div class="tarifa-aumento-body-v2">
                        @{ var tarifasAumentoFiltradas = GetTarifasAumentoFiltradas().ToList(); }

                        <section class="tarifa-aumento-card-v2 tarifa-aumento-filters-v2">
                            <div class="tarifa-aumento-card-v2__head">
                                <div>
                                    <h4 class="tarifa-aumento-card-v2__title">Filtros</h4>
                                    <span class="tarifa-aumento-card-v2__subtitle">Buscá el universo de tarifas a actualizar.</span>
                                </div>
                            </div>
                            <div class="tarifa-aumento-filters-v2__rows">
                                <div class="tarifa-aumento-filters-v2__row">
                                    <div class="tarifa-aumento-filters-v2__field tarifa-aumento-filters-v2__field--wide">
                                        <label>Tipo tarifa</label>
                                        <div class="tarifa-aumento-type-toggle-v2" role="group" aria-label="Tipo tarifa aumento">
                                            <button type="button" class="tarifa-aumento-pill-v2 @(!HasTarifaAumentoFleteroFilter() ? "tarifa-aumento-pill-v2--active" : string.Empty)" @onclick="SetTarifaAumentoTipoTodasAsync">Todas</button>
                                            <button type="button" class="tarifa-aumento-pill-v2 @(_tarifasAumentoFilters.TarifaFletero == "0" ? "tarifa-aumento-pill-v2--active" : string.Empty)" @onclick="SetTarifaAumentoTipoClientesAsync">Clientes</button>
                                            <button type="button" class="tarifa-aumento-pill-v2 @(_tarifasAumentoFilters.TarifaFletero == "1" ? "tarifa-aumento-pill-v2--active" : string.Empty)" @onclick="SetTarifaAumentoTipoFleterosAsync">Fleteros</button>
                                        </div>
                                    </div>
                                    <div class="tarifa-aumento-filters-v2__field">
                                        <label>Activo</label>
                                        <select @bind="_tarifasAumentoFilters.Activo">
                                            <option value="">Todos</option>
                                            <option value="1">Activo</option>
                                            <option value="0">Desactivado</option>
                                        </select>
                                    </div>
                                    <div class="tarifa-aumento-filters-v2__field tarifa-aumento-filters-v2__field--wide">
                                        <label>Cliente</label>
                                        <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_tarifasAumentoClienteTexto" TextChanged="OnTarifaAumentoClienteFiltroChangedAsync" SelectedChanged="OnTarifaAumentoClienteFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAumentoAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" MinimumCharacters="0" />
                                    </div>
                                    <div class="tarifa-aumento-filters-v2__field tarifa-aumento-filters-v2__field--wide">
                                        <label>Chofer/Fletero</label>
                                        <LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_tarifasAumentoChoferTexto" TextChanged="OnTarifaAumentoChoferFiltroChangedAsync" SelectedChanged="OnTarifaAumentoChoferFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAumentoAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" MinimumCharacters="0" />
                                    </div>
                                </div>
                                <div class="tarifa-aumento-filters-v2__row">
                                    <div class="tarifa-aumento-filters-v2__field tarifa-aumento-filters-v2__field--wide">
                                        <label>Destino</label>
                                        <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_tarifasAumentoDestinoTexto" TextChanged="OnTarifaAumentoDestinoFiltroChangedAsync" SelectedChanged="OnTarifaAumentoDestinoFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAumentoAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" MinimumCharacters="0" />
                                    </div>
                                    <div class="tarifa-aumento-filters-v2__field">
                                        <label>Tipo vehículo</label>
                                        <LookupAutocomplete Label="" Placeholder="Buscar tipo..." Text="@_tarifasAumentoTipoVehiculoTexto" TextChanged="OnTarifaAumentoTipoVehiculoFiltroChangedAsync" SelectedChanged="OnTarifaAumentoTipoVehiculoFiltroSelectedAsync" OnEnterCommitted="AplicarFiltrosTarifasAumentoAsync" SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" MinimumCharacters="0" />
                                    </div>
                                    <div class="tarifa-aumento-filters-v2__field tarifa-aumento-filters-v2__field--wide">
                                        <label>Buscar rápido</label>
                                        <input type="search" placeholder="Código, cliente, destino o tipo vehículo..." value="@_tarifasAumentoBusqueda" @oninput="OnTarifasAumentoBusquedaChangedAsync" />
                                    </div>
                                    <div class="tarifa-aumento-filters-v2__field tarifa-aumento-filters-v2__field--actions">
                                        <label>&nbsp;</label>
                                        <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltrosTarifasAumentoAsync">Limpiar filtros</button>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="tarifa-aumento-card-v2 tarifa-aumento-table-card-v2">
                            <div class="tarifa-aumento-card-v2__head tarifa-aumento-table-card-v2__head">
                                <div>
                                    <h4 class="tarifa-aumento-card-v2__title">Tarifas encontradas</h4>
                                    <span class="tarifa-aumento-card-v2__subtitle">@tarifasAumentoFiltradas.Count registro(s)</span>
                                </div>
                                <label class="tarifa-aumento-select-all-v2">
                                    <input type="checkbox" class="tarifa-aumento-check-v2" checked="@AreAllTarifasAumentoSeleccionadas()" @onchange="ToggleSelectAllTarifasAumentoAsync" />
                                    <span>Seleccionar todos</span>
                                </label>
                            </div>
                            @if (_tarifasAumentoLoading)
                            {
                                <div class="tarifa-aumento-empty-v2">Cargando tarifas...</div>
                            }
                            else if (tarifasAumentoFiltradas.Count == 0)
                            {
                                <div class="tarifa-aumento-empty-v2">Sin tarifas para mostrar.</div>
                            }
                            else
                            {
                                <div class="tarifa-aumento-table-scroll-v2">
                                    <table class="tarifa-aumento-table-v2" data-sticky-list-header>
                                        <thead>
                                            <tr>
                                                <th class="tarifa-aumento-table-v2__check-col">
                                                    <input type="checkbox" class="tarifa-aumento-check-v2" checked="@AreAllTarifasAumentoSeleccionadas()" @onchange="ToggleSelectAllTarifasAumentoAsync" aria-label="Seleccionar todos" />
                                                </th>
                                                <th>Código</th>
                                                <th>Cliente / Chofer</th>
                                                <th>Destino</th>
                                                <th>Tipo vehículo</th>
                                                <th class="tarifa-aumento-table-v2__money-col">Importe actual</th>
                                                <th class="tarifa-aumento-table-v2__money-col">Importe simulado</th>
                                                <th class="tarifa-aumento-table-v2__money-col">Diferencia</th>
                                                <th>Última actualización</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in tarifasAumentoFiltradas)
                                            {
                                                var selected = _tarifasAumentoSeleccionadas.Contains(row.Id);
                                                var simulated = GetTarifaAumentoImporteSimulado(row);
                                                var diff = GetTarifaAumentoDiferencia(row);
                                                <tr class="@(selected ? "tarifa-aumento-table-v2__row tarifa-aumento-table-v2__row--selected" : "tarifa-aumento-table-v2__row")">
                                                    <td class="tarifa-aumento-table-v2__check-col">
                                                        <input type="checkbox" class="tarifa-aumento-check-v2" checked="@selected" @onchange="args => ToggleTarifaAumentoSelectionAsync(row, args)" aria-label="@($"Seleccionar tarifa {row.IdLista}")" />
                                                    </td>
                                                    <td>@row.IdLista</td>
                                                    <td>@GetTarifaEntidadDisplay(row)</td>
                                                    <td>@ExtractVisibleText(row.Destino)</td>
                                                    <td>@ExtractVisibleText(row.TipoVehiculo)</td>
                                                    <td class="tarifa-aumento-table-v2__money-cell">@row.Importe.ToString("N2")</td>
                                                    <td class="tarifa-aumento-table-v2__money-cell">@((selected && _tarifasAumentoSimulada) ? simulated.ToString("N2") : "-")</td>
                                                    <td class="tarifa-aumento-table-v2__money-cell">@((selected && _tarifasAumentoSimulada) ? diff.ToString("+N2;-N2;0.00") : "-")</td>
                                                    <td>@FormatTarifaUltimaModificacion(row)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>

                        <section class="tarifa-aumento-card-v2 tarifa-aumento-config-v2">
                            <div class="tarifa-aumento-card-v2__head">
                                <div>
                                    <h4 class="tarifa-aumento-card-v2__title">Configuración del aumento</h4>
                                    <span class="tarifa-aumento-card-v2__subtitle">Definí el ajuste antes de aplicarlo a las tarifas seleccionadas.</span>
                                </div>
                            </div>
                            <div class="tarifa-aumento-config-v2__grid">
                                <div class="tarifa-aumento-config-v2__field">
                                    <span class="tarifa-aumento-config-v2__label">Tipo de ajuste</span>
                                    <div class="tarifa-aumento-config-v2__radio-group" role="group" aria-label="Tipo de ajuste">
                                        <label class="tarifa-aumento-config-v2__radio-pill">
                                            <input type="radio" name="tarifas-aumento-mode" checked="@(_tarifasAumentoMode == TarifasBulkModeIncreasePercent)" @onchange="async _ => await SetTarifasBulkModeAsync(TarifasBulkModeIncreasePercent)" />
                                            <span>Aumentar %</span>
                                        </label>
                                        <label class="tarifa-aumento-config-v2__radio-pill">
                                            <input type="radio" name="tarifas-aumento-mode" checked="@(_tarifasAumentoMode == TarifasBulkModeDecreasePercent)" @onchange="async _ => await SetTarifasBulkModeAsync(TarifasBulkModeDecreasePercent)" />
                                            <span>Disminuir %</span>
                                        </label>
                                        <label class="tarifa-aumento-config-v2__radio-pill">
                                            <input type="radio" name="tarifas-aumento-mode" checked="@(_tarifasAumentoMode == TarifasBulkModeAddFixed)" @onchange="async _ => await SetTarifasBulkModeAsync(TarifasBulkModeAddFixed)" />
                                            <span>Sumar importe fijo</span>
                                        </label>
                                        <label class="tarifa-aumento-config-v2__radio-pill">
                                            <input type="radio" name="tarifas-aumento-mode" checked="@(_tarifasAumentoMode == TarifasBulkModeSubtractFixed)" @onchange="async _ => await SetTarifasBulkModeAsync(TarifasBulkModeSubtractFixed)" />
                                            <span>Restar importe fijo</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="tarifa-aumento-config-v2__field">
                                    <label class="tarifa-aumento-config-v2__label">Valor</label>
                                    <input type="number" step="0.01" value="@_tarifasAumentoValue" @oninput="OnTarifaAumentoValueChangedAsync" />
                                </div>
                                <div class="tarifa-aumento-config-v2__field">
                                    <label class="tarifa-aumento-config-v2__label">Redondeo</label>
                                    <select @bind="_tarifasAumentoRedondeo">
                                        <option value="none">Ninguno</option>
                                        <option value="1">1</option>
                                        <option value="10">10</option>
                                        <option value="100">100</option>
                                    </select>
                                </div>
                                <div class="tarifa-aumento-config-v2__field tarifa-aumento-config-v2__field--action">
                                    <label class="tarifa-aumento-config-v2__label">&nbsp;</label>
                                    <button type="button" class="btn btn--primary btn--sm" @onclick="SimularTarifasAumentoAsync">Simular</button>
                                </div>
                                <div class="tarifa-aumento-config-v2__preview">
                                    <div class="tarifa-aumento-config-v2__preview-head">Vista previa</div>
                                    <div class="tarifa-aumento-config-v2__preview-grid">
                                        <div><span>Seleccionadas</span><strong>@GetTarifasAumentoSeleccionadasCount().ToString("N0")</strong></div>
                                        <div><span>Importe actual total</span><strong>@FormatMoney(GetTarifasAumentoCurrentTotal())</strong></div>
                                        <div><span>Importe simulado total</span><strong>@FormatMoney(GetTarifasAumentoSimulatedTotal())</strong></div>
                                        <div><span>Diferencia total</span><strong>@FormatMoney(GetTarifasAumentoDifferenceTotal())</strong></div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <footer class="tarifa-aumento-footer-v2">
                        <button type="button" class="btn btn--ghost" @onclick="CerrarTarifasBulkEditAsync">Cancelar</button>
                        <button type="button" class="btn btn--primary" @onclick="AplicarTarifasBulkEditAsync" disabled="@(!_tarifasAumentoSimulada || _tarifasAumentoSeleccionadas.Count == 0)">Guardar aumento</button>
                    </footer>
                </section>
            </div>
        }

        @if (_showTarifaEditor)
        {
            <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onmousedown="CerrarTarifaEditorAsync">
                <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--wide" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-tarifa-title" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                    <header class="cuentas-modal__header">
                        <div class="carga-viajes-tarifa-editor__header">
                            <span class="cuentas-modal__eyebrow">Tarifas</span>
                            <div class="carga-viajes-tarifa-editor__header-row">
                                <h3 id="carga-viajes-tarifa-title">@(_isNewTarifa ? "Nueva tarifa" : "Editar tarifa")</h3>
                                <div class="carga-viajes-tarifa-editor__header-id">
                                    <span class="carga-viajes-tarifa-editor__header-id-label">ID lista</span>
                                    <span class="carga-viajes-tarifa-editor__header-id-value">@_tarifaForm.IdLista</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="cuentas-modal__close" @onclick="CerrarTarifaEditorAsync" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>
                    <div class="cuentas-modal__body">
                        @if (_tarifaEditorFeedback is not null)
                        {
                            <div class="editor-msg carga-viajes-feedback__box @GetFeedbackClass(_tarifaEditorFeedback)">
                                <div class="carga-viajes-feedback__content">
                                    @if (ShouldShowFeedbackTitle(_tarifaEditorFeedback))
                                    {
                                        <strong class="carga-viajes-feedback__title">@_tarifaEditorFeedback.Title</strong>
                                    }
                                    <div class="carga-viajes-feedback__line">
                                        <span>@FormatFeedbackMessage(_tarifaEditorFeedback)</span>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="carga-viajes-form-grid carga-viajes-tarifa-editor__grid">
                            <div class="field field--wide">
                                <label>Tipo de tarifa</label>
                                <div class="carga-viajes-tarifa-editor__type" role="group" aria-label="Tipo de tarifa">
                                    <button type="button"
                                            class="carga-viajes-filter-pill @(!_tarifaForm.TarifaFletero ? "carga-viajes-filter-pill--active" : string.Empty)"
                                            aria-pressed="@(!_tarifaForm.TarifaFletero)"
                                            disabled="@(!_isNewTarifa)"
                                            title="@(_isNewTarifa ? string.Empty : "No se puede cambiar el tipo de una tarifa existente")"
                                            @onclick="SetTarifaClienteTypeAsync">
                                        <span class="carga-viajes-filter-pill__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                        <span>Cliente</span>
                                    </button>
                                    <button type="button"
                                            class="carga-viajes-filter-pill @(_tarifaForm.TarifaFletero ? "carga-viajes-filter-pill--active" : string.Empty)"
                                            aria-pressed="@_tarifaForm.TarifaFletero"
                                            disabled="@(!_isNewTarifa)"
                                            title="@(_isNewTarifa ? string.Empty : "No se puede cambiar el tipo de una tarifa existente")"
                                            @onclick="SetTarifaFleteroTypeAsync">
                                        <span class="carga-viajes-filter-pill__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                        <span>Fletero</span>
                                    </button>
                                </div>
                            </div>

                            <div class="field field--wide">
                                @if (_tarifaForm.TarifaFletero)
                                {
                                    <label>Chofer / fletero</label>
                                    <LookupAutocomplete @ref="_tarifaChoferLookup"
                                                        Label=""
                                                        Placeholder="Buscar chofer o fletero..."
                                                        Text="@_tarifaChoferTexto"
                                                        TextChanged="OnTarifaChoferTextoChangedAsync"
                                                        SelectedChanged="OnTarifaChoferSeleccionadoAsync"
                                                        OnEnterCommitted="FocusTarifaNombreAsync"
                                                        SearchFunc="CargaViajesSvc.SearchChoferLookupAsync"
                                                        Disabled="@(!_isNewTarifa)"
                                                        MinimumCharacters="0" />
                                }
                                else
                                {
                                    <label>Cliente</label>
                                    <LookupAutocomplete @ref="_tarifaClienteLookup"
                                                        Label=""
                                                        Placeholder="Buscar cliente..."
                                                        Text="@_tarifaClienteTexto"
                                                        TextChanged="OnTarifaClienteTextoChangedAsync"
                                                        SelectedChanged="OnTarifaClienteSeleccionadoAsync"
                                                        OnEnterCommitted="FocusTarifaNombreAsync"
                                                        SearchFunc="CargaViajesSvc.SearchClientesAsync"
                                                        Disabled="@(!_isNewTarifa)"
                                                        MinimumCharacters="0" />
                                }
                            </div>

                            <div class="field field--wide">
                                <label>Nombre de lista</label>
                                <input @ref="_tarifaNombreInput" type="text" @bind="_tarifaForm.Nombre" @onkeydown="args => HandleEnterAdvanceAsync(args, FocusTarifaDestinoAsync)" />
                            </div>

                            <div class="field">
                                <label>Destino</label>
                                <LookupAutocomplete @ref="_tarifaDestinoLookup"
                                                    Label=""
                                                    Placeholder="Buscar destino..."
                                                    Text="@_tarifaDestinoTexto"
                                                    TextChanged="OnTarifaDestinoTextoChangedAsync"
                                                    SelectedChanged="OnTarifaDestinoSeleccionadoAsync"
                                                    OnEnterCommitted="FocusTarifaTipoVehiculoAsync"
                                                    SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync"
                                                    MinimumCharacters="0" />
                            </div>

                            <div class="field">
                                <label>Tipo vehículo</label>
                                <LookupAutocomplete @ref="_tarifaTipoVehiculoLookup"
                                                    Label=""
                                                    Placeholder="Buscar tipo..."
                                                    Text="@_tarifaTipoVehiculoTexto"
                                                    TextChanged="OnTarifaTipoVehiculoTextoChangedAsync"
                                                    SelectedChanged="OnTarifaTipoVehiculoSeleccionadoAsync"
                                                    OnEnterCommitted="FocusTarifaImporteAsync"
                                                    SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync"
                                                    MinimumCharacters="0" />
                            </div>

                            <div class="field">
                                <label>Importe</label>
                                <input @ref="_tarifaImporteInput" type="number" step="0.01" @bind="_tarifaForm.Importe" @onkeydown="args => HandleEnterAdvanceAsync(args, FocusTarifaGuardarAsync)" />
                            </div>

                            <div class="field field--wide carga-viajes-tarifa-editor__fixed">
                                <label>Adicionales de esta tarifa</label>
                                <div class="carga-viajes-tarifa-editor__fixed-grid">
                                    <div class="carga-viajes-tarifa-editor__fixed-item">
                                        <div class="field">
                                            <label>Adicional 1 descripción</label>
                                            <input type="text" @bind="_tarifaForm.AdicionalFijo1Descripcion" placeholder="Dsp de 8hs" />
                                        </div>
                                        <div class="field">
                                            <label>Importe</label>
                                            <input type="number" step="0.01" @bind="_tarifaForm.AdicionalFijo1Importe" />
                                        </div>
                                        <label class="carga-viajes-checkbox @( _tarifaForm.AdicionalFijo1PideCantidad ? "carga-viajes-checkbox--active" : string.Empty)">
                                            <input class="carga-viajes-checkbox__input" type="checkbox" @bind="_tarifaForm.AdicionalFijo1PideCantidad" />
                                            <span class="carga-viajes-checkbox__box" aria-hidden="true"></span>
                                            <span class="carga-viajes-checkbox__label">Pide cantidad</span>
                                        </label>
                                    </div>
                                    <div class="carga-viajes-tarifa-editor__fixed-item">
                                        <div class="field">
                                            <label>Adicional 2 descripción</label>
                                            <input type="text" @bind="_tarifaForm.AdicionalFijo2Descripcion" placeholder="Otro adicional" />
                                        </div>
                                        <div class="field">
                                            <label>Importe</label>
                                            <input type="number" step="0.01" @bind="_tarifaForm.AdicionalFijo2Importe" />
                                        </div>
                                        <label class="carga-viajes-checkbox @( _tarifaForm.AdicionalFijo2PideCantidad ? "carga-viajes-checkbox--active" : string.Empty)">
                                            <input class="carga-viajes-checkbox__input" type="checkbox" @bind="_tarifaForm.AdicionalFijo2PideCantidad" />
                                            <span class="carga-viajes-checkbox__box" aria-hidden="true"></span>
                                            <span class="carga-viajes-checkbox__label">Pide cantidad</span>
                                        </label>
                                    </div>
                                    <div class="carga-viajes-tarifa-editor__fixed-item">
                                        <div class="field">
                                            <label>Adicional 3 descripción</label>
                                            <input type="text" @bind="_tarifaForm.AdicionalFijo3Descripcion" />
                                        </div>
                                        <div class="field">
                                            <label>Importe</label>
                                            <input type="number" step="0.01" @bind="_tarifaForm.AdicionalFijo3Importe" />
                                        </div>
                                        <label class="carga-viajes-checkbox @( _tarifaForm.AdicionalFijo3PideCantidad ? "carga-viajes-checkbox--active" : string.Empty)">
                                            <input class="carga-viajes-checkbox__input" type="checkbox" @bind="_tarifaForm.AdicionalFijo3PideCantidad" />
                                            <span class="carga-viajes-checkbox__box" aria-hidden="true"></span>
                                            <span class="carga-viajes-checkbox__label">Pide cantidad</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="carga-viajes-tarifa-editor__fixed-hint">
                                    Si una descripción tiene importe 0, se mostrará como advertencia visual.
                                </div>
                                <div class="actions" style="justify-content:flex-start; margin-top: .75rem;">
                                    <button type="button"
                                            class="btn btn--secondary btn--sm"
                                            disabled="@(_tarifaForm.TarifaFletero || string.IsNullOrWhiteSpace(_tarifaForm.Cliente))"
                                            @onclick="AbrirDuplicarTarifaAdicionalesAsync">
                                        Seleccionar lista a duplicar adicionales
                                    </button>
                                </div>
                            </div>

                            <div class="field">
                                <label>Estado</label>
                                <button type="button"
                                        class="carga-viajes-switch @(_tarifaForm.Activo ? "carga-viajes-check--active" : string.Empty)"
                                        aria-pressed="@_tarifaForm.Activo"
                                        @onclick="ToggleTarifaActivoAsync">
                                    <span class="carga-viajes-check__text">@(_tarifaForm.Activo ? "Activo" : "Desactivado")</span>
                                    <span class="carga-viajes-switch__pill" aria-hidden="true">
                                        <span class="carga-viajes-switch__thumb"></span>
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <footer class="cuentas-modal__actions">
                        <button type="button" class="btn btn--primary" @ref="_tarifaGuardarButton" @onclick="GuardarTarifaAsync">Guardar tarifa</button>
                        <button type="button" class="btn btn--ghost" @onclick="CerrarTarifaEditorAsync">Cerrar</button>
                    </footer>
                </section>
            </div>
        }
        @if (_showTarifaAdicionalesPropagateModal)
        {
            <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onmousedown="CloseTarifaAdicionalesPropagateModalAsync">
                <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--wide" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-tarifa-adicionales-title" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                    <header class="cuentas-modal__header">
                        <div>
                            <span class="cuentas-modal__eyebrow">Tarifas</span>
                            <h3 id="carga-viajes-tarifa-adicionales-title">Seleccionar listas a duplicar adicionales</h3>
                        </div>
                        <button type="button" class="cuentas-modal__close" @onclick="CloseTarifaAdicionalesPropagateModalAsync" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>

                    <div class="cuentas-modal__body">
                        <div class="editor-msg carga-viajes-feedback__box carga-viajes-feedback__box--info">
                            <div class="carga-viajes-feedback__content">
                                <strong class="carga-viajes-feedback__title">Duplicar solo los adicionales</strong>
                                <div class="carga-viajes-feedback__line">
                                    <span>Elegí las tarifas que van a recibir solamente los datos de los adicionales.</span>
                                </div>
                            </div>
                        </div>

                        <div class="carga-viajes-form-grid">
                            <div class="field">
                                <label>Cliente</label>
                                <input type="search"
                                       class="carga-viajes-adicionales__search"
                                       placeholder="Filtrar por cliente"
                                       @bind="_tarifaAdicionalesPropagateFilters.Cliente"
                                       @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label>Nombre de tarifa</label>
                                <input type="search"
                                       class="carga-viajes-adicionales__search"
                                       placeholder="Filtrar por nombre de tarifa"
                                       @bind="_tarifaAdicionalesPropagateFilters.Texto"
                                       @bind:event="oninput" />
                            </div>
                            <div class="field field--wide">
                                <button type="button" class="btn btn--ghost" @onclick="RecargarTarifaAdicionalesPropagateAsync" disabled="@_tarifaAdicionalesPropagateLoading">Buscar</button>
                            </div>
                            <div class="field field--wide">
                                <div class="carga-viajes-modal__list carga-viajes-modal__list--compact">
                                    @if (_tarifaAdicionalesPropagateLoading)
                                    {
                                        <div class="cuentas-modal__empty">
                                            <span>Preparando tarifas...</span>
                                        </div>
                                    }
                                    else if (_tarifaAdicionalesPropagateRows.Count == 0)
                                    {
                                        <div class="cuentas-modal__empty">
                                            <span>No hay coincidencias para la búsqueda.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var row in _tarifaAdicionalesPropagateRows)
                                        {
                                            var selected = _tarifaAdicionalesPropagateSelected.Contains(row.IdLista);
                                            <label class="carga-viajes-checkbox carga-viajes-checkbox--row @(selected ? "carga-viajes-checkbox--active" : string.Empty)">
                                                <input type="checkbox"
                                                       class="carga-viajes-checkbox__input"
                                                       checked="@selected"
                                                       @onchange="args => ToggleTarifaAdicionalesPropagateSelectionAsync(row, args)" />
                                                <span class="carga-viajes-checkbox__box" aria-hidden="true"></span>
                                                <span class="carga-viajes-checkbox__label">
                                                    <span class="carga-viajes-checkbox__label-title">
                                                        <strong>@row.IdLista - @row.Nombre</strong>
                                                    </span>
                                                    <span class="carga-viajes-checkbox__label-meta">@row.Cliente | @row.Destino | @row.TipoVehiculo</span>
                                                    <span class="carga-viajes-checkbox__label-meta">
                                                        @FormatMoney(row.Importe) @if (row.TarifaFletero) { <text>| Fletero</text> }
                                                    </span>
                                                    <span class="carga-viajes-checkbox__label-meta">
                                                        @if (!string.IsNullOrWhiteSpace(row.AdicionalFijo1Descripcion))
                                                        {
                                                            <text>A1: @row.AdicionalFijo1Descripcion (@FormatMoney(row.AdicionalFijo1Importe)@((row.AdicionalFijo1PideCantidad) ? " · Pide cantidad" : string.Empty))</text>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(row.AdicionalFijo2Descripcion))
                                                        {
                                                            <text>@(string.IsNullOrWhiteSpace(row.AdicionalFijo1Descripcion) ? string.Empty : " | ")A2: @row.AdicionalFijo2Descripcion (@FormatMoney(row.AdicionalFijo2Importe)@((row.AdicionalFijo2PideCantidad) ? " · Pide cantidad" : string.Empty))</text>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(row.AdicionalFijo3Descripcion))
                                                        {
                                                            <text>@((!string.IsNullOrWhiteSpace(row.AdicionalFijo1Descripcion) || !string.IsNullOrWhiteSpace(row.AdicionalFijo2Descripcion)) ? " | " : string.Empty)A3: @row.AdicionalFijo3Descripcion (@FormatMoney(row.AdicionalFijo3Importe)@((row.AdicionalFijo3PideCantidad) ? " · Pide cantidad" : string.Empty))</text>
                                                        }
                                                    </span>
                                                </span>
                                            </label>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <footer class="cuentas-modal__actions">
                        <button type="button" class="btn btn--ghost" @onclick="CloseTarifaAdicionalesPropagateModalAsync">Cancelar</button>
                        <button type="button" class="btn btn--primary" @onclick="AplicarTarifaAdicionalesPropagateAsync" disabled="@(_tarifaAdicionalesPropagateLoading || _tarifaAdicionalesPropagateRows.Count == 0)">Actualizar adicionales</button>
                    </footer>
                </section>
            </div>
        }
    }
    else if (_activeSection == SectionChoferes)
    {
        var pageActions = BuildListPageActions();
        var choferesFilterChips = BuildChoferesFilterChips();
        var showChoferesClearButton = choferesFilterChips.Count > 0 || !string.IsNullOrWhiteSpace(_choferesFilters.Texto);

        <section class="panel-card carga-viajes-section carga-viajes-section--filters">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Choferes</h3>
                </div>
            </div>

            <ModuleListToolbar AriaLabel="Herramientas de choferes"
                               PagerAriaLabel="Paginación de choferes"
                               ActionsAriaLabel="Acciones de choferes"
                               ShowPager="true"
                               CurrentPage="@_choferesPage"
                               TotalPages="@_choferesTotalPages"
                               IsLoading="@_choferesLoading"
                               OnPageChanged="CambiarPaginaChoferesAsync"
                               Actions="@pageActions">
                <SearchContent>
                    <div class="smart-search carga-viajes-smart-search carga-viajes-smart-search--choferes" @onkeydown="HandleChoferesSearchKeyDownAsync">
                        <div class="carga-viajes-smart-search__anchor">
                            <div class="smart-search__bar carga-viajes-smart-search__bar--with-chips">
                        <i class="bi bi-search carga-viajes-smart-search__search-icon"></i>
                        <div class="carga-viajes-smart-search__entry">
                            @if (choferesFilterChips.Count > 0)
                            {
                                <div class="carga-viajes-smart-search__inline-chips" aria-live="polite">
                                    @foreach (var chip in choferesFilterChips)
                                    {
                                        <button type="button"
                                                class="smart-chip carga-viajes-filter-chip"
                                                @key="chip.Key"
                                                title="@chip.Label"
                                                aria-label="@($"Quitar filtro {chip.Label}")"
                                                @onclick="() => RemoveChoferesFilterChipAsync(chip.Key)"
                                                @onclick:stopPropagation="true">
                                            <span>@chip.Label</span>
                                            <i class="bi bi-x" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            }
                            <input type="search"
                                   class="carga-viajes-smart-search__text-input"
                                   placeholder=""
                                   aria-label="Buscar chofer, fletero o código"
                                   @bind="_choferesFilters.Texto"
                                   @bind:event="oninput"
                                   @onfocus="AbrirChoferesAdvancedFilters" />
                        </div>
                        @if (showChoferesClearButton)
                        {
                            <button type="button"
                                    class="carga-viajes-clear-filters-btn"
                                    title="Limpiar filtros"
                                    aria-label="Limpiar filtros"
                                    @onclick="LimpiarFiltrosChoferesAsync"
                                    @onclick:stopPropagation="true">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        }
                        <button type="button" class="smart-search__toggle" @onclick="ToggleChoferesAdvancedFilters" aria-expanded="@_showChoferesAdvancedFilters" aria-controls="carga-viajes-choferes-filtros-avanzados" aria-label="Mostrar filtros avanzados">
                            <i class="bi @(_showChoferesAdvancedFilters ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                        </button>
                            </div>

                    @if (_showChoferesAdvancedFilters)
                    {
                        <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onmousedown="() => _showChoferesAdvancedFilters = false"></button>
                        <div id="carga-viajes-choferes-filtros-avanzados" class="smart-search__panel carga-viajes-smart-search__panel--choferes" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                            <div class="smart-search__column">
                                <h4><i class="bi bi-sliders"></i> Estado</h4>
                                <div class="smart-search__inline">
                                    <label>Activo</label>
                                    <select @bind="_choferesFilters.Activo"><option value="">Todos</option><option value="1">Activo</option><option value="0">Desactivado</option></select>
                                </div>
                                <div class="smart-search__inline">
                                    <label>Disponible</label>
                                    <select @bind="_choferesFilters.Disponible"><option value="">Todos</option><option value="1">Disponible</option><option value="0">No disponible</option></select>
                                </div>
                            </div>
                            <div class="smart-search__column">
                                <h4><i class="bi bi-person-badge"></i> Clasificación</h4>
                                <div class="smart-search__inline">
                                    <label>Es fletero</label>
                                    <select @bind="_choferesFilters.EsFletero"><option value="">Todos</option><option value="1">Fletero</option><option value="0">No fletero</option></select>
                                </div>
                                <div class="smart-search__inline">
                                    <label>Tipo vehículo</label>
                                    <LookupAutocomplete Label="" Placeholder="Buscar tipo..." Text="@_choferesTipoVehiculoTexto" TextChanged="OnChoferTipoVehiculoChangedAsync" SelectedChanged="OnChoferTipoVehiculoSelectedAsync" OnEnterCommitted="AplicarFiltrosChoferesAsync" SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" MinimumCharacters="0" />
                                </div>
                            </div>
                            <div class="carga-viajes-smart-search__apply-row">
                                <button type="button" class="btn btn--primary carga-viajes-smart-search__apply-btn" @onclick="AplicarFiltrosChoferesYCerrarAsync">Aplicar filtros</button>
                            </div>
                        </div>
                    }
                        </div>
                    </div>
                </SearchContent>
            </ModuleListToolbar>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div><h3 class="panel-card__title">Choferes</h3></div>
            </div>
            <div class="usuarios-table-wrap">
                <table class="data-table" data-sticky-list-header>
                    <thead>
                        <tr>
                            <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortChoferesAsync(SortKeyCodigo)"><span>Código</span><i class="bi @GetSortIcon(_choferesFilters, SortKeyCodigo)"></i></button></th>
                            <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortChoferesAsync(SortKeyNombre)"><span>Nombre</span><i class="bi @GetSortIcon(_choferesFilters, SortKeyNombre)"></i></button></th>
                            <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortChoferesAsync(SortKeyActivo)"><span>Activo</span><i class="bi @GetSortIcon(_choferesFilters, SortKeyActivo)"></i></button></th>
                            <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortChoferesAsync(SortKeyDisponible)"><span>Disponible</span><i class="bi @GetSortIcon(_choferesFilters, SortKeyDisponible)"></i></button></th>
                            <th><button type="button" class="carga-viajes-sort-button" @onclick="() => SortChoferesAsync(SortKeyEsFletero)"><span>Es fletero</span><i class="bi @GetSortIcon(_choferesFilters, SortKeyEsFletero)"></i></button></th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                                @foreach (var row in _choferes)
                                {
                            <tr @ondblclick="() => EditarChoferAsync(row.Codigo)">
                                <td>@row.Codigo</td><td>@row.Nombre</td><td>@(row.Activo ? "Activo" : "Desactivado")</td><td>@(row.Disponible ? "Disponible" : "No disponible")</td><td>@(row.EsFletero ? "Fletero" : "Chofer")</td>
                                <td><div class="actions"><button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarChoferAsync(row.Codigo)">Editar</button><button type="button" class="btn btn--ghost btn--sm" @onclick="() => BajaChoferAsync(row.Codigo)">Baja</button></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="carga-viajes-list-footer">@GetChoferesFoundText()</div>
        </section>

        @if (_showChoferEditor)
        {
            <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onmousedown="CerrarChoferEditorAsync">
                <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--compact" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-chofer-title" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                    <header class="cuentas-modal__header">
                        <div>
                            <span class="cuentas-modal__eyebrow">Choferes</span>
                            <h3 id="carga-viajes-chofer-title">@(_isNewChofer ? "Nuevo chofer" : $"Editar chofer {_choferForm.Codigo}")</h3>
                        </div>
                        <button type="button" class="cuentas-modal__close" @onclick="CerrarChoferEditorAsync" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </header>
                    <div class="cuentas-modal__body">
                        <div class="carga-viajes-form-grid">
                            <div class="field"><label>Código</label><input @ref="_choferCodigoInput" type="text" @bind="_choferForm.Codigo" disabled="@(!_isNewChofer)" @onkeydown="args => HandleEnterAdvanceAsync(args, FocusChoferNombreAsync)" /></div>
                            <div class="field field--wide"><label>Nombre</label><input @ref="_choferNombreInput" type="text" @bind="_choferForm.Nombre" @onkeydown="args => HandleEnterAdvanceAsync(args, FocusChoferGuardarAsync)" /></div>
