                        <button type="button" class="btn btn--primary" @onclick="GuardarTipoVehiculoAsync">Guardar tipo de vehículo</button>
                        <button type="button" class="btn btn--ghost" @onclick="CerrarTipoVehiculoEditorAsync">Cerrar</button>
                    </footer>
                </section>
            </div>
