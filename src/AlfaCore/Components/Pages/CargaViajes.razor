    private IReadOnlyList<CargaViajesViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private IReadOnlyList<CargaViajeGroupDto> BuildViajeGroups()
    {
        if (_viewSettings.AgruparPor == CargaViajesViewGroupKeys.Estado)
            return _viajes.GroupBy(x => x.Estado).Select(g => new CargaViajeGroupDto { Label = g.Key, ShowHeader = true, Items = g.ToList() }).ToList();
        if (_viewSettings.AgruparPor == CargaViajesViewGroupKeys.Usuario)
            return _viajes.GroupBy(x => x.Usuario).Select(g => new CargaViajeGroupDto { Label = string.IsNullOrWhiteSpace(g.Key) ? "Sin usuario" : g.Key, ShowHeader = true, Items = g.ToList() }).ToList();
        return [new CargaViajeGroupDto { Label = string.Empty, ShowHeader = false, Items = _viajes.ToList() }];
    }

    private static string RenderViajeColumn(CargaViajesGridItemDto row, string key)
        => (key ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            CargaViajesViewColumnKeys.Fecha => row.Fecha.ToString("dd/MM/yyyy"),
            CargaViajesViewColumnKeys.IdComprobante => row.IdComprobante,
            CargaViajesViewColumnKeys.Cliente => DisplayText(row.ClienteNombre, row.ClienteCodigo),
            CargaViajesViewColumnKeys.Destino => DisplayText(row.DestinoDescripcion, row.DestinoCodigo),
            CargaViajesViewColumnKeys.Chofer => DisplayText(row.ChoferNombre, row.ChoferCodigo),
            CargaViajesViewColumnKeys.TipoVehiculo => DisplayText(row.TipoVehiculoDescripcion, row.TipoVehiculoCodigo),
            CargaViajesViewColumnKeys.TotalCliente => row.TotalCliente.ToString("N2"),
            CargaViajesViewColumnKeys.TotalFletero => row.TotalFletero.ToString("N2"),
            CargaViajesViewColumnKeys.Estado => row.Estado,
            CargaViajesViewColumnKeys.Usuario => row.Usuario,
            CargaViajesViewColumnKeys.Alta => row.FechaHoraAlta.HasValue ? row.FechaHoraAlta.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty,
            _ => string.Empty
        };

