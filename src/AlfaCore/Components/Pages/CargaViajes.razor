    private async Task HandleViajesFilterKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            await AplicarFiltrosViajesAsync();
    }

    private async Task HandleModalKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            return;

        if (_showViewSettings)
            CancelarConfiguracionVista();
        else if (_showConfigEditor)
            CerrarConfiguracionModulo();
        else if (_showTarifaEditor)
            await CerrarTarifaEditorAsync();
        else if (_showChoferEditor)
            await CerrarChoferEditorAsync();
        else if (_showDestinoEditor)
            await CerrarDestinoEditorAsync();
        else if (_showTipoVehiculoViewSettings)
            CancelarConfiguracionTipoVehiculoVista();
        else if (_showTipoVehiculoEditor)
            await CerrarTipoVehiculoEditorAsync();
        else if (_showViajeEditor)
            await CerrarViajeEditorAsync();
    }

    private async Task NavigateSectionAsync(string section)
    {
        var normalized = NormalizeSection(section);
        Nav.NavigateTo(normalized == SectionViajes ? "/carga-viajes" : $"/carga-viajes/{normalized}");
        await Task.CompletedTask;
    }

    private static string NormalizeSection(string? value)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            SectionTarifas => SectionTarifas,
            SectionNuevo => SectionNuevo,
            SectionChoferes => SectionChoferes,
            SectionDestinos => SectionDestinos,
            SectionTipoVehiculo => SectionTipoVehiculo,
            SectionConfiguracion => SectionConfiguracion,
            _ => SectionViajes
        };

