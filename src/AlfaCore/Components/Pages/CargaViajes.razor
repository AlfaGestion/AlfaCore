        if (string.IsNullOrWhiteSpace(baseIdLista))
            return;

        var result = await UiOps.RunAsync(() => CargaViajesSvc.ClonarTarifaParaViajeAsync(baseIdLista, _viajeForm), "No se pudo duplicar la tarifa seleccionada para el viaje.");
        if (!result.Success || result.Value is null)
        {
            _viajeEditorFeedback = result.Feedback;
            return;
        }

        var tarifa = result.Value;
        _viajeForm.Lista = tarifa.IdLista;
        _viajeForm.ListaDisplay = FormatListaDisplay(tarifa.IdLista, tarifa.Nombre);
        _viajeListaTexto = _viajeForm.ListaDisplay;
        _viajeListaManualOverride = true;

        if (tarifa.TarifaFletero)
            _viajeForm.ImporteFletero = tarifa.Importe;
        else
            _viajeForm.ImporteCliente = tarifa.Importe;

        ApplyVisibleAdicionalesGeneralesFromTarifa(tarifa);
        SyncViajeAdicionalesFromForm();
        _viajeDirty = true;
        await FocusViajeImporteClienteAsync();
    }

