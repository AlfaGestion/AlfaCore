    private async Task AbrirTarifasClienteAsync()
    {
        if (_viajeReadOnly)
            return;

        _showViajeTarifasClientePanel = true;
        _viajeTarifasPanelPositionPending = true;
        _viajeTarifasFeedback = null;
        _viajeTarifasSelectionHint = string.Empty;
        _viajeTarifasSearch = string.Empty;
        _viajeTarifasLoading = true;
        await InvokeAsync(StateHasChanged);

        if (string.IsNullOrWhiteSpace(_viajeForm.Cliente))
        {
            _viajeTarifasLoading = false;
            _viajeTarifasFeedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Seleccioná un cliente",
                Message = "Primero elegí un cliente desde la lista para cargar sus tarifas."
            };
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var result = await UiOps.RunAsync(
                () => CargaViajesSvc.GetTarifasPorClienteAsync(_viajeForm.Cliente),
                "No se pudieron cargar las tarifas del cliente.");
            if (result.Success && result.Value is not null)
            {
                _viajeTarifasClienteRows.Clear();
                _viajeTarifasClienteRows.AddRange(result.Value);
            }
            else
            {
                _viajeTarifasClienteRows.Clear();
                _viajeTarifasFeedback = result.Feedback;
            }
        }
        finally
        {
            _viajeTarifasLoading = false;
            _viajeTarifasPanelPositionPending = true;
            await InvokeAsync(StateHasChanged);
        }
    }

