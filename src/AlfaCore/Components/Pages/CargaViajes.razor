    private async Task GuardarTarifaAsync()
    {
        try
        {
            if (_isNewTarifa)
                await ActualizarTarifaIdListaAsync();

            if (string.IsNullOrWhiteSpace(_tarifaForm.IdLista))
                throw new InvalidOperationException("No se pudo determinar el Id lista de la tarifa.");

            _tarifaForm.OriginalIdLista = _tarifaOriginalIdLista;
            await CargaViajesSvc.SaveTarifaAsync(_tarifaForm);
        }
        catch (Exception ex)
        {
            _tarifaEditorFeedback = UiOps.BuildMessage(ex, "No se pudo guardar la tarifa. Detalle tecnico registrado.");
            return;
        }

        _tarifaEditorFeedback = null;
        SetSuccessFeedback("Tarifa guardada", "La tarifa quedó actualizada.");
        _showTarifaEditor = false;
        _tarifaSnapshot = string.Empty;
        await RecargarTarifasAsync();
    }

