        {
            ["desde"] = _liquidacionesFilters.FechaDesde?.ToString("yyyy-MM-dd"),
            ["hasta"] = _liquidacionesFilters.FechaHasta?.ToString("yyyy-MM-dd"),
            ["chofer"] = _liquidacionesFilters.ChoferCodigo,
            ["cliente"] = _liquidacionesFilters.ClienteCodigo,
            ["destino"] = _liquidacionesFilters.DestinoCodigo,
            ["tipoPersona"] = _liquidacionesFilters.TipoPersona,
            ["estado"] = _liquidacionesFilters.Estado,
            ["estadoPago"] = _liquidacionesFilters.EstadoPago,
            ["token"] = await GetUserTokenAsync()
        };

        return QueryHelpers.AddQueryString(RouteContext.BuildRoute("/carga-viajes/liquidacion/descargar-excel"), query!);
    }

