    private IReadOnlyList<CargaViajeReporteLiquidacionResumenDto> GetReporteLiquidacionResumen()
        => GetReporteRowsAplicandoTipoPersona()
            .GroupBy(x => new { x.ChoferCodigo, x.ChoferNombre, x.EsFletero })
            .Select(g => new CargaViajeReporteLiquidacionResumenDto
            {
                ChoferCodigo = g.Key.ChoferCodigo,
                ChoferNombre = g.Key.ChoferNombre,
                EsFletero = g.Key.EsFletero,
                CantidadViajes = g.Sum(x => Math.Max(1, x.CantidadViajes)),
                TotalFlete = g.Sum(x => x.TotalFlete),
                TotalPeaje = g.Sum(x => x.EsFletero ? Math.Max(0m, x.TotalConPeaje - x.TotalFlete) : 0m),
                TotalConPeaje = g.Sum(x => x.TotalConPeaje)
            })
            .OrderByDescending(x => x.TotalConPeaje)
            .ThenByDescending(x => x.CantidadViajes)
            .ThenBy(x => x.ChoferNombre)
            .ThenBy(x => x.ChoferCodigo)
            .ToList();

