                                                   step="0.01"
                                                   min="0"
                                                   class="form-control form-control-sm text-end"
                                                   @bind="_config.PorcentajesAdicionales[index]"
                                                   disabled="@(!habilitado)" />
                                        </div>
                                        <label class="carga-viajes-config-adicionales__toggle @(habilitado ? "carga-viajes-config-adicionales__toggle--on" : string.Empty)">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   checked="@habilitado"
                                                   @onchange="args => OnConfigAdicionalHabilitadoChangedAsync(index, args)" />
                                            <span>Habilitado</span>
                                        </label>
                                        @if (index == 5)
                                        {
                                            <div class="carga-viajes-config-adicionales__toggle carga-viajes-config-adicionales__toggle--on">
                                                <span>Se suma al total del cliente</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <label class="carga-viajes-config-adicionales__toggle @(habilitado && GetConfigAdicionalSumarFletero(index) ? "carga-viajes-config-adicionales__toggle--on" : string.Empty)">
                                                <input type="checkbox"
                                                       class="form-check-input"
