    private async Task ConfirmarLiquidacionesPagoAsync()
    {
        if (!ValidateLiquidacionesPagoModal())
            return;

        var selectedRows = GetLiquidacionesPagoModalRows();
        if (selectedRows.Count == 0)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Sin viajes seleccionados",
                Message = "Debés dejar al menos un viaje seleccionado para confirmar el pago."
            };
            return;
        }

        if (selectedRows.Any(x => x.FletePagado))
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Viajes ya pagados",
                Message = "No se puede confirmar el pago con viajes que ya fueron pagados."
            };
            return;
        }

        var userName = AppUserSession.GetCurrentUserName(string.Empty);
        var result = await UiOps.RunAsync(() => CargaViajesSvc.MarcarFletesPagadosAsync(new CargaViajesMarcarPagadoRequest
        {
            Ids = selectedRows.Select(x => x.Id).ToList(),
            FechaPago = _liquidacionesPagoFecha,
            Observacion = _liquidacionesPagoObservacion,
            Usuario = userName
        }), "No se pudieron marcar los fletes como pagados.");

        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        var actualizados = result.Value;
        _showLiquidacionesPagoModal = false;
        _liquidacionesSeleccionadas.Clear();
        _liquidacionesTotalSeleccionado = 0m;

        if (_liquidacionesConsultada)
            await RecargarLiquidacionesAsync();

        if (actualizados < selectedRows.Count)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Pago parcial",
                Message = $"Se actualizaron {actualizados} de {selectedRows.Count} viaje(s). Algunos ya estaban pagados."
            };
            return;
        }

        _feedback = new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Success,
            Title = "Pagos registrados",
            Message = $"Se marcaron {actualizados} viaje(s) como pagados."
        };
    }

