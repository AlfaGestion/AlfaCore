                        </div>

                        <div class="field field--wide carga-viajes-adicionales">
                            <label>Adicionales generales</label>
                            <div class="carga-viajes-adicionales__simple-list">
                                @for (var i = 0; i < 6; i++)
                                {
                                    var index = i;
                                    if (!GetConfigAdicionalHabilitado(index))
