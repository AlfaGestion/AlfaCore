    private bool ValidateLiquidaciones()
    {
        EnsureLiquidacionesFiltersInitialized();

        if (_liquidacionesFilters.FechaDesde.HasValue && _liquidacionesFilters.FechaHasta.HasValue && _liquidacionesFilters.FechaHasta.Value.Date < _liquidacionesFilters.FechaDesde.Value.Date)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Rango inválido", Message = "La fecha hasta no puede ser menor que la fecha desde." };
            return false;
        }

        if (!_liquidacionesFilters.IncluirChoferes && !_liquidacionesFilters.IncluirFleteros)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Seleccione tipo de liquidación", Message = "Seleccione Choferes, Fleteros o ambos." };
            return false;
        }

        return true;
    }

    private bool ValidateLiquidacionesMarcado()
    {
        if (_liquidacionesSeleccionadas.Count == 0)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Seleccione viajes", Message = "Debe seleccionar al menos un viaje para marcar como pagado." };
            return false;
        }

        if (_liquidacionesPagoObservacion.Length > 250)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Observación demasiado larga", Message = "La observación de pago no puede superar los 250 caracteres." };
            return false;
        }

        return true;
    }

    private bool ValidateLiquidacionesPagoModal()
    {
        if (_liquidacionesSeleccionadas.Count == 0)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Seleccione viajes",
                Message = "Debe seleccionar al menos un viaje para continuar."
            };
            return false;
        }

        if (_liquidacionesPagoFecha == default)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Fecha obligatoria",
                Message = "Debe informar la fecha de pago."
            };
            return false;
        }

        if (_liquidacionesPagoObservacion.Length > 250)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Observación demasiado larga",
                Message = "La observación de pago no puede superar los 250 caracteres."
            };
            return false;
        }

        if (GetLiquidacionesPagoModalRows().Count == 0)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Sin viajes válidos",
                Message = "No quedan viajes seleccionados para confirmar el pago."
            };
            return false;
        }

        return true;
    }

    private async Task RecargarLiquidacionesAsync()
    {
        _liquidacionesLoading = true;
        _liquidacionesConsultada = true;
        _liquidacionesRows.Clear();
        _liquidacionesSeleccionadas.Clear();
        _liquidacionesTotalSeleccionado = 0m;

        try
        {
            var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchLiquidacionesFletesAsync(_liquidacionesFilters), "No se pudieron cargar las liquidaciones.");
            if (result.Success && result.Value is not null)
            {
                _liquidacionesRows.Clear();
                _liquidacionesRows.AddRange(result.Value);
                Logger.LogInformation(
                    "Liquidaciones dataset rows={Rows} totalConPeaje={TotalConPeaje} totalFlete={TotalFlete} totalPeaje={TotalPeaje} tipoPersona={TipoPersona} mostrarLiquidados={MostrarLiquidados}",
                    _liquidacionesRows.Count,
                    GetLiquidacionesTotalPendienteVisible(),
                    _liquidacionesRows.Sum(x => x.TotalFlete),
                    _liquidacionesRows.Sum(x => Math.Max(0m, x.Peaje)),
                    GetLiquidacionesTipoPersonaLabel(),
                    _liquidacionesFilters.MostrarLiquidados);
                return;
            }

            _feedback = result.Feedback;
            _liquidacionesRows.Clear();
        }
        finally
        {
            _liquidacionesLoading = false;
            RecalcularTotalSeleccionado();
        }
    }

    private IReadOnlyList<CargaViajeLiquidacionGroupDto> GetLiquidacionesGroups()
    {
        var filtered = GetLiquidacionesRowsAplicandoFiltros();
        var groups = filtered
            .GroupBy(x => new
            {
                x.ChoferCodigo,
                x.EsFletero,
                Nombre = DisplayVisibleText(x.ChoferNombre)
            })
            .Select(g =>
            {
                var items = SortLiquidacionesRows(g).ToList();
                return new CargaViajeLiquidacionGroupDto
                {
                    EsFletero = g.Key.EsFletero,
                    GrupoNombre = g.Key.Nombre,
                    GrupoTipo = g.Key.EsFletero ? "Fletero" : "Chofer",
                    CantidadViajes = items.Count,
                    TotalFlete = items.Sum(x => x.TotalFlete),
                    TotalPeaje = items.Sum(x => Math.Max(0m, x.Peaje)),
                    TotalConPeaje = items.Sum(x => x.TotalConPeaje),
                    Items = items
                };
            })
            .ToList();

        return SortLiquidacionesGroups(groups);
    }

    private IReadOnlyList<CargaViajeLiquidacionRowDto> GetLiquidacionesRowsAplicandoFiltros()
        => _liquidacionesRows
            .Where(x => _liquidacionesFilters.MostrarLiquidados || !x.FletePagado)
            .ToList();

