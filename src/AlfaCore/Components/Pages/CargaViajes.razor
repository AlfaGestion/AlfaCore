    protected override void OnParametersSet()
    {
        var normalized = NormalizeSection(Vista);
        if (!string.Equals(_lastMessageSection, normalized, StringComparison.OrdinalIgnoreCase))
            ClearMessages();

        _activeSection = normalized;
        _lastMessageSection = normalized;
