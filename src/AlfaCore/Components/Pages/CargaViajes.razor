    private Task OnConfigTarifaGeneralSeleccionadaAsync(CargaViajeLookupOptionDto item)
    {
        _config.CodigoTarifaGeneral = (item.Codigo ?? string.Empty).Trim().ToUpperInvariant();
        _configTarifaGeneralTexto = FormatLookupDisplay(item.Codigo ?? string.Empty, item.Titulo);
        return Task.CompletedTask;
    }

    private async Task SyncConfigTarifaGeneralTextoAsync()
    {
        var codigo = (_config.CodigoTarifaGeneral ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(codigo))
        {
            _configTarifaGeneralTexto = string.Empty;
            return;
        }

        try
        {
            var tarifa = await CargaViajesSvc.GetTarifaByIdAsync(codigo);
