                                            <td>@DisplayText(row.DestinoDescripcion, row.DestinoCodigo)</td>
                                            <td>@DisplayText(row.TipoVehiculoDescripcion, row.TipoVehiculoCodigo)</td>
                                            <td>@row.CantidadViajes</td>
                                            <td>@row.TotalFlete.ToString("N2")</td>
                                            <td>@(row.FletePagado ? "Pagado" : "Pendiente")</td>
                                            <td>@(row.FechaPagoFlete.HasValue ? row.FechaPagoFlete.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty)</td>
                                            <td>@row.UsuarioPagoFlete</td>
                                            <td>@row.ObservacionPagoFlete</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            }
        </section>
