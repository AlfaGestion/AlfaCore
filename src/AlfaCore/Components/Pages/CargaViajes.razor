    {
        var pageActions = BuildListPageActions();
        var reporteFilterChips = BuildReporteFilterChips();
        var showReporteClearButton = reporteFilterChips.Count > 0;

        <section class="panel-card carga-viajes-section carga-viajes-section--filters">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@GetReportesHeadline()</h3>
                    <span class="panel-card__subtitle">Consulta y análisis de viajes.</span>
                </div>
            </div>

            <ModuleListToolbar AriaLabel="Herramientas de reportes"
                               ActionsAriaLabel="Acciones de reportes"
                               Actions="@pageActions"
                               Class="module-list-toolbar--reportes">
                <SearchContent>
                    <div class="smart-search carga-viajes-smart-search carga-viajes-smart-search--reportes">
                        <div class="carga-viajes-smart-search__anchor">
                            <div class="smart-search__bar carga-viajes-smart-search__bar--with-chips" @onclick="AbrirReportesAdvancedFilters">
                        <i class="bi bi-sliders carga-viajes-smart-search__search-icon"></i>
                        <div class="carga-viajes-smart-search__entry">
                            @if (reporteFilterChips.Count > 0)
                            {
                                <div class="carga-viajes-smart-search__inline-chips" aria-live="polite">
                                    @foreach (var chip in reporteFilterChips)
                                    {
                                        <button type="button"
                                                class="smart-chip carga-viajes-filter-chip"
                                                @key="chip.Key"
                                                title="@chip.Label"
                                                aria-label="@($"Quitar filtro {chip.Label}")"
                                                @onclick="() => RemoveReporteFilterChipAsync(chip.Key)"
                                                @onclick:stopPropagation="true">
                                            <span>@chip.Label</span>
                                            <i class="bi bi-x" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="carga-viajes-smart-search__trigger-text"></span>
                            }
                        </div>
                        @if (showReporteClearButton)
                        {
                            <button type="button"
                                    class="carga-viajes-clear-filters-btn"
                                    title="Limpiar filtros"
                                    aria-label="Limpiar filtros"
                                    @onclick="LimpiarFiltrosReporteAsync"
                                    @onclick:stopPropagation="true">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        }
                        <button type="button" class="smart-search__toggle" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" @onclick="ToggleReportesAdvancedFilters" aria-expanded="@_showReportesAdvancedFilters" aria-controls="carga-viajes-reportes-advanced" aria-label="Mostrar filtros avanzados">
                            <i class="bi @(_showReportesAdvancedFilters ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                        </button>
                            </div>

                    @if (_showReportesAdvancedFilters)
                    {
                        <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onmousedown="() => _showReportesAdvancedFilters = false"></button>
                        <div id="carga-viajes-reportes-advanced" class="smart-search__panel carga-viajes-smart-search__panel--reportes" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                            <div class="viajes-filter-row-v2 carga-viajes-reportes__date-row">
                                <div class="viajes-filter-field-v2 sm">
                                    <label>Rango rápido</label>
                                    <select value="@_reporteLiquidacionFilters.RangoRapido" @onchange="OnReporteRangoRapidoChangedAsync">
                                        <option value="@CargaViajesReporteRangoRapidoKeys.Hoy">Hoy</option>
                                        <option value="@CargaViajesReporteRangoRapidoKeys.SemanaActual">Semana actual</option>
                                        <option value="@CargaViajesReporteRangoRapidoKeys.MesActual">Mes actual</option>
                                        <option value="@CargaViajesReporteRangoRapidoKeys.MesAnterior">Mes anterior</option>
                                        <option value="@CargaViajesReporteRangoRapidoKeys.AnioActual">Año actual</option>
                                        <option value="@CargaViajesReporteRangoRapidoKeys.AnioAnterior">Año anterior</option>
                                        <option value="@CargaViajesReporteRangoRapidoKeys.Personalizado">Personalizado</option>
                                        <option value="@CargaViajesReporteRangoRapidoKeys.Todo">Todo</option>
                                    </select>
                                </div>
                                <div class="viajes-filter-field-v2 sm">
                                    <label>Fecha desde</label>
                                    <InputDate TValue="DateTime?" Value="_reporteLiquidacionFilters.FechaDesde" ValueChanged="OnReporteFechaDesdeChangedAsync" ValueExpression="() => _reporteLiquidacionFilters.FechaDesde" />
                                </div>
                                <div class="viajes-filter-field-v2 sm">
                                    <label>Fecha hasta</label>
                                    <InputDate TValue="DateTime?" Value="_reporteLiquidacionFilters.FechaHasta" ValueChanged="OnReporteFechaHastaChangedAsync" ValueExpression="() => _reporteLiquidacionFilters.FechaHasta" />
                                </div>
                            </div>
                            <div class="viajes-filter-row-v2">
                                <div class="viajes-filter-field-v2 lg">
                                    <label>Chofer/Fletero</label>
                                    <LookupAutocomplete Label="" Placeholder="Buscar persona..." Text="@_reporteChoferFleteroTexto" TextChanged="OnReporteChoferFleteroTextoChangedAsync" SelectedChanged="OnReporteChoferFleteroSeleccionadoAsync" SearchFunc="SearchReporteChoferFleteroLookupAsync" />
                                </div>
                                <div class="viajes-filter-field-v2 sm">
                                    <label>Estado</label>
                                    <select value="@_reporteLiquidacionFilters.Estado" @onchange="OnReporteEstadoChangedAsync">
                                        <option value="@CargaViajesReporteEstadoKeys.Todos">Todos</option>
                                        <option value="@CargaViajesReporteEstadoKeys.Pendiente">Pendiente</option>
                                        <option value="@CargaViajesReporteEstadoKeys.Finalizado">Finalizado</option>
                                        <option value="@CargaViajesReporteEstadoKeys.PendientePago">Pendiente pago</option>
                                    </select>
                                </div>
                                <div class="viajes-filter-field-v2 sm">
                                    <label>Estado pago</label>
                                    <select value="@_reporteLiquidacionFilters.EstadoPago" @onchange="OnReporteEstadoPagoChangedAsync">
                                        <option value="@CargaViajesLiquidacionEstadoPagoKeys.Todos">Todos</option>
                                        <option value="@CargaViajesLiquidacionEstadoPagoKeys.Pendientes">Pendiente</option>
                                        <option value="@CargaViajesLiquidacionEstadoPagoKeys.Pagados">Pagado</option>
                                    </select>
                                </div>
                                <div class="viajes-filter-field-v2 sm">
                                    <label>Visualización</label>
                                    <select value="@_reporteLiquidacionFilters.Modo" @onchange="OnReporteModoChangedAsync">
                                        <option value="@CargaViajesReporteModoKeys.Detallado">Detallado</option>
                                        <option value="@CargaViajesReporteModoKeys.Resumen">Resumen</option>
                                    </select>
                                </div>
                            </div>
                            <div class="viajes-filter-row-v2">
                                <div class="viajes-filter-field-v2 type">
                                    <label>Tipo</label>
                                    <div class="viajes-report-type-toggle-v2" role="group" aria-label="Tipo de persona en reportes">
                                        <button type="button" class="viajes-type-toggle-v2__button @(_reporteLiquidacionFilters.IncluirChoferes ? "viajes-type-toggle-v2__button--active" : string.Empty)" aria-pressed="@_reporteLiquidacionFilters.IncluirChoferes" @onclick="ToggleReporteChoferesAsync">
                                            <span class="viajes-type-toggle-v2__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                            <span>Choferes</span>
                                        </button>
                                        <button type="button" class="viajes-type-toggle-v2__button @(_reporteLiquidacionFilters.IncluirFleteros ? "viajes-type-toggle-v2__button--active" : string.Empty)" aria-pressed="@_reporteLiquidacionFilters.IncluirFleteros" @onclick="ToggleReporteFleterosAsync">
                                            <span class="viajes-type-toggle-v2__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                            <span>Fleteros</span>
                                        </button>
                                        <button type="button" class="viajes-type-toggle-v2__button @(_reporteLiquidacionFilters.IncluirClientes ? "viajes-type-toggle-v2__button--active" : string.Empty)" aria-pressed="@_reporteLiquidacionFilters.IncluirClientes" @onclick="ToggleReporteClientesAsync">
                                            <span class="viajes-type-toggle-v2__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                            <span>Clientes</span>
                                        </button>
                                        <button type="button" class="viajes-type-toggle-v2__button @(_reporteLiquidacionFilters.IncluirTodoJunto ? "viajes-type-toggle-v2__button--active" : string.Empty)" aria-pressed="@_reporteLiquidacionFilters.IncluirTodoJunto" @onclick="ToggleReporteTodoJuntoAsync">
                                            <span class="viajes-type-toggle-v2__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                            <span>Todo junto</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="viajes-filter-field-v2 md">
                                    <label>Agrupar por</label>
                                    <select value="@_reporteLiquidacionFilters.AgruparPor" @onchange="async args => await SetReporteAgruparPorAsync(args.Value?.ToString() ?? string.Empty)" disabled="@_reporteLiquidacionFilters.IncluirClientes" title="@(_reporteLiquidacionFilters.IncluirClientes ? "No disponible en el modo Clientes" : string.Empty)">
                                        <option value="@CargaViajesViewGroupKeys.None">Sin agrupar</option>
                                        <option value="@CargaViajesViewGroupKeys.Chofer">Chofer/Fletero</option>
                                        <option value="@CargaViajesViewGroupKeys.Cliente">Cliente</option>
                                        <option value="@CargaViajesViewGroupKeys.Destino">Destino</option>
                                        <option value="@CargaViajesViewGroupKeys.TipoVehiculo">Tipo vehículo</option>
                                        <option value="@CargaViajesViewGroupKeys.Estado">Estado</option>
                                        <option value="@CargaViajesViewGroupKeys.Usuario">Usuario</option>
                                    </select>
                                </div>
                                <div class="viajes-filter-field-v2 lg">
                                    <label>Cliente</label>
                                    <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_reporteClienteTexto" TextChanged="OnReporteClienteTextoChangedAsync" SelectedChanged="OnReporteClienteSeleccionadoAsync" SearchFunc="SearchReporteClienteLookupAsync" MinimumCharacters="0" />
                                </div>
                                <div class="viajes-filter-field-v2 lg">
                                    <label>Destino</label>
                                    <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_reporteDestinoTexto" TextChanged="OnReporteDestinoTextoChangedAsync" SelectedChanged="OnReporteDestinoSeleccionadoAsync" SearchFunc="SearchReporteDestinoLookupAsync" MinimumCharacters="0" />
                                </div>
                            </div>
                            <div class="carga-viajes-smart-search__apply-row">
                                <button type="button" class="btn btn--primary carga-viajes-smart-search__apply-btn" @onclick="BuscarReporteLiquidacionAsync" disabled="@_reportesLoading">Aplicar filtros</button>
                            </div>
                        </div>
                    }
                        </div>
                    </div>
                </SearchContent>
            </ModuleListToolbar>
        </section>

        <section class="panel-card carga-viajes-liquidaciones-panel">
            @if (_reportesLoading)
            {
                <div class="liquidacion-loading">
                    <div class="liquidacion-loading__card">
                        <i class="bi bi-arrow-repeat"></i>
                        <strong>@_reportesBusyTitle</strong>
                        <span>@_reportesBusyMessage</span>
                    </div>
                </div>
            }
            else if (!_reporteLiquidacionConsultada)
            {
                <div class="usuarios-empty">Elegí los filtros y presioná Buscar para ver el resultado.</div>
            }
            else if (_reporteLiquidacionFilters.IncluirClientes || _reporteLiquidacionFilters.IncluirTodoJunto)
            {
                @if (_reporteClienteRows.Count == 0)
                {
                    <div class="usuarios-empty">No se encontraron viajes para los filtros seleccionados.</div>
                }
                else if (_reporteLiquidacionFilters.IncluirTodoJunto)
                {
                    <div class="carga-viajes-reportes__totales">
                        <article class="carga-viajes-reportes__total-card">
                            <span>Cantidad total de viajes</span>
                            <strong>@_reporteClienteRows.Count.ToString("N0")</strong>
                        </article>
                        <article class="carga-viajes-reportes__total-card">
                            <span>Total cliente</span>
                            <strong>@FormatMoney(_reporteClienteRows.Sum(row => row.Viaje.TotalCliente))</strong>
                        </article>
                        <article class="carga-viajes-reportes__total-card">
                            <span>Total chofer/fletero</span>
                            <strong>@FormatMoney(_reporteClienteRows.Sum(row => row.Viaje.TotalFletero))</strong>
                        </article>
                        <article class="carga-viajes-reportes__total-card carga-viajes-reportes__total-card--grand">
                            <span>Saldo</span>
                            <strong>@FormatMoney(_reporteClienteRows.Sum(row => row.Viaje.TotalCliente) - _reporteClienteRows.Sum(row => row.Viaje.TotalFletero))</strong>
                        </article>
                    </div>
                }
                else
                {
                    <div class="carga-viajes-reportes__totales">
                        <article class="carga-viajes-reportes__total-card">
                            <span>Cantidad total de viajes</span>
                            <strong>@_reporteClienteRows.Count.ToString("N0")</strong>
                        </article>
                        <article class="carga-viajes-reportes__total-card">
                            <span>Total cliente</span>
                            <strong>@FormatMoney(_reporteClienteRows.Sum(row => row.Viaje.TotalCliente))</strong>
                        </article>
                        <article class="carga-viajes-reportes__total-card carga-viajes-reportes__total-card--grand">
                            <span>Total peajes</span>
                            <strong>@FormatMoney(_reporteClienteRows.Sum(row => row.Viaje.Peaje))</strong>
                        </article>
                    </div>

                    @if (IsReporteResumen())
                    {
                        <div class="usuarios-table-wrap">
                            <table class="data-table" data-sticky-list-header>
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Cliente</th>
                                        <th>Destino</th>
                                        <th>Chofer/Fletero</th>
                                        <th>Tipo vehículo</th>
                                        <th class="liquidacion-table__num">Total</th>
                                        <th class="liquidacion-table__num">Peaje</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _reporteClienteRows)
                                    {
                                        <tr>
                                            <td>@row.Viaje.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@DisplayVisibleText(row.Viaje.ClienteNombre)</td>
                                            <td>@DisplayVisibleText(row.Viaje.DestinoDescripcion)</td>
                                            <td>@DisplayVisibleText(row.Viaje.ChoferNombre)</td>
                                            <td>@DisplayVisibleText(row.Viaje.TipoVehiculoDescripcion)</td>
                                            <td class="liquidacion-table__num">@FormatMoney(row.Viaje.TotalCliente)</td>
                                            <td class="liquidacion-table__num">@(row.Viaje.Peaje > 0m ? FormatMoney(row.Viaje.Peaje) : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="usuarios-table-wrap">
                            <table class="data-table" data-sticky-list-header>
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Comprobante</th>
                                        <th>Cliente</th>
                                        <th>Destino</th>
                                        <th>Chofer/Fletero</th>
                                        <th>Tipo vehículo</th>
                                        @foreach (var columna in GetReporteClienteConceptColumns(_reporteClienteRows))
                                        {
                                            <th class="liquidacion-table__num">@columna</th>
                                        }
                                        <th class="liquidacion-table__num">Total cliente</th>
                                        <th class="liquidacion-table__num">Peaje</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _reporteClienteRows)
                                    {
                                        <tr>
                                            <td>@row.Viaje.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@row.Viaje.IdComprobante</td>
                                            <td>@DisplayVisibleText(row.Viaje.ClienteNombre)</td>
                                            <td>@DisplayVisibleText(row.Viaje.DestinoDescripcion)</td>
                                            <td>@DisplayVisibleText(row.Viaje.ChoferNombre)</td>
                                            <td>@DisplayVisibleText(row.Viaje.TipoVehiculoDescripcion)</td>
                                            @foreach (var columna in GetReporteClienteConceptColumns(_reporteClienteRows))
                                            {
                                                <td class="liquidacion-table__num">@FormatConceptoImporte(row.Conceptos, columna)</td>
                                            }
                                            <td class="liquidacion-table__num">@FormatMoney(row.Viaje.TotalCliente)</td>
                                            <td class="liquidacion-table__num">@(row.Viaje.Peaje > 0m ? FormatMoney(row.Viaje.Peaje) : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            }
            else if (GetReporteRowsAplicandoTipoPersona().Count == 0)
            {
                <div class="usuarios-empty">No se encontraron viajes para los filtros seleccionados.</div>
            }
            else
            {
                <div class="carga-viajes-reportes__totales">
                    <article class="carga-viajes-reportes__total-card">
                        <span>Cantidad total de viajes</span>
                        <strong>@GetReporteCantidadTotalViajes().ToString("N0")</strong>
                    </article>
                    <article class="carga-viajes-reportes__total-card">
                        <span>Viajes pendientes</span>
                        <strong>@GetReporteCantidadPendientes().ToString("N0")</strong>
                    </article>
                    <article class="carga-viajes-reportes__total-card">
                        <span>Viajes pagados</span>
                        <strong>@GetReporteCantidadPagados().ToString("N0")</strong>
                    </article>
                    <article class="carga-viajes-reportes__total-card">
                        <span>Total cliente</span>
                        <strong>@FormatMoney(GetReporteTotalCliente())</strong>
                    </article>
                    <article class="carga-viajes-reportes__total-card">
                        <span>Total chofer/fletero</span>
                        <strong>@FormatMoney(GetReporteTotalChoferFletero())</strong>
                    </article>
                    <article class="carga-viajes-reportes__total-card">
                        <span>Total peajes</span>
                        <strong>@FormatMoney(GetReporteTotalPeajes())</strong>
                    </article>
                    <article class="carga-viajes-reportes__total-card carga-viajes-reportes__total-card--grand">
                        <span>Resultado</span>
                        <strong>@FormatMoney(GetReporteResultadoTotal())</strong>
                    </article>
                </div>

                @if (IsReporteResumen())
                {
                    <div class="carga-viajes-reportes__sortbar">
                        <span class="carga-viajes-reportes__sortbar-label">Ordenar resumen por:</span>
                        <button type="button" class="carga-viajes-sort-pill @GetSortPillClass(_reporteSortBy, _reporteSortDescending, SortKeyTipo)" @onclick="() => SortReportesAsync(SortKeyTipo)">
                            <span>Tipo</span>
                            <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyTipo)"></i>
                        </button>
                        <button type="button" class="carga-viajes-sort-pill @GetSortPillClass(_reporteSortBy, _reporteSortDescending, SortKeyChofer)" @onclick="() => SortReportesAsync(SortKeyChofer)">
                            <span>Chofer/Fletero</span>
                            <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyChofer)"></i>
                        </button>
                        <button type="button" class="carga-viajes-sort-pill @GetSortPillClass(_reporteSortBy, _reporteSortDescending, SortKeyViajes)" @onclick="() => SortReportesAsync(SortKeyViajes)">
                            <span>Viajes</span>
                            <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyViajes)"></i>
                        </button>
                        <button type="button" class="carga-viajes-sort-pill @GetSortPillClass(_reporteSortBy, _reporteSortDescending, SortKeyTotalCliente)" @onclick="() => SortReportesAsync(SortKeyTotalCliente)">
                            <span>Total cliente</span>
                            <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyTotalCliente)"></i>
                        </button>
                        <button type="button" class="carga-viajes-sort-pill @GetSortPillClass(_reporteSortBy, _reporteSortDescending, SortKeyTotalFletero)" @onclick="() => SortReportesAsync(SortKeyTotalFletero)">
                            <span>Total chofer/fletero</span>
                            <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyTotalFletero)"></i>
                        </button>
                        <button type="button" class="carga-viajes-sort-pill @GetSortPillClass(_reporteSortBy, _reporteSortDescending, SortKeyPeaje)" @onclick="() => SortReportesAsync(SortKeyPeaje)">
                            <span>Peajes</span>
                            <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyPeaje)"></i>
                        </button>
                        <button type="button" class="carga-viajes-sort-pill @GetSortPillClass(_reporteSortBy, _reporteSortDescending, SortKeyResultado)" @onclick="() => SortReportesAsync(SortKeyResultado)">
                            <span>Resultado</span>
                            <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyResultado)"></i>
                        </button>
                    </div>
                    @if (!IsReporteAgrupado())
                    {
                        <div class="usuarios-empty">
                            Resumen general sin agrupación. Elegí un agrupador para ver tarjetas por grupo.
                        </div>
                    }
                    else
                    {
                        <div class="carga-viajes-reportes__accordion">
                            @foreach (var group in GetReporteAgrupacionesActuales())
                            {
                                var groupKey = BuildReporteGroupKey(group);
                                var expanded = IsReporteGroupExpanded(groupKey);
                                <section class="liquidacion-group-card carga-viajes-reportes__group-card">
                                    <button type="button"
                                            class="liquidacion-group-card__header carga-viajes-reportes__group-header"
                                            @onclick="() => ToggleReporteGroupDetail(groupKey)">
                                        <div class="liquidacion-group-card__eyebrow">
                                            <i class="bi @(expanded ? "bi-caret-down-fill" : "bi-caret-right-fill")"></i>
                                            <span>@group.GrupoTipo.ToUpperInvariant()</span>
                                        </div>
                                        <div>
                                            <h4>@DisplayVisibleText(group.GrupoNombre)</h4>
                                            <span class="carga-viajes-reportes__group-hint">@(expanded ? "Ocultar detalle" : "Ver detalle")</span>
                                        </div>
                                        <div class="liquidacion-group-card__stats">
                                            <span>Viajes: @group.CantidadViajes</span>
                                            <span>Pendientes: @GetReporteGrupoCantidadPendientes(group)</span>
                                            <span>Pagados: @GetReporteGrupoCantidadPagados(group)</span>
                                            <span>Total cliente: @FormatMoney(group.TotalCliente)</span>
                                            <span>Total chofer/fletero: @FormatMoney(group.TotalFletero)</span>
                                            <span>Total peajes: @FormatMoney(group.TotalPeajes)</span>
                                            <span class="liquidacion-group-card__resultado">Resultado: @FormatMoney(group.Resultado)</span>
                                        </div>
                                    </button>

                                    @if (expanded)
                                    {
                                        <div class="carga-viajes-reportes__group-detail">
                                            <div class="usuarios-table-wrap liquidacion-table-shell__table">
                                                <table class="liquidacion-table" data-sticky-list-header>
                                                    <thead>
                                                        <tr>
                                                            <th class="@GetSortThClass(_reporteSortBy, _reporteSortDescending, SortKeyFecha)">
                                                                <button type="button" class="carga-viajes-sort-button" @onclick="() => SortReportesAsync(SortKeyFecha)">
                                                                    <span>Fecha</span>
                                                                    <i class="bi @GetSortIcon(_reporteSortBy, _reporteSortDescending, SortKeyFecha)"></i>
