    private IReadOnlyList<FilterChipItem> BuildReporteFilterChips()
    {
        var chips = new List<FilterChipItem>();

        if (_reporteLiquidacionFilters.FechaDesde.HasValue || _reporteLiquidacionFilters.FechaHasta.HasValue)
            chips.Add(new FilterChipItem("reportes-fecha", $"Fecha: {FormatFilterDateRange(_reporteLiquidacionFilters.FechaDesde, _reporteLiquidacionFilters.FechaHasta)}"));
        else if (NormalizeReporteRangoRapido(_reporteLiquidacionFilters.RangoRapido) != CargaViajesReporteRangoRapidoKeys.Todo)
            AddChipIfPresent(chips, "reportes-rango", "Rango", GetReporteRangoRapidoLabel(_reporteLiquidacionFilters.RangoRapido));

        if (_reporteLiquidacionFilters.IncluirClientes
            || _reporteLiquidacionFilters.IncluirTodoJunto
            || NormalizeReporteTipoPersona(_reporteLiquidacionFilters.TipoPersona) != CargaViajesReporteTipoPersonaKeys.ChoferesYFleteros)
            AddChipIfPresent(chips, "reportes-tipo", "Tipo", GetReporteTipoPersonaLabel());

        if (NormalizeReporteEstado(_reporteLiquidacionFilters.Estado) != CargaViajesReporteEstadoKeys.Todos)
            AddChipIfPresent(chips, "reportes-estado", "Estado", GetReporteEstadoLabel(_reporteLiquidacionFilters.Estado));

        if (NormalizeReporteEstadoPago(_reporteLiquidacionFilters.EstadoPago) != CargaViajesLiquidacionEstadoPagoKeys.Todos)
            AddChipIfPresent(chips, "reportes-estado-pago", "Estado pago", GetReporteEstadoPagoLabel(_reporteLiquidacionFilters.EstadoPago));

        if (NormalizeReporteModo(_reporteLiquidacionFilters.Modo) != CargaViajesReporteModoKeys.Detallado)
            AddChipIfPresent(chips, "reportes-modo", "Modo", GetReporteModoLabel(_reporteLiquidacionFilters.Modo));

        if (NormalizeReporteGroupBy(_reporteLiquidacionFilters.AgruparPor) != CargaViajesViewGroupKeys.None)
            AddChipIfPresent(chips, "reportes-agrupar", "Agrupar por", GetReporteAgruparPorLabel(_reporteLiquidacionFilters.AgruparPor));

        AddChipIfPresent(chips, "reportes-chofer", "Chofer / Fletero", _reporteChoferFleteroTexto);
        AddChipIfPresent(chips, "reportes-cliente", "Cliente", _reporteClienteTexto);
        AddChipIfPresent(chips, "reportes-destino", "Destino", _reporteDestinoTexto);

        return chips;
    }

    private async Task RemoveReporteFilterChipAsync(string key)
    {
        switch ((key ?? string.Empty).Trim().ToLowerInvariant())
        {
            case "reportes-rango":
                ApplyReporteRangoRapido(CargaViajesReporteRangoRapidoKeys.Todo);
                break;
            case "reportes-fecha":
                _reporteLiquidacionFilters.FechaDesde = null;
                _reporteLiquidacionFilters.FechaHasta = null;
                _reporteLiquidacionFilters.RangoRapido = CargaViajesReporteRangoRapidoKeys.Todo;
                break;
            case "reportes-tipo":
                _reporteLiquidacionFilters.IncluirClientes = false;
                _reporteLiquidacionFilters.IncluirTodoJunto = false;
                ApplyReporteTipoPersona(CargaViajesReporteTipoPersonaKeys.ChoferesYFleteros);
                break;
            case "reportes-estado":
                _reporteLiquidacionFilters.Estado = CargaViajesReporteEstadoKeys.Todos;
                break;
            case "reportes-estado-pago":
                _reporteLiquidacionFilters.EstadoPago = CargaViajesLiquidacionEstadoPagoKeys.Todos;
                break;
            case "reportes-modo":
                _reporteLiquidacionFilters.Modo = CargaViajesReporteModoKeys.Detallado;
                break;
            case "reportes-agrupar":
                _reporteLiquidacionFilters.AgruparPor = CargaViajesViewGroupKeys.None;
                _reporteGruposAbiertos.Clear();
                break;
            case "reportes-chofer":
                _reporteLiquidacionFilters.ChoferCodigo = string.Empty;
                _reporteLiquidacionFilters.ChoferTexto = string.Empty;
                _reporteChoferFleteroTexto = string.Empty;
                break;
            case "reportes-cliente":
                _reporteLiquidacionFilters.ClienteCodigo = string.Empty;
                _reporteLiquidacionFilters.ClienteTexto = string.Empty;
                _reporteClienteTexto = string.Empty;
                break;
            case "reportes-destino":
                _reporteLiquidacionFilters.DestinoCodigo = string.Empty;
                _reporteLiquidacionFilters.DestinoTexto = string.Empty;
                _reporteDestinoTexto = string.Empty;
                break;
            default:
                return;
        }

        await RefreshReporteAfterFilterChipChangedAsync();
    }

    private async Task RefreshReporteAfterFilterChipChangedAsync()
    {
        if (_reporteLiquidacionConsultada)
        {
            await BuscarReporteLiquidacionAsync();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

