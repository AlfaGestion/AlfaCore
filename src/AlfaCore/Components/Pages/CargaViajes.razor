            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Sesión requerida", Message = "Necesitás iniciar sesión para guardar la configuración de vista." };
            return;
        }

        var settings = new CargaViajeTipoVehiculoViewSettingsDto { AgruparPor = _tipoVehiculoDraftAgruparPor, Columnas = CloneTipoVehiculoViewSettings(_tipoVehiculoViewSettingsDraft).Columnas };
