    private async Task AbrirDuplicarTarifaAdicionalesAsync()
    {
        if (_tarifaForm.TarifaFletero)
            return;

        var clienteCodigo = (_tarifaForm.Cliente ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(clienteCodigo))
            return;

        _showTarifaAdicionalesPropagateModal = true;
        _tarifaAdicionalesPropagateLoading = true;
        _tarifaAdicionalesPropagateFilters = new CargaViajesFilters
        {
            Cliente = clienteCodigo,
            Texto = string.Empty,
            PageNumber = 1,
            PageSize = 200,
            SortBy = "nombre",
            SortDescending = false
        };
        _tarifaAdicionalesPropagateRows.Clear();
        _tarifaAdicionalesPropagateSelected.Clear();
        await InvokeAsync(StateHasChanged);

        try
        {
            await RecargarTarifaAdicionalesPropagateAsync();
        }
        finally
        {
            _tarifaAdicionalesPropagateLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task CloseTarifaAdicionalesPropagateModalAsync()
    {
        _showTarifaAdicionalesPropagateModal = false;
        _tarifaAdicionalesPropagateLoading = false;
        _tarifaAdicionalesPropagateFilters = new CargaViajesFilters { PageNumber = 1, PageSize = 200 };
        _tarifaAdicionalesPropagateRows.Clear();
        _tarifaAdicionalesPropagateSelected.Clear();
        return Task.CompletedTask;
    }

    private async Task RecargarTarifaAdicionalesPropagateAsync()
    {
        if (!_showTarifaAdicionalesPropagateModal)
            return;

        var clienteCodigo = (_tarifaAdicionalesPropagateFilters.Cliente ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(clienteCodigo))
            clienteCodigo = (_tarifaForm.Cliente ?? string.Empty).Trim();

        _tarifaAdicionalesPropagateLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            _tarifaAdicionalesPropagateRows.Clear();
            _tarifaAdicionalesPropagateSelected.Clear();

            var filters = new CargaViajesFilters
            {
                Cliente = clienteCodigo,
                Texto = (_tarifaAdicionalesPropagateFilters.Texto ?? string.Empty).Trim(),
                PageNumber = 1,
                PageSize = 200,
                SortBy = "nombre",
                SortDescending = false
            };

            var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchTarifasAsync(filters), "No se pudieron cargar las tarifas.");
            if (!result.Success || result.Value is null)
                return;

            var currentTarifaId = _tarifaForm.Id;
            var rows = result.Value.Items
                .Where(row => !row.TarifaFletero)
                .Where(row => currentTarifaId <= 0 || row.Id != currentTarifaId)
                .ToList();

            _tarifaAdicionalesPropagateRows.AddRange(rows);
            foreach (var row in rows)
                _tarifaAdicionalesPropagateSelected.Add((row.IdLista ?? string.Empty).Trim());
        }
        finally
        {
            _tarifaAdicionalesPropagateLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ToggleTarifaAdicionalesPropagateSelectionAsync(CargaViajeTarifaGridItemDto row, ChangeEventArgs args)
    {
        var idLista = (row.IdLista ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(idLista))
            return Task.CompletedTask;

        var selected = args.Value is bool value && value;
        if (selected)
            _tarifaAdicionalesPropagateSelected.Add(idLista);
        else
            _tarifaAdicionalesPropagateSelected.Remove(idLista);

        return InvokeAsync(StateHasChanged);
    }

    private async Task AplicarTarifaAdicionalesPropagateAsync()
    {
        if (_tarifaAdicionalesPropagateLoading)
            return;

        var targetRows = _tarifaAdicionalesPropagateRows
            .Where(row => _tarifaAdicionalesPropagateSelected.Contains((row.IdLista ?? string.Empty).Trim()))
            .ToList();

        if (targetRows.Count == 0)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Sin listas seleccionadas",
                Message = "Seleccioná al menos una lista para aplicar los adicionales."
            };
            return;
        }

        _tarifaAdicionalesPropagateLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
        var clienteCodigo = (_tarifaAdicionalesPropagateFilters.Cliente ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(clienteCodigo))
            clienteCodigo = (_tarifaForm.Cliente ?? string.Empty).Trim();
        var listasSeleccionadas = targetRows
            .Select(row => (row.IdLista ?? string.Empty).Trim())
            .Where(lista => !string.IsNullOrWhiteSpace(lista))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

            var saveResult = await UiOps.RunAsync(
                () => CargaViajesSvc.ActualizarAdicionalesTarifasClienteAsync(clienteCodigo, listasSeleccionadas, _tarifaForm),
                "No se pudieron actualizar los adicionales en las tarifas seleccionadas.");

            if (!saveResult.Success)
            {
                _feedback = saveResult.Feedback;
                return;
            }

            SetSuccessFeedback("Adicionales actualizados", "Los adicionales se copiaron en las tarifas seleccionadas.");
            await CloseTarifaAdicionalesPropagateModalAsync();
            await RecargarTarifasAsync();
        }
        finally
        {
            _tarifaAdicionalesPropagateLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

