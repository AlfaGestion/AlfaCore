    private async Task EnsureViewSettingsLoadedAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (_viewSettingsLoaded && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            _viewSettings = BuildDefaultViewSettings();
            _viewSettingsDraft = BuildDefaultViewSettings();
            _viewSettingsUserName = currentUser;
            _viewSettingsLoaded = true;
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetViewSettingsAsync(currentUser), "No se pudo cargar la configuración de vista.");
        _viewSettings = result.Success && result.Value is not null ? result.Value : BuildDefaultViewSettings();
        _viewSettingsDraft = CloneViewSettings(_viewSettings);
        _draftAgruparPor = _viewSettings.AgruparPor;
        _viewSettingsUserName = currentUser;
        _viewSettingsLoaded = true;
    }

    private async Task EnsureTipoVehiculoSchemaLoadedAsync()
