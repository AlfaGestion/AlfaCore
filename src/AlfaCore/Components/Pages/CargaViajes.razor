    private string GetTarifaListaCodigo()
    {
        var codigoBase = _tarifaForm.TarifaFletero ? _tarifaForm.Chofer : _tarifaForm.Cliente;
        var normalized = (codigoBase ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized))
            return _tarifaForm.IdLista.Trim().ToUpperInvariant();

        if (normalized.Length <= 4)
            return normalized.PadLeft(4, '0').ToUpperInvariant();

        return normalized[^4..].ToUpperInvariant();
    }

    private static string BuildLookupDisplayText(CargaViajeLookupOptionDto item)
    {
        var title = (item.Titulo ?? string.Empty).Trim();
        var code = (item.Codigo ?? string.Empty).Trim();
        return string.IsNullOrWhiteSpace(title) ? code : title;
    }

    private static string BuildListaDesdeCodigo(string codigo)
    {
        var value = (codigo ?? string.Empty).Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return value.Length <= 4
            ? value.PadLeft(4, '0')
            : value[^4..];
    }

    private static string GetTarifaImporteInputId(int id) => $"tarifa-importe-{id}";

    private async Task ActivarEdicionRapidaTarifaAsync(CargaViajeTarifaGridItemDto row, int index)
    {
        if (!_tarifasQuickImportEditMode || row.Id <= 0)
            return;

        _tarifasQuickImportEditId = row.Id;
        _tarifasQuickImportRowIndex = index;
        _tarifasQuickImportValue = row.Importe;
        _tarifasQuickImportOriginal = row.Importe.ToString(System.Globalization.CultureInfo.InvariantCulture);
        await InvokeAsync(StateHasChanged);
        await FocusTarifaImporteInputAsync(row.Id);
    }

    private async Task FocusTarifaImporteInputAsync(int id)
    {
        var inputId = GetTarifaImporteInputId(id);
        await Js.InvokeVoidAsync("eval", $"(function(){{var e=document.getElementById('{inputId}'); if(e){{ e.focus(); e.select(); }}}})();");
    }

    private async Task SelectTarifaImporteAsync(int id)
    {
        var inputId = GetTarifaImporteInputId(id);
        await Js.InvokeVoidAsync("eval", $"(function(){{var e=document.getElementById('{inputId}'); if(e){{ e.focus(); e.select(); }}}})();");
    }

    private async Task HandleTarifaImporteKeyDownAsync(KeyboardEventArgs args, CargaViajeTarifaGridItemDto row, int index)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            if (decimal.TryParse(_tarifasQuickImportOriginal, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var original))
                _tarifasQuickImportValue = original;
            else
                _tarifasQuickImportValue = row.Importe;

            _tarifasQuickImportEditId = 0;
            _tarifasQuickImportRowIndex = -1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return;

        await GuardarImporteRapidoTarifaAsync(row, index);
    }

    private async Task GuardarImporteRapidoTarifaAsync(CargaViajeTarifaGridItemDto row, int index)
    {
        try
        {
            await CargaViajesSvc.ActualizarTarifaImporteAsync(row.Id, row.IdLista, _tarifasQuickImportValue);
        }
        catch (Exception ex)
        {
            _feedback = UiOps.BuildMessage(ex, "No se pudo actualizar el importe de la tarifa.");
            await FocusTarifaImporteInputAsync(row.Id);
            return;
        }

        row.Importe = _tarifasQuickImportValue;
        SetSuccessFeedback("Importe actualizado", "La tarifa quedó actualizada.");

        var nextIndex = index + 1;
        if (nextIndex >= _tarifas.Count)
        {
            _tarifasQuickImportEditId = 0;
            _tarifasQuickImportRowIndex = -1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var nextRow = _tarifas[nextIndex];
        if (nextRow.Id <= 0)
        {
            _tarifasQuickImportEditId = 0;
            _tarifasQuickImportRowIndex = -1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _tarifasQuickImportEditId = nextRow.Id;
        _tarifasQuickImportRowIndex = nextIndex;
        _tarifasQuickImportValue = nextRow.Importe;
        await InvokeAsync(StateHasChanged);
        await FocusTarifaImporteInputAsync(nextRow.Id);
    }

