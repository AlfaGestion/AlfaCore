    private async Task RecargarTarifasAumentoAsync()
    {
        _tarifasAumentoLoading = true;
        _tarifasAumentoFilters.PageSize = 100;
        var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchTarifasAsync(_tarifasAumentoFilters), "No se pudieron cargar las tarifas.");
        if (result.Success && result.Value is not null)
        {
            _tarifasAumento.Clear();
            _tarifasAumento.AddRange(result.Value.Items);
            _tarifasAumentoSeleccionadas.RemoveWhere(id => _tarifasAumento.All(row => row.Id != id));
        }
        else
        {
            _feedback = result.Feedback;
        }

        _tarifasAumentoSimulada = false;
        _tarifasAumentoLoading = false;
    }

