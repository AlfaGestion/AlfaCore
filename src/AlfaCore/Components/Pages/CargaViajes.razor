                            <div class="field">
                                <label>Agrupar por</label>
                                <select @bind="_tipoVehiculoDraftAgruparPor">
                                    <option value="@CargaViajeTipoVehiculoViewGroupKeys.None">Sin agrupar</option>
                                    @if (_tipoVehiculosHasActivo)
