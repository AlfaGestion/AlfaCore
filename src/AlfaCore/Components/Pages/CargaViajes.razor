    private void ApplyViajeDefaultPercents(CargaViajeSaveRequest form)
    {
        if (GetConfigAdicionalHabilitado(0)) form.PorcentajeAdic = ResolvePercentOrDefault(form.PorcentajeAdic, 0);
        else form.PorcentajeAdic = 0m;

        if (GetConfigAdicionalHabilitado(1)) form.PorcentajeAdic1 = ResolvePercentOrDefault(form.PorcentajeAdic1, 1);
        else form.PorcentajeAdic1 = 0m;

        if (GetConfigAdicionalHabilitado(2)) form.PorcentajeAdic2 = ResolvePercentOrDefault(form.PorcentajeAdic2, 2);
        else form.PorcentajeAdic2 = 0m;

        if (GetConfigAdicionalHabilitado(3)) form.PorcentajeAdic3 = ResolvePercentOrDefault(form.PorcentajeAdic3, 3);
        else form.PorcentajeAdic3 = 0m;

        if (GetConfigAdicionalHabilitado(4)) form.PorcentajeAdic4 = ResolvePercentOrDefault(form.PorcentajeAdic4, 4);
        else form.PorcentajeAdic4 = 0m;

        if (GetConfigAdicionalHabilitado(5)) form.PorcentajeAdic5 = ResolvePercentOrDefault(form.PorcentajeAdic5, 5);
        else form.PorcentajeAdic5 = 0m;
    }

