    private async Task HandleTarifaImporteKeyDownAsync(KeyboardEventArgs args, CargaViajeTarifaGridItemDto row, int index)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            if (decimal.TryParse(_tarifasQuickImportOriginal, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var original))
                _tarifasQuickImportValue = original;
            else
                _tarifasQuickImportValue = row.Importe;

            _tarifasQuickImportEditId = 0;
            _tarifasQuickImportRowIndex = -1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return;

        await GuardarImporteRapidoTarifaAsync(row, index);
    }

    private async Task GuardarImporteRapidoTarifaAsync(CargaViajeTarifaGridItemDto row, int index)
    {
        try
        {
            await CargaViajesSvc.ActualizarTarifaImporteAsync(row.Id, row.IdLista, _tarifasQuickImportValue);
        }
        catch (Exception ex)
        {
            _feedback = UiOps.BuildMessage(ex, "No se pudo actualizar el importe de la tarifa.");
            await FocusTarifaImporteInputAsync(row.Id);
            return;
        }

        row.Importe = _tarifasQuickImportValue;
        SetSuccessFeedback("Importe actualizado", "La tarifa quedó actualizada.");

        var nextIndex = index + 1;
        if (nextIndex >= _tarifas.Count)
        {
            _tarifasQuickImportEditId = 0;
            _tarifasQuickImportRowIndex = -1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var nextRow = _tarifas[nextIndex];
        if (nextRow.Id <= 0)
        {
            _tarifasQuickImportEditId = 0;
            _tarifasQuickImportRowIndex = -1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _tarifasQuickImportEditId = nextRow.Id;
        _tarifasQuickImportRowIndex = nextIndex;
        _tarifasQuickImportValue = nextRow.Importe;
        await InvokeAsync(StateHasChanged);
        await FocusTarifaImporteInputAsync(nextRow.Id);
    }

