    private async Task ActualizarTarifaClienteAsync()
    {
        if (_viajeListaManualOverride)
            return;

        var preserveAdicionalesEdicion = !_isNewViaje;

        if (string.IsNullOrWhiteSpace(_viajeForm.Cliente) || string.IsNullOrWhiteSpace(_viajeForm.Destino) || string.IsNullOrWhiteSpace(_viajeForm.TipoVehiculo))
        {
            _viajeForm.ImporteCliente = 0m;
            SyncViajeMoneyTexts();
            if (!preserveAdicionalesEdicion)
            {
                ResetVisibleAdicionalesGenerales();
                _viajeForm.AdicionalFijo1Descripcion = string.Empty;
                _viajeForm.AdicionalFijo1Importe = 0m;
                _viajeForm.AdicionalFijo1Aplicado = false;
                _viajeForm.AdicionalFijo1Cantidad = 1m;
                _viajeForm.AdicionalFijo2Descripcion = string.Empty;
                _viajeForm.AdicionalFijo2Importe = 0m;
                _viajeForm.AdicionalFijo2Aplicado = false;
                _viajeForm.AdicionalFijo2Cantidad = 1m;
                _viajeForm.AdicionalFijo3Descripcion = string.Empty;
                _viajeForm.AdicionalFijo3Importe = 0m;
                _viajeForm.AdicionalFijo3Aplicado = false;
                _viajeForm.AdicionalFijo3Cantidad = 1m;
                _viajeForm.TotalAdicionalesFijos = 0m;
            }
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetTarifaClienteAsync(_viajeForm.Cliente, _viajeForm.Destino, _viajeForm.TipoVehiculo), "No se pudo calcular la tarifa cliente.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        var tarifa = result.Value;
        if (tarifa is null)
        {
            _viajeForm.ImporteCliente = 0m;
            SyncViajeMoneyTexts();
            if (!preserveAdicionalesEdicion)
            {
                ResetVisibleAdicionalesGenerales();
                _viajeForm.AdicionalFijo1Descripcion = string.Empty;
                _viajeForm.AdicionalFijo1Importe = 0m;
                _viajeForm.AdicionalFijo1Aplicado = false;
                _viajeForm.AdicionalFijo1PideCantidad = false;
                _viajeForm.AdicionalFijo2Descripcion = string.Empty;
                _viajeForm.AdicionalFijo2Importe = 0m;
                _viajeForm.AdicionalFijo2Aplicado = false;
                _viajeForm.AdicionalFijo2PideCantidad = false;
                _viajeForm.AdicionalFijo3Descripcion = string.Empty;
                _viajeForm.AdicionalFijo3Importe = 0m;
                _viajeForm.AdicionalFijo3Aplicado = false;
                _viajeForm.AdicionalFijo3PideCantidad = false;
                _viajeForm.TotalAdicionalesFijos = 0m;
            }
            return;
        }

        _viajeForm.Lista = tarifa.IdLista;
        _viajeForm.ListaDisplay = FormatListaDisplay(tarifa.IdLista, tarifa.Nombre);
        _viajeListaTexto = _viajeForm.ListaDisplay;
        _viajeForm.ImporteCliente = tarifa.Importe;
        SyncViajeMoneyTexts();
        if (!preserveAdicionalesEdicion)
        {
            ApplyVisibleAdicionalesGeneralesFromTarifa(tarifa);
            _viajeForm.AdicionalFijo1Descripcion = tarifa.AdicionalFijo1Descripcion;
            _viajeForm.AdicionalFijo1Importe = tarifa.AdicionalFijo1Importe;
            _viajeForm.AdicionalFijo1PideCantidad = tarifa.AdicionalFijo1PideCantidad;
            _viajeForm.AdicionalFijo1Cantidad = 1m;
            _viajeForm.AdicionalFijo2Descripcion = tarifa.AdicionalFijo2Descripcion;
            _viajeForm.AdicionalFijo2Importe = tarifa.AdicionalFijo2Importe;
            _viajeForm.AdicionalFijo2PideCantidad = tarifa.AdicionalFijo2PideCantidad;
            _viajeForm.AdicionalFijo2Cantidad = 1m;
            _viajeForm.AdicionalFijo3Descripcion = tarifa.AdicionalFijo3Descripcion;
            _viajeForm.AdicionalFijo3Importe = tarifa.AdicionalFijo3Importe;
            _viajeForm.AdicionalFijo3PideCantidad = tarifa.AdicionalFijo3PideCantidad;
            _viajeForm.AdicionalFijo3Cantidad = 1m;
            _viajeForm.AdicionalFijo1Aplicado = false;
            _viajeForm.AdicionalFijo2Aplicado = false;
            _viajeForm.AdicionalFijo3Aplicado = false;
            SyncViajeAdicionalesFijosFromForm();
        }
        else
        {
            SyncViajeAdicionalesFromForm();
            SyncViajeAdicionalesFijosFromForm();
        }
    }

    private async Task ActualizarTarifaFleteroAsync(bool allowManualOverride = false)
    {
        if (_viajeListaManualOverride && !allowManualOverride)
            return;

        if (string.IsNullOrWhiteSpace(_viajeForm.Chofer) || string.IsNullOrWhiteSpace(_viajeForm.Destino) || string.IsNullOrWhiteSpace(_viajeForm.TipoVehiculo))
        {
            _viajeForm.ImporteFletero = 0m;
            _viajeForm.AdicionalFijo1ImporteFletero = 0m;
            _viajeForm.AdicionalFijo2ImporteFletero = 0m;
            _viajeForm.AdicionalFijo3ImporteFletero = 0m;
            SyncViajeMoneyTexts();
            return;
        }

        var esFletero = await IsViajeChoferFleteroAsync(_viajeForm.Chofer);
        if (!esFletero)
        {
            _viajeForm.ImporteFletero = 0m;
            _viajeForm.AdicionalFijo1ImporteFletero = 0m;
            _viajeForm.AdicionalFijo2ImporteFletero = 0m;
            _viajeForm.AdicionalFijo3ImporteFletero = 0m;
            SyncViajeMoneyTexts();
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetTarifaFleteroDetalleAsync(_viajeForm.Chofer, _viajeForm.Destino, _viajeForm.TipoVehiculo), "No se pudo calcular la tarifa fletero.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _viajeForm.ImporteFletero = result.Value?.Importe ?? 0m;
        _viajeForm.AdicionalFijo1ImporteFletero = result.Value?.AdicionalFijo1Importe ?? 0m;
        _viajeForm.AdicionalFijo2ImporteFletero = result.Value?.AdicionalFijo2Importe ?? 0m;
        _viajeForm.AdicionalFijo3ImporteFletero = result.Value?.AdicionalFijo3Importe ?? 0m;
        SyncViajeMoneyTexts();
    }

