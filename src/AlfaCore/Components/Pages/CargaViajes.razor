        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Fecha desde obligatoria", Message = "Debe ingresar una fecha desde." };
            return false;
        }

        if (_liquidacionesFilters.FechaHasta is null)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Fecha hasta obligatoria", Message = "Debe ingresar una fecha hasta." };
            return false;
        }

        if (_liquidacionesFilters.FechaHasta.Value.Date < _liquidacionesFilters.FechaDesde.Value.Date)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Rango inválido", Message = "La fecha hasta no puede ser menor que la fecha desde." };
            return false;
        }

        if (!_liquidacionesFilters.IncluirChoferes && !_liquidacionesFilters.IncluirFleteros)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Seleccione tipo de liquidación", Message = "Seleccione Choferes, Fleteros o ambos." };
            return false;
        }

        return true;
    }

    private bool ValidateLiquidacionesMarcado()
    {
