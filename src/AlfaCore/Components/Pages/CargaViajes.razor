    private IReadOnlyList<CargaViajeReporteLiquidacionRowDto> GetReporteRowsAplicandoTipoPersona()
    {
        IEnumerable<CargaViajeReporteLiquidacionRowDto> rows = _reporteLiquidacionRows;
        if (!_reporteLiquidacionFilters.IncluirChoferes)
            rows = rows.Where(x => x.EsFletero);
        if (!_reporteLiquidacionFilters.IncluirFleteros)
            rows = rows.Where(x => !x.EsFletero);
        rows = ApplyReporteEstadoPagoFilter(rows);

        return rows.ToList();
    }

    private IEnumerable<CargaViajeReporteLiquidacionRowDto> ApplyReporteEstadoPagoFilter(IEnumerable<CargaViajeReporteLiquidacionRowDto> rows)
        => NormalizeReporteEstadoPago(_reporteLiquidacionFilters.EstadoPago) switch
        {
            CargaViajesLiquidacionEstadoPagoKeys.Pendientes => rows.Where(x => !x.FletePagado),
            CargaViajesLiquidacionEstadoPagoKeys.Pagados => rows.Where(x => x.FletePagado),
            _ => rows
        };

    private int GetReporteCantidadTotalViajes()
        => GetReporteRowsAplicandoTipoPersona().Sum(x => Math.Max(1, x.CantidadViajes));

    private int GetReporteCantidadPendientes()
        => GetReporteRowsAplicandoTipoPersona().Where(x => !x.FletePagado).Sum(x => Math.Max(1, x.CantidadViajes));

    private int GetReporteCantidadPagados()
        => GetReporteRowsAplicandoTipoPersona().Where(x => x.FletePagado).Sum(x => Math.Max(1, x.CantidadViajes));

    private static int GetReporteGrupoCantidadPendientes(CargaViajesAgrupacionDto<CargaViajeReporteLiquidacionRowDto> group)
        => group.DetalleViajes.Where(x => !x.FletePagado).Sum(x => Math.Max(1, x.CantidadViajes));

    private static int GetReporteGrupoCantidadPagados(CargaViajesAgrupacionDto<CargaViajeReporteLiquidacionRowDto> group)
        => group.DetalleViajes.Where(x => x.FletePagado).Sum(x => Math.Max(1, x.CantidadViajes));

    private decimal GetReporteTotalCliente()
        => GetReporteRowsAplicandoTipoPersona().Sum(x => x.TotalConPeaje);

    private decimal GetReporteTotalChoferFletero()
        => GetReporteRowsAplicandoTipoPersona().Sum(x => x.TotalFlete);

    private decimal GetReporteTotalPeajes()
