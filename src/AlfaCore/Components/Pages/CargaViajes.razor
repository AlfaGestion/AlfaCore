    private string GetTarifasBulkPreviewText()
        => _tarifasAumentoMode switch
        {
            TarifasBulkModeIncreasePercent => $"Aumentar {_tarifasAumentoValue:N2} %",
            TarifasBulkModeDecreasePercent => $"Disminuir {_tarifasAumentoValue:N2} %",
            TarifasBulkModeAddFixed => $"Sumar {FormatMoney(_tarifasAumentoValue)}",
            TarifasBulkModeSubtractFixed => $"Restar {FormatMoney(_tarifasAumentoValue)}",
            _ => string.Empty
        };

    private decimal GetTarifaAumentoImporteSimulado(CargaViajeTarifaGridItemDto row)
    {
        if (!_tarifasAumentoSimulada || row.Id <= 0 || !_tarifasAumentoSeleccionadas.Contains(row.Id))
            return row.Importe;

        var current = row.Importe;
        var next = _tarifasAumentoMode switch
        {
            TarifasBulkModeIncreasePercent => current * (1m + (_tarifasAumentoValue / 100m)),
            TarifasBulkModeDecreasePercent => current * (1m - (_tarifasAumentoValue / 100m)),
            TarifasBulkModeAddFixed => current + _tarifasAumentoValue,
            TarifasBulkModeSubtractFixed => current - _tarifasAumentoValue,
            _ => current
        };

        return next < 0m ? 0m : next;
    }

    private decimal GetTarifaAumentoDiferencia(CargaViajeTarifaGridItemDto row)
        => GetTarifaAumentoImporteSimulado(row) - row.Importe;

    private IEnumerable<CargaViajeTarifaGridItemDto> GetTarifasAumentoFiltradas()
    {
        if (string.IsNullOrWhiteSpace(_tarifasAumentoBusqueda))
            return _tarifasAumento;

        var search = _tarifasAumentoBusqueda.Trim();
        return _tarifasAumento.Where(row =>
            ContainsTarifaAumentoSearch(row.IdLista, search) ||
            ContainsTarifaAumentoSearch(GetTarifaEntidadDisplay(row), search) ||
            ContainsTarifaAumentoSearch(ExtractVisibleText(row.Destino), search) ||
            ContainsTarifaAumentoSearch(ExtractVisibleText(row.TipoVehiculo), search) ||
            ContainsTarifaAumentoSearch(FormatTarifaUltimaModificacion(row), search));
    }

    private static bool ContainsTarifaAumentoSearch(string? source, string search)
        => !string.IsNullOrWhiteSpace(source) && source.Contains(search, StringComparison.OrdinalIgnoreCase);

