    private bool ValidateReporteLiquidacion()
    {
        if (_reporteLiquidacionFilters.FechaDesde.HasValue && _reporteLiquidacionFilters.FechaHasta.HasValue
            && _reporteLiquidacionFilters.FechaHasta.Value.Date < _reporteLiquidacionFilters.FechaDesde.Value.Date)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Rango inválido", Message = "La fecha hasta no puede ser menor que la fecha desde." };
            return false;
        }

        return true;
    }

