@page "/carga-viajes"
@page "/carga-viajes/{Vista}"
@using AlfaCore.Models
@using AlfaCore.Services
@inject ICargaViajesService CargaViajesSvc
@inject IAppUiOperationService UiOps
@inject IAppUserSessionService AppUserSession
@inject NavigationManager Nav

<PageTitle>Carga de Viajes | Alfa Gestión</PageTitle>

<div class="page-grid" @onclick="HandlePageClickAsync">
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">Carga de Viajes</h2>
            <p class="page-intro__text">Administrá viajes, tarifas, choferes y destinos desde un único módulo operativo.</p>
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </section>
    }

    @if (_activeSection == SectionViajes)
    {
        <section class="panel-card filters-card" @onkeydown="HandleViajesFilterKeyDownAsync">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Filtros de viajes</h3>
                    <p class="panel-card__subtitle">Usá el mismo patrón de filtros globales del resto del sistema para acotar el listado.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="AbrirNuevoViajeAsync">Nuevo viaje</button>
                    <button type="button" class="btn btn--ghost" @onclick="AbrirConfiguracionVista">Configurar vista</button>
                </div>
            </div>

            <div class="filters-grid filters-grid--wide">
                <div class="field">
                    <label>Fecha desde</label>
                    <InputDate @bind-Value="_viajesFilters.FechaDesde" />
                </div>
                <div class="field">
                    <label>Fecha hasta</label>
                    <InputDate @bind-Value="_viajesFilters.FechaHasta" />
                </div>
                <div class="field">
                    <label>Cliente</label>
                    <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_clienteFiltroTexto" TextChanged="OnClienteFiltroTextoChangedAsync" SelectedChanged="OnClienteSeleccionadoAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" />
                </div>
                <div class="field">
                    <label>Chofer</label>
                    <LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_choferFiltroTexto" TextChanged="OnChoferFiltroTextoChangedAsync" SelectedChanged="OnChoferSeleccionadoAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" />
                </div>
                <div class="field">
                    <label>Destino</label>
                    <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_destinoFiltroTexto" TextChanged="OnDestinoFiltroTextoChangedAsync" SelectedChanged="OnDestinoSeleccionadoAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" />
                </div>
                <div class="field">
                    <label>Estado</label>
                    <select @bind="_viajesFilters.Estado">
                        <option value="">Todos</option>
                        @foreach (var estado in _lookups.Estados)
                        {
                            <option value="@estado">@estado</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Usuario</label>
                    <input type="text" @bind="_viajesFilters.Usuario" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label>Id comprobante</label>
                    <input type="text" @bind="_viajesFilters.IdComprobante" @bind:event="oninput" />
                </div>
            </div>

            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="AplicarFiltrosViajesAsync" disabled="@_viajesLoading">Aplicar filtros</button>
                <button type="button" class="btn btn--ghost" @onclick="LimpiarFiltrosViajesAsync" disabled="@_viajesLoading">Limpiar</button>
            </div>
        </section>

        @if (_showViewSettings)
        {
            <div class="drawer-overlay" @onclick="CancelarConfiguracionVista"></div>
            <section class="drawer carga-viajes-drawer carga-viajes-drawer--wide" @onclick:stopPropagation="true">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Configuración de vista</h3>
                        <p class="panel-card__subtitle">Activá columnas, reordenalas y elegí agrupación por estado o usuario.</p>
                    </div>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="CancelarConfiguracionVista">Cerrar</button>
                </div>

                <div class="usuarios-view-settings">
                    <div class="field">
                        <label>Agrupar por</label>
                        <select @bind="_draftAgruparPor">
                            <option value="@CargaViajesViewGroupKeys.None">Sin agrupar</option>
                            <option value="@CargaViajesViewGroupKeys.Estado">Estado</option>
                            <option value="@CargaViajesViewGroupKeys.Usuario">Usuario</option>
                        </select>
                    </div>

                    <div class="usuarios-view-settings__list">
                        @foreach (var column in _viewSettingsDraft.Columnas.OrderBy(c => c.Order))
                        {
                            <div class="usuarios-view-settings__item">
                                <label class="checkbox">
                                    <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleViewColumn(column.Key, args)" />
                                    <span>@column.Label</span>
                                </label>
                                <div class="actions">
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, -1)">↑</button>
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveViewColumn(column.Key, 1)">↓</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="actions">
                        <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionVistaAsync">Guardar vista</button>
                        <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionVista">Cancelar</button>
                    </div>
                </div>
            </section>
        }

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Viajes</h3>
                    <p class="panel-card__subtitle">@_viajesTotal registro(s) · Página @_viajesPage de @_viajesTotalPages</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="RecargarViajesAsync" disabled="@_viajesLoading">Recargar</button>
                </div>
            </div>

            @if (_viajesLoading)
            {
                <div class="usuarios-empty">Cargando viajes...</div>
            }
            else if (_viajes.Count == 0)
            {
                <div class="usuarios-empty">No hay viajes para los filtros seleccionados.</div>
            }
            else
            {
                var visibleColumns = GetVisibleColumns();
                var groups = BuildViajeGroups();
                <div class="usuarios-table-wrap">
                    <table class="data-table usuarios-table">
                        <thead>
                            <tr>
                                @foreach (var column in visibleColumns)
                                {
                                    <th>@column.Label</th>
                                }
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        @foreach (var group in groups)
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="usuarios-group-row">
                                        <td colspan="@(visibleColumns.Count + 1)">@group.Label</td>
                                    </tr>
                                }
                                @foreach (var row in group.Items)
                                {
                                    <tr class="data-grid__row">
                                        @foreach (var col in visibleColumns)
                                        {
                                            <td>@RenderViajeColumn(row, col.Key)</td>
                                        }
                                        <td>
                                            <div class="actions">
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => VerViajeAsync(row.Id)">Ver</button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarViajeAsync(row.Id)">Editar</button>
                                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => AnularViajeAsync(row.Id)">Anular</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
            }

            <div class="result-pagination">
                <div class="result-pagination__info">Total: @_viajesTotal</div>
                <div class="result-pagination__controls">
                    <button class="result-pagination__btn" @onclick="() => CambiarPaginaViajesAsync(_viajesPage - 1)" disabled="@(_viajesPage <= 1)">Anterior</button>
                    <button class="result-pagination__btn" @onclick="() => CambiarPaginaViajesAsync(_viajesPage + 1)" disabled="@(_viajesPage >= _viajesTotalPages)">Siguiente</button>
                </div>
            </div>
        </section>
    }
    else if (_activeSection == SectionTarifas)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Tarifas</h3>
                    <p class="panel-card__subtitle">ABM sobre TA_TARIFA con baja lógica y tarifas cliente/fletero.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="NuevaTarifaAsync">Nueva tarifa</button>
                    <button type="button" class="btn btn--ghost" @onclick="RecargarTarifasAsync">Recargar</button>
                </div>
            </div>

            <div class="carga-viajes-filters-grid">
                <div class="field field--wide">
                    <label>Búsqueda general</label>
                    <input type="search" @bind="_tarifasFilters.Texto" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label>Cliente</label>
                    <LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_tarifasFilters.Cliente" TextChanged="OnTarifaClienteFiltroChangedAsync" SelectedChanged="OnTarifaClienteFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" />
                </div>
                <div class="field">
                    <label>Chofer</label>
                    <LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_tarifasFilters.Chofer" TextChanged="OnTarifaChoferFiltroChangedAsync" SelectedChanged="OnTarifaChoferFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" />
                </div>
                <div class="field">
                    <label>Destino</label>
                    <LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_tarifasFilters.Destino" TextChanged="OnTarifaDestinoFiltroChangedAsync" SelectedChanged="OnTarifaDestinoFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" />
                </div>
                <div class="field">
                    <label>Tipo vehículo</label>
                    <LookupAutocomplete Label="" Placeholder="Buscar tipo..." Text="@_tarifasFilters.TipoVehiculo" TextChanged="OnTarifaTipoVehiculoFiltroChangedAsync" SelectedChanged="OnTarifaTipoVehiculoFiltroSelectedAsync" SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" />
                </div>
                <div class="field">
                    <label>Tarifa fletero</label>
                    <select @bind="_tarifasFilters.TarifaFletero">
                        <option value="">Todas</option>
                        <option value="0">Cliente</option>
                        <option value="1">Fletero</option>
                    </select>
                </div>
                <div class="field">
                    <label>Activo</label>
                    <select @bind="_tarifasFilters.Activo">
                        <option value="">Todos</option>
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
            </div>

            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="AplicarFiltrosTarifasAsync">Aplicar</button>
                <button type="button" class="btn btn--ghost" @onclick="LimpiarFiltrosTarifasAsync">Limpiar</button>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Listado de tarifas</h3>
                    <p class="panel-card__subtitle">@_tarifasTotal registro(s)</p>
                </div>
            </div>
            @if (_tarifasLoading)
            {
                <div class="usuarios-empty">Cargando tarifas...</div>
            }
            else if (_tarifas.Count == 0)
            {
                <div class="usuarios-empty">Sin tarifas para mostrar.</div>
            }
            else
            {
                <div class="usuarios-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>IdLista</th><th>Nombre</th><th>Importe</th><th>Cliente</th><th>Chofer</th><th>Destino</th><th>Tipo Vehículo</th><th>Activo</th><th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _tarifas)
                            {
                                <tr>
                                    <td>@row.IdLista</td>
                                    <td>@row.Nombre</td>
                                    <td>@row.Importe.ToString("N2")</td>
                                    <td>@row.Cliente</td>
                                    <td>@row.Chofer</td>
                                    <td>@row.Destino</td>
                                    <td>@row.TipoVehiculo</td>
                                    <td>@(row.Activo ? "Sí" : "No")</td>
                                    <td>
                                        <div class="actions">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarTarifaAsync(row.IdLista)">Editar</button>
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => BajaTarifaAsync(row.IdLista)">Baja</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (_showTarifaEditor)
        {
            <div class="drawer-overlay" @onclick="CerrarTarifaEditorAsync"></div>
            <section class="drawer carga-viajes-drawer" @onclick:stopPropagation="true">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">@(_isNewTarifa ? "Nueva tarifa" : $"Editar tarifa {_tarifaForm.IdLista}")</h3>
                        <p class="panel-card__subtitle">Configurá precio, origen de tarifa y adicionales.</p>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn--ghost" @onclick="CerrarTarifaEditorAsync">Cerrar</button>
                    </div>
                </div>
                <div class="filters-grid filters-grid--wide">
                    <div class="field"><label>IdLista</label><input type="text" @bind="_tarifaForm.IdLista" disabled="@(!_isNewTarifa)" /></div>
                    <div class="field"><label>Nombre</label><input type="text" @bind="_tarifaForm.Nombre" /></div>
                    <div class="field"><label>Importe</label><input type="number" step="0.01" @bind="_tarifaForm.Importe" /></div>
                    <div class="field"><label>Cliente</label><input type="text" @bind="_tarifaForm.Cliente" /></div>
                    <div class="field"><label>Chofer</label><input type="text" @bind="_tarifaForm.Chofer" /></div>
                    <div class="field"><label>Destino</label><input type="text" @bind="_tarifaForm.Destino" /></div>
                    <div class="field"><label>Tipo vehículo</label><input type="text" @bind="_tarifaForm.TipoVehiculo" /></div>
                    <div class="field"><label>Tarifa fletero</label><select @bind="_tarifaForm.TarifaFletero"><option value="false">Tarifa cliente</option><option value="true">Tarifa chofer/fletero</option></select></div>
                    <div class="field"><label>PorcentajeAdic</label><input type="number" step="0.01" @bind="_tarifaForm.PorcentajeAdic" /></div>
                    <div class="field"><label>PorcentajeAdic1</label><input type="number" step="0.01" @bind="_tarifaForm.PorcentajeAdic1" /></div>
                    <div class="field"><label>PorcentajeAdic2</label><input type="number" step="0.01" @bind="_tarifaForm.PorcentajeAdic2" /></div>
                    <div class="field"><label>PorcentajeAdic3</label><input type="number" step="0.01" @bind="_tarifaForm.PorcentajeAdic3" /></div>
                    <div class="field"><label>PorcentajeAdic4</label><input type="number" step="0.01" @bind="_tarifaForm.PorcentajeAdic4" /></div>
                    <div class="field"><label>Activo</label><input type="checkbox" @bind="_tarifaForm.Activo" /></div>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarTarifaAsync">Guardar tarifa</button>
                </div>
            </section>
        }
    }
    else if (_activeSection == SectionChoferes)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Choferes</h3>
                    <p class="panel-card__subtitle">ABM sobre TA_CHOFERES / MA_CHOFERES con baja lógica.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="NuevoChoferAsync">Nuevo chofer</button>
                    <button type="button" class="btn btn--ghost" @onclick="RecargarChoferesAsync">Recargar</button>
                </div>
            </div>

            <div class="filters-grid filters-grid--wide">
                <div class="field field--wide"><label>Buscar</label><input type="search" @bind="_choferesFiltroTexto" @bind:event="oninput" /></div>
            </div>
            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="AplicarFiltrosChoferesAsync">Aplicar</button>
                <button type="button" class="btn btn--ghost" @onclick="LimpiarFiltrosChoferesAsync">Limpiar</button>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div><h3 class="panel-card__title">Listado de choferes</h3><p class="panel-card__subtitle">@_choferesTotal registro(s)</p></div>
            </div>
            <div class="usuarios-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Activo</th><th>Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var row in _choferes)
                        {
                            <tr>
                                <td>@row.Codigo</td><td>@row.Nombre</td><td>@(row.Activo ? "Sí" : "No")</td>
                                <td><div class="actions"><button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarChoferAsync(row.Codigo)">Editar</button><button type="button" class="btn btn--ghost btn--sm" @onclick="() => BajaChoferAsync(row.Codigo)">Baja</button></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (_showChoferEditor)
        {
            <div class="drawer-overlay" @onclick="CerrarChoferEditorAsync"></div>
            <section class="drawer carga-viajes-drawer carga-viajes-drawer--compact" @onclick:stopPropagation="true">
                <div class="panel-card__header">
                    <div><h3 class="panel-card__title">@(_isNewChofer ? "Nuevo chofer" : $"Editar chofer {_choferForm.Codigo}")</h3><p class="panel-card__subtitle">Datos básicos del chofer.</p></div>
                    <div class="actions"><button type="button" class="btn btn--ghost" @onclick="CerrarChoferEditorAsync">Cerrar</button></div>
                </div>
                <div class="filters-grid filters-grid--wide">
                    <div class="field"><label>Código</label><input type="text" @bind="_choferForm.Codigo" disabled="@(!_isNewChofer)" /></div>
                    <div class="field field--wide"><label>Nombre</label><input type="text" @bind="_choferForm.Nombre" /></div>
                    <div class="field"><label>Activo</label><input type="checkbox" @bind="_choferForm.Activo" /></div>
                </div>
                <div class="actions"><button type="button" class="btn btn--primary" @onclick="GuardarChoferAsync">Guardar chofer</button></div>
            </section>
        }
    }
    else if (_activeSection == SectionDestinos)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Destinos</h3>
                    <p class="panel-card__subtitle">ABM sobre TA_DESTINOS / V_TA_DESTINO con baja lógica.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="NuevoDestinoAsync">Nuevo destino</button>
                    <button type="button" class="btn btn--ghost" @onclick="RecargarDestinosAsync">Recargar</button>
                </div>
            </div>

            <div class="filters-grid filters-grid--wide">
                <div class="field field--wide"><label>Buscar</label><input type="search" @bind="_destinosFiltroTexto" @bind:event="oninput" /></div>
            </div>
            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="AplicarFiltrosDestinosAsync">Aplicar</button>
                <button type="button" class="btn btn--ghost" @onclick="LimpiarFiltrosDestinosAsync">Limpiar</button>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-card__header">
                <div><h3 class="panel-card__title">Listado de destinos</h3><p class="panel-card__subtitle">@_destinosTotal registro(s)</p></div>
            </div>
            <div class="usuarios-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Código</th><th>Descripción</th><th>Activo</th><th>Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var row in _destinos)
                        {
                            <tr>
                                <td>@row.Codigo</td><td>@row.Descripcion</td><td>@(row.Activo ? "Sí" : "No")</td>
                                <td><div class="actions"><button type="button" class="btn btn--ghost btn--sm" @onclick="() => EditarDestinoAsync(row.Codigo)">Editar</button><button type="button" class="btn btn--ghost btn--sm" @onclick="() => BajaDestinoAsync(row.Codigo)">Baja</button></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (_showDestinoEditor)
        {
            <div class="drawer-overlay" @onclick="CerrarDestinoEditorAsync"></div>
            <section class="drawer carga-viajes-drawer carga-viajes-drawer--compact" @onclick:stopPropagation="true">
                <div class="panel-card__header">
                    <div><h3 class="panel-card__title">@(_isNewDestino ? "Nuevo destino" : $"Editar destino {_destinoForm.Codigo}")</h3><p class="panel-card__subtitle">Datos básicos del destino.</p></div>
                    <div class="actions"><button type="button" class="btn btn--ghost" @onclick="CerrarDestinoEditorAsync">Cerrar</button></div>
                </div>
                <div class="filters-grid filters-grid--wide">
                    <div class="field"><label>Código</label><input type="text" @bind="_destinoForm.Codigo" disabled="@(!_isNewDestino)" /></div>
                    <div class="field field--wide"><label>Descripción</label><input type="text" @bind="_destinoForm.Descripcion" /></div>
                    <div class="field"><label>Activo</label><input type="checkbox" @bind="_destinoForm.Activo" /></div>
                </div>
                <div class="actions"><button type="button" class="btn btn--primary" @onclick="GuardarDestinoAsync">Guardar destino</button></div>
            </section>
        }
    }
    else if (_activeSection == SectionConfiguracion)
    {
        <section class="panel-card">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configurar Carga de Viaje</h3>
                    <p class="panel-card__subtitle">Parámetros funcionales del módulo guardados en TA_CONFIGURACION.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--primary" @onclick="AbrirConfiguracionModuloAsync">Editar configuración</button>
                </div>
            </div>

            <div class="carga-viajes-config-summary">
                <article class="panel-card carga-viajes-config-summary__item">
                    <span class="panel-card__tag">SUCURSAL</span>
                    <h3 class="panel-card__title">@_config.Sucursal</h3>
                    <p class="panel-card__subtitle">Usada para numeración de comprobantes.</p>
                </article>
                <article class="panel-card carga-viajes-config-summary__item">
                    <span class="panel-card__tag">LETRA</span>
                    <h3 class="panel-card__title">@_config.Letra</h3>
                    <p class="panel-card__subtitle">Sufijo del IDCOMPROBANTE.</p>
                </article>
                <article class="panel-card carga-viajes-config-summary__item">
                    <span class="panel-card__tag">ADICIONALES</span>
                    <h3 class="panel-card__title">5 configurables</h3>
                    <p class="panel-card__subtitle">Nombres y porcentajes por defecto.</p>
                </article>
            </div>
        </section>
    }
    else if (_activeSection == SectionNuevo)
    {
        <section class="panel-card carga-viajes-drawer carga-viajes-drawer--wide carga-viajes-drawer--static">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Nuevo viaje</h3>
                    <p class="panel-card__subtitle">Carga del viaje con autocompletado para cliente, chofer, destino y tipo de vehículo.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="() => NavigateSectionAsync(SectionViajes)">Volver al listado</button>
                </div>
            </div>

            <div class="filters-grid filters-grid--wide">
                <div class="field"><label>Fecha</label><InputDate @bind-Value="_viajeForm.Fecha" /></div>
                <div class="field"><label>Cliente</label><LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_viajeClienteTexto" TextChanged="OnViajeClienteTextoChangedAsync" SelectedChanged="OnViajeClienteSelectedAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" /></div>
                <div class="field"><label>Chofer</label><LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_viajeChoferTexto" TextChanged="OnViajeChoferTextoChangedAsync" SelectedChanged="OnViajeChoferSelectedAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" /></div>
                <div class="field"><label>Destino</label><LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_viajeDestinoTexto" TextChanged="OnViajeDestinoTextoChangedAsync" SelectedChanged="OnViajeDestinoSelectedAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" /></div>
                <div class="field"><label>Tipo vehículo</label><LookupAutocomplete Label="" Placeholder="Buscar tipo..." Text="@_viajeTipoVehiculoTexto" TextChanged="OnViajeTipoVehiculoTextoChangedAsync" SelectedChanged="OnViajeTipoVehiculoSelectedAsync" SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" /></div>
                <div class="field"><label>Lista</label><input type="text" value="@_viajeForm.Lista" readonly /></div>
                <div class="field"><label>Importe cliente</label><input type="number" step="0.01" @bind="_viajeForm.ImporteCliente" /></div>
                <div class="field"><label>Importe fletero</label><input type="number" step="0.01" @bind="_viajeForm.ImporteFletero" /></div>
                <div class="field"><label>Peaje</label><input type="number" step="0.01" @bind="_viajeForm.Peaje" /></div>
                <div class="field"><label>Cantidad viajes</label><input type="number" step="1" @bind="_viajeForm.CantidadViajes" /></div>
                <div class="field"><label>@GetAdicionalLabel(0)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic" /></div>
                <div class="field"><label>@GetAdicionalLabel(1)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic1" /></div>
                <div class="field"><label>@GetAdicionalLabel(2)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic2" /></div>
                <div class="field"><label>@GetAdicionalLabel(3)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic3" /></div>
                <div class="field"><label>@GetAdicionalLabel(4)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic4" /></div>
                <div class="field field--wide"><label>Observaciones</label><textarea rows="4" @bind="_viajeForm.Observaciones"></textarea></div>
            </div>

            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="GuardarViajeAsync">Guardar viaje</button>
                <button type="button" class="btn btn--ghost" @onclick="LimpiarViajeFormAsync">Limpiar</button>
            </div>
        </section>
    }

    @if (_showConfigEditor)
    {
        <div class="drawer-overlay" @onclick="CerrarConfiguracionModulo"></div>
        <section class="drawer carga-viajes-drawer carga-viajes-drawer--wide carga-viajes-drawer--config" @onclick:stopPropagation="true">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Configurar Carga de Viaje</h3>
                    <p class="panel-card__subtitle">Parámetros funcionales, numeración y adicionales visibles.</p>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" @onclick="CerrarConfiguracionModulo">Cerrar</button>
                </div>
            </div>

            <div class="carga-viajes-config-grid">
                <div class="field"><label>Sucursal</label><input type="text" maxlength="4" @bind="_config.Sucursal" /></div>
                <div class="field"><label>Letra</label><input type="text" maxlength="1" @bind="_config.Letra" /></div>
                @for (var i = 0; i < _config.NombresAdicionales.Count; i++)
                {
                    var index = i;
                    <div class="field">
                        <label>Nombre adicional @(index + 1)</label>
                        <input type="text" @bind="_config.NombresAdicionales[index]" />
                    </div>
                    <div class="field">
                        <label>Porcentaje adicional @(index + 1)</label>
                        <input type="number" step="0.01" @bind="_config.PorcentajesAdicionales[index]" />
                    </div>
                }
            </div>

            <div class="actions">
                <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionModuloAsync">Guardar configuración</button>
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public string? Vista { get; set; }

    private const string SectionViajes = "viajes";
    private const string SectionTarifas = "tarifas";
    private const string SectionNuevo = "nuevo";
    private const string SectionChoferes = "choferes";
    private const string SectionDestinos = "destinos";
    private const string SectionConfiguracion = "configuracion";

    private string _activeSection = SectionViajes;
    private bool _loading;
    private AppUiMessage? _feedback;

    private CargaViajesLookupDto _lookups = new();
    private CargaViajesFilters _viajesFilters = new();
    private List<CargaViajesGridItemDto> _viajes = [];
    private int _viajesTotal;
    private int _viajesPage = 1;
    private int _viajesTotalPages = 1;
    private bool _viajesLoading = true;
    private CargaViajesDetailDto? _viajeSeleccionado;
    private bool _showViewSettings;
    private CargaViajesViewSettingsDto _viewSettings = new();
    private CargaViajesViewSettingsDto _viewSettingsDraft = new();
    private string _draftAgruparPor = CargaViajesViewGroupKeys.None;
    private bool _viewSettingsLoaded;
    private string _viewSettingsUserName = string.Empty;
    private CargaViajesConfigDto _config = new();
    private bool _configLoaded;
    private bool _showConfigEditor;

    private string _clienteFiltroTexto = string.Empty;
    private string _choferFiltroTexto = string.Empty;
    private string _destinoFiltroTexto = string.Empty;
    private string _viajeClienteTexto = string.Empty;
    private string _viajeChoferTexto = string.Empty;
    private string _viajeDestinoTexto = string.Empty;
    private string _viajeTipoVehiculoTexto = string.Empty;

    private readonly List<CargaViajeTarifaGridItemDto> _tarifas = [];
    private int _tarifasTotal;
    private CargaViajesFilters _tarifasFilters = new() { PageNumber = 1, PageSize = 50 };
    private bool _tarifasLoading = true;
    private bool _showTarifaEditor;
    private bool _isNewTarifa = true;
    private CargaViajeTarifaSaveRequest _tarifaForm = new();

    private readonly List<CargaViajeChoferGridItemDto> _choferes = [];
    private int _choferesTotal;
    private string _choferesFiltroTexto = string.Empty;
    private bool _choferesLoading = true;
    private bool _showChoferEditor;
    private bool _isNewChofer = true;
    private CargaViajeChoferSaveRequest _choferForm = new();

    private readonly List<CargaViajeDestinoGridItemDto> _destinos = [];
    private int _destinosTotal;
    private string _destinosFiltroTexto = string.Empty;
    private bool _destinosLoading = true;
    private bool _showDestinoEditor;
    private bool _isNewDestino = true;
    private CargaViajeDestinoSaveRequest _destinoForm = new();

    private bool _showViajeEditor;
    private bool _isNewViaje = true;
    private CargaViajeSaveRequest _viajeForm = new()
    {
        Fecha = DateTime.Today,
        Estado = CargaViajeEstadoKeys.Pendiente,
        CantidadViajes = 1
    };

    protected override async Task OnParametersSetAsync()
    {
        _activeSection = NormalizeSection(Vista);
        await EnsureLookupsLoadedAsync();
        await EnsureViewSettingsLoadedAsync();
        await EnsureConfigLoadedAsync();
        await LoadActiveSectionAsync();
    }

    private async Task LoadActiveSectionAsync()
    {
        switch (_activeSection)
        {
            case SectionTarifas:
                await RecargarTarifasAsync();
                break;
            case SectionChoferes:
                await RecargarChoferesAsync();
                break;
            case SectionDestinos:
                await RecargarDestinosAsync();
                break;
            case SectionConfiguracion:
                await Task.CompletedTask;
                break;
            case SectionNuevo:
                _showViajeEditor = true;
                await Task.CompletedTask;
                break;
            default:
                await RecargarViajesAsync();
                break;
        }
    }

    private async Task EnsureLookupsLoadedAsync()
    {
        if (_lookups.Estados.Count > 0)
            return;

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetLookupsAsync(), "No se pudieron cargar las listas auxiliares.");
        if (result.Success && result.Value is not null)
            _lookups = result.Value;
        else
            _feedback = result.Feedback;
    }

    private async Task EnsureViewSettingsLoadedAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(_viewSettingsUserName) && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            _viewSettings = BuildDefaultViewSettings();
            _viewSettingsDraft = BuildDefaultViewSettings();
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetViewSettingsAsync(currentUser), "No se pudo cargar la configuración de vista.");
        _viewSettings = result.Success && result.Value is not null ? result.Value : BuildDefaultViewSettings();
        _viewSettingsDraft = CloneViewSettings(_viewSettings);
        _draftAgruparPor = _viewSettings.AgruparPor;
        _viewSettingsUserName = currentUser;
        _viewSettingsLoaded = true;
    }

    private async Task EnsureConfigLoadedAsync()
    {
        if (_configLoaded)
            return;

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetConfiguracionAsync(), "No se pudo cargar la configuración de viajes.");
        if (result.Success && result.Value is not null)
            _config = result.Value;
        else
            _feedback = result.Feedback;

        _configLoaded = true;
    }

    private async Task RecargarViajesAsync()
    {
        _viajesLoading = true;
        var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchViajesAsync(_viajesFilters), "No se pudieron cargar los viajes.");
        if (result.Success && result.Value is not null)
        {
            _viajes = result.Value.Items.ToList();
            _viajesTotal = result.Value.Total;
            _viajesPage = result.Value.PageNumber;
            _viajesTotalPages = result.Value.TotalPages;
        }
        else
        {
            _feedback = result.Feedback;
        }

        _viajesLoading = false;
    }

    private async Task AplicarFiltrosViajesAsync()
    {
        _viajesFilters.PageNumber = 1;
        await RecargarViajesAsync();
    }

    private async Task LimpiarFiltrosViajesAsync()
    {
        _viajesFilters = new CargaViajesFilters { PageNumber = 1, PageSize = 50 };
        _clienteFiltroTexto = string.Empty;
        _choferFiltroTexto = string.Empty;
        _destinoFiltroTexto = string.Empty;
        await RecargarViajesAsync();
    }

    private async Task CambiarPaginaViajesAsync(int page)
    {
        if (page < 1)
            return;

        _viajesFilters.PageNumber = page;
        await RecargarViajesAsync();
    }

    private async Task VerViajeAsync(int id)
    {
        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetViajeByIdAsync(id), "No se pudo cargar el viaje.");
        if (!result.Success || result.Value is null)
        {
            _feedback = result.Feedback;
            return;
        }

        _viajeSeleccionado = result.Value;
        _showViajeEditor = true;
        _isNewViaje = false;
        MapViajeToForm(result.Value);
        await NavigateSectionAsync(SectionNuevo);
    }

    private async Task EditarViajeAsync(int id) => await VerViajeAsync(id);

    private async Task AbrirNuevoViajeAsync()
    {
        _showViajeEditor = true;
        _isNewViaje = true;
        _viajeSeleccionado = null;
        _viajeForm = BuildDefaultViajeForm(_config);
        _viajeClienteTexto = _viajeChoferTexto = _viajeDestinoTexto = _viajeTipoVehiculoTexto = string.Empty;
        await NavigateSectionAsync(SectionNuevo);
    }

    private async Task GuardarViajeAsync()
    {
        var result = await UiOps.RunAsync(async () =>
        {
            var id = await CargaViajesSvc.SaveViajeAsync(_viajeForm);
            return id;
        }, "No se pudo guardar el viaje.");

        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Viaje guardado", "El viaje quedó registrado correctamente.");
        await RecargarViajesAsync();
        await NavigateSectionAsync(SectionViajes);
    }

    private async Task LimpiarViajeFormAsync() => await AbrirNuevoViajeAsync();

    private async Task AnularViajeAsync(int id)
    {
        var result = await UiOps.RunAsync(() => CargaViajesSvc.AnularViajeAsync(id, AppUserSession.GetCurrentUserName(string.Empty)), "No se pudo anular el viaje.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _feedback = AppUiMessage.Success("Viaje anulado", "El viaje quedó en estado ANULADO.");
        await RecargarViajesAsync();
    }

    private IReadOnlyList<CargaViajesViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private IReadOnlyList<CargaViajeGroupDto> BuildViajeGroups()
    {
        if (_viewSettings.AgruparPor == CargaViajesViewGroupKeys.Estado)
            return _viajes.GroupBy(x => x.Estado).Select(g => new CargaViajeGroupDto { Label = g.Key, ShowHeader = true, Items = g.ToList() }).ToList();
        if (_viewSettings.AgruparPor == CargaViajesViewGroupKeys.Usuario)
            return _viajes.GroupBy(x => x.Usuario).Select(g => new CargaViajeGroupDto { Label = string.IsNullOrWhiteSpace(g.Key) ? "Sin usuario" : g.Key, ShowHeader = true, Items = g.ToList() }).ToList();
        return [new CargaViajeGroupDto { Label = string.Empty, ShowHeader = false, Items = _viajes.ToList() }];
    }

    private static string RenderViajeColumn(CargaViajesGridItemDto row, string key)
        => (key ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            CargaViajesViewColumnKeys.Fecha => row.Fecha.ToString("dd/MM/yyyy"),
            CargaViajesViewColumnKeys.IdComprobante => row.IdComprobante,
            CargaViajesViewColumnKeys.Cliente => $"{row.ClienteCodigo} - {row.ClienteNombre}",
            CargaViajesViewColumnKeys.Destino => $"{row.DestinoCodigo} - {row.DestinoDescripcion}",
            CargaViajesViewColumnKeys.Chofer => $"{row.ChoferCodigo} - {row.ChoferNombre}",
            CargaViajesViewColumnKeys.TipoVehiculo => $"{row.TipoVehiculoCodigo} - {row.TipoVehiculoDescripcion}",
            CargaViajesViewColumnKeys.TotalCliente => row.TotalCliente.ToString("N2"),
            CargaViajesViewColumnKeys.TotalFletero => row.TotalFletero.ToString("N2"),
            CargaViajesViewColumnKeys.Estado => row.Estado,
            CargaViajesViewColumnKeys.Usuario => row.Usuario,
            CargaViajesViewColumnKeys.Alta => row.FechaHoraAlta.HasValue ? row.FechaHoraAlta.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty,
            _ => string.Empty
        };

    private string GetAdicionalLabel(int index)
    {
        var name = _config.NombresAdicionales.ElementAtOrDefault(index);
        return string.IsNullOrWhiteSpace(name) ? $"Adicional {index + 1}" : name.Trim();
    }

    private void MapViajeToForm(CargaViajesDetailDto detail)
    {
        _viajeForm = new CargaViajeSaveRequest
        {
            Id = detail.Id,
            Tc = detail.Tc,
            IdComprobante = detail.IdComprobante,
            Fecha = detail.Fecha,
            Cliente = detail.ClienteCodigo,
            Chofer = detail.ChoferCodigo,
            Destino = detail.DestinoCodigo,
            TipoVehiculo = detail.TipoVehiculoCodigo,
            Lista = detail.Lista,
            ImporteCliente = detail.TotalImporte,
            ImporteFletero = detail.TotalFlete,
            Peaje = detail.Peaje,
            CantidadViajes = detail.CantidadViajes,
            PorcentajeAdic = detail.PorcentajeAdic,
            PorcentajeAdic1 = detail.PorcentajeAdic1,
            PorcentajeAdic2 = detail.PorcentajeAdic2,
            PorcentajeAdic3 = detail.PorcentajeAdic3,
            PorcentajeAdic4 = detail.PorcentajeAdic4,
            Observaciones = detail.Observaciones,
            Estado = detail.Estado
        };

        _viajeClienteTexto = detail.ClienteCodigo;
        _viajeChoferTexto = detail.ChoferCodigo;
        _viajeDestinoTexto = detail.DestinoCodigo;
        _viajeTipoVehiculoTexto = detail.TipoVehiculoCodigo;
    }

    private async Task OnClienteFiltroTextoChangedAsync(string text) { _clienteFiltroTexto = text; _viajesFilters.Cliente = text; await Task.CompletedTask; }
    private async Task OnChoferFiltroTextoChangedAsync(string text) { _choferFiltroTexto = text; _viajesFilters.Chofer = text; await Task.CompletedTask; }
    private async Task OnDestinoFiltroTextoChangedAsync(string text) { _destinoFiltroTexto = text; _viajesFilters.Destino = text; await Task.CompletedTask; }
    private async Task OnClienteSeleccionadoAsync(CargaViajeLookupOptionDto item) { _viajesFilters.Cliente = item.Codigo; _clienteFiltroTexto = item.Codigo; await Task.CompletedTask; }
    private async Task OnChoferSeleccionadoAsync(CargaViajeLookupOptionDto item) { _viajesFilters.Chofer = item.Codigo; _choferFiltroTexto = item.Codigo; await Task.CompletedTask; }
    private async Task OnDestinoSeleccionadoAsync(CargaViajeLookupOptionDto item) { _viajesFilters.Destino = item.Codigo; _destinoFiltroTexto = item.Codigo; await Task.CompletedTask; }

    private async Task OnViajeClienteTextoChangedAsync(string text) { _viajeClienteTexto = text; _viajeForm.Cliente = text; await Task.CompletedTask; }
    private async Task OnViajeChoferTextoChangedAsync(string text) { _viajeChoferTexto = text; _viajeForm.Chofer = text; await Task.CompletedTask; }
    private async Task OnViajeDestinoTextoChangedAsync(string text) { _viajeDestinoTexto = text; _viajeForm.Destino = text; await Task.CompletedTask; }
    private async Task OnViajeTipoVehiculoTextoChangedAsync(string text) { _viajeTipoVehiculoTexto = text; _viajeForm.TipoVehiculo = text; await Task.CompletedTask; }

    private async Task OnViajeClienteSelectedAsync(CargaViajeLookupOptionDto item)
    {
        _viajeForm.Cliente = item.Codigo;
        _viajeForm.Lista = item.Lista;
        _viajeClienteTexto = item.Codigo;
        await ActualizarTarifaClienteAsync();
        await Task.CompletedTask;
    }

    private async Task OnViajeChoferSelectedAsync(CargaViajeLookupOptionDto item) { _viajeForm.Chofer = item.Codigo; _viajeChoferTexto = item.Codigo; await ActualizarTarifaFleteroAsync(); await Task.CompletedTask; }
    private async Task OnViajeDestinoSelectedAsync(CargaViajeLookupOptionDto item) { _viajeForm.Destino = item.Codigo; _viajeDestinoTexto = item.Codigo; await ActualizarTarifaClienteAsync(); await ActualizarTarifaFleteroAsync(); await Task.CompletedTask; }
    private async Task OnViajeTipoVehiculoSelectedAsync(CargaViajeLookupOptionDto item) { _viajeForm.TipoVehiculo = item.Codigo; _viajeTipoVehiculoTexto = item.Codigo; await ActualizarTarifaClienteAsync(); await ActualizarTarifaFleteroAsync(); await Task.CompletedTask; }

    private async Task ActualizarTarifaClienteAsync()
    {
        if (string.IsNullOrWhiteSpace(_viajeForm.Cliente) || string.IsNullOrWhiteSpace(_viajeForm.Destino) || string.IsNullOrWhiteSpace(_viajeForm.TipoVehiculo))
        {
            _viajeForm.ImporteCliente = 0m;
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetTarifaClienteAsync(_viajeForm.Cliente, _viajeForm.Destino, _viajeForm.TipoVehiculo), "No se pudo calcular la tarifa cliente.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _viajeForm.ImporteCliente = result.Value;
    }

    private async Task ActualizarTarifaFleteroAsync()
    {
        if (string.IsNullOrWhiteSpace(_viajeForm.Chofer) || string.IsNullOrWhiteSpace(_viajeForm.Destino) || string.IsNullOrWhiteSpace(_viajeForm.TipoVehiculo))
        {
            _viajeForm.ImporteFletero = 0m;
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetTarifaFleteroAsync(_viajeForm.Chofer, _viajeForm.Destino, _viajeForm.TipoVehiculo), "No se pudo calcular la tarifa fletero.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        _viajeForm.ImporteFletero = result.Value;
    }

    private async Task AplicarFiltrosTarifasAsync() { _tarifasFilters.PageNumber = 1; await RecargarTarifasAsync(); }
    private async Task LimpiarFiltrosTarifasAsync()
    {
        _tarifasFilters = new CargaViajesFilters { PageNumber = 1, PageSize = 50 };
        await RecargarTarifasAsync();
    }

    private async Task OnTarifaClienteFiltroChangedAsync(string text) { _tarifasFilters.Cliente = text; await Task.CompletedTask; }
    private async Task OnTarifaClienteFiltroSelectedAsync(CargaViajeLookupOptionDto item) { _tarifasFilters.Cliente = item.Codigo; await Task.CompletedTask; }
    private async Task OnTarifaChoferFiltroChangedAsync(string text) { _tarifasFilters.Chofer = text; await Task.CompletedTask; }
    private async Task OnTarifaChoferFiltroSelectedAsync(CargaViajeLookupOptionDto item) { _tarifasFilters.Chofer = item.Codigo; await Task.CompletedTask; }
    private async Task OnTarifaDestinoFiltroChangedAsync(string text) { _tarifasFilters.Destino = text; await Task.CompletedTask; }
