        _viewSettingsSnapshot = CaptureViewSettingsSnapshot(_viewSettingsDraft);
    }

    private async Task CancelarConfiguracionVista()
    {
        if (_showViewSettings && HasViewSettingsPendingChanges())
        {
            var abandon = await ShowPendingChangesConfirmAsync(
                "Tiene cambios sin guardar.\n¿Desea abandonar la carga?",
                "Abandonar",
                "Continuar editando");
            if (!abandon)
                return;

            await ForceCancelarConfiguracionVistaAsync();
            return;
        }

        await ForceCancelarConfiguracionVistaAsync();
    }

    private void ToggleViewColumn(string key, ChangeEventArgs args)
    {
        var column = _viewSettingsDraft.Columnas.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null)
            return;

        column.Visible = args.Value is bool flag && flag;
        if (!_viewSettingsDraft.Columnas.Any(c => c.Visible))
            column.Visible = true;
    }

    private void MoveViewColumn(string key, int offset)
    {
        var ordered = _viewSettingsDraft.Columnas.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
            return;

        var target = index + offset;
        if (target < 0 || target >= ordered.Count)
            return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
        _viewSettingsDraft.Columnas = ordered;
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Sesión requerida", Message = "Necesitás iniciar sesión para guardar la configuración de vista." };
            return;
        }

        var settings = new CargaViajesViewSettingsDto { AgruparPor = _draftAgruparPor, Columnas = CloneViewSettings(_viewSettingsDraft).Columnas };
        try
        {
            await CargaViajesSvc.SaveViewSettingsAsync(currentUser, settings);
        }
        catch (Exception ex)
        {
            _feedback = UiOps.BuildMessage(ex, "No se pudo guardar la configuración de vista.");
            return;
        }

        _viewSettings = settings;
        _showViewSettings = false;
        _viewSettingsSnapshot = string.Empty;
        SetSuccessFeedback("Vista guardada", "La configuración de la grilla quedó actualizada para tu usuario.");
    }

    private async Task AbrirConfiguracionModuloAsync()
    {
        await EnsureConfigLoadedAsync();
        _showConfigEditor = true;
        await SyncConfigTarifaGeneralTextoAsync();
        _configSnapshot = CaptureConfigSnapshot(_config);
        await Task.CompletedTask;
    }

    private async Task GuardarConfiguracionModuloAsync()
    {
        try
        {
            await CargaViajesSvc.SaveConfiguracionAsync(_config);
        }
        catch (Exception ex)
        {
            _feedback = UiOps.BuildMessage(ex, "No se pudo guardar la configuración del módulo.");
            return;
        }

        SetSuccessFeedback("Configuración guardada", "Los parámetros del módulo quedaron actualizados.");
        _showConfigEditor = false;
        _configSnapshot = string.Empty;
        var reload = await UiOps.RunAsync(() => CargaViajesSvc.GetConfiguracionAsync(), "No se pudo recargar la configuración.");
        if (reload.Success && reload.Value is not null)
        {
            _config = reload.Value;
            await SyncConfigTarifaGeneralTextoAsync();
        }
    }

    private async Task CerrarConfiguracionModulo()
    {
        if (_showConfigEditor && HasConfigPendingChanges())
        {
            var abandon = await ShowPendingChangesConfirmAsync(
                "Tiene cambios sin guardar.\n¿Desea abandonar la carga?",
                "Abandonar",
                "Continuar editando");
            if (!abandon)
                return;

            await ForceCerrarConfiguracionModuloAsync();
            return;
        }

        await ForceCerrarConfiguracionModuloAsync();
    }

