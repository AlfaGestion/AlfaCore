    private bool ValidateReporteLiquidacion()
    {
        if (_reporteLiquidacionFilters.FechaDesde is null)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Fecha desde obligatoria", Message = "Debe ingresar una fecha desde." };
            return false;
        }

        if (_reporteLiquidacionFilters.FechaHasta is null)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Fecha hasta obligatoria", Message = "Debe ingresar una fecha hasta." };
            return false;
        }

        if (_reporteLiquidacionFilters.FechaHasta.Value.Date < _reporteLiquidacionFilters.FechaDesde.Value.Date)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Rango inválido", Message = "La fecha hasta no puede ser menor que la fecha desde." };
            return false;
        }

        if (!_reporteLiquidacionFilters.IncluirChoferes && !_reporteLiquidacionFilters.IncluirFleteros)
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Seleccione tipo de reporte", Message = "Seleccione Choferes, Fleteros o ambos." };
            return false;
        }

        return true;
    }

