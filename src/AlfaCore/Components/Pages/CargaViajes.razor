                <div class="carga-viajes-liquidaciones-actions__summary">
                    <strong>Seleccionados:</strong> @_liquidacionesSeleccionadas.Count viajes
                    <span><strong>Total seleccionado:</strong> @_liquidacionesTotalSeleccionado.ToString("C0")</span>
                </div>
                <button type="button"
                        class="btn btn--primary btn--sm carga-viajes-liquidaciones-actions__pay"
                        @onclick="MarcarSeleccionadosComoPagadosAsync">
                    Pagar seleccionados
                </button>
            </div>
        }
    }
