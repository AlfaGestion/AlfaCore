    private async Task LimpiarFiltrosTarifasAsync()
    {
        var sortBy = _tarifasFilters.SortBy;
        var sortDescending = _tarifasFilters.SortDescending;
        _tarifasFilters = new CargaViajesFilters { PageNumber = 1, PageSize = 50, SortBy = sortBy, SortDescending = sortDescending };
        _showTarifasAdvancedFilters = false;
        await RecargarTarifasAsync();
    }

    private async Task CambiarPaginaTarifasAsync(int page)
    {
        if (_tarifasLoading)
            return;

        var totalPages = Math.Max(1, _tarifasTotalPages);
        var currentPage = Math.Min(Math.Max(1, _tarifasPage), totalPages);
        var targetPage = Math.Min(Math.Max(1, page), totalPages);
        if (targetPage == currentPage)
            return;

        _tarifasFilters.PageNumber = targetPage;
        await RecargarTarifasAsync();
    }

