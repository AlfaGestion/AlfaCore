    private IReadOnlyList<FilterChipItem> BuildViajesFilterChips()
    {
        var chips = new List<FilterChipItem>();

        if (_viajesFilters.FechaDesde.HasValue || _viajesFilters.FechaHasta.HasValue)
            chips.Add(new FilterChipItem("viajes-fecha", $"Fecha: {GetViajesFechaRangoLabel()}"));

        AddChipIfPresent(chips, "viajes-cliente", "Cliente", _clienteFiltroTexto);
        AddChipIfPresent(chips, "viajes-chofer", "Chofer", _choferFiltroTexto);
        AddChipIfPresent(chips, "viajes-destino", "Destino", _destinoFiltroTexto);
        AddChipIfPresent(chips, "viajes-tipo-vehiculo", "Tipo vehículo", _viajesFilters.TipoVehiculo);
        AddChipIfPresent(chips, "viajes-usuario", "Usuario", _viajesFilters.Usuario);
        AddChipIfPresent(chips, "viajes-id-comprobante", "Comprobante", _viajesFilters.IdComprobante);
        AddChipIfPresent(chips, "viajes-estado", "Estado", _viajesFilters.Estado);

        return chips;
    }

    private string GetViajesFechaRangoLabel()
    {
        if (_viajesFilters.FechaDesde.HasValue && _viajesFilters.FechaHasta.HasValue)
        {
            var desde = FormatViajesFilterDate(_viajesFilters.FechaDesde.Value);
            var hasta = FormatViajesFilterDate(_viajesFilters.FechaHasta.Value);
            return string.Equals(desde, hasta, StringComparison.Ordinal) ? desde : $"{desde} - {hasta}";
        }

        if (_viajesFilters.FechaDesde.HasValue)
            return $"Desde {FormatViajesFilterDate(_viajesFilters.FechaDesde.Value)}";

        if (_viajesFilters.FechaHasta.HasValue)
            return $"Hasta {FormatViajesFilterDate(_viajesFilters.FechaHasta.Value)}";

        return "Personalizado";
    }

    private static string FormatViajesFilterDate(DateTime value) => value.ToString("dd/MM/yyyy");

