    private IReadOnlyList<FilterChipItem> BuildLiquidacionesFilterChips()
    {
        var chips = new List<FilterChipItem>();

        if (_liquidacionesFilters.FechaDesde.HasValue || _liquidacionesFilters.FechaHasta.HasValue)
            chips.Add(new FilterChipItem("liquidaciones-fecha", $"Fecha: {FormatFilterDateRange(_liquidacionesFilters.FechaDesde, _liquidacionesFilters.FechaHasta)}"));
        else if (NormalizeLiquidacionesRangoRapido(_liquidacionesFilters.RangoRapido) != CargaViajesReporteRangoRapidoKeys.Todo)
            AddChipIfPresent(chips, "liquidaciones-rango", "Rango", GetLiquidacionesRangoRapidoLabel(_liquidacionesFilters.RangoRapido));

        var tipoPersona = NormalizeLiquidacionesTipoPersona(_liquidacionesFilters.TipoPersona);
        if (tipoPersona != CargaViajesReporteTipoPersonaKeys.ChoferesYFleteros)
            chips.Add(new FilterChipItem("liquidaciones-tipo", $"Tipo: {GetLiquidacionesTipoPersonaLabel()}"));
        AddChipIfPresent(chips, "liquidaciones-chofer", "Chofer/Fletero", _liquidacionesChoferFleteroTexto);
        AddChipIfPresent(chips, "liquidaciones-cliente", "Cliente", _liquidacionesFilters.ClienteTexto);
        AddChipIfPresent(chips, "liquidaciones-destino", "Destino", _liquidacionesFilters.DestinoTexto);
        AddChipIfPresent(chips, "liquidaciones-tipo-vehiculo", "Tipo vehículo", _liquidacionesFilters.TipoVehiculoTexto);
        if (!string.IsNullOrWhiteSpace(_liquidacionesFilters.Estado))
            chips.Add(new FilterChipItem("liquidaciones-estado", $"Estado: {GetLiquidacionesEstadoLabel(_liquidacionesFilters.Estado)}"));
        if (_liquidacionesFilters.MostrarLiquidados)
            chips.Add(new FilterChipItem("liquidaciones-mostrar-liquidados", "Liquidados"));

        return chips;
    }

    private async Task RemoveLiquidacionesFilterChipAsync(string key)
    {
        switch ((key ?? string.Empty).Trim().ToLowerInvariant())
        {
            case "liquidaciones-rango":
                ApplyLiquidacionesRangoRapido(CargaViajesReporteRangoRapidoKeys.Todo);
                break;
            case "liquidaciones-fecha":
                _liquidacionesFilters.FechaDesde = null;
                _liquidacionesFilters.FechaHasta = null;
                _liquidacionesFilters.RangoRapido = CargaViajesReporteRangoRapidoKeys.Todo;
                break;
            case "liquidaciones-tipo":
                ApplyLiquidacionesTipoPersona(CargaViajesReporteTipoPersonaKeys.ChoferesYFleteros);
                break;
            case "liquidaciones-chofer":
                _liquidacionesFilters.ChoferCodigo = string.Empty;
                _liquidacionesFilters.ChoferTexto = string.Empty;
                _liquidacionesChoferFleteroTexto = string.Empty;
                break;
            case "liquidaciones-cliente":
                _liquidacionesFilters.ClienteCodigo = string.Empty;
                _liquidacionesFilters.ClienteTexto = string.Empty;
                _liquidacionesClienteTexto = string.Empty;
                break;
            case "liquidaciones-destino":
                _liquidacionesFilters.DestinoCodigo = string.Empty;
                _liquidacionesFilters.DestinoTexto = string.Empty;
                _liquidacionesDestinoTexto = string.Empty;
                break;
            case "liquidaciones-tipo-vehiculo":
                _liquidacionesFilters.TipoVehiculoCodigo = string.Empty;
                _liquidacionesFilters.TipoVehiculoTexto = string.Empty;
                _liquidacionesTipoVehiculoTexto = string.Empty;
                break;
            case "liquidaciones-estado":
                _liquidacionesFilters.Estado = string.Empty;
                break;
            case "liquidaciones-mostrar-liquidados":
                _liquidacionesFilters.MostrarLiquidados = false;
                _liquidacionesFilters.EstadoPago = CargaViajesLiquidacionEstadoPagoKeys.Pendientes;
                break;
            default:
                return;
        }

        await RefreshLiquidacionesAfterFilterChipChangedAsync();
    }

    private async Task RefreshLiquidacionesAfterFilterChipChangedAsync()
    {
        _liquidacionesSeleccionadas.Clear();
        _liquidacionesTotalSeleccionado = 0m;

        if (_liquidacionesConsultada)
        {
            await BuscarLiquidacionesAsync();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

