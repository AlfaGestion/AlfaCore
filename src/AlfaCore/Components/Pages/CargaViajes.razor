    private PageHeaderViewButton BuildSectionHeaderButton(string section, string label, string icon)
        => new()
        {
            Key = section,
            Label = label,
            Title = label,
            Icon = icon,
            Active = string.Equals(_activeSection, section, StringComparison.OrdinalIgnoreCase)
                     || (string.Equals(section, SectionViajes, StringComparison.OrdinalIgnoreCase) && string.Equals(_activeSection, SectionNuevo, StringComparison.OrdinalIgnoreCase)),
            Disabled = IsAnyOverlayOpen(),
            OnClick = () => RunHeaderActionAsync(() => NavigateSectionAsync(section))
        };

    private PageHeaderState GetHeaderState()
    {
        if (_viajesLoading || _tarifasLoading || _choferesLoading || _destinosLoading || _tipoVehiculosLoading || _reportesLoading || _liquidacionesLoading)
            return PageHeaderState.Loading;
        if (_showViajeEditor || _showTarifaEditor || _showChoferEditor || _showDestinoEditor || _showTipoVehiculoEditor || _showConfigEditor)
            return IsCurrentEditorNew() ? PageHeaderState.Creating : PageHeaderState.Editing;
        if (_liquidacionesSeleccionadas.Count > 0 && _activeSection == SectionLiquidaciones)
            return PageHeaderState.Selection;
        return PageHeaderState.List;
    }

    private bool IsCurrentEditorNew()
        => (_showViajeEditor && _isNewViaje)
           || (_showTarifaEditor && _isNewTarifa)
           || (_showChoferEditor && _isNewChofer)
           || (_showDestinoEditor && _isNewDestino)
           || (_showTipoVehiculoEditor && _isNewTipoVehiculo);

    private string GetHeaderTitle()
    {
        if (_showViajeEditor)
            return _isNewViaje ? "Nuevo viaje" : "Editar viaje";
        if (_showTarifaEditor)
            return _isNewTarifa ? "Nueva tarifa" : "Editar tarifa";
        if (_showChoferEditor)
            return _isNewChofer ? "Nuevo chofer" : "Editar chofer";
        if (_showDestinoEditor)
            return _isNewDestino ? "Nuevo destino" : "Editar destino";
        if (_showTipoVehiculoEditor)
            return _isNewTipoVehiculo ? "Nuevo tipo de vehículo" : "Editar tipo de vehículo";
        if (_showConfigEditor)
            return "Configurar carga de viajes";
        if (_showViewSettings || _showTipoVehiculoViewSettings)
            return "Configurar vista";
        if (_showLiquidacionesPagoModal)
            return "Confirmar pago";

        return _activeSection switch
        {
            SectionTarifas => "Tarifas",
            SectionChoferes => "Choferes",
            SectionDestinos => "Destinos",
            SectionTipoVehiculo => "Tipo de vehículo",
            SectionReportes => "Reportes",
            SectionLiquidaciones => "Liquidaciones",
            SectionConfiguracion => "Configuración",
            SectionNuevo => "Nuevo viaje",
            _ => "Carga de viajes"
        };
    }

    private async Task HandleHeaderBackAsync()
    {
        await HandleModalKeyDownAsync(new KeyboardEventArgs { Key = "Escape" });
        UpdatePageHeader();
    }

    private async Task RunHeaderActionAsync(Func<Task> action)
    {
        await action();
        UpdatePageHeader();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        PageHeader.Clear();
        _reportesCancellationCts?.Cancel();
        _reportesCancellationCts?.Dispose();
        _feedbackAutoClearCts?.Cancel();
        _feedbackAutoClearCts?.Dispose();
    }

