        _tarifasQuickImportOriginal = row.Importe.ToString(System.Globalization.CultureInfo.InvariantCulture);
        await InvokeAsync(StateHasChanged);
        await FocusTarifaImporteInputAsync(row.Id);
    }

    private async Task FocusTarifaImporteInputAsync(int id)
    {
        var inputId = GetTarifaImporteInputId(id);
        await Js.InvokeVoidAsync("eval", $"(function(){{var e=document.getElementById('{inputId}'); if(e){{ e.focus(); e.select(); }}}})();");
    }

    private async Task SelectTarifaImporteAsync(int id)
    {
