        => _tarifasAumento.Where(row => _tarifasAumentoSeleccionadas.Contains(row.Id)).ToList();

    private decimal GetTarifasAumentoCurrentTotal()
        => GetTarifasAumentoSeleccionadas().Sum(row => row.Importe);

    private decimal GetTarifasAumentoSimulatedTotal()
        => GetTarifasAumentoSeleccionadas().Sum(GetTarifaAumentoImporteSimulado);

    private decimal GetTarifasAumentoDifferenceTotal()
        => GetTarifasAumentoSimulatedTotal() - GetTarifasAumentoCurrentTotal();

    private async Task SimularTarifasAumentoAsync()
    {
        if (_tarifasAumentoSeleccionadas.Count == 0)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Seleccione tarifas",
                Message = "Debe seleccionar al menos una tarifa para simular."
            };
            return;
        }

        _tarifasAumentoSimulada = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AplicarTarifasBulkEditAsync()
    {
        if (_tarifasAumentoSeleccionadas.Count == 0)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Seleccione tarifas",
                Message = "Debe seleccionar al menos una tarifa."
            };
            return;
        }

        if (!_tarifasAumentoSimulada)
        {
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Warning,
                Title = "Simulación pendiente",
                Message = "Primero presione Simular para revisar los importes propuestos."
            };
            return;
        }

        var preview = GetTarifasBulkPreviewText();
        var confirm = await AppDialogs.ShowConfirmAsync(
            "Aumento de tarifa",
            $"Se actualizarán {_tarifasAumentoSeleccionadas.Count} tarifas.\n{preview}\n¿Desea continuar?",
            "Guardar aumento",
            "Cancelar",
            iconClass: "bi bi-arrow-up-circle");
        if (!confirm)
            return;

        foreach (var row in _tarifasAumento.Where(x => x.Id > 0 && _tarifasAumentoSeleccionadas.Contains(x.Id)))
        {
            var next = GetTarifaAumentoImporteSimulado(row);
            var result = await UiOps.RunAsync(
                () => CargaViajesSvc.ActualizarTarifaImporteAsync(row.Id, row.IdLista, next),
                "No se pudo actualizar una de las tarifas seleccionadas.");
            if (!result.Success)
            {
                _feedback = result.Feedback;
                return;
            }
        }

        SetSuccessFeedback("Aumento aplicado", "Se actualizaron las tarifas seleccionadas.");
        await CerrarTarifasBulkEditAsync();
        await RecargarTarifasAsync();
    }

