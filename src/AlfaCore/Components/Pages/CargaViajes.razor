                                       inputmode="decimal"
                                       class="carga-viajes-viaje__money-input"
                                       value="@_viajePeajeTexto"
                                       disabled="@_viajeReadOnly"
                                       @oninput="OnViajePeajeTextChangedAsync"
                                       @onblur="OnViajePeajeBlurAsync"
                                       @onkeydown="args => HandleEnterAdvanceAsync(args, FocusViajeCantidadViajesAsync)" />
