    protected override async Task OnParametersSetAsync()
    {
        _activeSection = NormalizeSection(Vista);
        await EnsureLookupsLoadedAsync();
        await EnsureViewSettingsLoadedAsync();
        await EnsureTipoVehiculoSchemaLoadedAsync();
        await EnsureConfigLoadedAsync();
        await LoadActiveSectionAsync();
    }

    private async Task LoadActiveSectionAsync()
    {
        _showViewSettings = false;
        _showConfigEditor = false;
        _showTarifaEditor = false;
        _showChoferEditor = false;
        _showDestinoEditor = false;
        _showTipoVehiculoEditor = false;
        _showTipoVehiculoViewSettings = false;
        _showViajeEditor = false;
        _viajeReadOnly = false;
        _showViajesAdvancedFilters = false;
        _showTarifasAdvancedFilters = false;
        _showChoferesAdvancedFilters = false;
        _showDestinosAdvancedFilters = false;
        _showTipoVehiculosAdvancedFilters = false;

        switch (_activeSection)
        {
            case SectionTarifas:
                await RecargarTarifasAsync();
                break;
            case SectionChoferes:
                await RecargarChoferesAsync();
                break;
            case SectionDestinos:
                await RecargarDestinosAsync();
                break;
            case SectionTipoVehiculo:
                await EnsureTipoVehiculoViewSettingsLoadedAsync();
                await RecargarTipoVehiculosAsync();
                break;
            case SectionConfiguracion:
                await Task.CompletedTask;
                break;
            case SectionNuevo:
                _showViajeEditor = true;
                _isNewViaje = true;
                _viajeReadOnly = false;
                _viajeSeleccionado = null;
                _viajeForm = BuildDefaultViajeForm(_config);
                _viajeClienteTexto = _viajeChoferTexto = _viajeDestinoTexto = _viajeTipoVehiculoTexto = string.Empty;
                await Task.CompletedTask;
                break;
            default:
                await RecargarViajesAsync();
                break;
        }
    }

    private async Task EnsureLookupsLoadedAsync()
    {
        if (_lookups.Estados.Count > 0)
            return;

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetLookupsAsync(), "No se pudieron cargar las listas auxiliares.");
        if (result.Success && result.Value is not null)
            _lookups = result.Value;
        else
            _feedback = result.Feedback;
    }

    private async Task EnsureViewSettingsLoadedAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (_viewSettingsLoaded && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            _viewSettings = BuildDefaultViewSettings();
            _viewSettingsDraft = BuildDefaultViewSettings();
            _viewSettingsUserName = currentUser;
            _viewSettingsLoaded = true;
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetViewSettingsAsync(currentUser), "No se pudo cargar la configuración de vista.");
        _viewSettings = result.Success && result.Value is not null ? result.Value : BuildDefaultViewSettings();
        _viewSettingsDraft = CloneViewSettings(_viewSettings);
        _draftAgruparPor = _viewSettings.AgruparPor;
        _viewSettingsUserName = currentUser;
        _viewSettingsLoaded = true;
    }

    private async Task EnsureTipoVehiculoSchemaLoadedAsync()
    {
        if (_tipoVehiculoSchemaLoaded)
            return;

        var result = await UiOps.RunAsync(() => CargaViajesSvc.TipoVehiculoTieneActivoAsync(), "No se pudo verificar la estructura de tipos de vehículo.");
        _tipoVehiculosHasActivo = result.Success && result.Value;
        _tipoVehiculoSchemaLoaded = true;
    }

    private async Task EnsureTipoVehiculoViewSettingsLoadedAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (_tipoVehiculoViewSettingsLoaded && string.Equals(_tipoVehiculoViewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            _tipoVehiculoViewSettings = BuildDefaultTipoVehiculoViewSettings();
            _tipoVehiculoViewSettingsDraft = BuildDefaultTipoVehiculoViewSettings();
            _tipoVehiculoViewSettingsUserName = currentUser;
            _tipoVehiculoViewSettingsLoaded = true;
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetTipoVehiculoViewSettingsAsync(currentUser), "No se pudo cargar la configuración de vista de tipo de vehículo.");
        _tipoVehiculoViewSettings = result.Success && result.Value is not null ? result.Value : BuildDefaultTipoVehiculoViewSettings();
        _tipoVehiculoViewSettingsDraft = CloneTipoVehiculoViewSettings(_tipoVehiculoViewSettings);
        _tipoVehiculoDraftAgruparPor = _tipoVehiculoViewSettings.AgruparPor;
        _tipoVehiculoViewSettingsUserName = currentUser;
        _tipoVehiculoViewSettingsLoaded = true;
