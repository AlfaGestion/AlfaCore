    private void ApplyViajeDefaultPercents(CargaViajeSaveRequest form)
    {
        var count = GetAdicionalesHabilitadosCount();
        if (count > 0) form.PorcentajeAdic = ResolvePercentOrDefault(form.PorcentajeAdic, 0);
        if (count > 1) form.PorcentajeAdic1 = ResolvePercentOrDefault(form.PorcentajeAdic1, 1);
        if (count > 2) form.PorcentajeAdic2 = ResolvePercentOrDefault(form.PorcentajeAdic2, 2);
        if (count > 3) form.PorcentajeAdic3 = ResolvePercentOrDefault(form.PorcentajeAdic3, 3);
        if (count > 4) form.PorcentajeAdic4 = ResolvePercentOrDefault(form.PorcentajeAdic4, 4);
    }

