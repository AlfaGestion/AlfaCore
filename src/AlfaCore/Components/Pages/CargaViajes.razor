    private async Task RecargarViajesAsync()
    {
        _viajesLoading = true;
        var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchViajesAsync(_viajesFilters), "No se pudieron cargar los viajes.");
        if (result.Success && result.Value is not null)
        {
            var totalPages = Math.Max(1, result.Value.TotalPages);
            if (result.Value.Total > 0 && _viajesFilters.PageNumber > totalPages)
            {
                _viajesLoading = false;
                _viajesFilters.PageNumber = totalPages;
                await RecargarViajesAsync();
                return;
            }

            _viajes = result.Value.Items.ToList();
            _viajesTotal = result.Value.Total;
            _viajesTotalPages = totalPages;
            _viajesPage = Math.Min(Math.Max(1, result.Value.PageNumber), _viajesTotalPages);
            _viajesFilters.PageNumber = _viajesPage;
        }
        else
        {
            _feedback = result.Feedback;
        }

        _viajesLoading = false;
    }

