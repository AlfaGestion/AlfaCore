    private async Task HandleModalKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            return;

        if (_showViewSettings)
            await CancelarConfiguracionVista();
        else if (_showConfigEditor)
            await CerrarConfiguracionModulo();
        else if (_showTarifaEditor)
            await CerrarTarifaEditorAsync();
        else if (_showChoferEditor)
            await CerrarChoferEditorAsync();
        else if (_showDestinoEditor)
            await CerrarDestinoEditorAsync();
        else if (_showTipoVehiculoViewSettings)
            await CancelarConfiguracionTipoVehiculoVista();
        else if (_showTipoVehiculoEditor)
            await CerrarTipoVehiculoEditorAsync();
        else if (_showLiquidacionesPagoModal)
            await CerrarLiquidacionesPagoModalAsync();
        else if (_showViajeEditor)
            await CerrarViajeEditorAsync();
    }

    private async Task NavigateSectionAsync(string section, bool preserveDialog = false)
    {
        var normalized = NormalizeSection(section);
        if (HasAnyPendingChanges())
        {
            var abandon = await ShowPendingChangesConfirmAsync(
                "Tiene cambios sin guardar.\n¿Desea abandonar la carga?",
                "Abandonar",
                "Continuar editando");
            if (!abandon)
                return;

            await ForceNavigateSectionAsync(normalized);
            return;
        }

        if (!preserveDialog)
            await AppDialogs.HideAsync();

        await ForceNavigateSectionAsync(normalized);
    }

    private async Task ForceNavigateSectionAsync(string normalized)
    {
        ClearMessages();
        await ForceCloseAllEditorsAsync();
        Nav.NavigateTo(BuildSectionRoute(normalized));
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            UpdatePageHeader();
        });
    }

    private string BuildSectionRoute(string normalized)
    {
        var route = normalized == SectionViajes ? "/carga-viajes" : $"/carga-viajes/{normalized}";
        var target = RouteContext.BuildRoute(route);
        return IsDirectRoute() ? AppendDirectFlag(target) : target;
    }

    private bool IsDirectRoute()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        return query.TryGetValue("directo", out var directo)
               && string.Equals(directo.ToString(), "1", StringComparison.OrdinalIgnoreCase);
    }

    private static string AppendDirectFlag(string route)
    {
        if (string.IsNullOrWhiteSpace(route) || route.Contains("directo=1", StringComparison.OrdinalIgnoreCase))
            return route;

        return route.Contains('?', StringComparison.Ordinal)
            ? route + "&directo=1"
            : route + "?directo=1";
    }

