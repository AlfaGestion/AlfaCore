                                                    SelectedChanged="OnConfigTarifaGeneralSeleccionadaAsync"
                                                    OnEnterCommitted="FocusConfigGuardarAsync"
                                                    SearchFunc="CargaViajesSvc.SearchTarifasLookupAsync"
                                                    MinimumCharacters="0" />
                            </div>
                        </div>
                    </div>

                    <div class="carga-viajes-config-section">
                        <div class="carga-viajes-config-section__title">Adicionales</div>
                        <div class="carga-viajes-config-adicionales">
                            @for (var i = 0; i < 6; i++)
                            {
                                var index = i;
                                var habilitado = GetConfigAdicionalHabilitado(index);
                                <article class="carga-viajes-config-adicionales__item @(habilitado ? "carga-viajes-config-adicionales__item--active" : string.Empty)" @key="index">
                                    <div class="carga-viajes-config-adicionales__badge">@GetConfigAdicionalBadgeText(index)</div>
                                    <div class="carga-viajes-config-adicionales__grid">
                                        <div class="field carga-viajes-config-adicionales__field carga-viajes-config-adicionales__field--name">
                                            <label>Nombre</label>
                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   @bind="_config.NombresAdicionales[index]"
                                                   disabled="@(!habilitado)" />
                                        </div>
                                        <div class="field carga-viajes-config-adicionales__field carga-viajes-config-adicionales__field--percent">
                                            <label>@(GetConfigAdicionalEsPorcentaje(index) ? "Porcentaje" : "Importe")</label>
