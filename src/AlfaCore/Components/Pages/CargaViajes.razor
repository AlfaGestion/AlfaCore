    private static IReadOnlyList<CargaViajesAgrupacionDto<TItem>> BuildAgrupaciones<TItem>(
        IEnumerable<TItem> rows,
        string agruparPor,
        Func<TItem, string, string> getValor,
        Func<TItem, string, string> getEtiqueta)
        where TItem : class
    {
        var normalized = NormalizeGroupBy(agruparPor);
        if (normalized == CargaViajesViewGroupKeys.None)
            return [];

        return rows
            .GroupBy(row => new
            {
                Tipo = getEtiqueta(row, normalized),
                Nombre = getValor(row, normalized)
            })
            .Select(g =>
            {
                var items = g.ToList();
                var totalCliente = items.Sum(GetGrupoTotalCliente);
                var totalFletero = items.Sum(GetGrupoTotalFletero);
                var totalPeajes = items.Sum(GetGrupoTotalPeaje);
                return new CargaViajesAgrupacionDto<TItem>
                {
                    GrupoTipo = g.Key.Tipo,
                    GrupoNombre = g.Key.Nombre,
                    CantidadViajes = items.Sum(GetGrupoCantidadViajes),
                    TotalCliente = totalCliente,
                    TotalFletero = totalFletero,
                    TotalPeajes = totalPeajes,
                    Resultado = totalCliente - totalFletero - totalPeajes,
                    DetalleViajes = items
                        .OrderBy(GetGrupoFecha)
                        .ThenBy(GetGrupoOrden)
                        .ToList()
                };
            })
            .OrderBy(x => x.GrupoTipo)
            .ThenBy(x => x.GrupoNombre)
            .ToList();
    }

