                            <div class="field">
                                <label>Cantidad viajes</label>
                                <input @ref="_viajeCantidadViajesInput" type="number" step="1" @bind="_viajeForm.CantidadViajes" disabled="@_viajeReadOnly" @onkeydown="args => HandleEnterAdvanceAsync(args, FocusViajeAdicional0Async)" />
                            </div>
                        </div>

                        <div class="field field--wide carga-viajes-viaje__tarifa-aplicada">
                            <span class="carga-viajes-viaje__tarifa-label">Tarifa aplicada</span>
