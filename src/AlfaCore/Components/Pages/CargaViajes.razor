            .OrderBy(c => c.Order)
            .ToList();

    private IReadOnlyList<CargaViajeTipoVehiculoGroupDto> BuildTipoVehiculoGroups()
    {
        if (_tipoVehiculoViewSettings.AgruparPor == CargaViajeTipoVehiculoViewGroupKeys.Activo && _tipoVehiculosHasActivo)
        {
            return _tipoVehiculos
                .GroupBy(x => x.Activo == true ? "Activo" : "Inactivo")
                .Select(g => new CargaViajeTipoVehiculoGroupDto { Label = g.Key, ShowHeader = true, Items = g.ToList() })
                .ToList();
        }

        return [new CargaViajeTipoVehiculoGroupDto { Label = string.Empty, ShowHeader = false, Items = _tipoVehiculos.ToList() }];
    }

    private static string RenderTipoVehiculoColumn(CargaViajeTipoVehiculoGridItemDto row, string key)
        => key switch
        {
            CargaViajeTipoVehiculoViewColumnKeys.Codigo => row.Codigo,
            CargaViajeTipoVehiculoViewColumnKeys.Descripcion => row.Descripcion,
            CargaViajeTipoVehiculoViewColumnKeys.Activo => !row.Activo.HasValue ? string.Empty : (row.Activo.Value ? "Activo" : "Desactivado"),
            _ => string.Empty
        };

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--ok",
            AppUiFeedbackSeverity.Info => "editor-msg--ok",
            AppUiFeedbackSeverity.Warning => "editor-msg--warning",
            _ => "editor-msg--error"
        };

    private static bool ShouldShowFeedbackTitle(AppUiMessage message)
    {
        if (string.IsNullOrWhiteSpace(message.Title))
            return false;

        if (string.IsNullOrWhiteSpace(message.Message))
            return true;

        return !string.Equals(message.Title.Trim(), message.Message.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatFeedbackMessage(AppUiMessage message)
    {
        var baseMessage = (message.Message ?? string.Empty).Trim();
        if (message.HasCode)
        {
            if (!string.IsNullOrWhiteSpace(baseMessage) && !baseMessage.EndsWith(".", StringComparison.Ordinal) && !baseMessage.EndsWith("!", StringComparison.Ordinal) && !baseMessage.EndsWith("?", StringComparison.Ordinal))
                baseMessage += ".";

            return string.IsNullOrWhiteSpace(baseMessage)
                ? $"Código: {message.Code}"
                : $"{baseMessage} Código: {message.Code}";
        }

        return baseMessage;
    }

    private void ClearMessages()
    {
        CancelFeedbackAutoClear();
        _feedback = null;
        _viajeEditorFeedback = null;
    }

    private void SetFeedback(AppUiMessage? message)
    {
        CancelFeedbackAutoClear();
        _feedback = message;
        if (message is null || message.Severity == AppUiFeedbackSeverity.Warning || message.Severity == AppUiFeedbackSeverity.Error)
            return;

        ScheduleAutoClearFeedback();
    }

    private void ScheduleAutoClearFeedback()
    {
        CancelFeedbackAutoClear();
        var cts = new CancellationTokenSource();
        _feedbackAutoClearCts = cts;
        _ = AutoClearFeedbackAsync(cts);
    }

    private void CancelFeedbackAutoClear()
    {
        _feedbackAutoClearCts?.Cancel();
        _feedbackAutoClearCts?.Dispose();
        _feedbackAutoClearCts = null;
    }

    private async Task AutoClearFeedbackAsync(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), cts.Token);
            if (cts.IsCancellationRequested || !ReferenceEquals(_feedbackAutoClearCts, cts))
                return;

            await InvokeAsync(() =>
            {
                if (ReferenceEquals(_feedbackAutoClearCts, cts))
                {
                    _feedback = null;
                    _viajeEditorFeedback = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void SetSuccessFeedback(string title, string message)
        => SetFeedback(AppUiMessage.Success(title, message));

    private bool IsAnyOverlayOpen()
        => _showViewSettings
           || _showTarifaEditor
           || _showChoferEditor
           || _showDestinoEditor
           || _showTipoVehiculoViewSettings
           || _showTipoVehiculoEditor
           || _showViajeEditor
           || _showConfigEditor
           || _showLiquidacionesPagoModal;

    private static string NormalizeSectionFromUri(string? vista) => NormalizeSection(vista);

    private static string NormalizeSection(string? value, bool _ = true)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            SectionTarifas => SectionTarifas,
            SectionNuevo => SectionNuevo,
            SectionChoferes => SectionChoferes,
            SectionDestinos => SectionDestinos,
            SectionTipoVehiculo => SectionTipoVehiculo,
            SectionReportesLegacy => SectionReportes,
            SectionReportes => SectionReportes,
            SectionLiquidaciones => SectionLiquidaciones,
            SectionConfiguracion => SectionConfiguracion,
            _ => SectionViajes
        };

