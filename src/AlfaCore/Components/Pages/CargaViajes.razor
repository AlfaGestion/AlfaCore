    @if (_showViajeEditor)
    {
        <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onclick="CerrarViajeEditorAsync">
            <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--wide" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-viaje-title" @onclick:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                <header class="cuentas-modal__header">
                    <div>
                        <span class="cuentas-modal__eyebrow">Viajes</span>
                        <h3 id="carga-viajes-viaje-title">@(_isNewViaje ? "Nuevo viaje" : _viajeReadOnly ? "Detalle de viaje" : $"Editar viaje {_viajeForm.IdComprobante}")</h3>
                    </div>
                    <button type="button" class="cuentas-modal__close" @onclick="CerrarViajeEditorAsync" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </header>

                <div class="cuentas-modal__body">
                    @if (_viajeEditorFeedback is not null)
                    {
                        <div class="editor-msg carga-viajes-modal-feedback @GetFeedbackClass(_viajeEditorFeedback)">
                            <div class="carga-viajes-feedback__content">
                                @if (ShouldShowFeedbackTitle(_viajeEditorFeedback))
                                {
                                    <strong class="carga-viajes-feedback__title">@_viajeEditorFeedback.Title</strong>
                                }
                                <div class="carga-viajes-feedback__line">
                                    <span>@FormatFeedbackMessage(_viajeEditorFeedback)</span>
                                </div>
                                @if (_viajeEditorFeedback.HasSuggestion)
                                {
                                    <small class="carga-viajes-feedback__suggestion">@_viajeEditorFeedback.Suggestion</small>
                                }
                            </div>
                        </div>
                    }

                    <div class="carga-viajes-form-grid">
                        <div class="field"><label>Fecha</label><InputDate @bind-Value="_viajeForm.Fecha" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Cliente</label><LookupAutocomplete Label="" Placeholder="Buscar cliente..." Text="@_viajeClienteTexto" TextChanged="OnViajeClienteTextoChangedAsync" SelectedChanged="OnViajeClienteSelectedAsync" SearchFunc="CargaViajesSvc.SearchClientesAsync" Disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Chofer</label><LookupAutocomplete Label="" Placeholder="Buscar chofer..." Text="@_viajeChoferTexto" TextChanged="OnViajeChoferTextoChangedAsync" SelectedChanged="OnViajeChoferSelectedAsync" SearchFunc="CargaViajesSvc.SearchChoferLookupAsync" Disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Destino</label><LookupAutocomplete Label="" Placeholder="Buscar destino..." Text="@_viajeDestinoTexto" TextChanged="OnViajeDestinoTextoChangedAsync" SelectedChanged="OnViajeDestinoSelectedAsync" SearchFunc="CargaViajesSvc.SearchDestinosLookupAsync" Disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Tipo vehículo</label><LookupAutocomplete Label="" Placeholder="Buscar tipo..." Text="@_viajeTipoVehiculoTexto" TextChanged="OnViajeTipoVehiculoTextoChangedAsync" SelectedChanged="OnViajeTipoVehiculoSelectedAsync" SearchFunc="CargaViajesSvc.SearchTipoVehiculosLookupAsync" Disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Lista</label><input type="text" value="@_viajeForm.ListaDisplay" readonly /></div>
                        <div class="field"><label>Importe cliente</label><input type="number" step="0.01" @bind="_viajeForm.ImporteCliente" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Importe fletero</label><input type="number" step="0.01" @bind="_viajeForm.ImporteFletero" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Peaje</label><input type="number" step="0.01" @bind="_viajeForm.Peaje" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>Cantidad viajes</label><input type="number" step="1" @bind="_viajeForm.CantidadViajes" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>@GetAdicionalLabel(0)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>@GetAdicionalLabel(1)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic1" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>@GetAdicionalLabel(2)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic2" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>@GetAdicionalLabel(3)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic3" disabled="@_viajeReadOnly" /></div>
                        <div class="field"><label>@GetAdicionalLabel(4)</label><input type="number" step="0.01" @bind="_viajeForm.PorcentajeAdic4" disabled="@_viajeReadOnly" /></div>
                        <div class="field field--wide"><label>Observaciones</label><textarea rows="4" @bind="_viajeForm.Observaciones" disabled="@_viajeReadOnly"></textarea></div>
                    </div>
                </div>

                <footer class="cuentas-modal__actions">
                    @if (!_viajeReadOnly)
                    {
                        <button type="button" class="btn btn--primary" @onclick="GuardarViajeAsync" disabled="@_savingViaje">Guardar viaje</button>
                        <button type="button" class="btn btn--ghost" @onclick="LimpiarViajeFormAsync">Limpiar</button>
                    }
                    <button type="button" class="btn btn--ghost" @onclick="CerrarViajeEditorAsync">Cerrar</button>
                </footer>
            </section>
        </div>
    }
    @if (_showConfigEditor)
    {
        <div class="cuentas-modal-backdrop carga-viajes-modal-backdrop" @onclick="CerrarConfiguracionModulo">
            <section class="cuentas-modal carga-viajes-modal carga-viajes-modal--config" role="dialog" aria-modal="true" aria-labelledby="carga-viajes-config-title" @onclick:stopPropagation="true" @onkeydown="HandleModalKeyDownAsync" tabindex="0">
                <header class="cuentas-modal__header">
                    <div>
                        <span class="cuentas-modal__eyebrow">Configuración</span>
                        <h3 id="carga-viajes-config-title">Configurar Carga de Viaje</h3>
                    </div>
                    <button type="button" class="cuentas-modal__close" @onclick="CerrarConfiguracionModulo" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </header>

                <div class="cuentas-modal__body">
                    <div class="carga-viajes-config-grid">
                        <div class="field"><label>Sucursal</label><input type="text" maxlength="4" @bind="_config.Sucursal" /></div>
                        <div class="field"><label>Letra</label><input type="text" maxlength="1" @bind="_config.Letra" /></div>
                        @for (var i = 0; i < _config.NombresAdicionales.Count; i++)
                        {
                            var index = i;
                            <div class="field">
                                <label>Nombre adicional @(index + 1)</label>
                                <input type="text" @bind="_config.NombresAdicionales[index]" />
                            </div>
                            <div class="field">
                                <label>Porcentaje adicional @(index + 1)</label>
                                <input type="number" step="0.01" @bind="_config.PorcentajesAdicionales[index]" />
                            </div>
                        }
                    </div>
                </div>

                <footer class="cuentas-modal__actions">
                    <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionModuloAsync">Guardar configuración</button>
                    <button type="button" class="btn btn--ghost" @onclick="CerrarConfiguracionModulo">Cerrar</button>
                </footer>
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public string? Vista { get; set; }

    private const string SectionViajes = "viajes";
    private const string SectionTarifas = "tarifas";
    private const string SectionNuevo = "nuevo";
    private const string SectionChoferes = "choferes";
    private const string SectionDestinos = "destinos";
    private const string SectionTipoVehiculo = "tipo-vehiculo";
    private const string SectionConfiguracion = "configuracion";

    private string _activeSection = SectionViajes;
    private AppUiMessage? _feedback;
    private AppUiMessage? _viajeEditorFeedback;

    private CargaViajesLookupDto _lookups = new();
    private CargaViajesFilters _viajesFilters = new();
    private List<CargaViajesGridItemDto> _viajes = [];
    private int _viajesTotal;
    private int _viajesPage = 1;
    private int _viajesTotalPages = 1;
    private bool _viajesLoading = true;
    private CargaViajesDetailDto? _viajeSeleccionado;
    private bool _showViewSettings;
    private CargaViajesViewSettingsDto _viewSettings = new();
    private CargaViajesViewSettingsDto _viewSettingsDraft = new();
