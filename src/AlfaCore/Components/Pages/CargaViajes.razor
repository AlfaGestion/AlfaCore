    private async Task RecargarReporteLiquidacionAsync()
    {
        if (_reporteLiquidacionFilters.IncluirClientes || _reporteLiquidacionFilters.IncluirTodoJunto)
        {
            await RecargarReporteClientesAsync();
            return;
        }

        _reportesLoading = true;
        _reportesBusyTitle = "Buscando liquidación";
        _reportesBusyMessage = "Estamos consultando los viajes de la liquidación operativa.";
        _reporteLiquidacionConsultada = true;
        _reporteGruposAbiertos.Clear();
        _reportesCancellationCts?.Dispose();
        using var timeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
        _reportesCancellationCts = CancellationTokenSource.CreateLinkedTokenSource(timeoutCts.Token);
        var reportesToken = _reportesCancellationCts.Token;
        await InvokeAsync(StateHasChanged);
        try
        {
            Logger.LogInformation(
                "Reportes start desde={Desde:yyyy-MM-dd} hasta={Hasta:yyyy-MM-dd} tipoPersona={TipoPersona} estado={Estado} estadoPago={EstadoPago} modo={Modo} chofer={Chofer} cliente={Cliente} destino={Destino}",
                _reporteLiquidacionFilters.FechaDesde,
                _reporteLiquidacionFilters.FechaHasta,
                _reporteLiquidacionFilters.TipoPersona,
                _reporteLiquidacionFilters.Estado,
                _reporteLiquidacionFilters.EstadoPago,
                _reporteLiquidacionFilters.Modo,
                _reporteLiquidacionFilters.ChoferCodigo,
                _reporteLiquidacionFilters.ClienteCodigo,
                _reporteLiquidacionFilters.DestinoCodigo);

            var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchLiquidacionChoferesAsync(_reporteLiquidacionFilters, reportesToken), "No se pudo generar la liquidación de choferes y fleteros.");
            Logger.LogInformation(
                "Liquidacion end success={Success} count={Count}",
                result.Success,
                result.Value?.Count ?? 0);
            if (result.Success && result.Value is not null)
            {
                _reporteLiquidacionRows.Clear();
                _reporteLiquidacionRows.AddRange(result.Value);
                _reporteTotalViajes = _reporteLiquidacionRows.Sum(x => x.TotalFlete);
                _reporteTotalPeaje = _reporteLiquidacionRows.Sum(x => Math.Max(0m, x.Peaje));
                _reporteTotalConPeaje = _reporteTotalViajes + _reporteTotalPeaje;
                Logger.LogInformation(
                    "Reportes dataset rows={Rows} totalViajes={TotalViajes} pendientes={Pendientes} pagados={Pagados} totalCliente={TotalCliente} totalChofer={TotalChofer} totalPeajes={TotalPeajes} tipoPersona={TipoPersona} estadoPago={EstadoPago}",
                    _reporteLiquidacionRows.Count,
                    GetReporteCantidadTotalViajes(),
                    GetReporteCantidadPendientes(),
                    GetReporteCantidadPagados(),
                    GetReporteTotalCliente(),
                    GetReporteTotalChoferFletero(),
                    GetReporteTotalPeajes(),
                    GetReporteTipoPersonaLabel(),
                    GetReporteEstadoPagoLabel(_reporteLiquidacionFilters.EstadoPago));
            }
            else
            {
                _reporteLiquidacionRows.Clear();
                _reporteTotalViajes = 0m;
                _reporteTotalPeaje = 0m;
                _reporteTotalConPeaje = 0m;
                _feedback = result.Feedback;
            }
        }
        catch (OperationCanceledException) when (reportesToken.IsCancellationRequested)
        {
            Logger.LogInformation("Reportes cancelado por el usuario.");
            _reportesBusyTitle = "Consulta cancelada";
            _reportesBusyMessage = "La búsqueda se canceló antes de completar los reportes.";
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Info,
                Title = "Consulta cancelada",
                Message = "La generación del reporte fue cancelada."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reportes falló.");
            _reportesBusyTitle = "No se pudo generar el reporte";
            _reportesBusyMessage = "Se produjo un error al consultar los reportes. Revisá el mensaje de soporte.";
            _reporteLiquidacionRows.Clear();
            _reporteTotalViajes = 0m;
            _reporteTotalPeaje = 0m;
            _reporteTotalConPeaje = 0m;
            _feedback = UiOps.BuildMessage(ex, "No se pudieron generar los reportes.");
        }
        finally
        {
            _reportesLoading = false;
            _reportesCancellationCts?.Dispose();
            _reportesCancellationCts = null;
            Logger.LogInformation("Reportes finalizó. Loading={Loading}", _reportesLoading);
        }
    }

    private async Task RecargarReporteClientesAsync()
    {
        _reportesLoading = true;
        _reportesBusyTitle = "Buscando reporte de clientes";
        _reportesBusyMessage = "Estamos consultando los viajes para facturación.";
        _reporteLiquidacionConsultada = true;
        _reporteGruposAbiertos.Clear();
        _reportesCancellationCts?.Dispose();
        using var timeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
        _reportesCancellationCts = CancellationTokenSource.CreateLinkedTokenSource(timeoutCts.Token);
        var reportesToken = _reportesCancellationCts.Token;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchReporteClientesAsync(_reporteLiquidacionFilters, reportesToken), "No se pudo generar el reporte de clientes.");
            if (result.Success && result.Value is not null)
            {
                _reporteClienteRows.Clear();
                _reporteClienteRows.AddRange(result.Value);
            }
            else
            {
                _reporteClienteRows.Clear();
                _feedback = result.Feedback;
            }
        }
        catch (OperationCanceledException) when (reportesToken.IsCancellationRequested)
        {
            Logger.LogInformation("Reporte de clientes cancelado por el usuario.");
            _reportesBusyTitle = "Consulta cancelada";
            _reportesBusyMessage = "La búsqueda se canceló antes de completar el reporte.";
            _feedback = new AppUiMessage
            {
                Severity = AppUiFeedbackSeverity.Info,
                Title = "Consulta cancelada",
                Message = "La generación del reporte fue cancelada."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reporte de clientes falló.");
            _reportesBusyTitle = "No se pudo generar el reporte";
            _reportesBusyMessage = "Se produjo un error al consultar el reporte. Revisá el mensaje de soporte.";
            _reporteClienteRows.Clear();
            _feedback = UiOps.BuildMessage(ex, "No se pudo generar el reporte de clientes.");
        }
        finally
        {
            _reportesLoading = false;
            _reportesCancellationCts?.Dispose();
            _reportesCancellationCts = null;
        }
    }

    private Task CancelarReporteLiquidacionAsync()
    {
        _reportesCancellationCts?.Cancel();
        return Task.CompletedTask;
    }

