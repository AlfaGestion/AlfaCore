        await Task.CompletedTask;
    }

    private void ApplyViajesFechaRange(string range)
    {
        var today = DateTime.Today;
        switch ((range ?? string.Empty).Trim().ToLowerInvariant())
        {
            case "hoy":
                _viajesFilters.FechaDesde = today;
                _viajesFilters.FechaHasta = today;
                break;
            case "semana":
                _viajesFilters.FechaDesde = today.AddDays(-7);
                _viajesFilters.FechaHasta = today;
                break;
            case "mes-actual":
                _viajesFilters.FechaDesde = new DateTime(today.Year, today.Month, 1);
                _viajesFilters.FechaHasta = today;
                break;
            case "mes-pasado":
                var firstThisMonth = new DateTime(today.Year, today.Month, 1);
                _viajesFilters.FechaDesde = firstThisMonth.AddMonths(-1);
                _viajesFilters.FechaHasta = firstThisMonth.AddDays(-1);
                break;
            case "anio-actual":
                _viajesFilters.FechaDesde = new DateTime(today.Year, 1, 1);
                _viajesFilters.FechaHasta = today;
                break;
            case "anio-pasado":
                _viajesFilters.FechaDesde = new DateTime(today.Year - 1, 1, 1);
                _viajesFilters.FechaHasta = new DateTime(today.Year - 1, 12, 31);
                break;
            case "personalizado":
                break;
            default:
                _viajesFilters.FechaDesde = null;
                _viajesFilters.FechaHasta = null;
                break;
        }
    }

