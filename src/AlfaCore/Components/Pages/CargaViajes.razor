    private void ApplyReporteRangoRapido(string value)
    {
        var normalized = NormalizeReporteRangoRapido(value);
        _reporteLiquidacionFilters.RangoRapido = normalized;

        var today = DateTime.Today;
        switch (normalized)
        {
            case CargaViajesReporteRangoRapidoKeys.Hoy:
                _reporteLiquidacionFilters.FechaDesde = today;
                _reporteLiquidacionFilters.FechaHasta = today;
                break;
            case CargaViajesReporteRangoRapidoKeys.SemanaActual:
                var startOfWeek = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
                _reporteLiquidacionFilters.FechaDesde = startOfWeek;
                _reporteLiquidacionFilters.FechaHasta = startOfWeek.AddDays(6);
                break;
            case CargaViajesReporteRangoRapidoKeys.MesActual:
                var firstOfMonth = new DateTime(today.Year, today.Month, 1);
                _reporteLiquidacionFilters.FechaDesde = firstOfMonth;
                _reporteLiquidacionFilters.FechaHasta = firstOfMonth.AddMonths(1).AddDays(-1);
                break;
            case CargaViajesReporteRangoRapidoKeys.MesAnterior:
                var firstOfPrevMonth = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
                _reporteLiquidacionFilters.FechaDesde = firstOfPrevMonth;
                _reporteLiquidacionFilters.FechaHasta = firstOfPrevMonth.AddMonths(1).AddDays(-1);
                break;
            case CargaViajesReporteRangoRapidoKeys.AnioActual:
                _reporteLiquidacionFilters.FechaDesde = new DateTime(today.Year, 1, 1);
                _reporteLiquidacionFilters.FechaHasta = new DateTime(today.Year, 12, 31);
                break;
            case CargaViajesReporteRangoRapidoKeys.AnioAnterior:
                var prevYear = today.Year - 1;
                _reporteLiquidacionFilters.FechaDesde = new DateTime(prevYear, 1, 1);
                _reporteLiquidacionFilters.FechaHasta = new DateTime(prevYear, 12, 31);
                break;
            case CargaViajesReporteRangoRapidoKeys.Todo:
                _reporteLiquidacionFilters.FechaDesde = null;
                _reporteLiquidacionFilters.FechaHasta = null;
                break;
            default:
                _reporteLiquidacionFilters.RangoRapido = CargaViajesReporteRangoRapidoKeys.Personalizado;
                break;
        }
    }

