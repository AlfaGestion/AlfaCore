    private IReadOnlyList<CargaViajeTarifaClienteResumenDto> GetVisibleViajeTarifas()
    {
        if (_viajeTarifasClienteRows.Count == 0)
            return [];

        var search = SearchTextHelper.Normalize(_viajeTarifasSearch);
        if (search.Length == 0)
            return _viajeTarifasClienteRows;

        return _viajeTarifasClienteRows
            .Where(tarifa =>
                SearchTextHelper.Normalize(tarifa.DestinoNombre).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.TipoVehiculoNombre).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.ListaNombre).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.FleteroNombreSugerido).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.DestinoCodigo).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.TipoVehiculoCodigo).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.ListaCodigo).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.ImporteCliente.ToString(System.Globalization.CultureInfo.InvariantCulture)).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                SearchTextHelper.Normalize(tarifa.ImporteFletero.ToString(System.Globalization.CultureInfo.InvariantCulture)).Contains(search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private IReadOnlyList<CargaViajeTarifaClienteResumenDto> GetVisibleViajeTarifasOrdered()
        => GetVisibleViajeTarifas()
            .OrderBy(tarifa => tarifa.EsTarifaGeneral ? 1 : 0)
            .ThenBy(tarifa => tarifa.DestinoNombre, StringComparer.OrdinalIgnoreCase)
            .ThenBy(tarifa => tarifa.TipoVehiculoNombre, StringComparer.OrdinalIgnoreCase)
            .ThenBy(tarifa => tarifa.ListaNombre, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private int GetViajeTarifasVisibleCount()
        => GetVisibleViajeTarifas().Count;

    private async Task<bool> IsViajeChoferFleteroAsync(string choferCodigo)
    {
        var codigo = (choferCodigo ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(codigo))
            return false;

        var result = await UiOps.RunAsync(
            () => CargaViajesSvc.SearchFleterosLookupAsync(codigo),
            "No se pudo validar el chofer seleccionado.");
        if (!result.Success || result.Value is null)
            return false;

        return result.Value.Any(item => string.Equals(item.Codigo, codigo, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SeleccionarTarifaClienteAsync(CargaViajeTarifaClienteResumenDto tarifa)
    {
        if (_viajeReadOnly)
            return;

        _viajeTarifasFeedback = null;
        _viajeTarifasSelectionHint = string.Empty;
        _viajeForm.Lista = tarifa.ListaCodigo;
        _viajeForm.ListaDisplay = FormatListaDisplay(tarifa.ListaCodigo, tarifa.ListaNombre);
        _viajeListaTexto = _viajeForm.ListaDisplay;
        _viajeListaManualOverride = true;

        _viajeForm.Destino = tarifa.DestinoCodigo;
        _viajeForm.DestinoDisplay = FormatLookupDisplay(tarifa.DestinoCodigo, tarifa.DestinoNombre);
        _viajeDestinoTexto = _viajeForm.DestinoDisplay;

        _viajeForm.TipoVehiculo = tarifa.TipoVehiculoCodigo;
        _viajeForm.TipoVehiculoDisplay = FormatLookupDisplay(tarifa.TipoVehiculoCodigo, tarifa.TipoVehiculoNombre);
        _viajeTipoVehiculoTexto = _viajeForm.TipoVehiculoDisplay;

        _viajeForm.ImporteCliente = tarifa.ImporteCliente;
        _viajeForm.ImporteFletero = 0m;
        SyncViajeMoneyTexts();

        var hadChoferSelected = !string.IsNullOrWhiteSpace(_viajeForm.Chofer);
        var currentChofer = (_viajeForm.Chofer ?? string.Empty).Trim();
        var suggestedChofer = (tarifa.FleteroCodigoSugerido ?? string.Empty).Trim();

        if (!string.IsNullOrWhiteSpace(suggestedChofer))
        {
            if (string.IsNullOrWhiteSpace(currentChofer))
            {
                _viajeForm.Chofer = suggestedChofer;
                _viajeForm.ChoferDisplay = FormatLookupDisplay(suggestedChofer, tarifa.FleteroNombreSugerido);
                _viajeChoferTexto = _viajeForm.ChoferDisplay;
                currentChofer = suggestedChofer;
            }
            else if (!string.Equals(currentChofer, suggestedChofer, StringComparison.OrdinalIgnoreCase))
            {
                _viajeTarifasSelectionHint = "La tarifa sugiere otro fletero.";
            }
        }

        if (!tarifa.TarifaFletero && hadChoferSelected && !string.IsNullOrWhiteSpace(currentChofer))
        {
            var esFletero = await IsViajeChoferFleteroAsync(currentChofer);
            if (esFletero)
            {
                // Mismo importe que muestra el listado de tarifas del cliente (SelectBestFleteroCandidate
                // en el servidor), en vez de recalcularlo atado exactamente al chofer asignado: la tarifa
                // general de destino/tipo vehículo puede estar cargada bajo otro chofer (ej. "General").
                _viajeForm.ImporteFletero = tarifa.ImporteFletero;
                SyncViajeMoneyTexts();
                if (!string.IsNullOrWhiteSpace(suggestedChofer) && !string.Equals(currentChofer, suggestedChofer, StringComparison.OrdinalIgnoreCase))
                {
                    _viajeTarifasSelectionHint = $"Importe fletero de la tarifa general (sugerida para {DisplayText(tarifa.FleteroNombreSugerido, suggestedChofer)}).";
                }
            }
            else
            {
                _viajeForm.ImporteFletero = 0m;
                SyncViajeMoneyTexts();
                _viajeTarifasSelectionHint = string.IsNullOrWhiteSpace(suggestedChofer)
                    ? "El chofer seleccionado no es fletero."
                    : $"El chofer seleccionado no es fletero: {DisplayText(tarifa.FleteroNombreSugerido, suggestedChofer)}";
            }
        }
        else
        {
            _viajeForm.ImporteFletero = 0m;
            SyncViajeMoneyTexts();
            if (!hadChoferSelected)
                _viajeTarifasSelectionHint = "Seleccione un chofer fletero para sumar la tarifa fletero.";
        }

        var detalleResult = await UiOps.RunAsync(
            () => CargaViajesSvc.GetTarifaByIdAsync(tarifa.ListaCodigo),
            "No se pudo cargar el detalle de la tarifa seleccionada.");
        if (detalleResult.Success && detalleResult.Value is not null)
        {
            ApplyVisibleAdicionalesGeneralesFromTarifa(detalleResult.Value);
            ClearVisibleAdicionalesGeneralesSelection();
            _viajeForm.AdicionalFijo1Descripcion = detalleResult.Value.AdicionalFijo1Descripcion;
            _viajeForm.AdicionalFijo1Importe = detalleResult.Value.AdicionalFijo1Importe;
            _viajeForm.AdicionalFijo1PideCantidad = detalleResult.Value.AdicionalFijo1PideCantidad;
            _viajeForm.AdicionalFijo1Cantidad = 1m;
            _viajeForm.AdicionalFijo2Descripcion = detalleResult.Value.AdicionalFijo2Descripcion;
            _viajeForm.AdicionalFijo2Importe = detalleResult.Value.AdicionalFijo2Importe;
            _viajeForm.AdicionalFijo2PideCantidad = detalleResult.Value.AdicionalFijo2PideCantidad;
            _viajeForm.AdicionalFijo2Cantidad = 1m;
            _viajeForm.AdicionalFijo3Descripcion = detalleResult.Value.AdicionalFijo3Descripcion;
            _viajeForm.AdicionalFijo3Importe = detalleResult.Value.AdicionalFijo3Importe;
            _viajeForm.AdicionalFijo3PideCantidad = detalleResult.Value.AdicionalFijo3PideCantidad;
            _viajeForm.AdicionalFijo3Cantidad = 1m;
            _viajeForm.AdicionalFijo1Aplicado = false;
            _viajeForm.AdicionalFijo2Aplicado = false;
            _viajeForm.AdicionalFijo3Aplicado = false;
            SyncViajeAdicionalesFijosFromForm();
        }
        else if (!detalleResult.Success)
        {
            _viajeTarifasFeedback = detalleResult.Feedback;
        }

        // Mismos importes que muestra el listado de tarifas del cliente (misma lógica de
        // selección que ImporteFletero), no una tarifa fletero recalculada aparte.
        _viajeForm.AdicionalFijo1ImporteFletero = tarifa.AdicionalFijo1ImporteFletero;
        _viajeForm.AdicionalFijo2ImporteFletero = tarifa.AdicionalFijo2ImporteFletero;
        _viajeForm.AdicionalFijo3ImporteFletero = tarifa.AdicionalFijo3ImporteFletero;

        _viajeDirty = true;
        _showViajeTarifasClientePanel = false;
        SyncViajeMoneyTexts();
        await Task.CompletedTask;
    }

