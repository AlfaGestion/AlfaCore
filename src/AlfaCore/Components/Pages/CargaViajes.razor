                    <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltrosLiquidacionesAsync" disabled="@_liquidacionesLoading">Limpiar filtros</button>
                    <button type="button"
                            class="btn btn--ghost btn--sm"
                            @onclick="SeleccionarPendientesVisiblesAsync"
