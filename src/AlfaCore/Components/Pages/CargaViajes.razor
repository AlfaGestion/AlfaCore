                        <button type="button" class="btn btn--primary" @onclick="GuardarConfiguracionTipoVehiculoVistaAsync">Guardar vista</button>
                        <button type="button" class="btn btn--ghost" @onclick="CancelarConfiguracionTipoVehiculoVista">Cancelar</button>
                    </footer>
