    private static string FormatMoney(decimal value)
        => value.ToString("C2", MoneyCulture);
    private static string FormatMoneyInput(decimal value)
        => value.ToString("N2", MoneyCulture);

    private static bool TryParseMoneyInput(string? value, out decimal result)
    {
        var text = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(text))
        {
            result = 0m;
            return true;
        }

        text = text.Replace("$", string.Empty, StringComparison.Ordinal).Replace(" ", string.Empty, StringComparison.Ordinal);
        if (decimal.TryParse(text, System.Globalization.NumberStyles.Currency | System.Globalization.NumberStyles.Number, MoneyCulture, out result))
            return true;

        text = text.Replace(".", string.Empty, StringComparison.Ordinal).Replace(",", ".", StringComparison.Ordinal);
        return decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out result);
    }

