    private async Task RecargarChoferesAsync()
    {
        _choferesLoading = true;
        _choferesFilters.PageSize = 50;
        var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchChoferesAsync(_choferesFilters), "No se pudieron cargar los choferes.");
        if (result.Success && result.Value is not null)
        {
            var totalPages = Math.Max(1, result.Value.TotalPages);
            if (result.Value.Total > 0 && _choferesFilters.PageNumber > totalPages)
            {
                _choferesLoading = false;
                _choferesFilters.PageNumber = totalPages;
                await RecargarChoferesAsync();
                return;
            }

            _choferes.Clear();
            _choferes.AddRange(result.Value.Items);
            _choferesTotal = result.Value.Total;
            _choferesTotalPages = totalPages;
            _choferesPage = Math.Min(Math.Max(1, result.Value.PageNumber), _choferesTotalPages);
            _choferesFilters.PageNumber = _choferesPage;
        }
        else _feedback = result.Feedback;
        _choferesLoading = false;
    }

