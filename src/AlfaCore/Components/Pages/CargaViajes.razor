    private async Task<string> GetTarifasExcelUrlAsync()
    {
        var query = new Dictionary<string, string?>
        {
            ["agruparPor"] = NormalizeTarifasAgruparPor(_tarifasFilters.AgruparPor),
            ["texto"] = _tarifasFilters.Texto,
            ["cliente"] = _tarifasFilters.Cliente,
            ["chofer"] = _tarifasFilters.Chofer,
            ["destino"] = _tarifasFilters.Destino,
            ["tipoVehiculo"] = _tarifasFilters.TipoVehiculo,
            ["tarifaFletero"] = _tarifasFilters.TarifaFletero,
            ["activo"] = _tarifasFilters.Activo,
            ["sortBy"] = _tarifasFilters.SortBy,
            ["sortDescending"] = _tarifasFilters.SortDescending ? "true" : "false",
            ["token"] = await GetUserTokenAsync()
        };

        return QueryHelpers.AddQueryString(RouteContext.BuildRoute("/carga-viajes/tarifas/descargar-excel"), query!);
    }

    private IReadOnlyList<CargaViajeTarifaGroupDto> BuildTarifaGroups()
    {
        var normalized = NormalizeTarifasAgruparPor(_tarifasFilters.AgruparPor);
        if (normalized == CargaViajesViewGroupKeys.None)
        {
            return
            [
                new CargaViajeTarifaGroupDto
                {
                    ShowHeader = false,
                    Items = _tarifas.ToList(),
                    TotalImporte = _tarifas.Sum(x => x.Importe)
                }
            ];
        }

        return _tarifas
            .Select((row, index) => new { row, index })
            .GroupBy(x => new
            {
                Label = GetTarifaGroupLabel(x.row, normalized)
            })
            .Select(g => new CargaViajeTarifaGroupDto
            {
                Label = g.Key.Label,
                ShowHeader = true,
                FirstIndex = g.Min(x => x.index),
                TotalImporte = g.Sum(x => x.row.Importe),
                Items = g.Select(x => x.row).ToList()
            })
            .OrderBy(g => g.FirstIndex)
            .ToList();
    }

    private static string NormalizeTarifasAgruparPor(string? value)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            CargaViajesViewGroupKeys.Cliente => CargaViajesViewGroupKeys.Cliente,
            CargaViajesViewGroupKeys.Chofer => CargaViajesViewGroupKeys.Chofer,
            CargaViajesViewGroupKeys.Fletero => CargaViajesViewGroupKeys.Chofer,
            _ => CargaViajesViewGroupKeys.None
        };

    private static string GetTarifasAgruparPorLabel(string? value)
        => NormalizeTarifasAgruparPor(value) switch
        {
            CargaViajesViewGroupKeys.Cliente => "Cliente",
            CargaViajesViewGroupKeys.Chofer => "Chofer / fletero",
            _ => "Sin agrupar"
        };

    private static string GetTarifaGroupLabel(CargaViajeTarifaGridItemDto row, string agruparPor)
        => agruparPor switch
        {
            CargaViajesViewGroupKeys.Cliente => row.TarifaFletero
                ? "Cliente: Sin cliente"
                : $"Cliente: {GetTarifaEntidadDisplay(row)}",
            CargaViajesViewGroupKeys.Chofer => row.TarifaFletero
                ? $"Chofer / fletero: {GetTarifaEntidadDisplay(row)}"
                : "Chofer / fletero: Sin chofer / fletero",
            _ => string.Empty
        };

    private async Task RecargarTarifasAsync()
    {
        _tarifasLoading = true;
        _tarifasFilters.PageSize = 10;
        var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchTarifasAsync(_tarifasFilters), "No se pudieron cargar las tarifas.");
        if (result.Success && result.Value is not null)
        {
            var totalPages = Math.Max(1, result.Value.TotalPages);
            if (result.Value.Total > 0 && _tarifasFilters.PageNumber > totalPages)
            {
                _tarifasLoading = false;
                _tarifasFilters.PageNumber = totalPages;
                await RecargarTarifasAsync();
                return;
            }

            _tarifas.Clear();
            _tarifas.AddRange(result.Value.Items);
            _tarifasTotal = result.Value.Total;
            _tarifasTotalPages = totalPages;
            _tarifasPage = Math.Min(Math.Max(1, result.Value.PageNumber), _tarifasTotalPages);
            _tarifasFilters.PageNumber = _tarifasPage;
        }
        else _feedback = result.Feedback;
        _tarifasLoading = false;
    }

