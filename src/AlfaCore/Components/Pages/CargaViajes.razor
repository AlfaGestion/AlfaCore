                                        <option value="@CargaViajeTipoVehiculoViewGroupKeys.Activo">Activo / Inactivo</option>
                                    }
                                </select>
                            </div>

                            <div class="usuarios-view-settings__list">
                                @foreach (var column in _tipoVehiculoViewSettingsDraft.Columnas.OrderBy(c => c.Order))
                                {
                                    <div class="usuarios-view-settings__item">
                                        <label class="checkbox">
                                            <input type="checkbox" checked="@column.Visible" @onchange="args => ToggleTipoVehiculoViewColumn(column.Key, args)" />
                                            <span>@column.Label</span>
                                        </label>
                                        <div class="actions">
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveTipoVehiculoViewColumn(column.Key, -1)">↑</button>
                                            <button type="button" class="btn btn--ghost btn--sm" @onclick="() => MoveTipoVehiculoViewColumn(column.Key, 1)">↓</button>
                                        </div>
