    private void ToggleTipoVehiculoViewColumn(string key)
    {
        var column = _tipoVehiculoViewSettingsDraft.Columnas.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is null)
            return;

        column.Visible = !column.Visible;
        if (!_tipoVehiculoViewSettingsDraft.Columnas.Any(c => c.Visible))
            column.Visible = true;
    }

    private void MoveTipoVehiculoViewColumn(string key, int offset)
    {
        var ordered = _tipoVehiculoViewSettingsDraft.Columnas.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
            return;

        var target = index + offset;
        if (target < 0 || target >= ordered.Count)
            return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
        _tipoVehiculoViewSettingsDraft.Columnas = ordered;
    }

    private async Task GuardarConfiguracionTipoVehiculoVistaAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            _feedback = new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Sesión requerida", Message = "Necesitás iniciar sesión para guardar la configuración de vista." };
            return;
        }

        var settings = new CargaViajeTipoVehiculoViewSettingsDto { AgruparPor = _tipoVehiculoDraftAgruparPor, Columnas = CloneTipoVehiculoViewSettings(_tipoVehiculoViewSettingsDraft).Columnas };
        try
        {
            await CargaViajesSvc.SaveTipoVehiculoViewSettingsAsync(currentUser, settings);
        }
        catch (Exception ex)
        {
            _feedback = UiOps.BuildMessage(ex, "No se pudo guardar la configuración de vista del tipo de vehículo.");
            return;
        }

        _tipoVehiculoViewSettings = settings;
