    private async Task ToggleLiquidacionesGrupoSeleccionAsync(CargaViajeLiquidacionGroupDto group)
    {
        var selectableRows = group.Items.Where(x => !x.FletePagado).ToList();
        if (selectableRows.Count == 0)
        {
            await Task.CompletedTask;
            return;
        }

        var allSelected = selectableRows.All(x => _liquidacionesSeleccionadas.Contains(x.Id));
        if (allSelected)
        {
            foreach (var row in selectableRows)
                _liquidacionesSeleccionadas.Remove(row.Id);
        }
        else
        {
            foreach (var row in selectableRows)
                _liquidacionesSeleccionadas.Add(row.Id);
        }

        RecalcularTotalSeleccionado();
        await Task.CompletedTask;
    }

    private async Task ToggleLiquidacionSeleccionAsync(int id)
    {
        var row = _liquidacionesRows.FirstOrDefault(x => x.Id == id);
