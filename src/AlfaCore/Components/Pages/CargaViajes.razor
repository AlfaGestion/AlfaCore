    private async Task HandleViajesFilterKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            await AplicarFiltrosViajesAsync();
    }

    private async Task HandleModalKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            return;

        if (_showViewSettings)
            await CancelarConfiguracionVista();
        else if (_showConfigEditor)
            await CerrarConfiguracionModulo();
        else if (_showTarifaEditor)
            await CerrarTarifaEditorAsync();
        else if (_showChoferEditor)
            await CerrarChoferEditorAsync();
        else if (_showDestinoEditor)
            await CerrarDestinoEditorAsync();
        else if (_showTipoVehiculoViewSettings)
            await CancelarConfiguracionTipoVehiculoVista();
        else if (_showTipoVehiculoEditor)
            await CerrarTipoVehiculoEditorAsync();
        else if (_showLiquidacionesPagoModal)
            await CerrarLiquidacionesPagoModalAsync();
        else if (_showViajeEditor)
            await CerrarViajeEditorAsync();
    }

    private async Task NavigateSectionAsync(string section, bool preserveDialog = false)
    {
        var normalized = NormalizeSection(section);
        if (HasAnyPendingChanges())
        {
            var abandon = await ShowPendingChangesConfirmAsync(
                "Tiene cambios sin guardar.\n¿Desea abandonar la carga?",
                "Abandonar",
                "Continuar editando");
            if (!abandon)
                return;

            await ForceNavigateSectionAsync(normalized);
            return;
        }

        if (!preserveDialog)
            await AppDialogs.HideAsync();

        await ForceNavigateSectionAsync(normalized);
    }

    private async Task ForceNavigateSectionAsync(string normalized)
    {
        ClearMessages();
        await ForceCloseAllEditorsAsync();
        Nav.NavigateTo(normalized == SectionViajes ? "/carga-viajes" : $"/carga-viajes/{normalized}");
    }

    private Task ForceCloseAllEditorsAsync()
    {
        _showViewSettings = false;
        _showConfigEditor = false;
        _showTarifaEditor = false;
        _showChoferEditor = false;
        _showDestinoEditor = false;
        _showTipoVehiculoViewSettings = false;
        _showTipoVehiculoEditor = false;
        _showViajeEditor = false;
        _showLiquidacionesPagoModal = false;
        _viajeReadOnly = false;
        _viajeDirty = false;
        _viajeSnapshot = string.Empty;
        _tarifaSnapshot = string.Empty;
        _choferSnapshot = string.Empty;
        _destinoSnapshot = string.Empty;
        _tipoVehiculoSnapshot = string.Empty;
        _configSnapshot = string.Empty;
        _viewSettingsSnapshot = string.Empty;
        _tipoVehiculoViewSettingsSnapshot = string.Empty;
        _tarifasQuickImportEditMode = false;
        _tarifasQuickImportEditId = 0;
        _tarifasQuickImportRowIndex = -1;
        _tarifasQuickImportValue = 0m;
        _tarifasQuickImportOriginal = string.Empty;
        return Task.CompletedTask;
    }

    private bool HasAnyPendingChanges()
        => (_showViajeEditor && HasViajePendingChanges())
            || (_showTarifaEditor && HasTarifaPendingChanges())
            || (_showChoferEditor && HasChoferPendingChanges())
            || (_showDestinoEditor && HasDestinoPendingChanges())
            || (_showTipoVehiculoEditor && HasTipoVehiculoPendingChanges())
            || (_showConfigEditor && HasConfigPendingChanges())
            || (_showViewSettings && HasViewSettingsPendingChanges())
            || (_showTipoVehiculoViewSettings && HasTipoVehiculoViewSettingsPendingChanges());

    private static string NormalizeSection(string? value)
        => (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            SectionTarifas => SectionTarifas,
            SectionNuevo => SectionNuevo,
            SectionChoferes => SectionChoferes,
            SectionDestinos => SectionDestinos,
            SectionTipoVehiculo => SectionTipoVehiculo,
            SectionReportes => SectionReportes,
            SectionLiquidaciones => SectionLiquidaciones,
            SectionConfiguracion => SectionConfiguracion,
            _ => SectionViajes
        };

