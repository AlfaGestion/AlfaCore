                                                       disabled="@(!habilitado)"
                                                       @onchange="args => OnConfigAdicionalSumarFleteroChangedAsync(index, args)" />
                                                <span>Sumar a fleteros</span>
                                            </label>
                                        }
                                        <label class="carga-viajes-config-adicionales__toggle @(habilitado && GetConfigAdicionalEsPorcentaje(index) ? "carga-viajes-config-adicionales__toggle--on" : string.Empty)">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   checked="@GetConfigAdicionalEsPorcentaje(index)"
                                                   disabled="@(!habilitado)"
                                                   @onchange="args => OnConfigAdicionalEsPorcentajeChangedAsync(index, args)" />
                                            <span>Es Porcentaje</span>
                                        </label>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                </div>

                <footer class="cuentas-modal__actions">
                    <button type="button" class="btn btn--primary" @ref="_configGuardarButton" @onclick="GuardarConfiguracionModuloAsync">Guardar configuración</button>
                    <button type="button" class="btn btn--ghost" @onclick="CerrarConfiguracionModulo">Cerrar</button>
                </footer>
            </section>
        </div>
    }
</div>

