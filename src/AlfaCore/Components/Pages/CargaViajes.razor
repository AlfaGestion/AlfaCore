    private void SyncViajeAdicionalesFijosFromForm()
    {
        _viajeForm.AdicionalFijo1Aplicado = _viajeForm.AdicionalFijo1Aplicado && HasViajeAdicionalFijo(_viajeForm.AdicionalFijo1Descripcion, _viajeForm.AdicionalFijo1Importe);
        _viajeForm.AdicionalFijo2Aplicado = _viajeForm.AdicionalFijo2Aplicado && HasViajeAdicionalFijo(_viajeForm.AdicionalFijo2Descripcion, _viajeForm.AdicionalFijo2Importe);
        _viajeForm.AdicionalFijo3Aplicado = _viajeForm.AdicionalFijo3Aplicado && HasViajeAdicionalFijo(_viajeForm.AdicionalFijo3Descripcion, _viajeForm.AdicionalFijo3Importe);
        _viajeForm.TotalAdicionalesFijos = GetViajeTotalAdicionalesFijos();
    }

    private decimal GetViajeAdicionalRawPercent(int index)
        => index switch
        {
            0 => _viajeForm.PorcentajeAdic,
            1 => _viajeForm.PorcentajeAdic1,
            2 => _viajeForm.PorcentajeAdic2,
            3 => _viajeForm.PorcentajeAdic3,
            4 => _viajeForm.PorcentajeAdic4,
            _ => 0m
        };

    private void ApplyViajeAdicionalesToFormForSave()
    {
        var enabledCount = GetAdicionalesHabilitadosCount();
        if (enabledCount > 0)
            _viajeForm.PorcentajeAdic = _viajeAdicionalesActivos[0] ? GetViajeAdicionalPercent(0) : 0m;
        if (enabledCount > 1)
            _viajeForm.PorcentajeAdic1 = _viajeAdicionalesActivos[1] ? GetViajeAdicionalPercent(1) : 0m;
        if (enabledCount > 2)
            _viajeForm.PorcentajeAdic2 = _viajeAdicionalesActivos[2] ? GetViajeAdicionalPercent(2) : 0m;
        if (enabledCount > 3)
            _viajeForm.PorcentajeAdic3 = _viajeAdicionalesActivos[3] ? GetViajeAdicionalPercent(3) : 0m;
        if (enabledCount > 4)
            _viajeForm.PorcentajeAdic4 = _viajeAdicionalesActivos[4] ? GetViajeAdicionalPercent(4) : 0m;
    }

