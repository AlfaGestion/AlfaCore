        _viajeListaTexto = string.Empty;
        _viajeListaManualOverride = false;
        _viajeForm.ClienteDisplay = string.Empty;
        _viajeForm.ChoferDisplay = string.Empty;
        _viajeForm.DestinoDisplay = string.Empty;
        _viajeForm.TipoVehiculoDisplay = string.Empty;
        _viajeForm.ListaDisplay = string.Empty;
        SyncViajeAdicionalesFromForm();
        _viajeEditorFeedback = null;
        _viajeSnapshot = CaptureViajeSnapshot(_viajeForm);
        _viajeDirty = false;
        await Task.CompletedTask;
    }

    private async Task GuardarViajeAsync()
    {
        if (_savingViaje)
            return;

        _savingViaje = true;
        await AppDialogs.ShowBusyAsync("Generando viaje", "Estamos registrando el viaje. No cierres esta ventana.");

        try
        {
            ApplyViajeAdicionalesToFormForSave();
            LogViajeDraftBeforeSave();
            var savedId = await CargaViajesSvc.SaveViajeAsync(_viajeForm);
            _showViajeEditor = false;
            _viajeReadOnly = false;
            _viajeSnapshot = string.Empty;
            _viajeDirty = false;
            _viajesFilters.PageNumber = 1;
            await RecargarViajesAsync();
            await NavigateSectionAsync(SectionViajes, preserveDialog: true);
            var idComprobante = string.IsNullOrWhiteSpace(_viajeForm.IdComprobante) ? $"#{savedId}" : _viajeForm.IdComprobante;
            await AppDialogs.ShowSuccessAsync("Viaje guardado correctamente", $"El viaje {idComprobante} quedó registrado correctamente.");
        }
        catch (AppValidationException validationEx)
        {
            var message = BuildValidationFeedback(validationEx);
            await AppDialogs.ShowMessageAsync(
                message.Severity,
                message.Title,
                FormatFeedbackMessage(message),
                message.HasSuggestion ? message.Suggestion : string.Empty);
        }
        catch (Exception ex)
        {
            var message = UiOps.BuildMessage(ex, "No se pudo guardar el viaje.");
            await AppDialogs.ShowMessageAsync(
                message.Severity,
                message.Title,
                FormatFeedbackMessage(message),
                message.HasSuggestion ? message.Suggestion : string.Empty);
        }
        finally
        {
            _savingViaje = false;
        }
    }

    private async Task LimpiarViajeFormAsync()
    {
        if (_showViajeEditor && HasViajePendingChanges())
        {
            var abandon = await ShowPendingChangesConfirmAsync(
                "Se perderán todos los datos ingresados.\n¿Desea continuar?",
                "Limpiar",
                "Cancelar");
            if (!abandon)
                return;

            await AbrirNuevoViajeAsync();
            return;
        }

        await AbrirNuevoViajeAsync();
    }

    private async Task CerrarViajeEditorAsync()
    {
        if (_showViajeEditor && HasViajePendingChanges())
        {
            var abandon = await ShowPendingChangesConfirmAsync(
                "Tiene cambios sin guardar.\n¿Desea abandonar la carga?",
                "Abandonar",
                "Continuar editando");
            if (!abandon)
                return;

            await ForceCerrarViajeEditorAsync();
            return;
        }

        await ForceCerrarViajeEditorAsync();
    }

    private Task ForceCerrarViajeEditorAsync()
    {
        _showViajeEditor = false;
        _viajeReadOnly = false;
        _viajeEditorFeedback = null;
        _viajeSnapshot = string.Empty;
        _viajeDirty = false;
        if (_activeSection == SectionNuevo)
            return NavigateSectionAsync(SectionViajes);

        return Task.CompletedTask;
    }

    private async Task AnularViajeAsync(int id)
    {
        var result = await UiOps.RunAsync(() => CargaViajesSvc.AnularViajeAsync(id, AppUserSession.GetCurrentUserName(string.Empty)), "No se pudo anular el viaje.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
