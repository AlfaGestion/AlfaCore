    private IReadOnlyList<FilterChipItem> BuildTarifasFilterChips()
    {
        var chips = new List<FilterChipItem>();
        AddChipIfPresent(chips, "tarifas-cliente", "Cliente", _tarifasFilters.Cliente);
        AddChipIfPresent(chips, "tarifas-chofer", "Chofer", _tarifasFilters.Chofer);
        AddChipIfPresent(chips, "tarifas-destino", "Destino", _tarifasFilters.Destino);
        AddChipIfPresent(chips, "tarifas-tipo-vehiculo", "Tipo vehículo", _tarifasFilters.TipoVehiculo);

        if (_tarifasFilters.TarifaFletero is "0" or "1")
            chips.Add(new FilterChipItem("tarifas-tipo", _tarifasFilters.TarifaFletero == "0" ? "Tipo: Clientes" : "Tipo: Fleteros"));

        if (!string.IsNullOrWhiteSpace(_tarifasFilters.Activo))
            chips.Add(new FilterChipItem("tarifas-activo", _tarifasFilters.Activo == "1" ? "Activo: Activo" : "Activo: Desactivado"));

        if (!string.IsNullOrWhiteSpace(_tarifasFilters.AgruparPor))
            chips.Add(new FilterChipItem("tarifas-agrupar", $"Agrupar: {GetTarifasAgruparPorLabel(_tarifasFilters.AgruparPor)}"));

        return chips;
    }

    private async Task RemoveTarifasFilterChipAsync(string key)
    {
        switch ((key ?? string.Empty).Trim().ToLowerInvariant())
        {
            case "tarifas-cliente":
                _tarifasFilters.Cliente = string.Empty;
                break;
            case "tarifas-chofer":
                _tarifasFilters.Chofer = string.Empty;
                break;
            case "tarifas-destino":
                _tarifasFilters.Destino = string.Empty;
                break;
            case "tarifas-tipo-vehiculo":
                _tarifasFilters.TipoVehiculo = string.Empty;
                break;
            case "tarifas-tipo":
                _tarifasFilters.TarifaFletero = string.Empty;
                break;
            case "tarifas-activo":
                _tarifasFilters.Activo = string.Empty;
                break;
            case "tarifas-agrupar":
                _tarifasFilters.AgruparPor = string.Empty;
                break;
            default:
                return;
        }

        await AplicarFiltrosTarifasAsync();
