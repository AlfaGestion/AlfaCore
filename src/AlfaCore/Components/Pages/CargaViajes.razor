    private Task ToggleTarifaAumentoSelectionAsync(CargaViajeTarifaGridItemDto row, ChangeEventArgs args)
    {
        if (row.Id <= 0)
            return Task.CompletedTask;

        var isSelected = args.Value is bool flag && flag;
        if (isSelected)
            _tarifasAumentoSeleccionadas.Add(row.Id);
        else
            _tarifasAumentoSeleccionadas.Remove(row.Id);

        _tarifasAumentoSimulada = false;
        return Task.CompletedTask;
    }

    private async Task ToggleSelectAllTarifasAumentoAsync(ChangeEventArgs args)
    {
        var selectAll = args.Value is bool flag && flag;
