                <span><strong>Seleccionados:</strong> @_liquidacionesSeleccionadas.Count</span>
                <span><strong>Total seleccionado:</strong> @_liquidacionesTotalSeleccionado.ToString("N2")</span>
                <span><strong>Total pendiente:</strong> @GetLiquidacionesTotalPendienteVisible().ToString("N2")</span>
