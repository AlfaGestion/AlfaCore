    private async Task ActualizarTarifaClienteAsync()
    {
        if (_viajeListaManualOverride)
            return;

        if (string.IsNullOrWhiteSpace(_viajeForm.Cliente) || string.IsNullOrWhiteSpace(_viajeForm.Destino) || string.IsNullOrWhiteSpace(_viajeForm.TipoVehiculo))
        {
            _viajeForm.ImporteCliente = 0m;
            ResetVisibleAdicionalesGenerales();
            _viajeForm.AdicionalFijo1Descripcion = string.Empty;
            _viajeForm.AdicionalFijo1Importe = 0m;
            _viajeForm.AdicionalFijo1Aplicado = false;
            _viajeForm.AdicionalFijo2Descripcion = string.Empty;
            _viajeForm.AdicionalFijo2Importe = 0m;
            _viajeForm.AdicionalFijo2Aplicado = false;
            _viajeForm.AdicionalFijo3Descripcion = string.Empty;
            _viajeForm.AdicionalFijo3Importe = 0m;
            _viajeForm.AdicionalFijo3Aplicado = false;
            _viajeForm.TotalAdicionalesFijos = 0m;
            return;
        }

        var result = await UiOps.RunAsync(() => CargaViajesSvc.GetTarifaClienteAsync(_viajeForm.Cliente, _viajeForm.Destino, _viajeForm.TipoVehiculo), "No se pudo calcular la tarifa cliente.");
        if (!result.Success)
        {
            _feedback = result.Feedback;
            return;
        }

        var tarifa = result.Value;
        if (tarifa is null)
        {
            _viajeForm.ImporteCliente = 0m;
            ResetVisibleAdicionalesGenerales();
            _viajeForm.AdicionalFijo1Descripcion = string.Empty;
            _viajeForm.AdicionalFijo1Importe = 0m;
            _viajeForm.AdicionalFijo1Aplicado = false;
            _viajeForm.AdicionalFijo2Descripcion = string.Empty;
            _viajeForm.AdicionalFijo2Importe = 0m;
            _viajeForm.AdicionalFijo2Aplicado = false;
            _viajeForm.AdicionalFijo3Descripcion = string.Empty;
            _viajeForm.AdicionalFijo3Importe = 0m;
            _viajeForm.AdicionalFijo3Aplicado = false;
            _viajeForm.TotalAdicionalesFijos = 0m;
            return;
        }

        _viajeForm.Lista = tarifa.IdLista;
        _viajeForm.ListaDisplay = FormatListaDisplay(tarifa.IdLista, tarifa.Nombre);
        _viajeListaTexto = _viajeForm.ListaDisplay;
        _viajeForm.ImporteCliente = tarifa.Importe;
        ApplyVisibleAdicionalesGeneralesFromTarifa(tarifa);
        _viajeForm.AdicionalFijo1Descripcion = tarifa.AdicionalFijo1Descripcion;
        _viajeForm.AdicionalFijo1Importe = tarifa.AdicionalFijo1Importe;
        _viajeForm.AdicionalFijo2Descripcion = tarifa.AdicionalFijo2Descripcion;
        _viajeForm.AdicionalFijo2Importe = tarifa.AdicionalFijo2Importe;
        _viajeForm.AdicionalFijo3Descripcion = tarifa.AdicionalFijo3Descripcion;
        _viajeForm.AdicionalFijo3Importe = tarifa.AdicionalFijo3Importe;
        _viajeForm.AdicionalFijo1Aplicado = false;
        _viajeForm.AdicionalFijo2Aplicado = false;
        _viajeForm.AdicionalFijo3Aplicado = false;
        SyncViajeAdicionalesFromForm();
        SyncViajeAdicionalesFijosFromForm();
    }

