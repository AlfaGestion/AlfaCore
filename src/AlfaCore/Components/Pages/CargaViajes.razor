    private bool GetConfigAdicionalHabilitado(int index)
        => index >= 0
           && index < _config.AdicionalesHabilitados.Length
           && _config.AdicionalesHabilitados[index];

    private bool GetConfigAdicionalSumarFletero(int index)
        => index >= 0
           && index < _config.AdicionalesSumarFletero.Length
           && index != 5
           && _config.AdicionalesSumarFletero[index];

    private bool GetConfigAdicionalEsPorcentaje(int index)
        => index < 0
           || index >= _config.EsPorcentajeAdicionales.Length
           || _config.EsPorcentajeAdicionales[index];

    private Task OnConfigAdicionalHabilitadoChangedAsync(int index, ChangeEventArgs args)
    {
        if (index < 0 || index >= _config.AdicionalesHabilitados.Length)
            return Task.CompletedTask;

        var enabled = args.Value is bool flag && flag;
        _config.AdicionalesHabilitados[index] = enabled;
        if (!enabled)
            _config.AdicionalesSumarFletero[index] = false;

        return Task.CompletedTask;
    }

    private Task OnConfigAdicionalSumarFleteroChangedAsync(int index, ChangeEventArgs args)
    {
        if (index < 0 || index >= _config.AdicionalesSumarFletero.Length || index == 5)
            return Task.CompletedTask;

        if (!GetConfigAdicionalHabilitado(index))
        {
            _config.AdicionalesSumarFletero[index] = false;
            return Task.CompletedTask;
        }

        _config.AdicionalesSumarFletero[index] = args.Value is bool flag && flag;
        return Task.CompletedTask;
    }

    private Task OnConfigAdicionalEsPorcentajeChangedAsync(int index, ChangeEventArgs args)
    {
        if (index < 0 || index >= _config.EsPorcentajeAdicionales.Length)
            return Task.CompletedTask;

        _config.EsPorcentajeAdicionales[index] = args.Value is bool flag && flag;
        return Task.CompletedTask;
    }

