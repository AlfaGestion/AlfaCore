    private static string FormatLookupDisplay(string code, string description)
    {
        var cleanCode = (code ?? string.Empty).Trim();
        var cleanDescription = (description ?? string.Empty).Trim();
        return string.IsNullOrWhiteSpace(cleanDescription)
            ? cleanCode
            : cleanDescription;
    }

    private static string FormatListaDisplay(string lista, string descripcion)
    {
        var display = FormatLookupDisplay(lista, descripcion);
        return string.IsNullOrWhiteSpace(display) ? string.Empty : display;
    }

    private static string DisplayText(string? description, string? fallbackCode)
    {
        var visible = (description ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(visible))
            return visible;

        return (fallbackCode ?? string.Empty).Trim();
    }

    private static string ExtractCodeFromDisplay(string? display)
    {
        var value = (display ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var separator = value.IndexOf(" - ", StringComparison.Ordinal);
        if (separator <= 0)
            return value;

        return value[..separator].Trim();
    }

    private static string ExtractVisibleText(string? display)
    {
        var value = (display ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var separator = value.IndexOf(" - ", StringComparison.Ordinal);
        if (separator < 0)
            return value;

        var visible = value[(separator + 3)..].Trim();
        return string.IsNullOrWhiteSpace(visible) ? value : visible;
    }

    private static AppUiMessage BuildValidationFeedback(AppValidationException validationEx)
    {
        var issues = validationEx.Validation.Issues
            .Select(issue => (issue.Message ?? string.Empty).Trim())
            .Where(message => !string.IsNullOrWhiteSpace(message))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return new AppUiMessage
        {
            Severity = AppUiFeedbackSeverity.Warning,
            Title = "Revisá los campos marcados",
            Message = issues.Count == 0
                ? validationEx.UserMessage
                : string.Join(Environment.NewLine, issues),
            Suggestion = "Corregí los campos marcados y volvé a intentar."
        };
    }

    private void LogViajeDraftBeforeSave()
    {
        Logger.LogInformation(
            "UI SaveViaje draft Cliente={Cliente} Chofer={Chofer} Destino={Destino} TipoVehiculo={TipoVehiculo} Lista={Lista} ImporteCliente={ImporteCliente} Fecha={Fecha:yyyy-MM-dd} Adic0={Adic0} Adic1={Adic1} Adic2={Adic2} Adic3={Adic3} Adic4={Adic4}",
            _viajeForm.Cliente,
            _viajeForm.Chofer,
            _viajeForm.Destino,
            _viajeForm.TipoVehiculo,
            _viajeForm.Lista,
            _viajeForm.ImporteCliente,
            _viajeForm.Fecha,
            GetViajeAdicionalChecked(0),
            GetViajeAdicionalChecked(1),
            GetViajeAdicionalChecked(2),
            GetViajeAdicionalChecked(3),
            GetViajeAdicionalChecked(4));
    }

    private bool GetViajeAdicionalChecked(int index)
        => index < GetAdicionalesHabilitadosCount()
           && index switch
           {
               0 => _viajeAdicionalesActivos[0],
               1 => _viajeAdicionalesActivos[1],
               2 => _viajeAdicionalesActivos[2],
               3 => _viajeAdicionalesActivos[3],
               4 => _viajeAdicionalesActivos[4],
               _ => false
           };

    private string GetViajeAdicionalPercentText(int index)
        => index < GetAdicionalesHabilitadosCount()
            ? $"{GetViajeAdicionalPercent(index):0.##}%"
            : string.Empty;

    private decimal GetViajeAdicionalPercent(int index)
        => index >= GetAdicionalesHabilitadosCount()
            ? 0m
            : index switch
        {
            0 => ResolvePercentOrDefault(_viajeForm.PorcentajeAdic, 0),
            1 => ResolvePercentOrDefault(_viajeForm.PorcentajeAdic1, 1),
            2 => ResolvePercentOrDefault(_viajeForm.PorcentajeAdic2, 2),
            3 => ResolvePercentOrDefault(_viajeForm.PorcentajeAdic3, 3),
            4 => ResolvePercentOrDefault(_viajeForm.PorcentajeAdic4, 4),
            _ => 0m
        };

    private decimal GetViajeAdicionalImporte(int index)
    {
        if (index >= GetAdicionalesHabilitadosCount())
            return 0m;

        if (!_viajeAdicionalesActivos[index])
            return 0m;

        var baseImporte = Math.Max(0m, _viajeForm.ImporteCliente) * Math.Max(1, _viajeForm.CantidadViajes);
        return baseImporte * GetViajeAdicionalPercent(index) / 100m;
    }

    private decimal GetViajeTotalAdicionales()
        => Enumerable.Range(0, GetAdicionalesHabilitadosCount()).Sum(GetViajeAdicionalImporte);

    private bool GetViajeAdicionalFijoVisible(int index)
        => index switch
        {
            0 => HasViajeAdicionalFijo(_viajeForm.AdicionalFijo1Descripcion, _viajeForm.AdicionalFijo1Importe),
            1 => HasViajeAdicionalFijo(_viajeForm.AdicionalFijo2Descripcion, _viajeForm.AdicionalFijo2Importe),
            2 => HasViajeAdicionalFijo(_viajeForm.AdicionalFijo3Descripcion, _viajeForm.AdicionalFijo3Importe),
            _ => false
        };

    private bool GetViajeAdicionalFijoChecked(int index)
        => index switch
        {
            0 => _viajeForm.AdicionalFijo1Aplicado,
            1 => _viajeForm.AdicionalFijo2Aplicado,
            2 => _viajeForm.AdicionalFijo3Aplicado,
            _ => false
        };

    private string GetViajeAdicionalFijoDescripcion(int index)
        => index switch
        {
            0 => (_viajeForm.AdicionalFijo1Descripcion ?? string.Empty).Trim(),
            1 => (_viajeForm.AdicionalFijo2Descripcion ?? string.Empty).Trim(),
            2 => (_viajeForm.AdicionalFijo3Descripcion ?? string.Empty).Trim(),
            _ => string.Empty
        };

    private decimal GetViajeAdicionalFijoImporte(int index)
        => index switch
        {
            0 => Math.Max(0m, _viajeForm.AdicionalFijo1Importe),
            1 => Math.Max(0m, _viajeForm.AdicionalFijo2Importe),
            2 => Math.Max(0m, _viajeForm.AdicionalFijo3Importe),
            _ => 0m
        };

    private decimal GetViajeAdicionalFijoTotal(int index)
        => GetViajeAdicionalFijoChecked(index) ? GetViajeAdicionalFijoImporte(index) : 0m;

    private decimal GetViajeTotalAdicionalesFijos()
        => Enumerable.Range(0, 3).Sum(GetViajeAdicionalFijoTotal);

    private static bool HasViajeAdicionalFijo(string? descripcion, decimal importe)
        => !string.IsNullOrWhiteSpace(descripcion) && importe > 0m;

    private decimal GetViajeTotalAdicionalesGenerales()
        => GetViajeTotalAdicionales();

    private decimal GetViajeTotalViaje()
        => Math.Max(0m, _viajeForm.ImporteCliente * Math.Max(1, _viajeForm.CantidadViajes))
           + GetViajeTotalAdicionalesGenerales()
           + GetViajeTotalAdicionalesFijos()
           + Math.Max(0m, _viajeForm.Peaje);

    private async Task OnViajeAdicionalChangedAsync(int index, ChangeEventArgs args)
    {
        if (index >= GetAdicionalesHabilitadosCount())
            return;

        var enabled = args.Value is bool flag && flag;
        switch (index)
        {
            case 0: _viajeAdicionalesActivos[0] = enabled; break;
            case 1: _viajeAdicionalesActivos[1] = enabled; break;
            case 2: _viajeAdicionalesActivos[2] = enabled; break;
            case 3: _viajeAdicionalesActivos[3] = enabled; break;
            case 4: _viajeAdicionalesActivos[4] = enabled; break;
        }

        MarkViajeDirty();
        await Task.CompletedTask;
    }

    private async Task ToggleViajeAdicionalFijoAsync(int index)
    {
        switch (index)
        {
            case 0:
                _viajeForm.AdicionalFijo1Aplicado = !_viajeForm.AdicionalFijo1Aplicado;
                break;
            case 1:
                _viajeForm.AdicionalFijo2Aplicado = !_viajeForm.AdicionalFijo2Aplicado;
                break;
            case 2:
                _viajeForm.AdicionalFijo3Aplicado = !_viajeForm.AdicionalFijo3Aplicado;
                break;
        }

        _viajeForm.TotalAdicionalesFijos = GetViajeTotalAdicionalesFijos();
        MarkViajeDirty();
        await Task.CompletedTask;
    }

    private async Task ToggleViajeAdicionalAsync(int index)
    {
        if (index >= GetAdicionalesHabilitadosCount())
            return;

        _viajeAdicionalesActivos[index] = !_viajeAdicionalesActivos[index];
        MarkViajeDirty();
        await Task.CompletedTask;
    }

    private void SetViajeAdicionalPercent(int index, decimal value)
    {
        if (index >= GetAdicionalesHabilitadosCount())
            return;

        switch (index)
        {
            case 0: _viajeForm.PorcentajeAdic = value; break;
            case 1: _viajeForm.PorcentajeAdic1 = value; break;
            case 2: _viajeForm.PorcentajeAdic2 = value; break;
            case 3: _viajeForm.PorcentajeAdic3 = value; break;
            case 4: _viajeForm.PorcentajeAdic4 = value; break;
        }
    }

