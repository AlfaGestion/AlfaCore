                                            <span class="carga-viajes-adicionales__simple-name">@GetViajeAdicionalFijoDescripcion(index)</span>
                                            <span class="carga-viajes-adicionales__simple-percent">Importe fijo</span>
                                        </span>
                                        @if (GetViajeAdicionalFijoPideCantidad(index))
                                        {
                                            <div class="carga-viajes-adicionales__fixed-quantity">
                                                <span class="carga-viajes-adicionales__fixed-quantity-label">Cantidad</span>
