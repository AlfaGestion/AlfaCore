    private async Task RecargarLiquidacionesAsync()
    {
        _liquidacionesLoading = true;
        _liquidacionesConsultada = true;
        _liquidacionesRows.Clear();
        _liquidacionesSeleccionadas.Clear();
        _liquidacionesTotalSeleccionado = 0m;

        try
        {
            var result = await UiOps.RunAsync(() => CargaViajesSvc.SearchLiquidacionesFletesAsync(_liquidacionesFilters), "No se pudieron cargar las liquidaciones.");
            if (result.Success && result.Value is not null)
            {
                _liquidacionesRows.Clear();
                _liquidacionesRows.AddRange(result.Value);
                return;
            }

            _feedback = result.Feedback;
            _liquidacionesRows.Clear();
        }
        finally
        {
            _liquidacionesLoading = false;
            RecalcularTotalSeleccionado();
        }
    }

    private IReadOnlyList<CargaViajeLiquidacionGroupDto> GetLiquidacionGroups()
    {
        var groups = new List<CargaViajeLiquidacionGroupDto>();
        if (_liquidacionesFilters.IncluirChoferes)
        {
            var choferes = _liquidacionesRows.Where(x => !x.EsFletero).ToList();
            if (choferes.Count > 0)
                groups.Add(new CargaViajeLiquidacionGroupDto { EsFletero = false, Label = "CHOFERES", Items = choferes });
        }

        if (_liquidacionesFilters.IncluirFleteros)
        {
            var fleteros = _liquidacionesRows.Where(x => x.EsFletero).ToList();
            if (fleteros.Count > 0)
                groups.Add(new CargaViajeLiquidacionGroupDto { EsFletero = true, Label = "FLETEROS", Items = fleteros });
        }

        return groups;
    }

