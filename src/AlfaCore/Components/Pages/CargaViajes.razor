    private decimal ApplyTarifasAumentoPreview(decimal current)
    {
        var next = _tarifasAumentoMode switch
        {
            TarifasBulkModeIncreasePercent => current * (1m + (_tarifasAumentoValue / 100m)),
            TarifasBulkModeDecreasePercent => current * (1m - (_tarifasAumentoValue / 100m)),
            TarifasBulkModeAddFixed => current + _tarifasAumentoValue,
            TarifasBulkModeSubtractFixed => current - _tarifasAumentoValue,
            _ => current
        };

        return next < 0m ? 0m : next;
    }

    private string GetTarifasAumentoPreviewText()
        => _tarifasAumentoMode switch
        {
            TarifasBulkModeIncreasePercent => $"+{_tarifasAumentoValue:N2} %",
            TarifasBulkModeDecreasePercent => $"-{_tarifasAumentoValue:N2} %",
            TarifasBulkModeAddFixed => $"+{FormatMoney(_tarifasAumentoValue)}",
            TarifasBulkModeSubtractFixed => $"-{FormatMoney(_tarifasAumentoValue)}",
            _ => "-"
        };

    private int GetTarifasAumentoSeleccionadasCount()
        => _tarifasAumentoSeleccionadas.Count;

