@page "/admin/modulos"
@page "/{idweb}/{idbase:int}/admin/modulos"
@layout AlfaCore.Components.Layout.MainLayout
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.ICentralAdminService AdminSvc
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav

<PageTitle>Módulos | AlfaNet</PageTitle>

<div class="page-grid admin-home-page">
<div class="panel-card">
    <div class="panel-card__header">
        <div>
            <h1 class="panel-card__title">Catálogo de módulos</h1>
            <p class="panel-card__subtitle">Un módulo es un nodo raíz del menú (con todo lo que cuelga de él) más los módulos de los que depende. La base de datos sigue siendo completa para todos los clientes — esto solo controla qué ve cada uno.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-light" @onclick="GoHome">Inicio</button>
            <button type="button" class="btn btn-primary" @onclick="StartNew">Nuevo módulo</button>
        </div>
    </div>

    @if (_loading)
    {
        <p>Cargando módulos...</p>
    }
    else if (!IsSuperAdmin)
    {
        <div class="editor-msg editor-msg--warning">
            <strong>Acceso restringido</strong>
            <p>Solo los superadmin pueden ver esta sección.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="editor-msg editor-msg--success">
                <strong>Listo</strong>
                <p>@_message</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="editor-msg editor-msg--warning">
                <strong>No se pudo guardar</strong>
                <p>@_error</p>
            </div>
        }

        <div class="row g-3">
            <div class="col-12 col-xl-5">
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h2 class="panel-card__title">@(_editing ? $"Editar módulo #{_form.Id}" : "Nuevo módulo")</h2>
                            <p class="panel-card__subtitle">El código no se puede repetir.</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Código</label>
                        <input class="form-control" @bind="_form.Codigo" placeholder="Ej: CONVERSACIONES" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="_form.Nombre" placeholder="Ej: Conversaciones" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" rows="2" @bind="_form.Descripcion"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nodo de menú raíz (opcional)</label>
                        <select class="form-select" @bind="_form.MenuKeyRaiz">
                            <option value="">Sin nodo propio (módulo solo funcionalidad)</option>
                            @foreach (var opcion in _menuOptions)
                            {
                                <option value="@opcion.Clave">@opcion.Nombre (@opcion.Clave)</option>
                            }
                        </select>
                        <div class="form-text">Arrastra automáticamente todo lo que cuelga de ese nodo en el menú. Dejalo vacío si el módulo no agrega una sección propia (ej.: una función dentro de otro módulo, como AlfaKnowledge dentro de Conversaciones).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Precio</label>
                        <input class="form-control" type="number" step="0.01" min="0" @bind="_form.Precio" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Depende de</label>
                        @if (_dependenciaOptions.Count == 0)
                        {
                            <div class="form-text">No hay otros módulos definidos todavía.</div>
                        }
                        else
                        {
                            @foreach (var opcion in _dependenciaOptions)
                            {
                                var seleccion = GetSeleccion(opcion.Id);
                                <div class="form-check d-flex align-items-center gap-2 flex-wrap">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="@($"dep-{opcion.Id}")"
                                           checked="@(seleccion is not null)"
                                           @onchange="args => ToggleDependencia(opcion.Id, args)" />
                                    <label class="form-check-label" for="@($"dep-{opcion.Id}")">@opcion.Nombre (@opcion.Codigo)</label>
                                    @if (seleccion is not null)
                                    {
                                        <select class="form-select form-select-sm w-auto" value="@(seleccion.EsObligatoria ? "obligatoria" : "opcional")" @onchange="args => SetTipoDependencia(opcion.Id, args)">
                                            <option value="obligatoria">Obligatoria (gratis, se activa sola)</option>
                                            <option value="opcional">Opcional (vinculada, no se activa sola)</option>
                                        </select>
                                    }
                                </div>
                            }
                        }
                        <div class="form-text">Obligatoria: se activa gratis junto con este módulo. Opcional: solo queda vinculada — el cliente la tiene que comprar aparte para que las funciones de este módulo que la usan se muestren.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" @onclick="SaveAsync">@(_editing ? "Guardar cambios" : "Crear módulo")</button>
                        <button type="button" class="btn btn-outline-light" @onclick="StartNew">Limpiar</button>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="panel-card">
                    <div class="panel-card__header">
                        <div>
                            <h2 class="panel-card__title">Listado</h2>
                            <p class="panel-card__subtitle">Módulos definidos en la central.</p>
                        </div>
                    </div>

                    @if (_items.Count == 0)
                    {
                        <p>No hay módulos activos para mostrar.</p>
                    }
                    else
                    {
                        <div class="table-responsive admin-table-wrap">
                            <table class="table table-sm align-middle admin-table" data-sticky-list-header>
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Nombre</th>
                                        <th>Nodo de menú</th>
                                        <th>Precio</th>
                                        <th>Depende de</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _items)
                                    {
                                        <tr>
                                            <td>@item.Codigo</td>
                                            <td>@item.Nombre</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.MenuKeyRaiz) ? "—" : item.MenuKeyRaiz)</td>
                                            <td>@item.Precio.ToString("C2")</td>
                                            <td>@(item.Dependencias.Count == 0 ? "—" : string.Join(", ", item.Dependencias.Select(d => d.EsObligatoria ? d.Codigo : $"{d.Codigo} (opcional)")))</td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => GoPlanes(item.Id)">Planes</button>
                                                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => EditAsync(item.Id)">Editar</button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateAsync(item)">Dar de baja</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="panel-card mt-3">
            <div class="panel-card__header">
                <div>
                    <h2 class="panel-card__title">Landing pages públicas</h2>
                    <p class="panel-card__subtitle">Una landing por módulo vendible, compartible en redes (/landing/{slug}). El contenido está hardcodeado por ahora; acá solo se controla si está publicada o suspendida.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_landingError))
            {
                <div class="editor-msg editor-msg--warning">
                    <strong>No se pudo actualizar</strong>
                    <p>@_landingError</p>
                </div>
            }

            <div class="table-responsive admin-table-wrap">
                <table class="table table-sm align-middle admin-table">
                    <thead>
                        <tr>
                            <th>Módulo</th>
                            <th>URL</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var landing in AlfaCore.Models.LandingContenidoCatalogo.Todos)
                        {
                            var activa = !_landingSuspendidas.Contains(landing.Slug);
                            <tr>
                                <td>@landing.Nombre</td>
                                <td><code>/landing/@landing.Slug</code></td>
                                <td>
                                    @if (activa)
                                    {
                                        <span class="badge text-bg-success">Publicada</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Suspendida</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a class="btn btn-sm btn-outline-light" href="@("/landing/" + landing.Slug)" target="_blank" rel="noopener">Ver</a>
                                        @if (activa)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_landingBusy" @onclick="() => SetLandingActivoAsync(landing.Slug, false)">Suspender</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success" disabled="@_landingBusy" @onclick="() => SetLandingActivoAsync(landing.Slug, true)">Reactivar</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
</div>

@code {
    private readonly CrearModuloRequest _form = new();
    private readonly List<AlfaCore.Models.ModuloDto> _items = [];
    private readonly List<AlfaCore.Models.MenuRaizOptionDto> _menuOptions = [];

    private bool _loading = true;
    private bool _editing;
    private bool IsSuperAdmin => AppUserSession.CurrentUser?.SuperAdmin == true;
    private string _message = string.Empty;
    private string _error = string.Empty;

    private HashSet<string> _landingSuspendidas = [];
    private bool _landingBusy;
    private string _landingError = string.Empty;

    private IReadOnlyList<AlfaCore.Models.ModuloDto> _dependenciaOptions
        => _editing ? _items.Where(m => m.Id != _form.Id).ToArray() : _items;

    protected override async Task OnInitializedAsync()
    {
        if (!IsSuperAdmin)
        {
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private void GoHome()
        => Nav.NavigateTo(RouteContext.BuildRoute("/admin"));

    private void GoPlanes(int idModulo)
        => Nav.NavigateTo(RouteContext.BuildRoute($"/admin/modulos/{idModulo}/planes"));

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items.Clear();
            _menuOptions.Clear();
            _items.AddRange(await AdminSvc.GetModulosAsync());
            _menuOptions.AddRange(await AdminSvc.GetMenuRaizOptionsAsync());

            var landingEstados = await AdminSvc.GetLandingEstadosAsync();
            _landingSuspendidas = landingEstados.Where(e => !e.Activo).Select(e => e.Slug).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartNew()
    {
        _editing = false;
        _form.Id = null;
        _form.Codigo = string.Empty;
        _form.Nombre = string.Empty;
        _form.Descripcion = string.Empty;
        _form.MenuKeyRaiz = string.Empty;
        _form.Precio = 0;
        _form.Dependencias = [];
        _message = string.Empty;
        _error = string.Empty;
    }

    private async Task EditAsync(int idModulo)
    {
        var item = await AdminSvc.GetModuloAsync(idModulo);
        if (item is null)
            return;

        _editing = true;
        _message = string.Empty;
        _error = string.Empty;
        _form.Id = item.Id;
        _form.Codigo = item.Codigo;
        _form.Nombre = item.Nombre;
        _form.Descripcion = item.Descripcion ?? string.Empty;
        _form.MenuKeyRaiz = item.MenuKeyRaiz;
        _form.Precio = item.Precio;
        _form.Dependencias = item.Dependencias
            .Select(d => new AlfaCore.Models.DependenciaSeleccionDto { IdModulo = d.IdModuloDependeDe, EsObligatoria = d.EsObligatoria })
            .ToList();
    }

    private AlfaCore.Models.DependenciaSeleccionDto? GetSeleccion(int idModulo)
        => _form.Dependencias.FirstOrDefault(d => d.IdModulo == idModulo);

    private void ToggleDependencia(int idModulo, ChangeEventArgs args)
    {
        var checkedValue = args.Value is bool value && value;
        if (checkedValue && GetSeleccion(idModulo) is null)
            _form.Dependencias.Add(new AlfaCore.Models.DependenciaSeleccionDto { IdModulo = idModulo, EsObligatoria = true });
        else if (!checkedValue)
            _form.Dependencias.RemoveAll(d => d.IdModulo == idModulo);
    }

    private void SetTipoDependencia(int idModulo, ChangeEventArgs args)
    {
        var seleccion = GetSeleccion(idModulo);
        if (seleccion is null)
            return;

        seleccion.EsObligatoria = string.Equals(args.Value?.ToString(), "obligatoria", StringComparison.OrdinalIgnoreCase);
    }

    private async Task SaveAsync()
    {
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            if (_editing)
                await AdminSvc.UpdateModuloAsync(_form);
            else
                await AdminSvc.CreateModuloAsync(_form);

            await LoadAsync();
            _message = _editing ? "Módulo actualizado." : "Módulo creado.";
            StartNew();
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
    }

    private async Task SetLandingActivoAsync(string slug, bool activo)
    {
        _landingError = string.Empty;
        _landingBusy = true;
        try
        {
            await AdminSvc.SetLandingActivoAsync(slug, activo);
            if (activo)
                _landingSuspendidas.Remove(slug);
            else
                _landingSuspendidas.Add(slug);
        }
        catch (Exception ex)
        {
            _landingError = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
        finally
        {
            _landingBusy = false;
        }
    }

    private async Task DeactivateAsync(AlfaCore.Models.ModuloDto item)
    {
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            await AdminSvc.DeleteModuloAsync(item.Id);
            await LoadAsync();
            _message = $"Módulo {item.Nombre} dado de baja.";
        }
        catch (Exception ex)
        {
            _error = ex is AlfaCore.Services.AppUserFacingException userFacing
                ? userFacing.UserMessage
                : ex.Message;
        }
    }
}
