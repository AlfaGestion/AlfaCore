@page "/documentos/disenador"
@page "/{idweb}/{idbase:int}/documentos/disenador"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using AlfaCore.Models
@using AlfaCore.Services
@inject IDocumentTemplateService TemplateSvc
@inject ICotizacionesService CotizSvc
@inject ICotizacionDocumentService CotizDocumentSvc
@inject IAppUserSessionService AppUserSession
@inject IJSRuntime JS
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Diseñador de comprobantes | Alfa Gestión</PageTitle>

<div class="document-designer page-grid">
    <header class="document-designer__header">
        <div>
            <span class="page-kicker">Utilidades</span>
            <p>Plantillas de Cotización por bloques. La vista previa y el PDF beta usan el mismo renderer HTML.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="document-designer__notice document-designer__notice--error">@_error</div> }
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="document-designer__notice">@_message</div> }

    <section class="document-designer__toolbar panel-card">
        <label>Unidad de negocio
            <select @bind="_uNegocio" @bind:after="LoadTemplatesAsync">
                <option value="">Plantilla global</option>
                @foreach (var option in _unidades) { <option value="@option.Codigo">@UnidadLabel(option)</option> }
            </select>
        </label>
        <label>Tipo de documento
            <select disabled><option>Cotización</option></select>
        </label>
        <label>Plantilla
            <select value="@_selectedTemplateId" @onchange="TemplateChangedAsync">
                @foreach (var item in _templates) { <option value="@item.IdTemplate">@TemplateLabel(item)</option> }
            </select>
        </label>
        <button class="btn btn--ghost" disabled="@(_selected is null)" @onclick="DuplicarAsync"><i class="bi bi-copy"></i> Duplicar</button>
    </section>

    @if (_selected is not null)
    {
        <section class="document-designer__layout">
            <aside class="document-designer__settings panel-card">
                @if (_selected.EsSistema)
                {
                    <div class="document-designer__readonly">
                        @if (IsTemplateReadOnly)
                        {
                            <span>@(_canEditSystemTemplate ? "Plantilla original protegida. Usá Editar original para habilitarla en esta sesión." : "Plantilla del sistema. Duplicala para personalizarla.")</span>
                        }
                        else
                        {
                            <span>Estás modificando la plantilla original del sistema. Al guardar se conservará una versión anterior.</span>
                        }
                    </div>
                }
                <section class="document-designer__settings-group">
                    <div class="document-designer__settings-heading">Formato</div>
                    <label>Nombre <input @bind="_draft.Nombre" disabled="@IsTemplateReadOnly" maxlength="100" /></label>
                    <label class="document-designer__toggle"><input type="checkbox" @bind="_draft.EsPredeterminado" disabled="@IsTemplateReadOnly" /><span>Predeterminada para esta unidad</span></label>
                    <div class="document-designer__settings-grid">
                        <label>Tamaño
                            <select @bind="_draft.Definition.Paper.Size" disabled="@IsTemplateReadOnly"><option>A4</option><option>A5</option></select>
                        </label>
                        <label>Orientación
                            <select @bind="_draft.Definition.Paper.Orientation" disabled="@IsTemplateReadOnly"><option>Portrait</option><option>Landscape</option></select>
                        </label>
                    </div>
                    <div class="document-designer__settings-heading document-designer__settings-heading--subtle">Márgenes (mm)</div>
                    <div class="document-designer__margins">
                        <label>Sup. <input type="number" @bind="_draft.Definition.Paper.MarginTopMm" disabled="@IsTemplateReadOnly" /></label>
                        <label>Inf. <input type="number" @bind="_draft.Definition.Paper.MarginBottomMm" disabled="@IsTemplateReadOnly" /></label>
                        <label>Izq. <input type="number" @bind="_draft.Definition.Paper.MarginLeftMm" disabled="@IsTemplateReadOnly" /></label>
                        <label>Der. <input type="number" @bind="_draft.Definition.Paper.MarginRightMm" disabled="@IsTemplateReadOnly" /></label>
                    </div>
                </section>
                @if (PortadaBlock is not null)
                {
                    <section class="document-designer__settings-group">
                        <div class="document-designer__settings-heading">Portada</div>
                        <label class="document-designer__toggle"><input type="checkbox" @bind="PortadaBlock.Visible" disabled="@IsTemplateReadOnly" /><span>Incluir portada al generar el PDF</span></label>
                        @if (_selected is { IdTemplate: > 0 })
                        {
                            <div class="cfglogo-uploader">
                                <div class="cfglogo-uploader__preview cfglogo-uploader__preview--portrait">
                                    @if (!string.IsNullOrWhiteSpace(_portadaPreviewUrl))
                                    {
                                        <img src="@_portadaPreviewUrl" alt="Portada" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-image"></i>
                                    }
                                </div>
                                <div class="cfglogo-uploader__content">
                                    <strong>@(_tienePortada ? "Portada cargada" : "Sin portada")</strong>
                                    <span>JPG o PNG, A4 vertical recomendado, hasta 5 MB.</span>
                                    <div class="cfglogo-uploader__actions">
                                        <div class="cfglogo-picker">
                                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Disabled="@(IsTemplateReadOnly || _subiendoPortada)">@(_tienePortada ? "Cambiar" : "Subir")</AlfaButton>
                                            <InputFile class="cfglogo-input" OnChange="HandlePortadaSelectedAsync" accept=".jpg,.jpeg,.png,image/jpeg,image/png" disabled="@(IsTemplateReadOnly || _subiendoPortada)" />
                                        </div>
                                        @if (_tienePortada)
                                        {
                                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-trash" Disabled="@(IsTemplateReadOnly || _subiendoPortada)" OnClick="QuitarPortadaAsync">Quitar</AlfaButton>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="document-designer__hint">Guardá la plantilla para poder subirle una portada.</p>
                        }
                    </section>
                }
                @if (LogoBlock is not null)
                {
                    <section class="document-designer__settings-group">
                        <div class="document-designer__settings-heading">Logo</div>
                        <label class="document-designer__toggle"><input type="checkbox" @bind="LogoBlock.Visible" disabled="@IsTemplateReadOnly" /><span>Mostrar logo</span></label>
                        <label class="document-designer__toggle"><input type="checkbox" @bind="LogoBlock.CombineWithCompany" disabled="@IsTemplateReadOnly" /><span>Combinar con los datos de la empresa (logo de un lado, datos del otro)</span></label>
                        <div class="document-designer__settings-grid">
                            <label>@(LogoBlock.CombineWithCompany ? "Lado" : "Alineación")
                                <select @bind="LogoBlock.Align" disabled="@IsTemplateReadOnly">
                                    <option value="left">Izquierda</option>
                                    @if (!LogoBlock.CombineWithCompany)
                                    {
                                        <option value="center">Centro</option>
                                    }
                                    <option value="right">Derecha</option>
                                </select>
                            </label>
                            <label>Ancho (px) <input type="number" @bind="LogoBlock.Width" disabled="@IsTemplateReadOnly" /></label>
                        </div>
                    </section>
                }
                @if (EmpresaBlock is not null)
                {
                    @RenderFieldBlockSettings("Datos de la empresa", EmpresaBlock, TiposBloqueDocumento.Empresa)
                }
                @if (ComprobanteBlock is not null)
                {
                    @RenderFieldBlockSettings("Condiciones", ComprobanteBlock, TiposBloqueDocumento.Comprobante)
                }
                @if (ClienteBlock is not null)
                {
                    @RenderFieldBlockSettings("Datos del cliente", ClienteBlock, TiposBloqueDocumento.Cliente)
                }
                @if (ItemsBlock is not null)
                {
                    <section class="document-designer__settings-group">
                        <div class="document-designer__settings-heading">Columnas del detalle</div>
                        @foreach (var column in ItemsBlock.Columns)
                        {
                            <div class="document-designer__column">
                                <input type="checkbox" @bind="column.Visible" disabled="@IsTemplateReadOnly" aria-label="Mostrar @column.Field" />
                                <input @bind="column.Title" disabled="@IsTemplateReadOnly" aria-label="Título @column.Field" />
                                <input type="number" @bind="column.WidthPercent" disabled="@IsTemplateReadOnly" aria-label="Ancho @column.Field" />
                            </div>
                        }
                        <label>Tamaño de letra (pt)
                            <input type="number" min="6" max="24" value="@(ItemsBlock.FontSizePt?.ToString() ?? string.Empty)" @onchange="args => SetFontSize(ItemsBlock, args)" disabled="@IsTemplateReadOnly" placeholder="Automático" />
                        </label>
                    </section>
                }
                @if (TotalesBlock is not null)
                {
                    @RenderFieldBlockSettings("Totales", TotalesBlock, TiposBloqueDocumento.Totales)
                }
                @if (PropuestaBlock is not null)
                {
                    <section class="document-designer__settings-group">
                        <div class="document-designer__settings-heading">Propuesta</div>
                        <label class="document-designer__toggle"><input type="checkbox" @bind="PropuestaBlock.Visible" disabled="@IsTemplateReadOnly" /><span>Mostrar el texto de la propuesta (con imágenes)</span></label>
                        <p class="document-designer__hint">Se completa desde la solapa "Propuesta" de cada cotización, nunca desde las Observaciones internas.</p>
                    </section>
                }
                @if (FirmaBlock is not null)
                {
                    <section class="document-designer__settings-group">
                        <div class="document-designer__settings-heading">Firma</div>
                        <label class="document-designer__toggle"><input type="checkbox" @bind="FirmaBlock.Visible" disabled="@IsTemplateReadOnly" /><span>Mostrar firma</span></label>
                        <p class="document-designer__hint">Usa la firma cargada por quien creó la cotización (Usuarios → Firma digital).</p>
                    </section>
                }
                @if (PieBlock is not null)
                {
                    <section class="document-designer__settings-group">
                        <div class="document-designer__settings-heading">Pie de página</div>
                        <label class="document-designer__toggle"><input type="checkbox" @bind="PieBlock.Visible" disabled="@IsTemplateReadOnly" /><span>Mostrar pie de página en el PDF</span></label>
                        <div class="document-designer__column-fields">
                            @foreach (var option in DocumentBlockFields.For(TiposBloqueDocumento.Pie))
                            {
                                <label class="document-designer__toggle document-designer__toggle--compact">
                                    <input type="checkbox" checked="@IsFieldVisible(PieBlock, option.Field)" @onchange="args => ToggleField(PieBlock, option.Field, args)" disabled="@(IsTemplateReadOnly || !PieBlock.Visible)" />
                                    <span>@option.Label</span>
                                </label>
                            }
                        </div>
                        <p class="document-designer__hint">Ambos datos son opcionales e independientes entre sí.</p>
                    </section>
                }
            </aside>
            <main class="document-designer__preview panel-card">
                <div class="document-designer__preview-toolbar">
                    <label>Cotización para probar
                        <select value="@_previewVersionId" @onchange="PreviewVersionChangedAsync">
                            <option value="0">Datos demo</option>
                            @foreach (var quote in _cotizaciones) { <option value="@quote.IdVersion">@quote.CodigoVisible - @quote.EmpresaProspecto</option> }
                        </select>
                    </label>
                    <button class="btn btn--ghost" @onclick="PreviewAsync" disabled="@_busy"><i class="bi bi-eye"></i> Actualizar vista previa</button>
                    @if (_previewVersionId > 0) { <button class="btn btn--primary" @onclick="PdfAsync" disabled="@_busy"><i class="bi bi-file-earmark-pdf"></i> PDF beta</button> }
                </div>
                @if (_previewHtml is null) { <p class="muted">Elegí una cotización para previsualizar el formato con datos reales.</p> }
                else { <iframe class="document-designer__frame" srcdoc="@_previewHtml" title="Vista previa de cotización"></iframe> }
            </main>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "idVersion")]
    public long? IdVersion { get; set; }

    private readonly List<DocumentTemplateDto> _templates = [];
    private IReadOnlyList<UnidadNegocioOptionDto> _unidades = [];
    private IReadOnlyList<CotizacionListItemDto> _cotizaciones = [];
    private DocumentTemplateDto? _selected;
    private DocumentTemplateSaveRequest _draft = new();
    private string _uNegocio = string.Empty;
    private int _selectedTemplateId;
    private long _previewVersionId;
    private string? _previewHtml;
    private bool _busy;
    private bool _canEditSystemTemplate;
    private bool _systemTemplateEditingEnabled;
    private string? _error;
    private string? _message;
    private bool _tienePortada;
    private string? _portadaPreviewUrl;
    private bool _subiendoPortada;

    private bool IsTemplateReadOnly => _selected?.EsSistema == true && !_systemTemplateEditingEnabled;

    private DocumentBlockDefinition? LogoBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Logo, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? ItemsBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Items, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? EmpresaBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Empresa, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? ComprobanteBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Comprobante, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? ClienteBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Cliente, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? TotalesBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Totales, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? PropuestaBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Propuesta, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? FirmaBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Firma, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? PortadaBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Portada, StringComparison.OrdinalIgnoreCase));
    private DocumentBlockDefinition? PieBlock => _draft.Definition.Blocks.FirstOrDefault(x => x.Type.Equals(TiposBloqueDocumento.Pie, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _canEditSystemTemplate = await TemplateSvc.CanEditSystemTemplatesAsync();
        UpdatePageHeader();
        _unidades = await TemplateSvc.GetUnidadesNegocioAsync();
        var list = await CotizSvc.GetListAsync(new CotizacionListFiltersDto { PageSize = 20 });
        _cotizaciones = list.Items;
        await LoadTemplatesAsync();
        if (IdVersion is > 0)
        {
            _previewVersionId = IdVersion.Value;
            await PreviewAsync();
        }
    }

    public void Dispose()
        => PageHeader.Clear();

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();
        if (_selected?.EsSistema == true && IsTemplateReadOnly && _canEditSystemTemplate)
        {
            actions.Add(new PageHeaderAction
            {
                Key = "editar-original",
                Label = "Editar original",
                Icon = "bi-shield-lock",
                Style = PageHeaderActionStyle.Secondary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _busy,
                OnClick = HabilitarEdicionOriginalAsync
            });
        }

        actions.AddRange(
        [
            new PageHeaderAction
            {
                Key = "nueva",
                Label = "Nueva",
                Icon = "bi-plus-lg",
                Style = PageHeaderActionStyle.Ghost,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _busy,
                OnClick = NuevaAsync
            },
            new PageHeaderAction
            {
                Key = "guardar",
                Label = "Guardar",
                Icon = "bi-floppy",
                Style = PageHeaderActionStyle.Primary,
                Priority = PageHeaderActionPriority.Essential,
                Disabled = _busy || IsTemplateReadOnly,
                Busy = _busy,
                OnClick = GuardarAsync
            }
        ]);

        PageHeader.Set(new PageHeaderConfig
        {
            Title = "Diseñador de comprobantes",
            Breadcrumb = ["Utilidades", "Documentos"],
            State = _busy ? PageHeaderState.Loading : PageHeaderState.Editing,
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildDocumentos(RouteContext, Nav, "disenador"),
            Actions = actions
        });
    }

    private async Task LoadTemplatesAsync()
    {
        _templates.Clear();
        _templates.AddRange(await TemplateSvc.GetListAsync(TiposDocumentoCore.Cotizacion, _uNegocio));
        var current = _templates.FirstOrDefault(x => x.IdTemplate == _selectedTemplateId) ?? _templates.FirstOrDefault();
        if (current is not null) await SelectTemplateAsync(current);
        else await NuevaAsync();
    }

    private async Task TemplateChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var id) && _templates.FirstOrDefault(x => x.IdTemplate == id) is { } template) await SelectTemplateAsync(template);
    }

    private Task SelectTemplateAsync(DocumentTemplateDto template)
    {
        _selected = template;
        _systemTemplateEditingEnabled = false;
        _selectedTemplateId = template.IdTemplate;
        _draft = new DocumentTemplateSaveRequest
        {
            IdTemplate = template.EsSistema ? null : template.IdTemplate, UNegocio = template.UNegocio, TipoDocumento = template.TipoDocumento,
            Nombre = template.Nombre, Definition = TemplateSvc.DeserializeAndValidate(template.TemplateJson), CssCustom = template.CssCustom,
            EsPredeterminado = template.EsPredeterminado, Activo = template.Activo, Usuario = AppUserSession.GetCurrentUserName("Sistema")
        };
        _previewHtml = null;
        _tienePortada = template.TienePortada;
        _portadaPreviewUrl = _tienePortada ? $"/api/documentos/plantillas/{template.IdTemplate}/portada?v={Guid.NewGuid():N}" : null;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private Task NuevaAsync()
    {
        _selected = new DocumentTemplateDto { IdTemplate = 0, TipoDocumento = TiposDocumentoCore.Cotizacion };
        _systemTemplateEditingEnabled = false;
        _selectedTemplateId = 0;
        _draft = new DocumentTemplateSaveRequest { UNegocio = NullIfEmpty(_uNegocio), Nombre = "Nueva cotización", Usuario = AppUserSession.GetCurrentUserName("Sistema") };
        _previewHtml = null;
        _tienePortada = false;
        _portadaPreviewUrl = null;
        UpdatePageHeader();
        StateHasChanged();
        return Task.CompletedTask;
    }

    // El botón "Editar original" vive en la barra superior (MainPageHeader, otro componente) --
    // el post-render automático de Blazor solo refresca al dueño del evento DOM, así que sin este
    // StateHasChanged explícito el estado quedaba habilitado internamente pero los campos del
    // formulario seguían viéndose (y comportándose) como deshabilitados hasta el próximo evento
    // propio de esta página.
    private Task HabilitarEdicionOriginalAsync()
    {
        if (!_canEditSystemTemplate || _selected?.EsSistema != true)
            return Task.CompletedTask;

        _systemTemplateEditingEnabled = true;
        _draft.IdTemplate = _selected.IdTemplate;
        _message = "Edición de plantilla original habilitada para esta sesión. Al guardar se conservará una versión anterior.";
        UpdatePageHeader();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task DuplicarAsync()
    {
        if (_selected is null || _selected.IdTemplate <= 0) return;
        await BusyAsync(async () =>
        {
            var copy = await TemplateSvc.DuplicateAsync(_selected.IdTemplate, NullIfEmpty(_uNegocio), AppUserSession.GetCurrentUserName("Sistema"));
            await LoadTemplatesAsync();
            await SelectTemplateAsync(copy);
            _message = "Se creó una copia editable de la plantilla.";
        });
    }

    private async Task GuardarAsync()
    {
        if (IsTemplateReadOnly) { _error = "La plantilla original está protegida. Duplicala o usá Editar original si sos administrador."; return; }
        await BusyAsync(async () =>
        {
            _draft.UNegocio = NullIfEmpty(_uNegocio);
            _draft.Usuario = AppUserSession.GetCurrentUserName("Sistema");
            var saved = await TemplateSvc.SaveAsync(_draft);
            _message = "Plantilla guardada. Si era una edición, se registró su versión anterior.";
            await LoadTemplatesAsync();
            await SelectTemplateAsync(saved);
        });
    }

    private async Task HandlePortadaSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null || _selected is not { IdTemplate: > 0 })
            return;

        _subiendoPortada = true;
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            await TemplateSvc.SavePortadaImageAsync(_selected.IdTemplate, bytes);
            _tienePortada = true;
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            _portadaPreviewUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            _message = "Portada actualizada.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _subiendoPortada = false;
            StateHasChanged();
        }
    }

    private async Task QuitarPortadaAsync()
    {
        if (_selected is not { IdTemplate: > 0 })
            return;

        _subiendoPortada = true;
        StateHasChanged();
        try
        {
            await TemplateSvc.DeletePortadaImageAsync(_selected.IdTemplate);
            _tienePortada = false;
            _portadaPreviewUrl = null;
            _message = "Se quitó la portada.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _subiendoPortada = false;
            StateHasChanged();
        }
    }

    private Task PreviewVersionChangedAsync(ChangeEventArgs args)
    {
        _previewVersionId = long.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        _previewHtml = null;
        return Task.CompletedTask;
    }

    private async Task PreviewAsync()
    {
        if (_previewVersionId <= 0) { _error = "Para este MVP elegí una cotización real como datos de prueba."; return; }
        await BusyAsync(async () =>
        {
            var result = await CotizDocumentSvc.RenderAsync(_previewVersionId, NullIfEmpty(_uNegocio));
            _previewHtml = result.Html;
            _message = $"Vista previa generada con plantilla #{result.IdTemplate}.";
        });
    }

    private async Task PdfAsync()
    {
        if (_previewVersionId <= 0) return;
        await BusyAsync(async () =>
        {
            var pdf = await CotizDocumentSvc.GeneratePdfAsync(_previewVersionId, NullIfEmpty(_uNegocio));
            await JS.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob", Convert.ToBase64String(pdf), "application/pdf", $"cotizacion-beta-{_previewVersionId}.pdf");
        });
    }

    private async Task BusyAsync(Func<Task> operation)
    {
        _busy = true;
        _error = null;
        _message = null;
        UpdatePageHeader();
        try
        {
            await operation();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            UpdatePageHeader();
            StateHasChanged();
        }
    }
    private RenderFragment RenderFieldBlockSettings(string heading, DocumentBlockDefinition block, string tipo) => @<section class="document-designer__settings-group">
        <div class="document-designer__settings-heading">@heading</div>
        <label class="document-designer__toggle"><input type="checkbox" @bind="block.Visible" disabled="@IsTemplateReadOnly" /><span>Mostrar esta sección</span></label>
        <div class="document-designer__column-fields">
            @foreach (var option in DocumentBlockFields.For(tipo))
            {
                <label class="document-designer__toggle document-designer__toggle--compact">
                    <input type="checkbox" checked="@IsFieldVisible(block, option.Field)" @onchange="args => ToggleField(block, option.Field, args)" disabled="@IsTemplateReadOnly" />
                    <span>@option.Label</span>
                </label>
            }
        </div>
        <label>Tamaño de letra (pt)
            <input type="number" min="6" max="24" value="@(block.FontSizePt?.ToString() ?? string.Empty)" @onchange="args => SetFontSize(block, args)" disabled="@IsTemplateReadOnly" placeholder="Automático" />
        </label>
    </section>;

    private static bool IsFieldVisible(DocumentBlockDefinition block, string field)
        => block.VisibleFields is null || block.VisibleFields.Contains(field, StringComparer.OrdinalIgnoreCase);

    private void ToggleField(DocumentBlockDefinition block, string field, ChangeEventArgs args)
    {
        var check = args.Value is bool b && b;
        block.VisibleFields ??= DocumentBlockFields.For(block.Type).Select(x => x.Field).ToList();
        if (check && !block.VisibleFields.Contains(field, StringComparer.OrdinalIgnoreCase))
            block.VisibleFields.Add(field);
        else if (!check)
            block.VisibleFields.RemoveAll(x => string.Equals(x, field, StringComparison.OrdinalIgnoreCase));
    }

    private static void SetFontSize(DocumentBlockDefinition block, ChangeEventArgs args)
        => block.FontSizePt = decimal.TryParse(args.Value?.ToString(), out var v) && v > 0 ? v : null;

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string UnidadLabel(UnidadNegocioOptionDto item) => string.IsNullOrWhiteSpace(item.Descripcion) ? item.Codigo : $"{item.Codigo} - {item.Descripcion}";
    private static string TemplateLabel(DocumentTemplateDto item) => $"{(item.UNegocio is null ? "Global" : item.UNegocio)} · {item.Nombre}{(item.EsSistema ? " (sistema)" : string.Empty)}";
}
