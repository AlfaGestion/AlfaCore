    private async Task GenerarMensajeIaAsync()
    {
        // Sin instrucciones puntuales, igual propone algo razonable con el contexto que ya tiene
        // la cotización (código, cliente, total) -- no hace falta escribir nada para usarlo.
        var pedido = string.IsNullOrWhiteSpace(_iaMensajePrompt)
            ? $"Mensaje corto genérico para acompañar el envío de la cotización {_detail?.CodigoVisible} (sin instrucciones puntuales del vendedor)."
            : _iaMensajePrompt;

        _iaMensajeCargando = true;
        StateHasChanged();
        var result = await UiOps.RunAsync(() => CotizSvc.GenerateEmailMessageAsync(pedido, _detail?.EmpresaProspecto), "No se pudo generar el mensaje con el asistente de IA.");
        _iaMensajeCargando = false;

        if (result.Success && !string.IsNullOrWhiteSpace(result.Value))
        {
            _compartirMensaje = result.Value;
            _iaMensajePrompt = string.Empty;
        }
        else if (!result.Success)
        {
            SetFeedback(result.Feedback);
        }
    }

    private async Task OnIaMensajeKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_iaMensajePrompt))
            await GenerarMensajeIaAsync();
    }

    private string BuildPublicBase()
    {
        var configured = Config["ServidorWeb:UrlBasePublica"];
        return string.IsNullOrWhiteSpace(configured) ? Nav.BaseUri : configured;
