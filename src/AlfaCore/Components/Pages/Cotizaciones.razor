    private void AgregarSeccion()
    {
        if (_detail is null)
            return;
        _detail.Secciones.Add(new CotizacionSeccionDto { IdSeccion = _seccionTempCounter--, Orden = _detail.Secciones.Count, Titulo = "Nueva sección", MostrarSubtotal = true });
    }

    private void MoverSeccion(CotizacionSeccionDto seccion, int delta)
    {
        if (_detail is null)
            return;
        var ordenadas = _detail.Secciones.OrderBy(s => s.Orden).ToList();
        var idx = ordenadas.IndexOf(seccion);
        var destino = idx + delta;
        if (destino < 0 || destino >= ordenadas.Count)
            return;
        (ordenadas[idx].Orden, ordenadas[destino].Orden) = (ordenadas[destino].Orden, ordenadas[idx].Orden);
    }

    private void EliminarSeccion(CotizacionSeccionDto seccion)
    {
        if (_detail is null)
            return;
        foreach (var linea in _detail.Lineas.Where(l => l.IdSeccion == seccion.IdSeccion))
            linea.IdSeccion = null;
        _detail.Secciones.Remove(seccion);
    }

    private void AgregarLineaLibre()
    {
        if (_detail is null)
            return;
        _detail.Lineas.Add(new CotizacionLineaDto { Tipo = CotizacionDetTipos.Libre, Descripcion = "Nueva línea", Cantidad = 1, ImpactaTotal = true, OrigenPrecio = CotizacionOrigenPrecio.Manual, Orden = _detail.Lineas.Count });
        RecalcularTotales();
    }

    private void AgregarLineaInformativa()
    {
        if (_detail is null)
            return;
        _detail.Lineas.Add(new CotizacionLineaDto { Tipo = CotizacionDetTipos.Informativo, Descripcion = "Nota", Cantidad = 1, ImpactaTotal = false, Orden = _detail.Lineas.Count });
    }

    private void EliminarLinea(CotizacionLineaDto linea)
    {
        _detail?.Lineas.Remove(linea);
        RecalcularTotales();
    }

    private void RecalcularTotales()
    {
        if (_detail is null)
            return;
        var subtotal = _detail.Lineas.Where(l => l.ImpactaTotal).Sum(l =>
        {
            l.Subtotal = decimal.Round(l.PrecioBase * (1m - l.PorcentajeDescuento / 100m) * l.Cantidad, 2);
            return l.Subtotal;
        });
        _detail.Subtotal = subtotal;
        _detail.TotalDescuento = decimal.Round(subtotal * _detail.DescuentoGeneralPorcentaje / 100m, 2);
        _detail.Total = _detail.Subtotal - _detail.TotalDescuento;
    }

    private List<CotizacionLineaDto> SinSeccion()
        => _detail is null ? [] : _detail.Lineas.Where(l => l.IdSeccion is null).OrderBy(l => l.Orden).ToList();

