@page "/cotizaciones"
@page "/{idweb}/{idbase:int}/cotizaciones"
@using AlfaCore.Models
@inject AlfaCore.Services.ICotizacionesService CotizSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConfiguration Config
@implements IDisposable

<PageTitle>Cotizaciones | Alfa Gestión</PageTitle>

<div class="page-grid cotizaciones-page" @onclick="HandlePageClickAsync">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    @if (!_showEditor)
    {
        <section class="cotiz-page--list">
            <header class="cotiz-list-header">
                <div class="cotiz-stats">
                    <div class="cotiz-stat">
                        <span class="cotiz-stat__label">Total abierto</span>
                        <strong class="cotiz-stat__value">@_resumen.TotalAbierto.ToString("N0")</strong>
                    </div>
                    <button type="button" class="cotiz-stat cotiz-stat--action @(_listTab == "enviadas" ? "is-active" : "")" @onclick='() => SetListTabAsync("enviadas")'>
                        <span class="cotiz-stat__label">Esperando respuesta</span>
                        <strong class="cotiz-stat__value">@_resumen.EsperandoRespuesta</strong>
                    </button>
                    <button type="button" class="cotiz-stat cotiz-stat--action @(_listTab == "aceptadas" ? "is-active" : "")" @onclick='() => SetListTabAsync("aceptadas")'>
                        <span class="cotiz-stat__label">Aceptadas este mes</span>
                        <strong class="cotiz-stat__value">@_resumen.AceptadasEsteMes</strong>
                    </button>
                </div>
            </header>

            <section class="cuentas-list-shell @(_selectedIds.Count > 0 ? "cuentas-list-shell--selection" : string.Empty)">
                @if (_loadingList)
                {
                    <div class="cuentas-list-shell__state">
                        <AlfaEmptyState Title="Cargando cotizaciones" Message="Estamos consultando la base activa." />
                    </div>
                }
                else if (_items.Count == 0)
                {
                    <div class="cuentas-list-shell__state">
                        <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults"
                                        Title="@(_listTab == "todas" && string.IsNullOrWhiteSpace(_filters.Texto) ? "Todavía no hay cotizaciones" : "No encontramos cotizaciones")"
                                        Message="@(_listTab == "todas" && string.IsNullOrWhiteSpace(_filters.Texto) ? "Creá una propuesta comercial para un cliente o comenzá desde una oportunidad del CRM." : "Probá con otros filtros o términos de búsqueda.")"
                                        ActionLabel="Nueva cotización" ActionIcon="bi bi-plus-circle" OnAction="_ => AbrirNuevaAsync()" />
                    </div>
                }
                else
                {
                    <div class="cuentas-list-shell__table-scroll">
                        <table class="cuentas-list-table cotiz-list-table">
                            <thead>
                                <tr>
                                    <th class="cuentas-list-table__select">
                                        <input type="checkbox"
                                               class="cuentas-list-table__checkbox"
                                               checked="@AreAllVisibleSelected"
                                               @onchange="ToggleSelectAllAsync"
                                               aria-label="Seleccionar todas las cotizaciones visibles"
                                               title="Seleccionar todas las cotizaciones visibles" />
                                    </th>
                                    <th>Número</th>
                                    <th>Cliente / Prospecto</th>
                                    <th>Contacto</th>
                                    <th class="num">Total</th>
                                    <th>Estado</th>
                                    <th>Vencimiento</th>
                                    <th>Origen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _items)
                                {
                                    <tr class="cuentas-list-table__row @(_selectedIds.Contains(item.IdCotizacion) ? "is-selected" : string.Empty)" @onclick="() => AbrirAsync(item.IdVersion)">
                                        <td class="cuentas-list-table__select" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   class="cuentas-list-table__checkbox"
                                                   checked="@_selectedIds.Contains(item.IdCotizacion)"
                                                   @onchange="args => ToggleRowSelectionAsync(item.IdCotizacion, args)"
                                                   aria-label="@($"Seleccionar {item.CodigoVisible}")"
                                                   title="@($"Seleccionar {item.CodigoVisible}")" />
                                        </td>
                                        <td><span class="cotiz-list__code">@item.CodigoVisible</span> <span class="cotiz-list__version">v@(item.NumeroVersion)</span></td>
                                        <td><strong>@DisplayOrFallback(item.EmpresaProspecto, item.CodigoCliente)</strong></td>
                                        <td>@item.ContactoNombre</td>
                                        <td class="num">@item.Total.ToString("N2") <span class="cotiz-list__currency">@item.CodigoMoneda</span></td>
                                        <td>
                                            <AlfaTag Tone="@EstadoTono(item.Estado)">@EstadoLabel(item.Estado)</AlfaTag>
                                            @if (item.Vencida)
                                            {
                                                <AlfaTag Tone="AlfaTagTone.Warning">Vencida</AlfaTag>
                                            }
                                        </td>
                                        <td>@(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@(item.OrigenCrm ? "CRM" : "Manual")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <footer class="alfa-data-view-footer">
                    <span class="alfa-data-view-footer__summary">@GetCotizBrowseSummary()</span>
                    <div class="alfa-data-view-footer__controls">
                        <AlfaSelect Value="@_filters.PageSize.ToString()"
                                    ValueChanged="SetCotizPageSizeAsync"
                                    Options="@CotizPageSizeOptions"
                                    Disabled="@_loadingList"
                                    Class="alfa-data-view-footer__page-size" />
                    </div>
                </footer>
            </section>
        </section>

        <AlfaConfirmDialog Open="@_showBulkAnularConfirm" Title="Anular cotizaciones"
                            Message="@($"¿Anular {_selectedIds.Count} cotización(es) seleccionada(s)? Quedarán marcadas como anuladas y no se podrá revertir desde acá.")"
                            ConfirmLabel="Anular" CancelLabel="Cancelar" Loading="@_bulkAnulando"
                            OnConfirm="ConfirmarAnularSeleccionadasAsync" OnCancel="() => _showBulkAnularConfirm = false" />
    }
    else if (_detail is not null)
    {
        <div class="cotiz-workspace">
            <header class="cotiz-hero">
                <div class="cotiz-hero__top">
                    <span class="cotiz-hero__code">@_detail.CodigoVisible</span>
                    <AlfaTag Tone="@EstadoTono(_detail.EstadoVersion)">@EstadoLabel(_detail.EstadoVersion)</AlfaTag>
                    @if (_detail.IdOportunidad is > 0)
                    {
                        <AlfaTag Tone="AlfaTagTone.Accent">CRM</AlfaTag>
                    }
                    <div class="cotiz-version-picker">
                        <button type="button" class="cotiz-version-picker__trigger" @onclick:stopPropagation="true" @onclick="() => _showVersionMenu = !_showVersionMenu">
                            v@(_detail.NumeroVersion) <i class="bi bi-chevron-down"></i>
                        </button>
                        @if (_showVersionMenu)
                        {
                            <div class="cotiz-version-picker__panel" @onclick:stopPropagation="true">
                                @foreach (var v in _versiones.OrderByDescending(x => x.NumeroVersion))
                                {
                                    <button type="button" class="cotiz-version-picker__item @(_detail.IdVersion == v.IdVersion ? "is-current" : "")" @onclick="() => SeleccionarVersionAsync(v.IdVersion)">
                                        <span>v@(v.NumeroVersion)</span>
                                        <span class="cotiz-version-picker__item-meta">@(v.EsActual ? "Actual" : EstadoLabel(v.EstadoVersion)) · @v.FechaHoraAlta.ToString("dd/MM/yy")</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="cotiz-stepper" aria-hidden="true">
                        <span class="cotiz-stepper__node @StepClass(0)">Borrador</span>
                        <span class="cotiz-stepper__node @StepClass(1)">Enviada</span>
                        <span class="cotiz-stepper__node @StepClass(2)">@(_detail.EstadoVersion == CotizacionEstados.Rechazada ? "Rechazada" : "Aceptada")</span>
                    </div>
                </div>

                <div class="cotiz-hero__main">
                    <h1>@(string.IsNullOrWhiteSpace(_detail.EmpresaProspecto) ? "Sin cliente asignado" : _detail.EmpresaProspecto)</h1>
                    @if (_detail.EsBorrador)
                    {
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-pencil" OnClick="_ => AbrirClienteDialogAsync()">Cambiar</AlfaButton>
                    }
                </div>

                <div class="cotiz-hero__meta">
                    @if (!string.IsNullOrWhiteSpace(_detail.ContactoNombre) || !string.IsNullOrWhiteSpace(_detail.ContactoEmail))
                    {
                        <span><i class="bi bi-person"></i> @_detail.ContactoNombre@(!string.IsNullOrWhiteSpace(_detail.ContactoEmail) ? $" · {_detail.ContactoEmail}" : "")</span>
                    }
                    @if (_clienteInfo is not null)
                    {
                        <span class="cotiz-hero__pricing">@(_clienteInfo.EsConsumidorFinal ? "Consumidor final" : $"Lista {_clienteInfo.IdLista} · Clase {_clienteInfo.ClasePrecio}")</span>
                    }
                </div>

                <div class="cotiz-hero__dates">
                    <span>@_detail.Fecha.ToString("dd/MM/yyyy")</span>
                    @if (_detail.FechaVencimiento is { } venc)
                    {
                        <span class="@(venc.Date < DateTime.Today && _detail.EsBorrador ? "cotiz-hero__vencida" : "")">→ Vence @venc.ToString("dd/MM/yyyy")</span>
                    }
                    <span class="cotiz-hero__currency">@(string.IsNullOrWhiteSpace(_detail.CodigoMoneda) ? "—" : _detail.CodigoMoneda)</span>
                </div>
            </header>

            @if (!_detail.EsBorrador)
            {
                <div class="cotiz-readonly-note">
                    <i class="bi bi-lock"></i>
                    Esta versión está en estado <strong>@EstadoLabel(_detail.EstadoVersion)</strong> y quedó de solo lectura. Creá una nueva versión para modificarla.
                </div>
            }

            <AlfaTabs Items="@EditorTabs" ActiveKey="@_activeTab" ActiveKeyChanged="ChangeTabAsync" AriaLabel="Secciones de la cotización" />

            <div class="cotiz-body">
                <main class="cotiz-main">
                    @if (_activeTab == "propuesta")
                    {
                        <section class="panel-card cotiz-propuesta-card">
                            <h3 class="panel-card__title">Propuesta comercial</h3>
                            <p class="panel-card__subtitle">Este texto se muestra en la vista pública que recibe el cliente. Escribí "/" para insertar títulos, listas, banners o imágenes.</p>

                            @if (_detail.EsBorrador)
                            {
                                <div class="cotiz-ia-input">
                                    <i class="bi bi-stars"></i>
                                    <input placeholder="Ej: cotizar Alfa Gestión para 5 usuarios, con soporte y capacitación" value="@_iaPropuestaPrompt"
                                           @oninput="args => _iaPropuestaPrompt = args.Value?.ToString() ?? string.Empty" @onkeydown="OnIaPropuestaKeyDownAsync" />
                                    <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-magic" Loading="@_iaPropuestaCargando"
                                                Disabled="@string.IsNullOrWhiteSpace(_iaPropuestaPrompt)" OnClick="_ => GenerarPropuestaIaAsync()">Generar</AlfaButton>
                                </div>
                                <p class="cotiz-ia-hint">La IA redacta el texto de la propuesta. Los precios se cargan en Productos y servicios (no los inventa).</p>
                            }

                            <div class="tickets-rich-editor cotiz-rich-editor">
                                <div class="tickets-rich-editor__surface cotiz-rich-editor__surface"
                                     @ref="_richEditorRef"
                                     contenteditable="@(_detail.EsBorrador ? "true" : "false")"
                                     data-placeholder="Escribí / para comandos"
                                     @oninput="OnPropuestaInputAsync"
                                     @onkeyup="OnPropuestaInputAsync"
                                     @onfocus="OnPropuestaFocusAsync"></div>
                                @if (_detail.EsBorrador)
                                {
                                    <div class="tickets-rich-editor__bar">
                                        @foreach (var option in ToolbarPropuestaCommands)
                                        {
                                            <button type="button" class="tickets-rich-editor__tool" title="@option.Title" @onclick="() => RunPropuestaCommandAsync(option)">
                                                <i class="bi @option.Icon"></i>
                                            </button>
                                        }
                                        <button type="button" class="tickets-rich-editor__tool" title="Comandos" @onclick="TogglePropuestaCommands">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                    </div>
                                    @if (_showPropuestaCommands)
                                    {
                                        <div class="tickets-slash-menu">
                                            @foreach (var group in PropuestaCommands.GroupBy(x => x.Group))
                                            {
                                                <div class="tickets-slash-menu__group">
                                                    <span>@group.Key</span>
                                                    @foreach (var option in group)
                                                    {
                                                        <button type="button" @onclick="() => RunPropuestaCommandAsync(option)">
                                                            <i class="bi @option.Icon"></i>
                                                            <span>
                                                                <strong>@option.Title</strong>
                                                                <small>@option.Description</small>
                                                            </span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </section>
                    }
                    else if (_activeTab == "condiciones")
                    {
                        <section class="panel-card">
                            <h3 class="panel-card__title">Condiciones comerciales</h3>
                            <div class="cotiz-datos-grid">
                                <div class="field">
                                    <label>CUIT / Documento</label>
                                    <input class="field-input" @bind="_detail.DocumentoFiscal" disabled="@(!_detail.EsBorrador)" />
                                </div>
                                <div class="field">
                                    <label>Moneda</label>
                                    <input class="field-input" @bind="_detail.CodigoMoneda" placeholder="ARS, USD..." disabled="@(!_detail.EsBorrador)" />
                                </div>
                                <div class="field">
                                    <label>Vencimiento</label>
                                    <input type="date" class="field-input" value="@_detail.FechaVencimiento?.ToString("yyyy-MM-dd")" disabled="@(!_detail.EsBorrador)"
                                           @onchange="args => _detail.FechaVencimiento = DateTime.TryParse(args.Value?.ToString(), out var d) ? d : null" />
                                </div>
                                <div class="field">
                                    <label>Contacto</label>
                                    <input class="field-input" @bind="_detail.ContactoNombre" disabled="@(!_detail.EsBorrador)" />
                                </div>
                                <div class="field">
                                    <label>Email</label>
                                    <input class="field-input" @bind="_detail.ContactoEmail" disabled="@(!_detail.EsBorrador)" />
                                </div>
                                <div class="field">
                                    <label>Teléfono</label>
                                    <input class="field-input" @bind="_detail.ContactoTelefono" disabled="@(!_detail.EsBorrador)" />
                                </div>
                            </div>
                            <div class="field cotiz-observaciones">
                                <label>Observaciones internas</label>
                                <textarea class="field-input" rows="3" @bind="_detail.Observaciones" disabled="@(!_detail.EsBorrador)"></textarea>
                            </div>
                            <div class="cotiz-observaciones">
                                <AlfaCheckbox Value="@_detail.IncluyePortada" ValueChanged="v => _detail.IncluyePortada = v == true" Disabled="@(!_detail.EsBorrador)">
                                    Incluir portada al generar el PDF
                                </AlfaCheckbox>
                            </div>
                        </section>

                        <section class="panel-card">
                            <h3 class="panel-card__title">Información del documento</h3>
                            <dl class="cotiz-meta-list">
                                <div><dt>Cotización</dt><dd>@_detail.CodigoVisible</dd></div>
                                <div><dt>Versión</dt><dd>v@(_detail.NumeroVersion) · @EstadoLabel(_detail.EstadoVersion)</dd></div>
                                <div><dt>Creada</dt><dd>@_detail.Fecha.ToString("dd/MM/yyyy")</dd></div>
                                @if (_detail.IdOportunidad is > 0)
                                {
                                    <div><dt>Origen</dt><dd>CRM · Oportunidad #@_detail.IdOportunidad</dd></div>
                                }
                            </dl>
                        </section>
                    }
                    else if (_activeTab == "historial")
                    {
                        <section class="panel-card">
                            <h3 class="panel-card__title">Actividad</h3>
                            <div class="cotiz-timeline">
                                @foreach (var v in _versiones.OrderByDescending(x => x.NumeroVersion))
                                {
                                    <div class="cotiz-timeline__item">
                                        <span class="cotiz-timeline__dot @(v.EsActual ? "is-current" : "")"></span>
                                        <div class="cotiz-timeline__body">
                                            <strong>Versión @v.NumeroVersion creada@(string.IsNullOrWhiteSpace(v.UsuarioAlta) ? "" : $" por {v.UsuarioAlta}")</strong>
                                            <span class="cotiz-timeline__meta">@v.FechaHoraAlta.ToString("dd/MM/yyyy HH:mm")</span>
                                            @if (v.FechaHoraEnvio is { } envio)
                                            {
                                                <span class="cotiz-timeline__extra"><i class="bi bi-send"></i> Enviada el @envio.ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                            <AlfaTag Tone="@EstadoTono(v.EstadoVersion)">@EstadoLabel(v.EstadoVersion)</AlfaTag>
                                            @if (_emailEnvios.TryGetValue(v.IdVersion, out var envios) && envios.Count > 0)
                                            {
                                                <ul class="cotiz-timeline__envios">
                                                    @foreach (var e in envios)
                                                    {
                                                        <li>
                                                            <i class="bi bi-envelope"></i>
                                                            <span>@e.Destinatario</span>
                                                            <span class="cotiz-timeline__meta">@e.FechaHoraEnvio.ToString("dd/MM/yyyy HH:mm")@(string.IsNullOrWhiteSpace(e.UsuarioEnvio) ? "" : $" · {e.UsuarioEnvio}")</span>
                                                            @if (e.FechaHoraLectura is { } lectura)
                                                            {
                                                                <span title="@GetAperturaTitle(e)"><AlfaTag Tone="AlfaTagTone.Success">Abierto (aprox.) @lectura.ToString("dd/MM HH:mm")</AlfaTag></span>
                                                            }
                                                            else
                                                            {
                                                                <AlfaTag Tone="AlfaTagTone.Neutral">Sin apertura detectada</AlfaTag>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                                <p class="cotiz-timeline__hint">"Abierto (aprox.)" no es 100% confiable: algunos clientes de correo (ej. Apple Mail) precargan imágenes aunque el destinatario no haya abierto el email.</p>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (_detail.IdOportunidad is > 0)
                                {
                                    <div class="cotiz-timeline__item">
                                        <span class="cotiz-timeline__dot"></span>
                                        <div class="cotiz-timeline__body">
                                            <strong>Cotización originada desde una oportunidad de CRM</strong>
                                            <span class="cotiz-timeline__meta">Oportunidad #@_detail.IdOportunidad</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                    else
                    {
                        @if (_detail.EsBorrador)
                        {
                            <div class="cotiz-toolbar">
                                <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-plus-lg" OnClick="_ => _showAddPanel = !_showAddPanel">Agregar</AlfaButton>
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-folder-plus" OnClick="_ => AgregarSeccion()">Sección</AlfaButton>
                                <AlfaButton Variant="AlfaButtonVariant.Secondary" Icon="bi bi-stars" Class="cotiz-alfa-cta" OnClick="AbrirAlfaDialogAsync">Configurar Alfa Gestión</AlfaButton>
                                <AlfaActionMenu Items="@MasAccionesItems" TriggerLabel="Más líneas" TriggerIcon="bi bi-three-dots" />
                            </div>

                            @if (_showAddPanel)
                            {
                                <div class="cotiz-add-panel">
                                    <div class="cotiz-add-panel__tabs">
                                        <button type="button" class="@(_addPanelMode == "articulo" ? "is-active" : "")" @onclick='() => _addPanelMode = "articulo"'>Artículos</button>
                                        <button type="button" class="@(_addPanelMode == "servicio" ? "is-active" : "")" @onclick='() => _addPanelMode = "servicio"'>Servicios</button>
                                        <button type="button" class="@(_addPanelMode == "ia" ? "is-active" : "")" @onclick='() => _addPanelMode = "ia"'><i class="bi bi-stars"></i> Asistente IA</button>
                                        <button type="button" class="cotiz-add-panel__close" @onclick="() => _showAddPanel = false" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    @if (_addPanelMode == "articulo")
                                    {
                                        <AlfaLookup TItem="CrmCotizacionArticuloDto" Placeholder="Buscar artículo por descripción o código..."
                                                    SearchFunc="BuscarArticulosLookupAsync" ItemKey="a => a.IdArticulo"
                                                    SelectedItem="null" SelectedItemChanged="OnArticuloSeleccionadoAsync">
                                            <ItemTemplate Context="a">
                                                <span class="cotiz-lookup-item__title">@a.Descripcion</span>
                                                <span class="cotiz-lookup-item__meta">@a.PrecioUnitarioConIva.ToString("N2")</span>
                                            </ItemTemplate>
                                        </AlfaLookup>
                                    }
                                    else if (_addPanelMode == "servicio")
                                    {
                                        <AlfaLookup TItem="CotizacionTareaDto" Placeholder="Buscar servicio..."
                                                    SearchFunc="BuscarTareasLookupAsync" ItemKey="t => t.IdTarea"
                                                    SelectedItem="null" SelectedItemChanged="OnTareaSeleccionadaAsync">
                                            <ItemTemplate Context="t">
                                                <span class="cotiz-lookup-item__title">@t.Descripcion</span>
                                                <span class="cotiz-lookup-item__meta">@t.ValorHora.ToString("N2") / hora</span>
                                            </ItemTemplate>
                                        </AlfaLookup>
                                    }
                                    else
                                    {
                                        <div class="cotiz-ia-input">
                                            <input placeholder="Ej: 5 cajas de tornillos y una de cinta" value="@_iaPrompt"
                                                   @oninput="args => _iaPrompt = args.Value?.ToString() ?? string.Empty" @onkeydown="OnIaKeyDownAsync" />
                                            <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-magic" Loading="@_iaCargando"
                                                        Disabled="@string.IsNullOrWhiteSpace(_iaPrompt)" OnClick="_ => SugerirLineasIaAsync()">Sugerir</AlfaButton>
                                        </div>
                                        <p class="cotiz-ia-hint">La IA interpreta tu pedido y busca los artículos reales del catálogo. Los precios salen del maestro, nunca los inventa.</p>

                                        @if (_iaSugerencias.Count > 0)
                                        {
                                            <div class="cotiz-ia-results">
                                                <div class="cotiz-ia-results__head">
                                                    <strong>@_iaSugerencias.Count sugerencia(s)</strong>
                                                    <div class="cotiz-ia-results__actions">
                                                        <button type="button" class="cotiz-link-btn" @onclick="ToggleTodasIaSugerencias">@(_iaSeleccion.Count == _iaSugerencias.Count ? "Ninguno" : "Todos")</button>
                                                        <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-plus-lg" Disabled="@(_iaSeleccion.Count == 0)" OnClick="_ => AgregarSugerenciasIaSeleccionadas()">Agregar (@_iaSeleccion.Count)</AlfaButton>
                                                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" OnClick="_ => { _iaSugerencias.Clear(); _iaSeleccion.Clear(); }">Descartar</AlfaButton>
                                                    </div>
                                                </div>
                                                @foreach (var sug in _iaSugerencias)
                                                {
                                                    <div class="cotiz-ia-result">
                                                        <AlfaCheckbox Value="@_iaSeleccion.Contains(sug.IdArticulo)" ValueChanged="v => ToggleIaSugerencia(sug.IdArticulo, v == true)">
                                                            <span class="cotiz-ia-result__desc">@sug.Descripcion</span>
                                                            <span class="cotiz-ia-result__meta">@sug.Cantidad.ToString("0.##") × @sug.PrecioUnitarioNeto.ToString("N2")</span>
                                                        </AlfaCheckbox>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }

                        @if (SinSeccion().Count == 0 && _detail.Secciones.Count == 0)
                        {
                            <AlfaEmptyState Title="Todavía no agregaste productos o servicios"
                                            Message="Usá &quot;Agregar&quot; para sumar artículos, servicios o una línea libre."
                                            ActionLabel="@(_detail.EsBorrador ? "Agregar" : null)" ActionIcon="bi bi-plus-lg"
                                            OnAction="_ => _showAddPanel = true" />
                        }
                        else
                        {
                            @if (SinSeccion().Count > 0)
                            {
                                <div class="cotiz-seccion">
                                    <div class="cotiz-seccion__header">
                                        <span class="cotiz-seccion__title">General</span>
                                        <span class="cotiz-seccion__subtotal">@SinSeccion().Where(l => l.ImpactaTotal).Sum(l => l.Subtotal).ToString("N2")</span>
                                    </div>
                                    @RenderLineasTable(SinSeccion(), null)
                                </div>
                            }

                            @foreach (var seccion in _detail.Secciones.OrderBy(s => s.Orden).ToList())
                            {
                                <div class="cotiz-seccion">
                                    <div class="cotiz-seccion__header">
                                        <i class="bi bi-folder2"></i>
                                        <input class="cotiz-seccion__title-input" value="@seccion.Titulo" disabled="@(!_detail.EsBorrador)"
                                               @onchange="args => seccion.Titulo = args.Value?.ToString() ?? string.Empty" />
                                        <span class="cotiz-seccion__subtotal">@LineasDeSeccion(seccion.IdSeccion).Where(l => l.ImpactaTotal).Sum(l => l.Subtotal).ToString("N2")</span>
                                        @if (_detail.EsBorrador)
                                        {
                                            <div class="cotiz-seccion__actions">
                                                <AlfaIconButton Icon="bi bi-arrow-up" Label="Subir" Size="AlfaSize.Sm" OnClick="_ => MoverSeccion(seccion, -1)" />
                                                <AlfaIconButton Icon="bi bi-arrow-down" Label="Bajar" Size="AlfaSize.Sm" OnClick="_ => MoverSeccion(seccion, 1)" />
                                                <AlfaIconButton Icon="bi bi-trash" Label="Eliminar sección" Size="AlfaSize.Sm" OnClick="_ => EliminarSeccion(seccion)" />
                                            </div>
                                        }
                                    </div>
                                    @RenderLineasTable(LineasDeSeccion(seccion.IdSeccion), seccion.IdSeccion)
                                </div>
                            }
                        }
                    }
                </main>

                <aside class="cotiz-sidebar">
                    <div class="cotiz-sidebar__card">
                        <h4>Resumen</h4>
                        <div class="cotiz-sidebar__row"><span>Subtotal</span><span>@_detail.Subtotal.ToString("N2")</span></div>
                        @if (_detail.EsBorrador)
                        {
                            <div class="cotiz-sidebar__row cotiz-sidebar__row--input">
                                <span>Descuento general</span>
                                <div class="cotiz-sidebar__discount">
                                    <input type="number" min="0" max="100" step="0.01" value="@_detail.DescuentoGeneralPorcentaje"
                                           @onchange="args => { _detail.DescuentoGeneralPorcentaje = ParseDecimal(args.Value); RecalcularTotales(); }" />
                                    <span>%</span>
                                </div>
                            </div>
                        }
                        @if (_detail.TotalDescuento > 0)
                        {
                            <div class="cotiz-sidebar__row"><span>Descuento</span><span>-@_detail.TotalDescuento.ToString("N2")</span></div>
                        }
                        <div class="cotiz-sidebar__row cotiz-sidebar__row--total"><span>Total</span><span>@_detail.Total.ToString("N2") @_detail.CodigoMoneda</span></div>
                    </div>

                    <div class="cotiz-sidebar__card">
                        <h4>Validez</h4>
                        <p>@(_detail.FechaVencimiento is { } v2 ? $"Vence el {v2:dd/MM/yyyy}" : "Sin fecha de vencimiento")</p>
                    </div>

                    @if (_clienteInfo is not null)
                    {
                        <div class="cotiz-sidebar__card">
                            <h4>Cliente</h4>
                            <p class="cotiz-sidebar__client-name">@_clienteInfo.Nombre</p>
                            <p class="cotiz-sidebar__client-meta">@(_clienteInfo.EsConsumidorFinal ? "Consumidor final" : $"Lista {_clienteInfo.IdLista} · Clase {_clienteInfo.ClasePrecio}")</p>
                        </div>
                    }
                </aside>
            </div>
        </div>
    }

    <AlfaDialog Open="@_showClienteDialog" Title="Cliente" Eyebrow="Datos comerciales" Size="AlfaDialogSize.Md" OnClose="_ => _showClienteDialog = false">
        <ChildContent>
            @if (!_prospectoMode)
            {
                <AlfaLookup TItem="CotizacionClienteOptionDto" Label="Buscar cliente existente" Placeholder="Nombre, código..."
                            SearchFunc="BuscarClientesLookupAsync" ItemKey="c => c.Codigo"
                            SelectedItem="null" SelectedItemChanged="OnClienteSeleccionadoAsync">
                    <ItemTemplate Context="c">
                        <span class="cotiz-lookup-item__title">@c.RazonSocial</span>
                        <span class="cotiz-lookup-item__meta">@c.Codigo@(string.IsNullOrWhiteSpace(c.Localidad) ? "" : $" · {c.Localidad}")</span>
                    </ItemTemplate>
                </AlfaLookup>
                <button type="button" class="cotiz-link-btn" @onclick="() => _prospectoMode = true">+ Cotizar a un prospecto</button>
            }
            else
            {
                <div class="field">
                    <label>Empresa / Prospecto</label>
                    <input class="field-input" @bind="_detail!.EmpresaProspecto" />
                </div>
                <button type="button" class="cotiz-link-btn" @onclick="() => _prospectoMode = false">Buscar un cliente existente</button>
            }
        </ChildContent>
        <Footer>
            <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => _showClienteDialog = false">Cerrar</AlfaButton>
        </Footer>
    </AlfaDialog>

    <AlfaDialog Open="@_showAlfaDialog" Title="Configurar Alfa Gestión" Eyebrow="Configurador comercial" Size="AlfaDialogSize.Lg" OnClose="_ => _showAlfaDialog = false">
        <ChildContent>
            @if (_alfaConfig.Modulos.Count == 0)
            {
                <AlfaEmptyState Title="Todavía no hay módulos configurados" Message="Cargalos desde la pestaña Configuración del módulo." />
            }
            else
            {
                <div class="cotiz-alfa">
                    <div class="cotiz-alfa__section">
                        <h4>1. Módulos</h4>
                        <div class="cotiz-alfa__modulos">
                            @foreach (var modulo in _alfaConfig.Modulos)
                            {
                                var seleccionado = _alfaSelectedModulos.Contains(modulo.Codigo);
                                <button type="button" class="cotiz-alfa__modulo @(seleccionado ? "is-selected" : "")" @onclick="() => ToggleAlfaModuloAsync(modulo.Codigo, !seleccionado)">
                                    <i class="bi @(seleccionado ? "bi-check-circle-fill" : "bi-circle")"></i>
                                    <span>@modulo.Nombre</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="cotiz-alfa__section">
                        <h4>2. Usuarios</h4>
                        <div class="cotiz-alfa__stepper">
                            <AlfaIconButton Icon="bi bi-dash-lg" Label="Menos usuarios" OnClick="_ => AjustarAlfaUsuariosAsync(-1)" />
                            <span>@_alfaUsuarios usuario@(_alfaUsuarios == 1 ? "" : "s")</span>
                            <AlfaIconButton Icon="bi bi-plus-lg" Label="Más usuarios" OnClick="_ => AjustarAlfaUsuariosAsync(1)" />
                        </div>
                        @if (_alfaResult is not null)
                        {
                            var licencia = _alfaResult.Lineas.FirstOrDefault(l => l.Tipo == CotizacionDetTipos.Libre);
                            <div class="cotiz-alfa__pricing">
                                <span>@_alfaConfig.PrecioBase.ToString("N0") base + @_alfaConfig.PrecioPorUsuario.ToString("N0") × @_alfaUsuarios usuarios</span>
                                <strong>Licencia @(licencia?.Subtotal.ToString("N2") ?? "—")</strong>
                            </div>
                        }
                    </div>

                    @if (_alfaResult?.PackRecomendado is not null)
                    {
                        <div class="cotiz-alfa__section">
                            <h4>3. Implementación</h4>
                            <div class="cotiz-alfa__pack">
                                <strong>@(_alfaResult.PackRecomendadoDescripcion ?? "Pack de implementación")</strong>
                                <span>Recomendado para esta instalación</span>
                                <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" OnClick="_ => AgregarResultadoAlfaAsync(_alfaResult.PackRecomendado.IdTarea)">Seleccionar</AlfaButton>
                            </div>
                        </div>
                    }
                </div>
            }
        </ChildContent>
        <Footer>
            <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => _showAlfaDialog = false">Cerrar</AlfaButton>
            @if (_alfaResult is not null)
            {
                <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-plus-lg" OnClick="_ => AgregarResultadoAlfaAsync(null)">Agregar sin implementación</AlfaButton>
            }
        </Footer>
    </AlfaDialog>

    <AlfaConfirmDialog Open="@_showAnularConfirm" Title="Anular cotización"
                        Message="@($"¿Anular la cotización {_detail?.CodigoVisible}? La cotización quedará marcada como anulada y no se podrá revertir desde acá.")"
                        ConfirmLabel="Anular" CancelLabel="Cancelar" Loading="@_anulando"
                        OnConfirm="ConfirmarAnularAsync" OnCancel="() => _showAnularConfirm = false" />

    <AlfaDialog Open="@_showCompartirDialog" Title="Compartir cotización" Eyebrow="@(_detail?.CodigoVisible)" Size="AlfaDialogSize.Md" OnClose="_ => _showCompartirDialog = false">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(_compartirUrl))
            {
                <div class="field">
                    <label>Link público</label>
                    <div class="cotiz-compartir-row">
                        <input class="field-input" readonly value="@_compartirUrl" />
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-clipboard" OnClick="_ => CopiarLinkAsync()">Copiar</AlfaButton>
                    </div>
                    <p class="panel-card__subtitle">Cualquiera con este link puede ver esta versión de la cotización, sin necesidad de iniciar sesión.</p>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-file-earmark-pdf" OnClick="_ => DescargarPdfCompartirAsync()">Descargar PDF</AlfaButton>
                </div>
            }
            else
            {
                <p class="panel-card__subtitle">Generando el link público...</p>
            }

            <div class="field cotiz-compartir-email">
                <label>Enviar por email</label>
                <div class="cotiz-compartir-row">
                    <input class="field-input" type="email" placeholder="cliente@correo.com" value="@_compartirEmail"
                           @oninput="args => _compartirEmail = args.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="cotiz-ia-input">
                    <i class="bi bi-stars"></i>
                    <input placeholder="Ej: mensaje corto agradeciendo el interés" value="@_iaMensajePrompt"
                           @oninput="args => _iaMensajePrompt = args.Value?.ToString() ?? string.Empty" @onkeydown="OnIaMensajeKeyDownAsync" />
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-magic" Loading="@_iaMensajeCargando"
                                OnClick="_ => GenerarMensajeIaAsync()">Generar</AlfaButton>
                </div>
                <textarea class="cotiz-compartir-mensaje" rows="5" placeholder="Mensaje para el cliente..." value="@_compartirMensaje"
                          @oninput="args => _compartirMensaje = args.Value?.ToString() ?? string.Empty"></textarea>
                <p class="cotiz-ia-hint">El PDF de la cotización se adjunta automáticamente.</p>
                <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-envelope" Loading="@_enviandoEmail"
                            Disabled="@string.IsNullOrWhiteSpace(_compartirEmail)" OnClick="_ => EnviarEmailAsync()">Enviar</AlfaButton>
            </div>
        </ChildContent>
        <Footer>
            <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => _showCompartirDialog = false">Cerrar</AlfaButton>
        </Footer>
    </AlfaDialog>
</div>

@code {
    [SupplyParameterFromQuery(Name = "oportunidad")] public long? OportunidadQuery { get; set; }
    [SupplyParameterFromQuery(Name = "empresa")] public string? EmpresaQuery { get; set; }
    [SupplyParameterFromQuery(Name = "contacto")] public string? ContactoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? EmailQuery { get; set; }
    [SupplyParameterFromQuery(Name = "telefono")] public string? TelefonoQuery { get; set; }

    private static readonly List<AlfaTabItem> EditorTabs =
    [
        new("productos", "Productos y servicios"),
        new("propuesta", "Propuesta"),
        new("condiciones", "Condiciones"),
        new("historial", "Historial")
    ];

    private sealed record PropuestaCommandOption(string Group, string Title, string Description, string Icon, string Command);

    // Mismo catálogo de comandos que usa Tickets (tickets-rich-editor.js), curado para una
    // propuesta comercial: se dejan afuera los específicos de tickets (Artículo, Índice).
    private static readonly IReadOnlyList<PropuestaCommandOption> PropuestaCommands =
    [
        new("FORMATEAR", "Título 1", "Título de sección grande", "bi-type-h1", "h1"),
        new("FORMATEAR", "Título 2", "Título de sección mediano", "bi-type-h2", "h2"),
        new("FORMATEAR", "Título 3", "Título de sección pequeño", "bi-type-h3", "h3"),
        new("FORMATEAR", "Texto", "Bloque de párrafo", "bi-paragraph", "paragraph"),
        new("ESTRUCTURA", "Separador", "Insertar un separador horizontal", "bi-dash-lg", "separator"),
        new("ESTRUCTURA", "Lista de viñetas", "Crear una lista simple", "bi-list-ul", "bulletList"),
        new("ESTRUCTURA", "Lista numerada", "Crear una lista numerada", "bi-list-ol", "numberedList"),
        new("ESTRUCTURA", "Lista de comprobación", "Llevar seguimiento de entregables", "bi-check2-square", "checkList"),
        new("BANNER", "Banner de información", "Insertar un aviso informativo", "bi-info-circle-fill", "infoBanner"),
        new("BANNER", "Banner de éxito", "Insertar un aviso destacado", "bi-check-circle-fill", "successBanner"),
        new("BANNER", "Banner de advertencia", "Insertar un aviso de advertencia", "bi-exclamation-triangle-fill", "warningBanner"),
        new("MEDIOS", "Imagen", "Insertar o pegar una imagen", "bi-file-earmark-image", "media"),
        new("NAVEGACIÓN", "Enlace", "Añadir un enlace", "bi-link-45deg", "link"),
        new("NAVEGACIÓN", "Cita", "Añadir una cita destacada", "bi-quote", "quote")
    ];

    private static readonly IReadOnlyList<PropuestaCommandOption> ToolbarPropuestaCommands =
    [
        PropuestaCommands[0],
        PropuestaCommands[5],
        PropuestaCommands[6],
        PropuestaCommands[11],
        PropuestaCommands[12]
    ];

    // ---- Listado ----
    private List<CotizacionListItemDto> _items = [];
    private bool _loadingList = true;
    private CotizacionListFiltersDto _filters = new();
    private int _totalRegistros;
    private int _totalPages = 1;
    private bool _hasPrevPage;
    private bool _hasNextPage;
    private CotizacionResumenDto _resumen = new();
    private string _listTab = "todas";
    private CancellationTokenSource? _searchDebounceCts;
    private bool _showSearchPanel;
    private readonly HashSet<long> _selectedIds = new();
    private bool _showBulkAnularConfirm;
    private bool _bulkAnulando;

    private static readonly IReadOnlyList<AlfaSelectOption> CotizPageSizeOptions =
    [
        new("25", "25 por página"),
        new("50", "50 por página"),
        new("100", "100 por página")
    ];

    // ---- Editor ----
    private bool _showEditor;
    private CotizacionVersionDetailDto? _detail;
    private AppUiMessage? _feedback;
    private string _activeTab = "productos";
    private bool _permiteDescuentoLinea;
    private List<CotizacionVersionSummaryDto> _versiones = [];
    private Dictionary<long, List<CotizacionEmailEnvioDto>> _emailEnvios = [];
    private bool _showVersionMenu;
    private CotizacionClienteInfoDto? _clienteInfo;
    private bool _showClienteDialog;
    private bool _prospectoMode;
    private bool _showAnularConfirm;
    private bool _anulando;

    private bool _showCompartirDialog;
    private string _compartirUrl = string.Empty;
    private string _compartirEmail = string.Empty;
    private string _compartirMensaje = string.Empty;
    private string _iaMensajePrompt = string.Empty;
    private bool _iaMensajeCargando;
    private bool _enviandoEmail;

    private ElementReference _richEditorRef;
    private IJSObjectReference? _richEditorJs;
    private bool _pendingRichEditorSync;

    private bool _showAlfaDialog;
    private CotizacionAlfaConfigDto _alfaConfig = new();
    private readonly HashSet<string> _alfaSelectedModulos = new(StringComparer.OrdinalIgnoreCase);
    private int _alfaUsuarios = 1;
    private CotizacionAlfaResultDto? _alfaResult;

    private bool _showAddPanel;
    private string _addPanelMode = "articulo";

    private string _iaPrompt = string.Empty;
    private bool _iaCargando;
    private List<CrmCotizacionAiLineaSugeridaDto> _iaSugerencias = [];
    private HashSet<string> _iaSeleccion = [];

    private string _iaPropuestaPrompt = string.Empty;
    private bool _iaPropuestaCargando;

    private bool _showPropuestaCommands;

    private long _seccionTempCounter = -1;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();

        // El editor de texto enriquecido usa @ref (_richEditorRef), que Blazor solo termina de
        // asignar DESPUÉS del primer render -- nunca se puede tocar desde OnInitializedAsync (ej.
        // el flujo de "Nueva cotización" que llega precargado desde CRM abre el editor ahí mismo).
        // Por eso AbrirAsync solo marca la bandera; la sincronización real del JS se hace acá,
        // donde el elemento del DOM ya existe.
        if (_pendingRichEditorSync)
        {
            _pendingRichEditorSync = false;
            await SyncRichEditorAsync();
        }
    }

    public void Dispose() => PageHeader.Clear();

    protected override async Task OnInitializedAsync()
    {
        if (OportunidadQuery is > 0)
        {
            var idVersion = await CotizSvc.CreateAsync(new CotizacionCreateRequest
            {
                IdOportunidad = OportunidadQuery,
                EmpresaProspecto = EmpresaQuery,
                ContactoNombre = ContactoQuery,
                ContactoEmail = EmailQuery,
                ContactoTelefono = TelefonoQuery,
                UsuarioAccion = CurrentUserName
            });
            await AbrirAsync(idVersion);
        }
        else
        {
            await BuscarAsync();
        }
    }

    private string CurrentUserName => AppUserSession.CurrentUser?.UserName ?? Environment.UserName;

    private async Task ChangeTabAsync(string? key)
    {
        var next = key ?? "productos";

        // El editor de texto enriquecido solo existe en el DOM mientras la pestaña Propuesta
        // está activa (@if la desmonta al salir). Si el usuario escribió algo ahí, hay que
        // volcarlo a _detail.CuerpoPropuesta ANTES de desmontar -- si no, GetRichEditorHtmlAsync
        // (llamado desde Guardar borrador en cualquier pestaña) quedaría con una referencia a un
        // elemento que ya no existe.
        if (_activeTab == "propuesta" && next != "propuesta" && _richEditorJs is not null && _detail is not null)
            _detail.CuerpoPropuesta = await GetRichEditorHtmlAsync();

        _activeTab = next;

        if (_activeTab == "propuesta")
            _pendingRichEditorSync = true;
    }

    private Task HandlePageClickAsync()
    {
        _showVersionMenu = false;
        if (_showSearchPanel)
        {
            _showSearchPanel = false;
            UpdatePageHeader();
        }
        return Task.CompletedTask;
    }

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();
        if (!_showEditor)
        {
            if (_selectedIds.Count > 0)
            {
                actions.Add(new PageHeaderAction { Key = "seleccion", Label = $"{_selectedIds.Count} seleccionadas", Icon = "bi-check2-square", Style = PageHeaderActionStyle.Ghost, Disabled = true });
                actions.Add(new PageHeaderAction { Key = "anular-masiva", Label = "Anular", Icon = "bi-slash-circle", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Essential, OnClick = () => { _showBulkAnularConfirm = true; return Task.CompletedTask; } });
                actions.Add(new PageHeaderAction { Key = "cancelar-seleccion", Label = "Cancelar selección", Icon = "bi-x-lg", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = ClearSelectionAsync });
            }
            actions.Add(new PageHeaderAction { Key = "nueva", Label = "Nueva cotización", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = AbrirNuevaAsync });
            actions.Add(new PageHeaderAction { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Disabled = _loadingList, OnClick = BuscarAsync });
        }
        else if (_detail is not null)
        {
            if (_detail.EsBorrador)
            {
                actions.Add(new PageHeaderAction { Key = "guardar", Label = "Guardar borrador", Icon = "bi-floppy", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = GuardarBorradorAsync });
                actions.Add(new PageHeaderAction { Key = "compartir", Label = "Compartir", Icon = "bi-send", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = AbrirCompartirDialogAsync });
                actions.Add(new PageHeaderAction { Key = "marcar-enviada", Label = "Marcar enviada", Icon = "bi-check2", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = MarcarEnviadaAsync });
            }
            else
            {
                actions.Add(new PageHeaderAction { Key = "compartir", Label = "Compartir", Icon = "bi-send", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = AbrirCompartirDialogAsync });
                if (string.Equals(_detail.EstadoVersion, CotizacionEstados.Enviada, StringComparison.OrdinalIgnoreCase))
                {
                    actions.Add(new PageHeaderAction { Key = "aceptar", Label = "Marcar aceptada", Icon = "bi-check-circle", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = MarcarAceptadaAsync });
                    actions.Add(new PageHeaderAction { Key = "rechazar", Label = "Marcar rechazada", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow, OnClick = MarcarRechazadaAsync });
                }
                actions.Add(new PageHeaderAction { Key = "nueva-version", Label = "Nueva versión", Icon = "bi-file-earmark-plus", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = NuevaVersionAsync });
            }
            actions.Add(new PageHeaderAction { Key = "anular", Label = "Anular", Icon = "bi-slash-circle", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow, OnClick = () => { _showAnularConfirm = true; return Task.CompletedTask; } });
            actions.Add(new PageHeaderAction { Key = "volver", Label = "Volver al listado", Icon = "bi-arrow-left", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = () => { CerrarEditor(); return Task.CompletedTask; } });
        }

        PageHeader.Set(new PageHeaderConfig
        {
            Title = !_showEditor ? "Cotizaciones" : _detail is null ? "Cotización" : $"{_detail.CodigoVisible} · v{_detail.NumeroVersion}",
            Breadcrumb = ["Cotizaciones"],
            State = _showEditor ? PageHeaderState.Editing : _loadingList ? PageHeaderState.Loading : _selectedIds.Count > 0 ? PageHeaderState.Selection : PageHeaderState.List,
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCotizaciones(RouteContext, Nav, "cotizaciones"),
            Search = _showEditor ? null : new PageHeaderSearchConfig(),
            SearchContent = _showEditor ? null : RenderCotizSmartSearch(),
            Pagination = _showEditor ? null : BuildCotizHeaderPagination(),
            Actions = actions
        });
    }

    private PageHeaderPaginationConfig BuildCotizHeaderPagination()
        => new()
        {
            Label = $"{_totalRegistros} registro(s)",
            PageLabel = $"{_filters.PageNumber} / {_totalPages}",
            HasPrevious = _hasPrevPage,
            HasNext = _hasNextPage,
            Disabled = _loadingList,
            OnPrevious = () => CambiarPaginaCotizAsync(_filters.PageNumber - 1),
            OnNext = () => CambiarPaginaCotizAsync(_filters.PageNumber + 1)
        };

    private async Task CambiarPaginaCotizAsync(int page)
    {
        if (page < 1 || page > _totalPages || _loadingList)
            return;
        _filters.PageNumber = page;
        await BuscarAsync();
    }

    private async Task SetCotizPageSizeAsync(string? value)
    {
        if (int.TryParse(value, out var size) && size > 0)
            _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
    }

    private string GetCotizBrowseSummary()
        => $"{(_totalRegistros == 1 ? "1 registro" : $"{_totalRegistros} registros")} · Página {_filters.PageNumber} de {_totalPages}";

    // ---- Selección masiva ----

    private bool AreAllVisibleSelected
        => _items.Count > 0 && _items.All(i => _selectedIds.Contains(i.IdCotizacion));

    private async Task ToggleSelectAllAsync(ChangeEventArgs args)
    {
        var check = args.Value is bool b && b;
        if (check)
            foreach (var item in _items)
                _selectedIds.Add(item.IdCotizacion);
        else
            foreach (var item in _items)
                _selectedIds.Remove(item.IdCotizacion);
        UpdatePageHeader();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task ToggleRowSelectionAsync(long idCotizacion, ChangeEventArgs args)
    {
        var check = args.Value is bool b && b;
        if (check)
            _selectedIds.Add(idCotizacion);
        else
            _selectedIds.Remove(idCotizacion);
        UpdatePageHeader();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private Task ClearSelectionAsync()
    {
        _selectedIds.Clear();
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private async Task ConfirmarAnularSeleccionadasAsync()
    {
        _bulkAnulando = true;
        var ids = _selectedIds.ToList();
        var fallo = 0;
        foreach (var idCotizacion in ids)
        {
            var result = await UiOps.RunAsync(async () => { await CotizSvc.AnularAsync(idCotizacion, CurrentUserName); return true; }, "No se pudo anular la cotización.");
            if (result.Success)
                _selectedIds.Remove(idCotizacion);
            else
                fallo++;
        }

        _bulkAnulando = false;
        _showBulkAnularConfirm = false;

        if (fallo == 0)
            SetFeedback(AppUiMessage.Success("Cotizaciones anuladas", $"Se anularon {ids.Count} cotización(es)."));
        else
            SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Warning, Title = "Anulación parcial", Message = $"No se pudieron anular {fallo} de {ids.Count} cotización(es) seleccionadas." });

        await BuscarAsync();
    }

