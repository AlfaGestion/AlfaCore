    private async Task AbrirCompartirDialogAsync()
    {
        if (_detail is null)
            return;

        _showCompartirDialog = true;
        _compartirUrl = string.Empty;
        _compartirEmail = _detail.ContactoEmail ?? string.Empty;
        _compartirMensaje = string.Empty;
        _iaMensajePrompt = string.Empty;
        StateHasChanged();

        var result = await UiOps.RunAsync(() => CotizSvc.EnsureShareAsync(_detail.IdVersion), "No se pudo generar el link para compartir.");
        if (result.Success && result.Value is not null && !string.IsNullOrWhiteSpace(result.Value.RelativeUrl))
            _compartirUrl = BuildPublicBase().TrimEnd('/') + result.Value.RelativeUrl;
        else if (!result.Success)
            SetFeedback(result.Feedback);

        var textoResult = await UiOps.RunAsync(() => CotizSvc.GetEmailTextoPredeterminadoAsync(), "No se pudo cargar el mensaje predeterminado del email.");
