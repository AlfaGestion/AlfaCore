    private async Task EnviarEmailAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_compartirEmail))
            return;

        _enviandoEmail = true;
        var destino = _compartirEmail.Trim();
        var idVersion = _detail.IdVersion;
        var urlParaEnviar = string.IsNullOrWhiteSpace(_compartirUrl) ? null : _compartirUrl;
        var mensaje = _compartirMensaje;
        var result = await UiOps.RunAsync(() => CotizSvc.SendByEmailAsync(idVersion, destino, urlParaEnviar, mensaje), "No se pudo enviar la cotización por email.");
        _enviandoEmail = false;

        if (result.Success)
        {
            _showCompartirDialog = false;
            SetFeedback(result.Value
                ? new AppUiMessage
                {
                    Severity = AppUiFeedbackSeverity.Warning,
                    Title = "Email enviado con la cuenta de AlfaGestión",
                    Message = $"Se envió a {destino} usando la cuenta de correo de AlfaGestión porque todavía no configuraste una propia. " +
                              "Configurala en Utilidades → Configuración General → Email (o en tu usuario) para una mejor entrega."
                }
                : AppUiMessage.Success("Email enviado", $"La cotización se envió a {destino}."));
            await AbrirAsync(idVersion, resetTab: false);
        }
        else
        {
            SetFeedback(result.Feedback);
        }
    }

