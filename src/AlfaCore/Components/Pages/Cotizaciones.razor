    private async Task SetListTabAsync(string tab)
    {
        _listTab = tab;
        _filters.SoloVencidas = tab == "vencidas" ? true : null;
        _filters.Estado = tab switch
        {
            "borradores" => CotizacionEstados.Borrador,
            "enviadas" => CotizacionEstados.Enviada,
            "aceptadas" => CotizacionEstados.Aceptada,
            _ => null
        };
        _filters.PageNumber = 1;
        _showSearchPanel = false;
        await BuscarAsync();
    }

    // ---- Búsqueda inteligente (barra superior, mismo patrón que Técnicos/Contactos) ----

    private sealed record SmartChip(string Key, string Label);

    private RenderFragment RenderCotizSmartSearch() => @<div class="smart-search" @onclick:stopPropagation @onkeydown="HandleCotizApplyKeyDownAsync">
        @{ var activeChips = BuildCotizFilterChips(); }
        <div class="smart-search__bar @(_showSearchPanel ? "is-open" : string.Empty)">
            <span class="smart-search__search-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
            <button type="button"
                    class="smart-search__filter-button @(_showSearchPanel || activeChips.Count > 0 ? "is-active" : string.Empty)"
                    title="Abrir filtros" aria-label="Abrir filtros" aria-expanded="@_showSearchPanel"
                    @onclick="ToggleCotizSearchPanel">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
            </button>
            <div class="smart-search__active-filters" aria-label="Filtros activos">
                @foreach (var chip in activeChips)
                {
                    <button type="button" class="smart-search__active-filter" title="@($"Quitar filtro {chip.Label}")" aria-label="@($"Quitar filtro {chip.Label}")" @onclick='() => SetListTabAsync("todas")'>
                        <span>@chip.Label</span>
                        <span class="smart-search__active-filter-remove" aria-hidden="true"><i class="bi bi-x"></i></span>
                    </button>
                }
            </div>
            <input type="search" placeholder="Buscar por número, cliente o contacto..." value="@_filters.Texto" @onfocus="OpenCotizSearchPanel" @oninput="OnBuscarTextoAsync" @onkeydown="HandleCotizApplyKeyDownAsync" />
            <button type="button" class="smart-search__toggle" @onclick="ToggleCotizSearchPanel" aria-label="Mostrar filtros" aria-expanded="@_showSearchPanel">
                <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_showSearchPanel)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="CloseCotizSearchPanel"></button>
            <div class="smart-search__panel smart-search__panel--compact" @onclick:stopPropagation @onkeydown="HandleCotizApplyKeyDownAsync">
                <div class="smart-search__column smart-search__section smart-search__section--status">
                    <h4><i class="bi bi-funnel-fill"></i> Estado</h4>
                    <button type="button" class="@GetSmartOptionClass(_listTab == "todas")" @onclick='() => SetListTabAsync("todas")'>Todas</button>
                    <button type="button" class="@GetSmartOptionClass(_listTab == "borradores")" @onclick='() => SetListTabAsync("borradores")'>Borradores</button>
                    <button type="button" class="@GetSmartOptionClass(_listTab == "enviadas")" @onclick='() => SetListTabAsync("enviadas")'>Enviadas</button>
                    <button type="button" class="@GetSmartOptionClass(_listTab == "aceptadas")" @onclick='() => SetListTabAsync("aceptadas")'>Aceptadas</button>
                    <button type="button" class="@GetSmartOptionClass(_listTab == "vencidas")" @onclick='() => SetListTabAsync("vencidas")'>Vencidas</button>
                </div>
            </div>
        }
    </div>;

    private void OpenCotizSearchPanel()
    {
        _showSearchPanel = true;
        UpdatePageHeader();
    }

    private void ToggleCotizSearchPanel()
    {
        _showSearchPanel = !_showSearchPanel;
        UpdatePageHeader();
    }

    private void CloseCotizSearchPanel()
    {
        if (!_showSearchPanel)
            return;
        _showSearchPanel = false;
        UpdatePageHeader();
    }

    private Task HandleCotizApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
            CloseCotizSearchPanel();
        return Task.CompletedTask;
    }

    private IReadOnlyList<SmartChip> BuildCotizFilterChips()
    {
        var chips = new List<SmartChip>();
        var label = _listTab switch
        {
            "borradores" => "Borradores",
            "enviadas" => "Enviadas",
            "aceptadas" => "Aceptadas",
            "vencidas" => "Vencidas",
            _ => null
        };
        if (label is not null)
            chips.Add(new("estado", label));
        return chips;
    }

    private static string GetSmartOptionClass(bool active)
        => active ? "smart-option is-active" : "smart-option";

    private async Task OnBuscarTextoAsync(ChangeEventArgs args)
    {
        _filters.Texto = args.Value?.ToString();
        _filters.PageNumber = 1;
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
                await BuscarAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task BuscarAsync()
    {
        _loadingList = true;
        UpdatePageHeader();

        var listResult = await UiOps.RunAsync(() => CotizSvc.GetListAsync(_filters), "No se pudieron cargar las cotizaciones.");
        if (listResult.Success && listResult.Value is not null)
        {
            _items = listResult.Value.Items.ToList();
            _totalRegistros = listResult.Value.Total;
            _totalPages = Math.Max(1, listResult.Value.TotalPages);
            _hasPrevPage = listResult.Value.HasPrev;
            _hasNextPage = listResult.Value.HasNext;
            _selectedIds.RemoveWhere(id => !_items.Any(i => i.IdCotizacion == id));
        }
        else
        {
            SetFeedback(listResult.Feedback);
        }

        var resumenResult = await UiOps.RunAsync(() => CotizSvc.GetResumenAsync(), "No se pudo cargar el resumen de cotizaciones.");
        if (resumenResult.Success && resumenResult.Value is not null)
            _resumen = resumenResult.Value;

        _loadingList = false;
        UpdatePageHeader();
        StateHasChanged();
    }

    private async Task AbrirNuevaAsync()
    {
        var result = await UiOps.RunAsync(() => CotizSvc.CreateAsync(new CotizacionCreateRequest { UsuarioAccion = CurrentUserName }), "No se pudo crear la cotización.");
        if (result.Success)
            await AbrirAsync(result.Value);
        else
            SetFeedback(result.Feedback);
    }

    private async Task AbrirAsync(long idVersion, bool resetTab = true)
    {
        var result = await UiOps.RunAsync(() => CotizSvc.GetVersionDetailAsync(idVersion), "No se pudo cargar la cotización.");
        if (!result.Success || result.Value is null)
        {
            SetFeedback(result.Feedback);
            return;
        }

        _detail = result.Value;
        _showEditor = true;
        if (resetTab)
            _activeTab = "productos";
        _showAlfaDialog = false;
        _alfaResult = null;
        _alfaSelectedModulos.Clear();
        _showAddPanel = false;
        _showClienteDialog = false;
        _showVersionMenu = false;
        _prospectoMode = string.IsNullOrWhiteSpace(_detail.CodigoCliente);
        _clienteInfo = null;

        var permiteResult = await UiOps.RunAsync(() => CotizSvc.PermiteDescuentoPorLineaAsync(), "No se pudo leer la configuración de descuento por línea.");
        _permiteDescuentoLinea = permiteResult.Success && permiteResult.Value;

        var versionesResult = await UiOps.RunAsync(() => CotizSvc.GetVersionesAsync(_detail.IdCotizacion), "No se pudo cargar el historial de versiones.");
        _versiones = versionesResult.Success && versionesResult.Value is not null ? versionesResult.Value.ToList() : [];

        var enviosResult = await UiOps.RunAsync(() => CotizSvc.GetEmailEnviosAsync(_detail.IdCotizacion), "No se pudo cargar el historial de envíos por email.");
        _emailEnvios = enviosResult.Success && enviosResult.Value is not null
            ? enviosResult.Value.GroupBy(x => x.IdVersion).ToDictionary(g => g.Key, g => g.ToList())
            : [];

        if (!string.IsNullOrWhiteSpace(_detail.CodigoCliente))
        {
            var clienteResult = await UiOps.RunAsync(() => CotizSvc.ResolveClienteAsync(_detail.CodigoCliente!), "No se pudo resolver el cliente.");
            if (clienteResult.Success)
                _clienteInfo = clienteResult.Value;
        }

        UpdatePageHeader();
        // Solo tiene sentido sincronizar el editor JS si la pestaña Propuesta va a estar
        // montada en este render -- si no, _richEditorRef no apunta a ningún elemento real.
        if (_activeTab == "propuesta")
            _pendingRichEditorSync = true;

        // Esta acción llega disparada desde el botón de la barra superior (otro componente,
        // MainPageHeader), no desde un evento propio de Cotizaciones -- Blazor solo re-renderiza
        // automáticamente al componente dueño del evento que disparó el handler, así que sin este
        // StateHasChanged explícito el estado cambia (por eso la barra sí se actualiza, vía
        // IPageHeaderService) pero el cuerpo de la página se queda mostrando lo anterior.
        StateHasChanged();
    }

    private async Task SeleccionarVersionAsync(long idVersion)
    {
        _showVersionMenu = false;
        if (_detail is not null && idVersion == _detail.IdVersion)
            return;
        await AbrirAsync(idVersion);
    }

    private void CerrarEditor()
    {
        _showEditor = false;
        _detail = null;
        UpdatePageHeader();
        StateHasChanged();
        _ = BuscarAsync();
    }

    private async Task EnsureRichEditorLoadedAsync()
        => _richEditorJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/tickets-rich-editor.js?v=20260519a");

    private async Task SyncRichEditorAsync()
    {
        await EnsureRichEditorLoadedAsync();
        if (_richEditorJs is not null && _detail is not null)
            await _richEditorJs.InvokeVoidAsync("setHtml", _richEditorRef, _detail.CuerpoPropuesta ?? string.Empty);
    }

    private async Task<string> GetRichEditorHtmlAsync()
    {
        // _richEditorRef solo es válido mientras la pestaña Propuesta está montada -- en
        // cualquier otra pestaña, _detail.CuerpoPropuesta ya tiene el último valor conocido
        // (ChangeTabAsync lo vuelca ahí justo antes de desmontar el editor).
        if (_richEditorJs is null || _activeTab != "propuesta")
            return _detail?.CuerpoPropuesta ?? string.Empty;
        return await _richEditorJs.InvokeAsync<string>("getHtml", _richEditorRef);
    }

    private async Task OnPropuestaInputAsync()
    {
        if (_detail is not null)
            _detail.CuerpoPropuesta = await GetRichEditorHtmlAsync();
        if (_richEditorJs is not null)
            _showPropuestaCommands = await _richEditorJs.InvokeAsync<bool>("shouldShowCommands", _richEditorRef);
    }

    private async Task OnPropuestaFocusAsync()
    {
        if (_richEditorJs is not null)
            _showPropuestaCommands = await _richEditorJs.InvokeAsync<bool>("shouldShowCommands", _richEditorRef);
    }

    private void TogglePropuestaCommands() => _showPropuestaCommands = !_showPropuestaCommands;

    private async Task RunPropuestaCommandAsync(PropuestaCommandOption option)
    {
        if (_richEditorJs is null)
            return;
        await _richEditorJs.InvokeVoidAsync("runCommand", _richEditorRef, option.Command);
        if (_detail is not null)
            _detail.CuerpoPropuesta = await GetRichEditorHtmlAsync();
        _showPropuestaCommands = false;
    }

    private async Task GuardarBorradorAsync()
    {
        if (_detail is null)
            return;

        var cuerpo = await GetRichEditorHtmlAsync();
        var request = new CotizacionSaveVersionRequest
        {
            IdVersion = _detail.IdVersion,
            EmpresaProspecto = _detail.EmpresaProspecto,
            ContactoNombre = _detail.ContactoNombre,
            ContactoEmail = _detail.ContactoEmail,
            ContactoTelefono = _detail.ContactoTelefono,
            DocumentoFiscal = _detail.DocumentoFiscal,
            CodigoMoneda = _detail.CodigoMoneda,
            FechaVencimiento = _detail.FechaVencimiento,
            Observaciones = _detail.Observaciones,
            CuerpoPropuesta = cuerpo,
            DescuentoGeneralPorcentaje = _detail.DescuentoGeneralPorcentaje,
            IncluyePortada = _detail.IncluyePortada,
            Secciones = _detail.Secciones,
            Lineas = _detail.Lineas,
            UsuarioAccion = CurrentUserName
        };

        var result = await UiOps.RunAsync(() => CotizSvc.SaveVersionAsync(request), "No se pudo guardar la cotización.");
        if (result.Success)
        {
            SetFeedback(AppUiMessage.Success("Cotización guardada", "El borrador se guardó correctamente."));
            await AbrirAsync(_detail.IdVersion, resetTab: false);
        }
        else
        {
            SetFeedback(result.Feedback);
        }
    }

