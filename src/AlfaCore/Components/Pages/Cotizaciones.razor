        _detail.Lineas.Add(new CotizacionLineaDto { Tipo = CotizacionDetTipos.Informativo, Descripcion = "Nota", Cantidad = 1, ImpactaTotal = false, Orden = _detail.Lineas.Count });
    }

    private IReadOnlyList<AlfaActionMenuItem> MasAccionesItems =>
    [
        new() { Key = "libre", Label = "Línea libre", Icon = "bi bi-plus-square", OnClick = () => { AgregarLineaLibre(); return Task.CompletedTask; } },
        new() { Key = "informativa", Label = "Línea informativa", Icon = "bi bi-info-circle", OnClick = () => { AgregarLineaInformativa(); return Task.CompletedTask; } }
    ];

    private void EliminarLinea(CotizacionLineaDto linea)
    {
        _detail?.Lineas.Remove(linea);
        RecalcularTotales();
    }

    private void RecalcularTotales()
    {
        if (_detail is null)
            return;
        var subtotal = _detail.Lineas.Where(l => l.ImpactaTotal).Sum(l =>
        {
            l.Subtotal = decimal.Round(l.PrecioBase * (1m - l.PorcentajeDescuento / 100m) * l.Cantidad, 2);
            return l.Subtotal;
        });
        _detail.Subtotal = subtotal;
        _detail.TotalDescuento = decimal.Round(subtotal * _detail.DescuentoGeneralPorcentaje / 100m, 2);
        _detail.Total = _detail.Subtotal - _detail.TotalDescuento;
    }

    private List<CotizacionLineaDto> SinSeccion()
        => _detail is null ? [] : _detail.Lineas.Where(l => l.IdSeccion is null).OrderBy(l => l.Orden).ToList();

    private List<CotizacionLineaDto> LineasDeSeccion(long idSeccion)
        => _detail is null ? [] : _detail.Lineas.Where(l => l.IdSeccion == idSeccion).OrderBy(l => l.Orden).ToList();

    private Task<IReadOnlyList<CrmCotizacionArticuloDto>> BuscarArticulosLookupAsync(string texto, CancellationToken ct)
        => CotizSvc.SearchArticulosAsync(_detail?.CodigoCliente, texto, 25, ct);

    private void OnArticuloSeleccionadoAsync(CrmCotizacionArticuloDto? articulo)
        => AgregarArticulo(articulo);

    private void AgregarArticulo(CrmCotizacionArticuloDto? articulo)
    {
        if (articulo is null || _detail is null)
            return;
        _detail.Lineas.Add(new CotizacionLineaDto
        {
            Tipo = CotizacionDetTipos.Articulo,
            CodigoRef = articulo.IdArticulo,
            Descripcion = articulo.Descripcion,
            Cantidad = 1,
            PrecioBase = articulo.PrecioUnitarioNeto,
            PrecioUnitario = articulo.PrecioUnitarioNeto,
            TasaIva = articulo.TasaIva,
            ImpactaTotal = true,
            OrigenPrecio = string.IsNullOrWhiteSpace(_detail.CodigoCliente) ? CotizacionOrigenPrecio.ConsumidorFinal : CotizacionOrigenPrecio.Cliente,
            Orden = _detail.Lineas.Count
        });
        RecalcularTotales();
    }

    private Task<IReadOnlyList<CotizacionTareaDto>> BuscarTareasLookupAsync(string texto, CancellationToken ct)
        => CotizSvc.SearchTareasAsync(texto, 25, ct);

    private void OnTareaSeleccionadaAsync(CotizacionTareaDto? tarea)
        => AgregarTarea(tarea);

    private void AgregarTarea(CotizacionTareaDto? tarea)
    {
        if (tarea is null || _detail is null)
            return;
        var cantidad = tarea.HorasEstimadas is > 0 ? tarea.HorasEstimadas.Value : 1m;
        _detail.Lineas.Add(new CotizacionLineaDto
        {
            Tipo = CotizacionDetTipos.Tarea,
            CodigoRef = tarea.IdTarea,
            Descripcion = tarea.Descripcion,
            Cantidad = cantidad,
            PrecioBase = tarea.ValorHora,
            PrecioUnitario = tarea.ValorHora,
            TasaIva = tarea.TasaIva,
            ImpactaTotal = true,
            OrigenPrecio = CotizacionOrigenPrecio.Manual,
            Orden = _detail.Lineas.Count
        });
        RecalcularTotales();
    }

    // ---- Asistente de IA: sugerir artículos por texto ----

    private async Task OnIaKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SugerirLineasIaAsync();
    }

    private async Task SugerirLineasIaAsync()
    {
        if (string.IsNullOrWhiteSpace(_iaPrompt) || _detail is null)
            return;

        _iaCargando = true;
        var result = await UiOps.RunAsync(() => CotizSvc.SuggestLinesFromPromptAsync(_detail.CodigoCliente, _iaPrompt), "No se pudo generar sugerencias con el asistente de IA.");
        _iaCargando = false;

        if (result.Success && result.Value is not null)
        {
            _iaSugerencias = result.Value.ToList();
            _iaSeleccion = _iaSugerencias.Select(x => x.IdArticulo).ToHashSet();
            if (_iaSugerencias.Count == 0)
                SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Info, Title = "Sin resultados", Message = "El asistente no encontró artículos para ese pedido. Probá con otras palabras." });
        }
        else
        {
            SetFeedback(result.Feedback);
        }
    }

    private void ToggleIaSugerencia(string idArticulo, bool value)
    {
        if (value)
            _iaSeleccion.Add(idArticulo);
        else
            _iaSeleccion.Remove(idArticulo);
    }

    private void ToggleTodasIaSugerencias()
        => _iaSeleccion = _iaSeleccion.Count == _iaSugerencias.Count ? [] : _iaSugerencias.Select(x => x.IdArticulo).ToHashSet();

    private void AgregarSugerenciasIaSeleccionadas()
    {
        if (_detail is null)
            return;

        foreach (var sug in _iaSugerencias.Where(x => _iaSeleccion.Contains(x.IdArticulo)))
        {
            _detail.Lineas.Add(new CotizacionLineaDto
            {
                Tipo = CotizacionDetTipos.Articulo,
                CodigoRef = sug.IdArticulo,
                Descripcion = sug.Descripcion,
                Cantidad = sug.Cantidad > 0 ? sug.Cantidad : 1m,
                PrecioBase = sug.PrecioUnitarioNeto,
                PrecioUnitario = sug.PrecioUnitarioNeto,
                TasaIva = sug.TasaIva,
                ImpactaTotal = true,
                OrigenPrecio = string.IsNullOrWhiteSpace(_detail.CodigoCliente) ? CotizacionOrigenPrecio.ConsumidorFinal : CotizacionOrigenPrecio.Cliente,
                Orden = _detail.Lineas.Count
            });
        }

        _iaSugerencias.Clear();
        _iaSeleccion.Clear();
        _iaPrompt = string.Empty;
        RecalcularTotales();
    }

    // ---- Asistente de IA: redactar propuesta ----

    private async Task OnIaPropuestaKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await GenerarPropuestaIaAsync();
    }

    private async Task GenerarPropuestaIaAsync()
    {
        if (string.IsNullOrWhiteSpace(_iaPropuestaPrompt) || _detail is null)
            return;

        _iaPropuestaCargando = true;
        var result = await UiOps.RunAsync(() => CotizSvc.GenerateServiceProposalAsync(_iaPropuestaPrompt, _detail.EmpresaProspecto), "No se pudo generar la propuesta con el asistente de IA.");
        _iaPropuestaCargando = false;

        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }

        var html = result.Value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(html))
            return;

        // Se llama solo desde la pestaña Propuesta, ya montada -- _richEditorRef es válido acá.
        await EnsureRichEditorLoadedAsync();
        if (_richEditorJs is null)
            return;

        var actual = await _richEditorJs.InvokeAsync<string>("getHtml", _richEditorRef);
        var combinado = string.IsNullOrWhiteSpace(actual) ? html : actual + html;
        await _richEditorJs.InvokeVoidAsync("setHtml", _richEditorRef, combinado);
        _detail.CuerpoPropuesta = combinado;
        _iaPropuestaPrompt = string.Empty;
    }

    // ---- Configurador Alfa Gestión ----

    private async Task AbrirAlfaDialogAsync()
    {
        _showAlfaDialog = true;
        if (_alfaConfig.Modulos.Count == 0)
        {
            var configResult = await UiOps.RunAsync(() => CotizSvc.GetAlfaConfigAsync(), "No se pudo cargar la configuración de Alfa Gestión.");
            if (configResult.Success && configResult.Value is not null)
                _alfaConfig = configResult.Value;
        }
        await CalcularAlfaAsync();
    }

    private async Task ToggleAlfaModuloAsync(string codigo, bool value)
    {
        if (value)
            _alfaSelectedModulos.Add(codigo);
        else
            _alfaSelectedModulos.Remove(codigo);
        await CalcularAlfaAsync();
    }

    private async Task AjustarAlfaUsuariosAsync(int delta)
    {
        _alfaUsuarios = Math.Max(1, _alfaUsuarios + delta);
        await CalcularAlfaAsync();
    }

    private async Task CalcularAlfaAsync()
    {
        var result = await UiOps.RunAsync(() => CotizSvc.BuildAlfaLinesAsync(_detail?.CodigoCliente, new CotizacionAlfaSelectionRequest
        {
            ModulosCodigo = _alfaSelectedModulos.ToList(),
            CantidadUsuarios = _alfaUsuarios
        }), "No se pudo calcular la configuración de Alfa Gestión.");
        if (result.Success)
            _alfaResult = result.Value;
        else
            SetFeedback(result.Feedback);
    }

    private async Task AgregarResultadoAlfaAsync(string? idTareaElegido)
    {
        if (_detail is null)
            return;

        var result = await UiOps.RunAsync(() => CotizSvc.BuildAlfaLinesAsync(_detail.CodigoCliente, new CotizacionAlfaSelectionRequest
        {
            ModulosCodigo = _alfaSelectedModulos.ToList(),
            CantidadUsuarios = _alfaUsuarios,
            IdTareaPackElegido = idTareaElegido
        }), "No se pudo agregar la configuración de Alfa Gestión.");
        if (!result.Success || result.Value is null)
        {
            SetFeedback(result.Feedback);
            return;
        }

        foreach (var linea in result.Value.Lineas)
        {
            linea.Orden = _detail.Lineas.Count;
            _detail.Lineas.Add(linea);
        }

        _showAlfaDialog = false;
        _alfaResult = null;
        RecalcularTotales();
    }

    // ---- Presentación ----

    private void SetFeedback(AppUiMessage? message)
        => _feedback = message;

    private static string DisplayOrFallback(string? primary, string? fallback)
        => string.IsNullOrWhiteSpace(primary) ? (fallback ?? string.Empty) : primary;

    private static AlfaTagTone EstadoTono(string estado) => estado switch
    {
        CotizacionEstados.Borrador => AlfaTagTone.Neutral,
        CotizacionEstados.Enviada => AlfaTagTone.Accent,
        CotizacionEstados.Aceptada => AlfaTagTone.Success,
        CotizacionEstados.Rechazada => AlfaTagTone.Danger,
        CotizacionEstados.Vencida => AlfaTagTone.Warning,
        CotizacionEstados.Anulada => AlfaTagTone.Neutral,
        _ => AlfaTagTone.Neutral
    };

    private static string EstadoLabel(string estado) => estado switch
    {
        CotizacionEstados.Borrador => "Borrador",
        CotizacionEstados.Enviada => "Enviada",
        CotizacionEstados.Aceptada => "Aceptada",
        CotizacionEstados.Rechazada => "Rechazada",
        CotizacionEstados.Vencida => "Vencida",
        CotizacionEstados.Anulada => "Anulada",
        _ => estado
    };

    private static string GetAperturaTitle(CotizacionEmailEnvioDto envio)
    {
        var detalle = envio.CantidadLecturas > 1 && envio.UltimaFechaHoraLectura is { } ultima
            ? $" ({envio.CantidadLecturas} veces, última el {ultima:dd/MM/yyyy HH:mm})"
            : string.Empty;
        return $"Se detectó carga de imágenes del email{detalle}. No es garantía de lectura real -- " +
               "algunos clientes de correo (ej. Apple Mail) las precargan automáticamente sin que el destinatario haya abierto el mensaje.";
    }

    private static string OrigenPrecioLabel(string origen) => origen switch
    {
        CotizacionOrigenPrecio.Cliente => "Precio de lista del cliente",
        CotizacionOrigenPrecio.ConsumidorFinal => "Consumidor final",
        CotizacionOrigenPrecio.Lista => "Lista de precios",
        CotizacionOrigenPrecio.Maestro => "Precio de maestro",
        CotizacionOrigenPrecio.Manual => "Manual",
        _ => origen
    };

    private string StepClass(int index)
    {
        var order = _detail?.EstadoVersion switch
        {
            CotizacionEstados.Borrador => 0,
            CotizacionEstados.Enviada => 1,
            CotizacionEstados.Aceptada => 2,
            CotizacionEstados.Rechazada => 2,
            CotizacionEstados.Vencida => 1,
            CotizacionEstados.Anulada => -1,
            _ => 0
        };
        if (order < 0)
            return "is-pending";
        if (index < order)
            return "is-done";
        if (index == order)
            return _detail?.EstadoVersion == CotizacionEstados.Rechazada && index == 2 ? "is-rejected" : "is-current";
        return "is-pending";
    }

    private RenderFragment RenderLineasTable(List<CotizacionLineaDto> lineas, long? seccionId) => @<text>
        @if (lineas.Count == 0)
        {
            <div class="cotiz-seccion__empty">Sin líneas todavía.</div>
        }
        else
        {
            <table class="cotiz-lineas-table">
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th class="num">Cant.</th>
                        <th class="num">Precio</th>
                        @if (_permiteDescuentoLinea)
                        {
                            <th class="num">Dto. %</th>
                        }
                        <th class="num">Subtotal</th>
                        @if (_detail!.EsBorrador && _detail.Secciones.Count > 0)
                        {
                            <th>Sección</th>
                        }
                        @if (_detail!.EsBorrador)
                        {
                            <th class="cotiz-lineas-table__actions-col"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in lineas)
                    {
                        <tr class="@(linea.Tipo == CotizacionDetTipos.Informativo ? "cotiz-linea--info" : "")">
                            <td class="cotiz-linea__desc">
                                @if (_detail!.EsBorrador)
                                {
                                    <input class="cotiz-linea__desc-input" value="@linea.Descripcion" @onchange="args => linea.Descripcion = args.Value?.ToString() ?? string.Empty" />
                                }
                                else
                                {
                                    <span>@linea.Descripcion</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(linea.OrigenPrecio) && linea.ImpactaTotal)
                                {
                                    <span class="cotiz-linea__origen">@OrigenPrecioLabel(linea.OrigenPrecio)</span>
                                }
                            </td>
                            <td class="num">
                                @if (_detail!.EsBorrador && linea.ImpactaTotal)
                                {
                                    <input class="cotiz-linea__num-input num" type="number" step="0.01" value="@linea.Cantidad" @onchange="args => { linea.Cantidad = ParseDecimal(args.Value); RecalcularTotales(); }" />
                                }
                                else if (linea.ImpactaTotal)
                                {
                                    @linea.Cantidad.ToString("0.##")
                                }
                            </td>
                            <td class="num">
                                @if (_detail!.EsBorrador && linea.ImpactaTotal)
                                {
                                    <input class="cotiz-linea__num-input num" type="number" step="0.01" value="@linea.PrecioBase" @onchange="args => { linea.PrecioBase = ParseDecimal(args.Value); RecalcularTotales(); }" />
                                }
                                else if (linea.ImpactaTotal)
                                {
                                    @linea.PrecioBase.ToString("N2")
                                }
                            </td>
                            @if (_permiteDescuentoLinea)
                            {
                                <td class="num">
                                    @if (_detail!.EsBorrador && linea.ImpactaTotal)
                                    {
                                        <input class="cotiz-linea__num-input num" type="number" step="0.01" value="@linea.PorcentajeDescuento" @onchange="args => { linea.PorcentajeDescuento = ParseDecimal(args.Value); RecalcularTotales(); }" />
                                    }
                                    else if (linea.ImpactaTotal)
                                    {
                                        @linea.PorcentajeDescuento.ToString("0.##")
                                    }
                                </td>
                            }
                            <td class="num cotiz-linea__subtotal">@(linea.ImpactaTotal ? linea.Subtotal.ToString("N2") : "")</td>
                            @if (_detail!.EsBorrador && _detail.Secciones.Count > 0)
                            {
                                <td>
                                    <select class="cotiz-linea__seccion-select" value="@(linea.IdSeccion?.ToString() ?? "")" @onchange="args => linea.IdSeccion = string.IsNullOrEmpty(args.Value?.ToString()) ? null : long.Parse(args.Value!.ToString()!)">
                                        <option value="">General</option>
                                        @foreach (var s in _detail.Secciones.OrderBy(s => s.Orden))
                                        {
                                            <option value="@s.IdSeccion">@s.Titulo</option>
                                        }
                                    </select>
                                </td>
                            }
                            @if (_detail!.EsBorrador)
                            {
                                <td><AlfaIconButton Icon="bi bi-trash" Label="Eliminar línea" Size="AlfaSize.Sm" OnClick="_ => EliminarLinea(linea)" /></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </text>;

    private static decimal ParseDecimal(object? value)
        => decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;
}
