@page "/cotizaciones"
@page "/{idweb}/{idbase:int}/cotizaciones"
@using AlfaCore.Models
@inject AlfaCore.Services.ICotizacionesService CotizSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IAppUserSessionService AppUserSession
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Cotizaciones | Alfa Gestión</PageTitle>

<style>
    .cotiz-editor { display: flex; flex-direction: column; gap: 1rem; padding: 1rem 1.25rem 3rem; max-width: 1100px; margin: 0 auto; }
    .cotiz-datos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .75rem; }
    .cotiz-seccion { border: 1px solid var(--alfa-border-default); border-radius: var(--alfa-radius-md); background: var(--alfa-bg-surface); overflow: hidden; }
    .cotiz-seccion__header { display: flex; align-items: center; gap: .5rem; padding: .6rem .8rem; background: var(--alfa-bg-surface-raised); }
    .cotiz-seccion__header input { flex: 1 1 auto; background: transparent; border: 0; color: var(--alfa-text-primary); font-weight: 600; font-size: .92rem; }
    .cotiz-lineas-table { width: 100%; border-collapse: collapse; font-size: .84rem; }
    .cotiz-lineas-table th, .cotiz-lineas-table td { padding: .4rem .55rem; border-bottom: 1px solid var(--alfa-border-default); text-align: left; }
    .cotiz-lineas-table td.num, .cotiz-lineas-table th.num { text-align: right; }
    .cotiz-lineas-table input { width: 100%; background: var(--alfa-bg-input); border: 1px solid var(--alfa-border-default); border-radius: 4px; padding: .2rem .35rem; color: var(--alfa-text-primary); }
    .cotiz-lineas-table input.num { text-align: right; }
    .cotiz-add-bar { display: flex; flex-wrap: wrap; gap: .5rem; padding: .6rem .8rem; }
    .cotiz-totales { align-self: flex-end; display: grid; gap: .25rem; text-align: right; min-width: 260px; }
    .cotiz-totales__final { font-size: 1.1rem; font-weight: 700; }
    .cotiz-alfa-panel { border: 1px solid var(--alfa-border-default); border-radius: var(--alfa-radius-md); background: var(--alfa-bg-surface); padding: .9rem 1rem; display: flex; flex-direction: column; gap: .6rem; }
    .cotiz-alfa-modulos { display: flex; flex-wrap: wrap; gap: .5rem .9rem; }
    .cotiz-search-results { max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: .3rem; }
    .cotiz-search-result { display: flex; justify-content: space-between; gap: .6rem; padding: .4rem .55rem; border: 1px solid var(--alfa-border-default); border-radius: 6px; cursor: pointer; }
    .cotiz-search-result:hover { border-color: var(--alfa-accent); }
</style>

<div class="page-grid cotizaciones-page" @onclick="HandlePageClickAsync">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    @if (!_showEditor)
    {
        <section class="cuentas-page--list" style="height:100%;min-height:0;display:flex;flex-direction:column;overflow:hidden;">
            <section class="cuentas-list-shell">
                @if (_loadingList)
                {
                    <div class="cuentas-list-shell__state">
                        <AlfaEmptyState Title="Cargando cotizaciones" Message="Estamos consultando la base activa." />
                    </div>
                }
                else if (_items.Count == 0)
                {
                    <div class="cuentas-list-shell__state">
                        <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="No hay cotizaciones"
                                        Message="No encontramos cotizaciones para los filtros seleccionados."
                                        ActionLabel="Nueva cotización" ActionIcon="bi bi-plus-circle" OnAction="_ => AbrirNuevaAsync()" />
                    </div>
                }
                else
                {
                    <div class="cuentas-list-shell__table-scroll">
                        <table class="cuentas-list-table">
                            <thead>
                                <tr>
                                    <th>Número</th>
                                    <th>Cliente / Prospecto</th>
                                    <th>Contacto</th>
                                    <th>Moneda</th>
                                    <th class="num">Total</th>
                                    <th>Estado</th>
                                    <th>Vencimiento</th>
                                    <th>Origen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _items)
                                {
                                    <tr @ondblclick="() => AbrirAsync(item.IdVersion)" style="cursor:pointer;">
                                        <td>@item.CodigoVisible <span style="opacity:.6;">v@(item.NumeroVersion)</span></td>
                                        <td>@DisplayOrFallback(item.EmpresaProspecto, item.CodigoCliente)</td>
                                        <td>@item.ContactoNombre</td>
                                        <td>@item.CodigoMoneda</td>
                                        <td class="num">@item.Total.ToString("N2")</td>
                                        <td><span class="@GetEstadoBadgeClass(item.Estado)">@item.Estado@(item.Vencida ? " (vencida)" : "")</span></td>
                                        <td>@(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>@(item.OrigenCrm ? "CRM" : "Manual")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </section>
    }
    else
    {
        <div class="cotiz-editor">
            @if (_detail is not null)
            {
                @if (!_detail.EsBorrador)
                {
                    <div class="editor-msg" style="background:rgba(234,179,8,.12);border:1px solid rgba(234,179,8,.35);padding:.6rem .8rem;border-radius:8px;">
                        Esta versión está en estado <strong>@_detail.EstadoVersion</strong> y quedó de solo lectura. Creá una nueva versión para modificarla.
                    </div>
                }

                <section class="panel-card">
                    <h3 class="panel-card__title" style="margin:0 0 .6rem;">Datos comerciales</h3>
                    <div class="cotiz-datos-grid">
                        <div class="field">
                            <label>Código de cliente (opcional)</label>
                            <input class="field-input" value="@_detail.CodigoCliente" disabled="@(!_detail.EsBorrador)"
                                   @onchange="args => _detail.CodigoCliente = args.Value?.ToString()" />
                        </div>
                        <div class="field">
                            <label>Empresa / Prospecto</label>
                            <input class="field-input" @bind="_detail.EmpresaProspecto" disabled="@(!_detail.EsBorrador)" />
                        </div>
                        <div class="field">
                            <label>Contacto</label>
                            <input class="field-input" @bind="_detail.ContactoNombre" disabled="@(!_detail.EsBorrador)" />
                        </div>
                        <div class="field">
                            <label>Email</label>
                            <input class="field-input" @bind="_detail.ContactoEmail" disabled="@(!_detail.EsBorrador)" />
                        </div>
                        <div class="field">
                            <label>Teléfono</label>
                            <input class="field-input" @bind="_detail.ContactoTelefono" disabled="@(!_detail.EsBorrador)" />
                        </div>
                        <div class="field">
                            <label>CUIT / Documento</label>
                            <input class="field-input" @bind="_detail.DocumentoFiscal" disabled="@(!_detail.EsBorrador)" />
                        </div>
                        <div class="field">
                            <label>Moneda</label>
                            <input class="field-input" @bind="_detail.CodigoMoneda" placeholder="Ej: $" disabled="@(!_detail.EsBorrador)" />
                        </div>
                        <div class="field">
                            <label>Vencimiento</label>
                            <input type="date" class="field-input" value="@_detail.FechaVencimiento?.ToString("yyyy-MM-dd")" disabled="@(!_detail.EsBorrador)"
                                   @onchange="args => _detail.FechaVencimiento = DateTime.TryParse(args.Value?.ToString(), out var d) ? d : null" />
                        </div>
                    </div>
                </section>

                <section class="panel-card">
                    <div class="panel-card__header">
                        <h3 class="panel-card__title" style="margin:0;">Asistente de propuesta</h3>
                    </div>
                    <div id="cotiz-rich-editor" @ref="_richEditorRef" contenteditable="@(_detail.EsBorrador ? "true" : "false")"
                         style="min-height:140px;border:1px solid var(--alfa-border-default);border-radius:8px;padding:.6rem .8rem;background:var(--alfa-bg-input);">
                    </div>
                </section>

                @if (_detail.EsBorrador)
                {
                    <div class="cotiz-add-bar" style="padding:0;">
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-folder-plus" OnClick="_ => AgregarSeccion()">Agregar sección</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-box-seam" OnClick="_ => AbrirBuscarArticuloAsync()">Agregar artículo</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-tools" OnClick="_ => AbrirBuscarTareaAsync()">Agregar servicio</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-plus-square" OnClick="_ => AgregarLineaLibre()">Agregar libre</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-info-circle" OnClick="_ => AgregarLineaInformativa()">Agregar informativa</AlfaButton>
                        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-stars" OnClick="_ => _showAlfaPanel = !_showAlfaPanel">Configurar Alfa Gestión</AlfaButton>
                    </div>
                }

                @if (_showAlfaPanel)
                {
                    <div class="cotiz-alfa-panel">
                        <strong>Configurador Alfa Gestión</strong>
                        @if (_alfaConfig.Modulos.Count == 0)
                        {
                            <span class="smart-search__hint">No hay módulos configurados todavía. Cargalos en la pestaña Configuración.</span>
                        }
                        else
                        {
                            <div class="cotiz-alfa-modulos">
                                @foreach (var modulo in _alfaConfig.Modulos)
                                {
                                    <AlfaCheckbox Value="@_alfaSelectedModulos.Contains(modulo.Codigo)"
                                                  ValueChanged="v => ToggleAlfaModulo(modulo.Codigo, v)">
                                        @modulo.Nombre
                                    </AlfaCheckbox>
                                }
                            </div>
                            <div class="field" style="max-width:220px;">
                                <label>Cantidad de usuarios</label>
                                <input type="number" min="1" class="field-input" @bind="_alfaUsuarios" />
                            </div>
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-calculator" OnClick="_ => CalcularAlfaAsync()">Calcular</AlfaButton>
                            @if (_alfaResult is not null)
                            {
                                @if (_alfaResult.PackRecomendado is not null)
                                {
                                    <div class="smart-search__hint">Por la configuración seleccionada recomendamos: <strong>@_alfaResult.PackRecomendadoDescripcion</strong>.</div>
                                    <div class="cotiz-add-bar" style="padding:0;">
                                        <AlfaButton Variant="AlfaButtonVariant.Primary" OnClick="_ => AgregarResultadoAlfaAsync(_alfaResult.PackRecomendado.IdTarea)">Agregar pack recomendado</AlfaButton>
                                        <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="_ => AgregarResultadoAlfaAsync(null)">No agregar implementación</AlfaButton>
                                    </div>
                                }
                                else
                                {
                                    <AlfaButton Variant="AlfaButtonVariant.Primary" OnClick="_ => AgregarResultadoAlfaAsync(null)">Agregar a la cotización</AlfaButton>
                                }
                            }
                        }
                    </div>
                }

                @if (SinSeccion().Count > 0)
                {
                    <div class="cotiz-seccion">
                        <div class="cotiz-seccion__header"><strong>General</strong></div>
                        @RenderLineasTable(SinSeccion(), null)
                    </div>
                }

                @foreach (var seccion in _detail.Secciones.OrderBy(s => s.Orden).ToList())
                {
                    <div class="cotiz-seccion">
                        <div class="cotiz-seccion__header">
                            <i class="bi bi-folder2"></i>
                            <input value="@seccion.Titulo" disabled="@(!_detail.EsBorrador)" @onchange="args => seccion.Titulo = args.Value?.ToString() ?? string.Empty" />
                            @if (_detail.EsBorrador)
                            {
                                <AlfaIconButton Icon="bi bi-arrow-up" Label="Subir" Size="AlfaSize.Sm" OnClick="_ => MoverSeccion(seccion, -1)" />
                                <AlfaIconButton Icon="bi bi-arrow-down" Label="Bajar" Size="AlfaSize.Sm" OnClick="_ => MoverSeccion(seccion, 1)" />
                                <AlfaIconButton Icon="bi bi-trash" Label="Eliminar sección" Size="AlfaSize.Sm" OnClick="_ => EliminarSeccion(seccion)" />
                            }
                        </div>
                        @RenderLineasTable(_detail.Lineas.Where(l => l.IdSeccion == seccion.IdSeccion).OrderBy(l => l.Orden).ToList(), seccion.IdSeccion)
                    </div>
                }

                <section class="panel-card">
                    <div class="field" style="max-width:260px;">
                        <label>Observaciones</label>
                        <textarea class="field-input" rows="2" @bind="_detail.Observaciones" disabled="@(!_detail.EsBorrador)"></textarea>
                    </div>
                    <div class="cotiz-totales">
                        <div class="field" style="max-width:180px;justify-self:flex-end;">
                            <label>Descuento general (%)</label>
                            <input type="number" min="0" max="100" step="0.01" class="field-input" value="@_detail.DescuentoGeneralPorcentaje" disabled="@(!_detail.EsBorrador)" @onchange="args => { _detail.DescuentoGeneralPorcentaje = ParseDecimal(args.Value); RecalcularTotales(); }" />
                        </div>
                        <div>Subtotal: @_detail.Subtotal.ToString("N2")</div>
                        <div>Descuento: -@_detail.TotalDescuento.ToString("N2")</div>
                        <div class="cotiz-totales__final">Total: @_detail.Total.ToString("N2") @_detail.CodigoMoneda</div>
                    </div>
                </section>
            }
        </div>
    }

    <AlfaDialog Open="@_showBuscarArticulo" Title="Agregar artículo" Size="AlfaDialogSize.Md" OnClose="_ => _showBuscarArticulo = false">
        <ChildContent>
            <input class="field-input" placeholder="Buscar artículo..." @oninput="OnBuscarArticuloInput" style="margin-bottom:.6rem;" />
            <div class="cotiz-search-results">
                @foreach (var art in _articulosEncontrados)
                {
                    <div class="cotiz-search-result" @onclick="() => AgregarArticulo(art)">
                        <span>@art.Descripcion</span>
                        <span>@art.PrecioUnitarioConIva.ToString("N2")</span>
                    </div>
                }
            </div>
        </ChildContent>
    </AlfaDialog>

    <AlfaDialog Open="@_showBuscarTarea" Title="Agregar servicio" Size="AlfaDialogSize.Md" OnClose="_ => _showBuscarTarea = false">
        <ChildContent>
            <input class="field-input" placeholder="Buscar servicio..." @oninput="OnBuscarTareaInput" style="margin-bottom:.6rem;" />
            <div class="cotiz-search-results">
                @foreach (var tarea in _tareasEncontradas)
                {
                    <div class="cotiz-search-result" @onclick="() => AgregarTarea(tarea)">
                        <span>@tarea.Descripcion</span>
                        <span>@tarea.ValorHora.ToString("N2")</span>
                    </div>
                }
            </div>
        </ChildContent>
    </AlfaDialog>
</div>

@code {
    [SupplyParameterFromQuery(Name = "oportunidad")] public long? OportunidadQuery { get; set; }
    [SupplyParameterFromQuery(Name = "empresa")] public string? EmpresaQuery { get; set; }
    [SupplyParameterFromQuery(Name = "contacto")] public string? ContactoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? EmailQuery { get; set; }
    [SupplyParameterFromQuery(Name = "telefono")] public string? TelefonoQuery { get; set; }

    private List<CotizacionListItemDto> _items = [];
    private bool _loadingList = true;
    private CotizacionListFiltersDto _filters = new();
    private int _totalRegistros;

    private bool _showEditor;
    private CotizacionVersionDetailDto? _detail;
    private AppUiMessage? _feedback;

    private ElementReference _richEditorRef;
    private IJSObjectReference? _richEditorJs;

    private bool _showAlfaPanel;
    private CotizacionAlfaConfigDto _alfaConfig = new();
    private readonly HashSet<string> _alfaSelectedModulos = new(StringComparer.OrdinalIgnoreCase);
    private int _alfaUsuarios = 1;
    private CotizacionAlfaResultDto? _alfaResult;

    private bool _showBuscarArticulo;
    private List<CrmCotizacionArticuloDto> _articulosEncontrados = [];
    private bool _showBuscarTarea;
    private List<CotizacionTareaDto> _tareasEncontradas = [];

    private long _seccionTempCounter = -1;

    protected override void OnInitialized() => UpdatePageHeader();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose() => PageHeader.Clear();

    protected override async Task OnInitializedAsync()
    {
        if (OportunidadQuery is > 0)
        {
            var idVersion = await CotizSvc.CreateAsync(new CotizacionCreateRequest
            {
                IdOportunidad = OportunidadQuery,
                EmpresaProspecto = EmpresaQuery,
                ContactoNombre = ContactoQuery,
                ContactoEmail = EmailQuery,
                ContactoTelefono = TelefonoQuery,
                UsuarioAccion = CurrentUserName
            });
            await AbrirAsync(idVersion);
        }
        else
        {
            await BuscarAsync();
        }
    }

    private string CurrentUserName => AppUserSession.CurrentUser?.UserName ?? Environment.UserName;

    private Task HandlePageClickAsync() => Task.CompletedTask;

    private void UpdatePageHeader()
    {
        var actions = new List<PageHeaderAction>();
        if (!_showEditor)
        {
            actions.Add(new PageHeaderAction { Key = "nueva", Label = "Nueva cotización", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = AbrirNuevaAsync });
            actions.Add(new PageHeaderAction { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Disabled = _loadingList, OnClick = BuscarAsync });
        }
        else if (_detail is not null)
        {
            if (_detail.EsBorrador)
            {
                actions.Add(new PageHeaderAction { Key = "guardar", Label = "Guardar borrador", Icon = "bi-floppy", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = GuardarBorradorAsync });
                actions.Add(new PageHeaderAction { Key = "enviar", Label = "Marcar enviada", Icon = "bi-send", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = MarcarEnviadaAsync });
            }
            else
            {
                if (string.Equals(_detail.EstadoVersion, CotizacionEstados.Enviada, StringComparison.OrdinalIgnoreCase))
                {
                    actions.Add(new PageHeaderAction { Key = "aceptar", Label = "Marcar aceptada", Icon = "bi-check-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, OnClick = MarcarAceptadaAsync });
                    actions.Add(new PageHeaderAction { Key = "rechazar", Label = "Marcar rechazada", Icon = "bi-x-circle", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow, OnClick = MarcarRechazadaAsync });
                }
                actions.Add(new PageHeaderAction { Key = "nueva-version", Label = "Nueva versión", Icon = "bi-file-earmark-plus", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = NuevaVersionAsync });
            }
            actions.Add(new PageHeaderAction { Key = "anular", Label = "Anular", Icon = "bi-slash-circle", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Overflow, OnClick = AnularAsync });
            actions.Add(new PageHeaderAction { Key = "volver", Label = "Volver al listado", Icon = "bi-arrow-left", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, OnClick = () => { CerrarEditor(); return Task.CompletedTask; } });
        }

        PageHeader.Set(new PageHeaderConfig
        {
            Title = !_showEditor ? "Cotizaciones" : _detail is null ? "Cotización" : $"{_detail.CodigoVisible} · v{_detail.NumeroVersion}",
            Breadcrumb = ["Cotizaciones"],
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            TopNavigationItems = AlfaCore.Services.ModuleTopNavPresets.BuildCotizaciones(RouteContext, Nav, "cotizaciones"),
            Actions = actions
        });
    }

    private async Task BuscarAsync()
    {
        _loadingList = true;
        UpdatePageHeader();
        var result = await UiOps.RunAsync(() => CotizSvc.GetListAsync(_filters), "No se pudieron cargar las cotizaciones.");
        if (result.Success && result.Value is not null)
        {
            _items = result.Value.Items.ToList();
            _totalRegistros = result.Value.Total;
        }
        else
        {
            SetFeedback(result.Feedback);
        }
        _loadingList = false;
        UpdatePageHeader();
    }

    private async Task AbrirNuevaAsync()
    {
        var result = await UiOps.RunAsync(() => CotizSvc.CreateAsync(new CotizacionCreateRequest { UsuarioAccion = CurrentUserName }), "No se pudo crear la cotización.");
        if (result.Success)
            await AbrirAsync(result.Value);
        else
            SetFeedback(result.Feedback);
    }

    private async Task AbrirAsync(long idVersion)
    {
        var result = await UiOps.RunAsync(() => CotizSvc.GetVersionDetailAsync(idVersion), "No se pudo cargar la cotización.");
        if (!result.Success || result.Value is null)
        {
            SetFeedback(result.Feedback);
            return;
        }

        _detail = result.Value;
        _showEditor = true;
        _showAlfaPanel = false;
        _alfaResult = null;
        _alfaSelectedModulos.Clear();
        var permiteResult = await UiOps.RunAsync(() => CotizSvc.PermiteDescuentoPorLineaAsync(), "No se pudo leer la configuración de descuento por línea.");
        _permiteDescuentoLinea = permiteResult.Success && permiteResult.Value;
        UpdatePageHeader();
        await SyncRichEditorAsync();
    }

    private void CerrarEditor()
    {
        _showEditor = false;
        _detail = null;
        UpdatePageHeader();
        _ = BuscarAsync();
    }

    private async Task EnsureRichEditorLoadedAsync()
        => _richEditorJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/tickets-rich-editor.js?v=20260519a");

    private async Task SyncRichEditorAsync()
    {
        await EnsureRichEditorLoadedAsync();
        if (_richEditorJs is not null && _detail is not null)
            await _richEditorJs.InvokeVoidAsync("setHtml", _richEditorRef, _detail.CuerpoPropuesta ?? string.Empty);
    }

    private async Task<string> GetRichEditorHtmlAsync()
    {
        if (_richEditorJs is null)
            return _detail?.CuerpoPropuesta ?? string.Empty;
        return await _richEditorJs.InvokeAsync<string>("getHtml", _richEditorRef);
    }

    private async Task GuardarBorradorAsync()
    {
        if (_detail is null)
            return;

        var cuerpo = await GetRichEditorHtmlAsync();
        var request = new CotizacionSaveVersionRequest
        {
            IdVersion = _detail.IdVersion,
            EmpresaProspecto = _detail.EmpresaProspecto,
            ContactoNombre = _detail.ContactoNombre,
            ContactoEmail = _detail.ContactoEmail,
            ContactoTelefono = _detail.ContactoTelefono,
            DocumentoFiscal = _detail.DocumentoFiscal,
            CodigoMoneda = _detail.CodigoMoneda,
            FechaVencimiento = _detail.FechaVencimiento,
            Observaciones = _detail.Observaciones,
            CuerpoPropuesta = cuerpo,
            DescuentoGeneralPorcentaje = _detail.DescuentoGeneralPorcentaje,
            Secciones = _detail.Secciones,
            Lineas = _detail.Lineas,
            UsuarioAccion = CurrentUserName
        };

        var result = await UiOps.RunAsync(() => CotizSvc.SaveVersionAsync(request), "No se pudo guardar la cotización.");
        if (result.Success)
        {
            SetFeedback(new AppUiMessage { Severity = AppUiFeedbackSeverity.Success, Title = "Cotización guardada", Message = "El borrador se guardó correctamente." });
            await AbrirAsync(_detail.IdVersion);
        }
        else
        {
            SetFeedback(result.Feedback);
        }
    }

    private async Task NuevaVersionAsync()
    {
        if (_detail is null)
            return;
        var result = await UiOps.RunAsync(() => CotizSvc.CreateNewVersionAsync(_detail.IdCotizacion, CurrentUserName), "No se pudo crear una nueva versión.");
        if (result.Success)
            await AbrirAsync(result.Value);
        else
            SetFeedback(result.Feedback);
    }

    private async Task MarcarEnviadaAsync()
    {
        if (_detail is null)
            return;
        var result = await UiOps.RunAsync(async () => { await CotizSvc.MarkEnviadaAsync(_detail.IdVersion, CurrentUserName); return true; }, "No se pudo marcar la cotización como enviada.");
        if (result.Success)
            await AbrirAsync(_detail.IdVersion);
        else
