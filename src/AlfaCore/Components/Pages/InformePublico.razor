@page "/{idweb}/informe/{PublicToken}"
@layout AlfaCore.Components.Layout.PublicLayout
@inherits SaaSRoutePageBase
@using AlfaCore.Models
@inject AlfaCore.Services.ICentralPublicLinkService PublicLinkSvc
@inject AlfaCore.Services.ICentralBasesService CentralBasesSvc
@inject AlfaCore.Services.ISessionService SessionSvc
@inject AlfaCore.Services.ITicketInformesService InformesSvc
@inject ILogger<InformePublico> Logger

<PageTitle>@(_informe?.Titulo ?? "Informe") | Alfa Gestión</PageTitle>

@* Informe al cliente de un ticket de soporte (TICK_INFORMES) por link público. El HTML viene limpio del servicio. *@
<div class="ip">
    @if (_loading)
    {
        <p class="ip-estado">Cargando el informe…</p>
    }
    else if (_informe is null)
    {
        <div class="ip-estado">
            <h1>Informe no disponible</h1>
            <p>@(_error ?? "Este enlace no es válido o el informe ya no está publicado.")</p>
        </div>
    }
    else
    {
        <article class="ip-hoja">
            <header class="ip-cabecera">
                <span class="ip-marca">Alfa Gestión · Soporte</span>
                <h1>@_informe.Titulo</h1>
                <dl class="ip-datos">
                    @if (!string.IsNullOrWhiteSpace(_informe.Cliente)) { <div><dt>Cliente</dt><dd>@_informe.Cliente</dd></div> }
                    <div><dt>Ticket</dt><dd>#@_informe.NumeroTicket · @_informe.TituloTicket</dd></div>
                    <div><dt>Fecha</dt><dd>@((_informe.FechaHoraModificacion ?? _informe.FechaHoraPublicacion)?.ToString("dd/MM/yyyy"))</dd></div>
                </dl>
            </header>
            <div class="ip-cuerpo">@((MarkupString)_informe.Html)</div>
            <footer class="ip-pie">Alfa Gestión · Soporte. Ante cualquier duda sobre este informe, respondanos por el canal habitual.</footer>
        </article>
    }
</div>

<style>
    .ip { min-height: 100vh; background: #eef1f5; color: #1d2430; font: 15px/1.6 "Segoe UI", system-ui, -apple-system, sans-serif;
          padding: 32px max(16px, env(safe-area-inset-left, 0px)) 48px max(16px, env(safe-area-inset-right, 0px)); box-sizing: border-box; }
    .ip-estado { max-width: 560px; margin: 15vh auto 0; text-align: center; color: #5b6574; }
    .ip-estado h1 { color: #1d2430; font-size: 1.4rem; margin: 0 0 .4rem; }
    .ip-hoja { max-width: 820px; margin: 0 auto; background: #fff; border: 1px solid #dfe3ea; border-radius: 12px; box-shadow: 0 8px 30px rgba(20, 35, 60, .06); overflow: hidden; }
    .ip-cabecera { padding: 28px 32px 20px; border-bottom: 1px solid #dfe3ea; display: grid; gap: 8px; }
    .ip-marca { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #1f5fa8; font-weight: 600; }
    .ip-cabecera h1 { margin: 0; font-size: 1.6rem; line-height: 1.25; text-wrap: balance; }
    .ip-datos { display: flex; flex-wrap: wrap; gap: 6px 28px; margin: 4px 0 0; }
    .ip-datos div { display: grid; }
    .ip-datos dt { font-size: 12px; color: #5b6574; }
    .ip-datos dd { margin: 0; font-weight: 500; }
    .ip-cuerpo { padding: 24px 32px 8px; display: grid; gap: 12px; }
    .ip-cuerpo > * { margin: 0; max-width: 72ch; }
    .ip-cuerpo h1, .ip-cuerpo h2 { font-size: 1.2rem; margin-top: 10px; }
    .ip-cuerpo h3 { font-size: 1.05rem; margin-top: 6px; }
    .ip-cuerpo ul, .ip-cuerpo ol { padding-left: 22px; display: grid; gap: 4px; }
    .ip-cuerpo table { max-width: 100%; border-collapse: collapse; font-size: 14px; display: block; overflow-x: auto; }
    .ip-cuerpo th, .ip-cuerpo td { border-bottom: 1px solid #dfe3ea; padding: 8px 10px; text-align: left; vertical-align: top; }
    .ip-cuerpo th { color: #5b6574; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .ip-cuerpo td.num, .ip-cuerpo th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .ip-cuerpo blockquote { border-left: 3px solid #1f5fa8; padding: 4px 14px; color: #3b4555; }
    .ip-cuerpo hr { border: 0; border-top: 1px solid #dfe3ea; width: 100%; max-width: none; }
    .ip-cuerpo .ticket-editor-banner { display: flex; gap: 10px; padding: 12px 14px; border-radius: 8px; background: #e8f0fb; max-width: none; }
    .ip-cuerpo .ticket-editor-banner--success { background: #e7f4ec; }
    .ip-cuerpo .ticket-editor-banner--warning { background: #fdf1dd; }
    .ip-cuerpo .ticket-editor-banner--danger { background: #fbe7e7; }
    .ip-pie { padding: 16px 32px 24px; color: #5b6574; font-size: 13px; border-top: 1px solid #dfe3ea; margin-top: 16px; }
    @@media (max-width: 600px) {
        .ip { padding-top: 12px; }
        .ip-cabecera, .ip-cuerpo, .ip-pie { padding-left: 18px; padding-right: 18px; }
        .ip-cabecera h1 { font-size: 1.3rem; }
    }
</style>

@code {
    [Parameter] public string PublicToken { get; set; } = string.Empty;

    private TicketInformePublicoDto? _informe;
    private string? _error;
    private bool _loading = true;
    private bool _vistaRegistrada;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _informe = null;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(idweb) || string.IsNullOrWhiteSpace(PublicToken)) return;
            var link = await PublicLinkSvc.ResolveAsync(idweb, PublicLinkTipos.Informe, PublicToken);
            if (link is null) return;
            var routeBase = await CentralBasesSvc.GetByIdAsync(link.IdBase);
            if (routeBase is null) return;
            SessionSvc.SetWebhookOverride(new SessionDto
            {
                Id = SessionDto.BuildGuidFromBaseId(routeBase.IdBase),
                BaseId = routeBase.IdBase,
                Nombre = routeBase.Nombre,
                Servidor = routeBase.DbServer,
                BaseDatos = routeBase.DbName,
                Usuario = routeBase.DbUser,
                Password = routeBase.DbPassword,
                TrustServerCertificate = true,
                Activa = true
            });
            _informe = await InformesSvc.ObtenerPublicoAsync(link.IdReferencia);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo abrir el informe público de {IdWeb}.", idweb);
            _error = "No se pudo cargar el informe. Probá de nuevo en unos minutos.";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>La apertura se anota una sola vez, ya con el navegador conectado (no en el pre-renderizado).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_vistaRegistrada || _informe is null) return;
        _vistaRegistrada = true;
        try { await InformesSvc.RegistrarVistaAsync(_informe.IdInforme, null); }
        catch (Exception ex) { Logger.LogWarning(ex, "No se pudo registrar la apertura del informe {IdInforme}.", _informe.IdInforme); }
    }
}
