@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

<div class="@WrapperClass">
    @if (!string.IsNullOrWhiteSpace(IconClass))
    {
        <span class="@IconWrapperClass" aria-hidden="true">
            <i class="@IconClass"></i>
        </span>
    }

    <input @ref="_inputRef"
           id="@Id"
           class="@InputClass"
           type="@EffectiveInputType"
           @oninput="HandleInputAsync"
           @onkeydown="HandleKeyDownAsync"
           placeholder="@Placeholder"
           disabled="@Disabled"
           autocomplete="@Autocomplete"
           inputmode="@InputMode"
           @attributes="AdditionalAttributes" />

    @if (ShowPasswordToggle)
    {
        <button type="button"
                class="@PasswordToggleClass"
                title="@PasswordToggleTitle"
                aria-label="@PasswordToggleTitle"
                @onclick="TogglePasswordAsync"
                disabled="@Disabled">
            <i class="@PasswordToggleIconClass"></i>
        </button>
    }
</div>

@code {
    private ElementReference _inputRef;

    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string InputClass { get; set; } = "auth-input-shell__input";
    [Parameter] public string WrapperClass { get; set; } = "auth-input-shell";
    [Parameter] public string IconWrapperClass { get; set; } = "auth-input-shell__icon";
    [Parameter] public string? IconClass { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Autocomplete { get; set; } = string.Empty;
    [Parameter] public string InputMode { get; set; } = string.Empty;
    [Parameter] public string InputType { get; set; } = "text";
    [Parameter] public bool ShowPasswordToggle { get; set; }
    [Parameter] public bool ShowPassword { get; set; }
    [Parameter] public EventCallback<bool> ShowPasswordChanged { get; set; }
    [Parameter] public string PasswordToggleClass { get; set; } = "auth-password__toggle";
    [Parameter] public string PasswordToggleIconClass { get; set; } = "bi bi-eye";
    [Parameter] public string PasswordToggleTitle { get; set; } = "Mostrar contraseÃ±a";
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string EffectiveInputType => ShowPasswordToggle ? (ShowPassword ? "text" : "password") : InputType;

    // El <input> no lleva value="@Value" en el markup a propósito: si Blazor reaplica el value en
    // cada render disparado por @oninput, escribir rápido hace que el round-trip al servidor pise
    // letras que el usuario ya tecleó (el DOM y el estado del servidor quedan compitiendo por el
    // valor). El campo queda "no controlado" mientras se escribe; solo empujamos Value hacia el DOM
    // por JS cuando cambia por fuera de este componente (ver OnParametersSet).
    private string? _lastEmittedValue;
    private bool _pendingDomSync;

    protected override void OnParametersSet()
    {
        if (!string.Equals(Value, _lastEmittedValue, StringComparison.Ordinal))
            _pendingDomSync = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingDomSync)
            return;

        _pendingDomSync = false;
        _lastEmittedValue = Value;

        try
        {
            await JS.InvokeVoidAsync("alfaCoreFormInput.setValue", _inputRef, Value);
        }
        catch
        {
        }
    }

    public ValueTask FocusAsync(bool preventScroll = false) => _inputRef.FocusAsync(preventScroll);

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        _lastEmittedValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (OnKeyDown.HasDelegate)
            await OnKeyDown.InvokeAsync(args);
    }

    private async Task TogglePasswordAsync()
        => await ShowPasswordChanged.InvokeAsync(!ShowPassword);
}
