@using AlfaCore.Models

<section class="panel-card filters-card" @onkeydown="HandleApplyKeyDownAsync">
    <div class="panel-card__header">
        <div>
            <h3 class="panel-card__title">@Titulo</h3>
            <p class="panel-card__subtitle">@Subtitulo</p>
        </div>
    </div>

    <div class="filters-grid filters-grid--dates">
        <div class="field">
            <label>Fecha desde</label>
            <InputDate @bind-Value="Model.FechaDesde" />
        </div>
        <div class="field">
            <label>Fecha hasta</label>
            <InputDate @bind-Value="Model.FechaHasta" />
        </div>
        <div class="filters-toggle-wrap">
            <button type="button" class="btn btn--ghost filters-toggle" @onclick="ToggleAdvanced">
                @(_showAdvanced ? "Ocultar filtros" : "Mostrar filtros")
            </button>
        </div>
    </div>

    <div class="quick-range">
        @foreach (var opt in QuickRangeOptions)
        {
            <button type="button"
                    class="btn btn--sm @(_activeQuickRange == opt.Key ? "btn--primary" : "btn--ghost")"
                    @onclick="() => ApplyQuickRangeAsync(opt.Key)">
                @opt.Label
            </button>
        }
        <button type="button"
                class="btn btn--sm @(_activeQuickRange is null ? "btn--primary" : "btn--ghost")"
                @onclick="MarcarRangoPersonalizado">
            Rango personalizado
        </button>
    </div>

    <div class="filters-summary" aria-live="polite">
        <span class="filters-summary__label">Filtros activos</span>
        <span class="filters-summary__text">@BuildSummary()</span>
    </div>

    <div class="field field--wide filters-uneg">
        <label>Unidad de negocio</label>
        <div class="uneg-checklist">
            @foreach (var item in Options.UnidadesNegocio)
            {
                <label class="uneg-checklist__item">
                    <input type="checkbox"
                           checked="@Model.UnidadesNegocio.Contains(item.Codigo)"
                           @onchange="e => ToggleUnidadNegocio(item.Codigo, e.Value)" />
                    <span>@item.Descripcion</span>
                </label>
            }
            @if (Options.UnidadesNegocio.Count == 0)
            {
                <span class="uneg-checklist__empty">No hay unidades de negocio con datos.</span>
            }
        </div>
    </div>

    @if (_showAdvanced)
    {
        <div class="filters-grid filters-grid--wide">
            <div class="field">
                <label>Cliente</label>
                <InputText @bind-Value="Model.Cliente" />
            </div>
            <div class="field">
                <label>Usuario</label>
                <InputSelect @bind-Value="Model.Usuario">
                    <option value="">Todos</option>
                    @foreach (var item in Options.Usuarios)
                    {
                        <option value="@item">@item</option>
                    }
                </InputSelect>
            </div>
            <div class="field">
                <label>Depósito</label>
                <InputSelect @bind-Value="Model.Deposito">
                    <option value="">Todos</option>
                    @foreach (var item in Options.Depositos)
                    {
                        <option value="@item">@item</option>
                    }
                </InputSelect>
            </div>
            <div class="field">
                <label>TC</label>
                <InputSelect @bind-Value="Model.TipoComprobante">
                    <option value="">Todos</option>
                    @foreach (var item in Options.TiposComprobante)
                    {
                        <option value="@item">@item</option>
                    }
                </InputSelect>
            </div>
        </div>
    }

    <div class="actions">
        <button class="btn btn--primary" @onclick="OnApply">Aplicar filtros</button>
        <button class="btn btn--ghost" @onclick="ClearAsync">Limpiar</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public VentasDashboardFilters Model { get; set; } = new();
    [Parameter] public VentasFilterOptionsDto Options { get; set; } = new();
    [Parameter] public string Titulo { get; set; } = "Filtros de ventas";
    [Parameter] public string Subtitulo { get; set; } = "Usá estos filtros para acotar el análisis comercial.";
    [Parameter] public bool MostrarComparativoUnidadNegocio { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }

    private bool _showAdvanced;
    private string? _activeQuickRange;

    private static readonly (string Key, string Label)[] QuickRangeOptions =
    [
        ("ayer", "Ayer"),
        ("ultimos-7", "Últimos 7 días"),
        ("ultimos-15", "Últimos 15 días"),
        ("ultimos-30", "Últimos 30 días"),
        ("mes", "Este mes"),
        ("mes-anterior", "Mes pasado"),
        ("anio", "Este año"),
        ("anio-anterior", "Año pasado")
    ];

    private async Task HandleApplyKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return;

        await OnApply.InvokeAsync();
    }

    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;

    private void ToggleUnidadNegocio(string codigo, object? isChecked)
    {
        var marcado = isChecked is bool b && b;
        if (marcado && !Model.UnidadesNegocio.Contains(codigo))
            Model.UnidadesNegocio.Add(codigo);
        else if (!marcado)
            Model.UnidadesNegocio.Remove(codigo);
    }

    private void MarcarRangoPersonalizado() => _activeQuickRange = null;

    private async Task ClearAsync()
    {
        var today = DateTime.Today;
        Model.FechaDesde = new DateTime(today.Year, today.Month, 1);
        Model.FechaHasta = today;
        Model.Cliente = null;
        Model.Usuario = null;
        Model.UnidadesNegocio = [];
        Model.ComparativoUnidadNegocio = false;
        Model.Deposito = null;
        Model.TipoComprobante = null;
        _activeQuickRange = null;
        await OnApply.InvokeAsync();
    }

    private async Task ApplyQuickRangeAsync(string key)
    {
        var today = DateTime.Today;
        switch (key)
        {
            case "ayer":
                Model.FechaDesde = today.AddDays(-1);
                Model.FechaHasta = today.AddDays(-1);
                break;
            case "ultimos-7":
                Model.FechaDesde = today.AddDays(-6);
                Model.FechaHasta = today;
                break;
            case "ultimos-15":
                Model.FechaDesde = today.AddDays(-14);
                Model.FechaHasta = today;
                break;
            case "ultimos-30":
                Model.FechaDesde = today.AddDays(-29);
                Model.FechaHasta = today;
                break;
            case "mes":
                Model.FechaDesde = new DateTime(today.Year, today.Month, 1);
                Model.FechaHasta = today;
                break;
            case "mes-anterior":
                var firstThisMonth = new DateTime(today.Year, today.Month, 1);
                Model.FechaDesde = firstThisMonth.AddMonths(-1);
                Model.FechaHasta = firstThisMonth.AddDays(-1);
                break;
            case "anio":
                Model.FechaDesde = new DateTime(today.Year, 1, 1);
                Model.FechaHasta = today;
                break;
            case "anio-anterior":
                Model.FechaDesde = new DateTime(today.Year - 1, 1, 1);
                Model.FechaHasta = new DateTime(today.Year - 1, 12, 31);
                break;
        }

        _activeQuickRange = key;
        await OnApply.InvokeAsync();
    }

    private string BuildSummary()
    {
        var parts = new List<string>();
        if (Model.FechaDesde.HasValue || Model.FechaHasta.HasValue)
            parts.Add($"Fecha: {Model.FechaDesde:dd/MM/yyyy} a {Model.FechaHasta:dd/MM/yyyy}");

        AddIfPresent(parts, "Cliente", Model.Cliente);
        AddIfPresent(parts, "Usuario", Model.Usuario);

        if (Model.UnidadesNegocio.Count > 0)
        {
            var nombres = Options.UnidadesNegocio
                .Where(u => Model.UnidadesNegocio.Contains(u.Codigo))
                .Select(u => u.Descripcion);
            parts.Add($"Unidad de negocio: {string.Join(", ", nombres)}");
        }
        else
        {
            parts.Add("Unidad de negocio: todas las unidades de negocio");
        }

        if (MostrarComparativoUnidadNegocio && Model.UnidadesNegocio.Count > 1)
            parts.Add("Vista: comparativo por unidad de negocio");

        AddIfPresent(parts, "Depósito", Model.Deposito);
        AddIfPresent(parts, "TC", Model.TipoComprobante);

        return parts.Count == 0 ? "Sin filtros seleccionados." : string.Join(" | ", parts);
    }

    private static void AddIfPresent(List<string> parts, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            parts.Add($"{label}: {value}");
    }
}
