@using AlfaCore.Models
@using AlfaCore.Components.Shared.AlfaDesign

<article class="portal-cliente__account-row">
    <div class="portal-cliente__account-row-main">
        <div class="portal-cliente__account-row-title">
            <strong>@Pedido.Tc @Pedido.IdComprobanteTexto</strong>
            <div class="portal-cliente__account-row-tags">
                @if (Pedido.EsPedidoWeb)
                {
                    <AlfaTag Tone="AlfaTagTone.Accent">Pedido Web</AlfaTag>
                }
                @if (Pedido.EsPedidoWeb && Pedido.IdCatalogoWeb is { } idCatalogo)
                {
                    <AlfaTag Tone="AlfaTagTone.Neutral">Catálogo #@idCatalogo</AlfaTag>
                }
                @if (Pedido.Anulada)
                {
                    <AlfaTag Tone="AlfaTagTone.Danger">Anulado</AlfaTag>
                }
            </div>
        </div>

        <span class="portal-cliente__account-row-date">Fecha @Pedido.Fecha.ToString("dd/MM/yyyy")</span>
    </div>

    <div class="portal-cliente__account-row-side">
        <div class="portal-cliente__account-row-amounts">
            <strong>@Money(Pedido.Total)</strong>
        </div>

        <a class="portal-cliente__account-row-action" href="@DetalleUrl">
            <i class="bi bi-eye"></i> Ver detalle
        </a>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public PortalClientePedidoResumenDto Pedido { get; set; } = null!;
    [Parameter, EditorRequired] public string DetalleUrl { get; set; } = string.Empty;

    private static string Money(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
