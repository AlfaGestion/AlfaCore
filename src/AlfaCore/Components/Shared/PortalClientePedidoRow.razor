@using AlfaCore.Models

<article class="portal-cliente__pedido-row">
    <div class="portal-cliente__pedido-row__main">
        <strong>@Pedido.Tc @Pedido.IdComprobanteTexto</strong>
        <span class="portal-cliente__pedido-row__fecha">@Pedido.Fecha.ToString("dd/MM/yyyy")</span>
        @if (Pedido.EsPedidoWeb)
        {
            <span class="badge text-bg-info">Pedido Web</span>
        }
        @if (Pedido.EsPedidoWeb && Pedido.IdCatalogoWeb is { } idCatalogo)
        {
            <span class="badge text-bg-secondary">Catálogo #@idCatalogo</span>
        }
        @if (Pedido.Anulada)
        {
            <span class="badge text-bg-danger">Anulado</span>
        }
    </div>
    <div class="portal-cliente__pedido-row__total">@Money(Pedido.Total)</div>
    <a class="btn btn--ghost btn--sm" href="@DetalleUrl">
        <i class="bi bi-eye"></i> Ver detalle
    </a>
</article>

@code {
    [Parameter, EditorRequired] public PortalClientePedidoResumenDto Pedido { get; set; } = null!;
    [Parameter, EditorRequired] public string DetalleUrl { get; set; } = string.Empty;

    private static string Money(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
