@using AlfaCore.Models
@using AlfaCore.Services
@using AlfaCore.Components.Shared.AlfaDesign

<AlfaDialog CloseOnBackdrop="false" Open="@(Preparacion is not null)" Title="@(Directo ? "Cobranza" : "Cobranza rápida")" Eyebrow="Caja y Bancos"
    Size="AlfaDialogSize.Xl" Loading="@Busy" ErrorMessage="@(_error ?? Error)" OnClose="OnClose">
    <ChildContent>
        @if (Preparacion is not null)
        {
            <div class="cobranza-editor">
                @if (Directo)
                {
                    @* Cobranza directa: como en el POS y en Alfa Gestión, una solapa con los comprobantes y otra con los
                       medios de pago, que se cargan tipeando el código (o código opcional) y el importe. *@
                    <section class="cobranza-cobro__cabecera" aria-label="Cliente y totales de la cobranza">
                        <div class="cobranza-cobro__cliente">
                            <strong>@NombreTitular</strong>
                            <small>Cliente @ClienteTitular · Unidad @UnidadTitular</small>
                            <small>Saldo actual: <b>@Dinero(Preparacion.SaldosCliente.Where(s=>s.Cliente==ClienteTitular).Sum(s=>s.Saldo))</b>@(Preparacion.SaldoAl is { } corte ? $" al {corte:dd/MM/yyyy}" : string.Empty)</small>
                        </div>
                        <div class="cobranza-cobro__total">
                            <span>Total cobrado</span>
                            <strong>$ @Dinero(Total)</strong>
                        </div>
                        @if (Faltante > 0)
                        {
                            <div class="cobranza-cobro__total cobranza-cobro__total--faltante"><span>Faltante</span><strong>$ @Dinero(Faltante)</strong></div>
                        }
                        else
                        {
                            <div class="cobranza-cobro__total cobranza-cobro__total--acuenta"><span>A cuenta (anticipo)</span><strong>$ @Dinero(ImporteACuenta)</strong></div>
                        }
                    </section>
                    <AlfaTabs Items="@Pestanas" ActiveKey="@_pestana" ActiveKeyChanged="CambiarPestana" AriaLabel="Comprobantes y medios de pago" />
                    <div class="cobranza-cobro__panel" hidden="@(_pestana != "comprobantes")">
                        @if (DocumentosUnidad.Count == 0)
                        {
                            <p class="cobranza-editor__sugerencia">El cliente no tiene comprobantes pendientes en esta unidad. Lo que cobres queda a cuenta (anticipo) y después se aplica a sus facturas.</p>
                        }
                        else
                        {
                            <p>Tildá las facturas que cancela este cobro, o ninguna si es un anticipo. Lo que no se aplique queda a cuenta del cliente.</p>
                        }
                        @TablaDocumentos()
                    </div>
                    <div class="cobranza-cobro__panel" hidden="@(_pestana != "medios")">
                        @if (DocumentosUnidad.Count == 0)
                        {
                            <p class="cobranza-editor__sugerencia">El cliente no tiene comprobantes pendientes en esta unidad: lo que cobres queda a cuenta (anticipo).</p>
                        }
                        <div class="cobranza-cobro__entrada">
                            <input class="cobranza-cobro__codigo" @ref="_refCodigo" @bind="_codigoMedio" @bind:event="oninput"
                                   @onkeydown="CodigoTecla" @onblur="CodigoSalir" placeholder="Código o descripción"
                                   aria-label="Código o descripción del medio de pago" autocomplete="off" disabled="@Busy" />
                            <div class="cobranza-cobro__seleccionado">
                                <span>Medio seleccionado</span>
                                <strong>@(MedioSeleccionado?.Descripcion ?? "Sin seleccionar")</strong>
                            </div>
                            <input class="cobranza-cobro__importe" @ref="_refImporte" @bind="_importeMedio" @bind:event="oninput"
                                   @bind:after="() => _importeEditado = true" @onkeydown="ImporteTeclaAsync" inputmode="decimal"
                                   placeholder="Importe" aria-label="Importe del medio de pago" autocomplete="off" disabled="@Busy" />
                            <input class="cobranza-cobro__referencia" @bind="_referenciaMedio" @bind:event="oninput" maxlength="50"
                                   placeholder="Referencia o certificado (opcional)" aria-label="Referencia o certificado" autocomplete="off" disabled="@Busy" />
                            <button type="button" class="cobranza-cobro__agregar" @onclick="AgregarPagoAsync" disabled="@(Busy || _lineas.Count >= 20)">Agregar</button>
                        </div>
                        <div class="cobranza-cobro__columnas">
                            <section>
                                <h4>Medios de pago</h4>
                                <div class="cobranza-cobro__medios">
                                    @foreach (var m in MediosFiltrados)
                                    {
                                        <button type="button" @key="m.Cuenta" class="cobranza-cobro__medio @(m.Cuenta == _medioSeleccionado ? "is-active" : string.Empty)"
                                                @onclick="() => ElegirMedioAsync(m.Cuenta)" disabled="@Busy">
                                            <strong>@m.Descripcion</strong>
                                            <span>@CodigoVisible(m) · @m.Tipo</span>
                                        </button>
                                    }
                                    @if (MediosFiltrados.Count == 0) { <p class="cobranza-editor__sugerencia">Ningún medio coincide con «@_codigoMedio».</p> }
                                </div>
                            </section>
                            <section>
                                <h4>Pagos aplicados</h4>
                                @if (_lineas.Count == 0)
                                {
                                    <p class="cobranza-cobro__vacio">Todavía no agregaste pagos.</p>
                                }
                                else
                                {
                                    <div class="cobranza-cobro__pagos">
                                        @foreach (var linea in _lineas)
                                        {
                                            var medio = Preparacion.Medios.FirstOrDefault(x => x.Cuenta == linea.Cuenta);
                                            <div class="cobranza-cobro__pago" @key="linea">
                                                <div>
                                                    <strong>@(medio?.Descripcion ?? linea.Cuenta)</strong>
                                                    <span>@(medio is null ? linea.Cuenta : CodigoVisible(medio))@(linea.Certificado.Length > 0 ? $" · {linea.Certificado}" : string.Empty)</span>
                                                </div>
                                                <strong>@Dinero(ParsearImporte(linea.Importe))</strong>
                                                <button type="button" aria-label="@($"Quitar {medio?.Descripcion ?? linea.Cuenta}")" disabled="@Busy" @onclick="() => QuitarPago(linea)"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="cobranza-cobro__resumen">
                                    <div><span>Facturas seleccionadas</span><strong>@Dinero(SaldoSeleccionado)</strong></div>
                                    <div><span>Total cobrado</span><strong>@Dinero(Total)</strong></div>
                                    <div><span>Aplicado a facturas</span><strong>@Dinero(TotalAplicado)</strong></div>
                                    <div class="@(Faltante > 0 ? "is-faltante" : string.Empty)"><span>Faltante</span><strong>@Dinero(Faltante)</strong></div>
                                    <div class="@(ImporteACuenta > 0 ? "is-acuenta" : string.Empty)"><span>A cuenta (anticipo)</span><strong>@Dinero(ImporteACuenta)</strong></div>
                                </div>
                            </section>
                        </div>
                    </div>
                }
                else
                {
                @if (Preparacion.Documentos.Select(d=>(d.Cliente,d.Unidad)).Distinct().Count()>1)
                {
                    <AlfaSelect Label="Cliente y unidad de negocio" Value="@_factura" ValueChanged="CambiarFactura"
                        Options="@OpcionesDocumentos" Disabled="@Busy" />
                    <p>Seleccioná comprobantes del mismo cliente y unidad para emitir un único recibo.</p>
                }
                @if (TieneTitular)
                {
                    <section class="cobranza-editor__resumen" aria-label="Cliente, saldo actual e ingreso bancario">
                        <div class="cobranza-editor__cliente">
                            <strong>@NombreTitular</strong>
                            <small>Cliente @ClienteTitular · Unidad @UnidadTitular</small>
                            <span>Saldo actual del cliente</span>
                            @if (Preparacion.SaldoAl is { } corte)
                            {
                                @foreach (var saldo in Preparacion.SaldosCliente.Where(s=>s.Cliente==ClienteTitular))
                                {
                                    <strong class="cobranza-editor__importe">@saldo.Moneda @Dinero(saldo.Saldo)</strong>
                                }
                                @if (!Preparacion.SaldosCliente.Any(s=>s.Cliente==ClienteTitular)) { <strong class="cobranza-editor__importe">$ 0,00</strong> }
                                <small>Al @corte.ToString("dd/MM/yyyy") · unidades autorizadas · antes de esta cobranza</small>
                            }
                            else { <small>Saldo no consultado</small> }
                        </div>
                        @if (!Directo)
                        {
                        <div class="cobranza-editor__ingreso">
                            <span>Recibido en el banco</span>
                            <strong class="cobranza-editor__importe">$ @Dinero(Preparacion.ImporteBanco)</strong>
                            <small>@Preparacion.Fecha.ToString("dd/MM/yyyy")</small>
                            <span>@Preparacion.Medios.FirstOrDefault(m=>m.Cuenta==Preparacion.CuentaBanco)?.Descripcion</span>
                        </div>
                        }
                    </section>
                    <h3>1. Facturas a cancelar</h3>
                    @if (Directo && DocumentosUnidad.Count == 0)
                    {
                        <p class="cobranza-editor__sugerencia">El cliente no tiene comprobantes pendientes en esta unidad. Lo que cobres queda a cuenta (anticipo) y después se aplica a sus facturas.</p>
                    }
                    else if (Directo)
                    {
                        <p>Tildá las facturas que cancela este cobro, o ninguna si es un anticipo. Lo que no se aplique queda a cuenta del cliente.</p>
                    }
                    else
                    {
                        <p>Seleccioná las facturas. Podés corregir el importe aplicado a cada una.</p>
                    }
                    @if (_seleccionSugerida) { <p class="cobranza-editor__sugerencia">Selección precargada desde la propuesta. Revisala antes de confirmar.</p> }
                    @TablaDocumentos()
                }
                <h3>@(Directo ? "2. Medios de pago" : "2. Banco y retenciones")</h3>
                @foreach (var linea in _lineas)
                {
                    <div class="cobranza-editor__medio" @key="linea">
                        @if (linea.Banco)
                        {
                            <div><small>Cuenta bancaria</small><p>@Preparacion.Medios.FirstOrDefault(m=>m.Cuenta==linea.Cuenta)?.Descripcion</p></div>
                            <strong class="cobranza-editor__importe-banco">$ @Dinero(Preparacion.ImporteBanco)</strong>
                        }
                        else
                        {
                            <AlfaSelect Label="@(Directo ? "Medio de pago" : "Retención")" Value="@linea.Cuenta"
                                ValueChanged="v => { linea.Cuenta=v ?? string.Empty; linea.Sugerida=false; linea.Auto=false; }" Options="@OpcionesRetenciones"
                                Placeholder="@(Directo ? "Seleccionar medio de pago" : "Seleccionar retención")" Disabled="@Busy" />
                            <AlfaInput Label="Importe" Type="number" Step="0.01" Value="@linea.Importe"
                                ValueChanged="v => { linea.Importe=v ?? string.Empty; linea.Sugerida=false; linea.Auto=false; }" Disabled="@Busy" />
                        }
                        @if (!linea.Banco)
                        {
                            @if (linea.Sugerida && UltimaRetencion is { } anterior)
                            {
                                <p class="cobranza-editor__sugerencia">Retención sugerida por la diferencia pendiente, según CB @anterior.Comprobante del @anterior.Fecha.ToString("dd/MM/yyyy"). Podés corregirla o quitarla.</p>
                            }
                            <AlfaInput Label="@(Directo ? "Referencia o certificado (opcional)" : "Certificado de retención (opcional)")" Value="@linea.Certificado" ValueChanged="v => { linea.Certificado=v ?? string.Empty; linea.Sugerida=false; }"
                                MaxLength="50" Disabled="@Busy" />
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@Busy" OnClick="() => _lineas.Remove(linea)">Quitar</AlfaButton>
                        }
                    </div>
                }
                <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@(Busy || _lineas.Count>=20)" OnClick="AgregarRetencion">@(Directo ? "Agregar medio de pago" : "Agregar retención")</AlfaButton>
                @if (Directo) { }
                else if (!_ajusteActivo)
                {
                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@(Busy || _seleccionadas.Count == 0 || Preparacion.CuentasAjuste.Count == 0 || DiferenciaParaAjuste == 0 || Math.Abs(DiferenciaParaAjuste) > Preparacion.LimiteAjuste)" OnClick="AgregarAjuste">Agregar ajuste de centavos</AlfaButton>
                    <p class="cobranza-editor__sugerencia">Ajuste opcional para cancelar el pendiente de las facturas seleccionadas. Límite: $ @Dinero(Preparacion.LimiteAjuste). No se registra como impuesto ni retención.</p>
                    @if (Preparacion.CuentasAjuste.Count == 0){<p class="cobranza-editor__sugerencia">No hay cuentas activas de ajustes, redondeos o gastos en pesos, sin medio de pago, disponibles para esta opción.</p>}
                }
                else
                {
                    <div class="cobranza-editor__medio">
                        <AlfaSelect Label="Cuenta de ajuste" Options="OpcionesAjuste" Value="@_cuentaAjuste" ValueChanged="v => _cuentaAjuste = v ?? string.Empty" Placeholder="Seleccionar cuenta de ajuste" Disabled="Busy" />
                        <AlfaInput Label="Importe del ajuste (+ gasto / − diferencia a favor)" Type="number" Step="0.01" Value="@_importeAjuste" ValueChanged="v => _importeAjuste = v ?? string.Empty" Disabled="Busy" />
                        <AlfaInput Label="Motivo del ajuste" MaxLength="100" Value="@_motivoAjuste" ValueChanged="v => _motivoAjuste = v ?? string.Empty" Disabled="Busy" />
                        <AlfaCheckbox Value="@_recordarAjuste" ValueChanged="v => _recordarAjuste = v == true" Disabled="Busy">Usar esta cuenta por defecto en próximas cobranzas</AlfaCheckbox>
                        <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="Busy" OnClick="QuitarAjuste">Quitar ajuste</AlfaButton>
                    </div>
                    <p class="cobranza-editor__sugerencia">El ajuste agrega una línea contable al recibo. El importe recibido en el banco se conserva. Revisá cuenta, signo e importe antes de confirmar.</p>
                }
                }
                <details class="cobranza-editor__opciones" open="@(Directo || string.IsNullOrWhiteSpace(_talonario))">
                    <summary>3. Fecha, talonario y concepto del recibo · @FechaResumen</summary>
                    <div class="cobranza-editor__cabecera">
                        <AlfaInput Label="Fecha de cobranza" Type="date" Value="@_fecha" ValueChanged="v => _fecha=v ?? string.Empty" Disabled="@Busy" />
                        <AlfaSelect Label="Talonario del recibo" Value="@_talonario" ValueChanged="v => _talonario=v ?? string.Empty"
                            Options="@OpcionesTalonarios" Placeholder="Seleccionar talonario CB" Disabled="@Busy" />
                    </div>
                    <AlfaInput Label="@(Directo ? "Concepto / observación" : "Detalle de la cobranza")" Value="@_detalle" ValueChanged="v => _detalle=v ?? string.Empty" MaxLength="100" Disabled="@Busy" />
                    <p class="cobranza-editor__sugerencia">El número definitivo de CB se asignará al confirmar.</p>
                </details>
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="cobranza-editor__totales">
            <span class="cobranza-editor__total-cb">Total CB: <strong>$ @Dinero(Total)</strong></span>
            @if (_ajusteActivo){<span>Ajuste incluido: <strong>@Dinero(ParsearImporte(_importeAjuste))</strong></span>}
            @if (Directo)
            {
                <span>Aplicado a facturas: <strong>@Dinero(TotalAplicado)</strong> · A cuenta (anticipo): <strong>@Dinero(Math.Max(0,Total-TotalAplicado))</strong></span>
            }
            else
            {
                <span>Aplicado: <strong>@Dinero(TotalAplicado)</strong> · Diferencia por aplicar: <strong>@Dinero(Total-TotalAplicado)</strong></span>
            }
            <span>Pendiente en facturas seleccionadas: <strong>@Dinero(SaldoSeleccionado-TotalAplicado)</strong></span>
        </div>
        <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@Busy" OnClick="() => OnClose.InvokeAsync()">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Disabled="@(Busy || !TieneTitular || string.IsNullOrEmpty(_talonario) || (Directo ? Total<=0 || TotalAplicado>Total : _seleccionadas.Count==0 || Total!=TotalAplicado) || AplicacionesActuales.Any(a=>a.Importe<=0) || (_ajusteActivo && (string.IsNullOrWhiteSpace(_cuentaAjuste) || string.IsNullOrWhiteSpace(_motivoAjuste) || ParsearImporte(_importeAjuste)==0 || Math.Abs(ParsearImporte(_importeAjuste))>(Preparacion?.LimiteAjuste??0))))"
            OnClick="Confirmar">@(Busy ? "Registrando…" : "Confirmar cobranza CB")</AlfaButton>
    </Footer>
</AlfaDialog>

@code {
    [Parameter] public CobranzaPreparacion? Preparacion { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CobranzaSolicitud> OnConfirm { get; set; }
    [Parameter] public string? ComprobantePreferido { get; set; }
    // Módulo Cobranzas: sin movimiento bancario; los medios (banco, efectivo, retenciones) y sus importes los carga el usuario.
    [Parameter] public bool Directo { get; set; }
    // Cobranza directa: comprobantes tildados en el listado; el resto del cliente y unidad se puede tildar acá.
    [Parameter] public IReadOnlyList<int>? Preseleccion { get; set; }
    private CobranzaPreparacion? _anterior;
    private Guid _operacion;
    private string _factura="",_talonario="",_fecha="";
    private string FechaResumen => DateTime.TryParseExact(_fecha,"yyyy-MM-dd",Invariante,System.Globalization.DateTimeStyles.None,out var fecha)
        ? fecha.ToString("dd/MM/yyyy") : _fecha;
    private string _detalle="",_detalleSugerido="";
    private string? _error;
    private readonly List<Linea> _lineas=[];
    private readonly HashSet<int> _seleccionadas=[];
    private readonly Dictionary<int,string> _importesManuales=[];
    private bool _seleccionSugerida;
    private bool _ajusteActivo, _recordarAjuste = true;
    private string _cuentaAjuste = "", _importeAjuste = "", _motivoAjuste = "Ajuste por redondeo";
    private IReadOnlyList<AlfaSelectOption> OpcionesAjuste => Preparacion?.CuentasAjuste.Select(c => new AlfaSelectOption(c.Codigo, $"{c.Codigo} · {c.Descripcion}")).ToList() ?? [];
    private decimal DiferenciaParaAjuste => SaldoSeleccionado - _lineas.Where(l => !l.Sugerida).Sum(l => ParsearImporte(l.Importe));
    private static readonly System.Globalization.CultureInfo Invariante=System.Globalization.CultureInfo.InvariantCulture;
    private static string Dinero(decimal valor) => valor.ToString("N2",System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
    private CobranzaDocumento? Documento => Preparacion?.Documentos.SingleOrDefault(d=>d.Id.ToString()==_factura);
    private IReadOnlyList<AlfaSelectOption> OpcionesDocumentos => Preparacion?.Documentos.DistinctBy(d=>(d.Cliente,d.Unidad))
        .Select(d=>new AlfaSelectOption(d.Id.ToString(),$"{d.Nombre} · Unidad {d.Unidad}")).ToList() ?? [];
    private IReadOnlyList<CobranzaDocumento> DocumentosUnidad => Preparacion?.Documentos.Where(d=>d.Cliente==ClienteTitular && d.Unidad==UnidadTitular).ToList() ?? [];
    // Titular del recibo: el del comprobante elegido o, en cobranza directa, el cliente elegido aunque no deba nada.
    private bool DirectoConCliente => Directo && !string.IsNullOrEmpty(Preparacion?.Cliente);
    private string ClienteTitular => DirectoConCliente ? Preparacion!.Cliente : Documento?.Cliente ?? "";
    private string UnidadTitular => DirectoConCliente ? Preparacion!.Unidad : Documento?.Unidad ?? "";
    private string NombreTitular => Documento?.Nombre ?? Preparacion?.NombreCliente ?? "";
    private bool TieneTitular => ClienteTitular.Length > 0 && UnidadTitular.Length > 0;
    private decimal SaldoSeleccionado => DocumentosUnidad.Where(d=>_seleccionadas.Contains(d.Id)).Sum(d=>d.Saldo);
    private decimal TotalAplicado => AplicacionesActuales.Sum(a=>a.Importe);
    private IReadOnlyList<CobranzaAplicacion> AplicacionesActuales
    {
        get
        {
            var seleccion=DocumentosUnidad.Where(d=>_seleccionadas.Contains(d.Id)).ToList();
            var disponible=Total-seleccion.Where(d=>_importesManuales.ContainsKey(d.Id)).Sum(d=>ParsearImporte(_importesManuales[d.Id]));
            var resultado=new List<CobranzaAplicacion>();
            foreach(var d in seleccion)
            {
                var manual=_importesManuales.TryGetValue(d.Id,out var texto);
                var importe=manual ? ParsearImporte(texto!) : Math.Min(d.Saldo,Math.Max(0,disponible));
                if(!manual) disponible-=importe;
                resultado.Add(new(d.Id,importe));
            }
            return resultado;
        }
    }
    private static decimal ParsearImporte(string texto) => decimal.TryParse(texto,System.Globalization.NumberStyles.AllowDecimalPoint|System.Globalization.NumberStyles.AllowLeadingSign,Invariante,out var n)?n:0;
    private IReadOnlyList<CobranzaTalonario> TalonariosUnidad
    {
        get
        {
            var todos=Preparacion?.Talonarios ?? [];
            return todos.Any(t=>t.Unidad==UnidadTitular) ? todos.Where(t=>t.Unidad==UnidadTitular).ToList()
                : todos.Where(t=>t.Unidad is "" or "0").ToList();
        }
    }
    private IReadOnlyList<AlfaSelectOption> OpcionesTalonarios => TalonariosUnidad.Select(t=>new AlfaSelectOption(t.Talonario.ToString(),t.Display)).ToList();
    private IReadOnlyList<AlfaSelectOption> OpcionesBanco => Preparacion?.Medios.Where(m=>m.Cuenta==Preparacion.CuentaBanco)
        .Select(m=>new AlfaSelectOption(m.Cuenta,$"{m.Cuenta} — {m.Descripcion}")).ToList() ?? [];
    private IReadOnlyList<AlfaSelectOption> OpcionesRetenciones => Preparacion?.Medios.Where(m=>(Directo||m.Tipo!="DB")&&m.Moneda=="1")
        .Select(m=>new AlfaSelectOption(m.Cuenta,$"{m.Descripcion} ({m.Tipo})")).ToList() ?? [];
    private decimal Total => _lineas.Sum(l=>decimal.TryParse(l.Importe,System.Globalization.NumberStyles.AllowDecimalPoint,Invariante,out var n)?n:0)+(_ajusteActivo?ParsearImporte(_importeAjuste):0);
    private CobranzaRetencionSugerida? UltimaRetencion => Preparacion?.RetencionesSugeridas.FirstOrDefault(r=>
        r.Cliente==ClienteTitular && r.Unidad==UnidadTitular && OpcionesRetenciones.Any(o=>o.Value==r.Cuenta));
    protected override void OnParametersSet()
    {
        if(ReferenceEquals(_anterior,Preparacion)) return;
        _anterior=Preparacion; _error=null; _lineas.Clear(); _seleccionadas.Clear();_importesManuales.Clear();_seleccionSugerida=false;
        _ajusteActivo=false;_cuentaAjuste=Preparacion?.CuentaAjustePredeterminada??"";_importeAjuste="";_recordarAjuste=true;_motivoAjuste="Ajuste por redondeo";
        _operacion=Guid.NewGuid(); _detalle=_detalleSugerido="";
        if(Preparacion is null) return;
        _fecha=Preparacion.Fecha.ToString("yyyy-MM-dd");
        if(!Directo) _lineas.Add(new() { Banco=true,Cuenta=Preparacion.CuentaBanco,Importe=Preparacion.ImporteBanco.ToString("0.00",Invariante) });
        var propuestaId=Preparacion.AplicacionesSugeridas.FirstOrDefault()?.FacturaId;
        var inicial=Preparacion.Documentos.FirstOrDefault(d=>Preseleccion?.Contains(d.Id)==true)
            ?? Preparacion.Documentos.FirstOrDefault(d=>$"{d.Tc}|{d.Comprobante}"==ComprobantePreferido)
            ?? Preparacion.Documentos.FirstOrDefault(d=>d.Id==propuestaId) ?? Preparacion.Documentos.FirstOrDefault();
        CambiarFactura(inicial?.Id.ToString());
        if(Directo)
        {
            // Cobranza nueva sin comprobantes tildados en el listado: no se preselecciona ninguno (puede ser un anticipo).
            _seleccionadas.Clear();
            foreach(var id in (Preseleccion ?? []).Where(id=>DocumentosUnidad.Any(d=>d.Id==id))) _seleccionadas.Add(id);
            // Con comprobantes ya elegidos (o sin ninguno para elegir) se abre en los medios de pago, listo para tipear.
            _codigoMedio=_referenciaMedio="";_medioSeleccionado=MedioPredeterminado()?.Cuenta ?? "";
            _pestana=_seleccionadas.Count>0||DocumentosUnidad.Count==0 ? "medios" : "comprobantes";
            _enfocar=_pestana=="medios" ? "codigo" : null;
            PrecargarImporte();
        }
        if(Preparacion.AplicacionesSugeridas.Count>0 && Preparacion.AplicacionesSugeridas.Any(a=>a.FacturaId==Documento?.Id)
            && Preparacion.AplicacionesSugeridas.All(a=>DocumentosUnidad.Any(d=>d.Id==a.FacturaId)))
        {
            _seleccionadas.Clear();foreach(var a in Preparacion.AplicacionesSugeridas) _seleccionadas.Add(a.FacturaId);
            _seleccionSugerida=true;ActualizarRetencionSugerida();
            if(Preparacion.AplicacionesSugeridas.Sum(a=>a.Importe)==Total)
                foreach(var a in Preparacion.AplicacionesSugeridas) _importesManuales[a.FacturaId]=a.Importe.ToString("0.00",Invariante);
        }
    }
    private void CambiarFactura(string? valor)
    {
        _ajusteActivo=false;_importeAjuste="";
        var proponer=string.IsNullOrWhiteSpace(_detalle)||_detalle==_detalleSugerido;
        _factura=valor ?? ""; _talonario=TalonariosUnidad.FirstOrDefault()?.Talonario.ToString() ?? ""; _error=null;
        _seleccionadas.Clear();_importesManuales.Clear();_seleccionSugerida=false;
        if(Documento is { } actual) _seleccionadas.Add(actual.Id);
        _detalleSugerido=Documento?.DetallePredeterminado ?? "";
        if(proponer) _detalle=_detalleSugerido;
        ActualizarRetencionSugerida();
    }
    private void CambiarSeleccion(CobranzaDocumento documento,bool seleccionar)
    {
        _ajusteActivo=false;_importeAjuste="";
        if(seleccionar) _seleccionadas.Add(documento.Id); else { _seleccionadas.Remove(documento.Id);_importesManuales.Remove(documento.Id); }
        _seleccionSugerida=false;_error=null;ActualizarRetencionSugerida();
    }
    // En cobranza directa el importe a cargar acompaña al faltante de las facturas tildadas hasta que el usuario lo edita.
    private void AutoCompletarDirecto()
    {
        if(Directo && !_importeEditado) PrecargarImporte();
    }
    private void ActualizarRetencionSugerida()
    {
        if(Directo){ AutoCompletarDirecto(); return; }
        _lineas.RemoveAll(l=>l.Sugerida);
        if(!_lineas.Any(l=>!l.Banco) && UltimaRetencion is { } retencion && SaldoSeleccionado>Total)
            _lineas.Add(new() { Cuenta=retencion.Cuenta,Importe=(SaldoSeleccionado-Total).ToString("0.00",Invariante),Sugerida=true });
    }
    private void AgregarRetencion() => _lineas.Add(new() {
        Cuenta=Directo ? "" : UltimaRetencion?.Cuenta ?? "",
        Importe=!Directo && SaldoSeleccionado>Total ? (SaldoSeleccionado-Total).ToString("0.00",Invariante) : ""
    });
    private void AgregarAjuste()
    {
        if (Busy || Preparacion is null || _seleccionadas.Count == 0 || DiferenciaParaAjuste == 0 || Math.Abs(DiferenciaParaAjuste) > Preparacion.LimiteAjuste) return;
        var diferencia = DiferenciaParaAjuste;
        _lineas.RemoveAll(l => l.Sugerida);
        _ajusteActivo = true; _importeAjuste = diferencia.ToString("0.00",Invariante);
        foreach (var d in DocumentosUnidad.Where(d => _seleccionadas.Contains(d.Id))) _importesManuales[d.Id] = d.Saldo.ToString("0.00",Invariante);
    }
    private void QuitarAjuste()
    {
        if (Busy) return;
        _ajusteActivo=false;_importeAjuste="";_importesManuales.Clear();
    }
    private async Task Confirmar()
    {
        try
        {
            _error=null;
            if(!DateTime.TryParseExact(_fecha,"yyyy-MM-dd",Invariante,System.Globalization.DateTimeStyles.None,out var fecha)||
                !int.TryParse(_talonario,out var tal)||!TieneTitular)
                throw new InvalidOperationException("Seleccioná comprobante, fecha y talonario.");
            var pagos=_lineas.Select(l=>new CobranzaPago(l.Cuenta,
                decimal.TryParse(l.Importe,System.Globalization.NumberStyles.AllowDecimalPoint,Invariante,out var n)?n:0,l.Certificado)).ToList();
            var aplicaciones=AplicacionesActuales;
            if(aplicaciones.Count==0&&!Directo) throw new InvalidOperationException("Seleccioná al menos un comprobante a cobrar.");
            // Cobranza directa: siempre a nombre del cliente elegido; lo que no se aplica a facturas queda a cuenta.
            var solicitud=Directo
                ? new CobranzaSolicitud(_operacion,aplicaciones.FirstOrDefault()?.FacturaId ?? 0,fecha,tal,pagos,null,_detalle,
                    aplicaciones,null,new CobranzaACuenta(ClienteTitular,UnidadTitular))
                : new CobranzaSolicitud(_operacion,aplicaciones[0].FacturaId,fecha,tal,pagos,Preparacion!.MovimientoId,_detalle,
                    aplicaciones.Count==1 && aplicaciones[0].Importe==Total ? null : aplicaciones,
                    _ajusteActivo?new(_cuentaAjuste,ParsearImporte(_importeAjuste),_motivoAjuste,_recordarAjuste):null);
            var total=CobranzasService.ValidarImportes(solicitud);
            if(aplicaciones.Any(a=>a.Importe>DocumentosUnidad.Single(d=>d.Id==a.FacturaId).Saldo))
                throw new InvalidOperationException("El importe aplicado supera el saldo de un comprobante. Revisá los importes y las retenciones.");
            if(_lineas.Any(l=>!l.Banco&&string.IsNullOrEmpty(l.Cuenta)))
                throw new InvalidOperationException("Seleccioná la cuenta de cada retención.");
            await OnConfirm.InvokeAsync(solicitud);
        }
        catch(InvalidOperationException ex) { _error=ex.Message; }
    }
    // ---- Cobranza directa: solapas y carga de medios como en el POS ----
    private string _pestana = "comprobantes";
    private string _codigoMedio = "", _importeMedio = "", _referenciaMedio = "", _medioSeleccionado = "";
    private bool _importeEditado;
    private string? _enfocar;
    private ElementReference _refCodigo, _refImporte;
    private decimal Faltante => Math.Max(0, SaldoSeleccionado - Total);
    private decimal ImporteACuenta => Math.Max(0, Total - TotalAplicado);
    private IReadOnlyList<AlfaTabItem> Pestanas =>
    [
        new("comprobantes", "1. Comprobantes", Badge: _seleccionadas.Count > 0 ? _seleccionadas.Count.ToString() : null),
        new("medios", "2. Medios de pago", Badge: _lineas.Count > 0 ? _lineas.Count.ToString() : null)
    ];
    private IReadOnlyList<CobranzaMedio> MediosDirecto => Preparacion?.Medios.Where(m => m.Moneda == "1").ToList() ?? [];
    private IReadOnlyList<CobranzaMedio> MediosFiltrados
        => MedioPagoBuscador.Filtrar(MediosDirecto, _codigoMedio, m => m.Cuenta, m => m.CodigoOpcional, m => m.Descripcion);
    private CobranzaMedio? MedioSeleccionado => MediosDirecto.FirstOrDefault(m => m.Cuenta == _medioSeleccionado);
    private static string CodigoVisible(CobranzaMedio m) => m.CodigoOpcional.Length > 0 ? m.CodigoOpcional : m.Cuenta;

    private void CambiarPestana(string? clave)
    {
        _pestana = clave ?? "comprobantes";
        if (_pestana == "medios") _enfocar = "codigo";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enfocar is not { } destino || Preparacion is null) return;
        _enfocar = null;
        try { await (destino == "importe" ? _refImporte : _refCodigo).FocusAsync(); } catch { }
    }

    // Código exacto (código opcional o cuenta) o, si el texto deja un único medio, ese medio. Igual que el POS.
    private (CobranzaMedio? Medio, int Coincidencias) ResolverMedio()
        => MedioPagoBuscador.Resolver(MediosDirecto, _codigoMedio, m => m.Cuenta, m => m.CodigoOpcional, m => m.Descripcion);

    private void SeleccionarMedio(CobranzaMedio medio)
    {
        _medioSeleccionado = medio.Cuenta; _error = null;
        if (!_importeEditado || string.IsNullOrWhiteSpace(_importeMedio)) PrecargarImporte();
    }

    private void PrecargarImporte() { _importeMedio = MedioPagoBuscador.FormatoCarga(Faltante); _importeEditado = false; }

    private void CodigoTecla(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var (medio, coincidencias) = ResolverMedio();
        if (medio is null)
        {
            if (coincidencias == 0 && _codigoMedio.Trim().Length > 0) _error = $"No hay un medio de pago con el código «{_codigoMedio.Trim()}».";
            return;
        }
        SeleccionarMedio(medio);
        _enfocar = "importe";
    }

    // Tab o clic afuera: se resuelve igual que con Enter; si el código no identifica un medio, se quita la selección
    // anterior para no cargar el importe en otro medio.
    private void CodigoSalir()
    {
        if (_codigoMedio.Trim().Length == 0) return;
        var (medio, coincidencias) = ResolverMedio();
        if (medio is not null) { SeleccionarMedio(medio); return; }
        _medioSeleccionado = "";
        if (coincidencias == 0) _error = $"No hay un medio de pago con el código «{_codigoMedio.Trim()}».";
    }

    private Task ElegirMedioAsync(string cuenta)
    {
        if (MediosDirecto.FirstOrDefault(m => m.Cuenta == cuenta) is { } medio) { SeleccionarMedio(medio); _enfocar = "importe"; }
        return Task.CompletedTask;
    }

    private async Task ImporteTeclaAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AgregarPagoAsync();
    }

    internal static bool TryImporte(string? texto, out decimal importe) => MedioPagoBuscador.TryImporte(texto, out importe);

    private Task AgregarPagoAsync()
    {
        _error = null;
        if (MedioSeleccionado is not { } medio) { _error = "Elegí un medio de pago: escribí su código o hacé clic en la lista."; _enfocar = "codigo"; return Task.CompletedTask; }
        if (!TryImporte(_importeMedio, out var importe) || importe <= 0 || importe != decimal.Round(importe, 2))
        { _error = "Ingresá un importe positivo de hasta dos decimales."; _enfocar = "importe"; return Task.CompletedTask; }
        if (_lineas.Count >= 20) { _error = "Un recibo admite hasta 20 medios de pago."; return Task.CompletedTask; }
        _lineas.Add(new() { Cuenta = medio.Cuenta, Importe = importe.ToString("0.00", Invariante), Certificado = _referenciaMedio.Trim() });
        _codigoMedio = _referenciaMedio = "";
        _medioSeleccionado = MedioPredeterminado()?.Cuenta ?? "";
        PrecargarImporte();
        _enfocar = "codigo";
        return Task.CompletedTask;
    }

    private void QuitarPago(Linea linea) { _lineas.Remove(linea); if (!_importeEditado) PrecargarImporte(); }

    private CobranzaMedio? MedioPredeterminado() => MediosDirecto.FirstOrDefault(m => m.Tipo == "EF") ?? MediosDirecto.FirstOrDefault();

    private RenderFragment TablaDocumentos() => @<text>
        @if (DocumentosUnidad.Count > 0)
        {
        <div class="cobranza-editor__documentos"><table>
            <thead><tr><th>Seleccionar</th><th>Comprobante</th><th>Pendiente de factura</th><th>Aplicar</th></tr></thead>
            <tbody>@foreach(var d in DocumentosUnidad)
            {
                var importe=AplicacionesActuales.FirstOrDefault(a=>a.FacturaId==d.Id)?.Importe ?? 0;
                <tr @key="d.Id">
                    <td><AlfaCheckbox Value="@_seleccionadas.Contains(d.Id)" ValueChanged="v=>CambiarSeleccion(d,v==true)" AriaLabel="@($"Seleccionar {d.Tc} {d.Comprobante}")" Disabled="@Busy" /></td>
                    <td>@d.Tc @d.Numero · @d.Fecha.ToString("dd/MM/yyyy")</td><td class="numero">@Dinero(d.Saldo)</td>
                    <td><AlfaInput Label="@($"Aplicar a {d.Tc} {d.Comprobante}")" Type="number" Step="0.01"
                        Value="@(_importesManuales.TryGetValue(d.Id,out var editado) ? editado : importe.ToString("0.00",Invariante))"
                        ValueChanged="v=>_importesManuales[d.Id]=v ?? string.Empty" Disabled="@(Busy || !_seleccionadas.Contains(d.Id))" /></td>
                </tr>
            }</tbody>
        </table></div>
        <p>@_seleccionadas.Count factura(s) · Pendiente seleccionado: <strong>@Dinero(SaldoSeleccionado)</strong>.</p>
        }
    </text>;

    private sealed class Linea
    {
        public bool Banco { get; set; }
        public bool Sugerida { get; set; }
        public bool Auto { get; set; }
        public string Cuenta { get; set; }="";
        public string Importe { get; set; }="";
        public string Certificado { get; set; }="";
    }
}
