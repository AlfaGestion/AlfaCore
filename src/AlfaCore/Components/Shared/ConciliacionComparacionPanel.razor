@using System.Globalization
@using AlfaCore.Services
@implements IDisposable
@inject ConciliacionBancariaService Servicio
@inject IAppUiOperationService UiOps

<section class="conciliacion-comparacion" aria-label="Comparación banco contra Alfa">
    <div class="conciliacion-comparacion__filtros">
        <AlfaSelect Label="Cuenta bancaria (pesos)" Value="@_cuenta" ValueChanged="v=>_cuenta=v ?? string.Empty" Options="@OpcionesCuentas" Placeholder="Seleccionar cuenta" Disabled="@_busy" />
        <AlfaInput Label="Desde" Type="date" Value="@_desde" ValueChanged="v=>_desde=v ?? string.Empty" Disabled="@_busy" />
        <AlfaInput Label="Hasta" Type="date" Value="@_hasta" ValueChanged="v=>_hasta=v ?? string.Empty" Disabled="@_busy" />
        <AlfaSelect Label="Conciliación" Value="@_estado" ValueChanged="v=>_estado=v ?? string.Empty" Options="@Estados" Disabled="@_busy" />
        <AlfaInput Label="Buscar en ambas listas" Value="@_buscar" ValueChanged="v=>_buscar=v ?? string.Empty" MaxLength="150" Disabled="@_busy" />
        <AlfaSelect Label="Movimiento" Value="@_sentido" ValueChanged="v=>_sentido=v ?? string.Empty" Options="@Sentidos" Disabled="@_busy" />
        <AlfaInput Label="Importe desde (valor absoluto)" Type="number" Step="any" Value="@_minimo" ValueChanged="v=>_minimo=v ?? string.Empty" Disabled="@_busy" />
        <AlfaInput Label="Importe hasta (valor absoluto)" Type="number" Step="any" Value="@_maximo" ValueChanged="v=>_maximo=v ?? string.Empty" Disabled="@_busy" />
        <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="LimpiarFiltros" Disabled="@_busy">Limpiar filtros</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" OnClick="Consultar" Disabled="@_busy">Comparar</AlfaButton>
    </div>
    <AlfaFeedbackPanel Message="@_feedback" />
    @if (_busy) { <p role="status">Procesando conciliación…</p> }
    @if (_datos is { } datos && _aplicado is { } filtro)
    {
        <p>Cuenta <strong>@filtro.Cuenta</strong> · @filtro.Desde.ToString("dd/MM/yyyy") al @filtro.Hasta.ToString("dd/MM/yyyy") · Pesos · Todas las importaciones de esta cuenta</p>
        <p>Movimientos del período: banco <strong>@Dinero(datos.Resumen.TotalBanco)</strong> · Alfa <strong>@Dinero(datos.Resumen.TotalAlfa)</strong> · Diferencia <strong>@Dinero(datos.Resumen.TotalBanco-datos.Resumen.TotalAlfa)</strong>.</p>
        <p>Son totales de movimientos importados y contables autorizados, sin saldos iniciales ni cierre de período. Las sugerencias comparan importe, sentido y fechas con margen de @datos.Resumen.Dias días; requieren tu confirmación.</p>
        @if (FiltrosModificados) { <p role="status">Hay filtros modificados. Pulsá Comparar para aplicarlos antes de seleccionar movimientos.</p> }
        <div class="conciliacion-comparacion__seleccion">
            <span><strong>@datos.Propuestas.Count coincidencias únicas</strong> en todo el resultado filtrado, incluidas otras páginas.</span>
            <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@(_busy||FiltrosModificados||datos.Propuestas.Count==0)" OnClick="AbrirPropuestas">Revisar propuestas del período</AlfaButton>
        </div>
        <div class="conciliacion-comparacion__seleccion">
            <span>Seleccionados: banco @_banco.Count · <strong>@Dinero(TotalBanco)</strong></span>
            <span>Alfa @_alfa.Count · <strong>@Dinero(TotalAlfa)</strong></span>
            <span>Diferencia: <strong>@Dinero(TotalBanco-TotalAlfa)</strong></span>
            <AlfaButton Variant="AlfaButtonVariant.Primary" Disabled="@(!PuedeConciliar)" OnClick="()=>_confirmar=true">Conciliar selección</AlfaButton>
            <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_busy" OnClick="LimpiarSeleccion">Limpiar selección</AlfaButton>
        </div>
        <div class="conciliacion-comparacion__listas">
            <section class="conciliacion-comparacion__lista" aria-label="Movimientos del banco">
                <h3>Banco · extractos importados</h3>
                <div class="conciliacion-comparacion__orden">
                    <AlfaSelect Label="Ordenar banco por" Value="@filtro.OrdenBanco" ValueChanged="v=>Ordenar(true,v ?? string.Empty)" Options="@OrdenBanco" Disabled="@(_busy||FiltrosModificados)" />
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="()=>InvertirOrden(true)" Disabled="@(_busy||FiltrosModificados)">@(filtro.DescBanco ? "Descendente ↓" : "Ascendente ↑")</AlfaButton>
                </div>
                <div class="conciliacion-comparacion__scroll"><table>
                    <thead><tr><th>Elegir</th><th>Fecha / referencia</th><th>Descripción</th><th>Importe</th><th>Estado / acciones</th></tr></thead>
                    <tbody>@foreach(var b in datos.Banco)
                    {
                        <tr class="@(_banco.ContainsKey(b.Id) ? "is-selected" : null)">
                            <td><AlfaCheckbox Value="@_banco.ContainsKey(b.Id)" ValueChanged="v=>ElegirBanco(b,v==true)" Disabled="@(_busy||FiltrosModificados||b.ConciliacionId.HasValue)"><span class="visually-hidden">Seleccionar #@b.Id</span></AlfaCheckbox></td>
                            <td>@b.Fecha.ToString("dd/MM/yyyy")<br />@b.Referencia</td><td>@b.Detalle</td><td class="numero">@Dinero(b.Importe)</td>
                            <td>@(b.ConciliacionId.HasValue ? $"Conciliado #{b.ConciliacionId}" : "Pendiente")
                                @if(b.Alterado) { <strong>Datos modificados: revisar</strong> }
                                <small>Registración: @b.Registracion</small>
                                @if(datos.Sugerencias.FirstOrDefault(s=>s.MovimientoId==b.Id) is { } s)
                                {
                                    <AlfaButton Variant="AlfaButtonVariant.Secondary" Size="AlfaSize.Sm" Disabled="@(_busy||FiltrosModificados)" OnClick="()=>UsarSugerencia(b,s)">
                                        Proponer @s.Asiento.Comprobante · @s.Candidatos candidato(s)
                                    </AlfaButton>
                                }
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="()=>Historial(b.Id)">Historial</AlfaButton>
                            </td>
                        </tr>
                    }</tbody>
                </table></div>
                @if(datos.Banco.Count==0) { <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin movimientos del banco" Message="Revisá la cuenta, las fechas, los filtros o importá el extracto correspondiente." /> }
                <footer class="alfa-data-view-footer">
                    <span>@datos.Resumen.Banco registros · Página @filtro.PaginaBanco · 50 por página</span>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@(_busy||FiltrosModificados||filtro.PaginaBanco==1)" OnClick="()=>Paginar(true,-1)">Anterior banco</AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@(_busy||FiltrosModificados||filtro.PaginaBanco*50>=datos.Resumen.Banco)" OnClick="()=>Paginar(true,1)">Siguiente banco</AlfaButton>
                </footer>
            </section>
            <section class="conciliacion-comparacion__lista" aria-label="Movimientos registrados en Alfa">
                <h3>Alfa · cuenta bancaria contable</h3>
                <div class="conciliacion-comparacion__orden">
                    <AlfaSelect Label="Ordenar Alfa por" Value="@filtro.OrdenAlfa" ValueChanged="v=>Ordenar(false,v ?? string.Empty)" Options="@OrdenAlfa" Disabled="@(_busy||FiltrosModificados)" />
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" OnClick="()=>InvertirOrden(false)" Disabled="@(_busy||FiltrosModificados)">@(filtro.DescAlfa ? "Descendente ↓" : "Ascendente ↑")</AlfaButton>
                </div>
                <div class="conciliacion-comparacion__scroll"><table>
                    <thead><tr><th>Elegir</th><th>Fecha / comprobante</th><th>Detalle</th><th>Importe</th><th>Conciliación</th></tr></thead>
                    <tbody>@foreach(var a in datos.Alfa)
                    {
                        <tr class="@(_alfa.ContainsKey(a.Clave) ? "is-selected" : null)">
                            <td><AlfaCheckbox Value="@_alfa.ContainsKey(a.Clave)" ValueChanged="v=>ElegirAlfa(a,v==true)" Disabled="@(_busy||FiltrosModificados||a.Legacy||a.ConciliacionId.HasValue||a.Moneda!="1")"><span class="visually-hidden">Seleccionar @a.Comprobante</span></AlfaCheckbox></td>
                            <td>@a.Fecha.ToString("dd/MM/yyyy")<br />@a.Comprobante<small>Unidad @a.Unidad · Moneda @a.Moneda</small></td>
                            <td>@a.Detalle<small>Referencia: @a.Referencia</small></td><td class="numero">@Dinero(a.Importe)</td>
                            <td>@(a.ConciliacionId.HasValue ? $"Conciliado #{a.ConciliacionId}" : a.Legacy ? "Conciliado en Alfa Gestión" : "Pendiente")
                                @if(a.Alterado) { <strong>Datos modificados: revisar</strong> }
                                @if(a.ConciliacionId is { } id) { <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Disabled="@_busy" OnClick="()=>VerVinculo(id)">Ver vínculo</AlfaButton> }
                            </td>
                        </tr>
                    }</tbody>
                </table></div>
                @if(datos.Alfa.Count==0) { <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin movimientos de Alfa" Message="No hay registros para estos filtros y las unidades autorizadas." /> }
                <footer class="alfa-data-view-footer">
                    <span>@datos.Resumen.Alfa registros · Página @filtro.PaginaAlfa · 50 por página</span>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@(_busy||FiltrosModificados||filtro.PaginaAlfa==1)" OnClick="()=>Paginar(false,-1)">Anterior Alfa</AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@(_busy||FiltrosModificados||filtro.PaginaAlfa*50>=datos.Resumen.Alfa)" OnClick="()=>Paginar(false,1)">Siguiente Alfa</AlfaButton>
                </footer>
            </section>
        </div>
    }
    else if(!_busy) { <AlfaEmptyState Title="Comparar banco y Alfa" Message="Elegí la cuenta bancaria y el período. Podés vincular uno o varios movimientos de cada lado por el mismo total." /> }
</section>

<AlfaDialog Open="@_propuestasAbiertas" Title="Propuestas de conciliación del período" Size="AlfaDialogSize.Lg" Loading="@_busy" OnClose="()=>_propuestasAbiertas=false">
    <ChildContent>
        <AlfaFeedbackPanel Message="@_feedback" />
        <p>Misma cuenta, importe y sentido, con una única contraparte dentro del margen de fechas. Cada par tendrá su propio vínculo. Revisá antes de confirmar.</p>
        <p>Seleccionados @_pares.Count · Máximo 100 por lote. Podés repetir con los restantes.</p>
        <div class="conciliacion-comparacion"><div class="conciliacion-comparacion__scroll">
        <table><thead><tr><th>Elegir</th><th>Banco</th><th>Alfa</th><th>Importe</th></tr></thead><tbody>
        @foreach(var p in _datos?.Propuestas ?? [])
        {
            <tr><td><AlfaCheckbox Value="@_pares.ContainsKey(p.Banco.Id)" ValueChanged="v=>ElegirPar(p,v==true)" Disabled="@(_busy||(!_pares.ContainsKey(p.Banco.Id)&&_pares.Count>=100))"><span class="visually-hidden">Seleccionar propuesta #@p.Banco.Id</span></AlfaCheckbox></td>
                <td>@p.Banco.Fecha.ToString("dd/MM/yyyy") · @p.Banco.Detalle<br />@p.Banco.Referencia</td>
                <td>@p.Alfa.Fecha.ToString("dd/MM/yyyy") · @p.Alfa.Comprobante<br />@p.Alfa.Detalle</td><td>@Dinero(p.Banco.Importe)</td></tr>
        }
        </tbody></table></div></div>
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Secondary" OnClick="()=>_propuestasAbiertas=false" Disabled="@_busy">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" OnClick="ConfirmarLote" Disabled="@(_busy||FiltrosModificados||_pares.Count==0)">Confirmar @_pares.Count conciliaciones</AlfaButton>
    </Footer>
</AlfaDialog>

<AlfaDialog Open="@_confirmar" Title="Confirmar conciliación" Size="AlfaDialogSize.Lg" Loading="@_busy" OnClose="()=>_confirmar=false">
    <ChildContent>
        <AlfaFeedbackPanel Message="@_feedback" />
        <p>Cuenta @_aplicado?.Cuenta · Total banco @Dinero(TotalBanco) · Total Alfa @Dinero(TotalAlfa)</p>
        <p>Se vincularán estos movimientos completos y se marcarán conciliados. No se genera un asiento ni una cobranza.</p>
        <h3>Banco</h3>@foreach(var b in _banco.Values) { <p>@b.Fecha.ToString("dd/MM/yyyy") · @b.Detalle · @Dinero(b.Importe)</p> }
        <h3>Alfa</h3>@foreach(var a in _alfa.Values) { <p>@a.Fecha.ToString("dd/MM/yyyy") · @a.Comprobante · @a.Detalle · @Dinero(a.Importe)</p> }
    </ChildContent>
    <Footer>
        <AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@_busy" OnClick="()=>_confirmar=false">Cancelar</AlfaButton>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Disabled="@(!PuedeConciliar)" OnClick="Confirmar">Confirmar conciliación</AlfaButton>
    </Footer>
</AlfaDialog>
<AlfaDialog Open="@_verHistorial" Title="Historial de conciliación" Size="AlfaDialogSize.Lg" Loading="@_busy" OnClose="CerrarHistorial">
    <ChildContent>
        <AlfaFeedbackPanel Message="@_feedback" />
        @if(_historial.Count==0 && _vinculo is null) { <p>Sin conciliaciones registradas en AlfaCore para este movimiento.</p> }
        @foreach(var h in _historial)
        {
            <p>#@h.Id · @(h.Activa ? "Activa" : "Desconciliada") · @h.Usuario · @h.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_busy" OnClick="()=>VerVinculo(h.Id)">Ver</AlfaButton></p>
        }
        @if(_vinculo is { } v)
        {
            <h3>Vínculo #@v.Cabecera.Id · Cuenta @v.Cabecera.Cuenta</h3>
            <p>@(v.Cabecera.Activa ? "Conciliado" : "Desconciliado") · @v.Cabecera.Usuario · @v.Cabecera.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            @foreach(var b in v.Banco) { <p>Banco: @b.Fecha.ToString("dd/MM/yyyy") · @b.Detalle · @Dinero(b.Importe)</p> }
            @foreach(var a in v.Alfa) { <p>Alfa: @a.Fecha.ToString("dd/MM/yyyy") · @a.Comprobante · @a.Detalle · @Dinero(a.Importe)</p> }
            @if(v.Cabecera.Activa)
            {
                <p>Desconciliar libera el grupo completo y conserva su historial. No elimina la registración contable.</p>
                <AlfaInput Label="Motivo para desconciliar" Value="@_motivo" ValueChanged="v=>_motivo=v ?? string.Empty" MaxLength="300" Disabled="@_busy" />
                <AlfaButton Variant="AlfaButtonVariant.Danger" Disabled="@(_busy||_motivo.Trim().Length<3)" OnClick="Desconciliar">Desconciliar este vínculo</AlfaButton>
            }
            else { <p>Motivo: @v.Cabecera.Motivo · @v.Cabecera.UsuarioAnulacion · @v.Cabecera.FechaAnulacionUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p> }
        }
    </ChildContent>
    <Footer><AlfaButton Variant="AlfaButtonVariant.Secondary" Disabled="@_busy" OnClick="CerrarHistorial">Cerrar</AlfaButton></Footer>
</AlfaDialog>

@code {
    [Parameter] public string? CuentaInicial { get; set; }
    private readonly CancellationTokenSource _lifetime=new();
    private bool _busy,_disposed,_confirmar,_verHistorial,_propuestasAbiertas;
    private string _sentido="Todos",_minimo="",_maximo="";
    private readonly Dictionary<long,ConciliacionVincularSolicitud> _pares=[];
    private static readonly IReadOnlyList<AlfaSelectOption> Sentidos=[new("Todos","Todos"),new("Ingresos","Ingresos"),new("Egresos","Egresos")];
    private static readonly IReadOnlyList<AlfaSelectOption> OrdenBanco=[new("Fecha","Fecha"),new("Referencia","Referencia"),new("Detalle","Descripción"),new("Importe","Importe"),new("Estado","Conciliación")];
    private static readonly IReadOnlyList<AlfaSelectOption> OrdenAlfa=[new("Fecha","Fecha"),new("Comprobante","Comprobante"),new("Detalle","Detalle"),new("Referencia","Referencia"),new("Importe","Importe"),new("Estado","Conciliación")];
    private string _cuenta="",_desde=DateTime.Today.AddDays(1-DateTime.Today.Day).ToString("yyyy-MM-dd"),_hasta=DateTime.Today.ToString("yyyy-MM-dd"),_estado="Pendientes",_buscar="",_motivo="";
    private IReadOnlyList<ConciliacionCuenta> _cuentas=[];
    private IReadOnlyList<AlfaSelectOption> OpcionesCuentas=>_cuentas.Where(c=>c.Moneda=="1").Select(c=>new AlfaSelectOption(c.Codigo,$"{c.Codigo} — {c.Descripcion}")).ToList();
    private static readonly IReadOnlyList<AlfaSelectOption> Estados=[new("Pendientes","Pendientes"),new("Conciliados","Conciliados"),new("Todos","Todos")];
    private ConciliacionComparacion? _datos;
    private ConciliacionCompararFiltro? _aplicado;
    private AppUiMessage? _feedback;
    private readonly Dictionary<long,ConciliacionFilaBanco> _banco=[];
    private readonly Dictionary<ConciliacionAsientoClave,ConciliacionFilaAlfa> _alfa=[];
    private IReadOnlyList<ConciliacionVinculoCabecera> _historial=[];
    private ConciliacionVinculoDetalle? _vinculo;
    private long? _historialMovimiento;
    private Guid _operacion=Guid.NewGuid();
    private decimal TotalBanco=>_banco.Values.Sum(b=>b.Importe);
    private decimal TotalAlfa=>_alfa.Values.Sum(a=>a.Importe);
    private bool FiltrosModificados=>_aplicado is { } f && (f.Cuenta!=_cuenta||f.Desde.ToString("yyyy-MM-dd")!=_desde||f.Hasta.ToString("yyyy-MM-dd")!=_hasta||f.Estado!=_estado||f.Buscar!=_buscar||f.Sentido!=_sentido||f.ImporteDesde!=Numero(_minimo)||f.ImporteHasta!=Numero(_maximo));
    private bool PuedeConciliar=>!_busy&&!FiltrosModificados&&_banco.Count is >0 and <=100&&_alfa.Count is >0 and <=100&&TotalBanco!=0&&TotalBanco==TotalAlfa
        &&_banco.Values.All(b=>Math.Sign(b.Importe)==Math.Sign(TotalBanco))&&_alfa.Values.All(a=>Math.Sign(a.Importe)==Math.Sign(TotalBanco));
    protected override Task OnInitializedAsync()=>Ejecutar(async()=>{
        _cuentas=await Servicio.CuentasAsync(_lifetime.Token);
        if(_cuentas.Any(c=>c.Codigo==CuentaInicial&&c.Moneda=="1")) _cuenta=CuentaInicial!;
    });
    private Task Consultar()=>Ejecutar(async()=>{
        if(!DateTime.TryParseExact(_desde,"yyyy-MM-dd",CultureInfo.InvariantCulture,DateTimeStyles.None,out var desde)
            ||!DateTime.TryParseExact(_hasta,"yyyy-MM-dd",CultureInfo.InvariantCulture,DateTimeStyles.None,out var hasta))
        { _feedback=AppUiMessage.Error("Fechas inválidas","Ingresá las fechas desde y hasta.");return; }
        if((!string.IsNullOrWhiteSpace(_minimo)&&Numero(_minimo) is null)||(!string.IsNullOrWhiteSpace(_maximo)&&Numero(_maximo) is null))
        { _feedback=AppUiMessage.Error("Importes inválidos","Ingresá importes numéricos.");return; }
        await Cargar(new(_cuenta,desde,hasta,_estado,_buscar,Sentido:_sentido,ImporteDesde:Numero(_minimo),ImporteHasta:Numero(_maximo)));LimpiarSeleccion();
    });
    private static decimal? Numero(string valor)=>decimal.TryParse(valor,NumberStyles.AllowDecimalPoint|NumberStyles.AllowLeadingSign,CultureInfo.InvariantCulture,out var n) ? n : null;
    private Task LimpiarFiltros() { _buscar="";_sentido="Todos";_minimo=_maximo="";_estado="Pendientes";return Consultar(); }
    private Task Ordenar(bool banco,string columna)=>Ejecutar(async()=>{
        if(_aplicado is not { } f)return;
        await Cargar(banco ? f with{OrdenBanco=columna,PaginaBanco=1} : f with{OrdenAlfa=columna,PaginaAlfa=1});
    });
    private Task InvertirOrden(bool banco)=>Ejecutar(async()=>{
        if(_aplicado is not { } f)return;
        await Cargar(banco ? f with{DescBanco=!f.DescBanco,PaginaBanco=1} : f with{DescAlfa=!f.DescAlfa,PaginaAlfa=1});
    });
    private void AbrirPropuestas()
    {
        _pares.Clear();
        foreach(var p in _datos?.Propuestas.Take(100) ?? []) ElegirPar(p,true);
        _propuestasAbiertas=true;
    }
    private void ElegirPar(ConciliacionPropuesta par,bool elegir)
    {
        if(!elegir) { _pares.Remove(par.Banco.Id);return; }
        if(_aplicado is not { } f||_pares.Count>=100)return;
        _pares[par.Banco.Id]=new(Guid.NewGuid(),f,[new(par.Banco.Id,par.Banco.Huella)],[new(par.Alfa.Clave,par.Alfa.Huella)]);
    }
    private Task ConfirmarLote()=>Ejecutar(async()=>{
        if(_aplicado is not { } f||FiltrosModificados)return;
        var ids=await Servicio.ConciliarLoteAsync(_pares.Values.ToList(),_lifetime.Token);
        _propuestasAbiertas=false;_pares.Clear();LimpiarSeleccion();
        _feedback=AppUiMessage.Success("Conciliaciones confirmadas",$"Se conciliaron {ids.Count} pares. Cada vínculo conserva su historial.");
        await Cargar(f);
    });
    private async Task Cargar(ConciliacionCompararFiltro filtro)
    {
        var datos=await Servicio.CompararAsync(filtro,_lifetime.Token);_lifetime.Token.ThrowIfCancellationRequested();
        _datos=datos;_aplicado=filtro;
    }
    public Task ActualizarAsync()=>Ejecutar(async()=>{if(_aplicado is { } f) { await Cargar(f);LimpiarSeleccion(); }});
    private Task Paginar(bool banco,int delta)=>Ejecutar(async()=>{
        if(_aplicado is not { } f)return;
        await Cargar(banco ? f with{PaginaBanco=f.PaginaBanco+delta} : f with{PaginaAlfa=f.PaginaAlfa+delta});
    });
    private void ElegirBanco(ConciliacionFilaBanco b,bool elegir) { if(elegir)_banco[b.Id]=b;else _banco.Remove(b.Id);_operacion=Guid.NewGuid(); }
    private void ElegirAlfa(ConciliacionFilaAlfa a,bool elegir) { if(elegir)_alfa[a.Clave]=a;else _alfa.Remove(a.Clave);_operacion=Guid.NewGuid(); }
    private void LimpiarSeleccion() { _banco.Clear();_alfa.Clear();_operacion=Guid.NewGuid();_confirmar=false; }
    private void UsarSugerencia(ConciliacionFilaBanco b,ConciliacionSugerencia s)
    { LimpiarSeleccion();ElegirBanco(b,true);ElegirAlfa(s.Asiento,true);_confirmar=true; }
    private Task Confirmar()=>Ejecutar(async()=>{
        if(_aplicado is not { } f)return;
        var id=await Servicio.ConciliarAsync(new(_operacion,f,_banco.Values.Select(b=>new ConciliacionBancoSeleccion(b.Id,b.Huella)).ToList(),
            _alfa.Values.Select(a=>new ConciliacionAlfaSeleccion(a.Clave,a.Huella)).ToList()),_lifetime.Token);
        LimpiarSeleccion();_feedback=AppUiMessage.Success("Conciliación confirmada",$"Vínculo #{id} registrado.");
        await Cargar(f);
    });
    private Task Historial(long movimientoId)=>Ejecutar(async()=>{
        var h=await Servicio.HistorialBancoAsync(movimientoId,_lifetime.Token);_lifetime.Token.ThrowIfCancellationRequested();
        _historial=h;_historialMovimiento=movimientoId;_vinculo=null;_motivo="";_verHistorial=true;
        if(h.FirstOrDefault() is { } v)_vinculo=await Servicio.VinculoAsync(v.Id,_lifetime.Token);
    });
    private Task VerVinculo(long id)=>Ejecutar(async()=>{
        var v=await Servicio.VinculoAsync(id,_lifetime.Token);_lifetime.Token.ThrowIfCancellationRequested();
        _vinculo=v;_motivo="";_verHistorial=true;
    });
    private void CerrarHistorial() { _verHistorial=false;_historial=[];_vinculo=null;_historialMovimiento=null;_motivo=""; }
    private Task Desconciliar()=>Ejecutar(async()=>{
        if(_vinculo is not { } v)return;
        await Servicio.DesconciliarAsync(v.Cabecera.Id,_motivo,_lifetime.Token);
        _vinculo=await Servicio.VinculoAsync(v.Cabecera.Id,_lifetime.Token);
        if(_historialMovimiento is { } m)_historial=await Servicio.HistorialBancoAsync(m,_lifetime.Token);
        if(_aplicado is { } f)await Cargar(f);LimpiarSeleccion();
        _feedback=AppUiMessage.Success("Vínculo desconciliado","Las registraciones contables se conservan.");
    });
    private async Task Ejecutar(Func<Task> action)
    {
        if(_busy||_disposed)return;_busy=true;_feedback=null;
        try { await action(); }
        catch(OperationCanceledException) { }
        catch(Exception ex) { if(!_disposed)_feedback=UiOps.BuildMessage(ex,"Conciliación bancaria"); }
        finally { _busy=false;if(!_disposed)await InvokeAsync(StateHasChanged); }
    }
    private static string Dinero(decimal valor)=>valor.ToString(valor==decimal.Round(valor,2) ? "N2" : "N4",CultureInfo.GetCultureInfo("es-AR"));
    public void Dispose() { _disposed=true;_lifetime.Cancel();_lifetime.Dispose(); }
