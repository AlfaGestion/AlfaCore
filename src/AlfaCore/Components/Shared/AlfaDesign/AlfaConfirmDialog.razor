@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Open)
{
    <div class="alfa-confirm-dialog__backdrop" @onclick="CancelAsync">
        <section class="alfa-confirm-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@_titleId"
                 aria-describedby="@_descriptionId"
                 @ref="_dialog"
                 @onclick:stopPropagation="true">
            <header class="alfa-confirm-dialog__header">
                <span class="alfa-confirm-dialog__icon alfa-confirm-dialog__icon--danger" aria-hidden="true">
                    <i class="bi bi-person-dash"></i>
                </span>
                <div>
                    <span class="alfa-confirm-dialog__eyebrow">Confirmación</span>
                    <h2 id="@_titleId">@Title</h2>
                </div>
            </header>

            <div id="@_descriptionId" class="alfa-confirm-dialog__body">
                <p>@Message</p>
                @if (!string.IsNullOrWhiteSpace(SecondaryMessage))
                {
                    <p class="alfa-confirm-dialog__secondary">@SecondaryMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="alfa-confirm-dialog__error" role="alert" aria-live="assertive">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>@ErrorMessage</span>
                    </div>
                }
            </div>

            <footer class="alfa-confirm-dialog__actions">
                <button type="button"
                        class="alfa-confirm-dialog__button alfa-confirm-dialog__button--cancel"
                        @ref="_cancelButton"
                        disabled="@Loading"
                        @onclick="CancelAsync">
                    @CancelLabel
                </button>
                <button type="button"
                        class="alfa-confirm-dialog__button alfa-confirm-dialog__button--danger"
                        disabled="@Loading"
                        @onclick="ConfirmAsync">
                    @if (Loading)
                    {
                        <span class="alfa-confirm-dialog__spinner" aria-hidden="true"></span>
                    }
                    <span>@(Loading ? LoadingLabel : ConfirmLabel)</span>
                </button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter] public string SecondaryMessage { get; set; } = string.Empty;
    [Parameter] public string ConfirmLabel { get; set; } = "Confirmar";
    [Parameter] public string CancelLabel { get; set; } = "Cancelar";
    [Parameter] public string LoadingLabel { get; set; } = "Procesando...";
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly string _titleId = $"alfa-confirm-title-{Guid.NewGuid():N}";
    private readonly string _descriptionId = $"alfa-confirm-description-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private ElementReference _cancelButton;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AlfaConfirmDialog>? _selfReference;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_wasOpen)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/alfa-confirm-dialog.js");
            _selfReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("activate", _dialog, _cancelButton, _selfReference);
        }
        else if (!Open && _wasOpen && _module is not null)
        {
            await _module.InvokeVoidAsync("deactivate", _dialog);
        }

        _wasOpen = Open;
    }

    private Task ConfirmAsync()
        => Loading ? Task.CompletedTask : OnConfirm.InvokeAsync();

    private Task CancelAsync()
        => Loading ? Task.CompletedTask : OnCancel.InvokeAsync();

    [JSInvokable]
    public Task RequestCancelAsync()
        => CancelAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("deactivate", _dialog);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
