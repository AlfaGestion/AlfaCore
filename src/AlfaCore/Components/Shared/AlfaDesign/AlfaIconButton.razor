<button class="@CssClass"
        type="button"
        title="@TooltipText"
        aria-label="@Label"
        aria-pressed="@(Active ? "true" : null)"
        disabled="@Disabled"
        @onclick="HandleClickAsync">
    <i class="@Icon" aria-hidden="true"></i>
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public AlfaSize Size { get; set; } = AlfaSize.Md;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string TooltipText => string.IsNullOrWhiteSpace(Tooltip) ? Label : Tooltip;

    private string CssClass
        => string.Join(" ", new[]
        {
            "alfa-icon-button",
            $"alfa-icon-button--{Size.ToString().ToLowerInvariant()}",
            Active ? "is-active" : null,
            Class
        }.Where(static x => !string.IsNullOrWhiteSpace(x)));

    private async Task HandleClickAsync(MouseEventArgs args)
    {
        if (!Disabled && OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }
}
