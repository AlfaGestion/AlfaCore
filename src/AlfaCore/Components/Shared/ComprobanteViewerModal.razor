@* Detalle de comprobante sobre la ventana estándar AlfaDesign (AlfaDialog), igual que ComprobanteVerHost.
   Se conserva el componente por su API (Ver comprobantes, informe de Punto de Venta). *@
<AlfaDialog Open="@Visible" Title="@($"Detalle del comprobante {Tc} {IdComprobante}".Trim())" Size="AlfaDialogSize.Xl" OnClose="CerrarAsync">
    @if (Visible)
    {
        <ComprobanteViewer @key="(Tc, IdComprobante, IdComplemento)" Tc="@Tc" IdComprobante="@IdComprobante" IdComplemento="@IdComplemento" ModoDetalleCompleto="true" />
    }
</AlfaDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Tc { get; set; } = string.Empty;
    [Parameter] public string IdComprobante { get; set; } = string.Empty;
    [Parameter] public int IdComplemento { get; set; }
    [Parameter] public string? Cliente { get; set; }
    [Parameter] public EventCallback Cerrado { get; set; }

    private async Task CerrarAsync()
    {
        if (Cerrado.HasDelegate)
            await Cerrado.InvokeAsync();
    }
}
