@using AlfaCore.Models
@inject AlfaCore.Services.IAppModeService AppMode

@if (Open)
{
    <div class="drawer-overlay app-login-overlay"></div>

    <div class="app-login-modal" role="dialog" aria-label="Ingreso al sistema">
        <div class="app-login-modal__header">
            <div>
                <p class="shell__eyebrow">Alfa Gestión</p>
                <h2 class="app-login-modal__title">Ingresar a la base activa</h2>
            </div>
        </div>

        <div class="app-login-modal__body">
            <div class="usuarios-empty">
                <strong>Base activa</strong>
                <p>@SqlSessionLabel</p>
                <small>Si cambiás de base, se cierra la sesión funcional actual y tenés que volver a ingresar.</small>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="editor-msg editor-msg--error">
                    <div>
                        <strong>No se pudo iniciar sesión</strong>
                        <p>@ErrorMessage</p>
                    </div>
                </div>
            }

            @if (AppMode.IsSaaSMode)
            {
                <div class="field">
                    <label>Usuario del sistema</label>
                    <div class="app-login-userlist" role="listbox" aria-label="Usuarios del sistema">
                        @if (UserOptions.Count > 0)
                        {
                            <select class="app-login-userlist__select"
                                    size="8"
                                    value="@UserName"
                                    @onchange="OnUserSelectChanged"
                                    disabled="@IsBusy"
                                    aria-label="Lista de usuarios del sistema">
                                <option value="">-- Seleccioná un usuario --</option>
                                @foreach (var user in UserOptions)
                                {
                                    <option value="@user.Nombre">@user.Nombre</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="app-login-userlist__empty">Sin usuarios disponibles</div>
                        }
                    </div>
                    @if (UseUserList)
                    {
                        <button type="button"
                                class="app-login-userlist__manual"
                                @onclick="EnableManualEntryAsync"
                                disabled="@IsBusy">
                            Escribir otro usuario
                        </button>
                    }
                    else
                    {
                        <div class="app-login-userlist__manual-row">
                            <input value="@UserName"
                                   @oninput="OnUserNameInput"
                                   placeholder="Ej: albert"
                                   disabled="@IsBusy" />
                            <button type="button"
                                    class="app-login-userlist__manual"
                                    @onclick="EnableManualEntryAsync"
                                    disabled="@IsBusy">
                                Volver a la lista
                            </button>
                        </div>
                    }
                </div>

                <div class="field">
                    <label>Contraseña</label>
                    <div class="drawer-new__password">
                        <input type="@(ShowPassword ? "text" : "password")"
                               value="@Password"
                               @oninput="OnPasswordInput"
                               @onkeydown="OnPasswordKeyDownAsync"
                               placeholder="Contraseña"
                               disabled="@IsBusy" />
                        <button type="button"
                                class="drawer-new__eye"
                                @onclick="TogglePassword"
                                title="@(ShowPassword ? "Ocultar" : "Mostrar")"
                                disabled="@IsBusy">
                            <i class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <label class="toggle-row toggle-row--compact">
                    <input type="checkbox"
                           checked="@RememberCredentials"
                           @onchange="OnRememberCredentialsChangedAsync"
                           disabled="@IsBusy" />
                    <span>Recordar usuario y contraseña en este equipo</span>
                </label>
            }
            else
            {
                <div class="field">
                    <label>Usuario</label>
                    <input value="@UserName"
                           @oninput="OnUserNameInput"
                           placeholder="Ej: albert"
                           disabled="@IsBusy" />
                </div>

                <div class="field">
                    <label>Contraseña</label>
                    <div class="drawer-new__password">
                        <input type="@(ShowPassword ? "text" : "password")"
                               value="@Password"
                               @oninput="OnPasswordInput"
                               @onkeydown="OnPasswordKeyDownAsync"
                               placeholder="Contraseña"
                               disabled="@IsBusy" />
                        <button type="button"
                                class="drawer-new__eye"
                                @onclick="TogglePassword"
                                title="@(ShowPassword ? "Ocultar" : "Mostrar")"
                                disabled="@IsBusy">
                            <i class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>
            }

            <div class="actions app-login-modal__actions">
                <button type="button" class="btn btn--primary" @onclick="SubmitAsync" disabled="@IsBusy">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>@(IsBusy ? "Ingresando..." : "Ingresar")</span>
                </button>
                @if (AppMode.IsSaaSMode)
                {
                    <button type="button" class="btn btn--ghost" @onclick="OpenSqlSessionsAsync" disabled="@IsBusy">
                        <i class="bi bi-database"></i>
                        <span>Cambiar base</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string SqlSessionLabel { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool ShowPassword { get; set; }
    [Parameter] public bool RememberCredentials { get; set; }
    [Parameter] public IReadOnlyList<UsuarioSistemaDto> UserOptions { get; set; } = [];
    [Parameter] public bool UseUserList { get; set; } = true;
    [Parameter] public EventCallback<string> UserNameChanged { get; set; }
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowPasswordChanged { get; set; }
    [Parameter] public EventCallback<bool> RememberCredentialsChanged { get; set; }
    [Parameter] public EventCallback<bool> UseUserListChanged { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnOpenSqlSessions { get; set; }

    private async Task SubmitAsync() => await OnSubmit.InvokeAsync();

    private async Task OpenSqlSessionsAsync() => await OnOpenSqlSessions.InvokeAsync();

    private async Task TogglePassword()
        => await ShowPasswordChanged.InvokeAsync(!ShowPassword);

    private async Task OnUserNameInput(ChangeEventArgs args)
        => await UserNameChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private async Task OnUserSelectChanged(ChangeEventArgs args)
    {
        var userName = args.Value?.ToString() ?? string.Empty;
        await UserNameChanged.InvokeAsync(userName);
        await UseUserListChanged.InvokeAsync(true);
    }

    private async Task EnableManualEntryAsync()
    {
        await UseUserListChanged.InvokeAsync(false);
        await UserNameChanged.InvokeAsync(string.Empty);
    }

    private async Task OnPasswordInput(ChangeEventArgs args)
        => await PasswordChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private async Task OnRememberCredentialsChangedAsync(ChangeEventArgs args)
        => await RememberCredentialsChanged.InvokeAsync(args.Value is bool value && value);

    private async Task OnPasswordKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
            await SubmitAsync();
    }
}
