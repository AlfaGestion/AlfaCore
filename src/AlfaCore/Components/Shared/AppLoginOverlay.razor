@inject AlfaCore.Services.IAppModeService AppMode

@if (Open)
{
    <div class="drawer-overlay app-login-overlay"></div>

    <div class="auth-shell auth-shell--selection app-login-modal app-login-modal--compact" role="dialog" aria-label="Ingreso al sistema">
        <aside class="auth-hero" aria-hidden="true">
            <div class="auth-hero__brand">
                <img class="central-brand-logo central-login-logo"
                     src="@AlfaCore.Components.Shared.AuthThemeAssets.GetLoginLogo(DarkTheme)"
                     alt="Alfa Gestion"
                     loading="eager"
                     decoding="async" />
            </div>

            <div class="auth-hero__copy">
                <h2 class="auth-hero__title">Acceso directo al sistema</h2>
                <p class="auth-hero__text">
                    Ingresa con tu usuario y contrasena para entrar a la base activa.
                </p>
            </div>

            <div class="auth-hero__note">
                El contexto de base se mantiene visible para evitar errores de acceso.
            </div>
        </aside>

        <section class="auth-form-panel auth-form-panel--selection">
            <div class="auth-form-panel__surface auth-form-panel__surface--selection">
                <header class="auth-form-panel__header">
                    <p class="auth-card__eyebrow">Alfa Gestion</p>
                    <h2 class="auth-card__title">Ingresar</h2>
                    <p class="auth-card__subtitle">Ingresa con tu usuario y contrasena para entrar a la base activa.</p>
                </header>

                <div class="auth-legacy-login__selected-row">
                    <div class="auth-legacy-login__selected app-login-session-note">
                        <div class="auth-legacy-login__selected-icon" aria-hidden="true">
                            <i class="bi bi-database-fill"></i>
                        </div>
                        <div class="auth-legacy-login__selected-body">
                            <strong>Base activa</strong>
                            <p>@SqlSessionLabel</p>
                            <small>Si cambias de base, se cierra la sesion funcional actual y tenes que volver a ingresar.</small>
                        </div>
                    </div>

                    @if (AppMode.IsSaaSMode)
                    {
                        <button type="button"
                                class="btn btn--ghost auth-legacy-login__selected-action"
                                @onclick="OpenSqlSessionsAsync"
                                disabled="@IsBusy">
                            <i class="bi bi-database"></i>
                            <span>Cambiar base</span>
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="editor-msg editor-msg--error">
                        <div>
                            <strong>No se pudo iniciar sesion</strong>
                            <p>@ErrorMessage</p>
                        </div>
                    </div>
                }

                <div class="field">
                    <label>Usuario</label>
                    <input class="central-login-input"
                           value="@UserName"
                           @oninput="OnUserNameInput"
                           placeholder="Ej: albert"
                           disabled="@IsBusy"
                           autocomplete="username" />
                </div>

                <div class="field">
                    <label>Contrasena</label>
                    <div class="central-login-password drawer-new__password">
                        <input class="central-login-input central-login-password__input"
                               type="@(ShowPassword ? "text" : "password")"
                               value="@Password"
                               @oninput="OnPasswordInput"
                               @onkeydown="OnPasswordKeyDownAsync"
                               placeholder="Contrasena"
                               disabled="@IsBusy"
                               autocomplete="current-password" />
                        <button type="button"
                                class="drawer-new__eye central-login-password__toggle"
                                @onclick="TogglePassword"
                                title="@(ShowPassword ? "Ocultar" : "Mostrar")"
                                disabled="@IsBusy">
                            <i class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <label class="toggle-row toggle-row--compact">
                    <input type="checkbox"
                           checked="@RememberCredentials"
                           @onchange="OnRememberCredentialsChangedAsync"
                           disabled="@IsBusy" />
                    <span>Recordar usuario y contrasena en este equipo</span>
                </label>

                <div class="actions app-login-modal__actions auth-legacy-login__actions">
                    <button type="button" class="btn btn--primary auth-card__submit" @onclick="SubmitAsync" disabled="@IsBusy">
                        @if (IsBusy)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right"></i>
                        }
                        <span>@(IsBusy ? "Ingresando..." : "Ingresar")</span>
                    </button>
                </div>

                <button type="button"
                        class="btn btn--ghost auth-legacy-login__logout"
                        @onclick="LogoutAsync"
                        disabled="@IsBusy">
                    <i class="bi bi-person-circle"></i>
                    <span>Cambiar usuario</span>
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool DarkTheme { get; set; }
    [Parameter] public string SqlSessionLabel { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool ShowPassword { get; set; }
    [Parameter] public bool RememberCredentials { get; set; }
    [Parameter] public EventCallback<string> UserNameChanged { get; set; }
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowPasswordChanged { get; set; }
    [Parameter] public EventCallback<bool> RememberCredentialsChanged { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnOpenSqlSessions { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    private async Task SubmitAsync() => await OnSubmit.InvokeAsync();

    private async Task OpenSqlSessionsAsync() => await OnOpenSqlSessions.InvokeAsync();

    private async Task LogoutAsync() => await OnLogout.InvokeAsync();

    private async Task TogglePassword()
        => await ShowPasswordChanged.InvokeAsync(!ShowPassword);

    private async Task OnUserNameInput(ChangeEventArgs args)
        => await UserNameChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private async Task OnPasswordInput(ChangeEventArgs args)
        => await PasswordChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private async Task OnRememberCredentialsChangedAsync(ChangeEventArgs args)
        => await RememberCredentialsChanged.InvokeAsync(args.Value is bool value && value);

    private async Task OnPasswordKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
            await SubmitAsync();
    }
}
