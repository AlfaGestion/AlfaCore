@using AlfaCore.Models
@using AlfaCore.Components.Shared.AlfaDesign

<article class="portal-cliente__account-row">
    <div class="portal-cliente__account-row-main">
        <div class="portal-cliente__account-row-title">
            <strong>@(string.IsNullOrWhiteSpace(Item.TcDescripcion) ? Item.Tc : Item.TcDescripcion) @Item.Sucursal-@Item.Numero@(string.IsNullOrWhiteSpace(Item.Letra) ? "" : $" {Item.Letra}")</strong>
            <div class="portal-cliente__account-row-tags">
                @if (Item.EstaVencido)
                {
                    <AlfaTag Tone="AlfaTagTone.Danger">Vencido</AlfaTag>
                }
                else
                {
                    <AlfaTag Tone="AlfaTagTone.Warning">A vencer</AlfaTag>
                }
            </div>
        </div>

        <span class="portal-cliente__account-row-date">Fecha @Item.Fecha.ToString("dd/MM/yyyy") · Vence @Item.Vencimiento.ToString("dd/MM/yyyy")</span>
    </div>

    <div class="portal-cliente__account-row-side">
        <div class="portal-cliente__account-row-amounts">
            @if (Item.ImporteOriginal is { } importe)
            {
                <span class="portal-cliente__account-row-original">Original @Money(importe)</span>
            }
            <strong>@Money(Item.Saldo)</strong>
        </div>

        @if (Item.IdComprobante is { } idComprobante)
        {
            <a class="portal-cliente__account-row-action" href="@DetalleUrlBuilder(idComprobante)">
                <i class="bi bi-eye"></i> Ver detalle
            </a>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public PortalClienteComprobantePendienteDto Item { get; set; } = null!;
    [Parameter, EditorRequired] public Func<int, string> DetalleUrlBuilder { get; set; } = null!;

    private static string Money(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
