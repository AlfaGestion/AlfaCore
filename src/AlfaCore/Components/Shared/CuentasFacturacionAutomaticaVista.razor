@using AlfaCore.Models
@* Vistas fijas de facturación automática de la lista de clientes (iguales a las del VB6).
   Doble clic o el botón de la fila abren la ficha en la solapa Facturación automática. *@

<div class="gd fa-vista">
    @if (PorConcepto)
    {
        <DataTable Titulo="Datos de facturación automática"
                   Subtitulo="@($"{Filas.Count} concepto(s) de {Filas.Select(f => f.Codigo).Distinct().Count()} cliente(s) con facturación activa · el importe anterior es el previo al último cambio")">
            <Header>
                <tr>
                    <th>@RenderTodos()</th>
                    @Th("codigo", "Código")
                    @Th("cliente", "Cliente")
                    @Th("detalle", "Detalle")
                    @Th("importe", "Importe", true)
                    @Th("anterior", "Importe anterior", true)
                    @Th("cambio", "Cambio")
                    @Th("cuota", "Cuota", true)
                    @Th("periodicidad", "Periodicidad")
                    @Th("tc", "TC")
                    @Th("unegocio", "U. negocio")
                    @Th("ultmov", "Últ. mov.")
                    <th></th>
                </tr>
            </Header>
            <Rows>
                @if (Filas.Count == 0)
                {
                    <tr><td colspan="13"><AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin conceptos" Message="No hay clientes con facturación automática activa para esta búsqueda." /></td></tr>
                }
                else
                {
                    @foreach (var fila in Ordenadas)
                    {
                        <tr class="fa-vista__fila @(fila.SeFactura ? string.Empty : "is-cumplido")" @ondblclick="() => OnAbrir.InvokeAsync(fila.Codigo)" title="@(fila.SeFactura ? "Doble clic para abrir la ficha" : "Cuotas cumplidas: ya no se factura")">
                            <td>@RenderMarca(fila.Codigo)</td>
                            <td>@fila.CtaCodigo</td>
                            <td><strong>@fila.RazonSocial</strong></td>
                            <td>@fila.Detalle</td>
                            <td style="text-align:right;">@Moneda(fila.Importe)</td>
                            <td style="text-align:right;">@Moneda(fila.ImporteAnterior)</td>
                            <td>@Fecha(fila.FechaCambio)</td>
                            <td style="text-align:right;">@(fila.Cuotas > 0 ? $"{fila.Cuota}/{fila.Cuotas}" : "")</td>
                            <td>@fila.Periodicidad</td>
                            <td>@fila.TC</td>
                            <td>@fila.UnidadNegocio</td>
                            <td>@Fecha(fila.FechaUltMov)</td>
                            <td>@RenderAbrir(fila.Codigo)</td>
                        </tr>
                    }
                    <tr class="data-table__totals">
                        <td colspan="4" class="gd-totals-label">Total (@Filas.Count conceptos)</td>
                        <td style="text-align:right;">@Moneda(Filas.Sum(f => f.Importe))</td>
                        <td style="text-align:right;">@Moneda(Filas.Sum(f => f.ImporteAnterior))</td>
                        <td colspan="7"></td>
                    </tr>
                }
            </Rows>
        </DataTable>
    }
    else
    {
        <DataTable Titulo="Facturación automática por cliente"
                   Subtitulo="@($"{Filas.Count} cliente(s) con facturación activa · Abono = líneas con <PERIODO> · Total = lo que se factura por período (sin cuotas cumplidas)")">
            <Header>
                <tr>
                    <th>@RenderTodos()</th>
                    @Th("codigo", "Código")
                    @Th("cliente", "Cliente")
                    @Th("contacto", "Contacto")
                    @Th("ultmov", "Últ. mov.")
                    @Th("periodicidad", "Periodicidad")
                    @Th("tc", "TC")
                    @Th("unegocio", "U. negocio")
                    @Th("vendedor", "Vendedor")
                    @Th("abono", "Abono", true)
                    @Th("otros", "Otros", true)
                    @Th("total", "Total", true)
                    @Th("conceptos", "Conceptos", true)
                    <th></th>
                </tr>
            </Header>
            <Rows>
                @if (Filas.Count == 0)
                {
                    <tr><td colspan="14"><AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin clientes" Message="No hay clientes con facturación automática activa para esta búsqueda." /></td></tr>
                }
                else
                {
                    @foreach (var fila in Ordenadas)
                    {
                        <tr class="fa-vista__fila" @ondblclick="() => OnAbrir.InvokeAsync(fila.Codigo)" title="Doble clic para abrir la ficha">
                            <td>@RenderMarca(fila.Codigo)</td>
                            <td>@fila.CtaCodigo</td>
                            <td><strong>@fila.RazonSocial</strong></td>
                            <td>@fila.Contacto</td>
                            <td>@Fecha(fila.FechaUltMov)</td>
                            <td>@fila.Periodicidad</td>
                            <td>@fila.TC</td>
                            <td>@fila.UnidadNegocio</td>
                            <td>@(string.IsNullOrWhiteSpace(fila.VendedorNombre) ? fila.VendedorCodigo : $"{fila.VendedorCodigo} · {fila.VendedorNombre}")</td>
                            <td style="text-align:right;">@Moneda(fila.Abono)</td>
                            <td style="text-align:right;">@Moneda(fila.Otros)</td>
                            <td style="text-align:right;"><strong>@Moneda(fila.Total)</strong></td>
                            <td style="text-align:right;">@fila.Conceptos</td>
                            <td>@RenderAbrir(fila.Codigo)</td>
                        </tr>
                    }
                    <tr class="data-table__totals">
                        <td colspan="9" class="gd-totals-label">Total (@Filas.Count clientes)</td>
                        <td style="text-align:right;">@Moneda(Filas.Sum(f => f.Abono))</td>
                        <td style="text-align:right;">@Moneda(Filas.Sum(f => f.Otros))</td>
                        <td style="text-align:right;">@Moneda(Filas.Sum(f => f.Total))</td>
                        <td colspan="2"></td>
                    </tr>
                }
            </Rows>
        </DataTable>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<FacturacionAutomaticaVistaFilaDto> Filas { get; set; } = [];
    [Parameter] public bool PorConcepto { get; set; }
    [Parameter] public EventCallback<string> OnAbrir { get; set; }
    /// <summary>Códigos seleccionados (compartido con la página, para las acciones por lote).</summary>
    [Parameter] public HashSet<string>? Seleccion { get; set; }
    [Parameter] public EventCallback OnSeleccionCambiada { get; set; }

    // Se selecciona el cliente: en la vista por concepto marcar una línea marca todas las de ese cliente.
    private bool Marcado(string codigo) => Seleccion?.Contains(codigo) == true;
    private bool TodosMarcados => Seleccion is not null && Filas.Count > 0 && Filas.All(f => Seleccion.Contains(f.Codigo));

    private Task Marcar(string codigo, bool valor)
    {
        if (Seleccion is null) return Task.CompletedTask;
        if (valor) Seleccion.Add(codigo); else Seleccion.Remove(codigo);
        return OnSeleccionCambiada.InvokeAsync();
    }

    private Task MarcarTodos(bool valor)
    {
        if (Seleccion is null) return Task.CompletedTask;
        foreach (var codigo in Filas.Select(f => f.Codigo).Distinct())
            if (valor) Seleccion.Add(codigo); else Seleccion.Remove(codigo);
        return OnSeleccionCambiada.InvokeAsync();
    }

    private RenderFragment RenderTodos() => @<AlfaCheckbox Value="@TodosMarcados" ValueChanged="v => MarcarTodos(v == true)">Todos</AlfaCheckbox>;

    private RenderFragment RenderMarca(string codigo) => @<span @ondblclick:stopPropagation="true"><AlfaCheckbox Value="@Marcado(codigo)" AriaLabel="@($"Seleccionar cliente {codigo}")" ValueChanged="v => Marcar(codigo, v == true)" /></span>;

    // ── Orden por columna (en pantalla: la vista trae todas las filas) ───────────
    // Clic: ascendente → descendente → orden original de la consulta.
    private string _ordenColumna = string.Empty;
    private bool _ordenDesc;

    private void Ordenar(string columna)
    {
        if (_ordenColumna != columna) { _ordenColumna = columna; _ordenDesc = false; }
        else if (!_ordenDesc) _ordenDesc = true;
        else { _ordenColumna = string.Empty; _ordenDesc = false; }
    }

    private IEnumerable<FacturacionAutomaticaVistaFilaDto> Ordenadas
    {
        get
        {
            Func<FacturacionAutomaticaVistaFilaDto, object>? clave = _ordenColumna switch
            {
                "codigo" => f => f.CtaCodigo,
                "cliente" => f => f.RazonSocial,
                "contacto" => f => f.Contacto,
                "detalle" => f => f.Detalle,
                "importe" => f => f.Importe,
                "anterior" => f => f.ImporteAnterior,
                "cambio" => f => f.FechaCambio ?? DateTime.MinValue,
                "cuota" => f => f.Cuota,
                "periodicidad" => f => f.Periodicidad,
                "tc" => f => f.TC,
                "unegocio" => f => f.UnidadNegocio,
                "ultmov" => f => f.FechaUltMov ?? DateTime.MinValue,
                "vendedor" => f => f.VendedorNombre,
                "abono" => f => f.Abono,
                "otros" => f => f.Otros,
                "total" => f => f.Total,
                "conceptos" => f => f.Conceptos,
                _ => null
            };
            if (clave is null)
                return Filas;
            return _ordenDesc ? Filas.OrderByDescending(clave) : Filas.OrderBy(clave);
        }
    }

    private RenderFragment Th(string columna, string titulo, bool derecha = false) => @<th style="@(derecha ? "text-align:right;" : null)" aria-sort="@(_ordenColumna == columna ? (_ordenDesc ? "descending" : "ascending") : "none")">
        @* Clase global table-sort: sticky-list-headers.js copia el encabezado fuera de este componente y
           los estilos aislados no llegan a esa copia (los botones se veían como botones comunes). *@
        <button type="button" class="table-sort @(_ordenColumna == columna ? "is-active" : null)" title="@($"Ordenar por {titulo}")" @onclick="() => Ordenar(columna)">
            <span class="table-sort__label">@titulo</span>
            <i class="table-sort__icon bi @(_ordenColumna != columna ? "bi-arrow-down-up" : _ordenDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")" aria-hidden="true"></i>
        </button>
    </th>;

    private RenderFragment RenderAbrir(string codigo) => @<AlfaIconButton Icon="bi bi-pencil-square" Label="Abrir ficha" Size="AlfaSize.Sm" OnClick="_ => OnAbrir.InvokeAsync(codigo)" />;

    private static string Moneda(decimal v) => v.ToString("$ #,##0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));

    // Alfa Gestión deja 01/01/1900 cuando nunca facturó.
    private static string Fecha(DateTime? v) => v is { Year: > 1900 } f ? f.ToString("dd/MM/yyyy") : "";
}
