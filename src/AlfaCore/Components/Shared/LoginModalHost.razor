@if (Open)
{
    <div class="drawer-overlay app-login-overlay"></div>

    <div class="@ModalClass"
         role="dialog"
         aria-modal="true"
         aria-label="@AriaLabel"
         tabindex="-1"
         @onkeydown="HandleDialogKeyDownAsync">
        @if (CanClose)
        {
            <button type="button" class="app-login-modal__close" @onclick="CloseAsync" title="Cerrar" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        }

        @ChildContent
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool CanClose { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Modal de inicio de sesión";
    [Parameter] public string ModalClass { get; set; } = "app-login-modal app-login-modal--compact";
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task CloseAsync() => await OnClose.InvokeAsync();

    private async Task HandleDialogKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase) && CanClose)
            await CloseAsync();
    }
}
