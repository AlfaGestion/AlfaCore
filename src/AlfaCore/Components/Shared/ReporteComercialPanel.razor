@inject AlfaCore.Services.ReporteComercialService ReporteService
@inject AlfaCore.Services.ReporteComprasExcelExporter Exporter
@inject AlfaCore.Services.ISessionService Sessions
@inject AlfaCore.Services.IAppUserSessionService Users
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IPageHeaderService PageHeader
@inject AlfaCore.Services.IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Titulo | Alfa Gestión</PageTitle>

<div class="gd-page gd">
    <header class="gd-header">
        <div>
            <h2>@Titulo</h2>
            <p>Resumen, comprobantes y movimientos de cuenta corriente. Incluye proformas; el IVA mostrado es el registrado fiscalmente.</p>
        </div>
    </header>

    <AlfaTabs Items="TiposReporte" ActiveKey="@_tipoReporte.ToString()" ActiveKeyChanged="OnTipoReporteChanged" AriaLabel="Tipo de reporte" />

    @if (_tipoReporte == TipoReporteCompras.CuentaCorriente)
    {
        <p class="gd-hint">Agrupado por código de cuenta, en orden cronológico. Incluye saldo inicial y acumulado por línea. Los importes son contables; el tipo de comprobante solo limita las líneas visibles y no recalcula el saldo.</p>
    }

    @* ── Estado inicial / carga / error ─────────────────────────────── *@
    @if (_isLoading)
    {
        <AlfaEmptyState Title="Generando reporte" Message="Buscando datos del período." />
    }
    else if (_error is not null)
    {
        <AlfaEmptyState Kind="AlfaEmptyStateKind.Error" Title="@_error.Message" Message="@ErrorDetalle(_error)" />
    }
    else if (!_mostrarResultados)
    {
        <AlfaEmptyState Title="@($"{TipoReporteLabel(_tipoReporte)} — {(EsSaldos ? $"Al {(_filtros.FechaHasta??DateTime.Today):dd/MM/yyyy}" : GestionRangosFecha.Etiqueta(_filtros.FechaDesde, _filtros.FechaHasta))}")"
                        Message="@(EsSaldos ? "Elegí fecha de corte y filtros de cartera en el buscador superior y generá el reporte." : $"Ajustá período, {Tercero.ToLowerInvariant()} o tipo de comprobante en el buscador de arriba y generá el reporte.")"
                        ActionLabel="Generar reporte"
                        ActionIcon="bi bi-play-fill"
                        OnAction="_ => GenerarAsync()" />
    }

    @* ── Resultados: Resumen de Compras ─────────────────────────────── *@
    @if (_mostrarResultados && _tipoReporte == TipoReporteCompras.ResumenDeCompras && _resumen is not null)
    {
        <div class="kpi-grid">
            <KpiCard Titulo="@(Ventas ? "Total vendido" : "Total comprado")"  Valor="@Moneda(_resumen.TotalComprado)"               Icono="$" />
            <KpiCard Titulo="Neto"            Valor="@Moneda(_resumen.NetoTotal)"                   Icono="N" />
            <KpiCard Titulo="IVA"             Valor="@Moneda(_resumen.IvaTotal)"                    Icono="%" />
            <KpiCard Titulo="Comprobantes"    Valor="@_resumen.CantidadComprobantes.ToString("N0")" Icono="C" />
            <KpiCard Titulo="@(Ventas ? "Clientes" : "Proveedores")"     Valor="@_resumen.CantidadProveedores.ToString("N0")"  Icono="@(Ventas ? "C" : "P")" />
        </div>

        <DataTable Titulo="@($"Resumen por {Tercero.ToLowerInvariant()}")"
                   Subtitulo="@($"{_resumen.Filas.Count} cuentas en el período")">
            <Header>
                <tr>
                    <th>Cuenta</th>
                    <th>@Tercero</th>
                    <th style="text-align:right;">Comprobantes</th>
                    <th style="text-align:right;">Neto</th>
                    <th style="text-align:right;">IVA</th>
                    <th style="text-align:right;">Total</th>
                    <th style="text-align:right;">% Part.</th>
                </tr>
            </Header>
            <Rows>
                @if (_resumen.Filas.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin comprobantes en el período" Message="Ampliá el rango de fechas o revisá los filtros aplicados." />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var fila in _resumen.Filas)
                    {
                        <tr>
                            <td>@fila.Cuenta</td>
                            <td><strong>@fila.RazonSocial</strong></td>
                            <td style="text-align:right;">@fila.CantidadComprobantes.ToString("N0")</td>
                            <td style="text-align:right;">@Moneda(fila.Neto)</td>
                            <td style="text-align:right;">@Moneda(fila.Iva)</td>
                            <td style="text-align:right;"><strong>@Moneda(fila.Total)</strong></td>
                            <td style="text-align:right;">@fila.Participacion.ToString("P1", Cultura)</td>
                        </tr>
                    }
                    <tr class="data-table__totals">
                        <td colspan="3" class="gd-totals-label">Total del período</td>
                        <td style="text-align:right;">@Moneda(_resumen.NetoTotal)</td>
                        <td style="text-align:right;">@Moneda(_resumen.IvaTotal)</td>
                        <td style="text-align:right;">@Moneda(_resumen.TotalComprado)</td>
                        <td></td>
                    </tr>
                }
            </Rows>
        </DataTable>
    }

    @* ── Resultados: Detalle de Compras ─────────────────────────────── *@
    @if (_mostrarResultados && _tipoReporte == TipoReporteCompras.DetalleDeCompras && _detalleCompras is not null)
    {
        <DataTable Titulo="Detalle de comprobantes"
                   Subtitulo="@GetSubtituloDetalle()">
            <Header>
                <tr>
                    <th>Fecha</th>
                    <th>TC</th>
                    <th>Comprobante</th>
                    <th>Cuenta</th>
                    <th>@Tercero</th>
                    <th>Motivo</th>
                    <th style="text-align:right;">Neto</th>
                    <th style="text-align:right;">IVA</th>
                    <th style="text-align:right;">Total</th>
                    <th>Usuario</th>
                    <th></th>
                </tr>
            </Header>
            <Rows>
                @if (_detalleCompras.Items.Count == 0)
                {
                    <tr>
                        <td colspan="11">
                            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin comprobantes en el período" Message="Ampliá el rango de fechas o revisá los filtros aplicados." />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in _detalleCompras.Items)
                    {
                        <tr>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.Tc</td>
                            <td>@item.IdComprobante</td>
                            <td>@item.Cuenta</td>
                            <td><strong>@item.RazonSocial</strong></td>
                            <td>@item.DescMotivo</td>
                            <td style="text-align:right;">@Moneda(item.Neto)</td>
                            <td style="text-align:right;">@Moneda(item.Iva)</td>
                            <td style="text-align:right;"><strong>@Moneda(item.Total)</strong></td>
                            <td>@item.Usuario</td>
                            <td>
                                @if (!EsDirecto)
                                {
                                <a class="adm-link-button" href="@BuildViewerUrl(item.Tc, item.IdComprobante)" title="Ver detalle del comprobante" aria-label="Ver detalle del comprobante">
                                    <i class="bi bi-eye"></i>
                                </a>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="data-table__totals">
                        <td colspan="6" class="gd-totals-label">
                            Total página (@_detalleCompras.Items.Count comprobantes)
                        </td>
                        <td style="text-align:right;">@Moneda(TotalNetoDetalle)</td>
                        <td style="text-align:right;">@Moneda(TotalIvaDetalle)</td>
                        <td style="text-align:right;">@Moneda(TotalTotalDetalle)</td>
                        <td colspan="2"></td>
                    </tr>
                }
            </Rows>
        </DataTable>
    }

    @* ── Resultados: Cuenta Corriente ──────────────────────────────── *@
    @if (_mostrarResultados && _tipoReporte == TipoReporteCompras.CuentaCorriente && _cuentaCorriente is not null)
    {
        <CuentaCorrienteVentasTabla Resultado="_cuentaCorriente" Ventas="Ventas" />
    }

    @if (_mostrarResultados && EsSaldos && _saldos is not null)
    {
        <SaldosVentasTabla Resultado="_saldos" ControlCredito="@(_tipoReporte == TipoReporteCompras.ControlCredito)" FechaCorte="_aplicados.FechaHasta" Ventas="Ventas" />
    }

    @if (_mostrarResultados && EsDocumentosCC && _documentosCC is not null)
    {
        <ComprobantesCuentaCorrienteTabla Resultado="_documentosCC" Analitico="@(_tipoReporte == TipoReporteCompras.CuentaCorrienteAnalitica)" Ventas="Ventas" />
    }

    @if (_mostrarResultados)
    {
        <footer class="alfa-data-view-footer">
            <span class="alfa-data-view-footer__summary">@(_tipoReporte == TipoReporteCompras.ResumenDeCompras ? $"{_resumen?.CantidadProveedores ?? 0} cuentas · {_resumen?.CantidadComprobantes ?? 0} registros" : _tipoReporte == TipoReporteCompras.DetalleDeCompras ? GetSubtituloDetalle() : EsSaldos ? GetSubtituloSaldos() : EsDocumentosCC ? GetSubtituloDocumentosCC() : GetSubtituloCC())</span>
            @if (_tipoReporte != TipoReporteCompras.ResumenDeCompras)
            {
                <div class="alfa-data-view-footer__controls">
                    <AlfaSelect Label="Registros por página" Value="@_aplicados.TamanioPagina.ToString()" ValueChanged="CambiarTamanioAsync" Disabled="@_isLoading" Options="@(new List<AlfaSelectOption> { new("25","25"),new("50","50"),new("100","100") })" />
                </div>
            }
        </footer>
    }

</div>

@code {
    [Parameter] public bool Ventas { get; set; }
    private string Titulo => Ventas ? "Reporte de Ventas" : "Reporte de Compras";
    private bool EsDirecto => Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("directo",out var v) && v.ToString() == "1";
    private string Tercero => Ventas ? "Cliente" : "Proveedor";
    private FiltrosReporteCompras _aplicados = new();
    private static FiltrosReporteCompras Copiar(FiltrosReporteCompras f) => new() { FechaDesde=f.FechaDesde,FechaHasta=f.FechaHasta,Proveedor=f.Proveedor,TipoComprobante=f.TipoComprobante,Pagina=f.Pagina,TamanioPagina=f.TamanioPagina, Vendedor=f.Vendedor,SinVendedor=f.SinVendedor,Zona=f.Zona,SinZona=f.SinZona,UnidadesNegocio=[..f.UnidadesNegocio],IncluirSaldosCero=f.IncluirSaldosCero };

    // Último encabezado publicado por esta página. Al cerrarse solo lo limpia si sigue siendo el
    // suyo: Blazor dispone la página anterior DESPUÉS de inicializar la nueva, y un Clear() sin
    // condición borraba el header recién publicado (se veía un instante el sidebar legacy).
    private PageHeaderConfig? _pageHeaderPublicado;

    private readonly FiltrosReporteCompras _filtros = new();
    private ReporteComprasOptionsDto _options = new();
    private TipoReporteCompras _tipoReporte = TipoReporteCompras.ResumenDeCompras;
    private bool _panelAbierto;

    private ResumenComprasDto?        _resumen;
    private DetalleComprasResultDto?  _detalleCompras;
    private CuentaCorrienteResultDto? _cuentaCorriente;
    private SaldosVentasResultDto? _saldos;
    private ComprobantesCuentaCorrienteResultDto? _documentosCC;
    private bool EsDocumentosCC => _tipoReporte is TipoReporteCompras.CuentaCorrienteResumida or TipoReporteCompras.CuentaCorrienteAnalitica;
    private bool EsSaldos => _tipoReporte == TipoReporteCompras.Saldos || (Ventas && _tipoReporte == TipoReporteCompras.ControlCredito);

    private AppUiMessage? _error;
    private bool _isLoading;
    private bool _mostrarResultados;

    private static readonly System.Globalization.CultureInfo Cultura =
        System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    // Totales de la página actual del detalle
    private decimal TotalNetoDetalle  => _detalleCompras?.Items.Sum(x => x.Neto)  ?? 0;
    private decimal TotalIvaDetalle   => _detalleCompras?.Items.Sum(x => x.Iva)   ?? 0;
    private decimal TotalTotalDetalle => _detalleCompras?.Items.Sum(x => x.Total) ?? 0;

    private CancellationTokenSource _contextCts = new();
    private bool _disposed;
    protected override void OnInitialized()
    {
        Sessions.SessionChanged += ContextoChanged; Users.StateChanged += ContextoChanged; UpdatePageHeader();
    }
    private void ContextoChanged()
    {
        _contextCts.Cancel(); _contextCts.Dispose(); _contextCts = new();
        _ = InvokeAsync(() => { if (_disposed) return; _resumen=null; _detalleCompras=null; _cuentaCorriente=null; _saldos=null; _documentosCC=null; _options=new(); _mostrarResultados=false;
            _error=AppUiMessage.Warning("Cambió la sesión", "Volvé a generar el reporte en la base activa."); UpdatePageHeader(); StateHasChanged(); });
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    public void Dispose()
    {
        _disposed=true; Sessions.SessionChanged -= ContextoChanged; Users.StateChanged -= ContextoChanged; _contextCts.Cancel(); _contextCts.Dispose();
        if (ReferenceEquals(PageHeader.Current, _pageHeaderPublicado))
            PageHeader.Clear();
    }

    private IReadOnlyList<AlfaTabItem> TiposReporte =>
    [
        new(nameof(TipoReporteCompras.ResumenDeCompras), Ventas ? "Resumen de ventas" : "Resumen de compras"),
        new(nameof(TipoReporteCompras.DetalleDeCompras), Ventas ? "Detalle de ventas" : "Detalle de compras"),
        new(nameof(TipoReporteCompras.CuentaCorriente), "Cuenta corriente"),
        new(nameof(TipoReporteCompras.Saldos), "Saldos"),
        ..(Ventas ? new AlfaTabItem[] { new(nameof(TipoReporteCompras.ControlCredito), "Saldos Control de Crédito") } : []),
        new(nameof(TipoReporteCompras.CuentaCorrienteResumida), "Cuenta corriente resumida"),
        new(nameof(TipoReporteCompras.CuentaCorrienteAnalitica), "Cuenta corriente analítica")
    ];

    private string TipoReporteLabel(TipoReporteCompras tipo) => tipo switch
    {
        TipoReporteCompras.DetalleDeCompras => Ventas ? "Detalle de ventas" : "Detalle de compras",
        TipoReporteCompras.CuentaCorriente => "Cuenta corriente",
        TipoReporteCompras.Saldos => "Saldos",
        TipoReporteCompras.ControlCredito => "Saldos Control de Crédito",
        TipoReporteCompras.CuentaCorrienteResumida => "Cuenta corriente resumida",
        TipoReporteCompras.CuentaCorrienteAnalitica => "Cuenta corriente analítica",
        _ => Ventas ? "Resumen de ventas" : "Resumen de compras"
    };

    private void OnTipoReporteChanged(string? key)
    {
        if (_isLoading) return;
        if (!Enum.TryParse<TipoReporteCompras>(key, out var tipo) || !Enum.IsDefined(tipo) || (!Ventas && tipo==TipoReporteCompras.ControlCredito) || tipo == _tipoReporte)
            return;

        // Cada tipo tiene su propio resultado: al cambiar de pestaña se vuelve al estado inicial.
        var veniaDeDocumentosCC=EsDocumentosCC;
        _tipoReporte = tipo;
        if (EsDocumentosCC && !veniaDeDocumentosCC) { _filtros.FechaDesde=null; _filtros.FechaHasta=DateTime.Today; }
        _mostrarResultados = false;
        _error = null;
        UpdatePageHeader();
    }

    private int TotalPaginasActual => _tipoReporte switch
    {
        TipoReporteCompras.DetalleDeCompras => _detalleCompras?.TotalPaginas ?? 0,
        TipoReporteCompras.CuentaCorriente => _cuentaCorriente?.TotalPaginas ?? 0,
        TipoReporteCompras.Saldos or TipoReporteCompras.ControlCredito => _saldos?.TotalPaginas ?? 0,
        TipoReporteCompras.CuentaCorrienteResumida or TipoReporteCompras.CuentaCorrienteAnalitica => _documentosCC?.TotalPaginas ?? 0,
        _ => 0
    };

    // Las tres vistas permiten exportar todos los registros del filtro aplicado.
    private bool PuedeExportarExcel => _mostrarResultados && !_isLoading;

    // Las acciones y la paginación corren desde el Context Toolbar (otro componente):
    // InvokeAsync + StateHasChanged para que esta página se vuelva a dibujar.
    private void UpdatePageHeader() => PageHeader.Set(_pageHeaderPublicado = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot,
        ModuleKey = Ventas ? "ventas" : "compras",
        Title = Titulo,
        TopNavigationItems = (Ventas ? AlfaCore.Services.ModuleTopNavPresets.BuildVentas(RouteContext, Nav, "reportes") : AlfaCore.Services.ModuleTopNavPresets.BuildCompras(RouteContext, Nav, "reportes")),
        Search = new PageHeaderSearchConfig(),
        SearchContent = RenderSmartSearch(),
        Actions =
        [
            new PageHeaderAction { Key = "generar", Label = _isLoading ? "Generando..." : "Generar reporte", Icon = "bi-play-fill", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _isLoading, OnClick = () => InvokeAsync(async () => { await GenerarAsync(); StateHasChanged(); }) },
            new PageHeaderAction { Key = "excel", Label = "Excel", Icon = "bi-file-earmark-excel", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = !PuedeExportarExcel, OnClick = () => InvokeAsync(ExportarAsync) },
            new PageHeaderAction { Key = "pdf", Label = "PDF", Icon = "bi-printer", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = !_mostrarResultados, OnClick = () => InvokeAsync(ImprimirPdfAsync) }
        ],
        Pagination = !_mostrarResultados || TotalPaginasActual <= 1 ? null : new PageHeaderPaginationConfig
        {
            PageLabel = $"{_filtros.Pagina} / {TotalPaginasActual}",
            HasPrevious = _filtros.Pagina > 1,
            HasNext = _filtros.Pagina < TotalPaginasActual,
            Disabled = _isLoading,
            OnPrevious = () => InvokeAsync(async () => { await PaginaAnteriorAsync(); StateHasChanged(); }),
            OnNext = () => InvokeAsync(async () => { await PaginaSiguienteAsync(); StateHasChanged(); })
        }
    });

    // ── Smart Search (Context Toolbar) ────────────────────────────────────────────
    // El fragmento se dibuja en el toolbar pero su estado vive acá: cada cambio vuelve a
    // publicar el header (mismo patrón que Contactos y Administrar → Clientes).
    private RenderFragment RenderSmartSearch() => @<div class="smart-search" @onclick:stopPropagation>
        @{ var chips = BuildFilterChips(); }
        <div class="smart-search__bar @(_panelAbierto ? "is-open" : string.Empty)">
            <span class="smart-search__search-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
            <button type="button" class="smart-search__filter-button @(_panelAbierto || chips.Count > 1 ? "is-active" : string.Empty)" title="Abrir filtros" aria-label="Abrir filtros" aria-expanded="@_panelAbierto" @onclick="TogglePanel">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
            </button>
            <div class="smart-search__active-filters" aria-label="Filtros activos">
                @foreach (var chip in chips.Take(2))
                {
                    <button type="button" class="smart-search__active-filter" title="@chip.Label" aria-label="@chip.Label" @onclick="() => RemoveChip(chip.Key)">
                        <span>@chip.Label</span>
                        @if (chip.Key != "periodo")
                        {
                            <span class="smart-search__active-filter-remove" aria-hidden="true"><i class="bi bi-x"></i></span>
                        }
                    </button>
                }
                @if (chips.Count > 2)
                {
                    <span class="smart-search__more-filters" title="@string.Join(", ", chips.Skip(2).Select(c => c.Label))">+@(chips.Count - 2)</span>
                }
            </div>
            <input type="search" placeholder="@($"Buscar por {Tercero.ToLowerInvariant()} o cuenta...")" value="@_filtros.Proveedor" @oninput="OnProveedorInput" @onkeydown="HandleSearchKeyDownAsync" />
            <button type="button" class="smart-search__toggle" @onclick="TogglePanel" aria-label="Mostrar filtros" aria-expanded="@_panelAbierto">
                <i class="bi @(_panelAbierto ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_panelAbierto)
        {
            <button type="button" class="module-actionbar__search-backdrop" aria-label="Cerrar filtros" @onclick="ClosePanel"></button>
            <div class="smart-search__panel smart-search__panel--standard" @onclick:stopPropagation @onkeydown="HandleSearchKeyDownAsync">
                <div class="smart-search__column">
                    <h4><i class="bi bi-calendar-range"></i> @(EsSaldos ? "Fecha de corte" : EsDocumentosCC ? "Fechas de emisión" : "Período")</h4>
                    @if (!EsSaldos)
                    {
                    var rangoActivo = GestionRangosFecha.Detectar(_filtros.FechaDesde, _filtros.FechaHasta);
                    foreach (var rango in GestionRangosFecha.Todos.Where(r => EsDocumentosCC || r.Key != "todo"))
                    {
                        <button type="button" class="@(rangoActivo == rango.Key ? "smart-option is-active" : "smart-option")" @onclick="() => SetRango(rango.Key)">@rango.Label</button>
                    }
                    <div class="smart-search__inline">
                        <label>Desde</label>
                        <input type="date" value="@(_filtros.FechaDesde?.ToString("yyyy-MM-dd"))" @onchange="e => SetFecha(e, desde: true)" />
                    </div>
                    }
                    <div class="smart-search__inline">
                        <label>@(EsSaldos ? "Al día" : "Hasta")</label>
                        <input type="date" value="@(_filtros.FechaHasta?.ToString("yyyy-MM-dd"))" @onchange="e => SetFecha(e, desde: false)" />
                    </div>
                </div>
                @if (!EsSaldos)
                {
                <div class="smart-search__column">
                    <h4><i class="bi bi-receipt"></i> Comprobante</h4>
                    <div class="smart-search__inline">
                        <label>Tipo (TC)</label>
                        <select value="@(_filtros.TipoComprobante ?? string.Empty)" @onchange="OnTcChanged">
                            <option value="">Todos</option>
                            @foreach (var tc in _options.TiposComprobante)
                            {
                                <option value="@tc">@tc</option>
                            }
                        </select>
                    </div>
                </div>
                }
                @if (EsSaldos)
                {
                    <div class="smart-search__column">
                        <h4><i class="bi bi-list-check"></i> Cuentas</h4>
                        <AlfaCheckbox Value="_filtros.IncluirSaldosCero" ValueChanged="CambiarIncluirCero">Incluir saldos cero</AlfaCheckbox>
                        <p class="gd-hint">@(Ventas ? "Control de crédito también incluye cuentas con límite asignado, aunque su saldo sea cero." : "Incluye proveedores sin movimientos, con saldo cero.")</p>
                    </div>
                }
                @if (Ventas)
                {
                    <div class="smart-search__column">
                        <h4><i class="bi bi-person-badge"></i> Cartera del cliente</h4>
                        <AlfaSelect Label="Vendedor del cliente" Value="@(_filtros.Vendedor ?? string.Empty)" Placeholder="Todos" Disabled="_filtros.SinVendedor"
                            Options="@_options.Vendedores.Select(x => new AlfaSelectOption(x.Codigo, $"{x.Codigo} · {x.Nombre}")).ToList()"
                            ValueChanged="v => CambiarCartera(v, true)" />
                        <AlfaCheckbox Value="_filtros.SinVendedor" ValueChanged="v => SinAsignacion(v, true)">Sin vendedor</AlfaCheckbox>
                        <AlfaSelect Label="Zona del cliente" Value="@(_filtros.Zona ?? string.Empty)" Placeholder="Todas" Disabled="_filtros.SinZona"
                            Options="@_options.Zonas.Select(x => new AlfaSelectOption(x, x)).ToList()"
                            ValueChanged="v => CambiarCartera(v, false)" />
                        <AlfaCheckbox Value="_filtros.SinZona" ValueChanged="v => SinAsignacion(v, false)">Sin zona</AlfaCheckbox>
                    </div>
                }
                    <div class="smart-search__column">
                        <h4><i class="bi bi-building"></i> Unidades de negocio</h4>
                        <p class="gd-hint">Sin selección: todas las unidades, incluso movimientos sin unidad.</p>
                        @foreach (var unidad in _options.UnidadesNegocio)
                        {
                            <AlfaCheckbox Value="@_filtros.UnidadesNegocio.Contains(unidad.Codigo)" ValueChanged="v => CambiarUnidad(unidad.Codigo, v)">@unidad.Codigo · @unidad.Nombre</AlfaCheckbox>
                        }
                        <AlfaCheckbox Value="@_filtros.UnidadesNegocio.Contains(string.Empty)" ValueChanged="v => CambiarUnidad(string.Empty, v)">Sin unidad asignada</AlfaCheckbox>
                    </div>
                <div class="smart-search__actions">
                    <AlfaButton Variant="AlfaButtonVariant.Ghost" Size="AlfaSize.Sm" Icon="bi bi-eraser" OnClick="_ => LimpiarAsync()">Limpiar</AlfaButton>
                    <AlfaButton Variant="AlfaButtonVariant.Primary" Size="AlfaSize.Sm" Icon="bi bi-play-fill" OnClick="_ => GenerarDesdePanelAsync()">Generar reporte</AlfaButton>
                </div>
            </div>
        }
    </div>;

    private void CambiarIncluirCero(bool? valor)
    {
        _filtros.IncluirSaldosCero=valor==true; UpdatePageHeader();
    }

    private void CambiarCartera(string? value, bool vendedor)
    {
        var texto=string.IsNullOrWhiteSpace(value)?null:value.Trim();
        if (vendedor) _filtros.Vendedor=texto; else _filtros.Zona=texto;
        UpdatePageHeader();
    }

    private void SinAsignacion(bool? value, bool vendedor)
    {
        if (vendedor) { _filtros.SinVendedor=value==true; _filtros.Vendedor=null; }
        else { _filtros.SinZona=value==true; _filtros.Zona=null; }
        UpdatePageHeader();
    }

    private void CambiarUnidad(string codigo, bool? value)
    {
        _filtros.UnidadesNegocio=value==true ? _filtros.UnidadesNegocio.Append(codigo).Distinct().ToArray()
            : _filtros.UnidadesNegocio.Where(x=>x!=codigo).ToArray();
        UpdatePageHeader();
    }

    private void OnProveedorInput(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString();
        _filtros.Proveedor = string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
        UpdatePageHeader();
    }

    private void OnTcChanged(ChangeEventArgs e)
    {
        var tc = e.Value?.ToString();
        _filtros.TipoComprobante = string.IsNullOrWhiteSpace(tc) ? null : tc;
        UpdatePageHeader();
    }

    private void SetFecha(ChangeEventArgs e, bool desde)
    {
        DateTime? valor = DateTime.TryParse(e.Value?.ToString(), out var fecha) ? fecha : null;
        if (desde) _filtros.FechaDesde = valor; else _filtros.FechaHasta = valor;
        UpdatePageHeader();
    }

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await GenerarDesdePanelAsync();
        else if (e.Key == "Escape")
            ClosePanel();
    }

    private async Task GenerarDesdePanelAsync()
    {
        _panelAbierto = false;
        await GenerarAsync();
    }

    private void TogglePanel()
    {
        _panelAbierto = !_panelAbierto;
        UpdatePageHeader();
    }

    private void ClosePanel()
    {
        _panelAbierto = false;
        UpdatePageHeader();
    }

    private static string ErrorDetalle(AppUiMessage error)
        => string.Join(" ", new[] { error.HasSuggestion ? error.Suggestion : null, error.HasCode ? $"Código: {error.Code}." : null }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override async Task OnInitializedAsync()
    {
        var ct = _contextCts.Token;
        var result = await UiOps.RunAsync(
            () => ReporteService.GetOptionsAsync(Ventas, ct),
            "No se pudieron cargar las opciones del reporte.");
        if (_disposed || ct.IsCancellationRequested) return;
        if (result.Success && result.Value is not null)
            _options = result.Value;
        else _error = result.Feedback;
        UpdatePageHeader();
    }

    private async Task GenerarAsync()
    {
        if (_isLoading || _disposed) return;
        // Generar desde cero siempre arranca en la página 1; la paginación llama a CargarAsync.
        _filtros.Pagina = 1;
        _aplicados = Copiar(_filtros);
        if (EsSaldos) { _aplicados.FechaDesde=null; _aplicados.TipoComprobante=null; _aplicados.FechaHasta ??= DateTime.Today; }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (_isLoading || _disposed) return;
        var ct = _contextCts.Token;
        _isLoading = true;
        _error = null;
        _mostrarResultados = false;
        UpdatePageHeader();

        try
        {
            switch (_tipoReporte)
            {
                case TipoReporteCompras.ResumenDeCompras:
                    _resumen = await ReporteService.GetResumenAsync(Ventas, _aplicados, ct);
                    break;
                case TipoReporteCompras.DetalleDeCompras:
                    _detalleCompras = await ReporteService.GetDetalleAsync(Ventas, _aplicados, ct);
                    break;
                case TipoReporteCompras.CuentaCorrienteResumida:
                case TipoReporteCompras.CuentaCorrienteAnalitica:
                    _documentosCC = Ventas ? await ReporteService.GetComprobantesCuentaCorrienteAsync(_aplicados, _tipoReporte==TipoReporteCompras.CuentaCorrienteAnalitica, ct) : await ReporteService.GetComprobantesCuentaCorrienteComprasAsync(_aplicados, _tipoReporte==TipoReporteCompras.CuentaCorrienteAnalitica, ct);
                    break;
                case TipoReporteCompras.Saldos:
                case TipoReporteCompras.ControlCredito:
                    _saldos = Ventas ? await ReporteService.GetSaldosVentasAsync(_aplicados, _tipoReporte==TipoReporteCompras.ControlCredito, ct) : await ReporteService.GetSaldosComprasAsync(_aplicados, ct);
                    break;
                case TipoReporteCompras.CuentaCorriente:
                    _cuentaCorriente = await ReporteService.GetCuentaCorrienteAsync(Ventas, _aplicados, ct);
                    break;
            }
            ct.ThrowIfCancellationRequested();
            _mostrarResultados = true;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            _error = UiOps.BuildMessage(ex, "No se pudo generar el reporte.");
        }
        finally
        {
            _isLoading = false;
            if (!_disposed) UpdatePageHeader();
        }
    }

    private async Task CambiarTamanioAsync(string? valor)
    {
        if (_isLoading || !int.TryParse(valor,out var size) || size is not (25 or 50 or 100)) return;
        _filtros.TamanioPagina=size; _aplicados.TamanioPagina=size; _filtros.Pagina=1; _aplicados.Pagina=1;
        await CargarAsync();
    }

    private async Task PaginaAnteriorAsync()
    {
        if (_isLoading || _filtros.Pagina <= 1) return;
        _filtros.Pagina--; _aplicados.Pagina = _filtros.Pagina;
        await CargarAsync();
    }

    private async Task PaginaSiguienteAsync()
    {
        if (_isLoading || _filtros.Pagina >= TotalPaginasActual) return;
        _filtros.Pagina++; _aplicados.Pagina = _filtros.Pagina;
        await CargarAsync();
    }

    private Task LimpiarAsync()
    {
        if (_isLoading) return Task.CompletedTask;
        (_filtros.FechaDesde, _filtros.FechaHasta) = GestionRangosFecha.Calcular("mes");
        _filtros.IncluirSaldosCero=false;
        _filtros.Vendedor=null; _filtros.SinVendedor=false; _filtros.Zona=null; _filtros.SinZona=false; _filtros.UnidadesNegocio=[];
        _filtros.Proveedor       = null;
        _filtros.TipoComprobante = null;
        _filtros.Pagina          = 1;
        _resumen         = null;
        _detalleCompras  = null;
        _cuentaCorriente = null; _saldos=null; _documentosCC=null;
        _mostrarResultados = false;
        _error = null;
        _panelAbierto = false;
        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private void SetRango(string key)
    {
        (_filtros.FechaDesde, _filtros.FechaHasta) = GestionRangosFecha.Calcular(key);
        UpdatePageHeader();
    }

    private sealed record FilterChip(string Key, string Label);

    private List<FilterChip> BuildFilterChips()
    {
        var chips = new List<FilterChip> { new("periodo", EsSaldos ? $"Al {(_filtros.FechaHasta??DateTime.Today):dd/MM/yyyy}" : GestionRangosFecha.Etiqueta(_filtros.FechaDesde, _filtros.FechaHasta)) };
        if (!EsSaldos && !string.IsNullOrWhiteSpace(_filtros.TipoComprobante))
            chips.Add(new("tc", $"TC: {_filtros.TipoComprobante}"));
        if (!string.IsNullOrWhiteSpace(_filtros.Proveedor))
            chips.Add(new("proveedor", $"{Tercero}: {_filtros.Proveedor}"));
        if (Ventas)
        {
            if (_filtros.Vendedor is not null) chips.Add(new("vendedor", $"Vendedor: {_filtros.Vendedor}"));
            if (_filtros.SinVendedor) chips.Add(new("vendedor", "Sin vendedor"));
            if (_filtros.Zona is not null) chips.Add(new("zona", $"Zona: {_filtros.Zona}"));
            if (_filtros.SinZona) chips.Add(new("zona", "Sin zona"));
        }
        if (_filtros.UnidadesNegocio.Length>0) chips.Add(new("unidades", $"Unidades: {string.Join(", ", _filtros.UnidadesNegocio.Select(x => x == "" ? "Sin unidad" : x))}"));
        if (EsSaldos && _filtros.IncluirSaldosCero) chips.Add(new("cero", "Incluye saldos cero"));
        return chips;
    }

    private void RemoveChip(string key)
    {
        switch (key)
        {
            case "cero": _filtros.IncluirSaldosCero=false; break;
            case "unidades": _filtros.UnidadesNegocio=[]; break;
            case "vendedor": _filtros.Vendedor=null; _filtros.SinVendedor=false; break;
            case "zona": _filtros.Zona=null; _filtros.SinZona=false; break;
            case "periodo": _panelAbierto = true; break;
            case "tc": _filtros.TipoComprobante = null; break;
            case "proveedor": _filtros.Proveedor = null; break;
        }
        UpdatePageHeader();
    }

    private async Task ImprimirPdfAsync()
    {
        await Js.InvokeVoidAsync("dashboardExport.printCurrentPage", Titulo);
    }

    private string BuildViewerUrl(string tc, string idComprobante) =>
        RouteContext.BuildRoute($"/comprobantes/viewer/{Uri.EscapeDataString(tc)}/{Uri.EscapeDataString(idComprobante)}?returnUrl={Uri.EscapeDataString(RouteContext.BuildRoute(Ventas ? "/ventas/reportes" : "/compras/reportes"))}" + (Nav.Uri.Contains("directo=1") ? "&directo=1" : ""));

    private async Task ExportarAsync()
    {
        if (_isLoading || !_mostrarResultados) return;
        _isLoading = true; UpdatePageHeader();
        var ct = _contextCts.Token;
        try
        {
            var f=Copiar(_aplicados); f.Pagina=1; f.TamanioPagina=500;
            byte[] bytes;
            if (EsDocumentosCC)
            {
                var items=new List<ComprobanteCuentaCorrienteDto>();
                while(true) { var r=Ventas ? await ReporteService.GetComprobantesCuentaCorrienteAsync(f,_tipoReporte==TipoReporteCompras.CuentaCorrienteAnalitica,ct) : await ReporteService.GetComprobantesCuentaCorrienteComprasAsync(f,_tipoReporte==TipoReporteCompras.CuentaCorrienteAnalitica,ct); items.AddRange(r.Items);
                    if(r.Items.Count==0 || items.Count>=r.TotalRegistros)break; f.Pagina++; }
                bytes=Exporter.ExportarComprobantesCuentaCorriente(items,f,_tipoReporte==TipoReporteCompras.CuentaCorrienteAnalitica,Ventas);
            }
            else if (EsSaldos)
            {
                var items=new List<SaldoVentasFilaDto>();
                while(true) { var r=Ventas ? await ReporteService.GetSaldosVentasAsync(f,_tipoReporte==TipoReporteCompras.ControlCredito,ct) : await ReporteService.GetSaldosComprasAsync(f,ct); items.AddRange(r.Items);
                    if(r.Items.Count==0 || items.Count>=r.TotalRegistros)break; f.Pagina++; }
                bytes=Exporter.ExportarSaldosVentas(items,f,_tipoReporte==TipoReporteCompras.ControlCredito,Ventas);
            }
            else if (_tipoReporte == TipoReporteCompras.ResumenDeCompras) bytes=Exporter.ExportarResumen(_resumen!, f, Ventas);
            else if (_tipoReporte == TipoReporteCompras.DetalleDeCompras)
            {
                var items=new List<DetalleComprasFilaDto>();
                while(true) { var r=await ReporteService.GetDetalleAsync(Ventas,f,ct); items.AddRange(r.Items);
                    if(r.Items.Count==0 || items.Count>=r.TotalRegistros)break; f.Pagina++; }
                bytes=Exporter.ExportarDetalle(items,f,items.Count,Ventas);
            }
            else
            {
                var items=new List<CuentaCorrienteFilaDto>(); decimal saldo=0;
                while(true) { var r=await ReporteService.GetCuentaCorrienteAsync(Ventas,f,ct); saldo=r.SaldoTotal; items.AddRange(r.Items);
                    if(r.Items.Count==0 || items.Count>=r.TotalRegistros)break; f.Pagina++; }
                bytes=Exporter.ExportarCuentaCorriente(items,f,saldo,Ventas);
            }
            ct.ThrowIfCancellationRequested();
            await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob",Convert.ToBase64String(bytes),"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",$"reporte_{(Ventas?"ventas":"compras")}_{_tipoReporte}_{DateTime.Today:yyyyMMdd}.xlsx");
        }
        catch(OperationCanceledException) when(ct.IsCancellationRequested) { }
        catch(Exception ex) { _error=UiOps.BuildMessage(ex,"No se pudo exportar el reporte."); }
        finally { _isLoading=false; if (!_disposed) { UpdatePageHeader(); StateHasChanged(); } }
    }

    private string GetSubtituloDetalle() =>
        _detalleCompras is null ? string.Empty
            : $"{_detalleCompras.TotalRegistros} comprobantes — página {_filtros.Pagina} de {_detalleCompras.TotalPaginas}";

    private string GetSubtituloDocumentosCC() => _documentosCC is null ? string.Empty
        : $"{_documentosCC.TotalRegistros} comprobantes · {_documentosCC.CantidadClientes} {(Ventas?"clientes":"proveedores")} · página {_aplicados.Pagina} de {_documentosCC.TotalPaginas} · pendiente: {Moneda(_documentosCC.PendienteTotal)}";

    private string GetSubtituloSaldos() => _saldos is null ? string.Empty
        : $"{_saldos.TotalRegistros} cuentas · página {_aplicados.Pagina} de {_saldos.TotalPaginas} · saldo de selección: {Moneda(_saldos.SaldoTotal)}";

    private string GetSubtituloCC() =>
        _cuentaCorriente is null ? string.Empty
            : $"{_cuentaCorriente.TotalRegistros} líneas · página {_aplicados.Pagina} de {_cuentaCorriente.TotalPaginas} · saldo al cierre: {Moneda(_cuentaCorriente.SaldoFinalTotal)}";

    private static string Moneda(decimal v) =>
        v.ToString("$ #,##0.00", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
