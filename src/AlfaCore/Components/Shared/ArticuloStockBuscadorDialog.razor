@using System.Globalization
@using AlfaCore.Models
@inject IJSRuntime Js
@implements IDisposable

@* Búsqueda F5 de artículos con stock del depósito, como la consulta de Alfa (Lib_FrmCons3): la lista aparece de entrada,
   se filtra al escribir, ↑ ↓ para moverse, Enter elige y Esc cierra. Sin precios: sirve para stock, compras o producción. *@
@if (Open)
{
    <AlfaDialog Open="true" Title="Buscar artículo" Size="AlfaDialogSize.Lg" OnClose="CerrarAsync">
        <div class="buscador">
            <p class="buscador__ayuda">Escribí para filtrar · ↑ ↓ para moverte · Enter para elegir · Esc para cerrar</p>
            <input id="@InputId" class="buscador__input" placeholder="Código, descripción o código de barras" autocomplete="off"
                   value="@_texto" @oninput="InputAsync" @onkeydown="KeyDownAsync" />
            <div class="buscador__lista" role="listbox" aria-label="Artículos encontrados">
                @if (_cargando) { <p class="buscador__ayuda">Buscando…</p> }
                else if (_error is not null) { <p class="buscador__error">@_error</p> }
                else if (_resultados.Count == 0) { <p class="buscador__ayuda">No se encontraron artículos.</p> }
                else
                {
                    <table class="buscador__tabla">
                        <thead><tr><th>Código</th><th>Descripción</th><th>Unidad</th><th class="num">@StockLabel</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _resultados.Count; i++)
                            {
                                var a = _resultados[i]; var idx = i;
                                <tr id="@($"{InputId}-res-{idx}")" class="@(idx == _activo ? "is-active" : null) @(a.Restriccion.Length > 0 ? "is-restringido" : null)"
                                    role="option" aria-selected="@(idx == _activo)" title="@(a.Restriccion.Length > 0 ? $"No se puede mover acá: {a.Restriccion}" : null)"
                                    @onclick="() => ElegirAsync(a)" @onmouseenter="() => _activo = idx">
                                    <td>@a.Codigo</td>
                                    <td>@a.Descripcion @if (a.Restriccion.Length > 0) { <small class="buscador__restriccion">@a.Restriccion</small> }</td>
                                    <td>@a.Unidad</td>
                                    <td class="num">@a.Stock.ToString("0.####", Ar)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </AlfaDialog>
}

@code {
    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");
    [Parameter] public bool Open { get; set; }
    /// <summary>Texto con el que se abre (lo que había en el código).</summary>
    [Parameter] public string TextoInicial { get; set; } = "";
    /// <summary>Resultados ya buscados (por ejemplo, al no encontrar el código exacto); si es null se busca al abrir.</summary>
    [Parameter] public IReadOnlyList<StockMovimientoArticulo>? ResultadosIniciales { get; set; }
    [Parameter, EditorRequired] public Func<string, CancellationToken, Task<IReadOnlyList<StockMovimientoArticulo>>> SearchFunc { get; set; } = default!;
    [Parameter] public string StockLabel { get; set; } = "Stock";
    [Parameter] public string InputId { get; set; } = "art-buscar";
    [Parameter] public EventCallback<StockMovimientoArticulo> OnElegir { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _abierto, _cargando;
    private string _texto = "";
    private string? _error;
    private List<StockMovimientoArticulo> _resultados = [];
    private int _activo = -1;
    private CancellationTokenSource? _cts;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_abierto)
        {
            _abierto = true; _texto = TextoInicial; _error = null; _resultados = []; _activo = -1;
            if (ResultadosIniciales is not null) Mostrar(ResultadosIniciales);
            else await BuscarAsync(debounce: false);
            await FocoAsync();
        }
        else if (!Open) { _abierto = false; _cts?.Cancel(); }
    }

    private async Task InputAsync(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? "";
        await BuscarAsync(debounce: true);
    }

    private async Task BuscarAsync(bool debounce)
    {
        _cts?.Cancel();
        var cts = _cts = new CancellationTokenSource();
        _cargando = true; _error = null;
        try
        {
            if (debounce) await Task.Delay(200, cts.Token);
            var resultados = await SearchFunc(_texto.Trim(), cts.Token);
            if (!cts.IsCancellationRequested) Mostrar(resultados);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!cts.IsCancellationRequested) { _resultados = []; _error = ex is InvalidOperationException ? ex.Message : "No se pudo buscar. Volvé a intentar."; }
        }
        finally
        {
            if (!cts.IsCancellationRequested) { _cargando = false; StateHasChanged(); }
        }
    }

    private void Mostrar(IReadOnlyList<StockMovimientoArticulo> resultados)
    {
        _resultados = resultados.ToList();
        _activo = _resultados.Count > 0 ? 0 : -1;
        _cargando = false;
    }

    private async Task KeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { await CerrarAsync(); return; }
        if (_resultados.Count == 0) return;
        if (e.Key == "ArrowDown") _activo = Math.Min(_activo + 1, _resultados.Count - 1);
        else if (e.Key == "ArrowUp") _activo = Math.Max(_activo - 1, 0);
        else if (e.Key == "Enter" && _activo >= 0) { await ElegirAsync(_resultados[_activo]); return; }
        else return;
        try { await Js.InvokeVoidAsync("cargaDirecta.scrollIntoView", $"{InputId}-res-{_activo}"); } catch { }
    }

    private Task ElegirAsync(StockMovimientoArticulo articulo) { _cts?.Cancel(); return OnElegir.InvokeAsync(articulo); }
    private Task CerrarAsync() { _cts?.Cancel(); return OnClose.InvokeAsync(); }
    private async Task FocoAsync() { try { await Js.InvokeVoidAsync("cargaDirecta.focus", InputId); } catch { } }
    public void Dispose() => _cts?.Cancel();
}
