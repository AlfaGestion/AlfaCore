@using AlfaCore.Components.Shared.AlfaDesign
@using AlfaCore.Models

<article class="lista-precios__row">
    <div class="lista-precios__row-media">
        @if (!string.IsNullOrWhiteSpace(ImagenUrl) && !_imagenFallo)
        {
            <img src="@ImagenUrl" alt="@Item.Descripcion" loading="lazy" @onerror="() => _imagenFallo = true" />
        }
        else
        {
            <div class="lista-precios__row-media-fallback"><i class="bi bi-image"></i></div>
        }
    </div>

    <div class="lista-precios__row-main">
        <div class="lista-precios__row-title">
            <strong>@Item.Descripcion</strong>
            @if (!string.IsNullOrWhiteSpace(Item.Presentacion))
            {
                <span class="lista-precios__row-presentation">@Item.Presentacion</span>
            }
        </div>

        <div class="lista-precios__row-meta">
            <span class="lista-precios__row-code">@Item.IdArticulo</span>
            @if (!string.IsNullOrWhiteSpace(Item.Marca))
            {
                <span>@Item.Marca</span>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Familia))
            {
                <span>@Item.Familia</span>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Rubro))
            {
                <span>@Item.Rubro</span>
            }
        </div>
    </div>

    <div class="lista-precios__row-price">
        @if (Item.SinPrecio)
        {
            <AlfaTag Tone="AlfaTagTone.Warning">Consultar</AlfaTag>
        }
        else
        {
            <strong class="lista-precios__row-price-main">@Money(Item.Precio)</strong>
            @if (Margen > 0)
            {
                <span class="lista-precios__row-price-secondary">Con margen: @Money(Item.Precio * (1 + Margen / 100m))</span>
            }
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ListaPreciosArticuloDto Item { get; set; } = null!;
    [Parameter] public string? ImagenUrl { get; set; }
    [Parameter] public decimal Margen { get; set; }

    private bool _imagenFallo;

    private static string Money(decimal value)
        => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
