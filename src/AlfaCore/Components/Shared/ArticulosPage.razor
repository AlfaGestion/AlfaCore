@using AlfaCore.Models
@using AlfaCore.Services
@using Microsoft.AspNetCore.WebUtilities
@inject IArticulosService ArticulosSvc
@inject IAppUiOperationService UiOps
@inject IAppUserSessionService AppUserSession
@inject IRouteContextService RouteContext
@inject IPageHeaderService PageHeader
@inject ISessionService SessionSvc
@inject NavigationManager Nav
@implements IDisposable

@* Módulo Archivos > Maestros > Artículos (MVP) -- mismo patrón estructural que Clientes
   (CuentasComercialesPage.razor): lista con columnas configurables + header/toolbar vía
   IPageHeaderService + editor de página completa (no modal) con pestañas. Alcance y decisiones en
   C:\Users\albert\.claude\plans\fluttering-drifting-moonbeam.md. *@

<div class="articulos-page" @onclick="HandlePageClickAsync">
    <AlfaNotification Message="@_feedback" OnDismiss="DismissFeedback" />

    <AlfaDialog Open="@_showViewSettings"
                Title="Configurar vista"
                Eyebrow="Listado de artículos"
                Description="Elegí qué columnas mostrar en la grilla y su orden."
                Size="AlfaDialogSize.Md"
                Loading="@_savingViewSettings"
                OnClose="CancelarConfiguracionVista">
        <ChildContent>
            <div class="articulos-view-settings">
                @foreach (var column in _viewSettingsDraft.OrderBy(c => c.Order))
                {
                    var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
                    var index = ordered.FindIndex(c => string.Equals(c.Key, column.Key, StringComparison.OrdinalIgnoreCase));
                    <div class="articulos-view-settings__item">
                        <AlfaCheckbox Value="@column.Visible" ValueChanged="v => SetColumnVisibility(column.Key, v)" Disabled="@_savingViewSettings">
                            @column.Label
                        </AlfaCheckbox>
                        <div class="articulos-view-settings__order">
                            <AlfaIconButton Icon="bi bi-arrow-up" Label="@($"Subir {column.Label}")" Size="AlfaSize.Sm"
                                            Disabled="@(_savingViewSettings || index <= 0)" OnClick="_ => MoveColumn(column.Key, -1)" />
                            <AlfaIconButton Icon="bi bi-arrow-down" Label="@($"Bajar {column.Label}")" Size="AlfaSize.Sm"
                                            Disabled="@(_savingViewSettings || index == ordered.Count - 1)" OnClick="_ => MoveColumn(column.Key, 1)" />
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
        <Footer>
            <AlfaButton Variant="AlfaButtonVariant.Ghost" Disabled="@_savingViewSettings" OnClick="_ => CancelarConfiguracionVista()">Cancelar</AlfaButton>
            <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-floppy" Loading="@_savingViewSettings" OnClick="_ => GuardarConfiguracionVistaAsync()">Guardar vista</AlfaButton>
        </Footer>
    </AlfaDialog>

    <AlfaConfirmDialog Open="@_showDeactivateConfirm"
                       Title="@(_pendingDeactivateCodes.Count > 1 ? $"Dar de baja {_pendingDeactivateCodes.Count} artículos" : "Dar de baja artículo")"
                       Message="@GetDeactivateMessage()"
                       SecondaryMessage="La baja es lógica: los artículos quedan inactivos, no se eliminan."
                       ConfirmLabel="Dar de baja"
                       CancelLabel="Cancelar"
                       Loading="@_saving"
                       OnConfirm="ConfirmDeactivateAsync"
                       OnCancel="CloseDeactivateConfirm" />

    <BaseMaestraImagenesDialog Open="@_showBuscarImagenModal"
                               Titulo="Imágenes encontradas"
                               Subtitulo="Búsqueda automática por código de barras/descripción -- misma fuente que usa Interfaces > Catálogos."
                               Articulos="@_buscarImagenOrigen"
                               IdClienteFtp="@_ftpCodigoCta"
                               IdBase="@SessionSvc.GetActiveSession()?.BaseId"
                               IncluirExistentesInicial="@_incluirExistentesEnBusqueda"
                               OnAsignadas="OnImagenAsignadaAsync"
                               OnClose="CerrarBusquedaImagenAsync" />

    @if (!_showEditor)
    {
        <section class="articulos-list-shell @(_selectedCodes.Count > 0 ? "articulos-list-shell--selection" : string.Empty)">
            @if (_loadingList)
            {
                <div class="articulos-list-shell__state">
                    <AlfaEmptyState Title="Cargando artículos" Message="Estamos consultando la base activa con los filtros actuales." />
                </div>
            }
            else if (_listLoadFailed)
            {
                <div class="articulos-list-shell__state">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.Error"
                                    Title="No se pudieron cargar los artículos"
                                    Message="Reintentá la consulta sobre la base activa."
                                    ActionLabel="Reintentar"
                                    ActionIcon="bi bi-arrow-clockwise"
                                    OnAction="_ => BuscarAsync()" />
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="articulos-list-shell__state">
                    <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults"
                                    Title="No encontramos artículos"
                                    Message="No hay artículos para los filtros seleccionados."
                                    ActionLabel="Limpiar filtros"
                                    ActionIcon="bi bi-eraser"
                                    OnAction="_ => LimpiarFiltrosAsync()" />
                </div>
            }
            else if (_viewMode == ArticuloViewModeKeys.Kanban)
            {
                <ArticulosKanbanView Items="@_items"
                                     SelectedCodes="@_selectedCodes"
                                     FtpCodigoCta="@_ftpCodigoCta"
                                     IdBase="@SessionSvc.GetActiveSession()?.BaseId"
                                     RowActions="BuildRowActions"
                                     OnToggleSelection="ToggleKanbanSelection"
                                     OnOpenRecord="codigo => AbrirEditorAsync(codigo)"
                                     OnRetry="BuscarAsync"
                                     OnEmptyAction="LimpiarFiltrosAsync" />
            }
            else
            {
                <div class="articulos-list-shell__table-scroll">
                    <table class="articulos-list-table" aria-label="Artículos encontrados">
                        <thead>
                            <tr>
                                <th class="articulos-list-table__select">
                                    <input type="checkbox" checked="@AreAllCurrentPageSelected" @onchange="ToggleSelectAll"
                                           aria-label="Seleccionar todos los artículos visibles" />
                                </th>
                                @foreach (var column in GetVisibleColumns())
                                {
                                    <th class="@GetColumnCssClass(column.Key)">@column.Label</th>
                                }
                                <th class="articulos-list-table__actions">Acciones</th>
                            </tr>
                        </thead>
                        @foreach (var group in BuildGridGroups())
                        {
                            <tbody>
                                @if (group.ShowHeader)
                                {
                                    <tr class="articulos-list-table__group">
                                        <td colspan="@(GetVisibleColumns().Count + 2)">@group.Label</td>
                                    </tr>
                                }
                                @foreach (var item in group.Items)
                                {
                                    <tr class="articulos-list-table__row @(IsSelected(item) ? "is-selected" : string.Empty)"
                                        @ondblclick="() => AbrirEditorAsync(item.Codigo)">
                                        <td class="articulos-list-table__select" @onclick:stopPropagation="true">
                                            <input type="checkbox" checked="@_selectedCodes.Contains(item.Codigo)"
                                                   @onchange="args => ToggleRowSelection(item.Codigo, args)"
                                                   aria-label="@($"Seleccionar {item.Descripcion}")" />
                                        </td>
                                        @foreach (var column in GetVisibleColumns())
                                        {
                                            <td class="@GetColumnCssClass(column.Key)">@RenderCell(item, column.Key)</td>
                                        }
                                        <td class="articulos-list-table__actions" @onclick:stopPropagation="true">
                                            <AlfaActionMenu Items="@BuildRowActions(item)"
                                                            TriggerLabel="@($"Acciones de {item.Descripcion}")"
                                                            MenuLabel="Acciones del artículo"
                                                            Align="AlfaActionMenuAlign.End" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
            }
            <footer class="articulos-list-footer">
                <span class="articulos-list-footer__summary">@GetSummary()</span>
                <div class="articulos-list-footer__controls">
                    <AlfaSelect Value="@_filters.PageSize.ToString()" ValueChanged="SetPageSizeAsync" Options="@PageSizeOptions" Disabled="@_loadingList" Class="articulos-list-footer__page-size" />
                </div>
            </footer>
        </section>
    }
    else
    {
        <section class="panel-card">
            <div class="articulos-summary">
                <div class="articulos-summary__avatar">
                    @if (!string.IsNullOrWhiteSpace(_imagenUrl))
                    {
                        <img src="@_imagenUrl" alt="Imagen del artículo" onerror="this.style.visibility='hidden'" />
                    }
                    else
                    {
                        @GetArticuloInitial()
                    }
                </div>
                <div class="articulos-summary__body">
                    <h2>@(string.IsNullOrWhiteSpace(_form.Descripcion) ? "Nuevo artículo" : _form.Descripcion)</h2>
                    <div class="articulos-summary__meta">
                        <span><i class="bi bi-upc-scan"></i>@(string.IsNullOrWhiteSpace(_form.Codigo) ? "Sin código" : _form.Codigo)</span>
                        @if (!_isNewMode)
                        {
                            <span><i class="bi bi-circle-fill @(_selectedActivo ? "articulos-status-dot--activo" : "articulos-status-dot--inactivo")"></i>@(_selectedActivo ? "Activo" : "Inactivo")</span>
                        }
                        <span><i class="bi bi-tag"></i>Precio: @_form.Precio.ToString("N2")</span>
                    </div>
                    @if (!_isNewMode)
                    {
                        <div class="articulos-image-actions">
                            <div class="articulos-image-picker">
                                <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-upload" Size="AlfaSize.Sm" Disabled="@_subiendoImagen">
                                    @(_subiendoImagen ? "Subiendo..." : "Subir imagen")
                                </AlfaButton>
                                <InputFile class="articulos-image-input" OnChange="HandleImagenSeleccionadaAsync" accept=".jpg,.jpeg,.png,image/jpeg,image/png" disabled="@_subiendoImagen" />
                            </div>
                            <AlfaButton Variant="AlfaButtonVariant.Ghost" Icon="bi bi-search" Size="AlfaSize.Sm" Disabled="@_subiendoImagen" OnClick="AbrirBusquedaImagenAsync">
                                Buscar en internet
                            </AlfaButton>
                        </div>
                    }
                </div>
            </div>

            <AlfaTabs Items="@_tabItems" ActiveKey="@_activeTab.ToString()" ActiveKeyChanged="SetActiveTabAsync" AriaLabel="Secciones del artículo" />

            @if (_activeTab == ArticuloTab.Datos)
            {
                <div class="articulos-form-grid">
                    <AlfaInput Label="Código de artículo" Value="@_form.Codigo" ValueChanged="v => _form.Codigo = v ?? string.Empty"
                               Disabled="@(!_isNewMode)" Required="true" MaxLength="25"
                               HelpText="@(_isNewMode ? "Identificador único del artículo (PK) -- numérico o alfanumérico." : "No se puede modificar en un artículo existente.")" />
                    <AlfaInput Label="Código de barras" Value="@_form.CodigoBarra" ValueChanged="v => _form.CodigoBarra = v ?? string.Empty" MaxLength="25" />

                    <AlfaInput Label="Descripción" Value="@_form.Descripcion" ValueChanged="v => _form.Descripcion = v ?? string.Empty" Required="true" MaxLength="150" Class="articulos-form-grid__span2" />

                    <div class="articulos-field">
                        <label class="articulos-field__label">Rubro</label>
                        <AlfaLookup TItem="ArticuloLookupOptionDto"
                                    Placeholder="Buscar o crear rubro..."
                                    MinimumCharacters="0"
                                    SearchText="@_form.RubroDescripcion"
                                    SearchTextChanged="v => _form.RubroDescripcion = v"
                                    SearchFunc="BuscarRubrosFiltroAsync"
                                    ItemKey="r => r.Codigo"
                                    SelectedItem="@_rubroSeleccionado"
                                    SelectedItemChanged="OnRubroSeleccionadoAsync">
                            <ItemTemplate Context="r">@r.Descripcion</ItemTemplate>
                        </AlfaLookup>
                        <small class="articulos-field__help">Elegí uno existente o escribí uno nuevo para crearlo al grabar.</small>
                    </div>
                    <div class="articulos-field">
                        <label class="articulos-field__label">Marca</label>
                        <AlfaLookup TItem="ArticuloLookupOptionDto"
                                    Placeholder="Buscar o crear marca..."
                                    MinimumCharacters="0"
                                    SearchText="@_form.MarcaDescripcion"
                                    SearchTextChanged="v => _form.MarcaDescripcion = v"
                                    SearchFunc="BuscarMarcasFiltroAsync"
                                    ItemKey="m => m.Codigo"
                                    SelectedItem="@_marcaSeleccionada"
                                    SelectedItemChanged="OnMarcaSeleccionadaAsync">
                            <ItemTemplate Context="m">@m.Descripcion</ItemTemplate>
                        </AlfaLookup>
                    </div>
                    <div class="articulos-field">
                        <label class="articulos-field__label">Unidad de medida</label>
                        <AlfaLookup TItem="ArticuloLookupOptionDto"
                                    Placeholder="Buscar o crear unidad..."
                                    MinimumCharacters="0"
                                    SearchText="@_form.UnidadDescripcion"
                                    SearchTextChanged="v => _form.UnidadDescripcion = v"
                                    SearchFunc="BuscarUnidadesFiltroAsync"
                                    ItemKey="u => u.Codigo"
                                    SelectedItem="@_unidadSeleccionada"
                                    SelectedItemChanged="OnUnidadSeleccionadaAsync">
                            <ItemTemplate Context="u">@u.Descripcion</ItemTemplate>
                        </AlfaLookup>
                    </div>

                    <div class="articulos-field">
                        <label class="articulos-field__label">Proveedor</label>
                        <AlfaLookup TItem="ArticuloLookupOptionDto"
                                    Placeholder="Buscar proveedor..."
                                    MinimumCharacters="1"
                                    SearchText="@_proveedorTexto"
                                    SearchTextChanged="v => _proveedorTexto = v"
                                    SearchFunc="BuscarProveedoresAsync"
                                    ItemKey="p => p.Codigo"
                                    SelectedItem="@_proveedorSeleccionado"
                                    SelectedItemChanged="OnProveedorSeleccionadoAsync">
                            <ItemTemplate Context="p">@p.Codigo -- @p.Descripcion</ItemTemplate>
                        </AlfaLookup>
                        <small class="articulos-field__help">Opcional. Podés dejarlo en blanco o elegir uno del maestro de proveedores.</small>
                    </div>
                    <div class="articulos-field">
                        <label class="articulos-field__label">Artículo del proveedor</label>
                        <input class="articulos-field__control" value="@_form.CodigoArtProveedor"
                               @onchange="e => _form.CodigoArtProveedor = e.Value?.ToString() ?? string.Empty" maxlength="25" />
                        <small class="articulos-field__help">Código que usa el proveedor para identificar este artículo (texto libre, sin validar).</small>
                    </div>

                    <div class="articulos-form-grid__span2">
                        <AlfaCheckbox Value="@_form.Pesable" ValueChanged="v => _form.Pesable = v == true">
                            <i class="bi bi-speedometer2"></i> Producto para balanza (pesable)
                        </AlfaCheckbox>
                    </div>
                </div>
            }
            else
            {
                <div class="articulos-form-grid">
                    <AlfaInput Label="Costo" Type="number" Value="@_form.Costo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               ValueChanged="OnCostoChangedAsync" />
                    <AlfaInput Label="Precio de venta" Type="number" Value="@_form.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               ValueChanged="OnPrecioChangedAsync" />
                    <AlfaInput Label="Utilidad %" Type="number" Value="@_form.Utilidad.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               ValueChanged="OnUtilidadChangedAsync" />
                    <AlfaInput Label="Alícuota de IVA" Type="number" Value="@_form.TasaIva.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               ValueChanged="v => _form.TasaIva = ParseDecimal(v)" />
                    <div class="articulos-form-grid__span2">
                        <AlfaCheckbox Value="@_form.Exento" ValueChanged="v => _form.Exento = v == true">
                            <i class="bi bi-receipt"></i> Exento de IVA
                        </AlfaCheckbox>
                    </div>
                    @if (_lookups.PrecioIncluyeIva)
                    {
                        <div class="articulos-form-grid__span2 articulos-hint">
                            <i class="bi bi-info-circle"></i> Configuración vigente: el precio de venta se carga con IVA incluido.
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private readonly List<ArticuloGridItemDto> _items = [];
    private readonly HashSet<string> _selectedCodes = new(StringComparer.OrdinalIgnoreCase);
    private ArticuloFilters _filters = new();
    private ArticuloLookupDataDto _lookups = new();
    private ArticuloViewSettingsDto _viewSettings = new();
    private readonly List<ArticuloViewColumnDto> _viewSettingsDraft = [];
    private bool _viewSettingsLoaded;
    private string _viewSettingsUserName = string.Empty;
    private string _viewMode = ArticuloViewModeKeys.Listado;

    private bool _loadingList;
    private bool _listLoadFailed;
    private bool _saving;
    private bool _savingViewSettings;
    private bool _showViewSettings;
    private bool _showEditor;
    private bool _isNewMode;
    private bool _selectedActivo = true;
    private string _selectedCodigo = string.Empty;
    private ArticuloTab _activeTab = ArticuloTab.Datos;

    // Combos con búsqueda del editor (Rubro/Marca/Unidad/Proveedor) -- mismo patrón AlfaLookup que el
    // panel de filtros, para que todo campo de tabla relacionada se maneje de forma homogénea.
    private ArticuloLookupOptionDto? _rubroSeleccionado;
    private ArticuloLookupOptionDto? _marcaSeleccionada;
    private ArticuloLookupOptionDto? _unidadSeleccionada;
    private string _proveedorTexto = string.Empty;
    private ArticuloLookupOptionDto? _proveedorSeleccionado;

    private string _imagenUrl = string.Empty;
    private bool _subiendoImagen;
    private bool _showBuscarImagenModal;
    private IReadOnlyList<BaseMaestraImagenOrigenDto> _buscarImagenOrigen = [];
    private bool _incluirExistentesEnBusqueda;
    private string? _ftpCodigoCta;
    private ArticuloSaveRequest _form = new();
    private AppUiMessage? _feedback;

    private bool _showDeactivateConfirm;
    private readonly List<string> _pendingDeactivateCodes = [];

    private bool _showSearchPanel;
    private CancellationTokenSource? _searchDebounceCts;
    private string _rubroFiltroTexto = string.Empty;
    private ArticuloLookupOptionDto? _rubroFiltroSeleccionado;
    private string _marcaFiltroTexto = string.Empty;
    private ArticuloLookupOptionDto? _marcaFiltroSeleccionado;

    private int _pagedTotal;
    private int _pageNumber = 1;
    private int _totalPages = 1;
    private bool _hasPrev;
    private bool _hasNext;

    private readonly IReadOnlyList<AlfaTabItem> _tabItems =
    [
        new(ArticuloTab.Datos.ToString(), "Datos generales"),
        new(ArticuloTab.Precios.ToString(), "Precios")
    ];

    private static readonly IReadOnlyList<AlfaSelectOption> PageSizeOptions =
    [
        new("25", "25 por página"),
        new("50", "50 por página"),
        new("100", "100 por página")
    ];

    private enum ArticuloTab { Datos, Precios }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        // No depender solo de los `_ = InvokeAsync(StateHasChanged)` desperdigados en
        // UpdatePageHeader(): los botones del header (Guardar/Cancelar/etc.) se disparan desde
        // MainPageHeader, no desde esta página, así que el único disparador confiable de un
        // re-render del CUERPO de esta página ante un cambio de header es suscribirse al evento,
        // igual que hace el propio MainPageHeader.
        PageHeader.Changed += OnHeaderChanged;
        UpdatePageHeader();
        await LoadLookupsAsync();
        await EnsureViewSettingsLoadedAsync();
        await BuscarAsync();
        await ApplyStartupQueryAsync();
        UpdatePageHeader();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            UpdatePageHeader();
    }

    private void OnHeaderChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        PageHeader.Changed -= OnHeaderChanged;
        PageHeader.Clear();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(ApplyCurrentLocationAsync);

    private async Task ApplyCurrentLocationAsync()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        var codigo = query.TryGetValue("editar", out var editar) ? editar.ToString() : string.Empty;
        if (string.IsNullOrWhiteSpace(codigo))
        {
            if (_showEditor && !_isNewMode)
                CerrarEditor();
            return;
        }

        if (!_showEditor || !string.Equals(_selectedCodigo, codigo, StringComparison.OrdinalIgnoreCase))
            await AbrirEditorAsync(codigo, updateUrl: false);
    }

    private async Task ApplyStartupQueryAsync()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        var codigo = query.TryGetValue("editar", out var editar) ? editar.ToString() : string.Empty;
        if (!string.IsNullOrWhiteSpace(codigo))
            await AbrirEditorAsync(codigo, updateUrl: false);
    }

    private Task HandlePageClickAsync() => Task.CompletedTask;

    private void DismissFeedback() => _feedback = null;

    private void SetFeedback(AppUiMessage? message) => _feedback = message;

    private void UpdatePageHeader()
    {
        if (_showEditor)
        {
            var editorActions = new List<PageHeaderAction>
            {
                new()
                {
                    Key = "guardar",
                    Label = _saving ? "Guardando..." : "Guardar",
                    Icon = "bi-floppy",
                    Style = PageHeaderActionStyle.Primary,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = _saving,
                    Busy = _saving,
                    OnClick = GuardarAsync
                },
                new()
                {
                    Key = "cancelar",
                    Label = "Cancelar",
                    Icon = "bi-x-circle",
                    Style = PageHeaderActionStyle.Ghost,
                    Priority = PageHeaderActionPriority.Essential,
                    Disabled = _saving,
                    OnClick = () => { CerrarEditor(); return Task.CompletedTask; }
                }
            };
            if (!_isNewMode && _selectedActivo)
            {
                editorActions.Add(new PageHeaderAction
                {
                    Key = "baja",
                    Label = "Dar de baja",
                    Icon = "bi-trash",
                    Style = PageHeaderActionStyle.Danger,
                    Priority = PageHeaderActionPriority.Overflow,
                    Disabled = _saving,
                    OnClick = () => { OpenDeactivateConfirm([_selectedCodigo]); return Task.CompletedTask; }
                });
            }

            PageHeader.Set(new PageHeaderConfig
            {
                Title = _isNewMode ? "Nuevo artículo" : $"Editar {_form.Descripcion}",
                Breadcrumb = ["Archivos", "Maestros", "Artículos"],
                State = _saving ? PageHeaderState.Loading : _isNewMode ? PageHeaderState.Creating : PageHeaderState.Editing,
                ShellMode = PageHeaderShellMode.AlfaDesignPilot,
                ModuleKey = "articulos",
                TopNavigationItems = [new() { Key = "articulos", Label = "Artículos", Url = RouteContext.BuildRoute("/articulos"), Active = true }],
                Actions = editorActions
            });
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        var actions = new List<PageHeaderAction>();
        if (_selectedCodes.Count > 0)
        {
            actions.Add(new PageHeaderAction { Key = "seleccion", Label = $"{_selectedCodes.Count} seleccionados", Icon = "bi-check2-square", Style = PageHeaderActionStyle.Ghost, Disabled = true });
            actions.Add(new PageHeaderAction { Key = "buscar-imagenes-masivo", Label = "Buscar imágenes", Icon = "bi-search", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Essential, Disabled = _loadingList, OnClick = AbrirBusquedaImagenBulkAsync });
            actions.Add(new PageHeaderAction { Key = "baja-masiva", Label = "Dar de baja", Icon = "bi-trash", Style = PageHeaderActionStyle.Danger, Priority = PageHeaderActionPriority.Essential, Disabled = _loadingList, OnClick = () => { OpenDeactivateConfirm(_selectedCodes.ToList()); return Task.CompletedTask; } });
            actions.Add(new PageHeaderAction { Key = "cancelar-seleccion", Label = "Cancelar selección", Icon = "bi-x-lg", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, OnClick = () => { _selectedCodes.Clear(); UpdatePageHeader(); return Task.CompletedTask; } });
        }

        actions.Add(new PageHeaderAction { Key = "nuevo", Label = "Nuevo artículo", Icon = "bi-plus-circle", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _loadingList, OnClick = BeginNewAsync });
        actions.Add(new PageHeaderAction { Key = "recargar", Label = "Recargar", Icon = "bi-arrow-clockwise", Style = PageHeaderActionStyle.Ghost, Disabled = _loadingList, OnClick = RecargarAsync });
        actions.Add(new PageHeaderAction { Key = "vista", Label = "Configurar vista", Icon = "bi-sliders", Style = PageHeaderActionStyle.Ghost, Priority = PageHeaderActionPriority.Overflow, Disabled = _loadingList, OnClick = () => { AbrirConfiguracionVista(); UpdatePageHeader(); return Task.CompletedTask; } });

        PageHeader.Set(new PageHeaderConfig
        {
            Title = "Artículos",
            Breadcrumb = ["Archivos", "Maestros", "Artículos"],
            State = _loadingList ? PageHeaderState.Loading : _selectedCodes.Count > 0 ? PageHeaderState.Selection : _viewMode == ArticuloViewModeKeys.Kanban ? PageHeaderState.Kanban : PageHeaderState.List,
            ShellMode = PageHeaderShellMode.AlfaDesignPilot,
            ModuleKey = "articulos",
            TopNavigationItems = [new() { Key = "articulos", Label = "Artículos", Url = RouteContext.BuildRoute("/articulos"), Active = true }],
            Search = new PageHeaderSearchConfig(),
            SearchContent = RenderArticulosSmartSearch(),
            Pagination = BuildHeaderPagination(),
            ViewButtons = BuildHeaderViewButtons(),
            Actions = actions
        });
        _ = InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<PageHeaderViewButton> BuildHeaderViewButtons() =>
    [
        new()
        {
            Key = "listado",
            Label = "Listado",
            Title = "Vista de listado",
            Icon = "bi-table",
            Active = _viewMode != ArticuloViewModeKeys.Kanban,
            Disabled = _loadingList,
            OnClick = () => SetViewModeAsync(ArticuloViewModeKeys.Listado)
        },
        new()
        {
            Key = "kanban",
            Label = "Kanban",
            Title = "Vista Kanban",
            Icon = "bi-kanban",
            Active = _viewMode == ArticuloViewModeKeys.Kanban,
            Disabled = _loadingList,
            OnClick = () => SetViewModeAsync(ArticuloViewModeKeys.Kanban)
        }
    ];

    private async Task SetViewModeAsync(string modo)
    {
        var normalizado = modo == ArticuloViewModeKeys.Kanban ? ArticuloViewModeKeys.Kanban : ArticuloViewModeKeys.Listado;
        if (_viewMode == normalizado)
            return;

        _viewMode = normalizado;
        _viewSettings.Vista = normalizado;
        UpdatePageHeader();

        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
            return;

        var result = await UiOps.RunAsync(async () => { await ArticulosSvc.SaveViewSettingsAsync(currentUser, _viewSettings); return true; }, "No se pudo guardar la vista seleccionada.");
        if (!result.Success)
            SetFeedback(result.Feedback);
    }

    private Task ToggleKanbanSelection(string codigo)
    {
        var normalizado = (codigo ?? string.Empty).Trim();
        if (normalizado.Length == 0)
            return Task.CompletedTask;

        if (!_selectedCodes.Add(normalizado))
            _selectedCodes.Remove(normalizado);

        UpdatePageHeader();
        return Task.CompletedTask;
    }

    private PageHeaderPaginationConfig BuildHeaderPagination() => new()
    {
        Label = $"{_pagedTotal:N0} registros",
        PageLabel = $"{_pageNumber} / {_totalPages}",
        HasPrevious = _hasPrev,
        HasNext = _hasNext,
        Disabled = _loadingList,
        OnPrevious = () => CambiarPaginaAsync(_pageNumber - 1),
        OnNext = () => CambiarPaginaAsync(_pageNumber + 1)
    };

    private RenderFragment RenderArticulosSmartSearch() => @<div class="smart-search" @onclick:stopPropagation @onkeydown="OnSearchKeyDownAsync">
        <div class="smart-search__bar">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   placeholder="Buscar por código, código de barras o descripción..."
                   value="@_filters.Texto"
                   @onfocus="OpenSearchPanel"
                   @oninput="OnSearchInput" />
            <button type="button" class="smart-search__toggle" @onclick="ToggleSearchPanel" aria-label="Mostrar filtros">
                <i class="bi @(_showSearchPanel ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
            </button>
        </div>

        @if (_showSearchPanel)
        {
            <div class="smart-search__panel">
                <div class="smart-search__column">
                    <h4><i class="bi bi-funnel-fill"></i> Estado</h4>
                    <button type="button" class="@GetSmartOptionClass(_filters.Activo == true)" @onclick="() => SetActivoFiltroAsync(true)">Activos</button>
                    <button type="button" class="@GetSmartOptionClass(_filters.Activo == false)" @onclick="() => SetActivoFiltroAsync(false)">Inactivos</button>
                    <button type="button" class="@GetSmartOptionClass(_filters.Activo == null)" @onclick="() => SetActivoFiltroAsync(null)">Todos</button>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-tag-fill"></i> Rubro</h4>
                    <AlfaLookup TItem="ArticuloLookupOptionDto"
                                Placeholder="Buscar rubro..."
                                MinimumCharacters="0"
                                SearchText="@_rubroFiltroTexto"
                                SearchTextChanged="v => _rubroFiltroTexto = v"
                                SearchFunc="BuscarRubrosFiltroAsync"
                                ItemKey="r => r.Codigo"
                                SelectedItem="@_rubroFiltroSeleccionado"
                                SelectedItemChanged="OnRubroFiltroSeleccionadoAsync">
                        <ItemTemplate Context="r">@r.Descripcion</ItemTemplate>
                    </AlfaLookup>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-award-fill"></i> Marca</h4>
                    <AlfaLookup TItem="ArticuloLookupOptionDto"
                                Placeholder="Buscar marca..."
                                MinimumCharacters="0"
                                SearchText="@_marcaFiltroTexto"
                                SearchTextChanged="v => _marcaFiltroTexto = v"
                                SearchFunc="BuscarMarcasFiltroAsync"
                                ItemKey="m => m.Codigo"
                                SelectedItem="@_marcaFiltroSeleccionado"
                                SelectedItemChanged="OnMarcaFiltroSeleccionadoAsync">
                        <ItemTemplate Context="m">@m.Descripcion</ItemTemplate>
                    </AlfaLookup>
                </div>
                <div class="smart-search__column">
                    <h4><i class="bi bi-stack"></i> Agrupar por</h4>
                    <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == ArticuloViewGroupKeys.None)" @onclick="() => SetGroupAsync(ArticuloViewGroupKeys.None)">Sin agrupar</button>
                    <button type="button" class="@GetSmartOptionClass(_viewSettings.AgruparPor == ArticuloViewGroupKeys.Rubro)" @onclick="() => SetGroupAsync(ArticuloViewGroupKeys.Rubro)">Rubro</button>
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarFiltrosAsync">
                        <i class="bi bi-eraser"></i> Limpiar filtros
