    private static decimal ParseDecimal(string? value)
        => decimal.TryParse((value ?? string.Empty).Trim().Replace(",", "."),
            System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;

    /// <summary>Mismo cálculo bidireccional Precio&lt;-&gt;Costo&lt;-&gt;Utilidad que
    /// CalcularUtlPrecio en FrmArtAlta.frm: si el precio incluye IVA (Cfg MaestroArticuloConIva), el
    /// margen se calcula sobre el precio neto de IVA.</summary>
    private Task OnCostoChangedAsync(string? value)
    {
        _form.Costo = ParseDecimal(value);
        if (_form.Utilidad > 0)
            RecalcularPrecioDesdeUtilidad();
        return Task.CompletedTask;
    }

    private Task OnUtilidadChangedAsync(string? value)
    {
        _form.Utilidad = ParseDecimal(value);
        RecalcularPrecioDesdeUtilidad();
        return Task.CompletedTask;
    }

    private Task OnPrecioChangedAsync(string? value)
    {
        _form.Precio = ParseDecimal(value);
        RecalcularUtilidadDesdePrecio();
        return Task.CompletedTask;
    }

    private void RecalcularPrecioDesdeUtilidad()
    {
        var precio = _form.Costo + (_form.Utilidad * _form.Costo / 100m);
        if (_lookups.PrecioIncluyeIva && !_form.Exento)
        {
            var alicuota = _form.TasaIva > 0 ? _form.TasaIva : _lookups.TasaIvaDefault;
            precio *= 1 + (alicuota / 100m);
        }

        _form.Precio = Math.Round(precio, 2);
    }

    private void RecalcularUtilidadDesdePrecio()
    {
        if (_form.Costo <= 0)
            return;

        var precioNeto = _form.Precio;
        if (_lookups.PrecioIncluyeIva && !_form.Exento)
        {
            var alicuota = _form.TasaIva > 0 ? _form.TasaIva : _lookups.TasaIvaDefault;
            precioNeto /= 1 + (alicuota / 100m);
        }

        _form.Utilidad = _form.Costo >= precioNeto ? 0 : Math.Round(((precioNeto * 100m) / _form.Costo) - 100m, 2);
    }

