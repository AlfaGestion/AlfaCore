    private List<ArticuloViewColumnDto> GetVisibleColumns()
        => _viewSettings.Columnas.Where(c => c.Visible).OrderBy(c => c.Order).ToList();

    private sealed record ArticuloGridGroup(string Label, bool ShowHeader, List<ArticuloGridItemDto> Items);

    private List<ArticuloGridGroup> BuildGridGroups()
    {
        if (_viewSettings.AgruparPor != ArticuloViewGroupKeys.Rubro)
            return [new ArticuloGridGroup(string.Empty, false, _items)];

        return _items
            .GroupBy(i => string.IsNullOrWhiteSpace(i.RubroDescripcion) ? "Sin rubro" : i.RubroDescripcion)
            .OrderBy(g => g.Key)
            .Select(g => new ArticuloGridGroup(g.Key, true, g.ToList()))
            .ToList();
    }

    private static string GetColumnCssClass(string key) => $"articulos-col articulos-col--{key}";

    private RenderFragment RenderCell(ArticuloGridItemDto item, string key) => builder =>
    {
        var text = key switch
        {
            ArticuloViewColumnKeys.Codigo => item.Codigo,
            ArticuloViewColumnKeys.CodigoBarra => item.CodigoBarra,
            ArticuloViewColumnKeys.Descripcion => item.Descripcion,
            ArticuloViewColumnKeys.Rubro => item.RubroDescripcion,
            ArticuloViewColumnKeys.Marca => item.MarcaDescripcion,
            ArticuloViewColumnKeys.Unidad => item.UnidadDescripcion,
            ArticuloViewColumnKeys.Costo => item.Costo.ToString("N2"),
            ArticuloViewColumnKeys.Precio => item.Precio.ToString("N2"),
            ArticuloViewColumnKeys.TasaIva => item.TasaIva.ToString("N2"),
            _ => string.Empty
        };
        builder.AddContent(0, text);
    };

    private async Task EnsureViewSettingsLoadedAsync(bool force = false)
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (!force && _viewSettingsLoaded && string.Equals(_viewSettingsUserName, currentUser, StringComparison.OrdinalIgnoreCase))
            return;

        if (string.IsNullOrWhiteSpace(currentUser))
        {
            _viewSettings = BuildDefaultViewSettings();
            _viewMode = _viewSettings.Vista;
            _viewSettingsLoaded = true;
            return;
        }

        var result = await UiOps.RunAsync(() => ArticulosSvc.GetViewSettingsAsync(currentUser), "No se pudo cargar la configuración de vista.");
        _viewSettings = result.Success && result.Value is not null ? result.Value : BuildDefaultViewSettings();
        _viewMode = _viewSettings.Vista == ArticuloViewModeKeys.Kanban ? ArticuloViewModeKeys.Kanban : ArticuloViewModeKeys.Listado;
        if (!result.Success)
            SetFeedback(result.Feedback);

        _viewSettingsUserName = currentUser;
        _viewSettingsLoaded = true;
    }

    private static ArticuloViewSettingsDto BuildDefaultViewSettings() => new()
    {
        Columnas =
        [
            new() { Key = ArticuloViewColumnKeys.Codigo, Label = "Código", Visible = true, Order = 0 },
            new() { Key = ArticuloViewColumnKeys.Descripcion, Label = "Descripción", Visible = true, Order = 1 },
            new() { Key = ArticuloViewColumnKeys.Rubro, Label = "Rubro", Visible = true, Order = 2 },
            new() { Key = ArticuloViewColumnKeys.Costo, Label = "Costo", Visible = true, Order = 3 },
            new() { Key = ArticuloViewColumnKeys.Precio, Label = "Precio", Visible = true, Order = 4 }
        ]
    };

    private void AbrirConfiguracionVista()
    {
        _showViewSettings = true;
        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(_viewSettings.Columnas.Select(c => new ArticuloViewColumnDto { Key = c.Key, Label = c.Label, Visible = c.Visible, Order = c.Order }));
    }

    private void CancelarConfiguracionVista()
    {
        _showViewSettings = false;
        _viewSettingsDraft.Clear();
    }

    private void SetColumnVisibility(string key, bool? visible)
    {
        var column = _viewSettingsDraft.FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        if (column is not null)
            column.Visible = visible == true;
    }

    private void MoveColumn(string key, int delta)
    {
        var ordered = _viewSettingsDraft.OrderBy(c => c.Order).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
        var target = index + delta;
        if (index < 0 || target < 0 || target >= ordered.Count)
            return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++)
            ordered[i].Order = i;

        _viewSettingsDraft.Clear();
        _viewSettingsDraft.AddRange(ordered);
    }

    private async Task GuardarConfiguracionVistaAsync()
    {
        var currentUser = AppUserSession.GetCurrentUserName(string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(currentUser))
        {
            SetFeedback(AppUiMessage.Warning("Configurar vista", "No hay un usuario logueado para guardar la configuración."));
            return;
        }

        _savingViewSettings = true;
        try
        {
            var nueva = new ArticuloViewSettingsDto { Columnas = _viewSettingsDraft.OrderBy(c => c.Order).ToList() };
            var result = await UiOps.RunAsync(async () => { await ArticulosSvc.SaveViewSettingsAsync(currentUser, nueva); return true; }, "No se pudo guardar la configuración de vista.");
            if (!result.Success)
            {
                SetFeedback(result.Feedback);
                return;
            }

            _viewSettings = nueva;
            _showViewSettings = false;
            SetFeedback(AppUiMessage.Success("Vista guardada", "La configuración de columnas se guardó correctamente."));
        }
        finally
        {
            _savingViewSettings = false;
        }
    }
