    </div>;

    private void OpenSearchPanel()
    {
        _showSearchPanel = true;
        UpdatePageHeader();
    }

    private void ToggleSearchPanel()
    {
        _showSearchPanel = !_showSearchPanel;
        UpdatePageHeader();
    }

    private void CloseSearchPanel()
    {
        _showSearchPanel = false;
        UpdatePageHeader();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _filters.Texto = e.Value?.ToString() ?? string.Empty;
        UpdatePageHeader();
        DebounceSearch();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            CloseSearchPanel();
            return;
        }

        if (!string.Equals(e.Key, "Enter", StringComparison.OrdinalIgnoreCase))
            return;

        _searchDebounceCts?.Cancel();
        _filters.PageNumber = 1;
        CloseSearchPanel();
        await BuscarAsync();
        UpdatePageHeader();
    }

    private void DebounceSearch()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounceCts = cts;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(300, cts.Token);
                if (cts.IsCancellationRequested)
                    return;

                _filters.PageNumber = 1;
                await BuscarAsync();
                UpdatePageHeader();
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private static string GetSmartOptionClass(bool active) => active ? "smart-option is-active" : "smart-option";

    private async Task SetActivoFiltroAsync(bool? valor)
    {
        _filters.Activo = valor;
        await AplicarFiltrosAsync();
    }

    private async Task SetGroupAsync(string grupo)
    {
        _viewSettings.AgruparPor = grupo;
        await AplicarFiltrosAsync();
    }

    private Task<IReadOnlyList<ArticuloLookupOptionDto>> BuscarRubrosFiltroAsync(string texto, CancellationToken ct)
        => Task.FromResult(FiltrarLookup(_lookups.Rubros, texto));

    private Task<IReadOnlyList<ArticuloLookupOptionDto>> BuscarMarcasFiltroAsync(string texto, CancellationToken ct)
        => Task.FromResult(FiltrarLookup(_lookups.Marcas, texto));

    private static IReadOnlyList<ArticuloLookupOptionDto> FiltrarLookup(IReadOnlyList<ArticuloLookupOptionDto> lista, string texto)
    {
        var t = (texto ?? string.Empty).Trim();
        var query = t.Length == 0
            ? lista
            : lista.Where(x => x.Descripcion.Contains(t, StringComparison.OrdinalIgnoreCase) || x.Codigo.Contains(t, StringComparison.OrdinalIgnoreCase));
        return query.Take(30).ToList();
    }

    private async Task OnRubroFiltroSeleccionadoAsync(ArticuloLookupOptionDto? item)
    {
        _rubroFiltroSeleccionado = item;
        _rubroFiltroTexto = item?.Descripcion ?? string.Empty;
        _filters.RubroCodigo = item?.Codigo ?? string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task OnMarcaFiltroSeleccionadoAsync(ArticuloLookupOptionDto? item)
    {
        _marcaFiltroSeleccionado = item;
        _marcaFiltroTexto = item?.Descripcion ?? string.Empty;
        _filters.MarcaCodigo = item?.Codigo ?? string.Empty;
        await AplicarFiltrosAsync();
    }

    private async Task LoadLookupsAsync()
    {
        var result = await UiOps.RunAsync(() => ArticulosSvc.GetLookupDataAsync(), "No se pudieron cargar las referencias de artículos.");
        _lookups = result.Success && result.Value is not null ? result.Value : new ArticuloLookupDataDto();
        if (!result.Success)
            SetFeedback(result.Feedback);

        // Se resuelve una sola vez acá (no en cada tarjeta) para que la vista Kanban pueda armar la
        // miniatura de cada artículo sin ida y vuelta al servidor por ítem.
        try
        {
            _ftpCodigoCta = await ArticulosSvc.GetFtpCodigoCtaAsync();
        }
        catch
        {
            _ftpCodigoCta = null;
        }
    }

    private async Task BuscarAsync()
    {
        _listLoadFailed = false;
        _loadingList = true;
        UpdatePageHeader();
        try
        {
            var result = await UiOps.RunAsync(() => ArticulosSvc.SearchAsync(_filters), "No se pudieron cargar los artículos.");
            if (!result.Success || result.Value is null)
            {
                _listLoadFailed = true;
                _items.Clear();
                _pagedTotal = 0;
                _pageNumber = 1;
                _totalPages = 1;
                _hasPrev = false;
                _hasNext = false;
                SetFeedback(result.Feedback);
                return;
            }

            _items.Clear();
            _items.AddRange(result.Value.Items);
            _selectedCodes.IntersectWith(_items.Select(i => i.Codigo));
            _pagedTotal = result.Value.Total;
            _pageNumber = result.Value.PageNumber;
            _totalPages = Math.Max(1, result.Value.TotalPages);
            _hasPrev = result.Value.HasPrev;
            _hasNext = result.Value.HasNext;
        }
        finally
        {
            _loadingList = false;
            UpdatePageHeader();
        }
    }

    private async Task AplicarFiltrosAsync()
    {
        _filters.PageNumber = 1;
        await BuscarAsync();
        UpdatePageHeader();
    }

    private async Task LimpiarFiltrosAsync()
    {
        _filters = new ArticuloFilters();
        _viewSettings.AgruparPor = ArticuloViewGroupKeys.None;
        _rubroFiltroTexto = string.Empty;
        _rubroFiltroSeleccionado = null;
        _marcaFiltroTexto = string.Empty;
        _marcaFiltroSeleccionado = null;
        await AplicarFiltrosAsync();
    }

    private async Task CambiarPaginaAsync(int pagina)
    {
        if (pagina < 1 || pagina > _totalPages || pagina == _pageNumber)
            return;

        _filters.PageNumber = pagina;
        await BuscarAsync();
        UpdatePageHeader();
    }

    private async Task SetPageSizeAsync(string? value)
    {
        if (!int.TryParse(value, out var size) || size <= 0)
            return;

        _filters.PageSize = size;
        _filters.PageNumber = 1;
        await BuscarAsync();
        UpdatePageHeader();
    }

    private async Task RecargarAsync()
    {
        await LoadLookupsAsync();
        await EnsureViewSettingsLoadedAsync(force: true);
        await BuscarAsync();
        UpdatePageHeader();
    }

    private bool IsSelected(ArticuloGridItemDto item) => string.Equals(_selectedCodigo, item.Codigo, StringComparison.OrdinalIgnoreCase);

    private bool AreAllCurrentPageSelected => _items.Count > 0 && _items.All(i => _selectedCodes.Contains(i.Codigo));

    private void ToggleRowSelection(string codigo, ChangeEventArgs args)
    {
        var normalized = (codigo ?? string.Empty).Trim();
        if (normalized.Length == 0)
            return;

        if (args.Value is bool flag && flag)
            _selectedCodes.Add(normalized);
        else
            _selectedCodes.Remove(normalized);

        UpdatePageHeader();
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var shouldSelect = args.Value is bool flag && flag;
        foreach (var codigo in _items.Select(i => i.Codigo).Where(c => !string.IsNullOrWhiteSpace(c)))
        {
            if (shouldSelect)
                _selectedCodes.Add(codigo);
            else
                _selectedCodes.Remove(codigo);
        }

        UpdatePageHeader();
    }

    private IReadOnlyList<AlfaActionMenuItem> BuildRowActions(ArticuloGridItemDto item) =>
    [
        new() { Label = "Editar", Icon = "bi bi-pencil", OnClick = () => AbrirEditorAsync(item.Codigo) },
        new() { Label = "Dar de baja", Icon = "bi bi-trash", Danger = true, Disabled = !item.Activo, OnClick = () => { OpenDeactivateConfirm([item.Codigo]); return Task.CompletedTask; } }
    ];

    private async Task BeginNewAsync()
    {
        _showEditor = true;
        _showViewSettings = false;
        _isNewMode = true;
        _selectedCodigo = string.Empty;
        _selectedActivo = true;
        _activeTab = ArticuloTab.Datos;
        _form = new ArticuloSaveRequest { TasaIva = _lookups.TasaIvaDefault };
        _rubroSeleccionado = null;
        _marcaSeleccionada = null;
        _unidadSeleccionada = null;
        _proveedorTexto = string.Empty;
        _proveedorSeleccionado = null;
        _imagenUrl = string.Empty;
        UpdatePageHeader();
        await Task.CompletedTask;
    }

    private async Task AbrirEditorAsync(string codigo, bool updateUrl = true)
    {
        if (updateUrl)
        {
            var target = QueryHelpers.AddQueryString(Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath, "editar", codigo);
            var current = Nav.ToBaseRelativePath(Nav.Uri);
            if (!string.Equals(current, target.TrimStart('/'), StringComparison.Ordinal))
                Nav.NavigateTo(target);
        }

        _showEditor = true;
        _showViewSettings = false;
        UpdatePageHeader();
        await SeleccionarAsync(codigo);
    }

    private async Task SeleccionarAsync(string codigo)
    {
        var result = await UiOps.RunAsync(() => ArticulosSvc.GetByIdAsync(codigo), "No se pudo cargar el artículo.");
        if (!result.Success)
        {
            SetFeedback(result.Feedback);
            return;
        }

        if (result.Value is null)
        {
            SetFeedback(AppUiMessage.Warning("Artículo no disponible", "El artículo seleccionado ya no existe en la base activa."));
            await BuscarAsync();
            return;
        }

        _isNewMode = false;
        _selectedCodigo = result.Value.Codigo;
        _selectedActivo = result.Value.Activo;
        _activeTab = ArticuloTab.Datos;
        _form = result.Value;
        _rubroSeleccionado = _lookups.Rubros.FirstOrDefault(r => string.Equals(r.Codigo, _form.RubroCodigo, StringComparison.OrdinalIgnoreCase));
        _marcaSeleccionada = _lookups.Marcas.FirstOrDefault(m => string.Equals(m.Codigo, _form.MarcaCodigo, StringComparison.OrdinalIgnoreCase));
        _unidadSeleccionada = _lookups.Unidades.FirstOrDefault(u => string.Equals(u.Codigo, _form.UnidadCodigo, StringComparison.OrdinalIgnoreCase));
        _proveedorSeleccionado = string.IsNullOrWhiteSpace(_form.CuentaProveedor)
            ? null
            : new ArticuloLookupOptionDto { Codigo = _form.CuentaProveedor, Descripcion = result.Value.CuentaProveedorNombre };
        _proveedorTexto = _proveedorSeleccionado is null ? string.Empty : $"{_proveedorSeleccionado.Codigo} -- {_proveedorSeleccionado.Descripcion}";
        UpdatePageHeader();
        await LoadImagenAsync();
    }

    private async Task LoadImagenAsync()
    {
        try
        {
            _imagenUrl = await ArticulosSvc.GetImagenUrlAsync(_form.Codigo);
        }
        catch
        {
            // La imagen es un dato secundario -- si falla resolverla no bloqueamos la edición del
            // artículo, simplemente no se muestra.
            _imagenUrl = string.Empty;
        }
    }

    private async Task HandleImagenSeleccionadaAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null || _isNewMode)
            return;

        _subiendoImagen = true;
        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var extension = Path.GetExtension(file.Name);

            var result = await UiOps.RunAsync(async () => { await ArticulosSvc.UploadImagenAsync(_form.Codigo, bytes, extension); return true; }, "No se pudo subir la imagen del artículo.");
            if (result.Success)
            {
                _imagenUrl = await ArticulosSvc.GetImagenUrlAsync(_form.Codigo, forzarRecarga: true);
                SetFeedback(AppUiMessage.Success("Imagen actualizada", "La imagen del artículo se guardó correctamente."));
            }
            else
            {
                SetFeedback(result.Feedback);
            }
        }
        finally
        {
            _subiendoImagen = false;
        }
    }

    // Búsqueda automática de imágenes (código de barras/descripción) -- reusa el mismo diálogo
    // compartido que ya usa Interfaces > Catálogos (BaseMaestraImagenesDialog / BaseMaestraImagenService:
    // Base Maestra oficial, sitios de supermercados y Google Images), en vez de construir un buscador
    // nuevo para Artículos.
    private async Task AbrirBusquedaImagenAsync()
    {
        if (_isNewMode)
            return;

        _ftpCodigoCta ??= await ArticulosSvc.GetFtpCodigoCtaAsync();
        if (string.IsNullOrWhiteSpace(_ftpCodigoCta))
        {
            SetFeedback(AppUiMessage.Warning("Buscar en internet", "No se pudo determinar el código de cliente FTP para buscar/guardar imágenes."));
            return;
        }

        _buscarImagenOrigen =
        [
            new BaseMaestraImagenOrigenDto
            {
                IdArticulo = _form.Codigo,
                DescripcionArticulo = _form.Descripcion,
                CodigoBarra = _form.CodigoBarra,
                TieneImagenActual = !string.IsNullOrWhiteSpace(_imagenUrl)
            }
        ];
        // Búsqueda de UN artículo puntual y explícito -- el usuario ya sabe que puede tener o no
        // imagen, así que mostramos el resultado directo en vez del gate pensado para la búsqueda en
        // lote (ver AbrirBusquedaImagenBulkAsync, que sí necesita filtrar los que ya tienen imagen).
        _incluirExistentesEnBusqueda = true;
        _showBuscarImagenModal = true;
    }

    private Task CerrarBusquedaImagenAsync()
    {
        _showBuscarImagenModal = false;
        return Task.CompletedTask;
    }

    /// <summary>Versión en lote: busca y asigna automáticamente (la primera imagen encontrada por
    /// artículo) para todos los seleccionados en la lista, reutilizando el mismo diálogo
    /// -- BaseMaestraImagenesDialog ya soporta N artículos, acá solo cambia de dónde sale la lista
    /// (la selección de la grilla en vez del único artículo abierto en el editor).</summary>
    private async Task AbrirBusquedaImagenBulkAsync()
    {
        if (_selectedCodes.Count == 0)
            return;

        _ftpCodigoCta ??= await ArticulosSvc.GetFtpCodigoCtaAsync();
        if (string.IsNullOrWhiteSpace(_ftpCodigoCta))
        {
            SetFeedback(AppUiMessage.Warning("Buscar imágenes", "No se pudo determinar el código de cliente FTP para buscar/guardar imágenes."));
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        _buscarImagenOrigen = _items
            .Where(i => _selectedCodes.Contains(i.Codigo))
            .Select(i => new BaseMaestraImagenOrigenDto
            {
                IdArticulo = i.Codigo,
                DescripcionArticulo = i.Descripcion,
                CodigoBarra = i.CodigoBarra,
                TieneImagenActual = false
            })
            .ToList();

        if (_buscarImagenOrigen.Count == 0)
            return;

        _incluirExistentesEnBusqueda = false;
        _showBuscarImagenModal = true;
        // Invocado desde una PageHeaderAction del topbar (MainPageHeader, componente distinto de esta
        // página) -- sin este StateHasChanged explícito el diálogo queda armado pero invisible hasta
        // que algo más fuerce un render (por eso "Recargar" lo hacía aparecer). Mismo bug que
        // OpenDeactivateConfirm más abajo.
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnImagenAsignadaAsync(BaseMaestraImagenResultadoDto resultado)
    {
        _showBuscarImagenModal = false;
        if (resultado.Asignadas <= 0)
        {
            SetFeedback(AppUiMessage.Info("Buscar en internet", "No se asignó ninguna imagen."));
            return;
        }

        SetFeedback(AppUiMessage.Success("Imágenes actualizadas", $"{resultado.Asignadas} imagen(es) se guardaron correctamente."));
        if (_showEditor)
            _imagenUrl = await ArticulosSvc.GetImagenUrlAsync(_form.Codigo, forzarRecarga: true);
        else
            await BuscarAsync();
    }

    private void CerrarEditor()
    {
        _showEditor = false;
        UpdatePageHeader();

        // Saca el ?editar= de la URL -- si no lo hacemos, ApplyCurrentLocationAsync lo vuelve a leer
        // ante cualquier LocationChanged posterior (los hay, disparados desde MainLayout) y reabre el
        // editor solo, aunque el usuario ya haya cancelado/guardado.
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath;
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        if (!string.Equals(current, path.TrimStart('/'), StringComparison.Ordinal))
            Nav.NavigateTo(path);
    }

    private async Task GuardarAsync()
    {
        _saving = true;
        UpdatePageHeader();
        try
        {
            var savedCode = await ArticulosSvc.SaveAsync(_form);
            SetFeedback(AppUiMessage.Success("Artículo guardado", $"El artículo {savedCode} se guardó correctamente."));
            CerrarEditor();
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            SetFeedback(UiOps.BuildMessage(ex, "No se pudo guardar el artículo."));
        }
        finally
        {
            _saving = false;
            UpdatePageHeader();
        }
    }

    private void OpenDeactivateConfirm(List<string> codigos)
    {
        if (codigos.Count == 0 || _saving)
            return;

        _pendingDeactivateCodes.Clear();
        _pendingDeactivateCodes.AddRange(codigos);
        _showDeactivateConfirm = true;
        // Se llama tanto desde el menú de la fila (ya dispara render solo, vive en el árbol de esta
        // página) como desde una PageHeaderAction del topbar (la dispara MainPageHeader, un
        // componente distinto -- sin este StateHasChanged explícito, el diálogo queda armado pero
        // invisible). Ver [[feedback_alfadesign_shell_modulos_nuevos]] para el mismo patrón de bug.
        _ = InvokeAsync(StateHasChanged);
    }

    private void CloseDeactivateConfirm()
    {
        if (_saving)
            return;

        _showDeactivateConfirm = false;
        _pendingDeactivateCodes.Clear();
    }

    private string GetDeactivateMessage()
        => _pendingDeactivateCodes.Count > 1
            ? $"Vas a dar de baja {_pendingDeactivateCodes.Count} artículos seleccionados."
            : $"Vas a dar de baja el artículo {(_pendingDeactivateCodes.FirstOrDefault() ?? string.Empty)}.";

    private async Task ConfirmDeactivateAsync()
    {
        _saving = true;
        try
        {
            foreach (var codigo in _pendingDeactivateCodes)
            {
                var result = await UiOps.RunAsync(() => ArticulosSvc.DeactivateAsync(codigo), "No se pudo dar de baja el artículo.");
                if (!result.Success)
                {
                    SetFeedback(result.Feedback);
                    return;
                }
            }

            SetFeedback(AppUiMessage.Success("Artículos dados de baja", "Los artículos seleccionados quedaron inactivos."));
            _selectedCodes.Clear();
            _showDeactivateConfirm = false;
            var afectaEditor = !string.IsNullOrWhiteSpace(_selectedCodigo) && _pendingDeactivateCodes.Contains(_selectedCodigo, StringComparer.OrdinalIgnoreCase);
            _pendingDeactivateCodes.Clear();
            if (afectaEditor)
                _showEditor = false;

            await BuscarAsync();
            UpdatePageHeader();
        }
        finally
        {
            _saving = false;
        }
    }

