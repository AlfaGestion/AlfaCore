<AlfaLookup TItem="ConciliacionAsientoCuenta" Label="@Label" Placeholder="Rubro y detalle, ej. gastos libreria"
    SearchText="@_texto" SearchTextChanged="v=>_texto=v" SelectedItem="@_seleccion" SelectedItemChanged="Elegir"
    SearchFunc="Buscar" ItemKey="c=>c.Codigo" Disabled="Disabled" MinimumCharacters="1">
    <ItemTemplate Context="c">@c.Codigo · @c.Descripcion@(c.Rubro.Length>0 ? $"  ({c.Rubro})" : "")</ItemTemplate>
</AlfaLookup>
@code {
    [Parameter] public string Label { get; set; }="Contrapartida";
    [Parameter] public string Cuenta { get; set; }="";
    [Parameter] public EventCallback<string> CuentaChanged { get; set; }
    [Parameter] public IReadOnlyList<ConciliacionAsientoCuenta> Cuentas { get; set; }=[];
    [Parameter] public bool Disabled { get; set; }
    private string _texto="",_anterior="";
    private ConciliacionAsientoCuenta? _seleccion;
    protected override void OnParametersSet() {
        // Solo se reinicia el texto si la cuenta cambió desde afuera (ej. al elegir un concepto); no al tipear.
        if(Cuenta==_anterior)return;
        _anterior=Cuenta;_seleccion=Cuentas.FirstOrDefault(c=>c.Codigo==Cuenta);
        _texto=_seleccion is null ? "" : $"{_seleccion.Codigo} · {_seleccion.Descripcion}";
    }
    private Task<IReadOnlyList<ConciliacionAsientoCuenta>> Buscar(string texto,CancellationToken ct) {
        ct.ThrowIfCancellationRequested();
        return Task.FromResult(Filtrar(Cuentas,texto));
    }
    /// <summary>Cada palabra escrita debe aparecer en el código, el nombre o el rubro (en cualquier orden): "gastos libreria" acota dentro de los gastos.</summary>
    internal static IReadOnlyList<ConciliacionAsientoCuenta> Filtrar(IReadOnlyList<ConciliacionAsientoCuenta> cuentas,string texto) {
        var palabras=texto.Split(' ',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
        return cuentas.Where(c=>palabras.All(p=>c.Codigo.Contains(p,StringComparison.OrdinalIgnoreCase)||c.Descripcion.Contains(p,StringComparison.OrdinalIgnoreCase)||c.Rubro.Contains(p,StringComparison.OrdinalIgnoreCase))).Take(30).ToList();
    }
    private async Task Elegir(ConciliacionAsientoCuenta? cuenta) {
        _seleccion=cuenta;_anterior=cuenta?.Codigo ?? "";
        if(cuenta is not null)_texto=$"{cuenta.Codigo} · {cuenta.Descripcion}";
        await CuentaChanged.InvokeAsync(_anterior);
    }
}
