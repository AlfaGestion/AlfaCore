@using AlfaCore.Services
@inject IContabilidadReportesService Service
@inject IPlanCuentasAbmService PlanAbm
@inject ISessionService Sessions
@inject IAppUiOperationService UiOps
@inject IPageHeaderService PageHeader
@inject IRouteContextService RouteContext
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Titulo | Alfa Gestión</PageTitle>

@* Reportes contables (Gestión Contable → Reportes del legacy): Mayor de cuentas y Balance de sumas y saldos. *@
<div class="gd-page gd ctr-page">
    <AlfaNotification Message="@_feedback" OnDismiss="() => _feedback = null" />

    <section class="ctr-filtros" aria-label="Filtros del reporte" @onkeydown="TeclaAsync">
        @if (!EsPlan)
        {
            <div class="ctr-filtros__ejercicio">
                <AlfaSelect Label="Ejercicio" Value="@_filtro.Periodo.ToString()" ValueChanged="v => CambiarEjercicio(v)" Options="@EjercicioOptions" Disabled="@_busy" />
            </div>
            @if (!EsBalanceGeneral)
            {
                <AlfaInput Type="date" Label="Desde" Value="@Fecha(_filtro.Desde)" ValueChanged="v => { if (Leer(v) is { } d) _filtro.Desde = d; }" Disabled="@_busy" />
            }
            <AlfaInput Type="date" Label="@(EsBalanceGeneral ? "Saldos al" : "Hasta")" Value="@Fecha(_filtro.Hasta)" ValueChanged="v => { if (Leer(v) is { } d) _filtro.Hasta = d; }" Disabled="@_busy" />
            <div class="ctr-filtros__unidad">
                <AlfaSelect Label="Unidad de negocio" Value="@(_filtro.Unidades.FirstOrDefault() ?? "")" ValueChanged="v => _filtro.Unidades = string.IsNullOrEmpty(v) ? [] : [v]"
                            Options="@UnidadOptions" Disabled="@_busy" />
            </div>
        }
        @if (EsDiario || EsSubdiarios)
        {
            <div class="ctr-filtros__unidad">
                <AlfaSelect Label="Subdiario" Value="@_filtro.Subdiario" ValueChanged="v => _filtro.Subdiario = v ?? string.Empty" Options="@SubdiarioOptions" Disabled="@_busy" />
            </div>
        }
        @if (EsBalanceGeneral)
        {
            <div class="ctr-filtros__unidad">
                <AlfaSelect Label="Detalle hasta el nivel" Value="@_filtro.NivelMaximo.ToString()" ValueChanged="v => _filtro.NivelMaximo = int.TryParse(v, out var n) ? n : 0" Options="@NivelOptions" Disabled="@_busy" />
            </div>
        }
        @if (EsMayor)
        {
            <div class="ctr-filtros__cuenta">
                <AlfaLookup TItem="ContabilidadOpcion" Label="Cuenta (o título: todas sus cuentas)" Placeholder="Código o nombre de la cuenta"
                            MinimumCharacters="1" @bind-SearchText="_cuentaTexto" SelectedItem="_cuenta" SelectedItemChanged="CuentaElegida"
                            SearchFunc="Service.BuscarCuentasAsync" ItemKey="x => x.Codigo" Disabled="@_busy">
                    <ItemTemplate Context="c">@c.Descripcion</ItemTemplate>
                </AlfaLookup>
            </div>
            <div class="ctr-filtros__cuenta ctr-filtros__cuenta--hasta">
                <AlfaLookup TItem="ContabilidadOpcion" Label="Hasta la cuenta (opcional)" Placeholder="Rango de cuentas"
                            MinimumCharacters="1" @bind-SearchText="_cuentaHastaTexto" SelectedItem="_cuentaHasta" SelectedItemChanged="CuentaHastaElegida"
                            SearchFunc="Service.BuscarCuentasAsync" ItemKey="x => x.Codigo" Disabled="@_busy">
                    <ItemTemplate Context="c">@c.Descripcion</ItemTemplate>
                </AlfaLookup>
            </div>
        }
        <div class="ctr-filtros__checks">
            @if (EsSubdiarios)
            {
                <AlfaCheckbox Value="@_filtro.Resumido" ValueChanged="v => _filtro.Resumido = v == true" Disabled="@_busy">Resumido: totales por cuenta</AlfaCheckbox>
            }
            @if (EsBalanceGeneral)
            {
                <AlfaCheckbox Value="@_filtro.Comparativo" ValueChanged="v => _filtro.Comparativo = v == true" Disabled="@_busy">Comparativo con el ejercicio anterior</AlfaCheckbox>
            }
            @if (EsPlan)
            {
                <AlfaCheckbox Value="@_filtro.PlanIncluirTerceros" ValueChanged="v => _filtro.PlanIncluirTerceros = v == true" Disabled="@_busy">Incluir cuentas de clientes y proveedores</AlfaCheckbox>
                <AlfaCheckbox Value="@_filtro.PlanIncluirBaja" ValueChanged="v => _filtro.PlanIncluirBaja = v == true" Disabled="@_busy">Incluir dadas de baja</AlfaCheckbox>
            }
            @if (EsSumas)
            {
                <AlfaCheckbox Value="@_filtro.AgruparTerceros" ValueChanged="v => _filtro.AgruparTerceros = v == true" Disabled="@_busy">Agrupar clientes y proveedores</AlfaCheckbox>
                <AlfaCheckbox Value="@_filtro.MostrarTitulos" ValueChanged="v => _filtro.MostrarTitulos = v == true" Disabled="@_busy">Mostrar títulos</AlfaCheckbox>
                <AlfaCheckbox Value="@_filtro.IncluirSinMovimientos" ValueChanged="v => _filtro.IncluirSinMovimientos = v == true" Disabled="@_busy">Cuentas sin movimientos</AlfaCheckbox>
            }
            @if (_catalogos?.PuedeVerProformas == true && !EsPlan)
            {
                <AlfaCheckbox Value="@_filtro.IncluirProformas" ValueChanged="v => _filtro.IncluirProformas = v == true" Disabled="@_busy">Incluir proformas</AlfaCheckbox>
            }
        </div>
        <AlfaButton Variant="AlfaButtonVariant.Primary" Icon="bi bi-play-fill" Loading="@_busy" Disabled="@_busy" OnClick="_ => GenerarAsync()">Generar</AlfaButton>
    </section>

    @if (!EsMayor && _sumas is { } s)
    {
        <div class="kpi-grid ctr-kpis">
            <KpiCard Titulo="Debe del período" Valor="@Moneda(s.TotalDebe)" Icono="@Icono("bi-plus-slash-minus")" Descripcion="@($"{s.Filtro.Desde:dd/MM/yyyy} al {s.Filtro.Hasta:dd/MM/yyyy}")" />
            <KpiCard Titulo="Haber del período" Valor="@Moneda(s.TotalHaber)" Icono="@Icono("bi-plus-slash-minus")" Descripcion="@s.Ejercicio" />
            <KpiCard Titulo="Diferencia" Valor="@Moneda(s.TotalDebe - s.TotalHaber)" Icono="@Icono(s.Desbalanceados.Count == 0 ? "bi-check2-circle" : "bi-exclamation-triangle")"
                     Destacado="@(s.Desbalanceados.Count > 0)" Descripcion="@(s.Desbalanceados.Count == 0 ? "Todos los asientos balancean" : $"{s.Desbalanceados.Count} asiento(s) no balancean")" />
            <KpiCard Titulo="Cuentas" Valor="@s.Filas.Count(f => !f.EsTitulo).ToString("N0")" Icono="@Icono("bi-list-ol")" Descripcion="Con saldo o movimientos" />
        </div>

        @if (s.Desbalanceados.Count > 0)
        {
            <details class="ctr-desbalance">
                <summary><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    @s.Desbalanceados.Count asiento(s) del período no balancean: diferencia total @Moneda(s.Desbalanceados.Sum(a => a.Diferencia)). Tocá para ver cuáles.</summary>
                <div class="ctr-tabla__scroll ctr-tabla__scroll--chica">
                    <table class="ctr-tabla">
                        <thead><tr><th>Fecha</th><th>Asiento</th><th>Comprobante</th><th>Detalle</th><th class="n">Renglones</th><th class="n">Diferencia</th></tr></thead>
                        <tbody>
                        @foreach (var a in s.Desbalanceados)
                        {
                            <tr><td>@a.Fecha.ToString("dd/MM/yyyy")</td><td>@a.MesOperativo-@a.Numero</td><td>@a.Tc @a.Comprobante</td><td>@a.Detalle</td>
                                <td class="n">@a.Renglones</td><td class="n">@M(a.Diferencia)</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </details>
        }

        <section class="ctr-tabla__marco" aria-label="Balance de sumas y saldos">
            <div class="ctr-tabla__scroll">
                <table class="ctr-tabla">
                    <thead><tr><th>Cuenta</th><th>Descripción</th><th class="n">Saldo anterior</th><th class="n">Debe</th><th class="n">Haber</th><th class="n">Saldo</th></tr></thead>
                    <tbody>
                    @foreach (var f in s.Filas)
                    {
                        <tr class="@(f.EsTitulo ? "is-titulo" : "is-cuenta")" title="@(f.EsTitulo || f.Agrupadas > 0 ? null : "Ver el mayor de la cuenta")"
                            @onclick="() => AbrirMayor(f)">
                            <td>@f.Codigo</td>
                            <td style="padding-left:@(12 + f.Nivel * 14)px">@f.Descripcion@(f.Agrupadas > 0 ? $" ({f.Agrupadas})" : "")</td>
                            <td class="n">@M(f.SaldoAnterior)</td><td class="n">@M(f.Debe)</td><td class="n">@M(f.Haber)</td>
                            <td class="n @(f.Saldo < 0 ? "is-acreedor" : null)">@M(f.Saldo)</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr><td></td><td>Totales</td><td class="n">@M(s.TotalSaldoAnterior)</td><td class="n">@M(s.TotalDebe)</td><td class="n">@M(s.TotalHaber)</td><td class="n">@M(s.TotalSaldo)</td></tr></tfoot>
                </table>
            </div>
        </section>
        <p class="ctr-nota">Saldo anterior: movimientos del ejercicio antes de la fecha desde (incluye la apertura). Saldo positivo = deudor, negativo = acreedor. Tocá una cuenta para ver su mayor.</p>
    }

    @if (EsMayor && _mayor is { } m)
    {
        @if (m.Cuentas.Count == 0)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin movimientos" Message="La cuenta no tiene saldo ni movimientos en ese período." />
        }
        else
        {
            @if (m.Truncado) { <AlfaNotification Message="@AppUiMessage.Warning("Demasiados movimientos", "Se muestran los primeros 20.000: acotá las cuentas o las fechas.")" /> }
            <section class="ctr-tabla__marco" aria-label="Mayor de cuentas">
                <div class="ctr-tabla__scroll">
                    <table class="ctr-tabla">
                        <thead><tr><th>Fecha</th><th>Asiento</th><th>Comprobante</th><th>Detalle</th><th class="n">Debe</th><th class="n">Haber</th><th class="n">Saldo</th></tr></thead>
                        <tbody>
                        @foreach (var c in m.Cuentas)
                        {
                            <tr class="is-cuenta-cab"><td colspan="4">@c.Codigo · @c.Descripcion <small>saldo anterior</small></td><td></td><td></td><td class="n">@c.SaldoAnterior.ToString("N2", Culture)</td></tr>
                            @foreach (var x in c.Movimientos)
                            {
                                <tr><td>@x.Fecha.ToString("dd/MM/yyyy")</td><td>@x.MesOperativo-@x.Asiento</td><td>@x.Tc @x.Comprobante</td><td class="ctr-detalle">@x.Detalle</td>
                                    <td class="n">@M(x.Debe)</td><td class="n">@M(x.Haber)</td><td class="n @(x.Saldo < 0 ? "is-acreedor" : null)">@x.Saldo.ToString("N2", Culture)</td></tr>
                            }
                            <tr class="is-total"><td colspan="4">Total @c.Codigo · @c.Movimientos.Count movimiento(s)</td><td class="n">@M(c.Debe)</td><td class="n">@M(c.Haber)</td>
                                <td class="n @(c.Saldo < 0 ? "is-acreedor" : null)">@c.Saldo.ToString("N2", Culture)</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
            <p class="ctr-nota">@m.Cuentas.Count cuenta(s) · @m.Movimientos.ToString("N0") movimiento(s). Saldo positivo = deudor, negativo = acreedor.</p>
        }
    }
    @if ((EsDiario || EsSubdiarios) && _diario is { } d)
    {
        <div class="kpi-grid ctr-kpis">
            <KpiCard Titulo="Asientos" Valor="@d.Asientos.Count.ToString("N0")" Icono="@Icono("bi-journal-text")" Descripcion="@($"{d.SubdiarioDescripcion} · {d.Filtro.Desde:dd/MM/yyyy} al {d.Filtro.Hasta:dd/MM/yyyy}")" />
            <KpiCard Titulo="Debe" Valor="@Moneda(d.TotalDebe)" Icono="@Icono("bi-plus-slash-minus")" Descripcion="@d.Ejercicio" />
            <KpiCard Titulo="Haber" Valor="@Moneda(d.TotalHaber)" Icono="@Icono("bi-plus-slash-minus")" Descripcion="@(Math.Abs(d.TotalDebe - d.TotalHaber) < 0.005m ? "Balancea" : $"Diferencia {Moneda(d.TotalDebe - d.TotalHaber)}")" />
        </div>
        @if (d.Truncado) { <AlfaNotification Message="@AppUiMessage.Warning("Demasiados renglones", "Se muestran los primeros 30.000: acotá las fechas.")" /> }
        @if (d.Asientos.Count == 0)
        {
            <AlfaEmptyState Kind="AlfaEmptyStateKind.NoResults" Title="Sin asientos" Message="No hay asientos para esos filtros." />
        }
        else if (EsSubdiarios && d.Filtro.Resumido)
        {
            <section class="ctr-tabla__marco"><div class="ctr-tabla__scroll">
                <table class="ctr-tabla">
                    <thead><tr><th>Cuenta</th><th>Descripción</th><th class="n">Debe</th><th class="n">Haber</th></tr></thead>
                    <tbody>@foreach (var x in d.PorCuenta) { <tr><td>@x.Cuenta</td><td>@x.Descripcion</td><td class="n">@M(x.Debe)</td><td class="n">@M(x.Haber)</td></tr> }</tbody>
                    <tfoot><tr><td></td><td>Totales</td><td class="n">@M(d.TotalDebe)</td><td class="n">@M(d.TotalHaber)</td></tr></tfoot>
                </table>
            </div></section>
        }
        else
        {
            <section class="ctr-tabla__marco"><div class="ctr-tabla__scroll">
                <table class="ctr-tabla">
                    <thead><tr><th>Cuenta</th><th>Descripción</th><th>Detalle</th><th class="n">Debe</th><th class="n">Haber</th></tr></thead>
                    <tbody>
                    @foreach (var a in d.Asientos)
                    {
                        <tr class="is-cuenta-cab"><td colspan="5">@a.Fecha.ToString("dd/MM/yyyy") · Asiento @a.MesOperativo-@a.Numero
                            @if (a.Tc.Length > 0 || a.Comprobante.Length > 0) { <span> · @a.Tc @a.Comprobante</span> }
                            @if (a.Subdiario.Length > 0) { <small>@a.Subdiario</small> }
                            @if (Math.Abs(a.Debe - a.Haber) >= 0.005m) { <span class="is-acreedor"> · no balancea (@M(a.Debe - a.Haber))</span> }</td></tr>
                        @foreach (var x in a.Renglones)
                        {
                            <tr><td>@x.Cuenta</td><td>@x.Descripcion</td><td class="ctr-detalle">@x.Detalle</td><td class="n">@M(x.Debe)</td><td class="n">@M(x.Haber)</td></tr>
                        }
                    }
                    </tbody>
                    <tfoot><tr><td colspan="3">Totales</td><td class="n">@M(d.TotalDebe)</td><td class="n">@M(d.TotalHaber)</td></tr></tfoot>
                </table>
            </div></section>
        }
    }

    @if (EsPlan && _plan is { } pc)
    {
        <section class="ctr-tabla__marco"><div class="ctr-tabla__scroll">
            <table class="ctr-tabla">
                <thead><tr><th>Código</th><th>Descripción</th><th>Nivel</th><th>Tipo</th></tr></thead>
                <tbody>
                @foreach (var c in pc.Cuentas)
                {
                    <tr class="@(c.Titulo ? "is-titulo" : null) @(PuedeEditarPlan ? "is-editable" : null)" title="@(PuedeEditarPlan ? "Modificar o borrar la cuenta" : null)"
                        @onclick="() => EditarCuenta(c.Codigo)"><td>@c.Codigo</td><td style="padding-left:@(12 + c.Nivel * 14)px">@c.Descripcion@(c.Baja ? " (dada de baja)" : "")</td>
                        <td>@c.NivelNombre</td><td>@(c.Titulo ? "Título" : c.TipoVista switch { "CL" => "Cliente", "PR" => "Proveedor", "BC" => "Caja/Banco", _ => "Imputable" })</td></tr>
                }
                </tbody>
            </table>
        </div></section>
        <p class="ctr-nota">@pc.Cuentas.Count cuentas · @pc.Cuentas.Count(c => c.Titulo) títulos y @pc.Cuentas.Count(c => !c.Titulo) imputables.@(PuedeEditarPlan ? " Tocá una cuenta para modificarla o borrarla." : "")</p>
    }

    @if (EsPlan && _planAbm is { PuedeModificar: true })
    {
        <PlanCuentasAbmDialog Open="@_cuentaAbierta" Catalogo="@_planAbm" Codigo="@_cuentaEditada"
                              OnClose="() => { _cuentaAbierta = false; UpdateHeader(); }" OnChanged="CuentaCambiadaAsync" />
    }

    @if (EsBalanceGeneral && _balance is { } bg)
    {
        @if (Math.Abs(bg.Diferencia) >= 0.005m)
        {
            <AlfaNotification Message="@AppUiMessage.Warning("El balance no suma cero", $"Los saldos difieren en {Moneda(bg.Diferencia)} porque hay asientos desbalanceados. El detalle está en Balance de sumas y saldos.")" />
        }
        <section class="ctr-tabla__marco"><div class="ctr-tabla__scroll">
            <table class="ctr-tabla">
                <thead><tr><th>Cuenta</th><th>Descripción</th><th>Nivel</th><th class="n">Saldo al @bg.Filtro.Hasta.ToString("dd/MM/yyyy")</th>
                    @if (bg.EjercicioComparativo is not null) { <th class="n">Saldo al @bg.HastaComparativo?.ToString("dd/MM/yyyy")</th> }</tr></thead>
                <tbody>
                @foreach (var x in bg.Filas)
                {
                    <tr class="@(x.EsTitulo ? "is-titulo" : null)"><td>@x.Codigo</td><td style="padding-left:@(12 + x.Nivel * 14)px">@x.Descripcion</td><td>@x.NivelNombre</td>
                        <td class="n @(x.Saldo < 0 ? "is-acreedor" : null)">@M(x.Saldo)</td>
                        @if (bg.EjercicioComparativo is not null) { <td class="n @(x.SaldoComparativo < 0 ? "is-acreedor" : null)">@M(x.SaldoComparativo ?? 0)</td> }</tr>
                }
                </tbody>
            </table>
        </div></section>
        <p class="ctr-nota">Saldos acumulados del ejercicio (con la apertura) hasta la fecha. Positivo = deudor, negativo = acreedor.@(bg.EjercicioComparativo is { } ec ? $" Comparativo: {ec}." : "")</p>
    }

    @if (_busy && !HayDatos)
    {
        <AlfaEmptyState Title="Generando el reporte" Message="Leyendo los asientos del ejercicio." />
    }
</div>

@code {
    /// <summary>"mayor" o "sumas-saldos".</summary>
    [Parameter] public string Tipo { get; set; } = "sumas-saldos";
    private bool EsMayor => Tipo == "mayor";
    private bool EsSumas => Tipo == "sumas-saldos";
    private bool EsDiario => Tipo == "diario";
    private bool EsSubdiarios => Tipo == "subdiarios";
    private bool EsPlan => Tipo == "plan";
    private bool EsBalanceGeneral => Tipo == "balance-general";
    private string Titulo => Tipo switch
    {
        "mayor" => "Mayor de cuentas", "diario" => "Libro diario", "subdiarios" => "Subdiarios", "plan" => "Plan de cuentas",
        "balance-general" => "Balance general de saldos", _ => "Balance de sumas y saldos"
    };
    private DiarioResultado? _diario;
    private PlanCuentasResultado? _plan;
    private PlanCuentasAbmCatalogo? _planAbm;
    private bool _cuentaAbierta;
    private string? _cuentaEditada;
    private bool PuedeEditarPlan => EsPlan && _planAbm is { PuedeModificar: true };
    private BalanceGeneralResultado? _balance;
    private IReadOnlyList<AlfaSelectOption> SubdiarioOptions =>
        [.. (EsSubdiarios ? Array.Empty<AlfaSelectOption>() : [new("", "Todos los asientos")]), new("DG", "Diario general (sin subdiarios)"),
         .. (_catalogos?.Subdiarios ?? []).Select(x => new AlfaSelectOption(x.Codigo, x.Codigo == x.Descripcion ? x.Codigo : $"{x.Codigo} · {x.Descripcion}"))];
    private IReadOnlyList<AlfaSelectOption> NivelOptions =>
        [new("0", "Todas las cuentas"), .. (_catalogos?.Niveles ?? []).Take(4).Select((n, i) => new AlfaSelectOption((i + 1).ToString(), $"{i + 1} · {n}"))];
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    private ContabilidadCatalogos? _catalogos;
    private readonly ContabilidadFiltro _filtro = new();
    private SumasSaldosResultado? _sumas;
    private MayorResultado? _mayor;
    private ContabilidadOpcion? _cuenta, _cuentaHasta;
    private string _cuentaTexto = "", _cuentaHastaTexto = "";
    private AppUiMessage? _feedback;
    private bool _busy, _disposed;
    private string? _exportando;
    private PageHeaderConfig? _header;

    private IReadOnlyList<AlfaSelectOption> EjercicioOptions => (_catalogos?.Ejercicios ?? [])
        .Select(e => new AlfaSelectOption(e.Periodo.ToString(), $"{e.Descripcion} ({e.Desde:dd/MM/yyyy} – {e.Hasta:dd/MM/yyyy}){(e.Cerrado ? " · cerrado" : "")}")).ToList();
    private IReadOnlyList<AlfaSelectOption> UnidadOptions => [new("", "Todas"), .. (_catalogos?.Unidades ?? []).Select(u => new AlfaSelectOption(u.Codigo, $"{u.Codigo} · {u.Descripcion}"))];

    protected override void OnInitialized() => UpdateHeader();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        UpdateHeader();
        var cat = await UiOps.RunAsync(() => Service.GetCatalogosAsync(), Titulo);
        if (!cat.Success) { _feedback = cat.Feedback; StateHasChanged(); return; }
        _catalogos = cat.Value;
        // Por defecto el ejercicio que contiene hoy (o el último) hasta hoy; la URL puede traer cuenta y fechas (desde el balance).
        var hoy = DateTime.Today;
        var ej = _catalogos!.Ejercicios.FirstOrDefault(e => hoy >= e.Desde && hoy <= e.Hasta) ?? _catalogos.Ejercicios.FirstOrDefault();
        if (ej is not null) { _filtro.Periodo = ej.Periodo; _filtro.Desde = ej.Desde; _filtro.Hasta = hoy < ej.Hasta ? hoy : ej.Hasta; }
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (q.TryGetValue("periodo", out var per) && int.TryParse(per, out var pe)) _filtro.Periodo = pe;
        if (q.TryGetValue("desde", out var de) && Leer(de) is { } fd) _filtro.Desde = fd;
        if (q.TryGetValue("hasta", out var ha) && Leer(ha) is { } fh) _filtro.Hasta = fh;
        if (q.TryGetValue("unidad", out var un) && un.ToString().Length > 0) _filtro.Unidades = [un.ToString()];
        if (q.TryGetValue("proformas", out var pf)) _filtro.IncluirProformas = pf == "1";
        if (q.TryGetValue("cuenta", out var cu) && cu.ToString().Length > 0)
        {
            _cuenta = new ContabilidadOpcion(cu.ToString(), cu.ToString()); _cuentaTexto = cu.ToString(); _filtro.CuentaDesde = cu.ToString();
        }
        StateHasChanged();
        if (EsPlan)
        {
            // El ABM (D9510) se ofrece dentro de la misma consulta si el usuario tiene permiso; si no, queda solo la consulta.
            try { _planAbm = await PlanAbm.CatalogoAsync(); } catch (InvalidOperationException) { _planAbm = null; }
            UpdateHeader();
        }
        if (EsSubdiarios && _filtro.Subdiario.Length == 0) _filtro.Subdiario = _catalogos.Subdiarios.FirstOrDefault()?.Codigo ?? "DG";
        if (!EsMayor || _filtro.CuentaDesde.Length > 0) await GenerarAsync();
    }

    private void CambiarEjercicio(string? valor)
    {
        if (!int.TryParse(valor, out var p) || _catalogos?.Ejercicios.FirstOrDefault(e => e.Periodo == p) is not { } e) return;
        _filtro.Periodo = p; _filtro.Desde = e.Desde; _filtro.Hasta = DateTime.Today < e.Hasta && DateTime.Today >= e.Desde ? DateTime.Today : e.Hasta;
    }

    private void CuentaElegida(ContabilidadOpcion? c) { _cuenta = c; _filtro.CuentaDesde = c?.Codigo ?? ""; if (c is not null) _cuentaTexto = c.Descripcion; }
    private void CuentaHastaElegida(ContabilidadOpcion? c) { _cuentaHasta = c; _filtro.CuentaHasta = c?.Codigo ?? ""; if (c is not null) _cuentaHastaTexto = c.Descripcion; }

    private Task TeclaAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) => e.Key == "Enter" ? GenerarAsync() : Task.CompletedTask;

    private async Task GenerarAsync()
    {
        if (_busy || _disposed || _catalogos is null) return;
        if (EsMayor && string.IsNullOrWhiteSpace(_filtro.CuentaDesde)) { _feedback = AppUiMessage.Info("Elegí la cuenta", "Buscá la cuenta por código o nombre. Si elegís un título, se muestran todas sus cuentas."); return; }
        _busy = true; _feedback = null; UpdateHeader();
        await InvokeAsync(StateHasChanged);
        try
        {
            if (EsMayor)
            {
                var r = await UiOps.RunAsync(() => Service.GetMayorAsync(Copia()), Titulo);
                if (r.Success) _mayor = r.Value; else _feedback = r.Feedback;
            }
            else if (EsDiario || EsSubdiarios)
            {
                var r = await UiOps.RunAsync(() => Service.GetDiarioAsync(Copia(), EsSubdiarios), Titulo);
                if (r.Success) _diario = r.Value; else _feedback = r.Feedback;
            }
            else if (EsPlan)
            {
                var r = await UiOps.RunAsync(() => Service.GetPlanCuentasAsync(Copia()), Titulo);
                if (r.Success) _plan = r.Value; else _feedback = r.Feedback;
            }
            else if (EsBalanceGeneral)
            {
                var r = await UiOps.RunAsync(() => Service.GetBalanceGeneralAsync(Copia()), Titulo);
                if (r.Success) _balance = r.Value; else _feedback = r.Feedback;
            }
            else
            {
                var r = await UiOps.RunAsync(() => Service.GetSumasSaldosAsync(Copia()), Titulo);
                if (r.Success) _sumas = r.Value; else _feedback = r.Feedback;
            }
        }
        finally { _busy = false; if (!_disposed) { UpdateHeader(); await InvokeAsync(StateHasChanged); } }
    }

    private ContabilidadFiltro Copia() => new()
    {
        Periodo = _filtro.Periodo, Desde = _filtro.Desde, Hasta = _filtro.Hasta, Unidades = [.. _filtro.Unidades], IncluirProformas = _filtro.IncluirProformas,
        CuentaDesde = _filtro.CuentaDesde, CuentaHasta = _filtro.CuentaHasta, AgruparTerceros = _filtro.AgruparTerceros,
        MostrarTitulos = _filtro.MostrarTitulos, IncluirSinMovimientos = _filtro.IncluirSinMovimientos,
        Subdiario = _filtro.Subdiario, ExcluirSubdiarios = _filtro.ExcluirSubdiarios, Resumido = _filtro.Resumido,
        PlanIncluirTerceros = _filtro.PlanIncluirTerceros, PlanIncluirBaja = _filtro.PlanIncluirBaja,
        NivelMaximo = _filtro.NivelMaximo, Comparativo = _filtro.Comparativo
    };

    private void EditarCuenta(string codigo)
    {
        if (!PuedeEditarPlan || _busy) return;
        _cuentaEditada = codigo; _cuentaAbierta = true;
    }

    private Task NuevaCuentaAsync()
    {
        if (!PuedeEditarPlan) return Task.CompletedTask;
        _cuentaEditada = null; _cuentaAbierta = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CuentaCambiadaAsync(AppUiMessage mensaje)
    {
        _cuentaAbierta = false;
        try { _planAbm = await PlanAbm.CatalogoAsync(); } catch (InvalidOperationException) { }
        await GenerarAsync();
        _feedback = mensaje;
        await InvokeAsync(StateHasChanged);
    }

    private void AbrirMayor(SumasSaldosFila f)
    {
        if (_sumas is not { } s) return;
        var url = RouteContext.BuildRoute("/contabilidad/mayor") + $"?periodo={s.Filtro.Periodo}&desde={s.Filtro.Desde:yyyy-MM-dd}&hasta={s.Filtro.Hasta:yyyy-MM-dd}" +
            $"&cuenta={Uri.EscapeDataString(f.Codigo)}{(s.Filtro.Unidades.Count > 0 ? "&unidad=" + Uri.EscapeDataString(s.Filtro.Unidades[0]) : "")}{(s.Filtro.IncluirProformas ? "&proformas=1" : "")}";
        _ = Js.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task ExportarAsync(bool pdf)
    {
        if (_exportando is not null) return;
        _exportando = pdf ? "pdf" : "excel"; UpdateHeader();
        try
        {
            var r = await UiOps.RunAsync(() => Tipo switch
            {
                "mayor" => Service.ExportarMayorAsync(Copia(), pdf),
                "diario" => Service.ExportarDiarioAsync(Copia(), false, pdf),
                "subdiarios" => Service.ExportarDiarioAsync(Copia(), true, pdf),
                "plan" => Service.ExportarPlanCuentasAsync(Copia(), pdf),
                "balance-general" => Service.ExportarBalanceGeneralAsync(Copia(), pdf),
                _ => Service.ExportarSumasSaldosAsync(Copia(), pdf)
            }, Titulo);
            if (r.Success && r.Value is { } a)
                await Js.InvokeVoidAsync(pdf ? "alfaCoreInterfacesUpload.openBlob" : "alfaCoreInterfacesUpload.downloadBlob", Convert.ToBase64String(a.Contenido), a.ContentType, a.Nombre);
            else _feedback = r.Feedback;
        }
        finally { _exportando = null; if (!_disposed) { UpdateHeader(); await InvokeAsync(StateHasChanged); } }
    }

    private bool HayDatos => Tipo switch
    {
        "mayor" => _mayor is { Cuentas.Count: > 0 },
        "diario" or "subdiarios" => _diario is { Asientos.Count: > 0 },
        "plan" => _plan is { Cuentas.Count: > 0 },
        "balance-general" => _balance is { Filas.Count: > 0 },
        _ => _sumas is { Filas.Count: > 0 }
    };

    private void UpdateHeader() => PageHeader.Set(_header = new PageHeaderConfig
    {
        ShellMode = PageHeaderShellMode.AlfaDesignPilot, ModuleKey = "contabilidad", Title = Titulo,
        Breadcrumb = ["Contabilidad", "Reportes", Titulo],
        TopNavigationItems = ModuleTopNavPresets.BuildContabilidad(RouteContext, Nav, Tipo),
        State = _busy ? PageHeaderState.Loading : PageHeaderState.List,
        Actions =
        [
            .. (PuedeEditarPlan ? [new PageHeaderAction { Key = "nueva-cuenta", Label = "Nueva cuenta", Icon = "bi-plus-lg", Style = PageHeaderActionStyle.Secondary, Disabled = _busy, OnClick = NuevaCuentaAsync }] : Array.Empty<PageHeaderAction>()),
            new() { Key = "generar", Label = "Generar", Icon = "bi-play-fill", Style = PageHeaderActionStyle.Primary, Priority = PageHeaderActionPriority.Essential, Disabled = _busy, OnClick = GenerarAsync },
            new() { Key = "pdf", Label = "PDF", Icon = "bi-printer", Style = PageHeaderActionStyle.Secondary, Disabled = _busy || !HayDatos || _exportando is not null, Busy = _exportando == "pdf", OnClick = () => ExportarAsync(true) },
            new() { Key = "excel", Label = "Excel", Icon = "bi-file-earmark-excel", Style = PageHeaderActionStyle.Secondary, Disabled = _busy || !HayDatos || _exportando is not null, Busy = _exportando == "excel", OnClick = () => ExportarAsync(false) }
        ]
    });

    private static string Icono(string bi) => $"<i class=\"bi {bi}\" aria-hidden=\"true\"></i>";
    private static string Moneda(decimal v) => v.ToString("C2", Culture);
    private static string M(decimal v) => v == 0 ? "" : v.ToString("N2", Culture);
    private static string Fecha(DateTime d) => d == default ? "" : d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    private static DateTime? Leer(string? v) => DateTime.TryParseExact(v, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    public void Dispose()
    {
        _disposed = true;
        if (ReferenceEquals(PageHeader.Current, _header)) PageHeader.Clear();
    }
}
