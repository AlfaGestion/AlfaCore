@using Microsoft.AspNetCore.Components.Web

<button type="@Type"
        class="@CssClass"
        title="@Title"
        aria-label="@AriaLabel"
        @onclick="HandleClickAsync"
        disabled="@Disabled">
    @if (IsBusy && !string.IsNullOrWhiteSpace(BusyIconClass))
    {
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrWhiteSpace(IconClass))
    {
        <i class="@IconClass" aria-hidden="true"></i>
    }

    <span>@(IsBusy && !string.IsNullOrWhiteSpace(BusyText) ? BusyText : Text)</span>
</button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string? BusyText { get; set; }
    [Parameter] public string? IconClass { get; set; }
    [Parameter] public string? BusyIconClass { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private async Task HandleClickAsync(MouseEventArgs args)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }
}
