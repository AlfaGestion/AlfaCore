@using AlfaCore.Models
@inject AlfaCore.Services.IComprobanteViewerService ComprobanteViewerSvc
@inject AlfaCore.Services.IFacturaDocumentService FacturaDocumentSvc
@inject AlfaCore.Services.ICompanyBrandingService CompanyBrandingSvc
@inject AlfaCore.Services.IAppUiOperationService UiOps
@inject AlfaCore.Services.IRouteContextService RouteCtx
@inject NavigationManager Navigation
@inject IJSRuntime Js

<div class="page-grid comprobante-viewer-page">
    <section class="page-intro">
        <div>
            <h2 class="page-intro__title">@GetTitle()</h2>
            <p class="page-intro__text">@GetIntro()</p>
        </div>
        <div class="actions">
            @if (_history.Count > 0)
            {
                <button type="button" class="btn btn--secondary" @onclick="VolverAlAnteriorAsync" disabled="@_loading">
                    <i class="bi bi-arrow-return-left"></i>
                    <span>Volver al comprobante anterior</span>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                <a class="btn btn--ghost" href="@ReturnUrl">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>
                </a>
            }
            <button type="button" class="btn btn--ghost" @onclick="CopyCurrentAsync" disabled="@(_loading || _dto?.Cabecera is null)">
                <i class="bi bi-copy"></i>
                <span>Copiar TC + ID</span>
            </button>
            @if (_dto?.Cabecera is not null)
            {
                <a class="btn btn--ghost" href="@BuildPageUrl(_dto.Cabecera.Tc, _dto.Cabecera.IdComprobante, _dto.Cabecera.IdComplemento)" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Abrir en otra pestaña</span>
                </a>
                @if (_dto.TieneAsiento)
                {
                    <button type="button" class="btn btn--secondary" @onclick="MostrarAsientoAsync" disabled="@_asientoLoading">
                        <i class="bi bi-journal-text"></i>
                        <span>Ver asiento</span>
                    </button>
                }
                <button type="button" class="btn btn--primary" @onclick="VerPdfFacturaAsync" disabled="@(_loading || _generandoPdf)">
                    <i class="bi bi-file-earmark-pdf"></i>
                    <span>Ver PDF</span>
                </button>
            }
        </div>
    </section>

    @if (_feedback is not null)
    {
        <section class="panel-card">
            <div class="editor-msg @GetFeedbackClass(_feedback)">
                <div>
                    <strong>@_feedback.Title</strong>
                    <p>@_feedback.Message</p>
                    @if (_feedback.HasSuggestion)
                    {
                        <small>@_feedback.Suggestion</small>
                    }
                    @if (_feedback.HasCode)
                    {
                        <small>Código: @_feedback.Code</small>
                    }
                </div>
            </div>
        </section>
    }

    @if (_loading)
    {
        <section class="panel-card">
            <div class="loading">Cargando comprobante...</div>
        </section>
    }
    else if (_dto?.Cabecera is null)
    {
        <section class="panel-card">
            <div class="interfaces-empty-upload">No se encontró el comprobante solicitado.</div>
        </section>
    }
    else
    {
        var c = _dto.Cabecera;
        <section class="panel-card comprobante-viewer__summary">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">@($"{c.Tc} {c.IdComprobante}")</h3>
                    <p class="panel-card__subtitle">Complemento: @c.IdComplemento · Fecha: @FormatDate(c.Fecha) · Usuario: @c.Usuario</p>
                </div>
                <div class="comprobante-viewer__badges">
                    @foreach (var badge in BuildEstadoBadges(c, IsReimpresion()))
                    {
                        <span class="comprobante-badge @badge.Css">@badge.Label</span>
                    }
                </div>
            </div>

            <div class="comprobante-viewer__header-grid">
                @RenderHeaderField(c.SistemaOrigen == "COMPRAS" ? "Proveedor / cuenta" : "Cliente / cuenta", FormatClienteCuenta(c))
                @RenderHeaderField("Nombre", c.Nombre)
                @RenderHeaderField("Domicilio", c.Domicilio)
                @RenderHeaderField("Localidad", BuildLocalidad(c))
                @RenderHeaderField("Teléfono", c.Telefono)
                @RenderHeaderField("Condición comercial", BuildCondicion(c))
                @RenderHeaderField("Vendedor", BuildVendedor(c))
                @RenderHeaderField("Técnico", BuildTecnico(c))
            </div>

            @if (!ModoDetalleCompleto && BuildTotales(c).Count > 0)
            {
                @RenderTotales(c)
            }
        </section>

        <section class="panel-card">
            @if (ModoDetalleCompleto)
            {
                @RenderDetalleCompleto()
            }
            else
            {
            <div class="contactos-tabs">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="btn @(_activeTab == tab.Key ? "btn--primary" : "btn--ghost")" @onclick="() => _activeTab = tab.Key">
                        @tab.Label
                    </button>
                }
            </div>

            @if (_activeTab == "resumen")
            {
                <div class="contactos-form__grid">
                    <div class="field">
                        <label>Neto gravado</label>
                        <input value="@FormatMoney(c.NetoGravado)" readonly />
                    </div>
                    @if (HasValue(c.NetoNoGravado))
                    {
                        <div class="field">
                            <label>Neto no gravado</label>
                            <input value="@FormatMoney(c.NetoNoGravado)" readonly />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.ObservacionesGenerales))
                    {
                        <div class="field field--full">
                            <label>Observaciones generales</label>
                            <textarea rows="4" readonly>@c.ObservacionesGenerales</textarea>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Comentarios))
                    {
                        <div class="field field--full">
                            <label>Comentarios</label>
                            <textarea rows="4" readonly>@c.Comentarios</textarea>
                        </div>
                    }
                </div>
            }
            else if (_activeTab == "insumos")
            {
                @RenderInsumos()
            }
            else if (_activeTab == "tareas")
            {
                @RenderTareas()
            }
            else if (_activeTab == "observaciones")
            {
                @RenderObservaciones()
            }
            else if (_activeTab == "aplicaciones")
            {
                @RenderAplicaciones()
            }
            else if (_activeTab == "documentos")
            {
                @RenderDocumentos()
            }
            else if (_activeTab == "asientos")
            {
                @RenderAsientos()
            }
            else if (_activeTab == "acciones")
            {
                @RenderAcciones()
            }
            }
        </section>
    }
</div>

@if (_asientoModalAbierto && _dto?.Cabecera is not null)
{
    <div class="comprobante-asiento-modal" role="dialog" aria-modal="true" aria-labelledby="comprobante-asiento-title">
        <section class="comprobante-asiento-modal__card" @onclick:stopPropagation="true">
            <header class="comprobante-asiento-modal__header">
                <div>
                    <h2 id="comprobante-asiento-title">Detalle del asiento contable</h2>
                    <p>@GetAsientoTitle()</p>
                </div>
                <button type="button" class="btn btn--ghost btn--sm" @onclick="CerrarAsientoModalAsync" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>
            <div class="comprobante-asiento-modal__body">
                <div class="comprobante-asiento-modal__summary">
                    <div><strong>Fecha</strong><span>@FormatDate(_dto.Cabecera.Fecha)</span></div>
                    <div><strong>Comprobante</strong><span>@($"{_dto.Cabecera.Tc} {_dto.Cabecera.IdComprobante}")</span></div>
                    <div><strong>Concepto</strong><span>@BuildAsientoConcepto()</span></div>
                    <div><strong>Usuario</strong><span>@_dto.Cabecera.Usuario</span></div>
                    <div><strong>Asiento N.º</strong><span>@GetNumeroAsiento()</span></div>
                    <div><strong>Unidad de negocio</strong><span>@GetUnidadNegocio()</span></div>
                </div>

                @if (_asientoLoading)
                {
                    <div class="loading">Cargando asiento...</div>
                }
                else if (!string.IsNullOrWhiteSpace(_asientoError))
                {
                    <div class="editor-msg editor-msg--error"><p>No se pudo cargar el asiento: @_asientoError</p></div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table usuarios-table comprobante-asiento-modal__table">
                            <thead>
                                <tr>
                                    <th>Cuenta</th>
                                    <th>Descripción</th>
                                    <th>Cheque</th>
                                    <th>Vencimiento</th>
                                    <th>Cuotas</th>
                                    <th>Debe</th>
                                    <th>Haber</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_asientos.Count == 0)
                                {
                                    <tr><td colspan="7" class="muted">Este comprobante no tiene asiento registrado.</td></tr>
                                }
                                else
                                {
                                    @foreach (var item in _asientos)
                                    {
                                        <tr>
                                            <td>@item.Cuenta</td>
                                            <td>
                                                <span>@(string.IsNullOrWhiteSpace(item.DescripcionCuenta) ? item.Detalle : item.DescripcionCuenta)</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Detalle) && !string.Equals(item.Detalle.Trim(), item.DescripcionCuenta.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <small class="comprobante-asiento-detail">@item.Detalle</small>
                                                }
                                            </td>
                                            <td>@item.Cheque</td>
                                            <td>@FormatDate(item.Vencimiento)</td>
                                            <td>@(item.Cuotas == 0 ? "" : item.Cuotas.ToString())</td>
                                            <td class="money">@FormatMoney(item.Debe)</td>
                                            <td class="money">@FormatMoney(item.Haber)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="comprobante-asiento-modal__totals">
                        <span>Suma de débitos: <strong>@FormatMoney(_asientos.Sum(x => x.Debe))</strong></span>
                        <span>Suma de créditos: <strong>@FormatMoney(_asientos.Sum(x => x.Haber))</strong></span>
                    </div>
                }

                <section class="comprobante-asiento-modal__history">
                    <h3>Historial de acciones</h3>
                    @RenderAcciones()
                </section>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public string Tc { get; set; } = string.Empty;
    [Parameter] public string IdComprobante { get; set; } = string.Empty;
    [Parameter] public int IdComplemento { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }
    [Parameter] public bool ModoDetalleCompleto { get; set; }
    [SupplyParameterFromQuery(Name = "reimpresion")] public string? Reimpresion { get; set; }

    private static readonly (string Key, string Label)[] Tabs =
    [
        ("resumen", "Resumen"),
        ("insumos", "Artículos"),
        ("tareas", "Servicios"),
        ("observaciones", "Otros conceptos"),
        ("aplicaciones", "Aplicaciones"),
        ("documentos", "Documentos"),
        ("asientos", "Asiento"),
        ("acciones", "Historial")
    ];

    private readonly Stack<ViewerNavItem> _history = new();
    private ComprobanteViewerDto? _dto;
    private CompanyBrandingDto? _branding;
    private AppUiMessage? _feedback;
    private bool _loading;
    private bool _generandoPdf;
    private bool _asientoLoading;
    private string? _asientoError;
    private IReadOnlyList<ComprobanteAsientoDto> _asientos = [];
    private bool _asientoModalAbierto;
    private string _activeTab = "resumen";
    private string _routeKey = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var nextKey = BuildKey(Tc, IdComprobante, IdComplemento);
        if (_routeKey == nextKey)
            return;

        _routeKey = nextKey;
        _history.Clear();
        await LoadAsync(Tc, IdComprobante, IdComplemento, false);
    }

    private async Task LoadAsync(string tc, string idComprobante, int idComplemento, bool pushCurrent)
    {
        if (_dto?.Cabecera is not null && pushCurrent)
        {
            _history.Push(new ViewerNavItem(_dto.Cabecera.Tc, _dto.Cabecera.IdComprobante, _dto.Cabecera.IdComplemento));
        }

        _loading = true;
        _feedback = null;
        StateHasChanged();

        var brandingTask = CompanyBrandingSvc.GetAsync();
        var asientoTask = EsCobranza(tc)
            ? ComprobanteViewerSvc.GetAsientosAsync(tc, idComprobante)
            : Task.FromResult<IReadOnlyList<ComprobanteAsientoDto>>([]);

        var result = await UiOps.RunAsync(
            () => ComprobanteViewerSvc.GetAsync(tc, idComprobante, idComplemento),
            "No se pudo cargar el comprobante.");

        if (!result.Success)
        {
            _feedback = result.Feedback;
            _dto = null;
            _loading = false;
            return;
        }

        _dto = result.Value;
        try { _branding = await brandingTask; }
        catch { _branding = null; }
        _asientos = [];
        _asientoError = null;
        _asientoModalAbierto = false;
        if (EsCobranza(tc))
        {
            _asientoLoading = true;
            try
            {
                _asientos = await asientoTask;
            }
            catch (Exception ex)
            {
                _asientoError = ex.Message;
            }
            finally
            {
                _asientoLoading = false;
            }
        }
        _activeTab = ResolveDefaultTab(_dto);
        _loading = false;
    }

    private async Task VolverAlAnteriorAsync()
    {
        if (_history.Count == 0)
            return;

        var previous = _history.Pop();
        await LoadAsync(previous.Tc, previous.IdComprobante, previous.IdComplemento, false);
    }

    private async Task OpenRelacionadoAsync(string tc, string idComprobante, int idComplemento)
    {
        await LoadAsync(tc, idComprobante, idComplemento, true);
    }

    private async Task MostrarAsientoAsync()
    {
        if (_dto?.Cabecera is null)
            return;

        _asientoModalAbierto = true;
        if (_asientoLoading || _asientos.Count > 0)
            return;

        _asientoLoading = true;
        _asientoError = null;
        try
        {
            _asientos = await ComprobanteViewerSvc.GetAsientosAsync(_dto.Cabecera.Tc, _dto.Cabecera.IdComprobante);
        }
        catch (Exception ex)
        {
            _asientoError = ex.Message;
        }
        finally
        {
            _asientoLoading = false;
        }
    }

    private Task CerrarAsientoModalAsync()
    {
        _asientoModalAbierto = false;
        return Task.CompletedTask;
    }


    private string GetAsientoTitle()
        => _dto?.Cabecera is null
            ? string.Empty
            : $"{_dto.Cabecera.Tc} {_dto.Cabecera.IdComprobante} · {_dto.Cabecera.Nombre}";

    private string BuildAsientoConcepto()
        => _dto?.Cabecera is null
            ? string.Empty
            : string.IsNullOrWhiteSpace(_dto.Cabecera.Comentarios)
                ? _dto.Cabecera.Tc.Equals("FC", StringComparison.OrdinalIgnoreCase) ? "Venta" : "Movimiento contable"
                : _dto.Cabecera.Comentarios;

    private string GetNumeroAsiento()
        => _asientos.FirstOrDefault()?.NumeroAsiento.ToString() ?? "—";

    private string GetUnidadNegocio()
        => _asientos.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.UnidadNegocio))?.UnidadNegocio ?? "—";

    private RenderFragment RenderDetalleCompleto() => @<div class="comprobante-detalle-completo">
        @if (EsCobranza(_dto!.Cabecera?.Tc))
        {
            <section class="comprobante-detalle-completo__section comprobante-detalle-completo__section--seat">
                <h3>Asiento contable y medios de pago</h3>
                @RenderAsientos()
            </section>
            <section class="comprobante-detalle-completo__section">
                <h3>Medios de pago</h3>
                @RenderMediosPago()
            </section>
            <section class="comprobante-detalle-completo__section">
                <h3>Otros conceptos</h3>
                @RenderObservaciones()
            </section>
            <section class="comprobante-detalle-completo__section">
                <h3>Totales</h3>
                @RenderTotales(_dto.Cabecera!)
            </section>
            <section class="comprobante-detalle-completo__section">
                <h3>Comprobantes relacionados</h3>
                @RenderAplicaciones(false)
            </section>
        }
        else
        {
            @if (_dto.Insumos.Count > 0)
            {
                <section class="comprobante-detalle-completo__section comprobante-detalle-completo__section--items">
                    <h3>Artículos</h3>
                    @RenderInsumos()
                </section>
            }
            @if (_dto.Tareas.Count > 0)
            {
                <section class="comprobante-detalle-completo__section">
                    <h3>Servicios</h3>
                    @RenderTareas()
                </section>
            }
            <section class="comprobante-detalle-completo__section">
                <h3>Otros conceptos</h3>
                @RenderObservaciones()
            </section>
            <section class="comprobante-detalle-completo__section">
                <h3>Totales</h3>
                @RenderTotales(_dto.Cabecera!)
            </section>
            <section class="comprobante-detalle-completo__section">
                <h3>Comprobantes relacionados y cobranzas</h3>
                @RenderAplicaciones()
            </section>
        }
        <section class="comprobante-detalle-completo__section">
            <h3>Historial de acciones</h3>
            @RenderAcciones()
        </section>
        <section class="comprobante-detalle-completo__section">
            <h3>Unidad de negocio</h3>
            <div class="comprobante-viewer__unit">
                @if (_dto.Cabecera is { } unidadCabecera && !string.IsNullOrWhiteSpace(unidadCabecera.UnidadNegocio))
                {
                    <strong>@unidadCabecera.UnidadNegocio</strong>
                    <span>@(string.IsNullOrWhiteSpace(unidadCabecera.UnidadNegocioDescripcion) || string.Equals(unidadCabecera.UnidadNegocioDescripcion.Trim(), unidadCabecera.UnidadNegocio.Trim(), StringComparison.OrdinalIgnoreCase) ? "—" : unidadCabecera.UnidadNegocioDescripcion)</span>
                }
                else
                {
                    <span>—</span>
                }
            </div>
        </section>
    </div>;

    private async Task VerPdfFacturaAsync()
    {
        if (_dto?.Cabecera is not { } c)
            return;

        _generandoPdf = true;
        StateHasChanged();
        try
        {
            var result = await UiOps.RunAsync(
                () => FacturaDocumentSvc.GeneratePdfAsync(c.Tc, c.IdComprobante, null),
                "Este comprobante no tiene una Factura A/B/C generable (¿es una nota de crédito, recibo u otro tipo?).");

            if (!result.Success || result.Value is not { Length: > 0 } pdf)
            {
                _feedback = result.Feedback;
                return;
            }

            await Js.InvokeVoidAsync("alfaCoreInterfacesUpload.downloadBlob", Convert.ToBase64String(pdf), "application/pdf", $"factura-{c.IdComprobante}.pdf");
        }
        finally
        {
            _generandoPdf = false;
            StateHasChanged();
        }
    }

    private async Task CopyCurrentAsync()
    {
        if (_dto?.Cabecera is null)
            return;

        var value = $"{_dto.Cabecera.Tc} {_dto.Cabecera.IdComprobante}";
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", value);
    }

    private string BuildPageUrl(string tc, string idComprobante, int idComplemento)
    {
        var path = RouteCtx.BuildRoute($"/comprobantes/viewer/{Uri.EscapeDataString(tc)}/{Uri.EscapeDataString(idComprobante)}?idComplemento={idComplemento}");
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            path += $"&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        return path;
    }

    private string BuildDocumentoUrl(ComprobanteDocumentoDto item)
        => $"/api/comprobantes/{Uri.EscapeDataString(_dto!.Cabecera!.Tc)}/{Uri.EscapeDataString(_dto.Cabecera.IdComprobante)}/documentos?idComplemento={_dto.Cabecera.IdComplemento}&documento={Uri.EscapeDataString(item.Documento)}";

    private static string BuildKey(string tc, string idComprobante, int idComplemento)
        => $"{tc.Trim().ToUpperInvariant()}|{idComprobante.Trim().ToUpperInvariant()}|{idComplemento}";

    private RenderFragment RenderHeaderField(string label, string value) => @<div class="comprobante-viewer__header-field">
        <span class="comprobante-viewer__header-label">@label</span>
        <strong>@(string.IsNullOrWhiteSpace(value) ? "—" : value)</strong>
    </div>;

    private static string FormatMoney(decimal? value)
        => value.HasValue ? value.Value.ToString("N2") : "—";

    private static bool HasValue(decimal? value)
        => value.HasValue && value.Value != 0m;

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "—";

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "—";

    private static string FormatTipoAccion(string? tipo)
        => tipo?.Trim().ToUpperInvariant() switch
        {
            "IN" or "A" or "ALTA" => "ALTA",
            "MO" or "M" or "MODIFICACION" or "MODIFICACIÓN" => "MODIFICACIÓN",
            "BA" or "B" or "BAJA" => "BAJA",
            _ => string.IsNullOrWhiteSpace(tipo) ? "—" : tipo.Trim()
        };

    private static string FormatClienteCuenta(ComprobanteCabeceraDto c)
        => string.Join(" · ", new[] { c.Cuenta, c.Nombre }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string BuildLocalidad(ComprobanteCabeceraDto c)
        => string.Join(" · ", new[] { c.Localidad, c.CodigoPostal }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string BuildCondicion(ComprobanteCabeceraDto c)
        => string.Join(" · ", new[] { c.CondicionComercialCodigo, c.CondicionComercialDescripcion }.Distinct().Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string BuildVendedor(ComprobanteCabeceraDto c)
        => string.Join(" · ", new[] { c.VendedorCodigo, c.VendedorNombre }.Distinct().Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string BuildTecnico(ComprobanteCabeceraDto c)
        => string.Join(" · ", new[] { c.TecnicoCodigo, c.TecnicoNombre }.Distinct().Where(x => !string.IsNullOrWhiteSpace(x)));

    private static bool EsCobranza(string? tc)
        => string.Equals(tc?.Trim(), "CBCT", StringComparison.OrdinalIgnoreCase)
           || string.Equals(tc?.Trim(), "CB", StringComparison.OrdinalIgnoreCase)
           || string.Equals(tc?.Trim(), "CBFP", StringComparison.OrdinalIgnoreCase);

    private static List<(string Label, decimal Value)> BuildTotales(ComprobanteCabeceraDto c)
    {
        var subtotal = c.ImporteInsumos + c.ImporteServicios + c.ImporteOtrosConceptos;
        var items = new List<(string Label, decimal Value)>
        {
            ("Subtotal", subtotal != 0m ? subtotal : c.ImporteSinIva),
            ("Descuento 1", c.Descuento1),
            ("Descuento 2", c.Descuento2),
            ("Descuento 3", c.Descuento3),
            ("Descuento 4", c.Descuento4),
            ("Impuestos", c.ImporteImpuestosInternos),
            ("Neto gravado", c.NetoGravado),
            ("Neto no gravado", c.NetoNoGravado),
            ("IVA", c.Iva),
            ("IVA recargo", c.IvaRecargo),
            ("Total", c.ImporteTotal)
        };

        return items;
    }

    private RenderFragment RenderTotales(ComprobanteCabeceraDto c) => @<div class="comprobante-viewer__totales-list">
        <div class="comprobante-viewer__total-column">
            <span class="comprobante-viewer__total-label">SUBTOTAL:</span>
            <strong>@FormatMoney(GetTotal(c, "Subtotal"))</strong>
        </div>
        <div class="comprobante-viewer__total-column comprobante-viewer__total-column--multi">
            <span class="comprobante-viewer__total-label">DESCUENTOS:</span>
            <strong>1&nbsp;&nbsp;@FormatMoney(c.Descuento1)</strong>
            <strong>2&nbsp;&nbsp;@FormatMoney(c.Descuento2)</strong>
            <strong>3&nbsp;&nbsp;@FormatMoney(c.Descuento3)</strong>
            <strong>4&nbsp;&nbsp;@FormatMoney(c.Descuento4)</strong>
        </div>
        <div class="comprobante-viewer__total-column">
            <span class="comprobante-viewer__total-label">IMPUESTOS:</span>
            <strong>@FormatMoney(c.ImporteImpuestosInternos)</strong>
        </div>
        <div class="comprobante-viewer__total-column comprobante-viewer__total-column--multi">
            <span class="comprobante-viewer__total-label">IVA:</span>
            <strong>@FormatMoney(c.Iva)</strong>
            <strong>0.00</strong>
            <strong>0.00</strong>
        </div>
        <div class="comprobante-viewer__total-column">
            <span class="comprobante-viewer__total-label">IVA RECARGO:</span>
            <strong>@FormatMoney(c.IvaRecargo)</strong>
        </div>
        <div class="comprobante-viewer__total-column comprobante-viewer__total-column--grand">
            <span class="comprobante-viewer__total-label">TOTAL $</span>
            <strong>@FormatMoney(c.ImporteTotal)</strong>
        </div>
    </div>;

    private static decimal GetTotal(ComprobanteCabeceraDto c, string label)
    {
        if (label != "Subtotal")
            return 0m;

        var subtotal = c.ImporteInsumos + c.ImporteServicios + c.ImporteOtrosConceptos;
        return subtotal != 0m ? subtotal : c.ImporteSinIva;
    }

    private static string ResolveDefaultTab(ComprobanteViewerDto? dto)
    {
        if (dto?.Cabecera is null)
            return "resumen";

        if (dto.Insumos.Count > 0)
            return "insumos";

        if (dto.Tareas.Count > 0)
            return "tareas";

        if (dto.Observaciones.Count > 0)
            return "observaciones";

        if (HasResumenContent(dto.Cabecera))
            return "resumen";

        return "resumen";
    }

    private static string BuildTotalesStyle(int count)
    {
        var columns = count >= 3 ? 3 : Math.Max(1, count);
        return $"display:grid;grid-template-columns:repeat({columns}, minmax(0, 1fr));gap:.85rem;align-items:stretch;";
    }

    private static bool HasResumenContent(ComprobanteCabeceraDto c)
        => HasValue(c.NetoGravado)
           || HasValue(c.NetoNoGravado)
           || !string.IsNullOrWhiteSpace(c.ObservacionesGenerales)
           || !string.IsNullOrWhiteSpace(c.Comentarios);

    private string GetTitle()
    {
        if (_dto?.Cabecera is null) return "Visualizador de comprobantes";
        var c = _dto.Cabecera;
        var prefix = c.TipoFormato switch
        {
            "ReciboCobros" => "Recibo de Cobros",
            "ReciboPagos"  => "Recibo de Pagos",
            _ when c.SistemaOrigen == "COMPRAS" => "Comprobante de Compras",
            _ => "Comprobante"
        };
        var empresa = string.IsNullOrWhiteSpace(_branding?.Nombre) ? "Alfa Gestión" : _branding.Nombre;
        return $"{empresa} · {prefix} {c.Tc} {c.IdComprobante}";
    }

    private string GetIntro()
    {
        if (_dto?.Cabecera is null)
            return "Consultá cabecera, detalle, observaciones, aplicaciones, documentos e historial del comprobante.";
        var c = _dto.Cabecera;
        return c.TipoFormato switch
        {
            "ReciboCobros" => $"Recibo de cobros {c.Tc} {c.IdComprobante} — pagos recibidos y comprobantes relacionados.",
            "ReciboPagos"  => $"Recibo de pagos {c.Tc} {c.IdComprobante} — pagos realizados y comprobantes relacionados.",
            _ when c.SistemaOrigen == "COMPRAS" => $"Comprobante de compras {c.Tc} {c.IdComprobante} — datos del proveedor, artículos e importes.",
            _ => $"Visor genérico del comprobante {c.Tc} {c.IdComprobante} con navegación entre comprobantes relacionados."
        };
    }

    private bool IsReimpresion()
        => string.Equals(Reimpresion, "1", StringComparison.OrdinalIgnoreCase)
           || string.Equals(Reimpresion, "true", StringComparison.OrdinalIgnoreCase)
           || string.Equals(Reimpresion, "si", StringComparison.OrdinalIgnoreCase);

    private static IEnumerable<(string Label, string Css)> BuildEstadoBadges(ComprobanteCabeceraDto c, bool reimpresion)
    {
        if (c.Anulada) yield return ("ANULADO", "is-danger");
        if (c.Finalizada) yield return ("FINALIZADO", "is-success");
        if (c.Aprobada) yield return ("APROBADO", "is-info");
        if (reimpresion) yield return ("REIMPRESION", "is-warning");
        else if (c.Impresa) yield return ("IMPRESO", "is-neutral");
        if (c.Bloqueada) yield return ("BLOQUEADO", "is-warning");
        if (c.Cerrada) yield return ("CERRADO", "is-neutral");
    }

    private static string GetFeedbackClass(AppUiMessage message)
        => message.Severity switch
        {
            AppUiFeedbackSeverity.Success => "editor-msg--ok",
            AppUiFeedbackSeverity.Warning => "editor-msg--warn",
            _ => "editor-msg--error"
        };

