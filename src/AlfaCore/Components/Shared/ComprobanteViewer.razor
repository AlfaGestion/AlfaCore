    private RenderFragment RenderAplicaciones(bool incluirMediosPago = true) => @<div class="comprobante-viewer__related">
        @if (incluirMediosPago && EsCobranza(_dto!.Cabecera?.Tc))
        {
            <div class="panel-card comprobante-viewer__nested">
                <div class="panel-card__header">
                    <div>
                        <h3 class="panel-card__title">Medios de pago</h3>
                        <p class="panel-card__subtitle">Cuentas registradas en el asiento de la cobranza.</p>
                    </div>
                </div>
                @RenderMediosPago()
            </div>
        }
        <div class="panel-card comprobante-viewer__nested">
            <div class="panel-card__header">
                <div>
                    <h3 class="panel-card__title">Comprobantes que aplican a @_dto!.Cabecera!.Tc @_dto.Cabecera.IdComprobante</h3>
                    <p class="panel-card__subtitle">TC e IDCOMPROBANTE de los comprobantes aplicados.</p>
                </div>
            </div>
            @RenderRelacionadasTable(_dto!.AplicadoPor, EsCobranza(_dto.Cabecera?.Tc))
        </div>
    </div>;

    private RenderFragment RenderMediosPago() => @<div class="table-wrap">
        <table class="data-table usuarios-table" data-sticky-list-header>
            <thead>
                <tr>
                    <th>Cuenta</th>
                    <th>Detalle</th>
                    <th>Debe/Haber</th>
                    <th>Usuario</th>
                    <th style="text-align:right;">Importe</th>
                </tr>
            </thead>
            <tbody>
                @if (_asientoLoading)
                {
                    <tr><td colspan="5" class="muted">Consultando los medios de pago en el asiento...</td></tr>
                }
                else if (!string.IsNullOrWhiteSpace(_asientoError))
                {
                    <tr><td colspan="5" class="muted">No se pudieron consultar los medios de pago.</td></tr>
                }
                else
                {
                    var medios = _asientos.Where(x => string.Equals(x.DebeHaber?.Trim(), "D", StringComparison.OrdinalIgnoreCase)).ToList();
                    if (medios.Count == 0)
                    {
                        medios = _asientos.ToList();
                    }

                    if (medios.Count == 0)
                    {
                        <tr><td colspan="5" class="muted">La cobranza no tiene medios de pago registrados en el asiento.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in medios)
                        {
                            <tr>
                                <td>@item.Cuenta</td>
                                <td>@item.Detalle</td>
                                <td>@item.DebeHaber</td>
                                <td>@item.Usuario</td>
                                <td style="text-align:right;">@FormatMoney(item.Importe)</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>;

    private RenderFragment RenderRelacionadasTable(IReadOnlyList<ComprobanteAplicacionDto> rows, bool mostrarOrigen) => @<div class="table-wrap">
        <table class="data-table usuarios-table" data-sticky-list-header>
            <thead>
                <tr>
                    <th>TC</th>
                    <th>IDCOMPROBANTE</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Count == 0)
                {
                    <tr><td colspan="3" class="muted">No hay comprobantes que apliquen a este comprobante.</td></tr>
                }
                else
                {
                    @foreach (var item in rows)
                    {
                        var tcDestino = mostrarOrigen ? item.TcOrigen : item.TcRelacionado;
                        var idDestino = mostrarOrigen ? item.IdComprobanteOrigen : item.IdComprobanteRelacionado;
                        var idCompDestino = mostrarOrigen ? item.IdComplementoOrigen : item.IdComplementoRelacionado;
                        <tr>
                            <td>@tcDestino</td>
                            <td>@idDestino</td>
                            <td>
                                <div class="actions">
                                    <button type="button" class="btn btn--ghost btn--sm" @onclick="() => OpenRelacionadoAsync(tcDestino, idDestino, idCompDestino)">
                                        <i class="bi bi-eye"></i>
                                        <span>Abrir</span>
                                    </button>
                                    <a class="btn btn--ghost btn--sm" href="@BuildPageUrl(tcDestino, idDestino, idCompDestino)" target="_blank" rel="noopener noreferrer">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        <span>Nueva pestaña</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>;

    private RenderFragment RenderDocumentos() => @<div class="table-wrap">
        <table class="data-table usuarios-table" data-sticky-list-header>
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Ruta / adjunto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (_dto!.Documentos.Count == 0)
                {
                    <tr><td colspan="3" class="muted">El comprobante no tiene documentos relacionados.</td></tr>
                }
                else
                {
                    @foreach (var item in _dto.Documentos)
                    {
                        <tr>
                            <td>@item.NombreArchivo</td>
                            <td class="comprobante-viewer__doc-path">@item.Documento</td>
                            <td>
                                @if (item.EsAbrible)
                                {
                                    if (item.EsUrlExterna)
                                    {
                                        <a class="btn btn--ghost btn--sm" href="@item.Documento" target="_blank" rel="noopener noreferrer">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                            <span>Abrir</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn--ghost btn--sm" href="@BuildDocumentoUrl(item)" target="_blank" rel="noopener noreferrer">
                                            <i class="bi bi-file-earmark-arrow-down"></i>
                                            <span>Abrir</span>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="muted">No disponible</span>
                                }
