    private RenderFragment RenderAsientos() => @<div class="table-wrap">
        @if (_asientoLoading)
        {
            <div class="loading">Cargando asiento...</div>
        }
        @if (!string.IsNullOrWhiteSpace(_asientoError))
        {
            <div class="editor-msg editor-msg--error"><p>@_asientoError</p></div>
        }
        <table class="data-table usuarios-table" data-sticky-list-header>
            <thead>
                <tr>
                    <th>Cuenta</th>
                    <th>Descripción</th>
                    <th>Cheque</th>
                    <th>Vencimiento</th>
                    <th>Cuotas</th>
                    <th style="text-align:right;">Debe</th>
                    <th style="text-align:right;">Haber</th>
                </tr>
            </thead>
            <tbody>
                @if (_asientos.Count == 0 && !_asientoLoading)
                {
                    <tr><td colspan="7" class="muted">Este comprobante no tiene asiento registrado.</td></tr>
                }
                else
                {
                    @foreach (var item in _asientos)
                    {
                        <tr>
                            <td>@item.Cuenta</td>
                            <td>
                                <span>@(string.IsNullOrWhiteSpace(item.DescripcionCuenta) ? item.Detalle : item.DescripcionCuenta)</span>
                                @if (!string.IsNullOrWhiteSpace(item.Detalle) && !string.Equals(item.Detalle.Trim(), item.DescripcionCuenta.Trim(), StringComparison.OrdinalIgnoreCase))
                                {
                                    <small class="comprobante-asiento-detail">@item.Detalle</small>
                                }
                            </td>
                            <td>@item.Cheque</td>
                            <td>@FormatDate(item.Vencimiento)</td>
                            <td>@(item.Cuotas == 0 ? "0.00" : item.Cuotas.ToString("0.##"))</td>
                            <td class="money">@FormatMoney(item.Debe)</td>
                            <td class="money">@FormatMoney(item.Haber)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (_asientos.Count > 0)
        {
            <div class="comprobante-asiento-inline__totals">
                <span>Suma de débitos: <strong>@FormatMoney(_asientos.Sum(x => x.Debe))</strong></span>
                <span>Suma de créditos: <strong>@FormatMoney(_asientos.Sum(x => x.Haber))</strong></span>
            </div>
        }
    </div>;

    private RenderFragment RenderAcciones() => @<div class="table-wrap">
