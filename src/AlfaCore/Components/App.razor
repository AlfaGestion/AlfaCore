    <title>AlfaNet - Alfa Gestión</title>
    <link rel="stylesheet" href="/bootstrap/bootstrap.min.css?v=20260703-cssfix" />
    <link rel="stylesheet" href="/app.css?v=20260812-crm-cotiz-ia-lineas" />
    <link rel="stylesheet" href="/css/informes.css?v=20260703-cssfix" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/AlfaCore.styles.css?v=20260812-crm-cotiz-pulir" />
    <link rel="stylesheet" href="/css/auth.css?v=20260708-loginlocal2" />
    <link rel="stylesheet" href="/theme-overrides.css?v=20260703-themefix3" />
    <link rel="stylesheet" href="/css/carga-viajes.css?v=20260703-cssfix2" />
    <link rel="stylesheet" href="/css/sticky-list-headers.css?v=20260715b" />
    <link rel="icon" type="image/png" href="/logos/icono.png?v=20260703-cssfix" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AlfaCore" />
    <script src="https://www.google.com/recaptcha/api.js?render=explicit" async defer></script>
    <script>
        (function () {
            var t = localStorage.getItem('dashboard.theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
        (function () {
            var isLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
            if (!isLocal || !('serviceWorker' in navigator))
                return;

            navigator.serviceWorker.getRegistrations()
                .then(function (registrations) {
                    return Promise.all(registrations.map(function (registration) {
                        return registration.unregister();
                    }));
                })
                .catch(function () { });

            if (window.caches && typeof window.caches.keys === 'function') {
                window.caches.keys()
                    .then(function (keys) {
                        return Promise.all(keys.map(function (key) {
                            return window.caches.delete(key);
                        }));
                    })
                    .catch(function () { });
            }
        })();
        window.dashboardTheme = {
            set: function (theme) {
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('dashboard.theme', theme);
                document.dispatchEvent(new CustomEvent('dashboard-theme-changed', { detail: theme }));
            },
            get: function () {
                return document.documentElement.getAttribute('data-theme') || 'light';
            },
            watch: function (dotnetRef) {
                if (window.__alfaCoreDashboardThemeHandler) {
                    document.removeEventListener('dashboard-theme-changed', window.__alfaCoreDashboardThemeHandler);
                }

                window.__alfaCoreDashboardThemeHandler = function () {
                    if (!dotnetRef) return;
                    var currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
                    dotnetRef.invokeMethodAsync('OnDashboardThemeChanged', currentTheme);
                };

                document.addEventListener('dashboard-theme-changed', window.__alfaCoreDashboardThemeHandler);
            },
            unwatch: function () {
                if (window.__alfaCoreDashboardThemeHandler) {
                    document.removeEventListener('dashboard-theme-changed', window.__alfaCoreDashboardThemeHandler);
                    window.__alfaCoreDashboardThemeHandler = null;
                }
            }
        };
        window.alfaCoreSqlSession = {
            setActive: function (id) {
                if (!id) return;
                localStorage.setItem('alfacore.sqlSessionId', id);
                document.cookie = 'AlfaCore.SqlSessionId=' + encodeURIComponent(id) + '; path=/; max-age=31536000; samesite=lax';
            },
            clearActive: function () {
                localStorage.removeItem('alfacore.sqlSessionId');
                document.cookie = 'AlfaCore.SqlSessionId=; path=/; max-age=0; samesite=lax';
            }
        };
        window.alfaCorePwaFunctionExists = function (name) {
            return !!(window.alfaCorePwa && typeof window.alfaCorePwa[name] === 'function');
        };
        window.alfaCoreNavigation = {
            canGoBack: function () {
                return window.history.length > 1;
            },
            goBack: function () {
                window.history.back();
            }
        };
        window.alfaCorePublicRegistration = {
            renderRecaptcha: function (elementId, siteKey) {
                return new Promise(function (resolve, reject) {
                    var attempts = 0;

                    function render() {
                        var element = document.getElementById(elementId);
                        if (!element) {
                            reject(new Error('No se encontro el contenedor de reCAPTCHA.'));
                            return;
                        }

                        if (element.dataset.widgetId) {
                            resolve(parseInt(element.dataset.widgetId, 10));
                            return;
                        }

                        if (window.grecaptcha && typeof window.grecaptcha.render === 'function') {
                            var widgetId = window.grecaptcha.render(elementId, { sitekey: siteKey });
                            element.dataset.widgetId = String(widgetId);
                            resolve(widgetId);
                            return;
                        }

                        attempts += 1;
                        if (attempts > 100) {
                            reject(new Error('reCAPTCHA no termino de cargar.'));
                            return;
                        }

                        window.setTimeout(render, 150);
                    }

                    render();
                });
            },
            getRecaptchaResponse: function (elementId) {
                var element = document.getElementById(elementId);
                if (!element || !element.dataset.widgetId || !window.grecaptcha)
                    return '';

                return window.grecaptcha.getResponse(parseInt(element.dataset.widgetId, 10)) || '';
            },
            resetRecaptcha: function (elementId) {
                var element = document.getElementById(elementId);
                if (!element || !element.dataset.widgetId || !window.grecaptcha)
                    return;

                window.grecaptcha.reset(parseInt(element.dataset.widgetId, 10));
            }
        };
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
