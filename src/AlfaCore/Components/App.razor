<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>AlfaCore - Alfa Gestión</title>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="AlfaCore.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/icon-192.png" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AlfaCore" />
    <script>
        (function () {
            var t = localStorage.getItem('dashboard.theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
        window.dashboardTheme = {
            set: function (theme) {
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('dashboard.theme', theme);
            },
            get: function () {
                return document.documentElement.getAttribute('data-theme') || 'light';
            }
        };
        window.alfaCoreSqlSession = {
            setActive: function (id) {
                if (!id) return;
                localStorage.setItem('alfacore.sqlSessionId', id);
                document.cookie = 'AlfaCore.SqlSessionId=' + encodeURIComponent(id) + '; path=/; max-age=31536000; samesite=lax';
            },
            clearActive: function () {
                localStorage.removeItem('alfacore.sqlSessionId');
                document.cookie = 'AlfaCore.SqlSessionId=; path=/; max-age=0; samesite=lax';
            }
        };
        window.alfaCorePwaFunctionExists = function (name) {
            return !!(window.alfaCorePwa && typeof window.alfaCorePwa[name] === 'function');
        };
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/dashboard-export.js?v=20260417"></script>
    <script src="js/auth-tree.js?v=20260526a"></script>
    <script src="js/conversaciones.js?v=20260520e"></script>
    <script src="js/interfaces-upload.js?v=20260526b"></script>
    <script src="js/pwa.js?v=20260521e"></script>
    <script src="js/sticky-table-scroll.js?v=20260525a"></script>
</body>

</html>
