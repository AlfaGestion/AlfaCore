<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlfaCore</AssemblyName>
    <UserSecretsId>AlfaCore-Development</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**;publish\**;App_Data\whatsapp-web\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2024.10.2" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Docs\manual_usuario.md" />
    <EmbeddedResource Include="Docs\manual_consultas.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="App_Data\whatsapp-web\**" />
    <None Remove="App_Data\whatsapp-web\**" />
    <!-- node_modules del worker de WhatsApp Web nunca se commitea (ver .gitignore); si un dev lo
         instaló localmente no queremos que MSBuild lo evalúe como item de proyecto en cada build. -->
    <None Remove="Node\WhatsAppWebWorker\node_modules\**" />
    <!-- WhatsAppWebSessionService.GetWorkerDirectory() resuelve el worker por AppContext.BaseDirectory
         (la carpeta de salida real), no por el árbol fuente: necesita el código del worker + su
         manifiesto de dependencias físicamente al lado del .exe en Debug/Release/publish.
         node_modules NO se copia acá a propósito (miles de archivos, no versionado): después del
         build/publish hace falta npm ci una vez dentro de la carpeta de salida
         Node\WhatsAppWebWorker, ver docs/ui/conversaciones-configuracion-redesign.md. -->
    <None Update="Node\WhatsAppWebWorker\worker.mjs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Node\WhatsAppWebWorker\package.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Node\WhatsAppWebWorker\package-lock.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Server.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="App_Data\updates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
