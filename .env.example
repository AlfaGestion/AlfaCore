PushNotifications__Subject=mailto:admin@alfagestion.com
PushNotifications__PublicKey=PEGAR_PUBLIC_KEY
PushNotifications__PrivateKey=PEGAR_PRIVATE_KEY

# Cadena de conexion a ALFA_CENTRAL (server, usuario y password reales). No commitear el valor real.
ConnectionStrings__AlfaCentral=Data Source=SERVIDOR;Initial Catalog=ALFA_CENTRAL;User ID=USUARIO;Password=PASSWORD;TrustServerCertificate=True

# API key para POST /api/vb6/backup-status (header X-Api-Key). Generar una nueva por entorno.
BackupStatus__ApiKey=PEGAR_API_KEY
